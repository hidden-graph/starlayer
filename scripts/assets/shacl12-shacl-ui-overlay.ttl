# SOURCE of the UI overlay for the SHACL meta-shapes: how to present the SHACL vocabulary in a form, as opposed to shacl_shacl,
# which says what is valid. HAND-EDITED. scripts/build_shacl_ui.py reads this file and writes the registered file
# starontology/shacl12-shacl-ui.ttl (registry entry shacl_shacl_ui), which is this file plus the FORM SHAPES it generates:
# stsh:NodeShapeForm and stsh:PropertyShapeForm, a shape per kind of node whose property shapes are the form's fields (one per
# predicate flagged stsh:nodeFormField / stsh:propertyFormField), each with its group and order from here and the datatype,
# node kind and sh:in list its predicate has in shacl_shacl. The build checks that every predicate shacl_shacl validates is a
# field of some form or is on build_shacl_ui.EXCLUDED with a reason, so the forms cannot fall behind the validation shapes.
#
# Contents of this source: 19 sh:PropertyGroup sections (stsh:TargetGroup, ...), sh:group and sh:order on each SHACL
# predicate (one group and one order per predicate: SHACL gives sh:order a single value, and the meta-shapes check that), the
# stsh: form flags (nodeFormField, propertyFormField, formMaxCount, nodePrimary), stsh:formFor, and two small hand-written forms
# (stsh:PropertyGroupForm, stsh:ShapesGraphForm).
#
# There is NO widget in this file. The 66 widget preferences it used to carry (shui:editor per sh:path) moved on
# 2026-10-21 to shacl_shacl_ui_scores, a scoring-side layer, because select_widgets reads scores from the scoring graph.
# The 20 fields no built-in widget fits (stsh:widgetType: path expressions, node expression lists, message lists, ...)
# were dropped on the same day; they belong in an application layer whose application understands them.
#
# A form shape has no sh:target*: it is not applied to anything. The exceptions are the two well-formedness shapes at the end
# (stsh:ShuiPredicateShapes, stsh:WidgetScoreShape), which validate shui: terms when this graph is merged with shacl_shacl.
# A tool picks the form for a node by stsh:formFor (the class of node the form is for) and passes it to select_widgets as
# shape_node. The human-editable content is docs/working/shacl-presentation/shacl-presentation-content.md, which may have
# drifted.
#
# baseURI: https://github.com/hidden-graph/starlayer/ns/shacl#

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix stsh: <https://github.com/hidden-graph/starlayer/ns/shacl#> .

# No root-level rdfs:label/rdfs:comment here by design - see
# shacl12-validation-shapes.ttl's own stsh: root description, which is the
# single canonical one.

#############################################################################
# Property groups (suggested UI section order)
#############################################################################

stsh:TypeGroup a sh:PropertyGroup ;
	sh:name "Type"@en ;
	sh:order 0 ;
	sh:description "What kind of thing this is — rdf:type, a simple multi-valued IRI. Allowed on any shape and expected on most (a shape need not be typed, SHACL 1.2 Core section 3.1, but a form should show and set the type)."@en .

stsh:DefinitionGroup a sh:PropertyGroup ;
	sh:name "Definition"@en ;
	sh:order 0.5 ;
	sh:description "What a kind of element is, as opposed to what it is called: the query of a SPARQL constraint, the subject, predicate and object of a triple rule, the prefix and namespace of a prefix declaration, the widget and score of a widget score, the members and imports of a shapes graph (GitHub issue #92)."@en .

stsh:TargetGroup a sh:PropertyGroup ;
	sh:name "Targeting"@en ;
	sh:order 1 ;
	sh:description "How a shape selects its focus nodes — sh:targetClass, sh:targetNode, and the rest of the targeting predicates."@en .

stsh:NamingGroup a sh:PropertyGroup ;
	sh:name "Naming and messages"@en ;
	sh:order 1.5 ;
	sh:description "What a shape is called and what it says when it fails: sh:name, sh:description, rdfs:label, rdfs:comment, sh:message, sh:severity, sh:deactivated. Directly after Targeting (GitHub issue #92)."@en .

stsh:PathGroup a sh:PropertyGroup ;
	sh:name "Property Paths"@en ;
	sh:order 2 ;
	sh:description "sh:path and its operators (inverse, alternative, repeated) that connect a focus node to its value nodes."@en .

stsh:CardinalityGroup a sh:PropertyGroup ;
	sh:name "Cardinality"@en ;
	sh:order 3 ;
	sh:description "How many values a path may or must have — sh:minCount/sh:maxCount."@en .

stsh:ValueTypeGroup a sh:PropertyGroup ;
	sh:name "Value Type"@en ;
	sh:order 4 ;
	sh:description "What kind of RDF term or class a value node must be — sh:class/sh:datatype/sh:nodeKind."@en .

stsh:ValueRangeGroup a sh:PropertyGroup ;
	sh:name "Value Range"@en ;
	sh:order 5 ;
	sh:description "Numeric/ordinal bounds on a value — sh:minInclusive and its siblings."@en .

stsh:StringGroup a sh:PropertyGroup ;
	sh:name "String Constraints"@en ;
	sh:order 6 ;
	sh:description "Constraints on a value's string form — length, pattern, language."@en .

stsh:ValueEnumerationGroup a sh:PropertyGroup ;
	sh:name "Value Enumeration"@en ;
	sh:order 7 ;
	sh:description "Allow-listing or requiring specific values — sh:in/sh:hasValue."@en .

stsh:ComparisonGroup a sh:PropertyGroup ;
	sh:name "Value Comparison"@en ;
	sh:order 8 ;
	sh:description "Comparing one property's values against another's — sh:equals/sh:disjoint/sh:lessThan and siblings."@en .

stsh:CompositionGroup a sh:PropertyGroup ;
	sh:name "Shape Composition"@en ;
	sh:order 9 ;
	sh:description "Combining shapes logically or by nesting — sh:not/sh:and/sh:or/sh:xone/sh:node/sh:property."@en .

stsh:QualifiedGroup a sh:PropertyGroup ;
	sh:name "Qualified Value Shapes"@en ;
	sh:order 10 ;
	sh:description "Counting how many values conform to a shape, rather than requiring all-or-none."@en .

stsh:ClosedGroup a sh:PropertyGroup ;
	sh:name "Closed Shapes"@en ;
	sh:order 11 ;
	sh:description "Restricting a focus node to only the explicitly listed properties."@en .

stsh:ListGroup a sh:PropertyGroup ;
	sh:name "List Constraints"@en ;
	sh:order 12 ;
	sh:description "Well-formedness and length/uniqueness rules for SHACL-list-valued properties."@en .

stsh:CrossNodeGroup a sh:PropertyGroup ;
	sh:name "Cross-Node"@en ;
	sh:order 13 ;
	sh:description "Constraints spanning multiple focus nodes (e.g. sh:uniqueValuesFor)."@en .

stsh:ReificationGroup a sh:PropertyGroup ;
	sh:name "Reification"@en ;
	sh:order 14 ;
	sh:description "RDF 1.2 triple-term reification constraints (sh:reifierShape, sh:reificationRequired)."@en .

stsh:MetadataGroup a sh:PropertyGroup ;
	sh:name "Non-Validating Metadata"@en ;
	sh:order 15 ;
	sh:description "Annotation-only predicates with no effect on conformance — sh:message/sh:severity/sh:name/etc."@en .

#############################################################################
# Predicate rendering hints (sh:group / sh:order) - full SHACL Core +
# SHACL 1.2 coverage
#############################################################################

sh:alternativePath sh:group stsh:PathGroup ; sh:order 3 .
sh:and sh:group stsh:CompositionGroup ; sh:order 2 .
sh:class sh:group stsh:ValueTypeGroup ; sh:order 1 .
sh:closed sh:group stsh:ClosedGroup ; sh:order 1 .
sh:datatype sh:group stsh:ValueTypeGroup ; sh:order 3 .
sh:deactivated sh:group stsh:NamingGroup ; sh:order 7 .
sh:defaultValue sh:group stsh:MetadataGroup ; sh:order 3 .
sh:values sh:group stsh:MetadataGroup ; sh:order 4 .
sh:description sh:group stsh:NamingGroup ; sh:order 2 .
sh:disjoint sh:group stsh:ComparisonGroup ; sh:order 2 .
sh:equals sh:group stsh:ComparisonGroup ; sh:order 1 .
sh:flags sh:group stsh:StringGroup ; sh:order 4 .
sh:group sh:group stsh:MetadataGroup ; sh:order 2 .
sh:hasValue sh:group stsh:ValueEnumerationGroup ; sh:order 2 .
sh:ignoredProperties sh:group stsh:ClosedGroup ; sh:order 2 .
sh:in sh:group stsh:ValueEnumerationGroup ; sh:order 1 .
sh:inversePath sh:group stsh:PathGroup ; sh:order 2 .
sh:languageIn sh:group stsh:StringGroup ; sh:order 5 .
sh:lessThan sh:group stsh:ComparisonGroup ; sh:order 3 .
sh:lessThanOrEquals sh:group stsh:ComparisonGroup ; sh:order 4 .
sh:maxCount sh:group stsh:CardinalityGroup ; sh:order 2 .
sh:maxExclusive sh:group stsh:ValueRangeGroup ; sh:order 4 .
sh:maxInclusive sh:group stsh:ValueRangeGroup ; sh:order 3 .
sh:maxLength sh:group stsh:StringGroup ; sh:order 2 .
sh:maxListLength sh:group stsh:ListGroup ; sh:order 2 .
sh:memberShape sh:group stsh:CompositionGroup ; sh:order 8 .
sh:message sh:group stsh:NamingGroup ; sh:order 5 .
sh:minCount sh:group stsh:CardinalityGroup ; sh:order 1 .
sh:minExclusive sh:group stsh:ValueRangeGroup ; sh:order 2 .
sh:minInclusive sh:group stsh:ValueRangeGroup ; sh:order 1 .
sh:minLength sh:group stsh:StringGroup ; sh:order 1 .
sh:minListLength sh:group stsh:ListGroup ; sh:order 1 .
sh:name sh:group stsh:NamingGroup ; sh:order 1 .
sh:node sh:group stsh:CompositionGroup ; sh:order 5 .
sh:nodeKind sh:group stsh:ValueTypeGroup ; sh:order 4 .
sh:not sh:group stsh:CompositionGroup ; sh:order 1 .
sh:oneOrMorePath sh:group stsh:PathGroup ; sh:order 5 .
sh:or sh:group stsh:CompositionGroup ; sh:order 3 .
sh:order sh:group stsh:MetadataGroup ; sh:order 1 .
sh:path sh:group stsh:PathGroup ; sh:order 1 .
sh:pattern sh:group stsh:StringGroup ; sh:order 3 .
sh:property sh:group stsh:CompositionGroup ; sh:order 6 .
sh:qualifiedMaxCount sh:group stsh:QualifiedGroup ; sh:order 3 .
sh:qualifiedMinCount sh:group stsh:QualifiedGroup ; sh:order 2 .
sh:qualifiedValueShape sh:group stsh:QualifiedGroup ; sh:order 1 .
sh:qualifiedValueShapesDisjoint sh:group stsh:QualifiedGroup ; sh:order 4 .
sh:reificationRequired sh:group stsh:ReificationGroup ; sh:order 2 .
sh:reifierShape sh:group stsh:ReificationGroup ; sh:order 1 .
sh:rootClass sh:group stsh:ValueTypeGroup ; sh:order 2 .
sh:severity sh:group stsh:NamingGroup ; sh:order 6 .
sh:singleLine sh:group stsh:StringGroup ; sh:order 7 .
sh:someValue sh:group stsh:CompositionGroup ; sh:order 7 .
sh:subsetOf sh:group stsh:ComparisonGroup ; sh:order 5 .
sh:targetClass sh:group stsh:TargetGroup ; sh:order 1 .
sh:targetNode sh:group stsh:TargetGroup ; sh:order 2 .
sh:targetObjectsOf sh:group stsh:TargetGroup ; sh:order 4 .
sh:targetSubjectsOf sh:group stsh:TargetGroup ; sh:order 3 .
sh:target sh:group stsh:TargetGroup ; sh:order 5 .        # a SPARQL target (sh:SPARQLTarget) or another target type (GitHub issue #91)
sh:targetWhere sh:group stsh:TargetGroup ; sh:order 6 .   # SHACL 1.2: the nodes that conform to a shape (GitHub issue #91)
sh:nodeByExpression sh:group stsh:CompositionGroup ; sh:order 9 .
sh:uniqueLang sh:group stsh:StringGroup ; sh:order 6 .
sh:uniqueMembers sh:group stsh:ListGroup ; sh:order 3 .
sh:uniqueValuesFor sh:group stsh:CrossNodeGroup ; sh:order 1 .
sh:xone sh:group stsh:CompositionGroup ; sh:order 4 .
sh:zeroOrMorePath sh:group stsh:PathGroup ; sh:order 4 .
sh:zeroOrOnePath sh:group stsh:PathGroup ; sh:order 6 .
sh:expression sh:group stsh:CompositionGroup ; sh:order 10 .   # Node Expressions 7.1: a condition any shape can carry, a node expression that must output exactly true


#############################################################################
# Property groups: Node Expressions, Rules & SPARQL Extensions, SHACL 1.2 UI widgets
#############################################################################

stsh:NodeExpressionGroup a sh:PropertyGroup ;
	sh:name "Node Expression"@en ;
	sh:order 1 ;
	sh:description "The expression type and its defining value — sh:union, sh:intersection, sh:nodes, sh:constant, sh:function, sh:arguments, sh:filterShape."@en .

stsh:RulesGroup a sh:PropertyGroup ;
	sh:name "Rules & SPARQL Extensions"@en ;
	sh:order 15 ;
	sh:description "SPARQL-based constraints, user-defined constraint components, and SHACL-AF inference rules — sh:sparql/sh:rule/sh:condition/sh:TripleRule/sh:SPARQLRule and their supporting predicates."@en .

stsh:WidgetGroup a sh:PropertyGroup ;
	sh:name "SHACL 1.2 UI Widgets"@en ;
	sh:order 16 ;
	sh:description "shui: vocabulary for form generation — widget/editor/viewer assignment and the built-in widget instances. Documents the vocabulary: validation ignores it; widget selection is implemented separately in starlayer.shacl.ui_widget_selection; property roles are not interpreted."@en .

#############################################################################
# Predicate rendering hints (sh:group / sh:order): Rules & SPARQL
# Extensions predicates, and shui: widget/editor/viewer vocabulary
#############################################################################

sh:sparql sh:group stsh:RulesGroup ; sh:order 1 .
sh:ConstraintComponent sh:group stsh:RulesGroup ; sh:order 4 .
sh:parameter sh:group stsh:RulesGroup ; sh:order 5 .
sh:validator sh:group stsh:RulesGroup ; sh:order 6 .
sh:nodeValidator sh:group stsh:RulesGroup ; sh:order 7 .
sh:propertyValidator sh:group stsh:RulesGroup ; sh:order 8 .
sh:rule sh:group stsh:RulesGroup ; sh:order 9 .
sh:condition sh:group stsh:RulesGroup ; sh:order 10 .
sh:TripleRule sh:group stsh:RulesGroup ; sh:order 11 .
sh:SPARQLRule sh:group stsh:RulesGroup ; sh:order 12 .
sh:prefixes sh:group stsh:RulesGroup ; sh:order 17 .
sh:layer sh:group stsh:RulesGroup ; sh:order 18 .
sh:runOnce sh:group stsh:RulesGroup ; sh:order 19 .
sh:expectedPredicate sh:group stsh:RulesGroup ; sh:order 20 .
sh:declare sh:group stsh:RulesGroup ; sh:order 21 .
sh:labelTemplate sh:group stsh:RulesGroup ; sh:order 22 .

# What a kind of element is (GitHub issues #92, #105): the first group after the type, for the forms of the kinds below
sh:select sh:group stsh:DefinitionGroup ; sh:order 1 .
sh:ask sh:group stsh:DefinitionGroup ; sh:order 2 .
sh:construct sh:group stsh:DefinitionGroup ; sh:order 3 .
sh:subject sh:group stsh:DefinitionGroup ; sh:order 4 .
sh:predicate sh:group stsh:DefinitionGroup ; sh:order 5 .
sh:object sh:group stsh:DefinitionGroup ; sh:order 6 .
sh:returnType sh:group stsh:DefinitionGroup ; sh:order 7 .
sh:bodyExpression sh:group stsh:DefinitionGroup ; sh:order 8 .
sh:prefix sh:group stsh:DefinitionGroup ; sh:order 9 .
sh:namespace sh:group stsh:DefinitionGroup ; sh:order 10 .
shui:widget sh:group stsh:DefinitionGroup ; sh:order 11 .
shui:score sh:group stsh:DefinitionGroup ; sh:order 12 .
shui:shapesGraphShape sh:group stsh:DefinitionGroup ; sh:order 13 .
shui:dataGraphShape sh:group stsh:DefinitionGroup ; sh:order 14 .
rdfs:member sh:group stsh:DefinitionGroup ; sh:order 15 .
owl:imports sh:group stsh:DefinitionGroup ; sh:order 16 .
sh:entailment sh:group stsh:DefinitionGroup ; sh:order 17 .

# A parameter's own fields sit in Cardinality, after sh:minCount and sh:maxCount
sh:optional sh:group stsh:CardinalityGroup ; sh:order 3 .
sh:keyParameter sh:group stsh:CardinalityGroup ; sh:order 4 .
shui:editor sh:group stsh:WidgetGroup ; sh:order 1 .
shui:viewer sh:group stsh:WidgetGroup ; sh:order 2 .
shui:propertyRole sh:group stsh:WidgetGroup ; sh:order 3 .
shui:TextFieldEditor sh:group stsh:WidgetGroup ; sh:order 4 .
shui:TextFieldWithLangEditor sh:group stsh:WidgetGroup ; sh:order 5 .
shui:TextAreaEditor sh:group stsh:WidgetGroup ; sh:order 6 .
shui:TextAreaWithLangEditor sh:group stsh:WidgetGroup ; sh:order 7 .
shui:RichTextEditor sh:group stsh:WidgetGroup ; sh:order 8 .
shui:NumberFieldEditor sh:group stsh:WidgetGroup ; sh:order 9 .
shui:BooleanEditor sh:group stsh:WidgetGroup ; sh:order 10 .
shui:DatePickerEditor sh:group stsh:WidgetGroup ; sh:order 11 .
shui:DateTimePickerEditor sh:group stsh:WidgetGroup ; sh:order 12 .
shui:IRIEditor sh:group stsh:WidgetGroup ; sh:order 13 .
shui:AutoCompleteEditor sh:group stsh:WidgetGroup ; sh:order 14 .
shui:EnumSelectEditor sh:group stsh:WidgetGroup ; sh:order 15 .
shui:InstancesSelectEditor sh:group stsh:WidgetGroup ; sh:order 16 .
shui:SubClassEditor sh:group stsh:WidgetGroup ; sh:order 17 .
shui:BlankNodeEditor sh:group stsh:WidgetGroup ; sh:order 18 .
shui:DetailsEditor sh:group stsh:WidgetGroup ; sh:order 19 .
shui:LiteralViewer sh:group stsh:WidgetGroup ; sh:order 20 .
shui:LangStringViewer sh:group stsh:WidgetGroup ; sh:order 21 .
shui:HTMLViewer sh:group stsh:WidgetGroup ; sh:order 22 .
shui:IRIViewer sh:group stsh:WidgetGroup ; sh:order 23 .
shui:HyperlinkViewer sh:group stsh:WidgetGroup ; sh:order 24 .
shui:ImageViewer sh:group stsh:WidgetGroup ; sh:order 25 .
shui:LabelViewer sh:group stsh:WidgetGroup ; sh:order 26 .
shui:BlankNodeViewer sh:group stsh:WidgetGroup ; sh:order 27 .
shui:DetailsViewer sh:group stsh:WidgetGroup ; sh:order 28 .
shui:ValueTableViewer sh:group stsh:WidgetGroup ; sh:order 29 .
shui:LabelRole sh:group stsh:WidgetGroup ; sh:order 30 .


#############################################################################
# Form flags
#
# Widget choice is not made here: there is no widget in this file. It is in a scoring layer (shacl_shacl_ui_scores).
#
# stsh:nodePrimary — false signals that a predicate is allowed but not
#   commonly expected; editors may choose to show it in a secondary section.
#
# These carry no validation semantics and are safe to add to any graph.
#############################################################################

stsh:nodePrimary a rdf:Property ;
    rdfs:label "node primary"@en ;
    rdfs:comment "When false, the predicate is allowed but not commonly expected — editors may show it in a secondary or collapsed section. Absent is treated as true."@en ;
    rdfs:range xsd:boolean .


#############################################################################
# Targeting predicates
#############################################################################



#############################################################################
# Property paths — sh:path itself, and the operators that build a compound
# path (RDF 1.2 Concepts allows full recursive path grammar here, reusing
# pySHACL's own shsh:PathNodeShape - see shacl12-validation-shapes.ttl's own
# comment on stsh:IRIOrPathShape). Default is the general/compound case
# (prop_path_expr, a dedicated path-expression editor), since a plain-IRI
# path is the simple special case of that, not the reverse - downstream
# apps commonly override to a simpler picker when the value happens to be
# a bare IRI.
#############################################################################



#############################################################################
# Non-validating metadata
#############################################################################

sh:description stsh:multiline true .
sh:message stsh:multiline true .


#############################################################################
# Closed shapes
#############################################################################



#############################################################################
# Value type
#############################################################################

sh:datatype stsh:nodePrimary false .


#############################################################################
# Cardinality
#############################################################################



#############################################################################
# List constraints
#############################################################################

sh:minListLength stsh:nodePrimary false .
sh:maxListLength stsh:nodePrimary false .
sh:uniqueMembers stsh:nodePrimary false .


#############################################################################
# Value range
#############################################################################

sh:minInclusive stsh:nodePrimary false .
sh:maxInclusive stsh:nodePrimary false .
sh:minExclusive stsh:nodePrimary false .
sh:maxExclusive stsh:nodePrimary false .


#############################################################################
# String constraints
#############################################################################

sh:minLength stsh:nodePrimary false .
sh:maxLength stsh:nodePrimary false .
sh:pattern stsh:nodePrimary false .
sh:flags stsh:nodePrimary false .
sh:singleLine stsh:nodePrimary false .


#############################################################################
# Value enumeration
#############################################################################

sh:languageIn stsh:nodePrimary false .


#############################################################################
# Value comparison
#############################################################################



#############################################################################
# Shape composition (logical / nested shapes)
#############################################################################



#############################################################################
# Qualified value shapes
#############################################################################



#############################################################################
# Cross-node constraints and RDF 1.2 reification
#############################################################################



#############################################################################
# Rules & SPARQL Extensions — sh:sparql/sh:rule/sh:condition/custom
# sh:ConstraintComponent and their supporting predicates (see
# shacl12-validation-shapes.ttl's stsh:RulesAndSparqlShapes/
# stsh:ConstraintComponentShape for the real well-formedness rules these
# render values of). Query-text predicates (confirmed sh:datatype
# xsd:string in the validation shapes) get "multiline", matching
# rdfs:comment's own plain-multiline-text treatment above - not "langstring"
# (these are never language-tagged) and not a dedicated code-editor value,
# since none exists in this vocabulary yet. Everything else here resolves
# (per the validation shapes' own sh:node) to a nested shape or a SHACL 1.2
# node expression - both open-ended/potentially-recursive structures, so
# "inline_shape" is the safe general default, same reasoning as sh:someValue/
# sh:qualifiedValueShape above.
#############################################################################




#############################################################################
# Form-field membership vocabulary
#############################################################################

stsh:nodeFormField a rdf:Property ;
    rdfs:label "node form field"@en ;
    rdfs:comment "True when this predicate appears as an inline form field in NodeShape editors."@en ;
    rdfs:range xsd:boolean .

stsh:propertyFormField a rdf:Property ;
    rdfs:label "property form field"@en ;
    rdfs:comment "True when this predicate appears as an inline form field in PropertyShape editors."@en ;
    rdfs:range xsd:boolean .

stsh:formMaxCount a rdf:Property ;
    rdfs:label "form max count"@en ;
    rdfs:comment "Maximum cardinality in the editing form. Absent = multi-valued."@en ;
    rdfs:range xsd:integer .


#############################################################################
# rdfs:comment — not a SHACL predicate but commonly appears on shapes
#############################################################################

# rdfs:label, rdfs:comment, rdfs:seeAlso and rdfs:subClassOf are not SHACL predicates but are on shapes all the time (GitHub issue #91);
# sh:name and sh:description stay the SHACL-native annotations. rdfs:label and rdfs:comment sit with them in the naming group.
rdfs:label        sh:group stsh:NamingGroup ; sh:order 3 ; sh:nodeKind sh:Literal .
rdfs:comment      sh:group stsh:NamingGroup ; sh:order 4 ; sh:nodeKind sh:Literal ; stsh:multiline true .
rdfs:seeAlso      sh:group stsh:MetadataGroup ; sh:order 6 ; sh:nodeKind sh:IRI .
rdfs:subClassOf   sh:group stsh:MetadataGroup ; sh:order 7 ; sh:nodeKind sh:IRI .
sh:unit           sh:group stsh:MetadataGroup ; sh:order 8 ; sh:nodeKind sh:IRIOrLiteral .
sh:codeIdentifier sh:group stsh:MetadataGroup ; sh:order 9 ; sh:datatype xsd:string ; sh:nodeKind sh:Literal .
sh:codeType       sh:group stsh:MetadataGroup ; sh:order 10 ; sh:nodeKind sh:IRI .


#############################################################################
# Form-field membership — which predicates appear in NodeShape / PropertyShape forms
#############################################################################

# Non-validating metadata — both shape types
sh:name          stsh:nodeFormField true ; stsh:propertyFormField true .
sh:description   stsh:nodeFormField true ; stsh:propertyFormField true .
sh:message       stsh:nodeFormField true ; stsh:propertyFormField true .
sh:severity      stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:deactivated   stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:order         stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .

# Annotations that are not SHACL predicates, and the other shape-level properties of the vocabulary (domain sh:Shape): both shape types
# (GitHub issue #91)
rdfs:label        stsh:nodeFormField true ; stsh:propertyFormField true .
rdfs:comment      stsh:nodeFormField true ; stsh:propertyFormField true .
rdfs:seeAlso      stsh:nodeFormField true ; stsh:propertyFormField true .
rdfs:subClassOf   stsh:nodeFormField true ; stsh:propertyFormField true .
sh:unit           stsh:nodeFormField true ; stsh:propertyFormField true .
sh:codeIdentifier stsh:nodeFormField true ; stsh:propertyFormField true ; stsh:formMaxCount 1 .
sh:codeType       stsh:nodeFormField true ; stsh:propertyFormField true ; stsh:formMaxCount 1 .
sh:target         stsh:nodeFormField true ; stsh:propertyFormField true .
sh:targetWhere    stsh:nodeFormField true ; stsh:propertyFormField true .
sh:nodeByExpression stsh:nodeFormField true ; stsh:propertyFormField true .

# Closed-shape predicates — NodeShape only
sh:closed            stsh:nodeFormField true ; stsh:formMaxCount 1 .
sh:ignoredProperties stsh:nodeFormField true .

# Property path — PropertyShape only
sh:path       stsh:propertyFormField true ; stsh:formMaxCount 1 .

# Expression constraint: any shape (Node Expressions 7.1), as many as you like
sh:expression stsh:nodeFormField true ; stsh:propertyFormField true .

# Cardinality — PropertyShape only
sh:minCount stsh:propertyFormField true ; stsh:formMaxCount 1 .
sh:maxCount stsh:propertyFormField true ; stsh:formMaxCount 1 .

# Property group assignment — PropertyShape only
sh:group stsh:propertyFormField true ; stsh:formMaxCount 1 .

# Value type — both
sh:nodeKind stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:class    stsh:nodeFormField true ;                       stsh:propertyFormField true .
sh:datatype stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .

# Value range — both
sh:minInclusive stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:maxInclusive stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:minExclusive stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:maxExclusive stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .

# String constraints — both
sh:pattern    stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:flags      stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:minLength  stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:maxLength  stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:uniqueLang stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:languageIn stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .

# Value enumeration — both
sh:in       stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:hasValue stsh:nodeFormField true ;                       stsh:propertyFormField true .

# Default value — both
sh:defaultValue stsh:propertyFormField true .
sh:values stsh:propertyFormField true ; stsh:formMaxCount 1 .

# Value comparison — sh:equals and sh:disjoint on both (shacl_shacl bans only sh:lessThan and sh:lessThanOrEquals on a node shape)
sh:equals           stsh:nodeFormField true ; stsh:propertyFormField true .   # valid on a node shape too (GitHub issue #91)
sh:disjoint         stsh:nodeFormField true ; stsh:propertyFormField true .
sh:lessThan         stsh:propertyFormField true .
sh:lessThanOrEquals stsh:propertyFormField true .

# Qualified value shapes — PropertyShape only
sh:qualifiedMinCount            stsh:propertyFormField true ; stsh:formMaxCount 1 .
sh:qualifiedMaxCount            stsh:propertyFormField true ; stsh:formMaxCount 1 .
sh:qualifiedValueShapesDisjoint stsh:propertyFormField true ; stsh:formMaxCount 1 .

# Generic shape-level predicates — both. Confirmed (not guessed) via the official SHACL 1.2
# WG draft's own meta-shapes, tests/vendor/shacl12-vocabularies/shacl-shacl.ttl's shsh:ShapeShape
# (sh:targetClass sh:NodeShape, sh:PropertyShape; these appear in its sh:targetSubjectsOf list
# and are NOT among shsh:NodeShapeShape's sh:maxCount-0 exclusions).
sh:and              stsh:nodeFormField true ; stsh:propertyFormField true .
sh:node             stsh:nodeFormField true ; stsh:propertyFormField true .
sh:not              stsh:nodeFormField true ; stsh:propertyFormField true .
sh:or               stsh:nodeFormField true ; stsh:propertyFormField true .
sh:property         stsh:nodeFormField true ; stsh:propertyFormField true .
sh:xone             stsh:nodeFormField true ; stsh:propertyFormField true .
sh:memberShape      stsh:nodeFormField true ; stsh:propertyFormField true .
sh:maxListLength    stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:minListLength    stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:uniqueMembers    stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:singleLine       stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:targetClass      stsh:nodeFormField true ; stsh:propertyFormField true .
sh:targetNode       stsh:nodeFormField true ; stsh:propertyFormField true .
sh:targetObjectsOf  stsh:nodeFormField true ; stsh:propertyFormField true .
sh:targetSubjectsOf stsh:nodeFormField true ; stsh:propertyFormField true .

# Same official draft's shsh:NodeShapeShape explicitly forbids this on NodeShape (sh:maxCount 0)
# even though shsh:ShapeShape's own sh:targetSubjectsOf list would otherwise suggest "generic".
# The explicit restriction wins.
sh:qualifiedValueShape stsh:propertyFormField true .

# SHACL-AF constraint/rule attachment — both. Not covered by the vendored official draft above
# (that file only models SHACL Core, not Advanced Features), but sh:sparql/sh:rule attach
# directly to either shape type per the SHACL-AF spec's own semantics, same as sh:and/sh:or/sh:not.
sh:sparql stsh:nodeFormField true ; stsh:propertyFormField true .
sh:rule   stsh:nodeFormField true ; stsh:propertyFormField true .

# New RDF 1.2 / SHACL 1.2 value constraints — both. Not covered by the vendored official draft or
# pySHACL's own shacl-shacl.ttl (both predate these predicates); judged by analogy to their nearest
# SHACL Core siblings, which the official draft *does* confirm as generic: sh:someValue is hasValue's
# list-based generalization, sh:subsetOf/sh:rootClass are set/class-membership comparisons like
# sh:equals's non-Property-restricted cousins, sh:uniqueValuesFor is a cross-property check with no
# node-vs-property asymmetry. See starshacl/assets/shacl12-validation-shapes.ttl's stsh:NewPredicateShapes
# for their value-shape constraints (a separate question from which host shape type they appear on).
sh:someValue      stsh:nodeFormField true ; stsh:propertyFormField true .
sh:subsetOf       stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .
sh:rootClass      stsh:nodeFormField true ; stsh:propertyFormField true .
sh:uniqueValuesFor stsh:nodeFormField true ; stsh:formMaxCount 1 ; stsh:propertyFormField true .

# RDF 1.2 reification constraints — PropertyShape only. Unlike the value constraints just above,
# reifying "the triple `focusNode <path> value`" is only meaningful in the context of a specific
# path, matching sh:minCount/sh:path's own PropertyShape-only treatment rather than sh:hasValue's.
sh:reifierShape        stsh:propertyFormField true ; stsh:formMaxCount 1 .
sh:reificationRequired stsh:propertyFormField true ; stsh:formMaxCount 1 .

# Deliberately NOT given nodeFormField/propertyFormField: predicates that are fields of a NESTED
# sub-form (a Rule, ConstraintComponent, Validator, or node-expression/path definition), not direct
# fields of a NodeShape/PropertyShape editing form. The binary above only answers "does this appear
# on the outer shape's own form" — these need a separate, not-yet-built "which fields belong on a
# <X> sub-form" mechanism, tracked in packages/shacl/CLAUDE.md rather than force-fit here:
#   - Property path operators (nested inside a sh:path value): sh:alternativePath, sh:inversePath,
#     sh:oneOrMorePath, sh:zeroOrMorePath, sh:zeroOrOnePath
#   - Rule/validator/component internals (nested inside sh:rule/sh:validator/sh:ConstraintComponent):
#     sh:condition, sh:select, sh:ask, sh:construct, sh:subject, sh:predicate, sh:object,
#     sh:parameter, sh:validator, sh:nodeValidator, sh:propertyValidator
#   - Class markers used via rdf:type, never as a shape's own predicate: sh:ConstraintComponent,
#     sh:TripleRule, sh:SPARQLRule


#############################################################################
# Node expression predicate rendering hints
# These apply to node expression BNodes and named node expression IRIs.
# The editor uses stsh:NodeExpressionGroup for ordering within a node
# expression form; sh:filterShape appears in both sh:PathGroup (on
# PropertyShape) and stsh:NodeExpressionGroup (on expressions).
#############################################################################

# sh:name and sh:description also apply to node expressions as identity annotations, but they keep the one group and
# order they have in stsh:MetadataGroup: a predicate has a single sh:order, so it cannot also be ordered first here.
sh:union          sh:group stsh:NodeExpressionGroup ; sh:order 10 .
sh:intersection   sh:group stsh:NodeExpressionGroup ; sh:order 11 .
sh:nodes          sh:group stsh:NodeExpressionGroup ; sh:order 12 .
sh:constant       sh:group stsh:NodeExpressionGroup ; sh:order 13 .
sh:function       sh:group stsh:NodeExpressionGroup ; sh:order 14 .
sh:arguments      sh:group stsh:NodeExpressionGroup ; sh:order 15 .
sh:filterShape    sh:group stsh:NodeExpressionGroup ; sh:order 16 .


#############################################################################
# Form shapes: what is added by hand to the generated ones (scripts/build_shacl_ui.py writes NodeShapeForm and PropertyShapeForm)
#############################################################################

stsh:formFor a rdf:Property ;
    rdfs:label "form for"@en ;
    rdfs:comment "The class of node a form shape is the form for (sh:NodeShape, sh:PropertyShape, sh:PropertyGroup, ...). A tool picks the form for a node by its type and passes the form to select_widgets as shape_node. It is not sh:targetClass on purpose: a form shape with no sh:target* is not applied to anything, so loading it never changes what validates."@en .

# The link from a shape to the shapes graph that defines it (SHACL 1.2 Profiling section 2.4): a field of both forms.
rdfs:isDefinedBy stsh:nodeFormField true ; stsh:propertyFormField true ; stsh:formMaxCount 1 ;
    sh:group stsh:MetadataGroup ; sh:order 5 .

# rdf:type: a simple multi-valued IRI, the first field of both forms. A UI-only node kind (shacl_shacl has no rule for it) lets the
# scoring pick the IRI editor and the honesty check give it a sample.
rdf:type stsh:nodeFormField true ; stsh:propertyFormField true ; sh:group stsh:TypeGroup ; sh:order 1 ; sh:nodeKind sh:IRI .

# A property shape's own widget fields (shui: preferences): a field of the property shape form only.
shui:editor stsh:propertyFormField true ; sh:nodeKind sh:IRI .
shui:viewer stsh:propertyFormField true ; sh:nodeKind sh:IRI .
shui:propertyRole stsh:propertyFormField true ; sh:nodeKind sh:IRI .

# stsh:secondary is the mark on a FIELD of a generated form: allowed but not commonly expected there, so a tool may show it
# in a collapsed section. The generator sets it on a field of the node shape form for each predicate flagged
# stsh:nodePrimary false above (sh:datatype or sh:pattern on a node shape is legal but unusual; on a property shape they are
# the normal case, so the property shape form has no such mark).
stsh:secondary a rdf:Property ;
    rdfs:label "secondary"@en ;
    rdfs:comment "True on a field of a form shape when the predicate is allowed but not commonly expected for that kind of node; a tool may show it in a collapsed section. Absent is treated as false. Generated from stsh:nodePrimary false for the node shape form."@en ;
    rdfs:range xsd:boolean .

# ---- Forms for the other kinds of element a shapes graph holds (GitHub issues #89, #105, #67)
# Each form below is generated like the two above, from a list of the predicates that are its fields: the field takes its group, order,
# maximum count, datatype and node kind from the predicate's own annotations in this file (so a predicate has one place whatever the
# kind: GitHub issue #92) and what shacl_shacl says of it (but not its minimum count: a form lists what it requires in stsh:formRequired,
# because the same predicate is required in one kind and optional in another: sh:select of a SPARQL function or a validator).
# rdf:type is the first field of every form (GitHub issue #105): the type is what makes a node that kind of element.

stsh:formFields a rdf:Property ;
    rdfs:label "form fields"@en ;
    rdfs:comment "The predicates that are the fields of a form shape generated from this source: a list. The build makes one property shape per predicate (named stsh:<Form>_<prefix>_<local>), with that predicate's group, order, maximum count, datatype and node kind. The list is documentation in the built file; the order of the fields is their sh:order."@en .

stsh:formRequired a rdf:Property ;
    rdfs:label "form required"@en ;
    rdfs:comment "The predicates of stsh:formFields that a node of this kind must have: each field gets sh:minCount 1."@en .

# A property group's form: its name (and SHACL Core's rdfs:label), its order among the groups, and the shapes graph that defines it.
stsh:PropertyGroupForm a sh:NodeShape ;
    stsh:formFor sh:PropertyGroup ;
    stsh:formFields ( rdf:type sh:name sh:description rdfs:label rdfs:comment sh:order rdfs:isDefinedBy ) .

# A shapes graph's form (SHACL 1.2 Profiling section 2): its label, the shapes it uses that another shapes graph defines
# (rdfs:member), the shapes graphs it depends on (owl:imports), its entailment regime, and prefix declarations (sh:declare). The same
# form serves an ontology node that holds prefix declarations (the W3C tests put sh:declare on an untyped ontology IRI too).
stsh:ShapesGraphForm a sh:NodeShape ;
    stsh:formFor sh:ShapesGraph ;
    stsh:formFields ( rdf:type rdfs:label rdfs:comment rdfs:member owl:imports sh:entailment sh:declare rdfs:isDefinedBy ) .

# A prefix declaration, the value of sh:declare (SHACL 1.2 Core section 5.2): a small node with a prefix and a namespace.
stsh:PrefixDeclarationForm a sh:NodeShape ;
    stsh:formFor sh:PrefixDeclaration ;
    stsh:formFields ( rdf:type sh:prefix sh:namespace ) ;
    stsh:formRequired ( sh:prefix sh:namespace ) .

# A SPARQL constraint, the value of sh:sparql.
stsh:SPARQLConstraintForm a sh:NodeShape ;
    stsh:formFor sh:SPARQLConstraint ;
    stsh:formFields ( rdf:type sh:select sh:prefixes rdfs:label rdfs:comment sh:message sh:severity sh:deactivated ) ;
    stsh:formRequired ( sh:select ) .

# The two kinds of SPARQL rule: a SPARQL CONSTRUCT rule and a triple rule (SHACL 1.2 Inference Rules sections 11.1 and 11.2).
# A triple rule's subject, predicate and object are all optional: an absent one is the focus node (section 11.2).
stsh:SPARQLRuleForm a sh:NodeShape ;
    stsh:formFor sh:SPARQLRule ;
    stsh:formFields ( rdf:type sh:construct sh:prefixes sh:condition sh:layer sh:runOnce sh:expectedPredicate rdfs:label rdfs:comment sh:order sh:deactivated ) ;
    stsh:formRequired ( sh:construct ) .

stsh:TripleRuleForm a sh:NodeShape ;
    stsh:formFor sh:TripleRule ;
    stsh:formFields ( rdf:type sh:subject sh:predicate sh:object sh:condition sh:layer sh:runOnce sh:expectedPredicate rdfs:label rdfs:comment sh:order sh:deactivated ) .

# A constraint component (SHACL-AF 6): its parameters and the validators that check them.
stsh:ConstraintComponentForm a sh:NodeShape ;
    stsh:formFor sh:ConstraintComponent ;
    stsh:formFields ( rdf:type sh:parameter sh:validator sh:nodeValidator sh:propertyValidator sh:labelTemplate rdfs:label rdfs:comment ) ;
    stsh:formRequired ( sh:parameter ) .

# A parameter of a constraint component or a function: a property shape (sh:Parameter is a subclass of sh:PropertyShape), so it orders
# its fields as a property shape does, plus whether it is optional and whether it is the key.
stsh:ParameterForm a sh:NodeShape ;
    stsh:formFor sh:Parameter ;
    stsh:formFields ( rdf:type sh:path sh:name sh:description rdfs:label rdfs:comment sh:class sh:datatype sh:nodeKind sh:optional sh:keyParameter sh:defaultValue sh:order ) ;
    stsh:formRequired ( sh:path ) .

# The validators of a constraint component.
stsh:AskValidatorForm a sh:NodeShape ;
    stsh:formFor sh:SPARQLAskValidator ;
    stsh:formFields ( rdf:type sh:ask sh:prefixes rdfs:label rdfs:comment sh:message ) ;
    stsh:formRequired ( sh:ask ) .

stsh:SelectValidatorForm a sh:NodeShape ;
    stsh:formFor sh:SPARQLSelectValidator ;
    stsh:formFields ( rdf:type sh:select sh:prefixes rdfs:label rdfs:comment sh:message ) ;
    stsh:formRequired ( sh:select ) .

# Functions: a function with a return type and parameters; a SPARQL function, whose body is a query.
stsh:FunctionForm a sh:NodeShape ;
    stsh:formFor sh:Function ;
    stsh:formFields ( rdf:type sh:parameter sh:returnType rdfs:label rdfs:comment ) .

stsh:SPARQLFunctionForm a sh:NodeShape ;
    stsh:formFor sh:SPARQLFunction ;
    stsh:formFields ( rdf:type sh:select sh:ask sh:prefixes sh:parameter sh:returnType rdfs:label rdfs:comment ) .

# A SPARQL target, the value of sh:target.
stsh:SPARQLTargetForm a sh:NodeShape ;
    stsh:formFor sh:SPARQLTarget ;
    stsh:formFields ( rdf:type sh:select sh:prefixes rdfs:label rdfs:comment ) ;
    stsh:formRequired ( sh:select ) .

# A widget score of SHACL UI (a scoring catalog entry).
stsh:WidgetScoreForm a sh:NodeShape ;
    stsh:formFor shui:WidgetScore ;
    stsh:formFields ( rdf:type shui:widget shui:score shui:shapesGraphShape shui:dataGraphShape rdfs:label rdfs:comment ) ;
    stsh:formRequired ( shui:widget shui:score ) .

# What the predicates of those forms take (the rest of what a field says comes from shacl_shacl where it has a rule).
sh:select sh:nodeKind sh:Literal ; stsh:formMaxCount 1 ; stsh:multiline true .
sh:ask sh:nodeKind sh:Literal ; stsh:formMaxCount 1 ; stsh:multiline true .
sh:construct sh:nodeKind sh:Literal ; stsh:formMaxCount 1 ; stsh:multiline true .
sh:prefixes sh:nodeKind sh:BlankNodeOrIRI .       # a node that holds sh:declare values: a shapes graph, an ontology, any resource
sh:declare sh:nodeKind sh:BlankNodeOrIRI .
sh:prefix sh:nodeKind sh:Literal ; stsh:formMaxCount 1 .
sh:namespace sh:nodeKind sh:IRIOrLiteral ; stsh:formMaxCount 1 .   # xsd:anyURI or xsd:string
sh:condition sh:nodeKind sh:BlankNodeOrIRI .      # a shape, or a list of shapes
sh:layer sh:nodeKind sh:Literal ; sh:datatype xsd:integer ; stsh:formMaxCount 1 .
sh:runOnce sh:nodeKind sh:Literal ; sh:datatype xsd:boolean ; stsh:formMaxCount 1 .
sh:expectedPredicate sh:nodeKind sh:IRI .
sh:labelTemplate sh:nodeKind sh:Literal ; stsh:formMaxCount 1 .
sh:parameter sh:nodeKind sh:BlankNodeOrIRI .
sh:validator sh:nodeKind sh:BlankNodeOrIRI ; stsh:formMaxCount 1 .
sh:nodeValidator sh:nodeKind sh:BlankNodeOrIRI ; stsh:formMaxCount 1 .
sh:propertyValidator sh:nodeKind sh:BlankNodeOrIRI ; stsh:formMaxCount 1 .
sh:returnType sh:nodeKind sh:IRI ; stsh:formMaxCount 1 .
sh:bodyExpression sh:nodeKind sh:BlankNodeOrIRI ; stsh:formMaxCount 1 .
sh:optional sh:nodeKind sh:Literal ; sh:datatype xsd:boolean ; stsh:formMaxCount 1 .
sh:keyParameter sh:nodeKind sh:Literal ; sh:datatype xsd:boolean ; stsh:formMaxCount 1 .
sh:entailment sh:nodeKind sh:IRI .
rdfs:member sh:nodeKind sh:IRI .
owl:imports sh:nodeKind sh:IRI .
shui:widget sh:nodeKind sh:BlankNodeOrIRI ; stsh:formMaxCount 1 .
shui:score sh:nodeKind sh:Literal ; stsh:formMaxCount 1 .
shui:shapesGraphShape sh:nodeKind sh:BlankNodeOrIRI ; stsh:formMaxCount 1 .
shui:dataGraphShape sh:nodeKind sh:BlankNodeOrIRI ; stsh:formMaxCount 1 .

# ---- What a field's values can be (sh:nodeKind), for a tool that shows a shape as a tree and a panel
# The form shapes copy a predicate's datatype, node kind and class from shacl_shacl where it has one. These are the predicates where it
# has none (its rule is an sh:or, a list, or nothing), so the form would not say what the values are. A tool decides from this whether
# a property's values can be blank nodes: if they can, the property is a branch of a tree (sh:property, sh:node); if they cannot, it is a
# field of the panel (an IRI as a link, a literal as text). A form may be stricter than validation: what is stated here wins.
# Values that are lists (sh:in, sh:languageIn, sh:ignoredProperties; sh:and, sh:or, sh:xone) are not covered by a node kind: the head
# of a list is a blank node, and a tool treats lists as the SHACL vocabulary defines them.

# literals
sh:name        sh:nodeKind sh:Literal .
sh:description sh:nodeKind sh:Literal .
sh:message     sh:nodeKind sh:Literal .
sh:order       sh:nodeKind sh:Literal .
sh:closed      sh:nodeKind sh:Literal .

# IRIs only: a class, a datatype, a node kind, a group, the graph that defines a shape
sh:class          sh:nodeKind sh:IRI .
sh:datatype       sh:nodeKind sh:IRI .
sh:nodeKind       sh:nodeKind sh:IRI .
sh:rootClass      sh:nodeKind sh:IRI .
sh:uniqueValuesFor sh:nodeKind sh:IRI .
sh:group          sh:nodeKind sh:IRI .
rdfs:isDefinedBy  sh:nodeKind sh:IRI .

# an IRI or a literal, never a blank node
sh:hasValue  sh:nodeKind sh:IRIOrLiteral .
sh:targetNode sh:nodeKind sh:IRIOrLiteral .

# a shape or another node with fields of its own: a blank node or an IRI
sh:property           sh:nodeKind sh:BlankNodeOrIRI .
sh:node               sh:nodeKind sh:BlankNodeOrIRI .
sh:not                sh:nodeKind sh:BlankNodeOrIRI .
sh:qualifiedValueShape sh:nodeKind sh:BlankNodeOrIRI .
sh:reifierShape       sh:nodeKind sh:BlankNodeOrIRI .
sh:and                sh:nodeKind sh:BlankNodeOrIRI .
sh:or                 sh:nodeKind sh:BlankNodeOrIRI .
sh:xone               sh:nodeKind sh:BlankNodeOrIRI .
sh:someValue          sh:nodeKind sh:BlankNodeOrIRI .   # takes a shape (rdfs:range sh:Shape), not a plain value (GitHub issue #67)
sh:target             sh:nodeKind sh:BlankNodeOrIRI .
sh:targetWhere        sh:nodeKind sh:BlankNodeOrIRI .
sh:nodeByExpression   sh:nodeKind sh:BlankNodeOrIRI .
sh:rule               sh:nodeKind sh:BlankNodeOrIRI .
sh:sparql             sh:nodeKind sh:BlankNodeOrIRI .
sh:expression         sh:nodeKind sh:BlankNodeOrIRI .

#############################################################################
# Well-formedness of shui: terms (moved here from shacl_shacl, 2026-10-23, GitHub issue #23)
#############################################################################
# Unlike the form shapes, these two DO validate: load this graph beside shacl_shacl
# (meta_validate(shapes, extra_graphs=[ui])) to have shui: terms in a shapes graph checked.

stsh:ShuiPredicateShapes
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for shui: predicates"@en ;
	sh:targetSubjectsOf shui:editor, shui:viewer, shui:propertyRole ;

	sh:property [
		sh:path shui:editor ;
		sh:nodeKind sh:IRI ;                     # editor-nodeKind: references a shui:Editor instance (built-in or custom), always an IRI
	] ;
	sh:property [
		sh:path shui:viewer ;
		sh:nodeKind sh:IRI ;                     # viewer-nodeKind: references a shui:Viewer instance, always an IRI
	] ;
	sh:property [
		sh:path shui:propertyRole ;
		sh:nodeKind sh:IRI ;                     # propertyRole-nodeKind: references a shui:PropertyRole instance (e.g. shui:LabelRole), always an IRI
	] .

stsh:WidgetScoreShape
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for shui:WidgetScore"@en ;
	sh:targetClass shui:WidgetScore ;

	sh:property [
		sh:path shui:widget ;
		sh:minCount 1 ;
		sh:maxCount 1 ;
		sh:nodeKind sh:BlankNodeOrIRI ;           # widget-nodeKind: the widget being scored, a named or anonymous widget instance
	] ;
	sh:property [
		sh:path shui:score ;
		sh:minCount 1 ;
		sh:maxCount 1 ;
		sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ; # score-datatype: xsd:decimal or xsd:integer, per the upstream shape
	] ;
	sh:property [
		sh:path shui:dataGraphShape ;
		sh:maxCount 1 ;
		sh:nodeKind sh:BlankNodeOrIRI ;           # dataGraphShape-nodeKind: optional, per the upstream shape
	] ;
	sh:property [
		sh:path shui:shapesGraphShape ;
		sh:maxCount 1 ;
		sh:nodeKind sh:BlankNodeOrIRI ;           # shapesGraphShape-nodeKind: optional, per the upstream shape
	] .
