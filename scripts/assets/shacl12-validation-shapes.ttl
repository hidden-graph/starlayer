# baseURI: https://github.com/hidden-graph/starlayer/ns/shacl#
#
# Our additions to the W3C Data Shapes Working Group's SHACL-for-SHACL (the pinned copy in
# scripts/assets/vendor/w3c-shacl-shacl.ttl). scripts/build_meta_shapes.py merges the two by ADDING: nothing in the
# Working Group's file is deleted or edited.
#
# This file holds:
#   (1) well-formedness rules for SHACL 1.2 predicates the Working Group's file has no rule for yet (sh:someValue,
#       sh:subsetOf, sh:rootClass, sh:uniqueValuesFor, sh:reifierShape, sh:reificationRequired), plus one addition to its
#       sh:memberShape rule (a value must be a blank node or IRI). The Working Group's own rules for sh:memberShape,
#       sh:singleLine, sh:minListLength, sh:maxListLength and sh:uniqueMembers are not repeated here;
#   (2) replacement rules for the parameters whose value space SHACL 1.2 widened and that the Working Group's file
#       still rejects: sh:nodeKind as a list, and sh:equals, sh:disjoint, sh:lessThan, sh:lessThanOrEquals as a path
#       (stsh:ShapeShapeOverrides);
#   (3) rules for sh:name, sh:description, sh:order, sh:group, sh:defaultValue and sh:PropertyGroup;
#   (4) our own stsh: shapes (rules, node expressions, SPARQL, UI hints) and documentation of the terms.
#
# For (2), SHACL constraints combine by AND, so a looser rule added beside a strict one changes nothing. The build
# therefore switches the Working Group's strict rule off with sh:deactivated true (build_meta_shapes.py,
# RELAXED_PATHS) and these shapes take over. sh:class, sh:datatype and sh:closed were handled this way too until the
# Working Group fixed them (2026-10-12); test_wg_overrides.py fails when it fixes another, so its entry can go.
#
# Also includes 4 gaps found 2026-08-01 by diffing against the official
# SHACL 1.2 WG's own draft meta-shapes (scripts/assets/vendor/
# w3c-shacl-shacl.ttl - see docs/shacl12-gap-matrix.md's "Official SHACL 1.2
# meta-shapes (shsh:) comparison" section for the full writeup): sh:
# DataGraph/owl:imports well-formedness, sh:in/sh:xone satisfiability
# warnings, sh:ignoredProperties/sh:languageIn minimum list length, and a
# correction to sh:memberShape's own well-formedness rule (must be a node
# shape specifically, not a property shape - previously accepted either).
#
# Reusable standalone by any SHACL 1.2-aware tooling (e.g. a shapes-graph
# editor) that wants "is this shapes graph well-formed" coverage for these
# predicates without depending on starShacl/pySHACL directly - the only
# external dependency this file has is pySHACL's own well-known
# shsh:ListShape / shsh:PathNodeShape / shsh:NodeShapeShape /
# shsh:PropertyShapeShape (http://www.w3.org/ns/shacl-shacl#), reused
# rather than re-derived, for the list-, path-, and shape-valued
# predicates below.
#
# Division of responsibility with shacl12-presentation-shapes.ttl: this
# file owns the single canonical (@en) rdfs:label/rdfs:comment/sh:name/
# sh:description for anything it defines, including the stsh: vocabulary
# root itself below - the presentation file never re-describes them, only
# adds genuinely UI-specific content on top (sh:order/sh:group, additional
# language-variant sh:name/sh:description values, future widget
# assignment). Avoids two files each declaring their own root label/comment
# once merged into one graph.

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix shsh: <http://www.w3.org/ns/shacl-shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix stsh: <https://github.com/hidden-graph/starlayer/ns/shacl#> .

stsh:
	rdfs:label "starShacl SHACL 1.2 Meta-Shapes"@en ;
	rdfs:comment "Supplementary SHACL 1.2 Core well-formedness rules and UI/presentation metadata, meant to be merged with pySHACL's own bundled shacl-shacl.ttl. See shacl12-validation-shapes.ttl (this file) for validation rules and shacl12-presentation-shapes.ttl for UI-specific metadata."@en .

#############################################################################
# Reusable building blocks
#############################################################################

stsh:IRIOrListOfIRIsShape
	a sh:NodeShape ;
	rdfs:label "IRI or list of IRIs"@en ;
	rdfs:comment "SHACL 1.2 widened several single-IRI-valued parameters (sh:class, sh:datatype, sh:rootClass, sh:uniqueValuesFor) to also accept a well-formed SHACL list of IRIs, meaning a union of the listed values."@en ;
	sh:or (
		[ sh:nodeKind sh:IRI ]
		[ sh:node shsh:ListShape ;
		  sh:property [
			sh:path [ sh:zeroOrMorePath rdf:rest ] ;
			sh:property [ sh:path rdf:first ; sh:nodeKind sh:IRI ] ;
		  ]
		]
	) .

stsh:IRIOrPathShape
	a sh:NodeShape ;
	rdfs:label "IRI or SHACL property path"@en ;
	rdfs:comment "SHACL 1.2 widened sh:equals/sh:disjoint/sh:lessThan/sh:lessThanOrEquals from a single comparison-property IRI to a full SHACL property path expression. Reuses the Working Group's shsh:PathNodeShape (present once this file is merged with the Working Group's meta-shapes graph) rather than re-deriving SHACL's path grammar."@en ;
	sh:or (
		[ sh:nodeKind sh:IRI ]
		[ sh:node shsh:PathNodeShape ]
	) .

stsh:TargetNodeValueShape
	a sh:NodeShape ;
	rdfs:label "Value of sh:targetNode: an IRI, a literal, or a node expression"@en ;
	rdfs:comment "SHACL 1.2 lets sh:targetNode take a node expression that computes the target nodes (Node Expressions, 'Getting Started'), and the validator also accepts a blank node carrying sh:select. The Working Group's rule gives sh:targetNode sh:nodeKind sh:IRIOrLiteral, which rejects both (GitHub issue #66). A blank node must be a well-formed node expression (stsh:NodeExpressionShape) or carry sh:select; a blank node with some other predicate is still rejected."@en ;
	sh:or (
		[ sh:nodeKind sh:IRIOrLiteral ]
		[ sh:nodeKind sh:BlankNode ;
		  sh:or (
			stsh:NodeExpressionShape
			[ sh:property [ sh:path sh:select ; sh:minCount 1 ] ]
		  )
		]
	) .

stsh:ShapeReferenceShape
	a sh:NodeShape ;
	rdfs:label "Well-formed shape reference"@en ;
	rdfs:comment "Used for SHACL 1.2 predicates whose value must itself be a well-formed shape (sh:someValue, sh:memberShape, sh:reifierShape). sh:node's semantics evaluate the referenced shape's own constraint components regardless of that shape's own targets, so referencing shsh:ShapeShape here checks full shape well-formedness, not just the node/property-shape distinction. sh:nodeKind is added on top because the Working Group's shsh:ShapeShape doesn't itself enforce blank-node-or-IRI - a bare literal vacuously satisfies shsh:NodeShapeShape's xone branch (every one of its checks is a maxCount 0 'must not have' rule, trivially true for a literal with no outgoing properties at all), so without this a literal value would incorrectly pass as 'a well-formed shape'."@en ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:node shsh:ShapeShape .

#############################################################################
# Replacement rules for SHACL 1.2-widened parameters
#############################################################################
# The Working Group's shsh:ShapeShape still enforces the old SHACL 1.0/1.1 single-value shape for these five paths.
# build_meta_shapes.py switches its rules off with sh:deactivated (RELAXED_PATHS), so these replacements are the
# only ones that apply instead of being ANDed against the too-strict rule.

stsh:ShapeShapeOverrides
	a sh:NodeShape ;
	rdfs:label "SHACL 1.2 replacement rules for widened parameters the Working Group file still rejects"@en ;
	sh:targetSubjectsOf sh:nodeKind, sh:equals, sh:disjoint, sh:lessThan, sh:lessThanOrEquals, sh:targetNode ;

	sh:property [
		sh:path sh:targetNode ;
		sh:node stsh:TargetNodeValueShape ;     # targetNode-nodeKind, replaces the Working Group's IRI-or-literal-only rule
	] ;

	sh:property [
		sh:path sh:nodeKind ;
		sh:or (
				[ sh:in ( sh:BlankNode sh:IRI sh:Literal sh:BlankNodeOrIRI sh:BlankNodeOrLiteral sh:IRIOrLiteral sh:TripleTerm ) ]
			[ sh:node shsh:ListShape ;
			  sh:property [
				sh:path [ sh:zeroOrMorePath rdf:rest ] ;
				sh:property [
					sh:path rdf:first ;
					sh:in ( sh:BlankNode sh:IRI sh:Literal sh:BlankNodeOrIRI sh:BlankNodeOrLiteral sh:IRIOrLiteral sh:TripleTerm ) ;
				] ;
			  ]
			]
		) ;                                     # nodeKind-in, replaces the Working Group's single-value-only rule
		sh:maxCount 1 ;                         # nodeKind-maxCount, as in the Working Group's rule
	] ;
	sh:property [
		sh:path sh:equals ;
		sh:node stsh:IRIOrPathShape ;           # equals-nodeKind, replaces the Working Group's IRI-only rule
	] ;
	sh:property [
		sh:path sh:disjoint ;
		sh:node stsh:IRIOrPathShape ;           # disjoint-nodeKind, replaces the Working Group's IRI-only rule
	] ;
	sh:property [
		sh:path sh:lessThan ;
		sh:node stsh:IRIOrPathShape ;           # lessThan-nodeKind, replaces the Working Group's IRI-only rule
	] ;
	sh:property [
		sh:path sh:lessThanOrEquals ;
		sh:node stsh:IRIOrPathShape ;           # lessThanOrEquals-nodeKind, replaces the Working Group's IRI-only rule
	] .

#############################################################################
# Additive rules for brand-new SHACL 1.2 predicates
#############################################################################
# Each rule matches exactly what the corresponding component in
# starshacl/native_components.py actually parses and accepts, not a
# broader or narrower reading of the spec.

stsh:NewPredicateShapes
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for new SHACL 1.2 predicates"@en ;
	sh:targetSubjectsOf sh:someValue, sh:subsetOf, sh:rootClass, sh:uniqueValuesFor, sh:memberShape,
		sh:reifierShape, sh:reificationRequired ;

	sh:property [
		sh:path sh:someValue ;
		sh:node stsh:ShapeReferenceShape ;
		sh:maxCount 1 ;                         # someValue-maxCount (SomeValueConstraintComponent.__init__ takes one)
	] ;
	sh:property [
		sh:path sh:subsetOf ;
		sh:nodeKind sh:IRI ;                     # subsetOf-nodeKind (simple-IRI comparison path only)
		sh:maxCount 1 ;                          # subsetOf-maxCount
	] ;
	sh:property [
		sh:path sh:rootClass ;
		sh:node stsh:IRIOrListOfIRIsShape ;      # rootClass-nodeKind (IRI or list of IRIs; multiple triples allowed, no maxCount)
	] ;
	sh:property [
		sh:path sh:uniqueValuesFor ;
		sh:node stsh:IRIOrListOfIRIsShape ;      # uniqueValuesFor-nodeKind (IRI or list of IRIs)
		sh:maxCount 1 ;                          # uniqueValuesFor-maxCount
	] ;
	sh:property [
		sh:path sh:memberShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;          # memberShape-nodeKind (reject a vacuously-passing literal - see stsh:ShapeReferenceShape's own rdfs:comment). The Working Group's file already requires sh:node shsh:NodeShapeShape and has no nodeKind rule, so this is the only part of the rule that is ours.
	] ;
	sh:property [
		sh:path sh:reifierShape ;
		sh:node stsh:ShapeReferenceShape ;       # reifierShape-node
		sh:maxCount 1 ;                          # reifierShape-maxCount
	] ;
	sh:property [
		sh:path sh:reificationRequired ;
		sh:datatype xsd:boolean ;                # reificationRequired-datatype
		sh:maxCount 1 ;                          # reificationRequired-maxCount
	] .

#############################################################################
# Gaps closed 2026-08-01 by comparing against the official SHACL 1.2 WG
# draft meta-shapes (scripts/assets/vendor/w3c-shacl-shacl.ttl,
# see docs/shacl12-gap-matrix.md's "Official SHACL 1.2 meta-shapes (shsh:)
# comparison" section) - none of these are among the 11 new predicates
# this file otherwise tracks; found only by diffing against the official
# draft, not from this project's own spec reading.
#############################################################################

stsh:DataGraphImportsShape
	a sh:NodeShape ;
	rdfs:label "sh:DataGraph owl:imports resolution note"@en ;
	rdfs:comment "Mirrors the official SHACL 1.2 WG draft's own shsh:DataGraphImportsShape: per the OWL RDF mapping's 'Resolving Included RDF Graphs' section (which the owl:imports mechanism relies on), a sh:DataGraph using owl:imports should explicitly assert its own rdf:type owl:Ontology for that resolution to behave as the mapping specifies. Info severity in both files - a hint, not a violation."@en ;
	sh:message "In light of the OWL RDF mapping section \"Resolving Included RDF Graphs\" and its reliance on certain triples being present, sh:DataGraphs using owl:imports should explicitly include the type owl:Ontology."@en ;
	sh:severity sh:Info ;
	sh:targetClass sh:DataGraph ;
	sh:or (
		[ sh:property [ sh:path owl:imports ; sh:maxCount 0 ] ]
		[ sh:property [ sh:path rdf:type ; sh:hasValue owl:Ontology ] ]
	) .

stsh:InXoneSatisfiabilityShapes
	a sh:NodeShape ;
	rdfs:label "sh:in / sh:xone satisfiability check"@en ;
	rdfs:comment "sh:in mirrors the official SHACL 1.2 WG draft's own shsh:inSubjectsShape exactly - Warning severity, since an empty sh:in list is soft-ignorable (confirmed live: allow_warnings=True lets it through cleanly, no crash). sh:xone deliberately diverges from the official draft's own shsh:xoneSubjectsShape (which uses Warning there too): pySHACL's own shape LOADER unconditionally rejects an empty sh:and/sh:or/sh:xone list with a raw ShapeLoadError the moment real validation runs, regardless of meta-shacl or allow_warnings - confirmed live for all three predicates. A Warning severity here would imply a working allow_warnings escape hatch that doesn't actually exist for sh:xone (unlike sh:in), trading a clear meta-shacl report for an uglier crash later - so this is Violation, an honest reflection of what's actually unconditionally enforced, not a hint."@en ;
	sh:targetSubjectsOf sh:in, sh:xone ;
	sh:property [
		sh:path sh:in ;
		sh:minListLength 1 ;                     # in-minListLength (Warning - genuinely soft, allow_warnings works)
		sh:severity sh:Warning ;
	] ;
	sh:property [
		sh:path sh:xone ;
		sh:minListLength 1 ;                     # xone-minListLength (Violation - pySHACL's own loader enforces this unconditionally anyway)
	] .

stsh:IgnoredPropertiesLanguageInMinListLengthShapes
	a sh:NodeShape ;
	rdfs:label "sh:ignoredProperties / sh:languageIn minimum list length"@en ;
	rdfs:comment "Mirrors the official SHACL 1.2 WG draft's own minListLength additions to shsh:ShapeShape for these two predicates - an empty sh:ignoredProperties or sh:languageIn list is rejected outright (Violation, unlike the Warning-level sh:in/sh:xone checks above, matching the official draft's own severity choice for these two - no explicit sh:severity override there either). Purely additive: pySHACL's own bundled base graph already correctly checks list-of-IRI/list-of-string membership for both, unmodified and untouched here - only the missing minimum-length check is added."@en ;
	sh:targetSubjectsOf sh:ignoredProperties, sh:languageIn ;
	sh:property [
		sh:path sh:ignoredProperties ;
		sh:minListLength 1 ;                     # ignoredProperties-minListLength
	] ;
	sh:property [
		sh:path sh:languageIn ;
		sh:minListLength 1 ;                     # languageIn-minListLength
	] .

#############################################################################
# Well-formedness rules for SHACL 1.2 Rules / SPARQL Extensions predicates
#############################################################################
# Structural requirements mirror exactly what pySHACL itself enforces at
# runtime, confirmed by direct source reading (not guessed): pySHACL's own
# pyshacl/rules/triple/__init__.py (TripleRule), pyshacl/rules/sparql/
# __init__.py (SPARQLRule), pyshacl/rules/shacl_rule.py (sh:condition),
# pyshacl/constraints/sparql/sparql_based_constraints.py (plain sh:sparql),
# pyshacl/constraints/constraint_component.py
# (CustomConstraintComponentFactory).
#
# Deliberately scoped narrower than full coverage: sh:subject/sh:predicate/
# sh:object's own VALUES (node expressions) are only checked for
# cardinality here, not full recursive well-formedness of the expression
# grammar itself (both old sh: and new shnex: forms would need covering, a
# much larger undertaking). A custom sh:ConstraintComponent's requirement
# that *at least one* validator form (sh:validator/sh:nodeValidator/
# sh:propertyValidator) be present isn't enforced either - only the shape
# of whichever form is actually used. sh:declare/sh:prefix/sh:namespace/
# sh:prefixes and sh:resultAnnotation/etc. aren't covered at all, since
# their functional support was never separately verified. See
# docs/shacl12-gap-matrix.md's "Not Covered / Deferred" for all of these.

stsh:AskValidatorShape
	a sh:NodeShape ;
	rdfs:label "Well-formed ASK validator"@en ;
	rdfs:comment "The value of sh:validator on a custom sh:ConstraintComponent - pySHACL requires exactly one sh:ask (an xsd:string) for this branch (AskConstraintValidator.__init__)."@en ;
	sh:property [
		sh:path sh:ask ;
		sh:datatype xsd:string ;
		sh:minCount 1 ;
		sh:maxCount 1 ;
	] .

stsh:SelectValidatorShape
	a sh:NodeShape ;
	rdfs:label "Well-formed SELECT validator"@en ;
	rdfs:comment "The value of sh:nodeValidator/sh:propertyValidator on a custom sh:ConstraintComponent, and of sh:sparql's own SPARQLConstraint value - pySHACL requires exactly one sh:select (an xsd:string) (SelectConstraintValidator.__init__, SPARQLBasedConstraint.__init__)."@en ;
	sh:property [
		sh:path sh:select ;
		sh:datatype xsd:string ;
		sh:minCount 1 ;
		sh:maxCount 1 ;
	] .

stsh:ShapeOrListOfShapesShape
	a sh:NodeShape ;
	rdfs:label "Well-formed shape, or list of well-formed shapes"@en ;
	rdfs:comment "SHACLRule.get_conditions() accepts sh:condition as either a single shape reference or a SHACL list whose members are each shape references. Uses the same stsh:ShapeReferenceShape as sh:someValue/sh:memberShape/sh:reifierShape - sh:condition is now in starshacl/native_components.py's SHAPE_EXPECTING_PREDICATES too, so starShacl auto-types its value(s) the same way as those three before pySHACL ever runs, whether or not the user's own shapes graph already had explicit sh:NodeShape/sh:PropertyShape typing. One consistent fix strategy for all four, not a stricter one-off for sh:condition."@en ;
	sh:or (
		stsh:ShapeReferenceShape
		[ sh:node shsh:ListShape ;
		  sh:property [
			sh:path [ sh:zeroOrMorePath rdf:rest ] ;
			sh:property [ sh:path rdf:first ; sh:node stsh:ShapeReferenceShape ] ;
		  ]
		]
	) .

#############################################################################
# Well-formedness rules for SHACL node expressions (SHACL 1.2 Node
# Expressions document)
#############################################################################
# sh:subject/sh:predicate/sh:object (sh:TripleRule) each take an arbitrary
# node expression, not just a constant or sh:this - and, per the SHACL 1.2
# Node Expressions spec, the same grammar is reused across sh:sparql target
# expressions, sh:values, etc. Deliberately "shallow but broad": recognizes
# that a value is SOME well-formed node expression form (a constant, a
# blank node carrying one of the ~25 known sh:/shnex: defining predicates,
# or a blank node structurally shaped like a SHACL Function call), without
# verifying the internal correctness of whichever form matched (e.g. does
# not check that shnex:if actually has both shnex:then/shnex:else, does not
# recurse into shnex:concat's own list members). This scope is deliberate -
# see docs/shacl12-gap-matrix.md's "Not Covered / Deferred" - it catches the
# realistic mistake (wrong/typo'd top-level form, or a value that isn't a
# node expression at all) without the effort/risk of a fully exhaustive
# recursive grammar.
#
# One exception: sh:path's own value gets full path-grammar checking for
# free, by reusing pySHACL's own shsh:PathNodeShape (already used above for
# stsh:IRIOrPathShape) - a real, known-correct recursive path grammar
# shape that already exists, so there's no reason not to reuse it here too.
#
# SHACL Functions are open-ended/user-extensible (the defining predicate is
# the function's own IRI, not a fixed vocabulary term), so they can't be
# recognized by name the way every other form can. Matched instead via the
# same structural test pySHACL's own
# pyshacl.helper.expression_helper.nodes_from_node_expression uses for its
# FunctionExpression fallback: some predicate other than sh:message whose
# object is a well-formed (rdf:first-bearing) list. Confirmed necessary,
# not optional - tests/fixtures/shapes/rdf12_node_expression_function.ttl
# already relies on exactly this shape (a real function call in a
# sh:TripleRule's sh:object position).

stsh:NodeExpressionFunctionCallShape
	a sh:NodeShape ;
	rdfs:label "Structurally shaped like a SHACL Function call"@en ;
	rdfs:comment "Matches pyshacl's own FunctionExpression detection: some predicate other than sh:message whose object is a well-formed list (has rdf:first). Structural only - does not confirm the referenced function is actually defined via sh:SPARQLFunction/sh:JSFunction, or that the argument count/types match."@en ;
	sh:sparql [
		sh:message "Value does not look like a SHACL Function call (no predicate other than sh:message has a list-shaped object)."@en ;
		sh:select """
			SELECT $this
			WHERE {
				FILTER NOT EXISTS {
					$this ?p ?o .
					FILTER (?p != <http://www.w3.org/ns/shacl#message>)
					?o <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ?f .
				}
			}
		""" ;
	] .

# Custom Named Parameter Expression Functions (SHACL 1.2 Node Expressions'
# "Custom Node Expressions" section) are called by using one of the
# function's own *key parameters'* sh:path IRIs directly as the call blank
# node's defining predicate (e.g. ex:AverageExpression declares key
# parameter sh:path ex:average, called as "[ ex:average <value> ]") - unlike
# a Custom List Parameter Function call (e.g. "[ ex:spacedConcat ( "a" "b" )
# ]"), the call's object is an arbitrary node expression, not necessarily a
# list, so it can't be recognized by stsh:NodeExpressionFunctionCallShape's
# generic "object is rdf:first-bearing" structural test above - confirmed
# live (`[ ex:average [ shnex:pathValues ex:employee ] ]` was rejected by
# meta_validate() before this shape was added, 2026-09-05). Unlike that
# generic structural test, this one really does need to consult the shapes
# graph itself (a purely structural "single predicate, non-list object" test
# would also match a genuinely malformed predicate like `[ ex:bogusThing
# ex:x ]` - see stsh:NodeExpressionShape's own "malformed forms are
# rejected" tests), so it queries for a real sh:NamedParameterExpressionFunction/
# sh:parameter/sh:path/sh:keyParameter declaration matching the predicate.
stsh:NamedParameterFunctionCallShape
	a sh:NodeShape ;
	rdfs:label "Structurally shaped like a call to a custom Named Parameter Expression Function"@en ;
	rdfs:comment "Matches SHACL 1.2 Node Expressions' Custom Named Parameter Expression call convention: some predicate other than sh:message that is the sh:path of a sh:keyParameter true parameter of some declared sh:NamedParameterExpressionFunction. Structural only - does not confirm sh:bodyExpression is itself well-formed."@en ;
	sh:sparql [
		sh:message "Value does not look like a call to any declared sh:NamedParameterExpressionFunction (no predicate matches a declared key parameter's sh:path)."@en ;
		sh:select """
			SELECT $this
			WHERE {
				FILTER NOT EXISTS {
					$this ?p ?o .
					FILTER (?p != <http://www.w3.org/ns/shacl#message>)
					?param <http://www.w3.org/ns/shacl#path> ?p .
					?param <http://www.w3.org/ns/shacl#keyParameter> true .
					?fn <http://www.w3.org/ns/shacl#parameter> ?param .
					?fn a <http://www.w3.org/ns/shacl#NamedParameterExpressionFunction> .
				}
			}
		""" ;
	] .

# Custom node expression functions (SHACL 1.2 Node Expressions, 6.1 and 6.2): the function is an IRI in a shapes graph (for a list parameter function, the IRI is its
# property) with a single sh:bodyExpression that is a well-formed node expression. sh:labelTemplate (a Parameterizable: a constraint component or a named parameter
# function) has literals of datatype xsd:string, rdf:langString or rdf:dirLangString (SPARQL Extensions 4.2.2).
stsh:CustomFunctionShape
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for a custom node expression function"@en ;
	sh:targetClass sh:NamedParameterExpressionFunction, sh:ListParameterExpressionFunction ;
	sh:nodeKind sh:IRI ;
	sh:message "A custom function is an IRI, not a blank node."@en ;
	sh:property [ sh:path sh:bodyExpression ; sh:minCount 1 ; sh:maxCount 1 ; sh:node stsh:NodeExpressionShape ] .

stsh:LabelTemplateShape
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for sh:labelTemplate"@en ;
	sh:targetSubjectsOf sh:labelTemplate ;
	sh:property [
		sh:path sh:labelTemplate ;
		sh:nodeKind sh:Literal ;
		sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] [ sh:datatype rdf:dirLangString ] ) ;
		sh:message "A label template is a literal of datatype xsd:string, rdf:langString or rdf:dirLangString."@en ;
	] .

stsh:NodeExpressionShape
	a sh:NodeShape ;
	sh:targetClass sh:NodeExpression ;     # typed by starlayer.shacl.shape_types.infer_types (shacl_shacl_rules), GitHub issue #22
	rdfs:label "Well-formed SHACL node expression"@en ;
	rdfs:comment "Accepts a constant (IRI/literal), sh:this, a blank node carrying a known sh:/shnex: node-expression defining predicate, a blank node structurally shaped like a SHACL Function call or a custom List Parameter Function call, or a call to a declared custom Named Parameter Expression Function. Deliberately shallow beyond that - see rdfs:comment on stsh:NodeExpressionFunctionCallShape and the section header above for the exact scope boundary."@en ;
	sh:or (
		[ sh:nodeKind sh:IRIOrLiteral ]
		[ sh:nodeKind sh:BlankNode ;
		  sh:or (
			[ sh:property [ sh:path sh:path ; sh:minCount 1 ; sh:node shsh:PathNodeShape ] ]
			[ sh:property [ sh:path sh:union ; sh:minCount 1 ] ]
			[ sh:property [ sh:path sh:intersection ; sh:minCount 1 ] ]
			[ sh:property [ sh:path sh:nodes ; sh:minCount 1 ] ]
			[ sh:property [ sh:path sh:filterShape ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:pathValues ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:filterShape ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:var ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:if ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:exists ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:distinct ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:remove ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:intersection ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:concat ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:orderBy ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:limit ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:offset ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:flatMap ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:findFirst ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:matchAll ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:count ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:min ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:max ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:sum ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:instancesOf ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:nodesMatching ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:conformsToShape ; sh:minCount 1 ] ]
			[ sh:property [ sh:path shnex:arg ; sh:minCount 1 ] ]
			stsh:NodeExpressionFunctionCallShape
			stsh:NamedParameterFunctionCallShape
		  )
		]
	) .

# The cells of an argument list inside a node expression are typed rdf:List by shacl_shacl_rules (GitHub issue #22); this gives them
# the Working Group's list shape, so that a tool finds a shape for them.
stsh:ExpressionArgumentListShape
	a sh:NodeShape ;
	rdfs:label "A list that is an argument of a node expression is a well-formed RDF list"@en ;
	sh:targetClass rdf:List ;
	sh:node shsh:ListShape .

# sh:expression (Node Expressions 7.1: "can be used in any shape"). The Working Group's shsh:PropertyShapeShape and
# shsh:NodeShapeShape are left as they are: a shape with sh:expression and no sh:path is a node shape (Core: a node
# shape is a shape that is not the subject of sh:path), so it passes shsh:NodeShapeShape and fails shsh:PropertyShapeShape,
# and the Working Group's sh:xone of the two stays exclusive. Only the well-formedness of the value is added here.
stsh:ExpressionConstraintShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:expression"@en ;
	rdfs:comment "SHACL 1.2 Node Expressions 7.1: each value of sh:expression, in any shape, must be a well-formed node expression."@en ;
	sh:targetSubjectsOf sh:expression ;
	sh:property [
		sh:path sh:expression ;
		sh:name "expression"@en ;
		sh:node stsh:NodeExpressionShape ;
		sh:message "sh:expression must be a well-formed node expression"@en ;
	] .

stsh:RuleShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:TripleRule or sh:SPARQLRule"@en ;
	sh:or (
		[ sh:class sh:TripleRule ;
		  # SHACL 1.2 Inference Rules 11.2: "Where sh:subject, sh:predicate, or sh:object are absent, use the list consisting of the current
		  # focus node", so each is optional (at most one). starlayer.shacl.triple_rule implements the default (GitHub issues #82, #67);
		  # pySHACL's own "No sh:subject" is replaced there.
		  sh:property [ sh:path sh:subject ; sh:maxCount 1 ; sh:node stsh:NodeExpressionShape ] ;
		  sh:property [ sh:path sh:predicate ; sh:maxCount 1 ; sh:node stsh:NodeExpressionShape ] ;
		  sh:property [ sh:path sh:object ; sh:maxCount 1 ; sh:node stsh:NodeExpressionShape ] ;
		]
		[ sh:class sh:SPARQLRule ;
		  sh:property [ sh:path sh:construct ; sh:datatype xsd:string ; sh:minCount 1 ] ;  # SPARQLRule.__init__: "No sh:construct on SPARQLRule"
		]
	) .

stsh:RulesAndSparqlShapes
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for sh:sparql / sh:rule / sh:condition"@en ;
	sh:targetSubjectsOf sh:sparql, sh:rule, sh:condition ;

	sh:property [
		sh:path sh:sparql ;
		sh:node stsh:SelectValidatorShape ;      # sparql-node, SPARQLBasedConstraint.__init__ requires exactly one sh:select
	] ;
	sh:property [
		sh:path sh:rule ;
		sh:node stsh:RuleShape ;                 # rule-node
	] ;
	sh:property [
		sh:path sh:condition ;
		sh:node stsh:ShapeOrListOfShapesShape ;  # condition-node
	] .

# Rule sets (SHACL 1.2 Inference Rules, "Rule Sets"): "Instances of this class must be identified by an IRI, not a blank node" (the vocabulary's own comment on sh:RuleSet).
# sh:hasRule adds a rule (a sh:TripleRule or a sh:SPARQLRule: an IRI or a blank node), sh:includesRuleSet includes another rule set (an IRI; inclusion is transitive and a
# cycle is fine). A node that has either property is a rule set, so it is checked even without the type.
stsh:RuleSetShape
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for sh:RuleSet"@en ;
	sh:targetClass sh:RuleSet ;
	sh:targetSubjectsOf sh:hasRule, sh:includesRuleSet ;
	sh:nodeKind sh:IRI ;
	sh:message "A rule set is identified by an IRI, not a blank node."@en ;
	sh:property [ sh:path sh:hasRule ; sh:nodeKind sh:BlankNodeOrIRI ; sh:node stsh:RuleShape ] ;
	sh:property [ sh:path sh:includesRuleSet ; sh:nodeKind sh:IRI ] .

stsh:ConstraintComponentShape
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for sh:ConstraintComponent"@en ;
	sh:targetClass sh:ConstraintComponent ;

	sh:property [
		sh:path sh:parameter ;
		sh:minCount 1 ;                          # CustomConstraintComponentFactory.__new__: "must have at least one value for sh:parameter"
		sh:node [
			a sh:NodeShape ;
			sh:property [ sh:path sh:path ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ;  # each sh:parameter needs exactly one IRI sh:path
		] ;
	] ;
	sh:property [
		sh:path sh:validator ;
		sh:node stsh:AskValidatorShape ;         # validator-node (make_validator_for_shape: plain sh:validator must resolve to an ASK validator)
	] ;
	sh:property [
		sh:path sh:nodeValidator ;
		sh:node stsh:SelectValidatorShape ;      # nodeValidator-node
	] ;
	sh:property [
		sh:path sh:propertyValidator ;
		sh:node stsh:SelectValidatorShape ;      # propertyValidator-node
	] ;
	sh:or (
		[ sh:property [ sh:path sh:validator ; sh:minCount 1 ] ]
		[ sh:property [ sh:path sh:nodeValidator ; sh:minCount 1 ] ]
		[ sh:property [ sh:path sh:propertyValidator ; sh:minCount 1 ] ]
	) .                                           # at-least-one-validator-form, make_validator_for_shape: "Cannot select a validator to use" if none of the three are present

#############################################################################
# Rule settings, where targets, and code hints
#############################################################################
# From the SHACL vocabulary's own ranges. sh:layer is numeric (Inference Rules: "numeric layer", default 0), sh:runOnce an xsd:boolean, sh:expectedPredicate an IRI (a property);
# sh:targetWhere links a shape to a shape that is well formed (Core: "Where Targets"); sh:codeIdentifier is an xsd:string and sh:codeType a datatype IRI (rdfs:Datatype), both
# hints for code generators. SHACL-AF's sh:target is not checked: SPARQL Extensions, Appendix F says SPARQL-based targets are no longer defined.
stsh:RuleSettingsShape
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for sh:layer, sh:runOnce and sh:expectedPredicate"@en ;
	sh:targetSubjectsOf sh:layer, sh:runOnce, sh:expectedPredicate ;
	sh:property [ sh:path sh:layer ; sh:nodeKind sh:Literal ; sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ; sh:message "sh:layer is a number."@en ] ;
	sh:property [ sh:path sh:runOnce ; sh:datatype xsd:boolean ; sh:message "sh:runOnce is an xsd:boolean."@en ] ;
	sh:property [ sh:path sh:expectedPredicate ; sh:nodeKind sh:IRI ] .

stsh:TargetWhereShape
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for sh:targetWhere"@en ;
	sh:targetSubjectsOf sh:targetWhere ;
	sh:property [ sh:path sh:targetWhere ; sh:node stsh:ShapeReferenceShape ] .

stsh:CodeHintsShape
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for sh:codeIdentifier and sh:codeType"@en ;
	sh:targetSubjectsOf sh:codeIdentifier, sh:codeType ;
	sh:property [ sh:path sh:codeIdentifier ; sh:datatype xsd:string ] ;
	sh:property [ sh:path sh:codeType ; sh:nodeKind sh:IRI ] .

#############################################################################
# Parameter declarations (SHACL 1.2 SPARQL Extensions 4.2.1 and Node Expressions 6.1)
#############################################################################
# The values of sh:parameter, whether of a constraint component or of a custom function. The parameter name is the local name of the IRI that is its sh:path;
# every name is a valid SPARQL VARNAME and is not one of this, path, PATH, value, message, failure; two parameters of one holder do not have the same name;
# sh:optional (constraint components) and sh:keyParameter (named parameter functions) have at most one value, an xsd:boolean. A constraint component has at least
# one non-optional parameter; a named parameter function has at least one parameter with sh:keyParameter true. Several shapes graphs together can make a holder
# fail these (a parameter declared in one, the holder in another), so they are errors, not warnings: the combination is what is ill-formed.
stsh:ParameterShape
	a sh:NodeShape ;
	rdfs:label "Well-formed parameter declaration (a value of sh:parameter)"@en ;
	sh:property [
		sh:path sh:path ;
		sh:nodeKind sh:IRI ;
		sh:minCount 1 ;
		sh:maxCount 1 ;
		sh:pattern "[#/][\\p{L}_0-9][\\p{L}_0-9\\u00B7\\u0300-\\u036F\\u203F\\u2040]*$" ;    # the parameter name is a valid SPARQL VARNAME
		sh:message "The local name of the sh:path of a parameter must be a valid SPARQL variable name."@en ;
	] ;
	sh:property [
		sh:path sh:path ;
		sh:not [ sh:pattern "[#/](this|path|PATH|value|message|failure)$" ] ;
		sh:message "A parameter name must not be this, path, PATH, value, message or failure."@en ;
	] ;
	sh:property [ sh:path sh:optional ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
	sh:property [ sh:path sh:keyParameter ; sh:datatype xsd:boolean ; sh:maxCount 1 ] .

stsh:ParameterHolderShapes
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for the holder of sh:parameter"@en ;
	sh:targetSubjectsOf sh:parameter ;
	sh:property [ sh:path sh:parameter ; sh:node stsh:ParameterShape ] ;
	sh:sparql [
		sh:message "Two parameters have the same name (the local name of their sh:path)."@en ;
		sh:select """
			PREFIX sh: <http://www.w3.org/ns/shacl#>
			SELECT DISTINCT $this
			WHERE {
				$this sh:parameter ?a , ?b .
				?a sh:path ?pa . ?b sh:path ?pb .
				FILTER (?a != ?b && REPLACE(STR(?pa), "^.*[#/]", "") = REPLACE(STR(?pb), "^.*[#/]", ""))
			}
		""" ;
	] .

stsh:ComponentNeedsANonOptionalParameterShape
	a sh:NodeShape ;
	rdfs:label "A constraint component has at least one non-optional parameter"@en ;
	sh:targetClass sh:ConstraintComponent ;
	sh:sparql [
		sh:message "Every constraint component has at least one non-optional parameter."@en ;
		sh:select """
			PREFIX sh: <http://www.w3.org/ns/shacl#>
			SELECT $this
			WHERE {
				FILTER EXISTS { $this sh:parameter ?any }
				FILTER NOT EXISTS { $this sh:parameter ?p . FILTER NOT EXISTS { ?p sh:optional true } }
			}
		""" ;
	] .

stsh:NamedParameterFunctionNeedsAKeyParameterShape
	a sh:NodeShape ;
	rdfs:label "A named parameter function has at least one key parameter"@en ;
	sh:targetClass sh:NamedParameterExpressionFunction ;
	sh:sparql [
		sh:message "A custom named parameter function declares at least one parameter with sh:keyParameter true."@en ;
		sh:select """
			PREFIX sh: <http://www.w3.org/ns/shacl#>
			SELECT $this
			WHERE {
				FILTER NOT EXISTS { $this sh:parameter ?p . ?p sh:keyParameter true }
			}
		""" ;
	] .

#############################################################################
# Well-formedness rules for sh:prefixes / sh:declare (explicit prefix sets)
#############################################################################
# Confirmed functionally implemented (unlike sh:resultAnnotation/
# sh:annotationProperty/sh:annotationVarName/sh:annotationValue, which do
# not appear anywhere in pySHACL's own code - not even its central
# consts.py predicate registry - so there is nothing for a meta-shacl rule
# to protect against there; using them is silently inert, not broken).
# sh:declare's requirements mirror
# pyshacl/helper/sparql_query_helper.py::SPARQLQueryHelper.collect_prefixes()
# exactly: exactly one sh:prefix (xsd:string) and exactly one sh:namespace
# (xsd:anyURI, or xsd:string as a documented fallback pySHACL itself
# accepts). Verified live end-to-end (RDF-1.1 and RDF-1.2 data) that a
# sh:sparql constraint using sh:prefixes/sh:declare instead of ordinary
# Turtle @prefix bindings resolves and evaluates correctly through
# starShacl's full pipeline.

stsh:PrefixDeclarationShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:declare prefix declaration"@en ;
	sh:property [
		sh:path sh:prefix ;
		sh:datatype xsd:string ;
		sh:minCount 1 ;
		sh:maxCount 1 ;
	] ;
	sh:property [
		sh:path sh:namespace ;
		sh:or ( [ sh:datatype xsd:anyURI ] [ sh:datatype xsd:string ] ) ;
		sh:minCount 1 ;
		sh:maxCount 1 ;
	] .

stsh:SparqlPrefixesShapes
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for sh:prefixes / sh:declare"@en ;
	sh:targetSubjectsOf sh:prefixes ;
	sh:property [
		sh:path sh:prefixes ;
		sh:node [
			a sh:NodeShape ;
			sh:property [
				sh:path sh:declare ;
				sh:node stsh:PrefixDeclarationShape ;
			] ;
		] ;
	] .

# sh:declare has no rdfs:domain (the vocabulary gives only rdfs:range sh:PrefixDeclaration), so any resource may hold prefix declarations:
# a sh:ShapesGraph, an untyped ontology IRI, a plain rdfs:Resource (the W3C tests do all three). stsh:SparqlPrefixesShapes above reaches
# a declaration only through an sh:prefixes that names its holder; this reaches every holder, so an entry nothing refers to yet is
# checked too (GitHub issue #89).
stsh:DeclareShapes
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for the holder of sh:declare"@en ;
	sh:targetSubjectsOf sh:declare ;
	sh:property [
		sh:path sh:declare ;
		sh:node stsh:PrefixDeclarationShape ;
		sh:nodeKind sh:BlankNodeOrIRI ;
	] .

# Result annotations (SHACL 1.2 SPARQL Extensions, Section 5). A value of sh:resultAnnotation is an IRI or a blank node, with no required type; sh:annotationProperty has exactly
# one value, an IRI; sh:annotationVarName at most one, an xsd:string; sh:annotationValue is any number of constants and is not restricted. The Working Group's file has no rule for any of
# these. The annotations are "declared at the subject of the sh:select or sh:ask triple": a holder with neither is reported as a Warning, since the section calls the support optional.
stsh:ResultAnnotationShape
	a sh:NodeShape ;
	rdfs:label "Well-formed result annotation (a value of sh:resultAnnotation)"@en ;
	sh:property [
		sh:path sh:annotationProperty ;
		sh:nodeKind sh:IRI ;
		sh:minCount 1 ;
		sh:maxCount 1 ;
	] ;
	sh:property [
		sh:path sh:annotationVarName ;
		sh:datatype xsd:string ;
		sh:maxCount 1 ;
	] .

stsh:ResultAnnotationHolderShapes
	a sh:NodeShape ;
	rdfs:label "Well-formedness rules for the holder of sh:resultAnnotation"@en ;
	sh:targetSubjectsOf sh:resultAnnotation ;
	sh:property [
		sh:path sh:resultAnnotation ;
		sh:nodeKind sh:BlankNodeOrIRI ;
		sh:node stsh:ResultAnnotationShape ;
	] ;
	sh:or ( [ sh:path sh:select ; sh:minCount 1 ] [ sh:path sh:ask ; sh:minCount 1 ] ) ;
	sh:severity sh:Warning .

#############################################################################
# Well-formedness rules for SHACL 1.2 UI (shui:) predicates
#############################################################################
# shui: has zero DATA-validation semantics of its own (confirmed via the
# spec's own scope statement - see docs/shacl12-gap-matrix.md), but its own
# predicates still have expected value shapes worth checking, same as any
# other annotation property - a shapes-graph authoring mistake here is a
# mistake regardless of whether shui: itself affects data validation.
# Scoped to the three predicates actually documented below
# (shui:editor/shui:viewer/shui:propertyRole, all of which reference a
# named widget/role instance and so must be IRIs).
#
# shui:WidgetScore now gets a real well-formedness shape too (below),
# confirmed stable upstream as of the 2026-10-16 re-check
# (https://www.w3.org/TR/shacl12-ui/widgets/score-validator.ttl, fetched
# live). shui:WidgetAcceptMatcher deliberately still has none - it has no
# formal shape anywhere upstream, and is actively contested there
# (w3c/data-shapes#1249, open/unmerged, proposing to change its own
# shui:widget cardinality) - see docs/shacl/implementation-plan.md item 3
# and starlayer.shacl.ui_widget_selection's own module docstring, which
# reads shui:WidgetAcceptMatcher's triples with no assumed cardinality for
# exactly this reason.

# stsh:ShuiPredicateShapes and stsh:WidgetScoreShape (well-formedness of shui: predicates and shui:WidgetScore) moved to
# shacl12-shacl-ui-overlay.ttl (registry entry shacl_shacl_ui) on 2026-10-23: they are about the UI, not about SHACL itself.
# Pass the UI companion as extra_graphs= to meta_validate() to check them.

#############################################################################
# Predicate documentation content (full SHACL Core + SHACL 1.2 coverage)
#############################################################################
# sh:name/sh:description/skos:example/rdfs:comment/rdfs:seeAlso are all
# non-validating annotation properties (SHACL Core's own, plus the standard
# SKOS documentation property skos:example) - carrying zero validation
# semantics per spec, safe to attach to any predicate IRI including ones
# this project doesn't own (e.g. sh:targetClass itself). Canonical (single,
# @en) content lives here per this file's own division-of-responsibility
# note above; shacl12-presentation-shapes.ttl adds only sh:order/sh:group
# and any future language-variant sh:name/sh:description values on top.
#
# Covers the full SHACL Core vocabulary, not just the SHACL 1.2 delta -
# generated from docs/shacl-presentation-content.md (see that file for the
# human-editable source and any content still under review).

sh:alternativePath
	sh:name "alternative path"@en ;
	sh:description "A list of paths, any one of which may match — like a logical OR over predicates. Useful when a value could arrive via one of several equivalent properties (e.g. schema:name or rdfs:label)."@en ;
	skos:example "sh:path [ sh:alternativePath ( schema:name rdfs:label ) ]"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:and
	sh:name "and"@en ;
	sh:description "A value node must conform to every shape in this list — logical conjunction. Rarely needed for simple cases (a single node shape's own constraints are already implicitly ANDed), but useful for combining reusable shape fragments."@en ;
	skos:example "sh:and ( ex:HasNameShape ex:HasEmailShape )"@en ;
	rdfs:seeAlso sh:or, sh:xone ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:class
	sh:name "class"@en ;
	sh:description "Every value node must be an instance of this class (or a subclass, under RDFS/OWL reasoning). SHACL 1.2 widens this to also accept a list of classes — the value must be an instance of *at least one* of them (a union, not an intersection)."@en ;
	skos:example "sh:path ex:employer ; sh:class ex:Organization"@en ;
	rdfs:comment "A list value here means \"any of these classes,\" not \"all of these classes\" — for an intersection, nest a separate sh:node shape instead."@en ;
	rdfs:seeAlso sh:datatype, sh:nodeKind ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain single-value form only — the SHACL 1.2 list-valued form requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:closed
	sh:name "closed"@en ;
	sh:description "When true, a conforming focus node may only have values for paths explicitly listed via sh:property (plus anything in sh:ignoredProperties) — any other property present is a violation. SHACL 1.2 adds sh:ByTypes, which closes the shape per-rdf:type rather than universally, useful when a class hierarchy adds properties incrementally."@en ;
	skos:example "ex:PersonShape sh:closed true ; sh:property [ sh:path ex:name ] . — ex:Person nodes may *only* have ex:name (and rdf:type)."@en ;
	rdfs:comment "rdf:type is always implicitly allowed on a closed shape. sh:ignoredProperties is needed to permit other \"bookkeeping\" properties (e.g. dcterms:created) without listing each as sh:property."@en ;
	rdfs:seeAlso sh:ignoredProperties ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain `xsd:boolean` value only — `sh:closed sh:ByTypes` requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:datatype
	sh:name "datatype"@en ;
	sh:description "Every value node must be a literal with this exact XSD (or other) datatype IRI. SHACL 1.2 widens this to also accept a list of datatypes (a union, same as sh:class)."@en ;
	skos:example "sh:path ex:age ; sh:datatype xsd:integer"@en ;
	rdfs:comment "xsd:integer and xsd:int/xsd:decimal are *not* the same datatype to SHACL — the match is exact, not numerically-compatible."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain single-value form only — the SHACL 1.2 list-valued form requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:deactivated
	sh:name "deactivated"@en ;
	sh:description "When true, this shape is skipped entirely during validation — as if it weren't there. Useful for temporarily disabling a rule without deleting it, e.g. while a training exercise focuses on a different constraint."@en ;
	skos:example "sh:deactivated true"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:defaultValue
	sh:name "default value"@en ;
	sh:description "A suggested default value for a property shape, for a UI to pre-fill when creating a new instance. Purely informational — has no effect on validation."@en ;
	rdfs:comment "The value is checked when a shapes graph is validated: at most one, and a well-formed node expression (stsh:DefaultValueShape)."@en ;
	skos:example "sh:path ex:status ; sh:defaultValue \"pending\""@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:description
	sh:name "description"@en ;
	sh:description "A longer human-readable explanation of a shape's purpose — again, the same property this file uses for every predicate's own description."@en ;
	rdfs:comment "The value is checked when a shapes graph is validated: an xsd:string or language-tagged string (stsh:NameAndDescriptionShape)."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:disjoint
	sh:name "disjoint"@en ;
	sh:description "The set of value nodes at this shape's path must share *no* members with the set of value nodes at the given path. SHACL 1.2 widens the object to any property path."@en ;
	skos:example "sh:path ex:blockedUsers ; sh:disjoint ex:friends — a user can't be both blocked and a friend."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain-IRI object only — the SHACL 1.2 path-valued form requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:equals
	sh:name "equals"@en ;
	sh:description "The set of value nodes at this shape's path must be exactly equal (as a set) to the set of value nodes at the given path or property. SHACL 1.2 widens the object from a plain IRI to any property path."@en ;
	skos:example "sh:path ex:homeAddress ; sh:equals ex:mailingAddress"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain-IRI object only — the SHACL 1.2 path-valued form requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:flags
	sh:name "flags"@en ;
	sh:description "Regex flags to apply alongside sh:pattern (e.g. \"i\" for case-insensitive). Has no effect without a sh:pattern on the same shape."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:group
	sh:name "group"@en ;
	sh:description "Links a property shape to a sh:PropertyGroup, letting a UI cluster related fields into named sections — exactly how this presentation file's own groups (Targeting, Cardinality, etc.) work."@en ;
	rdfs:comment "The value is checked when a shapes graph is validated: an instance of sh:PropertyGroup (stsh:GroupShape)."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:hasValue
	sh:name "has value"@en ;
	sh:description "At least one value node must equal exactly this one specific value — the opposite granularity from sh:in (one required value, rather than a list of allowed ones)."@en ;
	skos:example "sh:path rdf:type ; sh:hasValue ex:Person — requires the focus node to be typed ex:Person (among possibly other types)."@en ;
	rdfs:seeAlso sh:in ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:ignoredProperties
	sh:name "ignored properties"@en ;
	sh:description "A list of properties exempted from sh:closed's restriction — present without needing a matching sh:property entry."@en ;
	skos:example "sh:ignoredProperties ( rdf:type dcterms:created )"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:in
	sh:name "in"@en ;
	sh:description "Every value node must be exactly one of the members of this list — an enumeration/allow-list constraint."@en ;
	skos:example "sh:path ex:status ; sh:in ( \"active\" \"inactive\" \"pending\" )"@en ;
	rdfs:comment "List membership is exact-value matching, including datatype — sh:in (1 2 3) (integers) will not match the string \"1\"."@en ;
	rdfs:seeAlso sh:hasValue ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:inversePath
	sh:name "inverse path"@en ;
	sh:description "Traverses a triple backwards — from object to subject — instead of the normal subject-to-object direction. Used to write constraints in terms of \"things that point at me\" rather than \"things I point at.\""@en ;
	skos:example "sh:path [ sh:inversePath ex:parent ] — matches a node's children, by walking ex:parent triples backwards."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:languageIn
	sh:name "language in"@en ;
	sh:description "Every value node must be a language-tagged literal (or rdf:dirLangString under RDF 1.2) whose language tag is in this list. A plain literal with no language tag never matches."@en ;
	skos:example "sh:path ex:label ; sh:languageIn ( \"en\" \"en-US\" \"fr\" )"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	rdfs:comment "plain literals only — `rdf:dirLangString` recognition requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:lessThan
	sh:name "less than"@en ;
	sh:description "Every value node at this shape's path must be strictly less than every value node at the given path, for the same focus node. Requires an orderable datatype. SHACL 1.2 widens the object to any property path."@en ;
	skos:example "sh:path ex:startDate ; sh:lessThan ex:endDate"@en ;
	rdfs:seeAlso sh:lessThanOrEquals ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain-IRI object only — the SHACL 1.2 path-valued form requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:lessThanOrEquals
	sh:name "less than or equal to"@en ;
	sh:description "Same as sh:lessThan, but allows equality. SHACL 1.2 widens the object to any property path."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain-IRI object only — the SHACL 1.2 path-valued form requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:maxCount
	sh:name "maximum count"@en ;
	sh:description "The maximum number of value nodes a path may have for a given focus node. sh:maxCount 1 is the standard way to express \"at most one value\" (a functional property)."@en ;
	skos:example "sh:path ex:birthDate ; sh:maxCount 1"@en ;
	rdfs:seeAlso sh:minCount ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:maxExclusive
	sh:name "maximum exclusive value"@en ;
	sh:description "Every value node must be strictly less than this value."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:maxInclusive
	sh:name "maximum inclusive value"@en ;
	sh:description "Every value node must be numerically or ordinally ≤ this value."@en ;
	skos:example "sh:path ex:percentage ; sh:maxInclusive 100"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:maxLength
	sh:name "maximum length"@en ;
	sh:description "The string form of every value node must have at most this many characters."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:maxListLength
	sh:name "maximum list length"@en ;
	sh:description "The value node must be a well-formed SHACL list with at most this many members."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:memberShape
	sh:name "member shape"@en ;
	sh:description "The value node must be a well-formed SHACL list, and every member of that list must conform to the given shape. Combines list-well-formedness checking with per-member validation in one predicate."@en ;
	skos:example "sh:path ex:tags ; sh:memberShape [ sh:datatype xsd:string ]"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:message
	sh:name "message"@en ;
	sh:description "A human-readable explanation shown in the validation report when this shape is violated. Can use {$this}, {?path}, and similar placeholders that get filled in per-violation. Purely informational — has no effect on whether the shape conforms."@en ;
	skos:example "sh:message \"Age must be a non-negative integer.\"@en"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:minCount
	sh:name "minimum count"@en ;
	sh:description "The minimum number of value nodes a path must have for a given focus node. sh:minCount 1 is the standard way to express \"this property is required.\" There is no default minimum — omitting sh:minCount means any number of values, including zero, is allowed."@en ;
	skos:example "sh:path ex:email ; sh:minCount 1 — every focus node must have at least one ex:email value."@en ;
	rdfs:comment "A frequent mistake: writing sh:minCount 0 to mean \"optional.\" This is a no-op — 0 is already the default. Omit sh:minCount entirely for an optional property."@en ;
	rdfs:seeAlso sh:maxCount ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:minExclusive
	sh:name "minimum exclusive value"@en ;
	sh:description "Every value node must be strictly greater than this value (boundary itself not allowed)."@en ;
	skos:example "sh:path ex:temperature ; sh:minExclusive 0 — must be above absolute freezing on some scale, never equal to it."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:minInclusive
	sh:name "minimum inclusive value"@en ;
	sh:description "Every value node must be numerically or ordinally ≥ this value. Requires an orderable datatype (numbers, dates)."@en ;
	skos:example "sh:path ex:age ; sh:minInclusive 0"@en ;
	rdfs:seeAlso sh:minExclusive, sh:maxInclusive ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:minLength
	sh:name "minimum length"@en ;
	sh:description "The string form of every value node must have at least this many characters. Applies to both literals and IRIs (an IRI's length is measured too)."@en ;
	skos:example "sh:path ex:username ; sh:minLength 3"@en ;
	rdfs:seeAlso sh:maxLength ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:minListLength
	sh:name "minimum list length"@en ;
	sh:description "The value node must be a well-formed SHACL list with at least this many members."@en ;
	skos:example "sh:path ex:coordinates ; sh:minListLength 2"@en ;
	rdfs:seeAlso sh:maxListLength ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:name
	sh:name "name"@en ;
	sh:description "A short, human-readable label for a shape — this exact same annotation property is what this presentation file itself uses for every predicate's display label."@en ;
	rdfs:comment "The value is checked when a shapes graph is validated: an xsd:string or language-tagged string (stsh:NameAndDescriptionShape)."@en ;
	skos:example "sh:name \"email address\"@en"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:node
	sh:name "node"@en ;
	sh:description "Every value node must conform to the given (node) shape. The main way to nest shapes — validating the *shape* of a related resource, not just a scalar constraint on it."@en ;
	skos:example "sh:path ex:address ; sh:node ex:AddressShape"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:nodeKind
	sh:name "node kind"@en ;
	sh:description "Restricts what *kind* of RDF term a value node may be, independent of class or datatype: sh:IRI, sh:BlankNode, sh:Literal, or one of the three compound kinds (sh:BlankNodeOrIRI, sh:BlankNodeOrLiteral, sh:IRIOrLiteral). SHACL 1.2 widens this to also accept a list of node kinds."@en ;
	skos:example "sh:path ex:homepage ; sh:nodeKind sh:IRI — the value must be a real IRI, not a literal string."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain single-value form only — the SHACL 1.2 list-valued form requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:not
	sh:name "not"@en ;
	sh:description "A value node conforms only if it does *not* conform to the given shape — logical negation. A common way to express \"must not be of this type\" or \"must not match this pattern.\""@en ;
	skos:example "sh:not [ sh:hasValue ex:Deleted ]"@en ;
	rdfs:comment "Negating a shape with its own violations can be confusing to debug — the validation report shows that sh:not's inner shape *did* conform (which is why the outer shape failed), which reads backwards at first glance."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:oneOrMorePath
	sh:name "one-or-more path"@en ;
	sh:description "Matches the given path repeated one or more times — like + in a regular expression. Same as sh:zeroOrMorePath but excludes the zero-repetition (starting-node) case."@en ;
	skos:example "sh:path [ sh:oneOrMorePath ex:parent ] — every ancestor, not including the node itself."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:or
	sh:name "or"@en ;
	sh:description "A value node must conform to at least one shape in this list — logical disjunction. Commonly used to allow a value to be one of several alternative shapes (e.g. either an IRI reference or an inline literal)."@en ;
	skos:example "sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:integer ] )"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:order
	sh:name "order"@en ;
	sh:description "A number suggesting where a property shape should appear relative to its siblings when a UI renders a form — lower numbers first. Purely a rendering hint."@en ;
	rdfs:comment "The value is checked when a shapes graph is validated: at most one, a decimal (stsh:OrderShape)."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:path
	sh:name "path"@en ;
	sh:description "Required on every property shape. Names the property more complex path expression that connects a focus node to its value nodes. The simplest form is a single IRI; SHACL also supports sequence, alternative, inverse, and repeated (*/+/?) paths."@en ;
	skos:example "sh:path ex:email — the simple case, a single predicate."@en ;
	rdfs:seeAlso sh:inversePath, sh:alternativePath ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:pattern
	sh:name "pattern"@en ;
	sh:description "Every value node's string form must match this regular expression (XPath/XSD regex syntax, not PCRE — mostly compatible, but check character class and anchoring differences for anything nontrivial)."@en ;
	skos:example "sh:path ex:productCode ; sh:pattern \"^[A-Z]{3}-[0-9]{4}$\""@en ;
	rdfs:comment "SHACL patterns are *not* implicitly anchored — sh:pattern \"abc\" matches a value that merely *contains* \"abc\" anywhere, not one that equals it. Use ^...$ explicitly for a full-string match."@en ;
	rdfs:seeAlso sh:flags ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:property
	sh:name "property"@en ;
	sh:description "Attaches a property shape to a node shape. Nearly every real-world shape uses this — it's how a node shape says \"and also, here's a constraint on one of my properties.\""@en ;
	skos:example "ex:PersonShape sh:property [ sh:path ex:email ; sh:minCount 1 ]"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:qualifiedMaxCount
	sh:name "qualified maximum count"@en ;
	sh:description "The maximum number of value nodes that may conform to the sibling sh:qualifiedValueShape."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:qualifiedMinCount
	sh:name "qualified minimum count"@en ;
	sh:description "The minimum number of value nodes that must conform to the sibling sh:qualifiedValueShape."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:qualifiedValueShape
	sh:name "qualified value shape"@en ;
	sh:description "Works together with sh:qualifiedMinCount/sh:qualifiedMaxCount to count *how many* value nodes conform to a given shape (rather than requiring all or none to conform, like sh:node does)."@en ;
	skos:example "sh:path ex:contact ; sh:qualifiedValueShape ex:PhoneShape ; sh:qualifiedMinCount 1"@en ;
	rdfs:seeAlso sh:qualifiedMinCount, sh:qualifiedMaxCount ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:qualifiedValueShapesDisjoint
	sh:name "qualified value shapes disjoint"@en ;
	sh:description "When true, a value node counted toward *this* qualified shape's count is excluded from counting toward any sibling qualified shape on the same property shape — prevents one value from double-counting across two overlapping qualified constraints."@en ;
	rdfs:comment "Only affects counting against *sibling* qualified shapes on the same sh:property blank node list — it has no effect with only one sh:qualifiedValueShape present."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:reificationRequired
	sh:name "reification required"@en ;
	sh:description "When true, every triple term reached by the shape's path must actually have at least one reifier in the data — not just be well-formed, but be genuinely annotated/reified somewhere."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:reifierShape
	sh:name "reifier shape"@en ;
	sh:description "Requires that the reifier of a triple term (the node connected to it via rdf:reifies) conforms to the given shape — a way to put constraints on the metadata *about* a statement, not just the statement's own subject/predicate/object."@en ;
	skos:example "sh:path ex:claims ; sh:reifierShape [ sh:property [ sh:path ex:confidence ; sh:minCount 1 ] ] — every reifier of a claim must carry a confidence score."@en ;
	rdfs:seeAlso sh:reificationRequired ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:rootClass
	sh:name "root class"@en ;
	sh:description "Every value node must be an IRI that is, or is a transitive rdfs:subClassOf subclass of, this class - like sh:class but subclass-aware without needing full RDFS/OWL reasoning enabled. Not a targeting mechanism (despite the similar name to implicit class-based targeting) - it constrains a property's value nodes, the same role as sh:class/sh:datatype/sh:nodeKind."@en ;
	skos:example "sh:path ex:worksFor ; sh:rootClass ex:Organization — the value must be ex:Organization itself or a transitive subclass of it."@en ;
	rdfs:seeAlso sh:class ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:severity
	sh:name "severity"@en ;
	sh:description "How seriously to treat a violation of this shape: sh:Violation (default — fails conformance), sh:Warning, or sh:Info (both reported but don't fail conformance). Useful for phasing in stricter rules without breaking existing data immediately."@en ;
	skos:example "sh:severity sh:Warning"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:singleLine
	sh:name "single line"@en ;
	sh:description "When true, every value node's string form must not contain a line break — a lightweight way to reject accidentally-pasted multi-paragraph text in a field meant to hold a short label."@en ;
	skos:example "sh:path ex:title ; sh:singleLine true"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:someValue
	sh:name "some value"@en ;
	sh:description "At least one value node must conform to the given shape. Unlike sh:node (which requires *every* value node to conform), a single non-conforming value here is not itself a violation — only the absence of *any* conforming value is."@en ;
	skos:example "sh:path ex:contactMethod ; sh:someValue [ sh:datatype xsd:anyURI ] — at least one contact method must be a URI, others can be anything."@en ;
	rdfs:seeAlso sh:node ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:subsetOf
	sh:name "subset of"@en ;
	sh:description "The set of value nodes at this shape's path must be a subset of the set of value nodes at the given path — every value here must also appear there, but not vice versa."@en ;
	skos:example "sh:path ex:selectedTags ; sh:subsetOf ex:availableTags"@en ;
	rdfs:seeAlso sh:equals ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:targetClass
	sh:name "target class"@en ;
	sh:description "Every instance of this class (including subclasses, when RDFS/OWL reasoning is used) is a focus node for the shape. The most common way to attach a shape to \"all things of type X.\""@en ;
	skos:example "ex:PersonShape sh:targetClass ex:Person ."@en ;
	rdfs:seeAlso sh:targetNode, sh:rootClass ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:targetNode
	sh:name "target node"@en ;
	sh:description "A single, specific IRI or literal is a focus node for the shape, regardless of its type. Useful for validating one known resource directly, or in training examples where you want to point at exactly one node."@en ;
	skos:example "ex:AliceShape sh:targetNode ex:alice ."@en ;
	rdfs:comment "Doesn't scale — for validating \"all instances of a class,\" use sh:targetClass instead."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:targetObjectsOf
	sh:name "target objects of"@en ;
	sh:description "Any node that appears as the *object* of at least one triple with this predicate becomes a focus node — the mirror image of sh:targetSubjectsOf."@en ;
	skos:example "sh:targetObjectsOf ex:manager — targets every node that's someone's manager."@en ;
	rdfs:comment "Easy to mix up with sh:targetSubjectsOf — subjects-of targets the thing *with* the property, objects-of targets the thing *pointed to*."@en ;
	rdfs:seeAlso sh:targetSubjectsOf ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:targetSubjectsOf
	sh:name "target subjects of"@en ;
	sh:description "Any node that is the subject of at least one triple with this predicate becomes a focus node. A quick way to target \"everything that has an ex:email,\" without needing a shared class."@en ;
	skos:example "sh:targetSubjectsOf ex:email — targets every node with at least one ex:email value."@en ;
	rdfs:seeAlso sh:targetObjectsOf ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:uniqueLang
	sh:name "unique language"@en ;
	sh:description "When true, at most one value node may use each language tag — prevents two \"Hello\"@en values on the same focus node, without restricting which languages are used at all. SHACL 1.2 extends the uniqueness condition to also consider base direction for rdf:dirLangString values (\"1\"@ar--rtl and \"1\"@ar--ltr are different, as is the pair \"1\"@ar--rtl and \"1\"@ar)."@en ;
	skos:example "sh:path ex:label ; sh:uniqueLang true"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>, <https://www.w3.org/TR/shacl12-core/> ;
	rdfs:comment "plain language-tag uniqueness only — `rdf:dirLangString` direction-awareness requires stsh:StarShacl"@en ;
	stsh:requiredEngine stsh:PySHACL .

sh:uniqueMembers
	sh:name "unique members"@en ;
	sh:description "When true, the value node must be a well-formed SHACL list with no duplicate members (by RDF term equality)."@en ;
	skos:example "sh:path ex:coordinates ; sh:uniqueMembers true"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:uniqueValuesFor
	sh:name "unique values for"@en ;
	sh:description "Requires that the values reached via the given path (or list of paths) are unique *across every focus node* the shape applies to — not just within one focus node, like sh:uniqueLang/sh:uniqueMembers are. The classic use is enforcing a unique key (e.g. no two people share a username)."@en ;
	skos:example "ex:PersonShape sh:targetClass ex:Person ; sh:uniqueValuesFor ex:username ."@en ;
	rdfs:comment "Because this checks *across* focus nodes rather than within one, it needs the *entire* batch of candidate focus nodes evaluated together — composing it inside sh:and/sh:or/sh:not/sh:node/sh:qualifiedValueShape requires special handling to still see the full batch (which starShacl's native components provide — see docs/shacl12-gap-matrix.md)."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
	stsh:requiredEngine stsh:StarShacl .

sh:xone
	sh:name "exactly one"@en ;
	sh:description "A value node must conform to *exactly one* shape in this list — not zero, not two or more. Stricter than sh:or, useful when alternatives are meant to be mutually exclusive."@en ;
	skos:example "sh:xone ( ex:IndividualShape ex:OrganizationShape ) — a party is one or the other, never both."@en ;
	rdfs:comment "If two shapes in the list overlap (a value could satisfy both), a value that matches both fails sh:xone even though it would pass sh:or — easy to trip over when shapes aren't as mutually exclusive as intended."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:zeroOrMorePath
	sh:name "zero-or-more path"@en ;
	sh:description "Matches the given path repeated zero or more times — the SHACL equivalent of a regular expression's *. Commonly used to walk a transitive hierarchy (e.g. every ancestor via rdfs:subClassOf*)."@en ;
	skos:example "sh:path [ sh:zeroOrMorePath rdfs:subClassOf ]"@en ;
	rdfs:comment "Zero repetitions means the *starting node itself* is included in the match set — easy to forget when counting results."@en ;
	rdfs:seeAlso sh:oneOrMorePath, sh:zeroOrOnePath ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:zeroOrOnePath
	sh:name "zero-or-one path"@en ;
	sh:description "Matches the given path zero times (the node itself) or exactly once — like ? in a regular expression. Useful for \"this node, or its immediate parent if it has one.\""@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
	stsh:requiredEngine stsh:PySHACL .


#############################################################################
# Rules & SPARQL Extensions, and SHACL 1.2 UI widget documentation content
#############################################################################
# Non-validating property shape characteristics, and property groups
#############################################################################
# sh:name, sh:description, sh:order and sh:group do not affect validation (SHACL 1.0 section 2.3.2), but a shapes
# graph is also edited by form-based tools, so their values are checked here. Per SHACL 1.0: sh:name and
# sh:description are xsd:string or rdf:langString (one or more values); sh:order has at most one value, a decimal, and
# "may be used with any type of subjects"; sh:group names an instance of sh:PropertyGroup. SHACL 1.2 adds: a property
# shape has at most one sh:defaultValue, a well-formed node expression. The Working Group's file has no rule for any of
# these (see docs/shacl/shacl12-gap-matrix.md, 2026-10-21).

stsh:NameAndDescriptionShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:name and sh:description"@en ;
	sh:targetSubjectsOf sh:name, sh:description ;
	sh:property [
		sh:path sh:name ;
		sh:name "name"@en ;
		sh:order 1 ;
		sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] [ sh:datatype rdf:dirLangString ] ) ;
		sh:message "sh:name must be an xsd:string or a language-tagged string"@en ;
	] ;
	sh:property [
		sh:path sh:description ;
		sh:name "description"@en ;
		sh:order 2 ;
		sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] [ sh:datatype rdf:dirLangString ] ) ;
		sh:message "sh:description must be an xsd:string or a language-tagged string"@en ;
	] .

stsh:OrderShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:order"@en ;
	sh:targetSubjectsOf sh:order ;
	sh:property [
		sh:path sh:order ;
		sh:name "order"@en ;
		sh:order 3 ;
		sh:maxCount 1 ;
		sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ;
		sh:message "sh:order must be a single decimal"@en ;
	] .

stsh:GroupShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:group"@en ;
	sh:targetSubjectsOf sh:group ;
	sh:property [
		sh:path sh:group ;
		sh:name "group"@en ;
		sh:order 4 ;
		sh:nodeKind sh:BlankNodeOrIRI ;
		sh:class sh:PropertyGroup ;
		sh:message "sh:group must name an instance of sh:PropertyGroup"@en ;
	] .

stsh:DefaultValueShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:defaultValue"@en ;
	sh:targetSubjectsOf sh:defaultValue ;
	sh:property [
		sh:path sh:defaultValue ;
		sh:name "default value"@en ;
		sh:order 5 ;
		sh:maxCount 1 ;
		sh:node stsh:NodeExpressionShape ;
		sh:message "a shape has at most one sh:defaultValue, a well-formed node expression"@en ;
	] .

stsh:PropertyGroupShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:PropertyGroup"@en ;
	sh:targetClass sh:PropertyGroup ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:property [
		sh:path rdfs:label ;
		sh:name "label"@en ;
		sh:order 1 ;
		sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] [ sh:datatype rdf:dirLangString ] ) ;
		sh:message "a property group's rdfs:label must be an xsd:string or a language-tagged string"@en ;
	] ;
	sh:property [
		sh:path sh:order ;
		sh:name "order"@en ;
		sh:order 2 ;
		sh:maxCount 1 ;
		sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ;
	] .

# Coverage for the predicates a shapes-graph form needs and no shape described (GitHub issues #21 and #22). Each is a
# plain property shape on the subjects of the predicate, so a tool that selects shapes by target finds them.

stsh:IsDefinedByShape
	a sh:NodeShape ;
	rdfs:label "Well-formed rdfs:isDefinedBy on a shape"@en ;
	rdfs:comment "SHACL 1.2 Profiling 2.4: a shape names the sh:ShapesGraph that defines it. How many values a shape may have is an open question (GitHub issue #18), so no limit is stated here."@en ;
	sh:targetSubjectsOf rdfs:isDefinedBy ;
	sh:property [
		sh:path rdfs:isDefinedBy ;
		sh:name "defined by"@en ;
		sh:nodeKind sh:BlankNodeOrIRI ;
		sh:message "rdfs:isDefinedBy must be an IRI or blank node naming the shapes graph that defines the shape"@en ;
	] .

stsh:ShapeDefinedByOneGraphShape
	a sh:NodeShape ;
	rdfs:label "A shape is defined by at most one shapes graph"@en ;
	rdfs:comment "SHACL 1.2 Profiling 2.4 says a shape SHOULD name the graph that defines it, and 2.5 lists a graph that only uses it with rdfs:member, so a shape has one definer and many users. The draft states no limit, hence Warning severity: it does not make a shapes graph invalid, and it gives a form the maximum of one. Applies to shapes only; a validation report also uses rdfs:isDefinedBy (Profiling 5.4.1). GitHub issue #18."@en ;
	sh:targetClass sh:NodeShape, sh:PropertyShape ;
	sh:property [
		sh:path rdfs:isDefinedBy ;
		sh:maxCount 1 ;
		sh:severity sh:Warning ;
		sh:message "a shape should be defined by at most one shapes graph; use rdfs:member to list it in the others"@en ;
	] .

stsh:PropertiesOfNodeShapeShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:property on a shape"@en ;
	sh:targetSubjectsOf sh:property ;
	sh:property [
		sh:path sh:property ;
		sh:name "property shapes"@en ;
		sh:nodeKind sh:BlankNodeOrIRI ;
		sh:message "sh:property must name a property shape (an IRI or blank node)"@en ;
	] .

stsh:ValuesShape
	a sh:NodeShape ;
	rdfs:label "Well-formed sh:values"@en ;
	rdfs:comment "SHACL 1.2 Node Expressions: sh:values on a property shape holds the node expression that computes its values."@en ;
	sh:targetSubjectsOf sh:values ;
	sh:property [
		sh:path sh:values ;
		sh:name "values"@en ;
		sh:node stsh:NodeExpressionShape ;
		sh:message "sh:values must be a well-formed node expression"@en ;
	] .

stsh:PathOfShapeShape
	a sh:NodeShape ;
	rdfs:label "A property shape's sh:path, as a plain property shape"@en ;
	rdfs:comment "a form cannot read the Working Group's shsh:PropertyShapeShape (it only applies to values of sh:property). This is the sh:path rule stated directly, with the cardinality and path grammar of the Working Group's file."@en ;
	sh:targetSubjectsOf sh:path ;
	sh:property [
		sh:path sh:path ;
		sh:name "path"@en ;
		sh:maxCount 1 ;
		sh:or ( shsh:PathShape [ sh:nodeKind sh:IRI ] ) ;
		sh:message "sh:path must be an IRI or a well-formed property path, and a shape has at most one"@en ;
	] .

# Node expressions are found by target: the object of sh:values is one (GitHub issue #22). The nested blank nodes under a
# function call and the RDF list nodes of its arguments are still not selected; that is the open part of #22.
stsh:NodeExpressionShape
	sh:targetObjectsOf sh:values .

#############################################################################
# Documentation-only (sh:name/sh:description/skos:example/rdfs:comment/
# rdfs:seeAlso), same non-validating pattern as the SHACL Core section
# above - NOT accompanied by any meta-shacl well-formedness VALIDATION
# rules for sh:rule/sh:condition/sh:sparql/custom sh:ConstraintComponent
# structures, which remains a real, separate, unbuilt gap (a malformed use
# of these still fails with a raw exception rather than a clean report -
# see docs/shacl12-gap-matrix.md). shui: (SHACL 1.2 User Interfaces) has no
# validation semantics of its own at all per its own spec scope, so
# documentation is its complete possible scope here, not a partial slice
# of something bigger.

sh:sparql
	sh:name "SPARQL constraint"@en ;
	sh:description "Attaches a SPARQL-based constraint to a shape — the query is evaluated once per focus node, and any result row it returns is treated as a violation."@en ;
	skos:example "sh:sparql [ sh:select \"SELECT $this WHERE { FILTER NOT EXISTS { $this ex:email ?e } }\" ]"@en ;
	rdfs:comment "The query must project $this (or ?this); MINUS and VALUES against pre-bound variables are disallowed per spec."@en ;
	rdfs:seeAlso sh:select, sh:ConstraintComponent ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-sparql/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:select
	sh:name "SELECT query"@en ;
	sh:description "The SPARQL SELECT query text for a sh:sparql constraint or a custom sh:ConstraintComponent's sh:nodeValidator/sh:propertyValidator. Any row returned counts as a violation; bindings for ?value/?path/?this in the result customize the reported focus/value/path."@en ;
	skos:example "sh:select \"SELECT $this ?value WHERE { ?value ex:score ?s . FILTER (?s < 0) }\""@en ;
	rdfs:seeAlso sh:sparql, sh:ask ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-sparql/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:ask
	sh:name "ASK query"@en ;
	sh:description "The SPARQL ASK query text for a custom sh:ConstraintComponent's generic sh:validator. The value node conforms only if the query returns true."@en ;
	skos:example "sh:validator [ a sh:SPARQLAskValidator ; sh:ask \"ASK { FILTER (?value >= ?minScore) }\" ]"@en ;
	rdfs:comment "Unlike sh:select, false means *violation* here — the query must return true for conformance, the opposite polarity from a SELECT constraint's \"any row is a violation.\""@en ;
	rdfs:seeAlso sh:select ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-sparql/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:ConstraintComponent
	sh:name "constraint component"@en ;
	sh:description "Declares a reusable, user-defined SHACL constraint type, similar to a built-in one like sh:minCount. Combines one or more sh:parameter declarations with a sh:validator (or sh:nodeValidator/sh:propertyValidator) that implements the check."@en ;
	skos:example "ex:MinScoreConstraintComponent a sh:ConstraintComponent ; sh:parameter [ sh:path ex:minScore ] ; sh:validator [ a sh:SPARQLAskValidator ; sh:ask \"...\" ]"@en ;
	rdfs:comment "Requires at least one non-optional sh:parameter — a component with only optional parameters fails to load."@en ;
	rdfs:seeAlso sh:parameter, sh:validator ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-sparql/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:parameter
	sh:name "parameter"@en ;
	sh:description "Declares one input parameter of a custom sh:ConstraintComponent — the parameter's own sh:path becomes the predicate a shape uses to supply that argument's value (e.g. ex:minScore in the example above)."@en ;
	skos:example "sh:parameter [ sh:path ex:minScore ; sh:optional false ]"@en ;
	rdfs:seeAlso sh:ConstraintComponent ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-sparql/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:validator
	sh:name "validator"@en ;
	sh:description "The generic SPARQL ASK validator for a custom sh:ConstraintComponent, used when the component doesn't need to distinguish node vs. property shapes."@en ;
	rdfs:seeAlso sh:nodeValidator, sh:propertyValidator, sh:ask ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-sparql/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:nodeValidator
	sh:name "node validator"@en ;
	sh:description "A SELECT-based validator for a custom sh:ConstraintComponent, used specifically when the component is applied via a node shape."@en ;
	rdfs:seeAlso sh:propertyValidator, sh:select ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-sparql/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:propertyValidator
	sh:name "property validator"@en ;
	sh:description "A SELECT-based validator for a custom sh:ConstraintComponent, used specifically when the component is applied via a property shape."@en ;
	rdfs:seeAlso sh:nodeValidator, sh:select ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-sparql/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:rule
	sh:name "rule"@en ;
	sh:description "Attaches a SHACL-AF inference rule to a shape, applied to every focus node the shape targets when rule execution (not plain validation) is requested. sh:TripleRule and sh:SPARQLRule are the two concrete rule types."@en ;
	skos:example "ex:R sh:rule [ a sh:TripleRule ; sh:subject sh:this ; sh:predicate ex:derived ; sh:object [ sh:path ex:source ] ]"@en ;
	rdfs:seeAlso sh:TripleRule, sh:SPARQLRule, sh:condition ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-rules/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:condition
	sh:name "condition"@en ;
	sh:description "Restricts which focus nodes a rule actually applies to — only nodes conforming to the given shape have the rule run for them; every other focus node is skipped entirely for that rule."@en ;
	skos:example "sh:rule [ a sh:TripleRule ; sh:condition ex:AdultShape ; ... ]"@en ;
	rdfs:comment "The condition shape needs a real constraint to be discriminating — a shape with only a target predicate (e.g. sh:targetClass) trivially \"conforms\" for any node when checked ad hoc, since targeting doesn't itself constrain anything."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-rules/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:TripleRule
	sh:name "triple rule"@en ;
	sh:description "A rule type that derives one new triple per matching focus node from three independently-evaluated node expressions — sh:subject/sh:predicate/sh:object — without needing any SPARQL."@en ;
	skos:example "[ a sh:TripleRule ; sh:subject sh:this ; sh:predicate ex:ancestor ; sh:object [ sh:path ex:parent ] ]"@en ;
	rdfs:seeAlso sh:SPARQLRule, sh:subject, sh:predicate, sh:object ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-rules/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:SPARQLRule
	sh:name "SPARQL rule"@en ;
	sh:description "A rule type that derives new triples via an arbitrary SPARQL CONSTRUCT query (sh:construct), for derivations too complex for a single sh:TripleRule."@en ;
	skos:example "[ a sh:SPARQLRule ; sh:construct \"CONSTRUCT { $this ex:ancestor ?a } WHERE { $this ex:parent+ ?a }\" ]"@en ;
	rdfs:seeAlso sh:TripleRule, sh:construct ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-rules/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:construct
	sh:name "CONSTRUCT query"@en ;
	sh:description "The SPARQL CONSTRUCT query text for a sh:SPARQLRule — its WHERE clause is evaluated once per matching focus node (bound to $this), and every triple in its result is added to the data graph."@en ;
	skos:example "sh:construct \"PREFIX ex: <http://example.org/> CONSTRUCT { $this ex:ancestor ?a } WHERE { $this ex:parent ?a }\""@en ;
	rdfs:seeAlso sh:SPARQLRule ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-rules/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:subject
	sh:name "subject expression"@en ;
	sh:description "The node expression producing the subject of the triple a sh:TripleRule derives — most commonly just sh:this, the rule's own focus node."@en ;
	rdfs:seeAlso sh:TripleRule, sh:predicate, sh:object ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-rules/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:predicate
	sh:name "predicate expression"@en ;
	sh:description "The node expression producing the predicate of the triple a sh:TripleRule derives — typically a constant IRI naming the derived property."@en ;
	rdfs:seeAlso sh:TripleRule, sh:subject, sh:object ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-rules/> ;
	stsh:requiredEngine stsh:PySHACL .

sh:object
	sh:name "object expression"@en ;
	sh:description "The node expression producing the object of the triple a sh:TripleRule derives — often a shnex:pathValues/sh:path expression pulling a value from elsewhere in the data."@en ;
	rdfs:seeAlso sh:TripleRule, sh:subject, sh:predicate ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>, <https://www.w3.org/TR/shacl12-rules/> ;
	stsh:requiredEngine stsh:PySHACL .

shui:editor
	sh:name "editor widget"@en ;
	sh:description "Suggests which widget a form-generating UI should use to *edit* this property shape's values — one of the built-in editors below, or a custom one."@en ;
	skos:example "sh:property [ sh:path ex:birthDate ; shui:editor shui:DatePickerEditor ]"@en ;
	rdfs:seeAlso shui:viewer ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:viewer
	sh:name "viewer widget"@en ;
	sh:description "Suggests which widget a UI should use to *display* (read-only) this property shape's values, as opposed to editing them."@en ;
	skos:example "sh:property [ sh:path ex:homepage ; shui:viewer shui:HyperlinkViewer ]"@en ;
	rdfs:seeAlso shui:editor ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:propertyRole
	sh:name "property role"@en ;
	sh:description "Marks a property shape as playing a special semantic role for UI purposes — currently just shui:LabelRole, marking \"this is the property whose value should be used as the resource's own display label.\""@en ;
	skos:example "sh:property [ sh:path ex:name ; shui:propertyRole shui:LabelRole ]"@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; not interpreted by starlayer.shacl (property roles are documented here but not implemented)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:TextFieldEditor
	sh:name "text field"@en ;
	sh:description "A single-line plain-text input."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:TextFieldWithLangEditor
	sh:name "text field with language"@en ;
	sh:description "A single-line text input paired with a language-tag selector, for editing one language-tagged literal."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:TextAreaEditor
	sh:name "text area"@en ;
	sh:description "A multi-line plain-text input."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:TextAreaWithLangEditor
	sh:name "text area with language"@en ;
	sh:description "A multi-line text input paired with a language-tag selector."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:RichTextEditor
	sh:name "rich text editor"@en ;
	sh:description "A formatted (e.g. HTML/Markdown) text editor, for values meant to render with styling."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:NumberFieldEditor
	sh:name "number field"@en ;
	sh:description "A numeric input, for xsd:integer/xsd:decimal/xsd:double-typed values."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:BooleanEditor
	sh:name "boolean editor"@en ;
	sh:description "A checkbox or toggle, for xsd:boolean-typed values."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:DatePickerEditor
	sh:name "date picker"@en ;
	sh:description "A calendar-style date picker, for xsd:date-typed values."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:DateTimePickerEditor
	sh:name "date-time picker"@en ;
	sh:description "A calendar-and-time picker, for xsd:dateTime-typed values."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
	stsh:requiredEngine stsh:StarShacl .

shui:IRIEditor
	sh:name "IRI editor"@en ;
	sh:description "A plain-text input constrained to well-formed IRIs."@en ;
	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
