# SOURCE of what StarLayer adds to the W3C SHACL 1.2 vocabulary (scripts/assets/vendor/w3c-shacl.ttl, never edited).
# HAND-EDITED. scripts/build_starontology.py writes the registered file starontology/shacl12-vocabulary.ttl (registry entry
# shacl_vocabulary) from the vendored file plus this one.
#
# Contents: stsh:ShapesGraphShape, a description of what a shapes graph holds, for tools that show shapes graphs. It has one property
# shape per kind of entity a shapes graph defines. The path of each is the INVERSE of rdfs:isDefinedBy: the entity says
# rdfs:isDefinedBy the graph (SHACL 1.2 Profiling, "Indicating Element definition"), so the graph reaches it backwards. sh:class
# says the kind and sh:order the order a tool lists them in. What a graph merely uses it lists with rdfs:member ("Indicating Element
# use"), and the Profiling vocabulary puts no type on that. The Profiling vocabulary does not restrict the types a graph defines
# either; this list is what a tool offers a home for. The shapes describe, they do not validate: this graph is never loaded for
# validation, and a shape in it is not a constraint on a user's file.
#
# baseURI: https://github.com/hidden-graph/starlayer/ns/shacl#

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix stsh: <https://github.com/hidden-graph/starlayer/ns/shacl#> .

# The kinds a shapes graph defines are in groups, in the order a tool lists them (sh:group of each, sh:order of the group and of the kind).
# sh:Severity is not listed: any IRI is a severity (Core 3.1.4) and a tool need not offer to declare one. SHACL-AF kinds that SHACL 1.2 no longer defines (sh:Function, sh:SPARQLFunction, sh:Target with SPARQLTarget and TargetType: SPARQL Extensions, Appendix F)
# are not offered here; the vocabulary still has them, and an entity of one of those types is still shown by a tool.
# A kind is listed when the specification lets its instances be an IRI as well as a blank node, so an editor can accept an IRI wherever either is allowed.
# A widget is an editor or a viewer (shui:Widget is the superclass of both, in the W3C SHACL UI vocabulary), declared as an instance of its single or its multiple
# subclass (SHACL UI, Section 5): one kind, and the subclass says what it is and how many values it controls. The subclass links are stated here, since this
# vocabulary does not have the SHACL UI classes.

stsh:KindGroupShared a sh:PropertyGroup ;
    rdfs:label "Prefixes and Parameters" ;
    sh:order 1 .

stsh:KindGroupShapes a sh:PropertyGroup ;
    rdfs:label "Shapes" ;
    sh:order 2 .

stsh:KindGroupConstraints a sh:PropertyGroup ;
    rdfs:label "SPARQL, constraints and components" ;
    sh:order 3 .

stsh:KindGroupFunctions a sh:PropertyGroup ;
    rdfs:label "Functions for node expressions" ;
    sh:order 4 .

stsh:KindGroupRules a sh:PropertyGroup ;
    rdfs:label "Inference rules" ;
    sh:order 5 .

stsh:KindGroupUI a sh:PropertyGroup ;
    rdfs:label "User interface" ;
    sh:order 6 .

stsh:ShapesGraphShape a sh:NodeShape ;
    rdfs:label "A shapes graph" ;
    rdfs:comment "What a shapes graph defines (the entities that say rdfs:isDefinedBy it), one property shape per kind, in groups and in the order a tool lists them, and what it uses (it lists them with rdfs:member)." ;
    sh:targetClass sh:ShapesGraph ;
    sh:property
        stsh:ShapesGraphDefinesPrefixDeclaration,
        stsh:ShapesGraphDefinesNodeShape,
        stsh:ShapesGraphDefinesPropertyShape,
        stsh:ShapesGraphDefinesSPARQLConstraint,
        stsh:ShapesGraphDefinesConstraintComponent,
        stsh:ShapesGraphDefinesParameter,
        stsh:ShapesGraphDefinesValidator,
        stsh:ShapesGraphDefinesResultAnnotation,
        stsh:ShapesGraphDefinesNamedParameterExpressionFunction,
        stsh:ShapesGraphDefinesListParameterExpressionFunction,
        stsh:ShapesGraphDefinesRuleSet,
        stsh:ShapesGraphDefinesTripleRule,
        stsh:ShapesGraphDefinesSPARQLRule,
        stsh:ShapesGraphDefinesPropertyGroup,
        stsh:ShapesGraphDefinesWidgetScore,
        stsh:ShapesGraphDefinesWidgetAcceptMatcher,
        stsh:ShapesGraphDefinesConfiguration,
        stsh:ShapesGraphDefinesWidget,
        stsh:ShapesGraphUses .

stsh:ShapesGraphDefinesNodeShape a sh:PropertyShape ;
    sh:name "node shapes" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:NodeShape ;
    sh:group stsh:KindGroupShapes ;
    sh:order 3 .

stsh:ShapesGraphDefinesPropertyShape a sh:PropertyShape ;
    sh:name "property shapes" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:PropertyShape ;
    sh:group stsh:KindGroupShapes ;
    sh:order 4 .

stsh:ShapesGraphDefinesPropertyGroup a sh:PropertyShape ;
    sh:name "property groups" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:PropertyGroup ;
    sh:group stsh:KindGroupUI ;
    sh:order 14 .

stsh:ShapesGraphDefinesSPARQLConstraint a sh:PropertyShape ;
    sh:name "SPARQL constraints" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:SPARQLConstraint ;
    sh:group stsh:KindGroupConstraints ;
    sh:order 5 .

stsh:ShapesGraphDefinesConstraintComponent a sh:PropertyShape ;
    sh:name "constraint components" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:ConstraintComponent ;
    sh:group stsh:KindGroupConstraints ;
    sh:order 6 .

stsh:ShapesGraphDefinesParameter a sh:PropertyShape ;
    sh:name "parameters" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:Parameter ;
    sh:group stsh:KindGroupShared ;
    sh:order 2 .

stsh:ShapesGraphDefinesValidator a sh:PropertyShape ;
    sh:name "validators" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:Validator ;    # the ASK and SELECT validators together (both are subclasses): the kind follows from sh:ask or sh:select
    sh:group stsh:KindGroupConstraints ;
    sh:order 7 .

stsh:ShapesGraphDefinesResultAnnotation a sh:PropertyShape ;
    sh:name "result annotations" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:ResultAnnotation ;
    sh:group stsh:KindGroupConstraints ;
    sh:order 8 .

stsh:ShapesGraphDefinesPrefixDeclaration a sh:PropertyShape ;
    sh:name "prefix declarations" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:PrefixDeclaration ;
    sh:group stsh:KindGroupShared ;
    sh:order 1 .

stsh:ShapesGraphDefinesNamedParameterExpressionFunction a sh:PropertyShape ;
    sh:name "functions with named parameters" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:NamedParameterExpressionFunction ;
    sh:group stsh:KindGroupFunctions ;
    sh:order 9 .

stsh:ShapesGraphDefinesListParameterExpressionFunction a sh:PropertyShape ;
    sh:name "functions with list parameters" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:ListParameterExpressionFunction ;
    sh:group stsh:KindGroupFunctions ;
    sh:order 10 .

stsh:ShapesGraphDefinesRuleSet a sh:PropertyShape ;
    sh:name "rule sets" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:RuleSet ;
    sh:group stsh:KindGroupRules ;
    sh:order 11 .

stsh:ShapesGraphDefinesTripleRule a sh:PropertyShape ;
    sh:name "triple rules" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:TripleRule ;
    sh:group stsh:KindGroupRules ;
    sh:order 12 .

stsh:ShapesGraphDefinesSPARQLRule a sh:PropertyShape ;
    sh:name "SPARQL rules" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class sh:SPARQLRule ;
    sh:group stsh:KindGroupRules ;
    sh:order 13 .

stsh:ShapesGraphDefinesWidgetScore a sh:PropertyShape ;
    sh:name "widget scores" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class shui:WidgetScore ;
    sh:group stsh:KindGroupUI ;
    sh:order 15 .

stsh:ShapesGraphDefinesWidgetAcceptMatcher a sh:PropertyShape ;
    sh:name "widget accept matchers" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class shui:WidgetAcceptMatcher ;
    sh:group stsh:KindGroupUI ;
    sh:order 16 .

stsh:ShapesGraphDefinesConfiguration a sh:PropertyShape ;
    sh:name "UI configurations" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class shui:Configuration ;
    sh:group stsh:KindGroupUI ;
    sh:order 17 .

stsh:ShapesGraphDefinesWidget a sh:PropertyShape ;
    sh:name "widgets" ;
    sh:path [ sh:inversePath rdfs:isDefinedBy ] ;
    sh:class shui:Widget ;
    sh:group stsh:KindGroupUI ;
    sh:order 18 .

stsh:ShapesGraphUses a sh:PropertyShape ;
    sh:name "uses" ;
    sh:path rdfs:member ;
    sh:order 100 .

shui:Editor rdfs:subClassOf shui:Widget .
shui:Viewer rdfs:subClassOf shui:Widget .
shui:SingleEditor rdfs:subClassOf shui:Editor .
shui:MultiEditor rdfs:subClassOf shui:Editor .
shui:SingleViewer rdfs:subClassOf shui:Viewer .
shui:MultiViewer rdfs:subClassOf shui:Viewer .
