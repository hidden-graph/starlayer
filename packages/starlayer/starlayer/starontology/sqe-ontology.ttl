@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#> .

sqe:AskQuery rdfs:comment "An ASK query's root. sqe:where -> the flat pattern list; no projection." ;
    rdfs:subClassOf sqe:Query .

sqe:Bind a rdfs:Class ;
    rdfs:comment "A BIND(... AS ?var) element - sqe:expr -> an expression tree (spexpr:); sqe:var -> the bound variable." .

sqe:DescribeQuery a rdfs:Class ;
    rdfs:subClassOf sqe:Query ;
    rdfs:comment "A DESCRIBE query's root. sqe:describe -> rdf:List of IRIs and variables, or sqe:describeAll true for DESCRIBE *; an optional sqe:where; optionally sqe:dataset, sqe:groupBy, sqe:having, sqe:orderBy, sqe:limit, sqe:offset and a trailing sqe:values." .

sqe:ConstructQuery rdfs:comment "A CONSTRUCT query's root. sqe:template -> rdf:List of sqe:TriplePattern; sqe:where -> the flat pattern list." ;
    rdfs:subClassOf sqe:Query .

sqe:Filter a rdfs:Class ;
    rdfs:comment "A FILTER(...) element - sqe:expr -> an expression tree (the shared spexpr: vocabulary, not re-modeled here)." .

sqe:Optional a rdfs:Class ;
    rdfs:comment "An OPTIONAL { ... } block - sqe:where -> its own nested flat pattern list." .

sqe:OrderCondition a rdfs:Class ;
    rdfs:comment "One ORDER BY condition - sqe:expr -> a variable or expression; sqe:descending true for DESC(...), absent for ascending." .

sqe:Query rdfs:comment "The root of any encoded sqe: query, of any form - also typed sqe:Query regardless of query form, see to_rdf.query_to_sqe_rdf." .

sqe:SelectQuery rdfs:comment "A SELECT query's root. sqe:projection -> rdf:List of variables and sqe:Alias nodes (or sqe:selectAll true for SELECT *); sqe:where -> the flat pattern list; optionally sqe:distinct/reduced, sqe:groupBy, sqe:having, sqe:orderBy, sqe:limit, sqe:offset and a trailing sqe:values." ;
    rdfs:subClassOf sqe:Query .

sqe:TriplePattern a rdfs:Class ;
    rdfs:comment "One (subject, predicate, object) triple pattern - exactly one of each, via sqe:subject/sqe:predicate/sqe:object. A predicate that's a real property path uses the shared spexpr: path encoding." .

sqe:TripleTerm a rdfs:Class ;
    rdfs:comment "An RDF 1.2 triple term <<( s p o )>> in a pattern's object position (or nested as another triple term's object) - sqe:subject/sqe:predicate/sqe:object, each a term or variable. Reified-triple and annotation shorthand is written out as its expansion: a rdf:reifies triple plus ordinary triples." .

sqe:Union a rdfs:Class ;
    rdfs:comment "A { ... } UNION { ... } [UNION { ... }]* block - sqe:alternatives -> rdf:List of nested flat pattern lists, one per alternative." .

sqe:alternatives a rdf:Property ;
    rdfs:domain sqe:Union .

sqe:expr a rdf:Property ;
    rdfs:comment "Shared by several node types (sqe:Filter, Bind, Alias, OrderCondition); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

sqe:object a rdf:Property ;
    rdfs:comment "Shared by several node types (sqe:TriplePattern, TripleTerm); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

sqe:predicate a rdf:Property ;
    rdfs:comment "Shared by several node types (sqe:TriplePattern, TripleTerm); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

sqe:projection a rdf:Property ;
    rdfs:domain sqe:SelectQuery .

sqe:subject a rdf:Property ;
    rdfs:comment "Shared by several node types (sqe:TriplePattern, TripleTerm); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

sqe:template a rdf:Property ;
    rdfs:domain sqe:ConstructQuery .

sqe:var a rdf:Property ;
    rdfs:comment "Shared by several node types (sqe:Bind, Alias); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

sqe:where a rdf:Property ;
    rdfs:comment "A flat, ordered rdf:List of sibling pattern elements (sqe:TriplePattern/Optional/Union/Minus/Graph/Service/Filter/Bind/Values/SubSelect) - mirrors the raw parse tree's own already-flat GroupGraphPatternSub.part shape, not a resolved algebra's nested LeftJoin/Filter wrapping." .

sqe:selectAll a rdf:Property ;
    rdfs:domain sqe:SelectQuery ;
    rdfs:comment "true for SELECT *; replaces sqe:projection." .

sqe:distinct a rdf:Property ;
    rdfs:domain sqe:SelectQuery ;
    rdfs:comment "true for SELECT DISTINCT." .

sqe:reduced a rdf:Property ;
    rdfs:domain sqe:SelectQuery ;
    rdfs:comment "true for SELECT REDUCED." .

sqe:orderBy a rdf:Property ;
    rdfs:comment "ORDER BY: a flat rdf:List of sqe:OrderCondition, on a SELECT or CONSTRUCT root." .

sqe:descending a rdf:Property ;
    rdfs:domain sqe:OrderCondition .

sqe:limit a rdf:Property ;
    rdfs:comment "LIMIT n (xsd:integer), on a SELECT or CONSTRUCT root." .

sqe:offset a rdf:Property ;
    rdfs:comment "OFFSET n (xsd:integer), on a SELECT or CONSTRUCT root." .

sqe:TripleTerm rdfs:subClassOf spexpr:Expression .

sqe:Exists a rdfs:Class ;
    rdfs:subClassOf spexpr:Expression ;
    rdfs:comment "EXISTS { ... } (or NOT EXISTS when sqe:negated is true) inside an expression - sqe:where -> its own flat pattern list." .

sqe:negated a rdf:Property ;
    rdfs:domain sqe:Exists .

sqe:Alias a rdfs:Class ;
    rdfs:comment "(expr AS ?var) in a projection or GROUP BY - sqe:expr the expression, sqe:var the variable it binds." .

sqe:groupBy a rdf:Property ;
    rdfs:comment "GROUP BY on a SELECT, ASK, CONSTRUCT or DESCRIBE root (no rdfs:domain: a domain would type the other forms as SELECT)." .

sqe:having a rdf:Property ;
    rdfs:comment "HAVING on a SELECT, ASK, CONSTRUCT or DESCRIBE root (no rdfs:domain: a domain would type the other forms as SELECT)." .

sqe:Minus a rdfs:Class ;
    rdfs:comment "A MINUS { ... } block - sqe:where -> its own flat pattern list." .

sqe:Graph a rdfs:Class ;
    rdfs:comment "A GRAPH ?g { ... } block - sqe:graph the graph IRI or variable, sqe:where the flat pattern list." .

sqe:Values a rdfs:Class ;
    rdfs:comment "A VALUES block, as a pattern or as a query's trailing sqe:values - sqe:vars the variables, sqe:rows an rdf:List of rows (rdf:List of terms, or sqe:undef)." .

sqe:SubSelect a rdfs:Class ;
    rdfs:subClassOf sqe:SelectQuery ;
    rdfs:comment "A nested SELECT in a pattern list - the same properties as a sqe:SelectQuery; not itself a sqe:Query." .

sqe:graph a rdf:Property ;
    rdfs:domain sqe:Graph .

sqe:vars a rdf:Property ;
    rdfs:domain sqe:Values .

sqe:rows a rdf:Property ;
    rdfs:domain sqe:Values .

sqe:values a rdf:Property ;
    rdfs:comment "A query's trailing VALUES clause (a sqe:Values)." .

sqe:describe a rdf:Property ;
    rdfs:domain sqe:DescribeQuery ;
    rdfs:comment "DESCRIBE targets: an rdf:List of IRIs and variables." .

sqe:describeAll a rdf:Property ;
    rdfs:domain sqe:DescribeQuery ;
    rdfs:comment "true for DESCRIBE *; replaces sqe:describe." .

sqe:DatasetClause a rdfs:Class ;
    rdfs:comment "One FROM <iri> or FROM NAMED <iri> clause - sqe:source the graph IRI, sqe:named true for FROM NAMED." .

sqe:dataset a rdf:Property ;
    rdfs:comment "A query's FROM / FROM NAMED clauses: an rdf:List of sqe:DatasetClause in source order, on a SELECT, ASK, CONSTRUCT or DESCRIBE root." .

sqe:source a rdf:Property ;
    rdfs:domain sqe:DatasetClause .

sqe:named a rdf:Property ;
    rdfs:domain sqe:DatasetClause .

sqe:Service a rdfs:Class ;
    rdfs:comment "A SERVICE [SILENT] <iri-or-variable> { ... } block - sqe:service the endpoint, sqe:silent true for SILENT, sqe:where the flat pattern list." .

sqe:service a rdf:Property ;
    rdfs:domain sqe:Service .

sqe:silent a rdf:Property ;
    rdfs:comment "true for SILENT, on a sqe:Service and on the update operations that take it (Load, Clear, Drop, Create, Add, Move, Copy); deliberately no rdfs:domain, which would give an update operation the wrong extra type under RDFS inference." .

sqe:version a rdf:Property ;
    rdfs:comment "A VERSION \"x\" declaration of the query prologue (a plain string) on a query root; may repeat." .

sqe:UpdateRequest a rdfs:Class ;
    rdfs:comment "The root of an encoded SPARQL Update request. sqe:operations -> the rdf:List of operations in source order (empty for an empty request); a prologue written after the last operation is stored on the root (sqe:base, sqe:prologuePrefix, sqe:version)." .

sqe:UpdateOperation a rdfs:Class ;
    rdfs:comment "One operation of an update request. Carries the prologue (sqe:base, sqe:prologuePrefix, sqe:version) written in front of it; the prefixes of earlier operations stay in force for later ones." .

sqe:operations a rdf:Property ;
    rdfs:domain sqe:UpdateRequest .

sqe:InsertData a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "INSERT DATA { ... } - sqe:quads the data. No variables." .

sqe:DeleteData a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "DELETE DATA { ... } - sqe:quads the data. No variables and no blank nodes." .

sqe:DeleteWhere a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "DELETE WHERE { ... } - sqe:quads the pattern (also the template). No blank nodes." .

sqe:Modify a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "[WITH iri] ( DELETE {..} [INSERT {..}] | INSERT {..} ) [USING [NAMED] iri]* WHERE {..} - sqe:with, sqe:delete (no blank nodes), sqe:insert, sqe:using (rdf:List of sqe:DatasetClause), sqe:where." .

sqe:Load a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "LOAD [SILENT] iri [INTO GRAPH iri] - sqe:loadFrom, optional sqe:into (a sqe:GraphRef; absent: the default graph), optional sqe:silent." .

sqe:Clear a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "CLEAR [SILENT] (GRAPH iri | DEFAULT | NAMED | ALL) - sqe:target a graph reference." .

sqe:Drop a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "DROP [SILENT] (GRAPH iri | DEFAULT | NAMED | ALL) - sqe:target a graph reference." .

sqe:Create a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "CREATE [SILENT] GRAPH iri - sqe:target a sqe:GraphRef." .

sqe:Add a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "ADD [SILENT] from TO to - sqe:from and sqe:to, each a sqe:GraphRef or sqe:DefaultGraph." .

sqe:Move a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "MOVE [SILENT] from TO to - sqe:from and sqe:to, each a sqe:GraphRef or sqe:DefaultGraph." .

sqe:Copy a rdfs:Class ;
    rdfs:subClassOf sqe:UpdateOperation ;
    rdfs:comment "COPY [SILENT] from TO to - sqe:from and sqe:to, each a sqe:GraphRef or sqe:DefaultGraph." .

sqe:quads a rdf:Property ;
    rdfs:comment "An rdf:List of sqe:TriplePattern (default graph) and sqe:QuadGraph, in written order: the quads of INSERT DATA, DELETE DATA and DELETE WHERE. Shared by three classes, so no rdfs:domain." .

sqe:delete a rdf:Property ;
    rdfs:domain sqe:Modify ;
    rdfs:comment "The DELETE template of a Modify: an rdf:List of sqe:TriplePattern and sqe:QuadGraph (may be empty)." .

sqe:insert a rdf:Property ;
    rdfs:domain sqe:Modify ;
    rdfs:comment "The INSERT template of a Modify: an rdf:List of sqe:TriplePattern and sqe:QuadGraph (may be empty)." .

sqe:with a rdf:Property ;
    rdfs:domain sqe:Modify ;
    rdfs:comment "WITH iri of a Modify." .

sqe:using a rdf:Property ;
    rdfs:domain sqe:Modify ;
    rdfs:comment "The USING / USING NAMED clauses of a Modify: an rdf:List of sqe:DatasetClause." .

sqe:QuadGraph a rdfs:Class ;
    rdfs:comment "GRAPH iri-or-variable { triples } inside a quad list - sqe:graphName, sqe:triples (an rdf:List of sqe:TriplePattern, may be empty)." .

sqe:graphName a rdf:Property ;
    rdfs:domain sqe:QuadGraph .

sqe:triples a rdf:Property ;
    rdfs:domain sqe:QuadGraph .

sqe:loadFrom a rdf:Property ;
    rdfs:domain sqe:Load ;
    rdfs:comment "The IRI a LOAD reads." .

sqe:into a rdf:Property ;
    rdfs:domain sqe:Load ;
    rdfs:comment "The graph a LOAD writes to: a sqe:GraphRef." .

sqe:target a rdf:Property ;
    rdfs:comment "The graph reference of CLEAR, DROP and CREATE. Shared, so no rdfs:domain." .

sqe:from a rdf:Property ;
    rdfs:comment "The source graph reference of ADD, MOVE and COPY. Shared, so no rdfs:domain." .

sqe:to a rdf:Property ;
    rdfs:comment "The destination graph reference of ADD, MOVE and COPY. Shared, so no rdfs:domain." .

sqe:GraphRef a rdfs:Class ;
    rdfs:comment "GRAPH iri as a graph reference of an update operation - sqe:graphIri." .

sqe:graphIri a rdf:Property ;
    rdfs:domain sqe:GraphRef .

sqe:DefaultGraph a rdfs:Class ;
    rdfs:comment "The graph reference DEFAULT (the default graph)." .

sqe:NamedGraphs a rdfs:Class ;
    rdfs:comment "The graph reference NAMED (all named graphs)." .

sqe:AllGraphs a rdfs:Class ;
    rdfs:comment "The graph reference ALL (the default graph and all named graphs)." .
