@prefix manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tree: <https://github.com/hidden-graph/starlayer/ns/tree#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ordered children (frames, clauses, entries, operands, annotations, ...) are written with the shared tree: vocabulary: a blank node child carries
# tree:ord itself, an IRI or literal sits in a tree:Item. The shapes for the ordinals (one non-negative integer, no tie, a blank child with one
# parent only) are in tree_shapes.ttl and are imported below; the Ordered...Shape nodes here say which kind of child each ordered property holds.


manch:ClassExpressionOrNameShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] manch:ClassExpressionShape ) .

manch:ClassExpressionShape a sh:NodeShape ;
    sh:class manch:ClassExpression ;
    sh:message "expected a recognized class-expression tag (see manch:ClassExpression in manchester-ast-ontology.ttl)" .

manch:ClauseShape a sh:NodeShape ;
    sh:class manch:Clause ;
    sh:message "expected a recognized clause type" .

manch:DataNotShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:DataRangeOrNameShape ;
        sh:path manch:operand
    ] ;
    sh:targetClass manch:DataNot .

manch:DataRangeOrNameShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] manch:DataRangeShape ) .

manch:DataRangeShape a sh:NodeShape ;
    sh:class manch:DataRange ;
    sh:message "expected a recognized data-range tag" .

manch:ExactlyShape a sh:NodeShape ;
    sh:property [
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path manch:cardinality
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ], [
        sh:maxCount 1 ;
        sh:node manch:ClassExpressionOrNameShape ;
        sh:path manch:filler
    ] ;
    sh:targetClass manch:Exactly .

manch:FacetRestrictionShape a sh:NodeShape ;
    sh:property [
        sh:in ( xsd:minInclusive xsd:maxInclusive xsd:minExclusive xsd:maxExclusive xsd:length xsd:minLength xsd:maxLength xsd:pattern rdf:langRange ) ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:facet
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:path manch:restrictionValue
    ] ;
    sh:targetClass manch:FacetRestriction .

manch:FrameShape a sh:NodeShape ;
    sh:class manch:Frame ;
    sh:message "expected a recognized frame type" .

manch:InverseShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:operand
    ] ;
    sh:targetClass manch:Inverse .

manch:MaxShape a sh:NodeShape ;
    sh:property [
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path manch:cardinality
    ], [
        sh:maxCount 1 ;
        sh:node manch:ClassExpressionOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:Max .

manch:MinShape a sh:NodeShape ;
    sh:property [
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path manch:cardinality
    ], [
        sh:maxCount 1 ;
        sh:node manch:ClassExpressionOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:Min .

manch:MiscAxiomShape a sh:NodeShape ;
    sh:class manch:MiscAxiom ;
    sh:message "expected a recognized Misc-axiom type" .

manch:NotShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:ClassExpressionOrNameShape ;
        sh:path manch:operand
    ] ;
    sh:targetClass manch:Not .

manch:OnlyShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:ClassExpressionOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:Only .

manch:PrefixDeclarationShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:path manch:namespace
    ], [
        sh:datatype manch:PlainString ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path manch:prefixName
    ] ;
    sh:targetClass manch:PrefixDeclaration .

manch:PropertyExpressionOrNameShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] manch:PropertyExpressionShape ) .

manch:PropertyExpressionShape a sh:NodeShape ;
    sh:class manch:PropertyExpression ;
    sh:message "expected a recognized property-expression tag" .

manch:SelfShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:Self .

manch:SomeShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:ClassExpressionOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:Some .

manch:ValueClauseShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:ValueShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:Value .

manch:ValueShape a sh:NodeShape ;
    sh:message "a bare individual/data value must be an IRI or Literal" ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] [
        sh:nodeKind sh:Literal
    ] ) .

manch:DataSomeShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:DataRangeOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:DataSome .

manch:DataOnlyShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:DataRangeOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:DataOnly .

manch:DataMinShape a sh:NodeShape ;
    sh:property [
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path manch:cardinality
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:DataRangeOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:DataMin .

manch:DataMaxShape a sh:NodeShape ;
    sh:property [
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path manch:cardinality
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:DataRangeOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:DataMax .

manch:DataExactlyShape a sh:NodeShape ;
    sh:property [
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path manch:cardinality
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:DataRangeOrNameShape ;
        sh:path manch:filler
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:onProperty
    ] ;
    sh:targetClass manch:DataExactly .

manch:OrderedClassExpressionShape a sh:NodeShape ;
    sh:or ( [
    sh:class manch:ClassExpression ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode
    ] [
    sh:class tree:Item ;
    sh:node tree:ItemShape ;
    sh:property [ sh:path tree:value ; sh:nodeKind sh:IRI ]
    ] ) .

manch:OrderedPropertyExpressionShape a sh:NodeShape ;
    sh:or ( [
    sh:class manch:PropertyExpression ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode
    ] [
    sh:class tree:Item ;
    sh:node tree:ItemShape ;
    sh:property [ sh:path tree:value ; sh:nodeKind sh:IRI ]
    ] ) .

manch:OrderedDataRangeShape a sh:NodeShape ;
    sh:or ( [
    sh:class manch:DataRange ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode
    ] [
    sh:class tree:Item ;
    sh:node tree:ItemShape ;
    sh:property [ sh:path tree:value ; sh:nodeKind sh:IRI ]
    ] ) .

manch:OrderedNameShape a sh:NodeShape ;
    sh:class tree:Item ;
    sh:node tree:ItemShape ;
    sh:property [ sh:path tree:value ; sh:nodeKind sh:IRI ] .

manch:OrderedLiteralShape a sh:NodeShape ;
    sh:class tree:Item ;
    sh:node tree:ItemShape ;
    sh:property [ sh:path tree:value ; sh:nodeKind sh:Literal ] .

manch:OrderedPrefixDeclarationShape a sh:NodeShape ;
    sh:class manch:PrefixDeclaration ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode .

manch:OrderedFrameShape a sh:NodeShape ;
    sh:class manch:Frame ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode .

manch:OrderedClauseShape a sh:NodeShape ;
    sh:class manch:Clause ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode .

manch:OrderedMiscAxiomShape a sh:NodeShape ;
    sh:class manch:MiscAxiom ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode .

manch:OrderedAnnotationShape a sh:NodeShape ;
    sh:class manch:Annotation ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode .

manch:OrderedFacetRestrictionShape a sh:NodeShape ;
    sh:class manch:FacetRestriction ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode .

manch:OrderedFactShape a sh:NodeShape ;
    sh:class manch:Fact ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode .

manch:ClassItemShape a sh:NodeShape ;
    sh:class manch:ClauseItem ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:ClassExpressionOrNameShape ;
        sh:path manch:value
    ] .

manch:PropertyItemShape a sh:NodeShape ;
    sh:class manch:ClauseItem ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:PropertyExpressionOrNameShape ;
        sh:path manch:value
    ] .

manch:DataRangeItemShape a sh:NodeShape ;
    sh:class manch:ClauseItem ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:DataRangeOrNameShape ;
        sh:path manch:value
    ] .

manch:NameItemShape a sh:NodeShape ;
    sh:class manch:ClauseItem ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:value
    ] .

manch:ObjectPropertyCharacteristicItemShape a sh:NodeShape ;
    sh:class manch:ClauseItem ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:in ( owl:FunctionalProperty owl:InverseFunctionalProperty owl:TransitiveProperty owl:SymmetricProperty owl:AsymmetricProperty owl:ReflexiveProperty owl:IrreflexiveProperty ) ;
        sh:message "expected a property characteristic: Functional, InverseFunctional, Transitive, Symmetric, Asymmetric, Reflexive or Irreflexive" ;
        sh:nodeKind sh:IRI ;
        sh:path manch:value
    ] .

manch:DataPropertyCharacteristicItemShape a sh:NodeShape ;
    sh:class manch:ClauseItem ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:in ( owl:FunctionalProperty ) ;
        sh:message "expected a property characteristic: Functional (the only characteristic of a data property)" ;
        sh:nodeKind sh:IRI ;
        sh:path manch:value
    ] .

manch:ClassListItemShape a sh:NodeShape ;
    sh:class manch:ClauseItem ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [
        sh:maxCount 0 ;
        sh:path manch:value
    ], [
        sh:message "a single-axiom clause entry has at least one ordered manch:values member" ;
        sh:minCount 1 ;
        sh:node manch:OrderedClassExpressionShape ;
        sh:path manch:values
    ] .

manch:PropertyListItemShape a sh:NodeShape ;
    sh:class manch:ClauseItem ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode ;
    sh:property [
        sh:maxCount 0 ;
        sh:path manch:value
    ], [
        sh:message "a single-axiom clause entry has at least one ordered manch:values member" ;
        sh:minCount 1 ;
        sh:node manch:OrderedPropertyExpressionShape ;
        sh:path manch:values
    ] .

manch:ClassSubClassOfClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ClassItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ClassSubClassOfClause .

manch:ClassEquivalentToClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ClassItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ClassEquivalentToClause .

manch:ClassDisjointWithClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ClassItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ClassDisjointWithClause .

manch:ObjectPropertyDomainClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ClassItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertyDomainClause .

manch:ObjectPropertyRangeClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ClassItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertyRangeClause .

manch:DataPropertyDomainClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ClassItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DataPropertyDomainClause .

manch:IndividualTypesClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ClassItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:IndividualTypesClause .

manch:ObjectPropertySubPropertyOfClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertySubPropertyOfClause .

manch:ObjectPropertyEquivalentToClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertyEquivalentToClause .

manch:ObjectPropertyDisjointWithClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertyDisjointWithClause .

manch:ObjectPropertyInverseOfClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertyInverseOfClause .

manch:DataPropertySubPropertyOfClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DataPropertySubPropertyOfClause .

manch:DataPropertyEquivalentToClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DataPropertyEquivalentToClause .

manch:DataPropertyDisjointWithClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DataPropertyDisjointWithClause .

manch:DataPropertyRangeClause a sh:NodeShape ;
    sh:property [
        sh:node manch:DataRangeItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DataPropertyRangeClause .

manch:DatatypeEquivalentToClause a sh:NodeShape ;
    sh:property [
        sh:node manch:DataRangeItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DatatypeEquivalentToClause .

manch:AnnotationPropertyDomainClause a sh:NodeShape ;
    sh:property [
        sh:node manch:NameItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:AnnotationPropertyDomainClause .

manch:AnnotationPropertyRangeClause a sh:NodeShape ;
    sh:property [
        sh:node manch:NameItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:AnnotationPropertyRangeClause .

manch:AnnotationPropertySubPropertyOfClause a sh:NodeShape ;
    sh:property [
        sh:node manch:NameItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:AnnotationPropertySubPropertyOfClause .

manch:IndividualSameAsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:NameItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:IndividualSameAsClause .

manch:IndividualDifferentFromClause a sh:NodeShape ;
    sh:property [
        sh:node manch:NameItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:IndividualDifferentFromClause .

manch:ObjectPropertyCharacteristicsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ObjectPropertyCharacteristicItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertyCharacteristicsClause .

manch:DataPropertyCharacteristicsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:DataPropertyCharacteristicItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DataPropertyCharacteristicsClause .

manch:ClassDisjointUnionOfClause a sh:NodeShape ;
    sh:property [
        sh:node manch:ClassListItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ClassDisjointUnionOfClause .

manch:ClassHasKeyClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyListItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ClassHasKeyClause .

manch:ObjectPropertySubPropertyChainClause a sh:NodeShape ;
    sh:property [
        sh:node manch:PropertyListItemShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertySubPropertyChainClause .

manch:IndividualFactsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedFactShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:IndividualFactsClause .

manch:ClassAnnotationsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ClassAnnotationsClause .

manch:ObjectPropertyAnnotationsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:ObjectPropertyAnnotationsClause .

manch:DataPropertyAnnotationsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DataPropertyAnnotationsClause .

manch:AnnotationPropertyAnnotationsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:AnnotationPropertyAnnotationsClause .

manch:IndividualAnnotationsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:IndividualAnnotationsClause .

manch:DatatypeAnnotationsClause a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:DatatypeAnnotationsClause .

manch:MiscEquivalentClassesAxiom a sh:NodeShape ;
    sh:property [
        sh:minCount 1 ;
        sh:node manch:OrderedClassExpressionShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:MiscEquivalentClassesAxiom .

manch:MiscDisjointClassesAxiom a sh:NodeShape ;
    sh:property [
        sh:minCount 1 ;
        sh:node manch:OrderedClassExpressionShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:MiscDisjointClassesAxiom .

manch:MiscEquivalentPropertiesAxiom a sh:NodeShape ;
    sh:property [
        sh:minCount 1 ;
        sh:node manch:OrderedPropertyExpressionShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:MiscEquivalentPropertiesAxiom .

manch:MiscDisjointPropertiesAxiom a sh:NodeShape ;
    sh:property [
        sh:minCount 1 ;
        sh:node manch:OrderedPropertyExpressionShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:MiscDisjointPropertiesAxiom .

manch:MiscSameIndividualAxiom a sh:NodeShape ;
    sh:property [
        sh:minCount 1 ;
        sh:node manch:OrderedNameShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:MiscSameIndividualAxiom .

manch:MiscDifferentIndividualsAxiom a sh:NodeShape ;
    sh:property [
        sh:minCount 1 ;
        sh:node manch:OrderedNameShape ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:MiscDifferentIndividualsAxiom .

manch:MiscAxiomItemsShape a sh:NodeShape ;
    sh:property [
        sh:minCount 1 ;
        sh:path manch:items
    ], [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:annotations
    ] ;
    sh:targetClass manch:MiscAxiom .

manch:ClauseItemsShape a sh:NodeShape ;
    sh:property [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:path manch:reversed
    ], [
        sh:message "a clause has at least one entry in manch:items" ;
        sh:minCount 1 ;
        sh:path manch:items
    ] ;
    sh:targetClass manch:Clause .

manch:ClauseItemShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:path manch:value
    ], [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:annotations
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "a clause entry has exactly one of manch:value (an ordinary entry) or manch:values (a single-axiom entry: DisjointUnionOf:, HasKey:, SubPropertyChain:)" ;
        sh:select """
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                OPTIONAL { $this manch:value ?v }
                OPTIONAL { $this manch:values ?w }
                FILTER ( BOUND(?v) = BOUND(?w) )
            }
        """
    ] ;
    sh:targetClass manch:ClauseItem .

manch:FactShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:ValueShape ;
        sh:path manch:value
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:path manch:negative
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:property
    ], [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:annotations
    ] ;
    sh:targetClass manch:Fact .

manch:AnnotationShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:node manch:ValueShape ;
        sh:path manch:annotationTarget
    ], [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:annotationProperty
    ], [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:annotations
    ] ;
    sh:targetClass manch:Annotation .

manch:OntologyHeaderShape a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedNameShape ;
        sh:path manch:imports
    ], [
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:ontologyIRI
    ], [
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:versionIRI
    ], [
        sh:node manch:OrderedAnnotationShape ;
        sh:path manch:annotations
    ] ;
    sh:targetClass manch:OntologyHeader .

manch:OntologyDocumentShape a sh:NodeShape ;
    sh:property [
        sh:node manch:OrderedPrefixDeclarationShape ;
        sh:path manch:prefixes
    ], [
        sh:node manch:OrderedFrameShape ;
        sh:path manch:frames
    ], [
        sh:class manch:OntologyHeader ;
        sh:maxCount 1 ;
        sh:path manch:header
    ], [
        sh:node manch:OrderedMiscAxiomShape ;
        sh:path manch:misc
    ] ;
    sh:targetClass manch:OntologyDocument .

manch:FrameShapeDetail a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:subject
    ], [
        sh:node manch:OrderedClauseShape ;
        sh:path manch:clauses
    ] ;
    sh:targetClass manch:Frame .

manch:AndShape a sh:NodeShape ;
    sh:property [
        sh:message "manch:And has two or more ordered manch:operands" ;
        sh:minCount 2 ;
        sh:node manch:OrderedClassExpressionShape ;
        sh:path manch:operands
    ] ;
    sh:targetClass manch:And .

manch:OrShape a sh:NodeShape ;
    sh:property [
        sh:message "manch:Or has two or more ordered manch:operands" ;
        sh:minCount 2 ;
        sh:node manch:OrderedClassExpressionShape ;
        sh:path manch:operands
    ] ;
    sh:targetClass manch:Or .

manch:DataAndShape a sh:NodeShape ;
    sh:property [
        sh:message "manch:DataAnd has two or more ordered manch:operands" ;
        sh:minCount 2 ;
        sh:node manch:OrderedDataRangeShape ;
        sh:path manch:operands
    ] ;
    sh:targetClass manch:DataAnd .

manch:DataOrShape a sh:NodeShape ;
    sh:property [
        sh:message "manch:DataOr has two or more ordered manch:operands" ;
        sh:minCount 2 ;
        sh:node manch:OrderedDataRangeShape ;
        sh:path manch:operands
    ] ;
    sh:targetClass manch:DataOr .

manch:OneOfShape a sh:NodeShape ;
    sh:property [
        sh:message "manch:OneOf has at least one ordered manch:individuals" ;
        sh:minCount 1 ;
        sh:node manch:OrderedNameShape ;
        sh:path manch:individuals
    ] ;
    sh:targetClass manch:OneOf .

manch:DataOneOfShape a sh:NodeShape ;
    sh:property [
        sh:message "manch:DataOneOf has at least one ordered manch:literals" ;
        sh:minCount 1 ;
        sh:node manch:OrderedLiteralShape ;
        sh:path manch:literals
    ] ;
    sh:targetClass manch:DataOneOf .

manch:DatatypeRestrictionShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path manch:datatype
    ], [
        sh:minCount 1 ;
        sh:node manch:OrderedFacetRestrictionShape ;
        sh:path manch:facets
    ] ;
    sh:targetClass manch:DatatypeRestriction .

manch:ShapesGraph a sh:ShapesGraph ;
    rdfs:member manch:ClassExpressionOrNameShape, manch:ClassExpressionShape, manch:ClauseShape, manch:DataNotShape, manch:DataRangeOrNameShape, manch:DataRangeShape, manch:ExactlyShape, manch:FacetRestrictionShape, manch:FrameShape, manch:InverseShape, manch:MaxShape, manch:MinShape, manch:MiscAxiomShape, manch:NotShape, manch:OnlyShape, manch:PrefixDeclarationShape, manch:PropertyExpressionOrNameShape, manch:PropertyExpressionShape, manch:SelfShape, manch:SomeShape, manch:ValueClauseShape, manch:ValueShape, manch:DataSomeShape, manch:DataOnlyShape, manch:DataMinShape, manch:DataMaxShape, manch:DataExactlyShape, manch:OrderedClassExpressionShape, manch:OrderedPropertyExpressionShape, manch:OrderedDataRangeShape, manch:OrderedNameShape, manch:OrderedLiteralShape, manch:OrderedPrefixDeclarationShape, manch:OrderedFrameShape, manch:OrderedClauseShape, manch:OrderedMiscAxiomShape, manch:OrderedAnnotationShape, manch:OrderedFacetRestrictionShape, manch:OrderedFactShape, manch:ClassItemShape, manch:PropertyItemShape, manch:DataRangeItemShape, manch:NameItemShape, manch:ObjectPropertyCharacteristicItemShape, manch:DataPropertyCharacteristicItemShape, manch:ClassListItemShape, manch:PropertyListItemShape, manch:ClassSubClassOfClause, manch:ClassEquivalentToClause, manch:ClassDisjointWithClause, manch:ObjectPropertyDomainClause, manch:ObjectPropertyRangeClause, manch:DataPropertyDomainClause, manch:IndividualTypesClause, manch:ObjectPropertySubPropertyOfClause, manch:ObjectPropertyEquivalentToClause, manch:ObjectPropertyDisjointWithClause, manch:ObjectPropertyInverseOfClause, manch:DataPropertySubPropertyOfClause, manch:DataPropertyEquivalentToClause, manch:DataPropertyDisjointWithClause, manch:DataPropertyRangeClause, manch:DatatypeEquivalentToClause, manch:AnnotationPropertyDomainClause, manch:AnnotationPropertyRangeClause, manch:AnnotationPropertySubPropertyOfClause, manch:IndividualSameAsClause, manch:IndividualDifferentFromClause, manch:ObjectPropertyCharacteristicsClause, manch:DataPropertyCharacteristicsClause, manch:ClassDisjointUnionOfClause, manch:ClassHasKeyClause, manch:ObjectPropertySubPropertyChainClause, manch:IndividualFactsClause, manch:ClassAnnotationsClause, manch:ObjectPropertyAnnotationsClause, manch:DataPropertyAnnotationsClause, manch:AnnotationPropertyAnnotationsClause, manch:IndividualAnnotationsClause, manch:DatatypeAnnotationsClause, manch:MiscEquivalentClassesAxiom, manch:MiscDisjointClassesAxiom, manch:MiscEquivalentPropertiesAxiom, manch:MiscDisjointPropertiesAxiom, manch:MiscSameIndividualAxiom, manch:MiscDifferentIndividualsAxiom, manch:MiscAxiomItemsShape, manch:ClauseItemsShape, manch:ClauseItemShape, manch:FactShape, manch:AnnotationShape, manch:OntologyHeaderShape, manch:OntologyDocumentShape, manch:FrameShapeDetail, manch:AndShape, manch:OrShape, manch:DataAndShape, manch:DataOrShape, manch:OneOfShape, manch:DataOneOfShape, manch:DatatypeRestrictionShape ;
    owl:imports tree:ShapesGraph .
