    sh:order 15 .

stsh:NamingGroup a sh:PropertyGroup ;
    sh:description "What a shape is called and what it says when it fails: sh:name, sh:description, rdfs:label, rdfs:comment, sh:message, sh:severity, sh:deactivated. Directly after Targeting (GitHub issue #92)."@en ;
    sh:name "Naming and messages"@en ;
    sh:order 1.5 .

