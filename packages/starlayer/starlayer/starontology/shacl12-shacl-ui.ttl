stsh:secondary a rdf:Property ;
    rdfs:label "secondary"@en ;
    rdfs:comment "True on a field of a form shape when the predicate is allowed but not commonly expected for that kind of node; a tool may show it in a collapsed section. Absent is treated as false. Generated from stsh:nodePrimary false for the node shape form."@en ;
    rdfs:range xsd:boolean .

