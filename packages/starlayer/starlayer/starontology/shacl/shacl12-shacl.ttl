stsh:PrefixConflictShape sh:sparql _:ed470b5bc93e24ca798ebec7b8d88ab7 .
_:ed470b5bc93e24ca798ebec7b8d88ab7 sh:select "\n\t\t\tPREFIX owl: <http://www.w3.org/2002/07/owl#>\n\t\t\tPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tSELECT DISTINCT $this ?prefix ?first ?second\n\t\t\tWHERE {\n\t\t\t\tFILTER NOT EXISTS { $this sh:deactivated ?deactivated . FILTER (?deactivated = true) }\n\t\t\t\t{\n\t\t\t\t\t$this sh:prefixes/(^owl:versionIRI|owl:imports)* ?one .\n\t\t\t\t\t$this sh:prefixes/(^owl:versionIRI|owl:imports)* ?other .\n\t\t\t\t} UNION {\n\t\t\t\t\tFILTER NOT EXISTS { $this sh:prefixes ?any }\n\t\t\t\t\tVALUES (?oneType ?otherType) { (sh:DataGraph sh:DataGraph) (sh:ShapesGraph sh:ShapesGraph) (sh:RulesGraph sh:RulesGraph) (sh:DataGraph sh:ShapesGraph)\n\t\t\t\t\t\t(sh:DataGraph sh:RulesGraph) (sh:ShapesGraph sh:DataGraph) (sh:ShapesGraph sh:RulesGraph) (sh:RulesGraph sh:DataGraph) (sh:RulesGraph sh:ShapesGraph) }\n\t\t\t\t\t?one rdf:type ?oneType .\n\t\t\t\t\t?other rdf:type ?otherType .\n\t\t\t\t} UNION {\n\t\t\t\t\tFILTER NOT EXISTS { $this sh:prefixes ?any }\n\t\t\t\t\t?one rdf:type owl:Ontology .\n\t\t\t\t\t?other rdf:type owl:Ontology .\n\t\t\t\t}\n\t\t\t\t?one sh:declare/sh:prefix ?prefix .\n\t\t\t\t?other sh:declare/sh:prefix ?prefix .\n\t\t\t\t?one sh:declare ?oneDeclaration . ?oneDeclaration sh:prefix ?prefix ; sh:namespace ?first .\n\t\t\t\t?other sh:declare ?otherDeclaration . ?otherDeclaration sh:prefix ?prefix ; sh:namespace ?second .\n\t\t\t\tFILTER (STR(?first) < STR(?second))\n\t\t\t}\n\t\t" ;
	sh:message "The prefix {?prefix} is declared with two different namespaces ({?first} and {?second}) among the declarations this query reads."@en .
