stsh:OneCustomFunctionCallShape sh:sparql _:c0180dcf40efee9ba50c78baca20cbcc .
_:c0180dcf40efee9ba50c78baca20cbcc sh:select "\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tPREFIX shnex: <http://www.w3.org/ns/shacl-node-expr#>\n\t\t\tSELECT DISTINCT $this ?first ?second\n\t\t\tWHERE {\n\t\t\t\tFILTER isBlank($this)\n\t\t\t\t$this ?first ?firstValue .\n\t\t\t\t$this ?second ?secondValue .\n\t\t\t\tFILTER (STR(?first) < STR(?second))\n\t\t\t\tFILTER NOT EXISTS {\n\t\t\t\t\t$this ?operator ?operand .\n\t\t\t\t\tFILTER (?operator IN (sh:select, sh:sparqlExpr, shnex:arg, shnex:concat, shnex:conformsToShape, shnex:count, shnex:distinct, shnex:exists, shnex:filterShape, shnex:findFirst,\n\t\t\t\t\t\tshnex:flatMap, shnex:if, shnex:instancesOf, shnex:intersection, shnex:limit, shnex:matchAll, shnex:max, shnex:min, shnex:nodesMatching, shnex:offset, shnex:orderBy,\n\t\t\t\t\t\tshnex:pathValues, shnex:remove, shnex:sum, shnex:var) || STRSTARTS(STR(?operator), \"http://www.w3.org/ns/sparql#\"))\n\t\t\t\t}\n\t\t\t\t{ ?first a sh:ListParameterExpressionFunction }\n\t\t\t\tUNION\n\t\t\t\t{ ?firstFunction a sh:NamedParameterExpressionFunction ; sh:parameter ?firstParameter . ?firstParameter sh:keyParameter true ; sh:path ?first }\n\t\t\t\t{ ?second a sh:ListParameterExpressionFunction }\n\t\t\t\tUNION\n\t\t\t\t{ ?secondFunction a sh:NamedParameterExpressionFunction ; sh:parameter ?secondParameter . ?secondParameter sh:keyParameter true ; sh:path ?second }\n\t\t\t}\n\t\t" ;
	sh:message "This node expression has both {?first} and {?second}, which each call a custom function. A call has one function."@en .
stsh:OneCustomFunctionCallShape sh:severity sh:Violation ;
