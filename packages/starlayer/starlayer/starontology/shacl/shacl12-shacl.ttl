stsh:UnknownShaclTermShape sh:targetNode _:a8bf0ff3f30e955f58a6efccc81c534e ;
	sh:severity sh:Warning ;
	rdfs:comment "An IRI in the SHACL namespace that the shipped vocabulary does not define, used as a predicate or as an object (a misspelt sh:minCountt or sh:Shape2). Generated by scripts/build_meta_shapes.py from the vocabulary; IRIs in other namespaces are never reported."@en ;
	rdfs:label "No unknown term in the SHACL namespace"@en ;
	a sh:NodeShape .
shui:IconRole rdfs:comment "ignored by validation; a property role: see shui:propertyRole"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	rdfs:seeAlso shui:propertyRole ;
	sh:description "The role of property shapes whose value nodes are small images displayed next to the label of a resource, often shared across instances of the same class."@en ;
	sh:name "icon role"@en .
shui:DescriptionRole rdfs:comment "ignored by validation; a property role: see shui:propertyRole"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	rdfs:seeAlso shui:propertyRole ;
	sh:description "The role of property shapes whose value nodes are textual descriptions that summarize or introduce a resource."@en ;
	sh:name "description role"@en .
shui:ClassificationRole rdfs:comment "ignored by validation; a property role: see shui:propertyRole"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	rdfs:seeAlso shui:propertyRole ;
	sh:description "The role of property shapes whose value nodes indicate the kind, type or category that a resource belongs to. All the values are shown."@en ;
	sh:name "classification role"@en .
shui:DepictionRole rdfs:comment "ignored by validation; a property role: see shui:propertyRole"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	rdfs:seeAlso shui:propertyRole ;
	sh:description "The role of property shapes whose value nodes are images that depict the individual resource, such as a photo of a person. A renderer shows one depiction."@en ;
	sh:name "depiction role"@en .
shui:LabelRole rdfs:comment "ignored by validation; a property role: see shui:propertyRole"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	rdfs:seeAlso shui:propertyRole ;
	sh:description "The role of property shapes whose value nodes serve as human-readable display labels for a resource. A renderer applies Label Resolution to them and shows one label."@en ;
	sh:name "label role"@en .
shui:ValueTableViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui.widget_selection when it chooses a widget (see docs/guides/05d-shacl-ui.ipynb)"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	sh:description "Displays multiple values for a property as rows of a table, rather than a simple list."@en ;
	sh:name "value table viewer"@en .
shui:DetailsViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui.widget_selection when it chooses a widget (see docs/guides/05d-shacl-ui.ipynb)"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	rdfs:seeAlso shui:DetailsEditor ;
	sh:description "An expandable/collapsible read-only view for a complex value, the viewer counterpart to shui:DetailsEditor."@en ;
	sh:name "details viewer"@en .
shui:BlankNodeViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui.widget_selection when it chooses a widget (see docs/guides/05d-shacl-ui.ipynb)"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	sh:description "Read-only nested display of a blank-node-valued property's own properties."@en ;
	sh:name "blank node viewer"@en .
shui:LabelViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui.widget_selection when it chooses a widget (see docs/guides/05d-shacl-ui.ipynb)"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
	rdfs:seeAlso shui:propertyRole ;
	sh:description "Displays a resource by its resolved human-readable label (e.g. via shui:LabelRole/shui:displayProvider) rather than its raw IRI."@en ;
	sh:name "label viewer"@en .
shui:ImageViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui.widget_selection when it chooses a widget (see docs/guides/05d-shacl-ui.ipynb)"@en ;
	rdfs:isDefinedBy tr:shacl12-ui\/ ;
