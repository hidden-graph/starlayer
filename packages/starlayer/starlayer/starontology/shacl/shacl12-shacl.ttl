stsh:ThisIsAnIRIShape sh:sparql _:f3ee90db9de374cdac00e10b7af2d2b4 .
_:f3ee90db9de374cdac00e10b7af2d2b4 sh:select "\n\t\t\tPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\t\t\tPREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n\t\t\tSELECT DISTINCT $this ?user ?property\n\t\t\tWHERE {\n\t\t\t\t?user ?property $this .\n\t\t\t\tFILTER (?property NOT IN (rdfs:seeAlso, rdfs:isDefinedBy, skos:related, skos:exactMatch))\n\t\t\t}\n\t\t" ;
