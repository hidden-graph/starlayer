_:de0e6e0f6b6068296939d042a23fa4d9 sh:select "\n\t\t\tPREFIX shnex: <http://www.w3.org/ns/shacl-node-expr#>\n\t\t\tPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\t\t\tSELECT $this ?path ?value\n\t\t\tWHERE {\n\t\t\t\tFILTER isBlank($this)\n\t\t\t\tVALUES ?path { shnex:limit shnex:offset }\n\t\t\t\t$this ?path ?value .\n\t\t\t\tFILTER (!(isLiteral(?value) && datatype(?value) = xsd:integer && REGEX(STR(?value), \"^[+-]?[0-9]+$\") && ?value >= 0))\n\t\t\t}\n\t\t" ;
