stsh:ThisIsAnIRIShape sh:sparql _:bfa0ec4b4ccdf89c9fe3307b8dc62a91 .
_:bfa0ec4b4ccdf89c9fe3307b8dc62a91 sh:select "\n\t\t\tPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\t\t\tPREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n\t\t\tPREFIX stsh: <https://github.com/hidden-graph/starlayer/ns/shacl#>\n\t\t\tSELECT DISTINCT $this ?user ?property\n\t\t\tWHERE {\n\t\t\t\t?user ?property $this .\n\t\t\t\tFILTER (?property NOT IN (rdfs:seeAlso, rdfs:isDefinedBy, skos:related, skos:exactMatch))\n\t\t\t\tFILTER (?user != stsh:ThisIsAnIRIShape)\n\t\t\t}\n\t\t" ;
	sh:message "sh:this is an ordinary IRI in SHACL 1.2 (a constant), not the focus node as it was in SHACL Advanced Features; to refer to the focus node write [ shnex:var \"focusNode\" ]."@en .
stsh:ThisIsAnIRIShape sh:severity sh:Warning ;
