stsh:ListFunctionArgumentsShape sh:sparql _:a27e4e4eb061185c1f808f5367368761 .
_:a27e4e4eb061185c1f808f5367368761 sh:select "\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tPREFIX shnex: <http://www.w3.org/ns/shacl-node-expr#>\n\t\t\tSELECT DISTINCT $this ?path\n\t\t\tWHERE {\n\t\t\t\t$this sh:parameter ?p .\n\t\t\t\t?p sh:path ?path .\n\t\t\t\tFILTER STRSTARTS(STR(?path), STR(shnex:arg))\n\t\t\t\t?p ?cardinality ?n .\n\t\t\t\tFILTER (?cardinality IN (sh:minCount, sh:maxCount) && isLiteral(?n) && ?n > 1)\n\t\t\t}\n\t\t" ;
	sh:message "{?path} documents an argument, and an argument is a single node (Node Expressions 3.2.2: an argument that gives more than one node is a failure): its sh:minCount and sh:maxCount cannot be more than 1."@en .
stsh:ListFunctionArgumentsShape sh:sparql _:da00aadb1931bbd80997c5877efbf014 .
_:da00aadb1931bbd80997c5877efbf014 sh:select "\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tPREFIX shnex: <http://www.w3.org/ns/shacl-node-expr#>\n\t\t\tPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\t\t\tSELECT DISTINCT $this ?path\n\t\t\tWHERE {\n\t\t\t\t$this sh:parameter ?p .\n\t\t\t\t?p sh:path ?path .\n\t\t\t\tFILTER (STRSTARTS(STR(?path), STR(shnex:arg)) && REGEX(STR(?path), \"arg[1-9][0-9]*$\"))\n\t\t\t\tBIND (xsd:integer(SUBSTR(STR(?path), STRLEN(STR(shnex:arg)) + 1)) AS ?n)\n\t\t\t\tFILTER NOT EXISTS { $this sh:parameter ?q . ?q sh:path ?before . FILTER (STR(?before) = CONCAT(STR(shnex:arg), STR(?n - 1))) }\n\t\t\t}\n\t\t" ;
	sh:message "The function documents {?path} but not the argument before it: documented positions run 0, 1, 2, ... with none skipped."@en .
stsh:ListFunctionArgumentsShape sh:sparql _:eb5439cda21e9899b56bf0de84e15fd1 .
_:eb5439cda21e9899b56bf0de84e15fd1 sh:select "\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tPREFIX shnex: <http://www.w3.org/ns/shacl-node-expr#>\n\t\t\tPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\t\t\tSELECT DISTINCT $this ?index\n\t\t\tWHERE {\n\t\t\t\t$this sh:parameter ?documented .\n\t\t\t\t$this sh:bodyExpression ?body .\n\t\t\t\t?body (!<urn:starlayer:none>)* ?node .\n\t\t\t\t?node shnex:arg ?index .\n\t\t\t\tFILTER (isLiteral(?index) && datatype(?index) = xsd:integer)\n\t\t\t\tFILTER NOT EXISTS { $this sh:parameter ?q . ?q sh:path ?path . FILTER (STR(?path) = CONCAT(STR(shnex:arg), STR(?index))) }\n\t\t\t}\n\t\t" ;
	sh:message "The body reads argument {?index}, which the function does not document (its parameters are shnex:arg0, shnex:arg1, ...)."@en .
stsh:ListFunctionArgumentsShape sh:severity sh:Warning ;
	sh:targetClass sh:ListParameterExpressionFunction ;
	rdfs:label "A list parameter function's documented arguments and the positions its body reads agree"@en ;
	a sh:NodeShape .
