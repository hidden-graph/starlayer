stsh:NodeValidatorQueryPathShape sh:sparql _:fd5ba3f25e948439f0fa874c9a8d00f8 .
_:fd5ba3f25e948439f0fa874c9a8d00f8 sh:select "\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tSELECT DISTINCT $this ?validator\n\t\t\tWHERE {\n\t\t\t\t$this sh:nodeValidator ?validator .\n\t\t\t\t?validator ?query ?text .\n\t\t\t\tFILTER (?query IN (sh:select, sh:ask) && REGEX(STR(?text), \"[$?]PATH([^A-Za-z0-9_]|$)\"))\n\t\t\t}\n\t\t" ;
	sh:message "{?validator} is a validator for node shapes, which have no path, but its query uses $PATH. Hold it through sh:propertyValidator (or sh:validator), or take $PATH out of the query."@en .
stsh:NodeValidatorQueryPathShape sh:targetSubjectsOf sh:nodeValidator ;
	rdfs:label "A node validator does not use $PATH"@en ;
	a sh:NodeShape .
stsh:NodeShapeQueryPathShape sh:sparql _:d1ffc38e431f2ef2c61c65565054c1ae .
_:d1ffc38e431f2ef2c61c65565054c1ae sh:select "\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tSELECT DISTINCT $this ?constraint\n\t\t\tWHERE {\n\t\t\t\t$this sh:sparql ?constraint .\n\t\t\t\tFILTER NOT EXISTS { $this sh:path ?path }\n\t\t\t\tFILTER NOT EXISTS { $this a sh:PropertyShape }\n\t\t\t\t?constraint ?query ?text .\n\t\t\t\tFILTER (?query IN (sh:select, sh:ask, sh:construct) && REGEX(STR(?text), \"[$?]PATH([^A-Za-z0-9_]|$)\"))\n\t\t\t}\n\t\t" ;
	sh:message "{?constraint} is held by a node shape, which has no path, but its query uses $PATH. Hold it by a property shape, or take $PATH out of the query."@en .
stsh:NodeShapeQueryPathShape sh:targetSubjectsOf sh:sparql ;
	rdfs:label "A SPARQL constraint of a node shape does not use $PATH"@en ;
	a sh:NodeShape .
stsh:ComponentParameterValuesShape sh:sparql _:f81cc306684fcaf01849af5e896058a1 .
_:f81cc306684fcaf01849af5e896058a1 sh:select "\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tSELECT DISTINCT $this ?shape ?path\n\t\t\tWHERE {\n\t\t\t\t$this sh:parameter ?param . ?param sh:path ?path .\n\t\t\t\t?shape ?path ?v1 , ?v2 . FILTER (?v1 != ?v2)\n\t\t\t\tFILTER EXISTS { $this sh:parameter ?r1 , ?r2 . FILTER (?r1 != ?r2) }\n\t\t\t\tFILTER NOT EXISTS {\n\t\t\t\t\t$this sh:parameter ?r . ?r sh:path ?rp . FILTER NOT EXISTS { ?r sh:optional true }\n\t\t\t\t\tFILTER NOT EXISTS { ?shape ?rp ?any }\n\t\t\t\t}\n\t\t\t}\n\t\t" ;
	sh:message "{?shape} has more than one value for {?path}, but this component has more than one parameter and takes one value of each (the shape is ill-formed)."@en .
stsh:ComponentParameterValuesShape sh:targetClass sh:ConstraintComponent ;
	rdfs:label "A component with several parameters takes one value of each"@en ;
	a sh:NodeShape .
stsh:KeyParametersDisjointShape sh:sparql _:f89beda6d16ba7cc63f81cf7c35a4a2c .
_:f89beda6d16ba7cc63f81cf7c35a4a2c sh:select "\n\t\t\tPREFIX sh: <http://www.w3.org/ns/shacl#>\n\t\t\tPREFIX shnex: <http://www.w3.org/ns/shacl-node-expr#>\n\t\t\tSELECT DISTINCT $this ?path\n\t\t\tWHERE {\n\t\t\t\t$this sh:parameter ?p .\n\t\t\t\t?p sh:keyParameter true ; sh:path ?path .\n\t\t\t\tFILTER (\n\t\t\t\t\t?path IN (shnex:pathValues, shnex:filterShape, shnex:var, shnex:if, shnex:exists, shnex:distinct, shnex:remove, shnex:intersection, shnex:concat, shnex:orderBy, shnex:limit, shnex:offset, shnex:flatMap, shnex:findFirst, shnex:matchAll, shnex:count, shnex:min, shnex:max, shnex:sum, shnex:instancesOf, shnex:nodesMatching, shnex:conformsToShape, shnex:arg)\n\t\t\t\t\t|| STRSTARTS(STR(?path), \"http://www.w3.org/ns/sparql#\")\n\t\t\t\t\t|| EXISTS { ?other a sh:NamedParameterExpressionFunction ; sh:parameter ?q . ?q sh:keyParameter true ; sh:path ?path . FILTER (?other != $this) }\n\t\t\t\t)\n\t\t\t}\n\t\t" ;
	sh:message "The key parameter {?path} is also a key parameter of another function, a built-in function, or in the sparql: namespace: the key parameters of all node expression functions are disjoint."@en .
stsh:KeyParametersDisjointShape sh:targetClass sh:NamedParameterExpressionFunction ;
	rdfs:label "The key parameters of all node expression functions are disjoint"@en ;
