@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .

spexpr:AdditiveExpression rdfs:subClassOf spexpr:ArithmeticExpression .

spexpr:PathAlternative rdfs:comment "path1|path2 (alternative) - spexpr:args the alternatives, ordered." ;
    rdfs:subClassOf spexpr:Path .

spexpr:ArithmeticExpression rdfs:comment "Modelling helper (the grammar has AdditiveExpression and MultiplicativeExpression only): the superclass of the two chains, which share one shape. +/-/*// chains - spexpr:expr the first operand, spexpr:op the operators and spexpr:other the further operands, both ordered." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:ABS rdfs:subClassOf spexpr:OneArgExpression .

spexpr:BNODE rdfs:subClassOf spexpr:OptionalOneArgExpression .

spexpr:BOUND rdfs:subClassOf spexpr:OneArgExpression .

spexpr:CEIL rdfs:subClassOf spexpr:OneArgExpression .

spexpr:COALESCE rdfs:subClassOf spexpr:VariadicArgExpression .

spexpr:CONCAT rdfs:subClassOf spexpr:VariadicArgExpression .

spexpr:CONTAINS rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:DATATYPE rdfs:subClassOf spexpr:OneArgExpression .

spexpr:DAY rdfs:subClassOf spexpr:OneArgExpression .

spexpr:ENCODE_FOR_URI rdfs:subClassOf spexpr:OneArgExpression .

spexpr:FLOOR rdfs:subClassOf spexpr:OneArgExpression .

spexpr:HOURS rdfs:subClassOf spexpr:OneArgExpression .

spexpr:IF rdfs:subClassOf spexpr:ThreeArgExpression .

spexpr:IRI rdfs:subClassOf spexpr:OneArgExpression .

spexpr:LANG rdfs:subClassOf spexpr:OneArgExpression .

spexpr:LANGMATCHES rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:LCASE rdfs:subClassOf spexpr:OneArgExpression .

spexpr:MD5 rdfs:subClassOf spexpr:OneArgExpression .

spexpr:MINUTES rdfs:subClassOf spexpr:OneArgExpression .

spexpr:MONTH rdfs:subClassOf spexpr:OneArgExpression .

spexpr:NOW rdfs:subClassOf spexpr:ZeroArgExpression .

spexpr:RAND rdfs:subClassOf spexpr:ZeroArgExpression .

spexpr:REGEX rdfs:subClassOf spexpr:RegexExpression .

spexpr:REPLACE rdfs:subClassOf spexpr:ReplaceExpression .

spexpr:ROUND rdfs:subClassOf spexpr:OneArgExpression .

spexpr:SECONDS rdfs:subClassOf spexpr:OneArgExpression .

spexpr:SHA1 rdfs:subClassOf spexpr:OneArgExpression .

spexpr:SHA256 rdfs:subClassOf spexpr:OneArgExpression .

spexpr:SHA384 rdfs:subClassOf spexpr:OneArgExpression .

spexpr:SHA512 rdfs:subClassOf spexpr:OneArgExpression .

spexpr:STR rdfs:subClassOf spexpr:OneArgExpression .

spexpr:STRAFTER rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:STRBEFORE rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:STRDT rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:STRENDS rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:STRLANG rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:STRLEN rdfs:subClassOf spexpr:OneArgExpression .

spexpr:STRSTARTS rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:STRUUID rdfs:subClassOf spexpr:ZeroArgExpression .

spexpr:SUBSTR rdfs:subClassOf spexpr:SubstrExpression .

spexpr:TIMEZONE rdfs:subClassOf spexpr:OneArgExpression .

spexpr:TZ rdfs:subClassOf spexpr:OneArgExpression .

spexpr:UCASE rdfs:subClassOf spexpr:OneArgExpression .

spexpr:URI rdfs:subClassOf spexpr:OneArgExpression .

spexpr:UUID rdfs:subClassOf spexpr:ZeroArgExpression .

spexpr:YEAR rdfs:subClassOf spexpr:OneArgExpression .

spexpr:isBLANK rdfs:subClassOf spexpr:OneArgExpression .

spexpr:isIRI rdfs:subClassOf spexpr:OneArgExpression .

spexpr:isLITERAL rdfs:subClassOf spexpr:OneArgExpression .

spexpr:isNUMERIC rdfs:subClassOf spexpr:OneArgExpression .

spexpr:isURI rdfs:subClassOf spexpr:OneArgExpression .

spexpr:sameTerm rdfs:subClassOf spexpr:TwoArgExpression .

spexpr:ConditionalAndExpression rdfs:subClassOf spexpr:ConditionalExpression .

spexpr:ConditionalExpression rdfs:comment "Modelling helper (the grammar has ConditionalOrExpression and ConditionalAndExpression only): the superclass of the two chains, which share one shape. &&/|| chains - spexpr:expr the first operand plus the further operands in spexpr:other, ordered." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:ConditionalOrExpression rdfs:subClassOf spexpr:ConditionalExpression .

spexpr:Expression rdfs:comment "A SPARQL expression-tree node (grammar: Expression): a FILTER/BIND/ORDER BY/HAVING expression, a built-in call, an aggregate, a function call or an operator chain. Superclass of every expression class." ;
    rdfs:label "Expression" .

spexpr:FunctionCall rdfs:comment "A call of a function that is not a built-in, by IRI: f(args) or f(DISTINCT args) (grammar: FunctionCall, ArgList). spexpr:iri the function, spexpr:args the arguments in order, spexpr:distinct true when DISTINCT was written." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:PathInverse rdfs:comment "^path (inverse; grammar: PathEltOrInverse) - spexpr:arg the wrapped path/IRI." ;
    rdfs:subClassOf spexpr:Path .

spexpr:PathElt rdfs:comment "path* / path+ / path? (grammar: PathElt with a PathMod; a path element without a modifier has no node) - spexpr:path the repeated path/IRI, spexpr:mod the bare \"*\"/\"+\"/\"?\" modifier string. The modifier is a plain literal, not spexpr:PlainString-tagged, which is what makes the PathEltShape sh:in (\"*\" \"+\" \"?\") check match (sh:in compares terms exactly, so a datatype would break it)." ;
    rdfs:subClassOf spexpr:Path .

spexpr:MultiplicativeExpression rdfs:subClassOf spexpr:ArithmeticExpression .

spexpr:PathNegatedPropertySet rdfs:comment "!path / !(path1|path2) (negated property set; always stored with its members, even for one) - spexpr:args the members, ordered." ;
    rdfs:subClassOf spexpr:Path .

spexpr:OneArgExpression rdfs:comment "Exactly one required argument (spexpr:arg)." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:OptionalOneArgExpression rdfs:comment "Zero or one argument (spexpr:arg) - BNODE()/BNODE(?x) only." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:Path rdfs:comment "A SPARQL property path (grammar: Path); the superclass of the five path classes PathSequence, PathAlternative, PathInverse, PathElt and PathNegatedPropertySet. A plain IRI is a path without a node." .

spexpr:PlainString a rdfs:Datatype ;
    rdfs:comment "A plain, untagged bare string value (not a real RDF term) that needs a reserved datatype to survive RDF round-trip without colliding with an ordinary xsd:string-typed value - e.g. an operator symbol, a prefix label, a bare SPARQL grammar keyword. The shared, technology-neutral home for this concept (reused directly by spexpr:/sqe:, see vocab.py's PY_STR_DATATYPE) - renamed and moved here from PyStr 2026-10-15." .

spexpr:RegexExpression rdfs:comment "REGEX(text, pattern[, flags]) - unique key names." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:RelationalExpression rdfs:comment "=, !=, <, >, <=, >=, IN, NOT IN - spexpr:expr, spexpr:op and, for a comparison, spexpr:other (always one operand); IN / NOT IN have no spexpr:other but spexpr:args, the value list in order (none for an empty list)." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:ReplaceExpression rdfs:comment "REPLACE(arg, pattern, replacement[, flags]) - unique key names." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:PathSequence rdfs:comment "path1/path2 (sequence) - spexpr:args the sequenced paths/IRIs, ordered." ;
    rdfs:subClassOf spexpr:Path .

spexpr:SubstrExpression rdfs:comment "SUBSTR(arg, start[, length]) - unique key names." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:ThreeArgExpression rdfs:comment "Exactly three required arguments (spexpr:arg1/arg2/arg3) - IF() only." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:TwoArgExpression rdfs:comment "Exactly two required arguments (spexpr:arg1/arg2)." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:UnaryExpression rdfs:comment "Superclass of the three prefix operators UnaryNot (!), UnaryMinus (-) and UnaryPlus (+); exactly one required operand (spexpr:expr)." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:UnaryMinus rdfs:subClassOf spexpr:UnaryExpression .

spexpr:UnaryNot rdfs:subClassOf spexpr:UnaryExpression .

spexpr:UnaryPlus rdfs:subClassOf spexpr:UnaryExpression .

spexpr:VariadicArgExpression rdfs:comment "spexpr:args holds the arguments, ordered - CONCAT/COALESCE only." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:ZeroArgExpression rdfs:comment "No arguments (NOW/UUID/STRUUID/RAND)." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:isTRIPLE rdfs:subClassOf spexpr:OneArgExpression .

spexpr:SUBJECT rdfs:subClassOf spexpr:OneArgExpression .

spexpr:PREDICATE rdfs:subClassOf spexpr:OneArgExpression .

spexpr:OBJECT rdfs:subClassOf spexpr:OneArgExpression .

spexpr:LANGDIR rdfs:subClassOf spexpr:OneArgExpression .

spexpr:hasLANG rdfs:subClassOf spexpr:OneArgExpression .

spexpr:hasLANGDIR rdfs:subClassOf spexpr:OneArgExpression .

spexpr:STRLANGDIR rdfs:subClassOf spexpr:StrLangDirExpression .

spexpr:StrLangDirExpression rdfs:comment "STRLANGDIR(lex, lang, direction) - three required arguments under their own key names." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:Aggregate rdfs:comment "An aggregate call (grammar: Aggregate) in a projection, HAVING or ORDER BY expression; the class is the keyword as typed: COUNT, SUM, MIN, MAX, AVG, SAMPLE, GROUP_CONCAT. spexpr:expr the aggregated expression (or the marker * for COUNT(*)), spexpr:distinct true when DISTINCT was written, spexpr:separator the GROUP_CONCAT separator." ;
    rdfs:subClassOf spexpr:Expression .

spexpr:COUNT rdfs:subClassOf spexpr:Aggregate .

spexpr:SUM rdfs:subClassOf spexpr:Aggregate .

spexpr:MIN rdfs:subClassOf spexpr:Aggregate .

spexpr:MAX rdfs:subClassOf spexpr:Aggregate .

spexpr:AVG rdfs:subClassOf spexpr:Aggregate .

spexpr:SAMPLE rdfs:subClassOf spexpr:Aggregate .

spexpr:GROUP_CONCAT rdfs:subClassOf spexpr:Aggregate .

spexpr:Variable a rdfs:Datatype ;
    rdfs:comment "Modelling helper: a SPARQL variable is not an RDF term, so it is stored as a literal whose lexical form is the name (without ? or $) and whose datatype is spexpr:Variable. The same encoding is used in patterns, expressions and projections." .
