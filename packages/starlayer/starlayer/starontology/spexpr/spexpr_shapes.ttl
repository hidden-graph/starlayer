@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix tree: <https://github.com/hidden-graph/starlayer/ns/tree#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

spexpr:PathAlternativeShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:message "spexpr:PathAlternative holds its members in spexpr:args, in order (tree:ord), at least one" ;
        sh:minCount 1 ;
        sh:node spexpr:OrderedPathShape ;
        sh:path spexpr:args
    ] ;
    sh:targetClass spexpr:PathAlternative .


spexpr:ExpressionShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:message "expected a legal expression value (a term/Variable, or a recognized expression builtin)" ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] [
        sh:nodeKind sh:Literal
    ] spexpr:VariableShape [
        sh:class spexpr:Expression ;
        sh:nodeKind sh:BlankNode
    ] ) .

spexpr:PathInverseShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:PathInverse must have exactly one spexpr:arg, a path or IRI" ;
        sh:minCount 1 ;
        sh:node spexpr:PathOrIriShape ;
        sh:path spexpr:arg
    ] ;
    sh:targetClass spexpr:PathInverse .

spexpr:PathEltShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:PathElt must have exactly one spexpr:path, a path or IRI" ;
        sh:minCount 1 ;
        sh:node spexpr:PathOrIriShape ;
        sh:path spexpr:path
    ], [
        sh:in ( "*" "+" "?" ) ;
        sh:maxCount 1 ;
        sh:message "spexpr:PathElt must have exactly one spexpr:mod, a bare asterisk/plus/question-mark modifier string" ;
        sh:minCount 1 ;
        sh:path spexpr:mod
    ] ;
    sh:targetClass spexpr:PathElt .

spexpr:PathNegatedPropertySetShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:message "spexpr:PathNegatedPropertySet holds its members in spexpr:args, in order (tree:ord); none for the empty set !()" ;
        sh:node spexpr:OrderedPathShape ;
        sh:path spexpr:args
    ] ;
    sh:targetClass spexpr:PathNegatedPropertySet .



spexpr:PathOrIriShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] spexpr:PathShape ) .

spexpr:PathShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:class spexpr:Path ;
    sh:message "expected a recognized property-path operator (see spexpr:Path)" .

spexpr:PathSequenceShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:message "spexpr:PathSequence holds its members in spexpr:args, in order (tree:ord), at least one" ;
        sh:minCount 1 ;
        sh:node spexpr:OrderedPathShape ;
        sh:path spexpr:args
    ] ;
    sh:targetClass spexpr:PathSequence .

# ---- The ordered children (tree:ord) of an expression: a blank node member carries its own ordinal, a term or a variable is the
# tree:value of a tree:Item (starontology/tree/tree_shapes.ttl). A named node or a literal directly under the property is not accepted.

spexpr:OrderedExpressionShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:or ( [
        sh:node spexpr:ExpressionShape, tree:OrdShape ;
        sh:nodeKind sh:BlankNode
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:node spexpr:ExpressionShape ;
            sh:path tree:value
        ]
    ] ) .

spexpr:OrderedOperatorShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:node tree:ItemShape ;
    sh:property [
        sh:datatype spexpr:PlainString ;
        sh:in ( "+"^^spexpr:PlainString "-"^^spexpr:PlainString "*"^^spexpr:PlainString "/"^^spexpr:PlainString ) ;
        sh:message "an operator is one of + - * /, spexpr:PlainString-tagged" ;
        sh:path tree:value
    ] .

spexpr:OrderedPathShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:or ( [
        sh:class spexpr:Path ;
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:nodeKind sh:IRI ;
            sh:path tree:value
        ]
    ] ) .

spexpr:ShapesGraph a sh:ShapesGraph .

spexpr:VariableShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:datatype spexpr:Variable ;
    sh:nodeKind sh:Literal .

spexpr:_ArithmeticExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:message "expected at least one spexpr:other, the operands after the first, in order (tree:ord)" ;
        sh:minCount 1 ;
        sh:node spexpr:OrderedExpressionShape ;
        sh:path spexpr:other
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:expr" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ], [
        sh:message "expected at least one spexpr:op, the operators in order (tree:ord), spexpr:PlainString-tagged" ;
        sh:minCount 1 ;
        sh:node spexpr:OrderedOperatorShape ;
        sh:path spexpr:op
    ] .

spexpr:_ConditionalExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:expr" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ], [
        sh:message "spexpr:other is optional (absent means a single-condition expression); its operands are in order (tree:ord)" ;
        sh:node spexpr:OrderedExpressionShape ;
        sh:path spexpr:other
    ] .

spexpr:_FunctionCallExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:FunctionCall must have exactly one spexpr:iri, an IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path spexpr:iri
    ], [
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:maxCount 1 ;
        sh:message "spexpr:distinct of a function call is true when DISTINCT was written, and absent otherwise" ;
        sh:path spexpr:distinct
    ], [
        sh:message "spexpr:args of a function call holds the call arguments in order (tree:ord); none for a call with none" ;
        sh:node spexpr:OrderedExpressionShape ;
        sh:path spexpr:args
    ] .

spexpr:_OneArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg
    ] .

spexpr:_OptionalOneArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:arg is optional (absent means BNODE()'s no-argument form) but at most one" ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg
    ] .

spexpr:_RegexExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:flags is optional but at most one" ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:flags
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:pattern" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:pattern
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:text" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:text
    ] .

spexpr:_RelationalExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:expr" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ], [
        sh:datatype spexpr:PlainString ;
        sh:in ( "="^^spexpr:PlainString "!="^^spexpr:PlainString "<"^^spexpr:PlainString ">"^^spexpr:PlainString "<="^^spexpr:PlainString ">="^^spexpr:PlainString "IN"^^spexpr:PlainString "NOT IN"^^spexpr:PlainString ) ;
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:op, a spexpr:PlainString-tagged operator symbol" ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:path spexpr:op
    ] ;
    sh:message "spexpr:other is always one expression (a comparison has it and no spexpr:args); IN / NOT IN have the value list in spexpr:args, in order (tree:ord), and no spexpr:other" ;
    sh:or ( [
        sh:property [
            sh:in ( "IN"^^spexpr:PlainString "NOT IN"^^spexpr:PlainString ) ;
            sh:path spexpr:op
        ], [
            sh:maxCount 0 ;
            sh:path spexpr:other
        ], [
            sh:node spexpr:OrderedExpressionShape ;
            sh:path spexpr:args
        ]
    ] [
        sh:property [
            sh:in ( "="^^spexpr:PlainString "!="^^spexpr:PlainString "<"^^spexpr:PlainString ">"^^spexpr:PlainString "<="^^spexpr:PlainString ">="^^spexpr:PlainString ) ;
            sh:path spexpr:op
        ], [
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node spexpr:ExpressionShape ;
            sh:path spexpr:other
        ], [
            sh:maxCount 0 ;
            sh:path spexpr:args
        ]
    ] ) .

spexpr:_ReplaceExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:replacement" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:replacement
    ], [
        sh:maxCount 1 ;
        sh:message "spexpr:flags is optional but at most one" ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:flags
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:pattern" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:pattern
    ] .

spexpr:_SubstrExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:length is optional but at most one" ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:length
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:start" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:start
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg
    ] .

spexpr:_ThreeArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg3" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg3
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg1" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg1
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg2" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg2
    ] .

spexpr:_TwoArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg2" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg2
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg1" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg1
    ] .

spexpr:_UnaryExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:expr" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ] .

spexpr:_VariadicArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:message "spexpr:args holds the arguments in order (tree:ord); none for CONCAT() or COALESCE()" ;
        sh:node spexpr:OrderedExpressionShape ;
        sh:path spexpr:args
    ] .

spexpr:_ZeroArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph .

spexpr:_StrLangDirExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:lex" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:lex
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:lang" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:lang
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:direction" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:direction
    ] .

spexpr:AggregateBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "an aggregate must have exactly one spexpr:expr, the aggregated expression (or the marker *)" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ], [
        sh:datatype xsd:boolean ;
        sh:in ( true ) ;
        sh:maxCount 1 ;
        sh:message "spexpr:distinct of an aggregate is true when DISTINCT was written, and absent otherwise" ;
        sh:path spexpr:distinct
    ], [
        sh:maxCount 1 ;
        sh:message "spexpr:separator must be a single literal" ;
        sh:nodeKind sh:Literal ;
        sh:path spexpr:separator
    ] ;
    sh:targetClass spexpr:AVG, spexpr:COUNT, spexpr:GROUP_CONCAT,
        spexpr:MAX, spexpr:MIN, spexpr:SAMPLE, spexpr:SUM .
