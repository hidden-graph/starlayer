@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

spexpr:AlternativePathShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:AlternativePath must have exactly one spexpr:args, a well-formed rdf:List of path/IRI values" ;
        sh:minCount 1 ;
        sh:node spexpr:PathArgsListShape ;
        sh:path spexpr:args
    ] ;
    sh:targetClass spexpr:AlternativePath .

spexpr:DistinctMarkerShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:or ( [
        sh:datatype spexpr:PlainString ;
        sh:nodeKind sh:Literal
    ] [
        sh:hasValue ()
    ] ) .

spexpr:ExpressionListShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of expression values" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest+ ?tail .
                    FILTER ( ?tail != rdf:nil )
                    FILTER NOT EXISTS { ?tail rdf:first ?tailHead }
                }
            }
        """
    ] .

spexpr:ExpressionShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:message "expected a legal expression value (a term/Variable, or a recognized expression builtin)" ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] [
        sh:nodeKind sh:Literal
    ] spexpr:VariableShape [
        sh:class spexpr:Expression ;
        sh:nodeKind sh:BlankNode
    ] ) .

spexpr:InvPathShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:InvPath must have exactly one spexpr:arg, a path or IRI" ;
        sh:minCount 1 ;
        sh:node spexpr:PathOrIriShape ;
        sh:path spexpr:arg
    ] ;
    sh:targetClass spexpr:InvPath .

spexpr:MulPathShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:MulPath must have exactly one spexpr:path, a path or IRI" ;
        sh:minCount 1 ;
        sh:node spexpr:PathOrIriShape ;
        sh:path spexpr:path
    ], [
        sh:in ( "*" "+" "?" ) ;
        sh:maxCount 1 ;
        sh:message "spexpr:MulPath must have exactly one spexpr:mod, a bare asterisk/plus/question-mark modifier string" ;
        sh:minCount 1 ;
        sh:path spexpr:mod
    ] ;
    sh:targetClass spexpr:MulPath .

spexpr:NegatedPathShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:NegatedPath must have exactly one spexpr:args, a well-formed rdf:List of path/IRI values" ;
        sh:minCount 1 ;
        sh:node spexpr:PathArgsListShape ;
        sh:path spexpr:args
    ] ;
    sh:targetClass spexpr:NegatedPath .

spexpr:OperatorStringListShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of spexpr:PlainString-tagged operator strings, each one of the real Arithmetic operators (+/-/*//), shared by AdditiveExpression and MultiplicativeExpression alike" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( !isLiteral(?item) || datatype(?item) != spexpr:PlainString ||
                              ( str(?item) != "+" && str(?item) != "-" && str(?item) != "*" && str(?item) != "/" ) )
                }
            }
        """
    ] .

spexpr:PathArgsListShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of path/IRI values" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest+ ?tail .
                    FILTER ( ?tail != rdf:nil )
                    FILTER NOT EXISTS { ?tail rdf:first ?tailHead }
                }
            }
        """
    ] .

spexpr:PathOrIriShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] spexpr:PathShape ) .

spexpr:PathShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:class spexpr:Path ;
    sh:message "expected a recognized property-path operator (see spexpr:Path)" .

spexpr:SequencePathShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:SequencePath must have exactly one spexpr:args, a well-formed rdf:List of path/IRI values" ;
        sh:minCount 1 ;
        sh:node spexpr:PathArgsListShape ;
        sh:path spexpr:args
    ] ;
    sh:targetClass spexpr:SequencePath .

spexpr:ShapesGraph a sh:ShapesGraph .

spexpr:VariableShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:datatype spexpr:Variable ;
    sh:nodeKind sh:Literal .

spexpr:_ArithmeticExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:other, a well-formed rdf:List of expressions" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionListShape ;
        sh:path spexpr:other
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:expr" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:op, a well-formed rdf:List of spexpr:PlainString-tagged operator strings" ;
        sh:minCount 1 ;
        sh:node spexpr:OperatorStringListShape ;
        sh:path spexpr:op
    ] .

spexpr:_ConditionalExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:expr" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ], [
        sh:maxCount 1 ;
        sh:message "spexpr:other is optional (absent means a single-condition expression) but a well-formed rdf:List of expressions when present" ;
        sh:node spexpr:ExpressionListShape ;
        sh:path spexpr:other
    ] .

spexpr:_ExistsExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:graph" ;
        sh:minCount 1 ;
        sh:path spexpr:graph
    ] .

spexpr:_FunctionExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:Function must have exactly one spexpr:iri, an IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path spexpr:iri
    ], [
        sh:maxCount 1 ;
        sh:message "spexpr:Function's spexpr:distinct must have exactly one value (a spexpr:PlainString-tagged DISTINCT keyword, or rdf:nil when absent) - confirmed always present, empirically, same as the aggregate bodies' own spexpr:distinct above" ;
        sh:minCount 1 ;
        sh:node spexpr:DistinctMarkerShape ;
        sh:path spexpr:distinct
    ], [
        sh:maxCount 1 ;
        sh:message "spexpr:Function must have exactly one spexpr:expr, a well-formed rdf:List of call arguments" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionListShape ;
        sh:path spexpr:expr
    ] .

spexpr:_OneArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg
    ] .

spexpr:_OptionalOneArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:arg is optional (absent means BNODE()'s no-argument form) but at most one" ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg
    ] .

spexpr:_RegexExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:flags is optional but at most one" ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:flags
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:pattern" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:pattern
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:text" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:text
    ] .

spexpr:_RelationalExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:other, an expression or (for IN/NOT IN) a well-formed rdf:List of expressions" ;
        sh:minCount 1 ;
        sh:node [
            sh:or ( spexpr:ExpressionShape spexpr:ExpressionListShape )
        ] ;
        sh:path spexpr:other
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:expr" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ], [
        sh:datatype spexpr:PlainString ;
        sh:in ( "="^^spexpr:PlainString "!="^^spexpr:PlainString "<"^^spexpr:PlainString ">"^^spexpr:PlainString "<="^^spexpr:PlainString ">="^^spexpr:PlainString "IN"^^spexpr:PlainString "NOT IN"^^spexpr:PlainString ) ;
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:op, a spexpr:PlainString-tagged operator symbol" ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:path spexpr:op
    ] .

spexpr:_ReplaceExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:replacement" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:replacement
    ], [
        sh:maxCount 1 ;
        sh:message "spexpr:flags is optional but at most one" ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:flags
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:pattern" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:pattern
    ] .

spexpr:_SubstrExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "spexpr:length is optional but at most one" ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:length
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:start" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:start
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg
    ] .

spexpr:_ThreeArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg3" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg3
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg1" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg1
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg2" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg2
    ] .

spexpr:_TwoArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg2" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg2
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg1" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:arg1
    ] .

spexpr:_UnaryExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:expr" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:expr
    ] .

spexpr:_VariadicArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:arg, a well-formed rdf:List of expression values" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionListShape ;
        sh:path spexpr:arg
    ] .

spexpr:_ZeroArgExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph .

spexpr:_StrLangDirExprBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:lex" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:lex
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:lang" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:lang
    ], [
        sh:maxCount 1 ;
        sh:message "expected exactly one spexpr:direction" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:direction
    ] .

spexpr:AggregateBodyShape a sh:NodeShape ;
    rdfs:isDefinedBy spexpr:ShapesGraph ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "an aggregate must have exactly one spexpr:vars, the aggregated expression (or the marker *)" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path spexpr:vars
    ], [
        sh:maxCount 1 ;
        sh:message "spexpr:distinct must be empty (rdf:nil) or the string DISTINCT" ;
        sh:in ( rdf:nil "DISTINCT"^^spexpr:PlainString ) ;
        sh:path spexpr:distinct
    ], [
        sh:maxCount 1 ;
        sh:message "spexpr:separator must be a single literal" ;
        sh:nodeKind sh:Literal ;
        sh:path spexpr:separator
    ] ;
    sh:targetClass spexpr:Aggregate_Avg, spexpr:Aggregate_Count, spexpr:Aggregate_GroupConcat,
        spexpr:Aggregate_Max, spexpr:Aggregate_Min, spexpr:Aggregate_Sample, spexpr:Aggregate_Sum .
