# The generic SHACL UI scoring catalog (registry entry shacl_ui_baseline): which widget suits a property that names none.
# It knows nothing about any application or about SHACL itself, and nothing uses it unless it is passed as
# scoring_graph= to starlayer.shacl.ui_widget_selection.select_widgets (or StarShaclSchema(scoring_graph=...)).
#
# Three tiers, by score:
#   1  a default that matches everything     TextFieldEditor, LiteralViewer
#   2  defaults by datatype                  number, boolean, date, dateTime, language-tagged string
#   3  defaults by a constraint that lists   sh:in, sh:class, sh:nodeKind sh:IRI
#      the answers
# A constraint is a stronger signal than a datatype (an xsd:string with sh:in is an enumeration), so tier 3 beats 2. A
# layer on top (an editor for SHACL, an application, a user) adds scores that beat these (the Working Group's own
# files use 40 for a preference).
#
# ONE catalog serves both roles: select_widgets(role="editor") considers only editors and role="viewer" only viewers,
# because a widget's role comes from its class. A widget a shape names itself with shui:editor / shui:viewer wins.
#
# Every condition is written on its own score (shui:shapesGraphShape on the shui:WidgetScore), as in the Working Group's
# widget files, so it applies to that score only. There are NO per-widget shui:WidgetAcceptMatcher entries: a matcher
# is shared by every layer, so a layer on top could not add back a widget a lower layer had excluded. A score without
# a condition applies to everything.
#
# Contributed in GitHub issue #10 (from the graph workbench) and restructured into tiers on 2026-10-21. The draft
# publishes its built-in scores only as prose (SHACL UI section 9), so these scores are ours, not the Working Group's.
#
# baseURI: https://github.com/hidden-graph/starlayer/ns/ui-baseline#

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uib: <https://github.com/hidden-graph/starlayer/ns/ui-baseline#> .

# ---- tier 1 (score 1): matches everything - no condition
uib:textFieldEditorScore1 a shui:WidgetScore ; shui:widget shui:TextFieldEditor ; shui:score 1 .
uib:literalViewerScore1   a shui:WidgetScore ; shui:widget shui:LiteralViewer   ; shui:score 1 .

# ---- tier 2 (score 2): by datatype
uib:numberFieldEditorScore2 a shui:WidgetScore ; shui:widget shui:NumberFieldEditor     ; shui:score 2 ; shui:shapesGraphShape uib:HasNumericDatatype .
uib:booleanEditorScore2     a shui:WidgetScore ; shui:widget shui:BooleanEditor         ; shui:score 2 ; shui:shapesGraphShape uib:HasBooleanDatatype .
uib:datePickerScore2        a shui:WidgetScore ; shui:widget shui:DatePickerEditor      ; shui:score 2 ; shui:shapesGraphShape uib:HasDateDatatype .
uib:dateTimePickerScore2    a shui:WidgetScore ; shui:widget shui:DateTimePickerEditor  ; shui:score 2 ; shui:shapesGraphShape uib:HasDateTimeDatatype .
uib:textFieldWithLangScore2 a shui:WidgetScore ; shui:widget shui:TextFieldWithLangEditor ; shui:score 2 ; shui:shapesGraphShape uib:HasLangStringDatatype .
uib:langStringViewerScore2  a shui:WidgetScore ; shui:widget shui:LangStringViewer      ; shui:score 2 ; shui:shapesGraphShape uib:HasLangStringDatatype .

# ---- tier 3 (score 3): by a constraint that lists the answers
uib:enumSelectEditorScore3      a shui:WidgetScore ; shui:widget shui:EnumSelectEditor      ; shui:score 3 ; shui:shapesGraphShape uib:HasInList .
uib:instancesSelectEditorScore3 a shui:WidgetScore ; shui:widget shui:InstancesSelectEditor ; shui:score 3 ; shui:shapesGraphShape uib:HasClass .
uib:iriEditorScore3             a shui:WidgetScore ; shui:widget shui:IRIEditor             ; shui:score 3 ; shui:shapesGraphShape uib:IsIRIWithoutClass .
uib:labelViewerScore3           a shui:WidgetScore ; shui:widget shui:LabelViewer           ; shui:score 3 ; shui:shapesGraphShape uib:IsResource .

# ---- the conditions: shapes about the property shape being rendered
uib:HasNumericDatatype a sh:NodeShape ;
    sh:property [ sh:path sh:datatype ; sh:minCount 1 ; sh:in ( xsd:integer xsd:decimal xsd:double xsd:float ) ] .
uib:HasBooleanDatatype a sh:NodeShape ;
    sh:property [ sh:path sh:datatype ; sh:hasValue xsd:boolean ] .
uib:HasDateDatatype a sh:NodeShape ;
    sh:property [ sh:path sh:datatype ; sh:hasValue xsd:date ] .
uib:HasDateTimeDatatype a sh:NodeShape ;
    sh:property [ sh:path sh:datatype ; sh:hasValue xsd:dateTime ] .
uib:HasLangStringDatatype a sh:NodeShape ;
    sh:property [ sh:path sh:datatype ; sh:hasValue rdf:langString ] .
uib:HasInList a sh:NodeShape ;
    sh:property [ sh:path sh:in ; sh:minCount 1 ] .
uib:HasClass a sh:NodeShape ;
    sh:property [ sh:path sh:class ; sh:minCount 1 ] .
# an IRI-valued property that names no class: with a class, InstancesSelectEditor is the better fit, and the two would
# otherwise tie at 3 (ties go to the widget IRI, which would pick IRIEditor)
uib:IsIRIWithoutClass a sh:NodeShape ;
    sh:property [ sh:path sh:nodeKind ; sh:hasValue sh:IRI ] ;
    sh:property [ sh:path sh:class ; sh:maxCount 0 ] .
uib:IsResource a sh:NodeShape ;
    sh:or ( uib:HasClass [ sh:property [ sh:path sh:nodeKind ; sh:hasValue sh:IRI ] ] ) .
