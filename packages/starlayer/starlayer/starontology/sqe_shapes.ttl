@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sqe:AlternativesListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List whose members are themselves well-formed pattern lists" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?alt .
                    {
                        FILTER ( ?alt != rdf:nil )
                        FILTER NOT EXISTS { ?alt rdf:first ?altHead }
                    } UNION {
                        ?alt rdf:rest*/rdf:first ?item .
                        FILTER NOT EXISTS {
                            ?item a ?t .
                            FILTER ( ?t IN ( sqe:TriplePattern, sqe:Optional, sqe:Union, sqe:Filter, sqe:Bind, sqe:Minus, sqe:Graph, sqe:Service, sqe:Values, sqe:SubSelect ) )
                        }
                    }
                }
            }
        """
    ] .

sqe:AskQueryShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:AskQuery must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having)/rdf:rest*/rdf:first ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:vars|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|rdf:rest|rdf:first)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/rdf:rest*/rdf:first/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """
    ] ;
    sh:targetClass sqe:AskQuery .

sqe:BindShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Bind must have exactly one sqe:expr, a well-formed expression" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path sqe:expr
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Bind must have exactly one sqe:var, a Variable" ;
        sh:minCount 1 ;
        sh:node spexpr:VariableShape ;
        sh:path sqe:var
    ] ;
    sh:targetClass sqe:Bind .

sqe:ConstructQueryShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:ConstructQuery must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:ConstructQuery must have exactly one sqe:template, an rdf:List of TriplePattern" ;
        sh:minCount 1 ;
        sh:node sqe:TemplateListShape ;
        sh:path sqe:template
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Template variable {?var} is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                $this sqe:template/rdf:rest*/rdf:first ?tpl .
                ?tpl a sqe:TriplePattern ;
                    (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """
    ], [
        a sh:SPARQLConstraint ;
        sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having)/rdf:rest*/rdf:first ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:vars|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|rdf:rest|rdf:first)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/rdf:rest*/rdf:first/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """
    ] ;
    sh:targetClass sqe:ConstructQuery .

sqe:FilterShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Filter must have exactly one sqe:expr, a well-formed expression" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path sqe:expr
    ] ;
    sh:targetClass sqe:Filter .

sqe:ObjectOrVariableShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] [
        sh:nodeKind sh:BlankNode
    ] [
        sh:nodeKind sh:Literal
    ] [
        sh:class sqe:TripleTerm
    ] spexpr:VariableShape ) .

sqe:OptionalShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Optional must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ] ;
    sh:targetClass sqe:Optional .

sqe:PredicateOrVariableOrPathShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] spexpr:VariableShape spexpr:PathShape ) .

sqe:PrefixBindingShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:PrefixBinding must have exactly one sqe:namespace, an IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:namespace
    ], [
        sh:datatype spexpr:PlainString ;
        sh:maxCount 1 ;
        sh:message "sqe:PrefixBinding must have exactly one sqe:prefixLabel, a spexpr:PlainString-tagged string" ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:path sqe:prefixLabel
    ] ;
    sh:targetClass sqe:PrefixBinding .

sqe:SelectQueryShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:SelectQuery may have at most one sqe:projection, a non-empty rdf:List of variables and aliases" ;
        sh:node sqe:ProjectionListShape ;
        sh:path sqe:projection
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:SelectQuery must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Projected variable {?var} is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                $this sqe:projection/rdf:rest*/rdf:first ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this sqe:groupBy/rdf:rest*/rdf:first/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """
    ], [
        a sh:SPARQLConstraint ;
        sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having)/rdf:rest*/rdf:first ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:vars|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|rdf:rest|rdf:first)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/rdf:rest*/rdf:first/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """
    ] ;
    sh:targetClass sqe:SelectQuery .

sqe:SelectModifierShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:groupBy must be a single, non-empty rdf:List of variables, expressions or sqe:Alias" ;
        sh:node sqe:GroupByListShape ;
        sh:path sqe:groupBy
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:having must be a single, non-empty rdf:List of expressions" ;
        sh:node sqe:HavingListShape ;
        sh:path sqe:having
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:selectAll must be a single xsd:boolean" ;
        sh:path sqe:selectAll
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:distinct must be a single xsd:boolean" ;
        sh:path sqe:distinct
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:reduced must be a single xsd:boolean" ;
        sh:path sqe:reduced
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A sqe:SelectQuery needs exactly one of sqe:projection (a variable list) or sqe:selectAll (SELECT *)." ;
        sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER NOT EXISTS { $this sqe:projection ?p }
                    FILTER NOT EXISTS { $this sqe:selectAll ?a }
                } UNION {
                    $this sqe:projection ?p ; sqe:selectAll ?a .
                }
            }
        """
    ], [
        a sh:SPARQLConstraint ;
        sh:message "A sqe:SelectQuery cannot be both sqe:distinct and sqe:reduced." ;
        sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE { $this sqe:distinct ?d ; sqe:reduced ?r . }
        """
    ] ;
    sh:targetClass sqe:SelectQuery .

sqe:SolutionModifierShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:orderBy must be a single, well-formed rdf:List of sqe:OrderCondition" ;
        sh:node sqe:OrderByListShape ;
        sh:path sqe:orderBy
    ], [
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:message "sqe:limit must be a single non-negative xsd:integer" ;
        sh:minInclusive 0 ;
        sh:path sqe:limit
    ], [
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:message "sqe:offset must be a single non-negative xsd:integer" ;
        sh:minInclusive 0 ;
        sh:path sqe:offset
    ] ;
    sh:targetClass sqe:AskQuery, sqe:ConstructQuery, sqe:DescribeQuery, sqe:SelectQuery .

sqe:OrderByListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed, non-empty rdf:List of sqe:OrderCondition" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a sqe:OrderCondition }
                }
            }
        """
    ] .

sqe:OrderConditionShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:OrderCondition must have exactly one sqe:expr, a variable or well-formed expression" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path sqe:expr
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:descending must be a single xsd:boolean" ;
        sh:path sqe:descending
    ] ;
    sh:targetClass sqe:OrderCondition .

sqe:TripleTermShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:TripleTerm must have exactly one sqe:subject (an IRI, blank node, variable or triple term - never a literal)" ;
        sh:minCount 1 ;
        sh:node sqe:SubjectOrVariableShape ;
        sh:path sqe:subject
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:TripleTerm must have exactly one sqe:predicate (an IRI or variable)" ;
        sh:minCount 1 ;
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path sqe:predicate
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:TripleTerm must have exactly one sqe:object" ;
        sh:minCount 1 ;
        sh:node sqe:ObjectOrVariableShape ;
        sh:path sqe:object
    ] ;
    sh:targetClass sqe:TripleTerm .

sqe:ExistsShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Exists must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:negated must be a single xsd:boolean" ;
        sh:path sqe:negated
    ] ;
    sh:targetClass sqe:Exists .

sqe:AliasShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Alias must have exactly one sqe:expr, an expression" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path sqe:expr
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Alias must have exactly one sqe:var, the variable it binds" ;
        sh:minCount 1 ;
        sh:node spexpr:VariableShape ;
        sh:path sqe:var
    ] ;
    sh:targetClass sqe:Alias .

sqe:MinusShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Minus must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ] ;
    sh:targetClass sqe:Minus .

sqe:GraphShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Graph must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Graph must have exactly one sqe:graph, an IRI or variable" ;
        sh:minCount 1 ;
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path sqe:graph
    ] ;
    sh:targetClass sqe:Graph .

sqe:ValuesShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Values must have exactly one sqe:vars, an rdf:List of variables" ;
        sh:minCount 1 ;
        sh:node sqe:VariableListShape ;
        sh:path sqe:vars
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Values must have exactly one sqe:rows, an rdf:List of rdf:List rows" ;
        sh:minCount 1 ;
        sh:node sqe:RowsListShape ;
        sh:path sqe:rows
    ] ;
    sh:targetClass sqe:Values .

sqe:ProjectionListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "sqe:projection must be a non-empty rdf:List of variables and sqe:Alias nodes" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a sqe:Alias }
                    FILTER NOT EXISTS { FILTER ( isLiteral(?item) && datatype(?item) = spexpr:Variable ) }
                }
            }
        """
    ] .

sqe:GroupByListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "sqe:groupBy must be a non-empty rdf:List of variables, sqe:Alias nodes or expressions" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( isLiteral(?item) && datatype(?item) != spexpr:Variable || isIRI(?item) )
                }
            }
        """
    ] .

sqe:HavingListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "sqe:having must be a non-empty rdf:List of expressions" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                }
            }
        """
    ] .

sqe:VariableListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected an rdf:List of variables" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { FILTER ( isLiteral(?item) && datatype(?item) = spexpr:Variable ) }
                }
            }
        """
    ] .

sqe:RowsListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "sqe:rows must be a well-formed rdf:List of rdf:List rows" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?row .
                    FILTER ( ?row != rdf:nil )
                    FILTER NOT EXISTS { ?row rdf:first ?cell }
                }
            }
        """
    ] .

sqe:QueryValuesShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:class sqe:Values ;
        sh:message "a query's trailing sqe:values must be a single sqe:Values block" ;
        sh:path sqe:values
    ] ;
    sh:targetClass sqe:Query, sqe:SubSelect .

sqe:PrologueShape a sh:NodeShape ;
    sh:property [
        sh:class sqe:PrefixBinding ;
        sh:message "sqe:prologuePrefix must be a sqe:PrefixBinding node" ;
        sh:path sqe:prologuePrefix
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:base must be a single IRI" ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:base
    ] ;
    sh:targetClass sqe:Query .

sqe:ShapesGraph a sh:ShapesGraph ;
    rdfs:member sqe:FilterShape, sqe:AskQueryShape, sqe:BindShape, sqe:ObjectOrVariableShape, sqe:ConstructQueryShape, sqe:OptionalShape, sqe:SubjectOrVariableShape, sqe:WhereListShape, sqe:UnionShape, sqe:SelectQueryShape, sqe:AlternativesListShape, sqe:PrefixBindingShape, sqe:TemplateListShape, sqe:TriplePatternShape, sqe:PredicateOrVariableOrPathShape, sqe:SelectModifierShape, sqe:SolutionModifierShape, sqe:OrderByListShape, sqe:OrderConditionShape, sqe:TripleTermShape, sqe:ExistsShape, sqe:AliasShape, sqe:MinusShape, sqe:GraphShape, sqe:ValuesShape, sqe:ProjectionListShape, sqe:GroupByListShape, sqe:HavingListShape, sqe:VariableListShape, sqe:RowsListShape, sqe:QueryValuesShape, sqe:PrologueShape, sqe:ServiceShape, sqe:DescribeQueryShape, sqe:DatasetClauseShape, sqe:DatasetListShape, sqe:GroupingModifierShape, sqe:DatasetShape, sqe:VariableOrIriListShape, sqe:UpdateRequestShape, sqe:UpdateOperationShape, sqe:UpdateOperationListShape, sqe:QuadListShape, sqe:QuadGraphShape, sqe:QuadTriplesListShape, sqe:InsertDataShape, sqe:DeleteDataShape, sqe:DeleteWhereShape, sqe:ModifyShape, sqe:LoadShape, sqe:ClearShape, sqe:DropShape, sqe:CreateShape, sqe:AddShape, sqe:MoveShape, sqe:CopyShape, sqe:GraphRefShape, sqe:AnyGraphRefShape, sqe:GraphOrDefaultShape ;
    owl:imports spexpr:ShapesGraph .

sqe:SubjectOrVariableShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] [
        sh:nodeKind sh:BlankNode
    ] spexpr:VariableShape [
        sh:class sqe:TripleTerm
    ] ) .

sqe:TemplateListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of sqe:TriplePattern" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a sqe:TriplePattern }
                }
            }
        """
    ] .

sqe:TriplePatternShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:TriplePattern must have exactly one sqe:subject, an IRI/blank node/Variable" ;
        sh:minCount 1 ;
        sh:node sqe:SubjectOrVariableShape ;
        sh:path sqe:subject
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:TriplePattern must have exactly one sqe:predicate, an IRI/Variable/property path" ;
        sh:minCount 1 ;
        sh:node sqe:PredicateOrVariableOrPathShape ;
        sh:path sqe:predicate
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:TriplePattern must have exactly one sqe:object" ;
        sh:minCount 1 ;
        sh:node sqe:ObjectOrVariableShape ;
        sh:path sqe:object
    ] ;
    sh:targetClass sqe:TriplePattern .

sqe:UnionShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Union must have exactly one sqe:alternatives, an rdf:List of pattern lists" ;
        sh:minCount 1 ;
        sh:node sqe:AlternativesListShape ;
        sh:path sqe:alternatives
    ] ;
    sh:targetClass sqe:Union .

sqe:WhereListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of sqe:TriplePattern/Optional/Union/Filter/Bind/Minus/Graph/Service/Values/SubSelect" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS {
                        ?item a ?t .
                        FILTER ( ?t IN ( sqe:TriplePattern, sqe:Optional, sqe:Union, sqe:Filter, sqe:Bind, sqe:Minus, sqe:Graph, sqe:Service, sqe:Values, sqe:SubSelect ) )
                    }
                }
            }
        """
    ] .

sqe:ServiceShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Service must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Service must have exactly one sqe:service, an IRI or variable" ;
        sh:minCount 1 ;
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path sqe:service
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:silent must be a single xsd:boolean" ;
        sh:path sqe:silent
    ] ;
    sh:targetClass sqe:Service .

sqe:DescribeQueryShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:DescribeQuery may have one sqe:where, a well-formed pattern list" ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:describe must be a single, non-empty rdf:List of IRIs and variables" ;
        sh:node sqe:VariableOrIriListShape ;
        sh:path sqe:describe
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:describeAll must be a single xsd:boolean" ;
        sh:path sqe:describeAll
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A sqe:DescribeQuery needs exactly one of sqe:describe (a list of targets) or sqe:describeAll (DESCRIBE *)." ;
        sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER NOT EXISTS { $this sqe:describe ?p }
                    FILTER NOT EXISTS { $this sqe:describeAll ?a }
                } UNION {
                    $this sqe:describe ?p ; sqe:describeAll ?a .
                }
            }
        """
    ], [
        a sh:SPARQLConstraint ;
        sh:message "DESCRIBE * needs a sqe:where pattern (it describes the variables of the pattern)." ;
        sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                $this sqe:describeAll ?a .
                FILTER NOT EXISTS { $this sqe:where ?w }
            }
        """
    ] ;
    sh:targetClass sqe:DescribeQuery .

sqe:VariableOrIriListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a non-empty rdf:List of IRIs and variables" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( !isIRI(?item) && !( isLiteral(?item) && datatype(?item) = spexpr:Variable ) )
                }
            }
        """
    ] .

sqe:DatasetClauseShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:DatasetClause must have exactly one sqe:source, a graph IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:source
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:named must be a single xsd:boolean" ;
        sh:path sqe:named
    ] ;
    sh:targetClass sqe:DatasetClause .

sqe:DatasetListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "sqe:dataset must be a non-empty, well-formed rdf:List of sqe:DatasetClause" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a sqe:DatasetClause }
                }
            }
        """
    ] .

sqe:GroupingModifierShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:groupBy must be a single, non-empty rdf:List of variables, expressions or sqe:Alias" ;
        sh:node sqe:GroupByListShape ;
        sh:path sqe:groupBy
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:having must be a single, non-empty rdf:List of expressions" ;
        sh:node sqe:HavingListShape ;
        sh:path sqe:having
    ] ;
    sh:targetClass sqe:AskQuery, sqe:ConstructQuery, sqe:DescribeQuery .

sqe:DatasetShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:dataset must be a single rdf:List of sqe:DatasetClause (the FROM / FROM NAMED clauses)" ;
        sh:node sqe:DatasetListShape ;
        sh:path sqe:dataset
    ] ;
    sh:targetClass sqe:AskQuery, sqe:ConstructQuery, sqe:DescribeQuery, sqe:SelectQuery .

sqe:UpdateRequestShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:UpdateRequest must have exactly one sqe:operations, a well-formed rdf:List of update operations (rdf:nil for an empty request)" ;
        sh:minCount 1 ;
        sh:node sqe:UpdateOperationListShape ;
        sh:path sqe:operations
    ], [
        sh:class sqe:PrefixBinding ;
        sh:message "sqe:prologuePrefix must be a sqe:PrefixBinding node" ;
        sh:path sqe:prologuePrefix
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:base must be a single IRI" ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:base
    ] ;
    sh:targetClass sqe:UpdateRequest .

sqe:UpdateOperationShape a sh:NodeShape ;
    sh:property [
        sh:class sqe:PrefixBinding ;
        sh:message "sqe:prologuePrefix must be a sqe:PrefixBinding node" ;
        sh:path sqe:prologuePrefix
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:base must be a single IRI" ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:base
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:silent must be a single xsd:boolean" ;
        sh:datatype xsd:boolean ;
        sh:path sqe:silent
    ] ;
    sh:targetClass sqe:UpdateOperation .

sqe:UpdateOperationListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of update operations (rdf:nil for none)" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS {
                        ?item a ?t .
                        FILTER ( ?t IN ( sqe:InsertData, sqe:DeleteData, sqe:DeleteWhere, sqe:Modify, sqe:Load, sqe:Clear, sqe:Drop, sqe:Create, sqe:Add, sqe:Move, sqe:Copy ) )
                    }
                }
            }
        """
    ] .

sqe:QuadListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of sqe:TriplePattern and sqe:QuadGraph (rdf:nil for none)" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS {
                        ?item a ?t .
                        FILTER ( ?t IN ( sqe:TriplePattern, sqe:QuadGraph ) )
                    }
                }
            }
        """
    ] .

sqe:QuadTriplesListShape a sh:NodeShape ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of sqe:TriplePattern (rdf:nil for none)" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS {
                        ?item a ?t .
                        FILTER ( ?t IN ( sqe:TriplePattern ) )
                    }
                }
            }
        """
    ] .

sqe:QuadGraphShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:QuadGraph must have exactly one sqe:graphName, an IRI or variable" ;
        sh:minCount 1 ;
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path sqe:graphName
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:QuadGraph must have exactly one sqe:triples, a list of sqe:TriplePattern" ;
        sh:minCount 1 ;
        sh:node sqe:QuadTriplesListShape ;
        sh:path sqe:triples
    ] ;
    sh:targetClass sqe:QuadGraph .

sqe:InsertDataShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:InsertData must have exactly one sqe:quads, a well-formed quad list" ;
        sh:minCount 1 ;
        sh:node sqe:QuadListShape ;
        sh:path sqe:quads
    ] ;
    sh:sparql     [
        a sh:SPARQLConstraint ;
        sh:message "Variables are not allowed in INSERT DATA." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:quads/(rdf:rest|rdf:first|sqe:triples|sqe:subject|sqe:predicate|sqe:object|sqe:graphName)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object|sqe:graphName) ?v .
                FILTER ( isLiteral(?v) && datatype(?v) = spexpr:Variable )
            }
        """
    ] ;
    sh:targetClass sqe:InsertData .

sqe:DeleteDataShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:DeleteData must have exactly one sqe:quads, a well-formed quad list" ;
        sh:minCount 1 ;
        sh:node sqe:QuadListShape ;
        sh:path sqe:quads
    ] ;
    sh:sparql     [
        a sh:SPARQLConstraint ;
        sh:message "Variables are not allowed in DELETE DATA." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:quads/(rdf:rest|rdf:first|sqe:triples|sqe:subject|sqe:predicate|sqe:object|sqe:graphName)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object|sqe:graphName) ?v .
                FILTER ( isLiteral(?v) && datatype(?v) = spexpr:Variable )
            }
        """
    ],
    [
        a sh:SPARQLConstraint ;
        sh:message "Blank nodes are not allowed in DELETE DATA." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:quads/(rdf:rest|rdf:first|sqe:triples|sqe:subject|sqe:predicate|sqe:object)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object) ?v .
                FILTER ( isBlank(?v) )
                FILTER NOT EXISTS { ?v a sqe:TripleTerm }
            }
        """
    ] ;
    sh:targetClass sqe:DeleteData .

sqe:DeleteWhereShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:DeleteWhere must have exactly one sqe:quads, a well-formed quad list" ;
        sh:minCount 1 ;
        sh:node sqe:QuadListShape ;
        sh:path sqe:quads
    ] ;
    sh:sparql     [
        a sh:SPARQLConstraint ;
        sh:message "Blank nodes are not allowed in DELETE WHERE." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:quads/(rdf:rest|rdf:first|sqe:triples|sqe:subject|sqe:predicate|sqe:object)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object) ?v .
                FILTER ( isBlank(?v) )
                FILTER NOT EXISTS { ?v a sqe:TripleTerm }
            }
        """
    ] ;
    sh:targetClass sqe:DeleteWhere .

sqe:ModifyShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:with must be a single IRI" ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:with
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:delete must be a single, well-formed quad list" ;
        sh:node sqe:QuadListShape ;
        sh:path sqe:delete
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:insert must be a single, well-formed quad list" ;
        sh:node sqe:QuadListShape ;
        sh:path sqe:insert
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:using must be a single, non-empty rdf:List of sqe:DatasetClause" ;
        sh:node sqe:DatasetListShape ;
        sh:path sqe:using
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Modify must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where
    ] ;
    sh:sparql     [
        a sh:SPARQLConstraint ;
        sh:message "Blank nodes are not allowed in a DELETE template." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:delete/(rdf:rest|rdf:first|sqe:triples|sqe:subject|sqe:predicate|sqe:object)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object) ?v .
                FILTER ( isBlank(?v) )
                FILTER NOT EXISTS { ?v a sqe:TripleTerm }
            }
        """
    ],
    [
        a sh:SPARQLConstraint ;
        sh:message "A sqe:Modify needs a sqe:delete or a sqe:insert template." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this a sqe:Modify .
                FILTER NOT EXISTS { $this sqe:delete ?d }
                FILTER NOT EXISTS { $this sqe:insert ?i }
            }
        """
    ] ;
    sh:targetClass sqe:Modify .

sqe:LoadShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Load must have exactly one sqe:loadFrom, an IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:loadFrom
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:into must be a single sqe:GraphRef" ;
        sh:class sqe:GraphRef ;
        sh:path sqe:into
    ] ;
    sh:targetClass sqe:Load .

sqe:ClearShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Clear must have exactly one sqe:target, a graph reference" ;
        sh:minCount 1 ;
        sh:node sqe:AnyGraphRefShape ;
        sh:path sqe:target
    ] ;
    sh:targetClass sqe:Clear .

sqe:DropShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Drop must have exactly one sqe:target, a graph reference" ;
        sh:minCount 1 ;
        sh:node sqe:AnyGraphRefShape ;
        sh:path sqe:target
    ] ;
    sh:targetClass sqe:Drop .

sqe:CreateShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Create must have exactly one sqe:target, a sqe:GraphRef" ;
        sh:minCount 1 ;
        sh:class sqe:GraphRef ;
        sh:path sqe:target
    ] ;
    sh:targetClass sqe:Create .

sqe:AddShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Add must have exactly one sqe:from, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:from
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Add must have exactly one sqe:to, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:to
    ] ;
    sh:targetClass sqe:Add .

sqe:MoveShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Move must have exactly one sqe:from, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:from
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Move must have exactly one sqe:to, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:to
    ] ;
    sh:targetClass sqe:Move .

sqe:CopyShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Copy must have exactly one sqe:from, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:from
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Copy must have exactly one sqe:to, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:to
    ] ;
    sh:targetClass sqe:Copy .

sqe:GraphRefShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:GraphRef must have exactly one sqe:graphIri, an IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:graphIri
    ] ;
    sh:targetClass sqe:GraphRef .

sqe:AnyGraphRefShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:GraphRef
    ] [
        sh:class sqe:DefaultGraph
    ] [
        sh:class sqe:NamedGraphs
    ] [
        sh:class sqe:AllGraphs
    ] ) .

sqe:GraphOrDefaultShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:GraphRef
    ] [
        sh:class sqe:DefaultGraph
    ] ) .
