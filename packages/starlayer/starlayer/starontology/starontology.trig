    _:ndf52ad7b3e8048a497d1e5c26224be38b137 a sh:SPARQLConstraint ;
        sh:message "expected a well-formed 2-element rdf:List [source, dest] of graph references (IRI/BlankNode/PyStr DEFAULT keyword)" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starsparql/ns/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER NOT EXISTS { $this rdf:first ?first }
                } UNION {
                    FILTER NOT EXISTS { $this rdf:rest/rdf:first ?second }
                } UNION {
                    $this rdf:rest/rdf:rest ?tail .
                    FILTER ( ?tail != rdf:nil )
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( !isIRI(?item) && !isBlank(?item) && !(isLiteral(?item) && datatype(?item) = salg:PyStr) )
                }
            }
