<https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/starontology/skos-ontology.ttl> {
    skos:altLabel a owl:AnnotationProperty ;
        rdfs:range rdfs:Literal ;
        rdfs:subPropertyOf rdfs:label .

    skos:changeNote a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:definition a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:editorialNote a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:exactMatch a owl:ObjectProperty,
            owl:SymmetricProperty,
            owl:TransitiveProperty ;
        rdfs:subPropertyOf skos:closeMatch .

    skos:example a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:hiddenLabel a owl:AnnotationProperty ;
        rdfs:range rdfs:Literal ;
        rdfs:subPropertyOf rdfs:label .

    skos:historyNote a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:member a owl:ObjectProperty ;
        rdfs:domain skos:Collection ;
        rdfs:range _:n9a9be701ff23425cb84ffdf765f8c8c0b1 .

    skos:memberList a owl:FunctionalProperty,
            owl:ObjectProperty ;
        rdfs:domain skos:OrderedCollection ;
        rdfs:range rdf:List .

    skos:narrowMatch a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:mappingRelation,
            skos:narrower ;
        owl:inverseOf skos:broadMatch .

    skos:notation a owl:DatatypeProperty .

    skos:prefLabel a owl:AnnotationProperty ;
        rdfs:range rdfs:Literal ;
        rdfs:subPropertyOf rdfs:label .

    skos:relatedMatch a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:subPropertyOf skos:mappingRelation,
            skos:related .

    skos:scopeNote a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:topConceptOf a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:inScheme ;
        owl:inverseOf skos:hasTopConcept .

    skos:OrderedCollection a owl:Class ;
        rdfs:subClassOf skos:Collection .

    skos:broadMatch a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:broader,
            skos:mappingRelation .

    skos:closeMatch a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:subPropertyOf skos:mappingRelation .

    skos:hasTopConcept a owl:ObjectProperty ;
        rdfs:domain skos:ConceptScheme ;
        rdfs:range skos:Concept .

    skos:inScheme a owl:ObjectProperty ;
        rdfs:range skos:ConceptScheme .

    skos:narrower a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:narrowerTransitive ;
        owl:inverseOf skos:broader .

    skos:narrowerTransitive a owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:subPropertyOf skos:semanticRelation ;
        owl:inverseOf skos:broaderTransitive .

    skos:related a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:subPropertyOf skos:semanticRelation .

    skos:broader a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:broaderTransitive .

    skos:broaderTransitive a owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:subPropertyOf skos:semanticRelation .

    skos:ConceptScheme a owl:Class ;
        owl:disjointWith skos:Collection .

    skos:Concept a owl:Class ;
        owl:disjointWith skos:Collection,
            skos:ConceptScheme .

    skos:mappingRelation a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:semanticRelation .

    skos:semanticRelation a owl:ObjectProperty ;
        rdfs:domain skos:Concept ;
        rdfs:range skos:Concept .

    skos:Collection a owl:Class .

    skos:note a owl:AnnotationProperty .

    _:n9a9be701ff23425cb84ffdf765f8c8c0b1 a owl:Class ;
        owl:unionOf _:n9a9be701ff23425cb84ffdf765f8c8c0b2 .

    _:n9a9be701ff23425cb84ffdf765f8c8c0b2 rdf:first skos:Concept ;
        rdf:rest _:n9a9be701ff23425cb84ffdf765f8c8c0b3 .

    _:n9a9be701ff23425cb84ffdf765f8c8c0b3 rdf:first skos:Collection ;
        rdf:rest () .
}

<https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/starontology/srl-ontology.ttl> {
    srl:AssignmentElement a rdfs:Class ;
        rdfs:comment "SET (?var := expr) - srl:var/srl:expr, §4.1. Never legal inside a negation element's own body." ;
        rdfs:subClassOf srl:BodyElement .

    srl:BodyElement a rdfs:Class ;
        rdfs:comment "The union of every rule-body element kind: TriplePattern, FilterElement, AssignmentElement, NegationElement." .

    srl:Data a rdfs:Class ;
        rdfs:comment "One top-level DATA {} block - srl:triples, ground only, §4.1." .

    srl:FilterElement a rdfs:Class ;
        rdfs:comment "FILTER Constraint - srl:expr, a real salg: expression tree, §4.1." ;
        rdfs:subClassOf srl:BodyElement,
            srl:NegationBodyElement .

    srl:NegationBodyElement a rdfs:Class ;
        rdfs:comment "The narrower union a negation element's own inner body is restricted to: TriplePattern or FilterElement only." .

    srl:NegationElement a rdfs:Class ;
        rdfs:comment "NOT DATA? {...} - srl:inner (a list of srl:NegationBodyElement), srl:negationData (bool), §4.1. Never legal inside another negation element's own body." ;
        rdfs:subClassOf srl:BodyElement .

    srl:Rule a rdfs:Class ;
        rdfs:comment "One RULE - srl:head/srl:body (lists), srl:ruleData (bool: match WHERE DATA), srl:id (optional IRI), §4.1." .

    srl:RuleSet a rdfs:Class ;
        rdfs:comment "A whole SRL rule set - srl:rules/srl:data/srl:imports, §4.1." .

    srl:TriplePattern a rdfs:Class ;
        rdfs:comment "A triple template (rule head) or triple pattern (rule body/DATA) - srl:subject/srl:predicate/srl:object, same shape either way per §4.1." ;
        rdfs:subClassOf srl:BodyElement,
            srl:NegationBodyElement .
}

<https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/starontology/skos_shapes.ttl> {
    skshp:ShapesGraph a sh:ShapesGraph ;
        rdfs:member skshp:CollectionDisjointnessShape,
            skshp:ConceptDisjointnessShape,
            skshp:ConceptPrefLabelRecommendedShape,
            skshp:ConceptSchemeDisjointnessShape,
            skshp:LexicalLabelShape,
            skshp:MappingRelationDisjointnessShape,
            skshp:OrderedCollectionMemberListConsistencyShape,
            skshp:RelatedDisjointWithHierarchicalShape,
            skshp:SemanticRelationDomainRangeShape .

    skshp:CollectionDisjointnessShape a sh:NodeShape ;
        sh:message "S37: skos:Collection is disjoint with skos:Concept and skos:ConceptScheme." ;
        sh:not _:n6066219323ef42229071c525556696fdb7,
            _:n6066219323ef42229071c525556696fdb8 ;
        sh:targetClass skos:Collection,
            skos:OrderedCollection .

    skshp:ConceptDisjointnessShape a sh:NodeShape ;
        sh:message "S9/S37: skos:Concept is disjoint with skos:ConceptScheme and skos:Collection." ;
        sh:not _:n6066219323ef42229071c525556696fdb1,
            _:n6066219323ef42229071c525556696fdb2,
            _:n6066219323ef42229071c525556696fdb3 ;
        sh:targetClass skos:Concept .

    skshp:ConceptPrefLabelRecommendedShape a sh:NodeShape ;
        sh:property _:n6066219323ef42229071c525556696fdb15 ;
        sh:targetClass skos:Concept .

    skshp:ConceptSchemeDisjointnessShape a sh:NodeShape ;
        sh:message "S9/S37: skos:ConceptScheme is disjoint with skos:Concept and skos:Collection." ;
        sh:not _:n6066219323ef42229071c525556696fdb4,
            _:n6066219323ef42229071c525556696fdb5,
            _:n6066219323ef42229071c525556696fdb6 ;
        sh:targetClass skos:ConceptScheme .

    skshp:LexicalLabelShape a sh:NodeShape ;
        sh:property _:n6066219323ef42229071c525556696fdb10,
            _:n6066219323ef42229071c525556696fdb11,
            _:n6066219323ef42229071c525556696fdb9 ;
        sh:targetSubjectsOf skos:altLabel,
            skos:hiddenLabel,
            skos:prefLabel .

    skshp:MappingRelationDisjointnessShape a sh:NodeShape ;
        sh:property _:n6066219323ef42229071c525556696fdb13 ;
        sh:targetSubjectsOf skos:exactMatch .

    skshp:OrderedCollectionMemberListConsistencyShape a sh:NodeShape ;
        sh:sparql _:n6066219323ef42229071c525556696fdb14 ;
        sh:targetClass skos:OrderedCollection .

    skshp:RelatedDisjointWithHierarchicalShape a sh:NodeShape ;
        sh:property _:n6066219323ef42229071c525556696fdb12 ;
        sh:targetSubjectsOf skos:related .

    skshp:SemanticRelationDomainRangeShape a sh:NodeShape ;
        sh:class skos:Concept ;
        sh:message "S19/S20: the domain and range of every SKOS semantic relation is skos:Concept." ;
        sh:targetObjectsOf skos:broader,
            skos:broaderTransitive,
            skos:narrower,
            skos:narrowerTransitive,
            skos:related,
            skos:semanticRelation ;
        sh:targetSubjectsOf skos:broader,
            skos:broaderTransitive,
            skos:narrower,
            skos:narrowerTransitive,
            skos:related,
            skos:semanticRelation .

    _:n6066219323ef42229071c525556696fdb1 sh:class skos:ConceptScheme .

    _:n6066219323ef42229071c525556696fdb10 sh:disjoint skos:hiddenLabel,
            skos:prefLabel ;
        sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint." ;
        sh:path skos:altLabel .

    _:n6066219323ef42229071c525556696fdb11 sh:disjoint skos:altLabel,
            skos:prefLabel ;
        sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint." ;
        sh:path skos:hiddenLabel .

    _:n6066219323ef42229071c525556696fdb12 sh:disjoint skos:broader,
            skos:broaderTransitive,
            skos:narrower,
            skos:narrowerTransitive ;
        sh:message "S27: skos:related is disjoint with skos:broader(Transitive)/skos:narrower(Transitive)." ;
        sh:path skos:related .

    _:n6066219323ef42229071c525556696fdb13 sh:disjoint skos:broadMatch,
            skos:narrowMatch,
            skos:relatedMatch ;
        sh:message "S46: skos:exactMatch is disjoint with skos:broadMatch, skos:narrowMatch, and skos:relatedMatch." ;
        sh:path skos:exactMatch .

    _:n6066219323ef42229071c525556696fdb14 a sh:SPARQLConstraint ;
        sh:message "skos:memberList and skos:member must describe the same set of members." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT DISTINCT $this
            WHERE {
                $this skos:memberList ?list .
                {
                    ?list rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { $this skos:member ?item }
                }
                UNION
                {
                    $this skos:member ?item .
                    FILTER NOT EXISTS { ?list rdf:rest*/rdf:first ?item }
                }
            }
        """ .

    _:n6066219323ef42229071c525556696fdb15 sh:message "Recommended: a skos:Concept should have at least one skos:prefLabel." ;
        sh:minCount 1 ;
        sh:path skos:prefLabel ;
        sh:severity sh:Info .

    _:n6066219323ef42229071c525556696fdb2 sh:class skos:Collection .

    _:n6066219323ef42229071c525556696fdb3 sh:class skos:OrderedCollection .

    _:n6066219323ef42229071c525556696fdb4 sh:class skos:Concept .

    _:n6066219323ef42229071c525556696fdb5 sh:class skos:Collection .

    _:n6066219323ef42229071c525556696fdb6 sh:class skos:OrderedCollection .

    _:n6066219323ef42229071c525556696fdb7 sh:class skos:Concept .

    _:n6066219323ef42229071c525556696fdb8 sh:class skos:ConceptScheme .

    _:n6066219323ef42229071c525556696fdb9 sh:datatype rdf:langString ;
        sh:disjoint skos:altLabel,
            skos:hiddenLabel ;
        sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint. S14: no more than one skos:prefLabel per language tag." ;
        sh:path skos:prefLabel ;
        sh:uniqueLang true .
}

