    _:n0fc827eebb834aa59e55935693e77169b17 sh:maxCount 1 ;
        sh:message "sqe:TriplePattern must have exactly one sqe:subject, an IRI/blank node/Variable" ;
        sh:minCount 1 ;
        sh:node sqe:SubjectOrVariableShape ;
        sh:path sqe:subject .

    _:n0fc827eebb834aa59e55935693e77169b18 sh:maxCount 1 ;
