    sqe:BindShape a sh:NodeShape ;
        sh:property _:n0fc827eebb834aa59e55935693e77169b24,
            _:n0fc827eebb834aa59e55935693e77169b25 ;
        sh:targetClass sqe:Bind .

    sqe:ConstructQueryShape a sh:NodeShape ;
        sh:property _:n0fc827eebb834aa59e55935693e77169b29,
            _:n0fc827eebb834aa59e55935693e77169b30 ;
        sh:targetClass sqe:ConstructQuery .

    sqe:FilterShape a sh:NodeShape ;
        sh:property _:n0fc827eebb834aa59e55935693e77169b23 ;
        sh:targetClass sqe:Filter .

    sqe:OptionalShape a sh:NodeShape ;
        sh:property _:n0fc827eebb834aa59e55935693e77169b21 ;
        sh:targetClass sqe:Optional .

    sqe:SelectQueryShape a sh:NodeShape ;
        sh:property _:n0fc827eebb834aa59e55935693e77169b26,
            _:n0fc827eebb834aa59e55935693e77169b27 ;
        sh:targetClass sqe:SelectQuery .

    sqe:TriplePatternShape a sh:NodeShape ;
        sh:property _:n0fc827eebb834aa59e55935693e77169b17,
            _:n0fc827eebb834aa59e55935693e77169b18,
            _:n0fc827eebb834aa59e55935693e77169b19 ;
        sh:targetClass sqe:TriplePattern .

    sqe:UnionShape a sh:NodeShape ;
        sh:property _:n0fc827eebb834aa59e55935693e77169b22 ;
