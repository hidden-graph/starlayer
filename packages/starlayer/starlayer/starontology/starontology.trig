    stsh:WidgetScoreShape a sh:NodeShape ;
        rdfs:label "Well-formedness rules for shui:WidgetScore"@en ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:path shui:widget ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ;
                sh:path shui:score ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:path shui:dataGraphShape ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:path shui:shapesGraphShape ] ;
        sh:targetClass shui:WidgetScore .

    stsh:formFields a rdf:Property ;
        rdfs:label "form fields"@en ;
        rdfs:comment "The predicates that are the fields of a form shape generated from this source: a list. The build makes one property shape per predicate (named stsh:<Form>_<prefix>_<local>), with that predicate's group, order, maximum count, datatype and node kind. The list is documentation in the built file; the order of the fields is their sh:order."@en .

    stsh:formFieldsExcept a rdf:Property ;
        rdfs:label "form fields except"@en ;
        rdfs:comment "The predicates of the form named by stsh:formFieldsOf that this form leaves out."@en .

    stsh:formFieldsOf a rdf:Property ;
        rdfs:label "form fields of"@en ;
        rdfs:comment "A form that has the fields of the form of this class (node shape or property shape), besides its own stsh:formFields, less stsh:formFieldsExcept."@en .

    stsh:formFor a rdf:Property ;
        rdfs:label "form for"@en ;
        rdfs:comment "The class of node a form shape is the form for (sh:NodeShape, sh:PropertyShape, sh:PropertyGroup, ...). A tool picks the form for a node by its type and passes the form to select_widgets as shape_node. It is not sh:targetClass on purpose: a form shape with no sh:target* is not applied to anything, so loading it never changes what validates."@en .

    stsh:formForSubclasses a rdf:Property ;
        rdfs:label "form for subclasses"@en ;
        rdfs:comment "On a form: it is also the form of a node whose type is a subclass of the class it is for (a data graph, a single editor), besides the forms of the subclass itself."@en .

    stsh:formHeldBy a rdf:Property ;
        rdfs:label "form held by"@en ;
        rdfs:comment "On a predicate: the field is for a node that is the value of sh:parameter of a node of this class (sh:optional: sh:ConstraintComponent; sh:keyParameter: sh:NamedParameterExpressionFunction). A tool shows the field only then, or when it does not know what holds the node."@en .

    stsh:formMaxCount a rdf:Property ;
        rdfs:label "form max count"@en ;
        rdfs:comment "Maximum cardinality in the editing form. Absent = multi-valued."@en ;
        rdfs:range xsd:integer .

    stsh:formOnlyFor a rdf:Property ;
        rdfs:label "form only for"@en ;
        rdfs:comment "On a predicate: the field is for a node of this class (a graph that is a sh:DataGraph). A tool shows it only then."@en .

    stsh:formRequired a rdf:Property ;
        rdfs:label "form required"@en ;
        rdfs:comment "The predicates of stsh:formFields that a node of this kind must have: each field gets sh:minCount 1."@en .

    stsh:nodeFormField a rdf:Property ;
        rdfs:label "node form field"@en ;
        rdfs:comment "True when this predicate appears as an inline form field in NodeShape editors."@en ;
        rdfs:range xsd:boolean .

    stsh:nodePrimary a rdf:Property ;
        rdfs:label "node primary"@en ;
        rdfs:comment "When false, the predicate is allowed but not commonly expected — editors may show it in a secondary or collapsed section. Absent is treated as true."@en ;
        rdfs:range xsd:boolean .

    stsh:propertyFormField a rdf:Property ;
        rdfs:label "property form field"@en ;
        rdfs:comment "True when this predicate appears as an inline form field in PropertyShape editors."@en ;
        rdfs:range xsd:boolean .

    stsh:secondary a rdf:Property ;
        rdfs:label "secondary"@en ;
        rdfs:comment "True on a field of a form shape when the predicate is allowed but not commonly expected for that kind of node; a tool may show it in a collapsed section. Absent is treated as false. Generated from stsh:nodePrimary false for the node shape form."@en ;
        rdfs:range xsd:boolean .

