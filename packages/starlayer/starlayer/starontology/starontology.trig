    _:ne6fc48832bd84c2698f5fc5e4672effeb14 a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of class expressions" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayergraph/ns/manchester-ast#>
            SELECT $this
            WHERE {
                { FILTER ( $this != rdf:nil ) FILTER NOT EXISTS { $this rdf:first ?head } }
                UNION
                {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a manch:ClassExpression }
                    FILTER ( !isIRI(?item) )
                }
            }
        """ .

