@prefix conformance: <https://github.com/hidden-graph/starlayer/ns/conformance#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pkg: <https://github.com/hidden-graph/starlayer/tree/main/packages/starlayer/starlayer/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix profile: <http://www.w3.org/ns/shacl/profile/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .
@prefix salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix shsh: <http://www.w3.org/ns/shacl-shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skshp: <https://github.com/hidden-graph/starlayer/ns/graph/skos-shapes#> .
@prefix slp: <https://github.com/hidden-graph/starlayer/ns/profile#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#> .
@prefix srl: <https://github.com/hidden-graph/starlayer/ns/sparql/srl#> .
@prefix starontology: <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/starontology/> .
@prefix stsh: <https://github.com/hidden-graph/starlayer/ns/shacl#> .
@prefix tr: <https://www.w3.org/TR/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

starontology:manchester-ast-ontology.ttl {
    manch:AnnotationAssertion a rdfs:Class ;
        rdfs:comment "One (annotationProperty, value) pair - manch:annotationProperty (a URIRef), manch:annotationValue (a URIRef or Literal). Used both for a frame-level Annotations: clause's own items, and inside a ClauseItem's/FactItem's manch:annotations list. May itself carry manch:annotations: the annotations on this annotation (annotationAnnotatedList)." .

    manch:ClauseItem a rdfs:Class ;
        rdfs:comment "One ordinary clause-list item - manch:value (shape depends on the enclosing clause, see each Clause subclass's own comment), manch:annotations (optional, an rdf:List of AnnotationAssertion - present only when the item had an inline Annotations: prefix). Deliberately one uniform shape for every per-item-annotatable clause, regardless of whether the OWL 2 RDF mapping ultimately reifies it via owl:Axiom or (for a negative Fact:) attaches directly to an owl:NegativePropertyAssertion bnode - that distinction is an artifact of the final OWL-semantic compile step, not something that exists yet at this AST layer." .

    manch:Document a rdfs:Class ;
        rdfs:comment "The root of one parsed Manchester document." .

    manch:FacetRestriction a rdfs:Class ;
        rdfs:comment "One (facet, literal) pair inside a DRestriction - manch:facetPredicate (the xsd: facet URIRef, e.g. xsd:minInclusive), manch:facetValue (the Literal)." .

    manch:FactItem a rdfs:Class ;
        rdfs:comment "One Individual: Facts: item - manch:negative (an xsd:boolean Literal), manch:property (a URIRef), manch:value (a URIRef or Literal), manch:annotations (optional, same shape as ClauseItem's)." .

    manch:OntologyHeader a rdfs:Class ;
        rdfs:comment "The Ontology: header - manch:ontologyIri (optional URIRef), manch:versionIri (optional URIRef, only with an ontologyIri), manch:imports (rdf:List of URIRef, in order), manch:annotations (optional rdf:List of AnnotationAssertion - the ontology's own Annotations:)." .

    manch:PrefixDecl a rdfs:Class ;
        rdfs:comment "One Prefix: declaration - manch:prefixLabel (a manch:PlainString-tagged string, '' for the default prefix), manch:prefixIri (a plain string, not a URIRef - a Prefix: declaration's own IRI is definitional, not a reference)." .

    manch:And rdfs:comment "`C1 and C2 and ...` - manch:operands, an rdf:List of >=2 ClassExpression." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:AnnPropAnnotationsClause rdfs:comment "AnnotationProperty: Annotations: - same shape as ClassAnnotationsClause." ;
        rdfs:subClassOf manch:Clause .

    manch:AnnPropDomainClause rdfs:comment "AnnotationProperty: Domain: - items' manch:value is a bare URIRef." ;
        rdfs:subClassOf manch:Clause .

    manch:AnnPropRangeClause rdfs:comment "AnnotationProperty: Range: - items' manch:value is a bare URIRef." ;
        rdfs:subClassOf manch:Clause .

    manch:AnnPropSubPropertyOfClause rdfs:comment "AnnotationProperty: SubPropertyOf: - items' manch:value is a bare URIRef." ;
        rdfs:subClassOf manch:Clause .

    manch:AnnotationPropertyFrame rdfs:comment "AnnotationProperty: <name>." ;
        rdfs:subClassOf manch:Frame .

    manch:ClassAnnotationsClause rdfs:comment "Class: Annotations: - manch:items, an rdf:List of bare AnnotationAssertion (no ClauseItem wrapper, no per-item annotations slot - a frame-level Annotations: clause is never itself annotated)." ;
        rdfs:subClassOf manch:Clause .

    manch:ClassDisjointUnionOfClause rdfs:comment "DisjointUnionOf: - a single-axiom clause: manch:items holds exactly one ClauseItem, whose manch:value is itself an rdf:List of >=2 ClassExpression (the whole comma list is one axiom, annotated once - see manchester_parser.py's own DisjointUnionOf: handling)." ;
        rdfs:subClassOf manch:Clause .

    manch:ClassDisjointWithClause rdfs:comment "Class: DisjointWith: - same item shape as ClassSubClassOfClause." ;
        rdfs:subClassOf manch:Clause .

    manch:ClassEquivalentToClause rdfs:comment "Class: EquivalentTo: - same item shape as ClassSubClassOfClause." ;
        rdfs:subClassOf manch:Clause .

    manch:ClassFrame rdfs:comment "Class: <name>." ;
        rdfs:subClassOf manch:Frame .

    manch:ClassHasKeyClause rdfs:comment "HasKey: - single-axiom, same shape as ClassDisjointUnionOfClause but manch:value is an rdf:List of PropertyExpression." ;
        rdfs:subClassOf manch:Clause .

    manch:ClassSubClassOfClause rdfs:comment "SubClassOf:/SuperClassOf: - manch:items, an rdf:List of ClauseItem whose manch:value is a ClassExpression. See manch:reversed for how the two keywords are told apart." ;
        rdfs:subClassOf manch:Clause .

    manch:DAnd rdfs:comment "`D1 and D2 and ...` - manch:operands, an rdf:List of >=2 DataRange." ;
        rdfs:subClassOf manch:DataRange .

    manch:DExact rdfs:comment "`d exactly n D` - same shape as DMin." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:DMax rdfs:comment "`d max n D` - same shape as DMin." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:DMin rdfs:comment "`d min n D` - QUALIFIED data cardinality (the unqualified form stays manch:Min, it has no filler to tell data from object): manch:onProperty, manch:cardinality, manch:filler (a DataRange, required)." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:DNot rdfs:comment "`not D` - manch:operand, a single DataRange." ;
        rdfs:subClassOf manch:DataRange .

    manch:DOnly rdfs:comment "`d only D` - data-property counterpart of manch:Only; manch:filler is a DataRange." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:DOr rdfs:comment "`D1 or D2 or ...` - same shape as DAnd." ;
        rdfs:subClassOf manch:DataRange .

    manch:DSome rdfs:comment "`d some D` - a Some restriction on a DATA property: manch:onProperty, manch:filler (a DataRange, not a ClassExpression). Distinct from manch:Some because the OWL mapping differs (rdfs:Datatype fillers, owl:onDataRange for the qualified forms) and Manchester syntax itself does not mark the difference - the parser decides from the property's declaration or the filler's shape." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:DataPropAnnotationsClause rdfs:comment "DataProperty: Annotations: - same shape as ClassAnnotationsClause." ;
        rdfs:subClassOf manch:Clause .

    manch:DataPropCharacteristicsClause rdfs:comment "DataProperty: Characteristics: - same item shape as ObjPropCharacteristicsClause (only Functional is legal here, but the AST/ontology doesn't restrict which characteristic keyword)." ;
        rdfs:subClassOf manch:Clause .

    manch:DataPropDisjointWithClause rdfs:comment "DataProperty: DisjointWith: - same item shape as DataPropSubPropertyOfClause." ;
        rdfs:subClassOf manch:Clause .

    manch:DataPropDomainClause rdfs:comment "DataProperty: Domain: - items' manch:value is a ClassExpression." ;
        rdfs:subClassOf manch:Clause .

    manch:DataPropEquivalentToClause rdfs:comment "DataProperty: EquivalentTo: - same item shape as DataPropSubPropertyOfClause." ;
        rdfs:subClassOf manch:Clause .

    manch:DataPropRangeClause rdfs:comment "DataProperty: Range: - items' manch:value is a DataRange, not a ClassExpression (genuinely distinct shape from ObjPropRangeClause)." ;
        rdfs:subClassOf manch:Clause .

    manch:DataPropSubPropertyOfClause rdfs:comment "DataProperty SubPropertyOf:/SuperPropertyOf: - items' manch:value is a PropertyExpression (same grammar as the object-property case; the parser doesn't restrict `inverse` away from data properties even though it's semantically meaningless there - a deliberate parser permissiveness, not enforced by this AST either, matching manchester_parser.py's own documented declaration-order-strictness stance). See manch:reversed for how the two keywords are told apart." ;
        rdfs:subClassOf manch:Clause .

    manch:DataPropertyFrame rdfs:comment "DataProperty: <name>." ;
        rdfs:subClassOf manch:Frame .

    manch:DatatypeAnnotationsClause rdfs:comment "Datatype: Annotations: - same shape as ClassAnnotationsClause." ;
        rdfs:subClassOf manch:Clause .

    manch:DatatypeEquivalentToClause rdfs:comment "Datatype: EquivalentTo: - items' manch:value is a DataRange." ;
        rdfs:subClassOf manch:Clause .

    manch:DatatypeFrame rdfs:comment "Datatype: <name>." ;
        rdfs:subClassOf manch:Frame .

    manch:Exact rdfs:comment "`p exactly n` / `p exactly n C` - same shape as Min." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:IndividualAnnotationsClause rdfs:comment "Individual: Annotations: - same shape as ClassAnnotationsClause." ;
        rdfs:subClassOf manch:Clause .

    manch:IndividualDifferentFromClause rdfs:comment "DifferentFrom: - same item shape as IndividualSameAsClause." ;
        rdfs:subClassOf manch:Clause .

    manch:IndividualFactsClause rdfs:comment "Individual: Facts: - manch:items is an rdf:List of manch:FactItem (not plain ClauseItem - a fact is itself a (negative, property, value) triple, not a bare expression; see manch:FactItem)." ;
        rdfs:subClassOf manch:Clause .

    manch:IndividualFrame rdfs:comment "Individual: <name>." ;
        rdfs:subClassOf manch:Frame .

    manch:IndividualSameAsClause rdfs:comment "SameAs: - items' manch:value is a bare individual URIRef." ;
        rdfs:subClassOf manch:Clause .

    manch:IndividualTypesClause rdfs:comment "Individual: Types: - items' manch:value is a ClassExpression." ;
        rdfs:subClassOf manch:Clause .

    manch:Inverse rdfs:comment "`inverse p` - manch:operand, the wrapped property URIRef." ;
        rdfs:subClassOf manch:PropertyExpression .

    manch:Max rdfs:comment "`p max n` / `p max n C` - same shape as Min." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:Min rdfs:comment "`p min n` / `p min n C` (qualified) - manch:onProperty, manch:cardinality (an xsd:nonNegativeInteger Literal), manch:filler (a ClassExpression, absent for the unqualified form - same tag either way, per manchester_parser.py's own AST, not two separate constructs)." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:MiscDifferentIndividualsAxiom rdfs:comment "DifferentIndividuals: - same item shape as MiscSameIndividualAxiom." ;
        rdfs:subClassOf manch:MiscAxiom .

    manch:MiscDisjointClassesAxiom rdfs:comment "DisjointClasses: - same item shape as MiscEquivalentClassesAxiom." ;
        rdfs:subClassOf manch:MiscAxiom .

    manch:MiscDisjointPropertiesAxiom rdfs:comment "DisjointProperties: - same item shape as MiscEquivalentPropertiesAxiom." ;
        rdfs:subClassOf manch:MiscAxiom .

    manch:MiscEquivalentClassesAxiom rdfs:comment "EquivalentClasses: - manch:items an rdf:List of ClassExpression." ;
        rdfs:subClassOf manch:MiscAxiom .

    manch:MiscEquivalentPropertiesAxiom rdfs:comment "EquivalentProperties: - manch:items an rdf:List of PropertyExpression." ;
        rdfs:subClassOf manch:MiscAxiom .

    manch:MiscSameIndividualAxiom rdfs:comment "SameIndividual: - manch:items an rdf:List of bare individual URIRef." ;
        rdfs:subClassOf manch:MiscAxiom .

    manch:Not rdfs:comment "`not C` - manch:operand, a single ClassExpression." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:ObjPropAnnotationsClause rdfs:comment "ObjectProperty: Annotations: - same shape as ClassAnnotationsClause." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjPropCharacteristicsClause rdfs:comment "Characteristics: - items' manch:value is a URIRef (owl:FunctionalProperty etc, the resolved characteristic, not the bare keyword)." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjPropDisjointWithClause rdfs:comment "ObjectProperty: DisjointWith: - same item shape as ObjPropSubPropertyOfClause." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjPropDomainClause rdfs:comment "ObjectProperty: Domain: - items' manch:value is a ClassExpression." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjPropEquivalentToClause rdfs:comment "ObjectProperty: EquivalentTo: - same item shape as ObjPropSubPropertyOfClause." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjPropInverseOfClause rdfs:comment "InverseOf: (object property only) - same item shape as ObjPropSubPropertyOfClause." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjPropRangeClause rdfs:comment "ObjectProperty: Range: - items' manch:value is a ClassExpression (contrast DataPropRangeClause)." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjPropSubPropertyChainClause rdfs:comment "SubPropertyChain: (object property only) - single-axiom, manch:items holds exactly one ClauseItem whose manch:value is an rdf:List of PropertyExpression, in chain order (`p1 o p2 o p3`)." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjPropSubPropertyOfClause rdfs:comment "SubPropertyOf:/SuperPropertyOf: - items' manch:value is a PropertyExpression. See manch:reversed for how the two keywords are told apart." ;
        rdfs:subClassOf manch:Clause .

    manch:ObjectPropertyFrame rdfs:comment "ObjectProperty: <name>." ;
        rdfs:subClassOf manch:Frame .

    manch:Only rdfs:comment "`p only C` - same shape as Some." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:Or rdfs:comment "`C1 or C2 or ...` - manch:operands, same shape as And." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:PlainString a rdfs:Datatype ;
        rdfs:comment "Reserved datatype tag for a bare Python string that must round-trip distinctly from a genuine RDF string literal (rdflib.Literal('x') == 'x' is False, and the two hash differently) - used only for manch:prefixLabel, the one place this vocabulary carries a bare Python str rather than an already-real URIRef/Literal/int (cardinalities, facet literals, individual/data values, and Characteristics: values are all already real terms - see ontology/__init__.py's own module docstring)." .

    manch:SelfR rdfs:comment "`p Self` - manch:onProperty only." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:Some rdfs:comment "`p some C` - manch:onProperty (a PropertyExpression), manch:filler (a ClassExpression)." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:Value rdfs:comment "`p value v` - manch:onProperty, manch:filler (an individual URIRef or a data Literal - `value` accepts either)." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:annotationProperty a rdf:Property ;
        rdfs:comment "Domain safe: leaf class." ;
        rdfs:domain manch:AnnotationAssertion .

    manch:annotationValue a rdf:Property ;
        rdfs:comment "Domain safe: leaf class." ;
        rdfs:domain manch:AnnotationAssertion .

    manch:annotations a rdf:Property ;
        rdfs:comment "A ClauseItem's, FactItem's or OntologyHeader's own optional rdf:List of AnnotationAssertion - present only when an Annotations: was written there. No rdfs:domain: shared across leaf classes with no other common superclass." ;
        rdfs:range rdf:List .

    manch:cardinality a rdf:Property ;
        rdfs:comment "Min/Max/Exact's own xsd:nonNegativeInteger cardinality Literal. No rdfs:domain - three sibling leaf classes, kept undeclared for the same consistency reasoning as manch:onProperty." .

    manch:clauses a rdf:Property ;
        rdfs:comment "The frame's own rdf:List of Clause, in written order. Domain safe, same reasoning as manch:subject." ;
        rdfs:domain manch:Frame ;
        rdfs:range rdf:List .

    manch:facetPredicate a rdf:Property ;
        rdfs:comment "The facet's own xsd: URIRef (xsd:minInclusive etc). Domain safe: leaf class." ;
        rdfs:domain manch:FacetRestriction .

    manch:facetValue a rdf:Property ;
        rdfs:comment "The facet's own Literal value. Domain safe: leaf class." ;
        rdfs:domain manch:FacetRestriction .

    manch:facets a rdf:Property ;
        rdfs:comment "DRestriction's own rdf:List of FacetRestriction. Domain safe: leaf class." ;
        rdfs:domain manch:DRestriction ;
        rdfs:range rdf:List .

    manch:filler a rdf:Property ;
        rdfs:comment "Some/Only/Value/Min/Max/Exact's own filler (absent on Min/Max/Exact's unqualified form). No rdfs:domain: its own value is independently sh:class-dispatch-checked (a ClassExpression, or for Value a plain URIRef/Literal, not always dispatch-checked at all) - declaring range would risk pre-satisfying that check for the ClassExpression-valued uses." .

    manch:frames a rdf:Property ;
        rdfs:comment "Document's own rdf:List of Frame, in written order." ;
        rdfs:domain manch:Document ;
        rdfs:range rdf:List .

    manch:header a rdf:Property ;
        rdfs:comment "Document's own Ontology: header - range safe here: nothing dispatch-checks manch:OntologyHeader via sh:class (it's a leaf, no subclasses)." ;
        rdfs:domain manch:Document ;
        rdfs:range manch:OntologyHeader .

    manch:imports a rdf:Property ;
        rdfs:comment "The header's own rdf:List of Import: URIRef, in order." ;
        rdfs:domain manch:OntologyHeader ;
        rdfs:range rdf:List .

    manch:individuals a rdf:Property ;
        rdfs:comment "OneOf's own rdf:List of individual URIRef. Domain safe: manch:OneOf is a leaf ClassExpression subclass, not itself a dispatch superclass." ;
        rdfs:domain manch:OneOf ;
        rdfs:range rdf:List .

    manch:items a rdf:Property ;
        rdfs:comment "A Clause's or MiscAxiom's own rdf:List of items - member shape depends on the concrete (sub)class, see each one's own comment. No rdfs:domain: shared across manch:Clause and manch:MiscAxiom, two unrelated dispatch families." ;
        rdfs:range rdf:List .

    manch:literals a rdf:Property ;
        rdfs:comment "DOneOf's own rdf:List of Literal. Domain safe: leaf class." ;
        rdfs:domain manch:DOneOf ;
        rdfs:range rdf:List .

    manch:misc a rdf:Property ;
        rdfs:comment "Document's own rdf:List of MiscAxiom, in written order." ;
        rdfs:domain manch:Document ;
        rdfs:range rdf:List .

    manch:negative a rdf:Property ;
        rdfs:comment "Whether this is a negative fact (`not prop value`). Domain safe: leaf class." ;
        rdfs:domain manch:FactItem .

    manch:onDatatype a rdf:Property ;
        rdfs:comment "DRestriction's own base datatype URIRef. Domain safe: leaf class." ;
        rdfs:domain manch:DRestriction .

    manch:onProperty a rdf:Property ;
        rdfs:comment "Some/Only/Value/SelfR/Min/Max/Exact's own property expression. No rdfs:domain (shared across 7 sibling leaf classes, no other common superclass but manch:ClassExpression itself - declaring it would be technically harmless here since all 7 truly are ClassExpression subclasses, but left undeclared for consistency with manch:filler below, which cannot safely declare it)." .

    manch:ontologyIri a rdf:Property ;
        rdfs:comment "The optional Ontology: <iri> - absent for a bare `Ontology:` header." ;
        rdfs:domain manch:OntologyHeader .

    manch:operand a rdf:Property ;
        rdfs:comment "Not/DNot/Inverse's own single operand. No rdfs:domain - shared across three unrelated dispatch families (ClassExpression/DataRange/PropertyExpression), and its own value is independently sh:class-dispatch-checked depending on which clause it's reached through." .

    manch:operands a rdf:Property ;
        rdfs:comment "And/Or/DAnd/DOr's own rdf:List of >=2 operands. No rdfs:domain - shared across manch:ClassExpression and manch:DataRange subclasses, two unrelated dispatch families." ;
        rdfs:range rdf:List .

    manch:prefixIri a rdf:Property ;
        rdfs:comment "The declaration's own IRI text, as a plain string Literal (not a URIRef - this is the definition of the prefix mapping itself, not a reference resolved through it)." ;
        rdfs:domain manch:PrefixDecl .

    manch:prefixLabel a rdf:Property ;
        rdfs:comment "The bare prefix label ('' for the default prefix) - a manch:PlainString-tagged Literal, not a plain string literal (see manch:PlainString's own comment)." ;
        rdfs:domain manch:PrefixDecl .

    manch:prefixes a rdf:Property ;
        rdfs:comment "Document's own rdf:List of PrefixDecl, in written order." ;
        rdfs:domain manch:Document ;
        rdfs:range rdf:List .

    manch:property a rdf:Property ;
        rdfs:comment "The fact's own property URIRef. Domain safe: leaf class - manch:FactItem is the only class using this exact property name (deliberately distinct from manch:onProperty above, which is used elsewhere)." ;
        rdfs:domain manch:FactItem .

    manch:reversed a rdf:Property ;
        rdfs:comment "Present (true) only on a ClassSubClassOfClause/ObjPropSubPropertyOfClause/DataPropSubPropertyOfClause instance that was originally written as SuperClassOf:/SuperPropertyOf: rather than SubClassOf:/SubPropertyOf: - absent (not just false) otherwise. This is load-bearing, not spelling trivia: SuperClassOf:/SuperPropertyOf: compiles to the OPPOSITE rdfs:subClassOf/subPropertyOf triple direction from its Sub* counterpart (the frame's own subject ends up as the *object*, not the subject, of the relation), and manch:items alone can't distinguish the two cases (same item shape either way) - so without this flag, decoding a Super* clause and re-rendering it as Sub* would silently reverse the compiled OWL semantics. Domain safe: only ever asserted on a manch:Clause instance." ;
        rdfs:domain manch:Clause ;
        rdfs:range xsd:boolean .

    manch:subject a rdf:Property ;
        rdfs:comment "The frame's own name (class/property/individual/datatype URIRef). Domain safe: used consistently across every manch:Frame subclass, no other class anywhere reuses this property name." ;
        rdfs:domain manch:Frame .

    manch:value a rdf:Property ;
        rdfs:comment "A ClauseItem's own value - shape depends on the enclosing clause (a ClassExpression, PropertyExpression, DataRange, or bare URIRef/Literal). No rdfs:domain/range: deliberately polymorphic by design (see manch:ClauseItem's own comment), and several of its possible shapes are independently sh:class-dispatch-checked." .

    manch:versionIri a rdf:Property ;
        rdfs:comment "The optional version IRI that follows the ontology IRI in `Ontology: <iri> <versionIri>`." ;
        rdfs:domain manch:OntologyHeader .

    manch:DOneOf rdfs:comment "`{ lit1, lit2, ... }` - manch:literals, an rdf:List of Literal." ;
        rdfs:subClassOf manch:DataRange .

    manch:OneOf rdfs:comment "`{ ind1, ind2, ... }` - manch:individuals, an rdf:List of URIRef." ;
        rdfs:subClassOf manch:ClassExpression .

    manch:PropertyExpression rdfs:comment "A property-expression AST node - a plain property is a bare URIRef, no wrapper; manch:Inverse is the only wrapped form." .

    manch:DRestriction rdfs:comment "`datatype[facet lit, ...]` - manch:onDatatype (a URIRef), manch:facets (an rdf:List of manch:FacetRestriction)." ;
        rdfs:subClassOf manch:DataRange .

    manch:DataRange rdfs:comment "A data-range AST node (DataProperty: Range:, Datatype: EquivalentTo:) - an atomic datatype is a bare URIRef, no wrapper." .

    manch:MiscAxiom rdfs:comment "A top-level Misc axiom (no subject frame) - manch:items, an rdf:List whose member shape depends on the concrete axiom (see each subclass), and optionally manch:annotations: the axiom's own leading `Annotations:`, one list for the whole axiom (the note's misc production), never per item." .

    manch:Frame rdfs:comment "A top-level Manchester frame (Class:/ObjectProperty:/DataProperty:/AnnotationProperty:/Individual:/Datatype:) - manch:subject (the frame's own name), manch:clauses (an rdf:List of Clause, in written order)." .

    manch:ClassExpression rdfs:comment "An OWL class-expression AST node (manchester_parser.py's own And/Or/Not/OneOf/Some/Only/Value/SelfR/Min/Max/Exact tags) - an atomic class is a bare URIRef, no wrapper." .

    manch:Clause rdfs:comment "One clause body inside a frame - manch:items, an rdf:List whose member shape depends on the concrete clause type (see each subclass's own comment). SuperClassOf:/SuperPropertyOf: fold into the same clause class as their SubClassOf:/SubPropertyOf: counterpart (same manch:items shape either way) - but unlike other spelling variants, this pair is not cosmetic: it flips which side of the compiled rdfs:subClassOf/subPropertyOf triple the frame's own subject lands on, so the optional manch:reversed boolean (see its own comment) is what actually distinguishes the two on decode, not the keyword." .
}

starontology:manchester_shapes.ttl {
    manch:ShapesGraph a sh:ShapesGraph ;
        rdfs:member manch:AndShape,
            manch:AnnPropDomainClause,
            manch:AnnPropRangeClause,
            manch:AnnPropSubPropertyOfClause,
            manch:AnnotationAssertionListShape,
            manch:AnnotationAssertionShape,
            manch:ClassDisjointWithClause,
            manch:ClassEquivalentToClause,
            manch:ClassExpressionItemListShape,
            manch:ClassExpressionListShape,
            manch:ClassExpressionOrNameShape,
            manch:ClassExpressionShape,
            manch:ClassSubClassOfClause,
            manch:ClauseItemShape,
            manch:ClauseItemsShape,
            manch:ClauseListShape,
            manch:ClauseShape,
            manch:DAndShape,
            manch:DExactShape,
            manch:DMaxShape,
            manch:DMinShape,
            manch:DNotShape,
            manch:DOneOfShape,
            manch:DOnlyShape,
            manch:DOrShape,
            manch:DRestrictionShape,
            manch:DSomeShape,
            manch:DataPropCharacteristicsClause,
            manch:DataPropDisjointWithClause,
            manch:DataPropDomainClause,
            manch:DataPropEquivalentToClause,
            manch:DataPropRangeClause,
            manch:DataPropSubPropertyOfClause,
            manch:DataRangeItemListShape,
            manch:DataRangeListShape,
            manch:DataRangeOrNameShape,
            manch:DataRangeShape,
            manch:DatatypeEquivalentToClause,
            manch:DocumentShape,
            manch:ExactShape,
            manch:FacetRestrictionListShape,
            manch:FacetRestrictionShape,
            manch:FactItemShape,
            manch:FrameListShape,
            manch:FrameShape,
            manch:FrameShapeDetail,
            manch:IndividualDifferentFromClause,
            manch:IndividualSameAsClause,
            manch:IndividualTypesClause,
            manch:InverseShape,
            manch:IriListShape,
            manch:LiteralListShape,
            manch:MaxShape,
            manch:MinShape,
            manch:MiscAxiomItemsShape,
            manch:MiscAxiomListShape,
            manch:MiscAxiomShape,
            manch:MiscDifferentIndividualsAxiom,
            manch:MiscDisjointClassesAxiom,
            manch:MiscDisjointPropertiesAxiom,
            manch:MiscEquivalentClassesAxiom,
            manch:MiscEquivalentPropertiesAxiom,
            manch:MiscSameIndividualAxiom,
            manch:NameItemListShape,
            manch:NameListShape,
            manch:NotShape,
            manch:ObjPropCharacteristicsClause,
            manch:ObjPropDisjointWithClause,
            manch:ObjPropDomainClause,
            manch:ObjPropEquivalentToClause,
            manch:ObjPropInverseOfClause,
            manch:ObjPropRangeClause,
            manch:ObjPropSubPropertyOfClause,
            manch:OneOfShape,
            manch:OnlyShape,
            manch:OntologyHeaderShape,
            manch:OrShape,
            manch:PrefixDeclListShape,
            manch:PrefixDeclShape,
            manch:PropertyExpressionItemListShape,
            manch:PropertyExpressionListShape,
            manch:PropertyExpressionOrNameShape,
            manch:PropertyExpressionShape,
            manch:SelfRShape,
            manch:SomeShape,
            manch:ValueClauseShape,
            manch:ValueShape,
            manch:WellFormedListShape .

    manch:AndShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ClassExpressionListShape ;
                sh:path manch:operands ] ;
        sh:targetClass manch:And .

    manch:AnnotationAssertionShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ValueShape ;
                sh:path manch:annotationValue ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path manch:annotationProperty ],
            [ sh:maxCount 1 ;
                sh:node manch:AnnotationAssertionListShape ;
                sh:path manch:annotations ] ;
        sh:targetClass manch:AnnotationAssertion .

    manch:ClauseItemShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:value ],
            [ sh:maxCount 1 ;
                sh:node manch:AnnotationAssertionListShape ;
                sh:path manch:annotations ] ;
        sh:targetClass manch:ClauseItem .

    manch:ClauseItemsShape a sh:NodeShape ;
        sh:property [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:path manch:reversed ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:WellFormedListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:Clause .

    manch:ClauseShape a sh:NodeShape ;
        sh:class manch:Clause ;
        sh:message "expected a recognized clause type" .

    manch:DAndShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:DataRangeListShape ;
                sh:path manch:operands ] ;
        sh:targetClass manch:DAnd .

    manch:DExactShape a sh:NodeShape ;
        sh:property [ sh:datatype xsd:nonNegativeInteger ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:cardinality ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:DataRangeOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:DExact .

    manch:DMaxShape a sh:NodeShape ;
        sh:property [ sh:datatype xsd:nonNegativeInteger ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:cardinality ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:DataRangeOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:DMax .

    manch:DMinShape a sh:NodeShape ;
        sh:property [ sh:datatype xsd:nonNegativeInteger ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:cardinality ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:DataRangeOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:DMin .

    manch:DNotShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:DataRangeOrNameShape ;
                sh:path manch:operand ] ;
        sh:targetClass manch:DNot .

    manch:DOneOfShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:LiteralListShape ;
                sh:path manch:literals ] ;
        sh:targetClass manch:DOneOf .

    manch:DOnlyShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:DataRangeOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:DOnly .

    manch:DOrShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:DataRangeListShape ;
                sh:path manch:operands ] ;
        sh:targetClass manch:DOr .

    manch:DRestrictionShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path manch:onDatatype ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:FacetRestrictionListShape ;
                sh:path manch:facets ] ;
        sh:targetClass manch:DRestriction .

    manch:DSomeShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:DataRangeOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:DSome .

    manch:DocumentShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PrefixDeclListShape ;
                sh:path manch:prefixes ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:FrameListShape ;
                sh:path manch:frames ],
            [ sh:class manch:OntologyHeader ;
                sh:maxCount 1 ;
                sh:path manch:header ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:MiscAxiomListShape ;
                sh:path manch:misc ] ;
        sh:targetClass manch:Document .

    manch:ExactShape a sh:NodeShape ;
        sh:property [ sh:datatype xsd:nonNegativeInteger ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:cardinality ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ],
            [ sh:maxCount 1 ;
                sh:node manch:ClassExpressionOrNameShape ;
                sh:path manch:filler ] ;
        sh:targetClass manch:Exact .

    manch:FacetRestrictionShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path manch:facetPredicate ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:path manch:facetValue ] ;
        sh:targetClass manch:FacetRestriction .

    manch:FactItemShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ValueShape ;
                sh:path manch:value ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:negative ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path manch:property ],
            [ sh:maxCount 1 ;
                sh:node manch:AnnotationAssertionListShape ;
                sh:path manch:annotations ] ;
        sh:targetClass manch:FactItem .

    manch:FrameShape a sh:NodeShape ;
        sh:class manch:Frame ;
        sh:message "expected a recognized frame type" .

    manch:FrameShapeDetail a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path manch:subject ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ClauseListShape ;
                sh:path manch:clauses ] ;
        sh:targetClass manch:Frame .

    manch:InverseShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path manch:operand ] ;
        sh:targetClass manch:Inverse .

    manch:MaxShape a sh:NodeShape ;
        sh:property [ sh:datatype xsd:nonNegativeInteger ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:cardinality ],
            [ sh:maxCount 1 ;
                sh:node manch:ClassExpressionOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:Max .

    manch:MinShape a sh:NodeShape ;
        sh:property [ sh:datatype xsd:nonNegativeInteger ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:cardinality ],
            [ sh:maxCount 1 ;
                sh:node manch:ClassExpressionOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:Min .

    manch:MiscAxiomItemsShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:WellFormedListShape ;
                sh:path manch:items ],
            [ sh:maxCount 1 ;
                sh:node manch:AnnotationAssertionListShape ;
                sh:path manch:annotations ] ;
        sh:targetClass manch:MiscAxiom .

    manch:MiscAxiomShape a sh:NodeShape ;
        sh:class manch:MiscAxiom ;
        sh:message "expected a recognized Misc-axiom type" .

    manch:NotShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ClassExpressionOrNameShape ;
                sh:path manch:operand ] ;
        sh:targetClass manch:Not .

    manch:OneOfShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:IriListShape ;
                sh:path manch:individuals ] ;
        sh:targetClass manch:OneOf .

    manch:OnlyShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ClassExpressionOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:Only .

    manch:OntologyHeaderShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:node manch:IriListShape ;
                sh:path manch:imports ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path manch:ontologyIri ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path manch:versionIri ],
            [ sh:maxCount 1 ;
                sh:node manch:AnnotationAssertionListShape ;
                sh:path manch:annotations ] ;
        sh:targetClass manch:OntologyHeader .

    manch:OrShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ClassExpressionListShape ;
                sh:path manch:operands ] ;
        sh:targetClass manch:Or .

    manch:PrefixDeclShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:path manch:prefixIri ],
            [ sh:datatype manch:PlainString ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path manch:prefixLabel ] ;
        sh:targetClass manch:PrefixDecl .

    manch:SelfRShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:SelfR .

    manch:SomeShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ClassExpressionOrNameShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:Some .

    manch:ValueClauseShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:ValueShape ;
                sh:path manch:filler ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node manch:PropertyExpressionOrNameShape ;
                sh:path manch:onProperty ] ;
        sh:targetClass manch:Value .

    manch:AnnPropDomainClause a sh:NodeShape ;
        sh:property [ sh:node manch:NameItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:AnnPropDomainClause .

    manch:AnnPropRangeClause a sh:NodeShape ;
        sh:property [ sh:node manch:NameItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:AnnPropRangeClause .

    manch:AnnPropSubPropertyOfClause a sh:NodeShape ;
        sh:property [ sh:node manch:NameItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:AnnPropSubPropertyOfClause .

    manch:ClassDisjointWithClause a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ClassDisjointWithClause .

    manch:ClassEquivalentToClause a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ClassEquivalentToClause .

    manch:ClassExpressionShape a sh:NodeShape ;
        sh:class manch:ClassExpression ;
        sh:message "expected a recognized class-expression tag (see manch:ClassExpression in manchester-ast-ontology.ttl)" .

    manch:ClassSubClassOfClause a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ClassSubClassOfClause .

    manch:ClauseListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of Clause" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                { FILTER ( $this != rdf:nil ) FILTER NOT EXISTS { $this rdf:first ?head } }
                UNION
                {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a manch:Clause }
                }
            }
        """ ] .

    manch:DataPropCharacteristicsClause a sh:NodeShape ;
        sh:property [ sh:node manch:NameItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:DataPropCharacteristicsClause .

    manch:DataPropDisjointWithClause a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:DataPropDisjointWithClause .

    manch:DataPropDomainClause a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:DataPropDomainClause .

    manch:DataPropEquivalentToClause a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:DataPropEquivalentToClause .

    manch:DataPropRangeClause a sh:NodeShape ;
        sh:property [ sh:node manch:DataRangeItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:DataPropRangeClause .

    manch:DataPropSubPropertyOfClause a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:DataPropSubPropertyOfClause .

    manch:DataRangeShape a sh:NodeShape ;
        sh:class manch:DataRange ;
        sh:message "expected a recognized data-range tag" .

    manch:DatatypeEquivalentToClause a sh:NodeShape ;
        sh:property [ sh:node manch:DataRangeItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:DatatypeEquivalentToClause .

    manch:FacetRestrictionListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected an rdf:List of FacetRestriction" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                FILTER NOT EXISTS { ?item a manch:FacetRestriction }
            }
        """ ] .

    manch:FrameListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of Frame" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                { FILTER ( $this != rdf:nil ) FILTER NOT EXISTS { $this rdf:first ?head } }
                UNION
                {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a manch:Frame }
                }
            }
        """ ] .

    manch:IndividualDifferentFromClause a sh:NodeShape ;
        sh:property [ sh:node manch:NameItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:IndividualDifferentFromClause .

    manch:IndividualSameAsClause a sh:NodeShape ;
        sh:property [ sh:node manch:NameItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:IndividualSameAsClause .

    manch:IndividualTypesClause a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:IndividualTypesClause .

    manch:LiteralListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected an rdf:List of literals" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                FILTER ( !isLiteral(?item) )
            }
        """ ] .

    manch:MiscAxiomListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of MiscAxiom" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                { FILTER ( $this != rdf:nil ) FILTER NOT EXISTS { $this rdf:first ?head } }
                UNION
                {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a manch:MiscAxiom }
                }
            }
        """ ] .

    manch:MiscDifferentIndividualsAxiom a sh:NodeShape ;
        sh:property [ sh:node manch:NameListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:MiscDifferentIndividualsAxiom .

    manch:MiscDisjointClassesAxiom a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:MiscDisjointClassesAxiom .

    manch:MiscDisjointPropertiesAxiom a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:MiscDisjointPropertiesAxiom .

    manch:MiscEquivalentClassesAxiom a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:MiscEquivalentClassesAxiom .

    manch:MiscEquivalentPropertiesAxiom a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:MiscEquivalentPropertiesAxiom .

    manch:MiscSameIndividualAxiom a sh:NodeShape ;
        sh:property [ sh:node manch:NameListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:MiscSameIndividualAxiom .

    manch:ObjPropCharacteristicsClause a sh:NodeShape ;
        sh:property [ sh:node manch:NameItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ObjPropCharacteristicsClause .

    manch:ObjPropDisjointWithClause a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ObjPropDisjointWithClause .

    manch:ObjPropDomainClause a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ObjPropDomainClause .

    manch:ObjPropEquivalentToClause a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ObjPropEquivalentToClause .

    manch:ObjPropInverseOfClause a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ObjPropInverseOfClause .

    manch:ObjPropRangeClause a sh:NodeShape ;
        sh:property [ sh:node manch:ClassExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ObjPropRangeClause .

    manch:ObjPropSubPropertyOfClause a sh:NodeShape ;
        sh:property [ sh:node manch:PropertyExpressionItemListShape ;
                sh:path manch:items ] ;
        sh:targetClass manch:ObjPropSubPropertyOfClause .

    manch:PrefixDeclListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected an rdf:List of PrefixDecl" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                FILTER NOT EXISTS { ?item a manch:PrefixDecl }
            }
        """ ] .

    manch:PropertyExpressionShape a sh:NodeShape ;
        sh:class manch:PropertyExpression ;
        sh:message "expected a recognized property-expression tag" .

    manch:DataRangeItemListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of ClauseItem whose value is a data range" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                ?item manch:value ?v .
                FILTER NOT EXISTS { ?v a manch:DataRange }
                FILTER ( !isIRI(?v) )
            }
        """ ] .

    manch:DataRangeListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of data ranges" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                { FILTER ( $this != rdf:nil ) FILTER NOT EXISTS { $this rdf:first ?head } }
                UNION
                {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a manch:DataRange }
                    FILTER ( !isIRI(?item) )
                }
            }
        """ ] .

    manch:IriListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected an rdf:List of IRIs" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                FILTER ( !isIRI(?item) )
            }
        """ ] .

    manch:NameListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of bare IRIs" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                FILTER ( !isIRI(?item) )
            }
        """ ] .

    manch:PropertyExpressionListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of property expressions" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                { FILTER ( $this != rdf:nil ) FILTER NOT EXISTS { $this rdf:first ?head } }
                UNION
                {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a manch:PropertyExpression }
                    FILTER ( !isIRI(?item) )
                }
            }
        """ ] .

    manch:ValueShape a sh:NodeShape ;
        sh:message "a bare individual/data value must be an IRI or Literal" ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:Literal ] ) .

    manch:ClassExpressionListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of class expressions" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                { FILTER ( $this != rdf:nil ) FILTER NOT EXISTS { $this rdf:first ?head } }
                UNION
                {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a manch:ClassExpression }
                    FILTER ( !isIRI(?item) )
                }
            }
        """ ] .

    manch:AnnotationAssertionListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of AnnotationAssertion" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                { FILTER ( $this != rdf:nil ) FILTER NOT EXISTS { $this rdf:first ?head } }
                UNION
                {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a manch:AnnotationAssertion }
                }
            }
        """ ] .

    manch:ClassExpressionOrNameShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] manch:ClassExpressionShape ) .

    manch:DataRangeOrNameShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] manch:DataRangeShape ) .

    manch:ClassExpressionItemListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of ClauseItem whose value is a class expression" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                ?item manch:value ?v .
                FILTER NOT EXISTS { ?v a manch:ClassExpression }
                FILTER ( !isIRI(?v) )
            }
        """ ] .

    manch:NameItemListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of ClauseItem whose value is a bare IRI" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                ?item manch:value ?v .
                FILTER ( !isIRI(?v) )
            }
        """ ] .

    manch:PropertyExpressionItemListShape a sh:NodeShape ;
        sh:node manch:WellFormedListShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of ClauseItem whose value is a property expression" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#>
            SELECT $this
            WHERE {
                $this rdf:rest*/rdf:first ?item .
                ?item manch:value ?v .
                FILTER NOT EXISTS { ?v a manch:PropertyExpression }
                FILTER ( !isIRI(?v) )
            }
        """ ] .

    manch:PropertyExpressionOrNameShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] manch:PropertyExpressionShape ) .

    manch:WellFormedListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List (every cell has rdf:first, and the chain ends in rdf:nil without a cycle)" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                $this rdf:rest* ?cell .
                FILTER ( ?cell != rdf:nil )
                FILTER ( NOT EXISTS { ?cell rdf:first ?x } || NOT EXISTS { ?cell rdf:rest* rdf:nil } )
            }
        """ ] .
}

starontology:salg-ontology.ttl {
    salg:Binding a rdfs:Class ;
        rdfs:comment "One (variable, value) pair inside a VALUES row." .

    salg:DatasetClause a rdfs:Class ;
        rdfs:comment "One FROM/FROM NAMED clause - exactly one of salg:default (FROM) or salg:named (FROM NAMED), each an IRI." .

    salg:OrderCondition a rdfs:Class ;
        rdfs:comment "One ORDER BY expr, ASC or DESC." .

    salg:QuadsForGraph a rdfs:Class ;
        rdfs:comment "One graph-qualified {graph, triples} entry inside an Update operation's salg:quads list." .

    salg:QueryCollection a rdfs:Class ;
        rdfs:comment "A collection of independent salg:Query roots, linked via salg:queries." .

    salg:Update a rdfs:Class ;
        rdfs:comment "The root of one encoded SPARQL Update request - salg:operations holds its ordered operations." .

    salg:values a rdfs:Class ;
        rdfs:comment "An inline VALUES clause - a list of Binding rows." .

    salg:A a rdf:Property ;
        rdfs:comment "AggregateJoin's own list of salg:Aggregate computations. Domain safe: salg:AggregateJoin is a leaf GraphPattern subclass, not a dispatch superclass." ;
        rdfs:domain salg:AggregateJoin ;
        rdfs:range rdf:List .

    salg:Add rdfs:comment "ADD [SILENT] <source> TO <dest> - salg:graph a plain 2-element rdf:List [source, dest], each a real graph term or a bare DEFAULT keyword." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:Aggregate_Avg rdfs:comment "AVG(...) - same shape as Aggregate_Count." ;
        rdfs:subClassOf salg:Aggregate .

    salg:Aggregate_Count rdfs:comment "COUNT(...) - salg:distinct/salg:vars/salg:res." ;
        rdfs:subClassOf salg:Aggregate .

    salg:Aggregate_GroupConcat rdfs:comment "GROUP_CONCAT(...; SEPARATOR=...) - salg:distinct/salg:vars/salg:res plus salg:separator (optional, defaults to a single space per the SPARQL spec when omitted)." ;
        rdfs:subClassOf salg:Aggregate .

    salg:Aggregate_Max rdfs:comment "MAX(...) - same shape as Aggregate_Count." ;
        rdfs:subClassOf salg:Aggregate .

    salg:Aggregate_Min rdfs:comment "MIN(...) - same shape as Aggregate_Count." ;
        rdfs:subClassOf salg:Aggregate .

    salg:Aggregate_Sample rdfs:comment "SAMPLE(...) - salg:vars/salg:res only, no salg:distinct (confirmed empirically: SAMPLE's own CompValue has no distinct key at all, unlike every other aggregate here)." ;
        rdfs:subClassOf salg:Aggregate .

    salg:Aggregate_Sum rdfs:comment "SUM(...) - same shape as Aggregate_Count." ;
        rdfs:subClassOf salg:Aggregate .

    salg:AskQuery rdfs:comment "An ASK query's root - salg:p the WHERE-clause pattern; no projected variables." ;
        rdfs:subClassOf salg:Query .

    salg:BGP rdfs:comment "A basic graph pattern - an ordered list of triple patterns." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:Clear rdfs:comment "CLEAR [SILENT] (GRAPH <g> | DEFAULT | NAMED | ALL) - salg:graphiri a real graph term or a bare DEFAULT/NAMED/ALL keyword (spexpr:PlainString-tagged, see vocab.py)." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:Copy rdfs:comment "COPY - same salg:graph shape as Add/Move." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:Create rdfs:comment "CREATE - same salg:graphiri shape as Clear/Drop." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:DeleteClause rdfs:comment "Modify's own DELETE template - {triples, quads}, same shape as InsertData/DeleteData, but template position (values may be Variables bound by .where), not pattern position." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:DeleteData rdfs:comment "DELETE DATA { ... } - always ground, same reason as InsertData." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:DeleteWhere rdfs:comment "DELETE WHERE { ... } - its own triples/quads serve as both the match pattern and the delete template." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:DescribeQuery rdfs:comment "A DESCRIBE query's root - salg:PV the described variables/IRIs, salg:p the (possibly trivial) WHERE-clause pattern." ;
        rdfs:subClassOf salg:Query .

    salg:Distinct rdfs:comment "SELECT DISTINCT." ;
        rdfs:subClassOf salg:SubSelect .

    salg:Drop rdfs:comment "DROP - same salg:graphiri shape as Clear." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:Extend rdfs:comment "BIND(expr AS ?var)." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:Filter rdfs:comment "FILTER(expr) applied to a nested pattern." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:Graph rdfs:comment "GRAPH ?g { ... } / GRAPH <iri> { ... } - salg:term the graph IRI/Variable, salg:p the wrapped pattern (a real translated pattern, unlike salg:ServiceGraphPattern's own raw salg:graph fragment). Confirmed via translateQuery: Graph{term, p}. Found missing entirely 2026-08-15 - see salg:term's own rdfs:domain comment below for the RDFS-inference collision this omission caused with salg:ServiceGraphPattern." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:Group rdfs:comment "GROUP BY's own wrapper around the WHERE-clause pattern - salg:p the wrapped pattern, salg:expr the (possibly empty) list of grouping-key expressions. Confirmed via translateQuery: Group{p, expr} where expr is a plain list of Variables/expressions, not an rdf:List-shaped CompValue key." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:InsertClause rdfs:comment "Modify's own INSERT template - same shape and template-position semantics as DeleteClause." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:InsertData rdfs:comment "INSERT DATA { ... } - always ground (SPARQL's QuadData grammar forbids variables here)." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:Join rdfs:comment "Ordinary conjunction of two patterns." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:LeftJoin rdfs:comment "OPTIONAL { }." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:Load rdfs:comment "LOAD <iri> [INTO GRAPH <g>] - salg:iri the IRI to load from." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:Minus rdfs:comment "{ } MINUS { } - salg:p1/salg:p2, same shape as LeftJoin minus its salg:expr (confirmed via translateQuery: Minus{p1, p2})." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:Move rdfs:comment "MOVE - same salg:graph shape as Add." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:OrderBy rdfs:comment "ORDER BY, wrapping the WHERE-clause pattern being ordered." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:PV a rdf:Property ;
        rdfs:comment "The projected-variables list (a well-formed rdf:List of Variable-typed Literals) - used by Project, SelectQuery, AskQuery, and DescribeQuery, which share no other superclass but salg:Query itself; no rdfs:domain declared (see module docstring on why multiple rdfs:domain triples on one property are not used - RDFS domain entailment is per-triple, not a union, so declaring several here would falsely cross-type every node using this property - confirmed as a real, live bug via validate()'s own RDFS reasoning once actually enabled, not just a theoretical concern)." .

    salg:Project rdfs:comment "The projected-variable-list wrapper around a WHERE-clause pattern." ;
        rdfs:subClassOf salg:SubSelect .

    salg:Reduced rdfs:comment "SELECT REDUCED." ;
        rdfs:subClassOf salg:SubSelect .

    salg:SelectQuery rdfs:comment "A SELECT query's root." ;
        rdfs:subClassOf salg:Query .

    salg:Slice rdfs:comment "LIMIT/OFFSET." ;
        rdfs:subClassOf salg:SubSelect .

    salg:ToMultiSet rdfs:comment "Wraps an inline VALUES clause or a subquery." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:TriplePattern rdfs:comment "One (s, p, o) slot inside a BGP." ;
        rdfs:subClassOf salg:TripleSlot .

    salg:TripleTerm rdfs:comment "A SPARQL 1.2 <<( s p o )>>/TRIPLE(s, p, o) triple term." ;
        rdfs:subClassOf salg:TripleSlot .

    salg:Union rdfs:comment "{ } UNION { }." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:arg a rdf:Property ;
        rdfs:comment "OneArg/OptionalOneArg's sole argument, or VariadicArg's argument list - always an Expression. Also reused, same key name, for InvPath's own wrapped path/IRI (rdflib's InvPath constructor argument is itself literally named 'arg') - a Path, not an Expression, but this project's generic key-name-based encoding doesn't distinguish the two uses. No rdfs:domain declared, same reasoning as salg:p1 above (would let entailment pre-satisfy ExpressionShape's own sh:class check, and now also risks the same for a future PathShape)." ;
        rdfs:subPropertyOf salg:operand .

    salg:arg1 a rdf:Property ;
        rdfs:comment "TwoArg/ThreeArg's first argument - no rdfs:domain declared, same reasoning as salg:arg." ;
        rdfs:subPropertyOf salg:operand .

    salg:arg2 a rdf:Property ;
        rdfs:comment "TwoArg/ThreeArg's second argument - no rdfs:domain declared, same reasoning as salg:arg." ;
        rdfs:subPropertyOf salg:operand .

    salg:arg3 a rdf:Property ;
        rdfs:comment "ThreeArg's third argument (IF() only) - no rdfs:domain declared: ThreeArgExpression is itself rdfs:subClassOf salg:Expression, so declaring it here would transitively entail salg:Expression too, the same defeats-validation risk as salg:arg above, just one subclass hop away." ;
        rdfs:subPropertyOf salg:operand .

    salg:args a rdf:Property ;
        rdfs:comment "SequencePath/AlternativePath/NegatedPath's own well-formed rdf:List of member paths/IRIs. No rdfs:domain declared: salg:Path is a dispatch-style superclass (parallel to salg:GraphPattern/salg:Expression/salg:Aggregate) - same defeats-a-future-dispatch-shape reasoning as salg:vars above." ;
        rdfs:range rdf:List .

    salg:datasetClause a rdf:Property ;
        rdfs:comment "FROM/FROM NAMED - shared by all four query forms (SelectQuery/ConstructQuery/AskQuery/DescribeQuery), which share no other superclass but salg:Query itself; no rdfs:domain declared, same reasoning as salg:PV above (multiple rdfs:domain triples would falsely cross-type them once RDFS reasoning runs)." .

    salg:delete a rdf:Property ;
        rdfs:comment "Modify's own DELETE clause (a salg:DeleteClause), absent for an INSERT-only Modify. Domain safe: salg:Modify is a leaf UpdateOperation subclass, not itself a dispatch superclass." ;
        rdfs:domain salg:Modify .

    salg:distinct a rdf:Property ;
        rdfs:comment "Whether DISTINCT was specified - FunctionExpression's own call, or (all Aggregate subclasses except Aggregate_Sample, confirmed empirically) an aggregate's own DISTINCT modifier. No rdfs:domain declared, same reasoning as salg:iri - shared across salg:Expression and salg:Aggregate, both dispatch-adjacent classes." .

    salg:expr a rdf:Property ;
        rdfs:comment "Filter/LeftJoin/Extend/OrderCondition's governing expression, or Unary/Relational/Conditional's own operand - no domain (also genuinely heterogeneous - see module docstring's original note - as well as risking the same entailment problem for its Expression-typed uses)." ;
        rdfs:subPropertyOf salg:operand .

    salg:flags a rdf:Property ;
        rdfs:comment "Optional flags string on REGEX/REPLACE. No rdfs:domain declared - both the salg:PV/salg:var reason above (RegexExpression and ReplaceExpression share no other superclass) and the salg:arg reason (both are salg:Expression subclasses)." .

    salg:graph a rdf:Property ;
        rdfs:comment "Three unrelated uses of the same key name (this project's generic key-name-based encoding): on Builtin_EXISTS/NOTEXISTS and ServiceGraphPattern, EXISTS/NOT EXISTS/SERVICE's own raw, untranslated group-graph-pattern fragment - see shapes.py's own scoping note; on Add/Move/Copy, a plain 2-element rdf:List [source, dest] of graph references; on QuadsForGraph, the single graph term one quads-group is qualified by. No rdfs:domain declared: ExistsExpression/ServiceGraphPattern is rdfs:subClassOf salg:Expression/salg:GraphPattern respectively, so declaring it here would risk the same defeats-dispatch-shape-validation problem noted on salg:arg above - and the property is shared across unrelated classes regardless." .

    salg:graphiri a rdf:Property ;
        rdfs:comment "Clear/Drop/Create's own graph reference - a real graph term, or a bare DEFAULT/NAMED/ALL keyword (spexpr:PlainString-tagged, see vocab.py's 'Bare Python strings' section). No rdfs:domain declared - shared by three otherwise-unrelated classes." .

    salg:insert a rdf:Property ;
        rdfs:comment "Modify's own INSERT clause (a salg:InsertClause), absent for a DELETE-only Modify. Domain safe, same reasoning as salg:delete." ;
        rdfs:domain salg:Modify .

    salg:iri a rdf:Property ;
        rdfs:comment "The called function's own IRI (FunctionExpression), or Load's own source IRI (salg:Load) - always a plain IRI term either way. No rdfs:domain declared: FunctionExpression is a salg:Expression subclass (same reasoning as salg:graph above), and the property is shared with the unrelated salg:Load regardless." .

    salg:length a rdf:Property ;
        rdfs:comment "No rdfs:domain declared, same reasoning as salg:start." .

    salg:mod a rdf:Property ;
        rdfs:comment "MulPath's own bare \"*\"/\"+\"/\"?\" repetition-modifier string - a plain literal, not spexpr:PlainString-tagged (see salg:MulPath's own comment above for why; corrected 2026-08-16, this comment previously claimed PlainString-tagging incorrectly). No rdfs:domain declared, same reasoning as salg:args." .

    salg:object a rdf:Property ;
        rdfs:comment "No range declared - any RDF term, Variable, or TripleTerm." ;
        rdfs:domain salg:TripleSlot .

    salg:op a rdf:Property ;
        rdfs:comment "RelationalExpression's comparison operator, or Additive/MultiplicativeExpression's operator list - always a bare string/list of strings, never a salg: class instance. No rdfs:domain declared, same reasoning as salg:arg above." .

    salg:operations a rdf:Property ;
        rdfs:comment "A well-formed rdf:List of the request's own salg:UpdateOperation nodes, in execution order - domain safe here (salg:Update is a leaf container class, not a dispatch superclass anything else would need to avoid pre-satisfying), same pattern as salg:queries/salg:QueryCollection." ;
        rdfs:domain salg:Update ;
        rdfs:range rdf:List .

    salg:order a rdf:Property ;
        rdfs:comment "ASC/DESC - absent means ASC." ;
        rdfs:domain salg:OrderCondition .

    salg:other a rdf:Property ;
        rdfs:comment "RelationalExpression's right operand (or IN/NOT IN's list); Conditional/ArithmeticExpression's further operands. No rdfs:domain declared, same reasoning as salg:arg above." .

    salg:p a rdf:Property ;
        rdfs:comment "The single adjacent pattern (Filter/Extend/OrderBy/Project: a GraphPattern; SelectQuery/Slice/Distinct/Reduced: a SubSelect; ToMultiSet: values or a SubSelect) - no domain/range, see module docstring's note on dispatch classes." ;
        rdfs:subPropertyOf salg:pattern .

    salg:p1 a rdf:Property ;
        rdfs:comment "LeftJoin/Union/Join's left operand - always a GraphPattern, but no rdfs:domain/range declared here: see module docstring's note on dispatch classes (declaring either would let RDFS range/domain entailment silently pre-satisfy GraphPatternShape's own sh:class check for any value, defeating exactly the validation it exists to do - confirmed as a real, live bug via a negative test that stopped correctly failing once this was declared)." ;
        rdfs:subPropertyOf salg:pattern .

    salg:p2 a rdf:Property ;
        rdfs:comment "LeftJoin/Union/Join's right operand - same reasoning as salg:p1." ;
        rdfs:subPropertyOf salg:pattern .

    salg:path a rdf:Property ;
        rdfs:comment "MulPath's own repeated path/IRI. No rdfs:domain declared, same reasoning as salg:args (salg:Path is dispatch-style)." .

    salg:predicate a rdf:Property ;
        rdfs:comment "No range declared - always an IRI or Variable, never a salg: class instance." ;
        rdfs:domain salg:TripleSlot .

    salg:quads a rdf:Property ;
        rdfs:comment "A well-formed rdf:List of salg:QuadsForGraph nodes (graph-qualified triples, e.g. INSERT DATA { GRAPH <g> {...} }) - shared by InsertData/DeleteData/DeleteWhere/DeleteClause/InsertClause, five otherwise-unrelated-by-any-other-superclass classes, so no rdfs:domain declared (same multi-class-sharing reasoning as salg:triples above, which this property directly parallels - see vocab.py's own 'Update quads-by-graph maps' section)." ;
        rdfs:range rdf:List .

    salg:queries a rdf:Property ;
        rdfs:comment "A well-formed rdf:List of the collection's member salg:Query roots. rdfs:range rdf:List only (not salg:Query - see salg:triples' own comment above for why a list-valued property's range types the list node itself, never its individual members)." ;
        rdfs:domain salg:QueryCollection ;
        rdfs:range rdf:List .

    salg:replacement a rdf:Property ;
        rdfs:comment "No rdfs:domain declared, same reasoning as salg:text." .

    salg:res a rdf:Property ;
        rdfs:comment "On salg:values: a well-formed rdf:List of VALUES rows, each itself a well-formed rdf:List of salg:Binding. On a salg:Aggregate: the aggregate's own output Variable - an unrelated meaning, same key name, per this project's generic key-name-based encoding. Previously rdfs:domain salg:values; removed once salg:Aggregate started reusing this key too - two rdfs:domain triples on one property entail *both* simultaneously, which would falsely cross-type every Aggregate_* node as salg:values as well (the exact class of bug salg:PV/salg:var's own comments already document; res just wasn't sharing a class yet when originally declared)." .

    salg:service_string a rdf:Property ;
        rdfs:comment "The original SERVICE clause's own source text, as rdflib's algebra keeps it verbatim (used internally for re-parsing at evaluation time) - informational only, not itself further structured. Domain still safe as of 2026-08-15: confirmed via the same empirical CompValue-key sweep that found salg:term's collision that no other node type uses this key." ;
        rdfs:domain salg:ServiceGraphPattern .

    salg:silent a rdf:Property ;
        rdfs:comment "The optional SILENT modifier (Clear/Drop/Create/Add/Move/Copy/Load, and separately ServiceGraphPattern's own SERVICE SILENT) - a bare Python string when present (\"SILENT\", spexpr:PlainString-tagged), absent otherwise. No rdfs:domain declared - shared across many otherwise-unrelated classes." .

    salg:start a rdf:Property ;
        rdfs:comment "No rdfs:domain declared, same reasoning as salg:text (SubstrExpression is a salg:Expression subclass)." .

    salg:subject a rdf:Property ;
        rdfs:comment "No range declared - can be an IRI, blank node, Variable, or (object position only elsewhere) TripleTerm." ;
        rdfs:domain salg:TripleSlot .

    salg:template a rdf:Property ;
        rdfs:comment "A CONSTRUCT query's own template - a well-formed rdf:List of salg:TriplePattern, same shape as salg:BGP's salg:triples but a distinct property (a template is not itself a BGP)." ;
        rdfs:domain salg:ConstructQuery .

    salg:term a rdf:Property ;
        rdfs:comment "SERVICE's own endpoint (an IRI, or a Variable for SERVICE ?g {...}), or - an unrelated meaning, same key name, per this project's generic key-name-based encoding - salg:Graph's own GRAPH ?g {...} graph term. Previously rdfs:domain salg:ServiceGraphPattern (\"domain safe\" reasoning at the time: ServiceGraphPattern is a leaf GraphPattern subclass, not a dispatch superclass); removed 2026-08-15 once salg:Graph started reusing this key too - confirmed as a real, live bug the same way salg:val/salg:PV's own comments document (a Graph node's own rdf:type got falsely entailed salg:ServiceGraphPattern as well, then failed ServiceGraphPatternShape's own salg:graph minCount check it has no business being subject to). No rdfs:range declared - the value is a term/Variable, not a salg: class instance, so range would add nothing." .

    salg:text a rdf:Property ;
        rdfs:comment "No rdfs:domain declared, same reasoning as salg:graph above (RegexExpression is a salg:Expression subclass)." .

    salg:triples a rdf:Property ;
        rdfs:comment "A well-formed rdf:List of salg:TriplePattern - salg:BGP's own use of this property, specifically. No rdfs:domain declared even though every *in-scope* class using it is salg:BGP: this project's generic, key-name-based encoding (see to_rdf.py) means the untranslated GroupGraphPatternSub/TriplesBlock fragment inside EXISTS/NOT EXISTS (deliberately out of scope - see ExistsExpression) also happens to use a same-named 'triples' key on an unrelated node, and would be falsely entailed rdf:type salg:BGP by rdfs:domain here - confirmed as a real, live bug via validate()'s own RDFS reasoning once actually enabled (BGPShape's own shape then wrongly fired on that fragment). rdfs:range rdf:List is safe to keep - true regardless of which node uses this property." ;
        rdfs:range rdf:List .

    salg:val a rdf:Property ;
        rdfs:comment "A VALUES row's bound value for salg:var - absent means UNDEF." ;
        rdfs:domain salg:Binding .

    salg:var a rdf:Property ;
        rdfs:comment "The bound Variable - Extend's BIND target, or a VALUES row's own variable. No rdfs:domain declared - same reason as salg:PV above (Extend and Binding share no other superclass; multiple rdfs:domain triples would falsely cross-type them once RDFS reasoning runs)." .

    salg:vars a rdf:Property ;
        rdfs:comment "An aggregate's own input Variable (COUNT(?o) etc's ?o). No rdfs:domain declared: salg:Aggregate is a dispatch-style superclass (parallel to salg:GraphPattern/salg:Expression) - declaring domain here would risk the same defeats-a-future-dispatch-shape problem noted on salg:arg above, should a later shapes.py pass add an AggregateListShape checking sh:class salg:Aggregate." .

    salg:where a rdf:Property ;
        rdfs:comment "Modify's own WHERE-clause graph pattern. Domain safe, same reasoning as salg:delete - not itself dispatch-relevant (the *value* is checked against GraphPatternShape by a future shapes.py addition, which is unaffected by domain on this property)." ;
        rdfs:domain salg:Modify .

    salg:AggregateJoin rdfs:comment "Wraps a Group and the aggregate computations applied to it - salg:p the wrapped Group, salg:A the list of salg:Aggregate nodes (SELECT's own aggregate expressions reference each one's result Variable, not this node, once evaluated). Confirmed via translateQuery: AggregateJoin{A, p}." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:ConstructQuery rdfs:comment "A CONSTRUCT query's root - salg:template holds the construct template (an rdf:List of TriplePattern), salg:p the WHERE-clause pattern." ;
        rdfs:subClassOf salg:Query .

    salg:ServiceGraphPattern rdfs:comment "SERVICE [SILENT] <endpoint-or-var> { ... } - salg:term the endpoint (IRI or Variable), salg:graph a raw untranslated parse-tree fragment (GroupGraphPatternSub/TriplesBlock - rdflib evaluates SERVICE by re-parsing this on demand, not at translate time), same out-of-scope-fragment treatment as Builtin_EXISTS/NOTEXISTS's own salg:graph below. Confirmed via translateQuery: ServiceGraphPattern{service_string, term, graph, silent?}." ;
        rdfs:subClassOf salg:GraphPattern .

    salg:Modify rdfs:comment "DELETE {...} INSERT {...} WHERE {...} (either clause optional, never both absent) - salg:delete/salg:insert point at DeleteClause/InsertClause, salg:where at a graph pattern." ;
        rdfs:subClassOf salg:UpdateOperation .

    salg:pattern a rdf:Property ;
        rdfs:comment "Abstract: links an operator to an adjacent structural component (a pattern, subquery, or VALUES clause - which, depends on the concrete subproperty/domain)." .

    salg:Query rdfs:comment "The root of any encoded query, of any form - also typed salg:Query regardless of query form, see to_rdf.query_to_rdf." .

    salg:SubSelect rdfs:comment "A subquery pattern: Project, optionally wrapped in Slice/Distinct/Reduced." .

    salg:TripleSlot rdfs:comment "Anything with a subject/predicate/object triple - shared by TriplePattern and TripleTerm." .

    salg:operand a rdf:Property ;
        rdfs:comment "Abstract: an expression's operand." .

    salg:Aggregate rdfs:comment "One GROUP BY aggregate computation, a member of an AggregateJoin's salg:A list." .

    salg:GraphPattern rdfs:label "Graph pattern operator" ;
        rdfs:comment "A translated SPARQL algebra graph-pattern operator." .

    salg:UpdateOperation rdfs:comment "One SPARQL Update operation (INSERT/DELETE DATA, DELETE WHERE, Modify, or a graph-management form)." .
}

starontology:shacl-ui-baseline.ttl {
    # The generic SHACL UI scoring catalog (registry entry shacl_ui_baseline): which widget suits a property that names none.
    # It knows nothing about any application or about SHACL itself, and nothing uses it unless it is passed as
    # scoring_graph= to starlayer.shacl.ui_widget_selection.select_widgets (or StarShaclSchema(scoring_graph=...)).
    #
    # Three tiers, by score:
    #   1  a default that matches everything     TextFieldEditor, LiteralViewer
    #   2  defaults by datatype                  number, boolean, date, dateTime, language-tagged string
    #   3  defaults by a constraint that lists   sh:in, sh:class, sh:nodeKind sh:IRI
    #      the answers
    # A constraint is a stronger signal than a datatype (an xsd:string with sh:in is an enumeration), so tier 3 beats 2. A
    # layer on top (an editor for SHACL, an application, a user) adds scores that beat these (the Working Group's own
    # files use 40 for a preference).
    #
    # ONE catalog serves both roles: select_widgets(role="editor") considers only editors and role="viewer" only viewers,
    # because a widget's role comes from its class. A widget a shape names itself with shui:editor / shui:viewer wins.
    #
    # Every condition is written on its own score (shui:shapesGraphShape on the shui:WidgetScore), as in the Working Group's
    # widget files, so it applies to that score only. There are NO per-widget shui:WidgetAcceptMatcher entries: a matcher
    # is shared by every layer, so a layer on top could not add back a widget a lower layer had excluded. A score without
    # a condition applies to everything.
    #
    # Contributed in GitHub issue #10 (from the graph workbench) and restructured into tiers on 2026-10-21. The draft
    # publishes its built-in scores only as prose (SHACL UI section 9), so these scores are ours, not the Working Group's.
    #
    # baseURI: https://github.com/hidden-graph/starlayer/ns/ui-baseline#

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#booleanEditorScore2> a shui:WidgetScore ;
        shui:score 2 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasBooleanDatatype> ;
        shui:widget shui:BooleanEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#datePickerScore2> a shui:WidgetScore ;
        shui:score 2 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasDateDatatype> ;
        shui:widget shui:DatePickerEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#dateTimePickerScore2> a shui:WidgetScore ;
        shui:score 2 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasDateTimeDatatype> ;
        shui:widget shui:DateTimePickerEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#enumSelectEditorScore3> a shui:WidgetScore ;
        shui:score 3 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasInList> ;
        shui:widget shui:EnumSelectEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#instancesSelectEditorScore3> a shui:WidgetScore ;
        shui:score 3 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasClass> ;
        shui:widget shui:InstancesSelectEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#iriEditorScore3> a shui:WidgetScore ;
        shui:score 3 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#IsIRIWithoutClass> ;
        shui:widget shui:IRIEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#labelViewerScore3> a shui:WidgetScore ;
        shui:score 3 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#IsResource> ;
        shui:widget shui:LabelViewer .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#langStringViewerScore2> a shui:WidgetScore ;
        shui:score 2 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasLangStringDatatype> ;
        shui:widget shui:LangStringViewer .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#literalViewerScore1> a shui:WidgetScore ;
        shui:score 1 ;
        shui:widget shui:LiteralViewer .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#numberFieldEditorScore2> a shui:WidgetScore ;
        shui:score 2 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasNumericDatatype> ;
        shui:widget shui:NumberFieldEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#textFieldEditorScore1> a shui:WidgetScore ;
        shui:score 1 ;
        shui:widget shui:TextFieldEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#textFieldWithLangScore2> a shui:WidgetScore ;
        shui:score 2 ;
        shui:shapesGraphShape <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasLangStringDatatype> ;
        shui:widget shui:TextFieldWithLangEditor .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasBooleanDatatype> a sh:NodeShape ;
        sh:property [ sh:hasValue xsd:boolean ;
                sh:path sh:datatype ] .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasDateDatatype> a sh:NodeShape ;
        sh:property [ sh:hasValue xsd:date ;
                sh:path sh:datatype ] .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasDateTimeDatatype> a sh:NodeShape ;
        sh:property [ sh:hasValue xsd:dateTime ;
                sh:path sh:datatype ] .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasInList> a sh:NodeShape ;
        sh:property [ sh:minCount 1 ;
                sh:path sh:in ] .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasNumericDatatype> a sh:NodeShape ;
        sh:property [ sh:in ( xsd:integer xsd:decimal xsd:double xsd:float ) ;
                sh:minCount 1 ;
                sh:path sh:datatype ] .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#IsIRIWithoutClass> a sh:NodeShape ;
        sh:property [ sh:hasValue sh:IRI ;
                sh:path sh:nodeKind ],
            [ sh:maxCount 0 ;
                sh:path sh:class ] .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#IsResource> a sh:NodeShape ;
        sh:or ( <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasClass> [ sh:property [ sh:hasValue sh:IRI ;
                            sh:path sh:nodeKind ] ] ) .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasClass> a sh:NodeShape ;
        sh:property [ sh:minCount 1 ;
                sh:path sh:class ] .

    <https://github.com/hidden-graph/starlayer/ns/ui-baseline#HasLangStringDatatype> a sh:NodeShape ;
        sh:property [ sh:hasValue rdf:langString ;
                sh:path sh:datatype ] .
}

starontology:shacl12-shacl-rules.ttl {
    # What the structure of a shapes graph entails about the shapes graph: SHACL rules that add the rdf:type triples SHACL 1.2 Core
    # leaves to the engine (GitHub issues #24, #27, #28). Hand-edited. Registry entry shacl_shacl_rules, a companion of shacl_shacl.
    #
    # Core 3.1 says which nodes are shapes (a SHACL instance of sh:NodeShape or sh:PropertyShape; the subject of a target; the
    # subject of a constraint parameter; the value of a shape-valued parameter; a member of a list that is the value of sh:and,
    # sh:or or sh:xone). 3.2 and 3.3 split them: a shape that is the subject of sh:path is a property shape, any other a node shape.
    # Declaring the type is only recommended, so most hand-written shapes graphs carry none.
    #
    # Run them with starlayer.shacl.shape_types.infer_types(), or directly: apply_rules(shapes_graph, shacl_graph=<this graph>);
    # the inferred_graph of the result is the new triples only. They are rules for a shapes graph as data, never applied to a data
    # graph: loading this graph beside shacl_shacl does not change what validates. Layer 0 decides what is a shape, layer 1 which kind.
    #
    # Layer 2 types the node expressions and the argument lists inside them (GitHub issue #22), so that a tool finds a shape for
    # every node under a sh:values: the value of sh:values, sh:defaultValue or sh:expression is a sh:NodeExpression, and so is every
    # blank-node argument inside one (directly, or as a member of an argument list, at any depth); the cells of those argument lists are
    # typed rdf:List. Arguments that are paths, shapes or classes (sh:path, shnex:pathValues, the filter and conformance shapes) are not
    # expressions and are left alone. shacl12-validation-shapes.ttl gives sh:NodeExpression and rdf:List a shape to apply.
    #
    # What these rules do not do: the types of things that are not shapes (a property group, a constraint component, a prefix
    # declaration) come from the domains and ranges of the SHACL vocabulary (registry entry shacl_vocabulary), not from rules.
    #
    # baseURI: https://github.com/hidden-graph/starlayer/ns/shacl#

    stsh:ExpressionArgumentListRule a sh:NodeShape ;
        rdfs:label "The cells of an argument list of a node expression are lists"@en ;
        sh:rule [ a sh:SPARQLRule ;
                sh:construct """
            CONSTRUCT { ?cell a rdf:List } WHERE {
                $this ?p ?head .
                FILTER (?p NOT IN (rdf:type, sh:path, shnex:pathValues, sh:filterShape, shnex:filterShape,
                                   shnex:conformsToShape, shnex:instancesOf, shnex:nodesMatching, shnex:var))
                ?head rdf:rest* ?cell . ?cell rdf:first ?member . FILTER (isBlank(?cell))
            }""" ;
                sh:layer 2 ;
                sh:prefixes stsh:NodeExpressionPrefixes ] ;
        sh:targetClass sh:NodeExpression .

    stsh:NodeExpressionArgumentRule a sh:NodeShape ;
        rdfs:label "A blank-node argument of a node expression is a node expression"@en ;
        sh:rule [ a sh:SPARQLRule ;
                sh:construct """
            CONSTRUCT { ?argument a sh:NodeExpression } WHERE {
                $this ?p ?o .
                FILTER (?p NOT IN (rdf:type, sh:path, shnex:pathValues, sh:filterShape, shnex:filterShape,
                                   shnex:conformsToShape, shnex:instancesOf, shnex:nodesMatching, shnex:var))
                { BIND (?o AS ?argument) FILTER (isBlank(?argument) && NOT EXISTS { ?argument rdf:first ?x }) }
                UNION
                { ?o rdf:rest*/rdf:first ?argument . FILTER (isBlank(?argument) && NOT EXISTS { ?argument rdf:first ?y }) }
            }""" ;
                sh:layer 2 ;
                sh:prefixes stsh:NodeExpressionPrefixes ] ;
        sh:targetClass sh:NodeExpression .

    stsh:NodeExpressionRootRule a sh:NodeShape ;
        rdfs:label "The value of sh:values, sh:defaultValue or sh:expression is a node expression"@en ;
        sh:rule [ a sh:TripleRule ;
                sh:layer 2 ;
                sh:object sh:NodeExpression ;
                sh:predicate rdf:type ;
                sh:subject [ sh:path [ sh:alternativePath ( sh:values sh:defaultValue sh:expression ) ] ] ] ;
        sh:targetSubjectsOf sh:defaultValue,
            sh:expression,
            sh:values .

    stsh:NodeShapeRule a sh:NodeShape ;
        rdfs:label "A shape without sh:path is a node shape"@en ;
        sh:rule [ a sh:TripleRule ;
                sh:condition [ sh:not [ sh:property [ sh:minCount 1 ;
                                        sh:path sh:path ] ] ] ;
                sh:layer 1 ;
                sh:object sh:NodeShape ;
                sh:predicate rdf:type ;
                sh:subject sh:this ] ;
        sh:targetClass sh:Shape .

    stsh:PropertyShapeRule a sh:NodeShape ;
        rdfs:label "A shape with sh:path is a property shape"@en ;
        sh:rule [ a sh:TripleRule ;
                sh:condition [ sh:property [ sh:minCount 1 ;
                                sh:path sh:path ] ] ;
                sh:layer 1 ;
                sh:object sh:PropertyShape ;
                sh:predicate rdf:type ;
                sh:subject sh:this ] ;
        sh:targetClass sh:Shape .

    stsh:SPARQLAskValidatorRule a sh:NodeShape ;
        rdfs:label "A validator that is an ASK executable is an SPARQL ASK validator"@en ;
        sh:rule [ a sh:TripleRule ;
                sh:condition [ sh:class sh:Validator ] ;
                sh:layer 1 ;
                sh:object sh:SPARQLAskValidator ;
                sh:predicate rdf:type ;
                sh:subject sh:this ] ;
        sh:targetClass sh:SPARQLAskExecutable .

    stsh:SPARQLSelectValidatorRule a sh:NodeShape ;
        rdfs:label "A validator that is a SELECT executable is an SPARQL SELECT validator"@en ;
        sh:rule [ a sh:TripleRule ;
                sh:condition [ sh:class sh:Validator ] ;
                sh:layer 1 ;
                sh:object sh:SPARQLSelectValidator ;
                sh:predicate rdf:type ;
                sh:subject sh:this ] ;
        sh:targetClass sh:SPARQLSelectExecutable .

    stsh:ShapeByListMemberRule a sh:NodeShape ;
        rdfs:label "A member of the list that is the value of sh:and, sh:or or sh:xone is a shape"@en ;
        sh:rule [ a sh:TripleRule ;
                sh:layer 0 ;
                sh:object sh:Shape ;
                sh:predicate rdf:type ;
                sh:subject [ sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ] ] ;
        sh:targetObjectsOf sh:and,
            sh:or,
            sh:xone .

    stsh:ShapeBySubjectRule a sh:NodeShape ;
        rdfs:label "A node with a target or a constraint parameter is a shape"@en ;
        sh:rule [ a sh:TripleRule ;
                sh:layer 0 ;
                sh:object sh:Shape ;
                sh:predicate rdf:type ;
                sh:subject sh:this ] ;
        sh:targetSubjectsOf sh:and,
            sh:class,
            sh:closed,
            sh:datatype,
            sh:disjoint,
            sh:equals,
            sh:flags,
            sh:hasValue,
            sh:ignoredProperties,
            sh:in,
            sh:languageIn,
            sh:lessThan,
            sh:lessThanOrEquals,
            sh:maxCount,
            sh:maxExclusive,
            sh:maxInclusive,
            sh:maxLength,
            sh:maxListLength,
            sh:memberShape,
            sh:minCount,
            sh:minExclusive,
            sh:minInclusive,
            sh:minLength,
            sh:minListLength,
            sh:node,
            sh:nodeKind,
            sh:not,
            sh:or,
            sh:path,
            sh:pattern,
            sh:property,
            sh:qualifiedMaxCount,
            sh:qualifiedMinCount,
            sh:qualifiedValueShape,
            sh:qualifiedValueShapesDisjoint,
            sh:singleLine,
            sh:targetClass,
            sh:targetNode,
            sh:targetObjectsOf,
            sh:targetSubjectsOf,
            sh:targetWhere,
            sh:uniqueLang,
            sh:uniqueMembers,
            sh:xone .

    stsh:ShapeByValueRule a sh:NodeShape ;
        rdfs:label "The value of a shape-valued parameter is a shape"@en ;
        sh:rule [ a sh:TripleRule ;
                sh:layer 0 ;
                sh:object sh:Shape ;
                sh:predicate rdf:type ;
                sh:subject sh:this ] ;
        sh:targetObjectsOf sh:memberShape,
            sh:node,
            sh:not,
            sh:property,
            sh:qualifiedValueShape,
            sh:reifierShape,
            sh:someValue .

    stsh:NodeExpressionPrefixes sh:declare [ sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ;
                sh:prefix "sh" ],
            [ sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
                sh:prefix "rdf" ],
            [ sh:namespace "http://www.w3.org/ns/shacl-node-expr#"^^xsd:anyURI ;
                sh:prefix "shnex" ] .
}

starontology:shacl12-shacl-ui-scores.ttl {
    # The scoring layer for editing SHACL (registry entry shacl_shacl_ui_scores): which widget edits which SHACL predicate in a form
    # built from shacl_shacl. It builds on the generic catalog (shacl_ui_baseline: tier 1 score 1, tier 2 score 2, tier 3 score 3)
    # and adds scores at 40, the tier the Working Group's own widget files use for a preference, so these beat the generic ones.
    #
    # This is an APPLICATION layer that ships with starlayer because shacl_shacl is part of starlayer. It knows about SHACL; the
    # generic catalog does not. The same pattern is meant for the other vocabularies in starontology (sqe, srl, manch, ...): a
    # shapes-side file for the presentation (here shacl_shacl_ui: groups, sh:order, form flags) and a scoring-side file like this
    # one, each built on the generic catalog.
    #
    # Use it as the scoring graph together with the generic catalog (the caller combines them; higher scores win):
    #     select_widgets(shape_node=..., shapes_graph=shacl_shacl (+ shacl_shacl_ui),
    #                    scoring_graph=baseline + this, role="editor")
    # Editors only: for a viewer the generic defaults apply. Conditions are written on the scores (nothing is a shared gate),
    # so a layer above this one, or a user, can add or replace entries freely.
    #
    # Each score applies when the property shape being rendered has a sh:path that is one of the listed predicates (so it
    # works with the property shapes of shacl_shacl itself, or of any form shape that edits those predicates).
    #
    # Generated once from the preferences the overlay used to carry (66 predicates, 9 widgets) on 2026-10-21; hand-edited since:
    # sh:targetClass, sh:targetSubjectsOf and sh:targetObjectsOf (IRIs only, per SHACL) were moved from the text field to the IRI
    # editor; sh:targetNode keeps the text field because its values may be literals. sh:languageIn (a list of language tags,
    # strings) was moved from the IRI editor to the text field (2026-10-26, GitHub issue #130).
    #
    # 2026-10-26 (GitHub issues #91, #105): the paths of the new fields and forms: nested shapes (sh:target, sh:targetWhere, sh:nodeByExpression, sh:prefixes,
    # sh:declare, sh:bodyExpression) get the details editor; rdfs:comment a text area; rdfs:label a text field with language. The rest
    # (booleans, sh:layer, IRIs such as rdfs:seeAlso) come out right from the datatype and node kind the form states, with the generic catalog.
    #
    # 2026-10-26: sh:expression (a field of both shape forms) gets the details editor, like sh:nodeByExpression: its value is a node expression, a nested blank node.
    #
    # baseURI: https://github.com/hidden-graph/starlayer/ns/shacl#

    stsh:score40BooleanEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithBooleanEditor ;
        shui:widget shui:BooleanEditor .

    stsh:score40DetailsEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithDetailsEditor ;
        shui:widget shui:DetailsEditor .

    stsh:score40EnumSelectEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithEnumSelectEditor ;
        shui:widget shui:EnumSelectEditor .

    stsh:score40IRIEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithIRIEditor ;
        shui:widget shui:IRIEditor .

    stsh:score40InstancesSelectEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithInstancesSelectEditor ;
        shui:widget shui:InstancesSelectEditor .

    stsh:score40NumberFieldEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithNumberFieldEditor ;
        shui:widget shui:NumberFieldEditor .

    stsh:score40TextAreaEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithTextAreaEditor ;
        shui:widget shui:TextAreaEditor .

    stsh:score40TextFieldEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithTextFieldEditor ;
        shui:widget shui:TextFieldEditor .

    stsh:score40TextFieldWithLangEditor a shui:WidgetScore ;
        shui:score 40 ;
        shui:shapesGraphShape stsh:PathsEditedWithTextFieldWithLangEditor ;
        shui:widget shui:TextFieldWithLangEditor .

    stsh:PathsEditedWithBooleanEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:closed sh:deactivated sh:qualifiedValueShapesDisjoint sh:reificationRequired sh:singleLine sh:uniqueLang sh:uniqueMembers ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .

    stsh:PathsEditedWithDetailsEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:ConstraintComponent sh:SPARQLRule sh:TripleRule sh:condition sh:memberShape sh:nodeValidator sh:object sh:parameter sh:predicate sh:propertyValidator sh:qualifiedValueShape sh:reifierShape sh:rule sh:someValue sh:sparql sh:subject sh:validator sh:target sh:targetWhere sh:nodeByExpression sh:prefixes sh:declare sh:bodyExpression sh:expression ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .

    stsh:PathsEditedWithEnumSelectEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:nodeKind sh:severity ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .

    stsh:PathsEditedWithIRIEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:targetClass sh:targetObjectsOf sh:targetSubjectsOf sh:uniqueValuesFor ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .

    stsh:PathsEditedWithInstancesSelectEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:class sh:datatype sh:filterShape sh:ignoredProperties sh:rootClass ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .

    stsh:PathsEditedWithNumberFieldEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:maxCount sh:maxExclusive sh:maxInclusive sh:maxLength sh:maxListLength sh:minCount sh:minExclusive sh:minInclusive sh:minLength sh:minListLength sh:order sh:qualifiedMaxCount sh:qualifiedMinCount ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .

    stsh:PathsEditedWithTextAreaEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:ask sh:comment rdfs:comment sh:construct sh:select ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .

    stsh:PathsEditedWithTextFieldEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:and sh:defaultValue sh:flags sh:function sh:languageIn sh:node sh:not sh:or sh:pattern sh:property sh:targetNode sh:xone ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .

    stsh:PathsEditedWithTextFieldWithLangEditor a sh:NodeShape ;
        sh:property [ sh:in ( sh:description sh:name rdfs:label ) ;
                sh:minCount 1 ;
                sh:path sh:path ] .
}

