starontology:shacl12-shacl.ttl {
    # GENERATED by scripts/build_starontology.py - do not edit by hand.
    # The SHACL 1.2 meta-shapes: pySHACL's bundled shacl-shacl (adjusted for the rules
    # SHACL 1.2 widened) plus StarLayer's shacl12-validation-shapes.ttl.

    shsh: a owl:Ontology ;
        rdfs:label "W3C SHACL for SHACL Validator"@en ;
        dcterms:creator "W3C Data Shapes Working Group" ;
        dcterms:license "https://www.w3.org/copyright/software-license/"^^xsd:anyURI ;
        dcterms:publisher "World Wide Web Consortium" ;
        rdfs:comment "This shapes graph can be used to validate SHACL shapes graphs against a subset of the syntax rules."@en ;
        owl:imports sh: ;
        owl:versionIRI shsh:1.2 ;
        sh:declare [ sh:namespace "http://www.w3.org/ns/shacl-shacl#"^^xsd:anyURI ;
                sh:prefix "shsh" ] .

    shsh:DataGraphImportsShape a sh:NodeShape ;
        rdfs:seeAlso <https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/#Resolving_Included_RDF_Graphs>,
            <https://www.w3.org/TR/shacl12-core/#data-graph> ;
        sh:message "In light of the OWL RDF mapping section \"Resolving Included RDF Graphs\" and its reliance on certain triples being present, sh:DataGraphs using owl:imports should explicitly include the type owl:Ontology."@en ;
        sh:or ( [ sh:property [ sh:maxCount 0 ;
                            sh:path owl:imports ] ] [ sh:property [ sh:hasValue owl:Ontology ;
                            sh:path rdf:type ] ] ) ;
        sh:severity sh:Info ;
        sh:targetClass sh:DataGraph .

    shsh:EntailmentShape a sh:NodeShape ;
        sh:nodeKind sh:IRI ;
        sh:targetObjectsOf sh:entailment .

    shsh:ShapesGraphShape a sh:NodeShape ;
        sh:nodeKind sh:IRI ;
        sh:targetObjectsOf sh:shapesGraph .

    shsh:ShapesListShape a sh:NodeShape ;
        sh:memberShape shsh:ShapeShape ;
        sh:targetObjectsOf sh:and,
            sh:or,
            sh:xone .

    shsh:ValidationReportShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:path sh:usedConfiguration ],
            [ sh:nodeKind sh:IRI ;
                sh:path sh:usedDataGraph ],
            [ sh:nodeKind sh:IRI ;
                sh:path sh:usedShapesGraph ] ;
        sh:targetClass sh:ValidationReport .

    shsh:inSubjectsShape a sh:NodeShape ;
        rdfs:comment "A shape that raises warnings on unsatisfiable lists.  If some use case requires a length-0 list on 'sh:in', this graph should be supplemented with 'shsh:inSubjectsShape sh:deactivated true .'."@en ;
        sh:property shsh:inSubjectsShapeInPropertyShape ;
        sh:targetSubjectsOf sh:in .

    shsh:xoneSubjectsShape a sh:NodeShape ;
        rdfs:comment "A shape that raises warnings on unsatisfiable lists.  If some use case requires a length-0 list on 'sh:xone', this graph should be supplemented with 'shsh:xoneSubjectsShape sh:deactivated true .'."@en ;
        sh:property shsh:xoneSubjectsShapeXonePropertyShape ;
        sh:targetSubjectsOf sh:xone .

    shui:AutoCompleteEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A text input with suggestions, typically backed by shui:resourceFilter-style search against existing resources."@en ;
        sh:name "autocomplete editor"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:BlankNodeEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A nested sub-form for editing a blank-node-valued property in place, rather than as a reference."@en ;
        sh:name "blank node editor"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:BlankNodeViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "Read-only nested display of a blank-node-valued property's own properties."@en ;
        sh:name "blank node viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:BooleanEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A checkbox or toggle, for xsd:boolean-typed values."@en ;
        sh:name "boolean editor"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:DatePickerEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A calendar-style date picker, for xsd:date-typed values."@en ;
        sh:name "date picker"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:DateTimePickerEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A calendar-and-time picker, for xsd:dateTime-typed values."@en ;
        sh:name "date-time picker"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:DetailsViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        rdfs:seeAlso shui:DetailsEditor ;
        sh:description "An expandable/collapsible read-only view for a complex value, the viewer counterpart to shui:DetailsEditor."@en ;
        sh:name "details viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:EnumSelectEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A dropdown/select list, for a value constrained by sh:in to a fixed set of options."@en ;
        sh:name "enum select"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:HTMLViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "Renders a value's content as formatted HTML rather than as plain escaped text."@en ;
        sh:name "HTML viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:HyperlinkViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "Displays an IRI value as a clickable link."@en ;
        sh:name "hyperlink viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:IRIEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A plain-text input constrained to well-formed IRIs."@en ;
        sh:name "IRI editor"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:IRIViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "Read-only display of an IRI value, typically abbreviated with a known prefix."@en ;
        sh:name "IRI viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:ImageViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "Renders an IRI value inline as an image, for properties known to point at image resources."@en ;
        sh:name "image viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:InstancesSelectEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A dropdown/select list populated dynamically from existing instances of a class, rather than a fixed sh:in list."@en ;
        sh:name "instances select"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:LabelRole rdfs:comment "ignored by validation; not interpreted by starlayer.shacl (property roles are documented here but not implemented)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        rdfs:seeAlso shui:propertyRole ;
        sh:description "The one built-in shui:propertyRole value — marks a property shape's values as the resource's own display label."@en ;
        sh:name "label role"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:LabelViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        rdfs:seeAlso shui:propertyRole ;
        sh:description "Displays a resource by its resolved human-readable label (e.g. via shui:LabelRole/shui:displayProvider) rather than its raw IRI."@en ;
        sh:name "label viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:LangStringViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "Read-only display of a language-tagged literal, typically showing the language tag alongside the text."@en ;
        sh:name "language string viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:LiteralViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "Plain read-only display of a literal value's lexical form."@en ;
        sh:name "literal viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:NumberFieldEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A numeric input, for xsd:integer/xsd:decimal/xsd:double-typed values."@en ;
        sh:name "number field"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:RichTextEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A formatted (e.g. HTML/Markdown) text editor, for values meant to render with styling."@en ;
        sh:name "rich text editor"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:SubClassEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        rdfs:seeAlso sh:rootClass ;
        sh:description "A class picker constrained to subclasses of a given root class — the editor-side counterpart to sh:rootClass."@en ;
        sh:name "subclass editor"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:TextAreaEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A multi-line plain-text input."@en ;
        sh:name "text area"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:TextAreaWithLangEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A multi-line text input paired with a language-tag selector."@en ;
        sh:name "text area with language"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:TextFieldEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A single-line plain-text input."@en ;
        sh:name "text field"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:TextFieldWithLangEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "A single-line text input paired with a language-tag selector, for editing one language-tagged literal."@en ;
        sh:name "text field with language"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:ValueTableViewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "Displays multiple values for a property as rows of a table, rather than a simple list."@en ;
        sh:name "value table viewer"@en ;
        stsh:requiredEngine stsh:StarShacl .

    stsh: rdfs:label "starShacl SHACL 1.2 Meta-Shapes"@en ;
        rdfs:comment "Supplementary SHACL 1.2 Core well-formedness rules and UI/presentation metadata, meant to be merged with pySHACL's own bundled shacl-shacl.ttl. See shacl12-validation-shapes.ttl (this file) for validation rules and shacl12-presentation-shapes.ttl for UI-specific metadata."@en .

    stsh:ConstraintComponentShape a sh:NodeShape ;
        rdfs:label "Well-formedness rules for sh:ConstraintComponent"@en ;
        sh:or ( [ sh:property [ sh:minCount 1 ;
                            sh:path sh:validator ] ] [ sh:property [ sh:minCount 1 ;
                            sh:path sh:nodeValidator ] ] [ sh:property [ sh:minCount 1 ;
                            sh:path sh:propertyValidator ] ] ) ;
        sh:property [ sh:minCount 1 ;
                sh:node [ a sh:NodeShape ;
                        sh:property [ sh:maxCount 1 ;
                                sh:minCount 1 ;
                                sh:nodeKind sh:IRI ;
                                sh:path sh:path ] ] ;
                sh:path sh:parameter ],
            [ sh:node stsh:AskValidatorShape ;
                sh:path sh:validator ],
            [ sh:node stsh:SelectValidatorShape ;
                sh:path sh:nodeValidator ],
            [ sh:node stsh:SelectValidatorShape ;
                sh:path sh:propertyValidator ] ;
        sh:targetClass sh:ConstraintComponent .

    stsh:DataGraphImportsShape a sh:NodeShape ;
        rdfs:label "sh:DataGraph owl:imports resolution note"@en ;
        rdfs:comment "Mirrors the official SHACL 1.2 WG draft's own shsh:DataGraphImportsShape: per the OWL RDF mapping's 'Resolving Included RDF Graphs' section (which the owl:imports mechanism relies on), a sh:DataGraph using owl:imports should explicitly assert its own rdf:type owl:Ontology for that resolution to behave as the mapping specifies. Info severity in both files - a hint, not a violation."@en ;
        sh:message "In light of the OWL RDF mapping section \"Resolving Included RDF Graphs\" and its reliance on certain triples being present, sh:DataGraphs using owl:imports should explicitly include the type owl:Ontology."@en ;
        sh:or ( [ sh:property [ sh:maxCount 0 ;
                            sh:path owl:imports ] ] [ sh:property [ sh:hasValue owl:Ontology ;
                            sh:path rdf:type ] ] ) ;
        sh:severity sh:Info ;
        sh:targetClass sh:DataGraph .

    stsh:DefaultValueShape a sh:NodeShape ;
        rdfs:label "Well-formed sh:defaultValue"@en ;
        sh:property [ sh:maxCount 1 ;
                sh:message "a shape has at most one sh:defaultValue, a well-formed node expression"@en ;
                sh:name "default value"@en ;
                sh:node stsh:NodeExpressionShape ;
                sh:order 5 ;
                sh:path sh:defaultValue ] ;
        sh:targetSubjectsOf sh:defaultValue .

    stsh:GroupShape a sh:NodeShape ;
        rdfs:label "Well-formed sh:group"@en ;
        sh:property [ sh:class sh:PropertyGroup ;
                sh:message "sh:group must name an instance of sh:PropertyGroup"@en ;
                sh:name "group"@en ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:order 4 ;
                sh:path sh:group ] ;
        sh:targetSubjectsOf sh:group .

    stsh:IgnoredPropertiesLanguageInMinListLengthShapes a sh:NodeShape ;
        rdfs:label "sh:ignoredProperties / sh:languageIn minimum list length"@en ;
        rdfs:comment "Mirrors the official SHACL 1.2 WG draft's own minListLength additions to shsh:ShapeShape for these two predicates - an empty sh:ignoredProperties or sh:languageIn list is rejected outright (Violation, unlike the Warning-level sh:in/sh:xone checks above, matching the official draft's own severity choice for these two - no explicit sh:severity override there either). Purely additive: pySHACL's own bundled base graph already correctly checks list-of-IRI/list-of-string membership for both, unmodified and untouched here - only the missing minimum-length check is added."@en ;
        sh:property [ sh:minListLength 1 ;
                sh:path sh:ignoredProperties ],
            [ sh:minListLength 1 ;
                sh:path sh:languageIn ] ;
        sh:targetSubjectsOf sh:ignoredProperties,
            sh:languageIn .

    stsh:InXoneSatisfiabilityShapes a sh:NodeShape ;
        rdfs:label "sh:in / sh:xone satisfiability check"@en ;
        rdfs:comment "sh:in mirrors the official SHACL 1.2 WG draft's own shsh:inSubjectsShape exactly - Warning severity, since an empty sh:in list is soft-ignorable (confirmed live: allow_warnings=True lets it through cleanly, no crash). sh:xone deliberately diverges from the official draft's own shsh:xoneSubjectsShape (which uses Warning there too): pySHACL's own shape LOADER unconditionally rejects an empty sh:and/sh:or/sh:xone list with a raw ShapeLoadError the moment real validation runs, regardless of meta-shacl or allow_warnings - confirmed live for all three predicates. A Warning severity here would imply a working allow_warnings escape hatch that doesn't actually exist for sh:xone (unlike sh:in), trading a clear meta-shacl report for an uglier crash later - so this is Violation, an honest reflection of what's actually unconditionally enforced, not a hint."@en ;
        sh:property [ sh:minListLength 1 ;
                sh:path sh:in ;
                sh:severity sh:Warning ],
            [ sh:minListLength 1 ;
                sh:path sh:xone ] ;
        sh:targetSubjectsOf sh:in,
            sh:xone .

    stsh:NameAndDescriptionShape a sh:NodeShape ;
        rdfs:label "Well-formed sh:name and sh:description"@en ;
        sh:property [ sh:message "sh:name must be an xsd:string or a language-tagged string"@en ;
                sh:name "name"@en ;
                sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] [ sh:datatype rdf:dirLangString ] ) ;
                sh:order 1 ;
                sh:path sh:name ],
            [ sh:message "sh:description must be an xsd:string or a language-tagged string"@en ;
                sh:name "description"@en ;
                sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] [ sh:datatype rdf:dirLangString ] ) ;
                sh:order 2 ;
                sh:path sh:description ] ;
        sh:targetSubjectsOf sh:description,
            sh:name .

    stsh:NewPredicateShapes a sh:NodeShape ;
        rdfs:label "Well-formedness rules for new SHACL 1.2 predicates"@en ;
        sh:property [ sh:maxCount 1 ;
                sh:node stsh:ShapeReferenceShape ;
                sh:path sh:someValue ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path sh:subsetOf ],
            [ sh:node stsh:IRIOrListOfIRIsShape ;
                sh:path sh:rootClass ],
            [ sh:maxCount 1 ;
                sh:node stsh:IRIOrListOfIRIsShape ;
                sh:path sh:uniqueValuesFor ],
            [ sh:nodeKind sh:BlankNodeOrIRI ;
                sh:path sh:memberShape ],
            [ sh:maxCount 1 ;
                sh:node stsh:ShapeReferenceShape ;
                sh:path sh:reifierShape ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:path sh:reificationRequired ] ;
        sh:targetSubjectsOf sh:memberShape,
            sh:reificationRequired,
            sh:reifierShape,
            sh:rootClass,
            sh:someValue,
            sh:subsetOf,
            sh:uniqueValuesFor .

    stsh:OrderShape a sh:NodeShape ;
        rdfs:label "Well-formed sh:order"@en ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sh:order must be a single decimal"@en ;
                sh:name "order"@en ;
                sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ;
                sh:order 3 ;
                sh:path sh:order ] ;
        sh:targetSubjectsOf sh:order .

    stsh:PropertyGroupShape a sh:NodeShape ;
        rdfs:label "Well-formed sh:PropertyGroup"@en ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property [ sh:message "a property group's rdfs:label must be an xsd:string or a language-tagged string"@en ;
                sh:name "label"@en ;
                sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] [ sh:datatype rdf:dirLangString ] ) ;
                sh:order 1 ;
                sh:path rdfs:label ],
            [ sh:maxCount 1 ;
                sh:name "order"@en ;
                sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ;
                sh:order 2 ;
                sh:path sh:order ] ;
        sh:targetClass sh:PropertyGroup .

    stsh:RulesAndSparqlShapes a sh:NodeShape ;
        rdfs:label "Well-formedness rules for sh:sparql / sh:rule / sh:condition"@en ;
        sh:property [ sh:node stsh:SelectValidatorShape ;
                sh:path sh:sparql ],
            [ sh:node stsh:RuleShape ;
                sh:path sh:rule ],
            [ sh:node stsh:ShapeOrListOfShapesShape ;
                sh:path sh:condition ] ;
        sh:targetSubjectsOf sh:condition,
            sh:rule,
            sh:sparql .

    stsh:ShapeShapeOverrides a sh:NodeShape ;
        rdfs:label "SHACL 1.2 replacement rules for widened parameters the Working Group file still rejects"@en ;
        sh:property [ sh:node stsh:IRIOrPathShape ;
                sh:path sh:equals ],
            [ sh:node stsh:IRIOrPathShape ;
                sh:path sh:disjoint ],
            [ sh:node stsh:IRIOrPathShape ;
                sh:path sh:lessThan ],
            [ sh:node stsh:IRIOrPathShape ;
                sh:path sh:lessThanOrEquals ],
            [ sh:maxCount 1 ;
                sh:or ( [ sh:in ( sh:BlankNode sh:IRI sh:Literal sh:BlankNodeOrIRI sh:BlankNodeOrLiteral sh:IRIOrLiteral sh:TripleTerm ) ] [ sh:node shsh:ListShape ;
                            sh:property [ sh:path [ sh:zeroOrMorePath rdf:rest ] ;
                                    sh:property [ sh:in ( sh:BlankNode sh:IRI sh:Literal sh:BlankNodeOrIRI sh:BlankNodeOrLiteral sh:IRIOrLiteral sh:TripleTerm ) ;
                                            sh:path rdf:first ] ] ] ) ;
                sh:path sh:nodeKind ] ;
        sh:targetSubjectsOf sh:disjoint,
            sh:equals,
            sh:lessThan,
            sh:lessThanOrEquals,
            sh:nodeKind .

    stsh:ShuiPredicateShapes a sh:NodeShape ;
        rdfs:label "Well-formedness rules for shui: predicates"@en ;
        sh:property [ sh:nodeKind sh:IRI ;
                sh:path shui:editor ],
            [ sh:nodeKind sh:IRI ;
                sh:path shui:viewer ],
            [ sh:nodeKind sh:IRI ;
                sh:path shui:propertyRole ] ;
        sh:targetSubjectsOf shui:editor,
            shui:propertyRole,
            shui:viewer .

    stsh:SparqlPrefixesShapes a sh:NodeShape ;
        rdfs:label "Well-formedness rules for sh:prefixes / sh:declare"@en ;
        sh:property [ sh:node [ a sh:NodeShape ;
                        sh:property [ sh:node stsh:PrefixDeclarationShape ;
                                sh:path sh:declare ] ] ;
                sh:path sh:prefixes ] ;
        sh:targetSubjectsOf sh:prefixes .

    stsh:WidgetScoreShape a sh:NodeShape ;
        rdfs:label "Well-formedness rules for shui:WidgetScore"@en ;
        sh:property [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:path shui:widget ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:or ( [ sh:datatype xsd:decimal ] [ sh:datatype xsd:integer ] ) ;
                sh:path shui:score ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:path shui:dataGraphShape ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:BlankNodeOrIRI ;
                sh:path shui:shapesGraphShape ] ;
        sh:targetClass shui:WidgetScore .

    sh:deactivated rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:deactivated true"@en ;
        sh:description "When true, this shape is skipped entirely during validation — as if it weren't there. Useful for temporarily disabling a rule without deleting it, e.g. while a training exercise focuses on a different constraint."@en ;
        sh:name "deactivated"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:message rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:message \"Age must be a non-negative integer.\"@en"@en ;
        sh:description "A human-readable explanation shown in the validation report when this shape is violated. Can use {$this}, {?path}, and similar placeholders that get filled in per-violation. Purely informational — has no effect on whether the shape conforms."@en ;
        sh:name "message"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:severity rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:severity sh:Warning"@en ;
        sh:description "How seriously to treat a violation of this shape: sh:Violation (default — fails conformance), sh:Warning, or sh:Info (both reported but don't fail conformance). Useful for phasing in stricter rules without breaking existing data immediately."@en ;
        sh:name "severity"@en ;
        stsh:requiredEngine stsh:PySHACL .

    shsh:ListNodeShape a sh:NodeShape ;
        rdfs:label "List node shape"@en ;
        rdfs:comment "Defines constraints on what it means for a node to be a node within a well-formed RDF list. Note that this does not check whether the rdf:rest items are also well-formed lists as this would lead to unsupported recursion."@en ;
        sh:or ( [ sh:hasValue () ;
                    sh:property [ sh:maxCount 0 ;
                            sh:path rdf:first ],
                        [ sh:maxCount 0 ;
                            sh:path rdf:rest ] ] [ sh:not [ sh:hasValue () ] ;
                    sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path rdf:rest ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path rdf:first ] ] ) .

    shsh:inSubjectsShapeInPropertyShape a sh:PropertyShape ;
        sh:minListLength 1 ;
        sh:path sh:in ;
        sh:severity sh:Warning .

    shsh:xoneSubjectsShapeXonePropertyShape a sh:PropertyShape ;
        sh:minListLength 1 ;
        sh:path sh:xone ;
        sh:severity sh:Warning .

    shui:DetailsEditor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        sh:description "An expandable/collapsible nested editor for a complex (typically shape-constrained) value."@en ;
        sh:name "details editor"@en ;
        stsh:requiredEngine stsh:StarShacl .

    stsh:AskValidatorShape a sh:NodeShape ;
        rdfs:label "Well-formed ASK validator"@en ;
        rdfs:comment "The value of sh:validator on a custom sh:ConstraintComponent - pySHACL requires exactly one sh:ask (an xsd:string) for this branch (AskConstraintValidator.__init__)."@en ;
        sh:property [ sh:datatype xsd:string ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path sh:ask ] .

    stsh:NamedParameterFunctionCallShape a sh:NodeShape ;
        rdfs:label "Structurally shaped like a call to a custom Named Parameter Expression Function"@en ;
        rdfs:comment "Matches SHACL 1.2 Node Expressions' Custom Named Parameter Expression call convention: some predicate other than sh:message that is the sh:path of a sh:keyParameter true parameter of some declared sh:NamedParameterExpressionFunction. Structural only - does not confirm sh:bodyExpression is itself well-formed."@en ;
        sh:sparql [ sh:message "Value does not look like a call to any declared sh:NamedParameterExpressionFunction (no predicate matches a declared key parameter's sh:path)."@en ;
                sh:select """
			SELECT $this
			WHERE {
				FILTER NOT EXISTS {
					$this ?p ?o .
					FILTER (?p != <http://www.w3.org/ns/shacl#message>)
					?param <http://www.w3.org/ns/shacl#path> ?p .
					?param <http://www.w3.org/ns/shacl#keyParameter> true .
					?fn <http://www.w3.org/ns/shacl#parameter> ?param .
					?fn a <http://www.w3.org/ns/shacl#NamedParameterExpressionFunction> .
				}
			}
		""" ] .

    stsh:NodeExpressionFunctionCallShape a sh:NodeShape ;
        rdfs:label "Structurally shaped like a SHACL Function call"@en ;
        rdfs:comment "Matches pyshacl's own FunctionExpression detection: some predicate other than sh:message whose object is a well-formed list (has rdf:first). Structural only - does not confirm the referenced function is actually defined via sh:SPARQLFunction/sh:JSFunction, or that the argument count/types match."@en ;
        sh:sparql [ sh:message "Value does not look like a SHACL Function call (no predicate other than sh:message has a list-shaped object)."@en ;
                sh:select """
			SELECT $this
			WHERE {
				FILTER NOT EXISTS {
					$this ?p ?o .
					FILTER (?p != <http://www.w3.org/ns/shacl#message>)
					?o <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ?f .
				}
			}
		""" ] .

    stsh:PrefixDeclarationShape a sh:NodeShape ;
        rdfs:label "Well-formed sh:declare prefix declaration"@en ;
        sh:property [ sh:datatype xsd:string ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path sh:prefix ],
            [ sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:or ( [ sh:datatype xsd:anyURI ] [ sh:datatype xsd:string ] ) ;
                sh:path sh:namespace ] .

    stsh:RuleShape a sh:NodeShape ;
        rdfs:label "Well-formed sh:TripleRule or sh:SPARQLRule"@en ;
        sh:or ( [ sh:class sh:TripleRule ;
                    sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node stsh:NodeExpressionShape ;
                            sh:path sh:subject ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node stsh:NodeExpressionShape ;
                            sh:path sh:predicate ],
                        [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node stsh:NodeExpressionShape ;
                            sh:path sh:object ] ] [ sh:class sh:SPARQLRule ;
                    sh:property [ sh:datatype xsd:string ;
                            sh:minCount 1 ;
                            sh:path sh:construct ] ] ) .

    stsh:ShapeOrListOfShapesShape a sh:NodeShape ;
        rdfs:label "Well-formed shape, or list of well-formed shapes"@en ;
        rdfs:comment "SHACLRule.get_conditions() accepts sh:condition as either a single shape reference or a SHACL list whose members are each shape references. Uses the same stsh:ShapeReferenceShape as sh:someValue/sh:memberShape/sh:reifierShape - sh:condition is now in starshacl/native_components.py's SHAPE_EXPECTING_PREDICATES too, so starShacl auto-types its value(s) the same way as those three before pySHACL ever runs, whether or not the user's own shapes graph already had explicit sh:NodeShape/sh:PropertyShape typing. One consistent fix strategy for all four, not a stricter one-off for sh:condition."@en ;
        sh:or ( stsh:ShapeReferenceShape [ sh:node shsh:ListShape ;
                    sh:property [ sh:path [ sh:zeroOrMorePath rdf:rest ] ;
                            sh:property [ sh:node stsh:ShapeReferenceShape ;
                                    sh:path rdf:first ] ] ] ) .

    sh:closed rdfs:comment "plain `xsd:boolean` value only — `sh:closed sh:ByTypes` requires stsh:StarShacl"@en,
            "rdf:type is always implicitly allowed on a closed shape. sh:ignoredProperties is needed to permit other \"bookkeeping\" properties (e.g. dcterms:created) without listing each as sh:property."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        rdfs:seeAlso sh:ignoredProperties ;
        skos:example "ex:PersonShape sh:closed true ; sh:property [ sh:path ex:name ] . — ex:Person nodes may *only* have ex:name (and rdf:type)."@en ;
        sh:description "When true, a conforming focus node may only have values for paths explicitly listed via sh:property (plus anything in sh:ignoredProperties) — any other property present is a violation. SHACL 1.2 adds sh:ByTypes, which closes the shape per-rdf:type rather than universally, useful when a class hierarchy adds properties incrementally."@en ;
        sh:name "closed"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:construct rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-rules/> ;
        rdfs:seeAlso sh:SPARQLRule ;
        skos:example "sh:construct \"PREFIX ex: <http://example.org/> CONSTRUCT { $this ex:ancestor ?a } WHERE { $this ex:parent ?a }\""@en ;
        sh:description "The SPARQL CONSTRUCT query text for a sh:SPARQLRule — its WHERE clause is evaluated once per matching focus node (bound to $this), and every triple in its result is added to the data graph."@en ;
        sh:name "CONSTRUCT query"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:defaultValue rdfs:comment "The value is checked when a shapes graph is validated: at most one, and a well-formed node expression (stsh:DefaultValueShape)."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:path ex:status ; sh:defaultValue \"pending\""@en ;
        sh:description "A suggested default value for a property shape, for a UI to pre-fill when creating a new instance. Purely informational — has no effect on validation."@en ;
        sh:name "default value"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:description rdfs:comment "The value is checked when a shapes graph is validated: an xsd:string or language-tagged string (stsh:NameAndDescriptionShape)."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "A longer human-readable explanation of a shape's purpose — again, the same property this file uses for every predicate's own description."@en ;
        sh:name "description"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:group rdfs:comment "The value is checked when a shapes graph is validated: an instance of sh:PropertyGroup (stsh:GroupShape)."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "Links a property shape to a sh:PropertyGroup, letting a UI cluster related fields into named sections — exactly how this presentation file's own groups (Targeting, Cardinality, etc.) work."@en ;
        sh:name "group"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:hasValue rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:in ;
        skos:example "sh:path rdf:type ; sh:hasValue ex:Person — requires the focus node to be typed ex:Person (among possibly other types)."@en ;
        sh:description "At least one value node must equal exactly this one specific value — the opposite granularity from sh:in (one required value, rather than a list of allowed ones)."@en ;
        sh:name "has value"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:maxExclusive rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "Every value node must be strictly less than this value."@en ;
        sh:name "maximum exclusive value"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:minInclusive rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:maxInclusive,
            sh:minExclusive ;
        skos:example "sh:path ex:age ; sh:minInclusive 0"@en ;
        sh:description "Every value node must be numerically or ordinally ≥ this value. Requires an orderable datatype (numbers, dates)."@en ;
        sh:name "minimum inclusive value"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:minLength rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:maxLength ;
        skos:example "sh:path ex:username ; sh:minLength 3"@en ;
        sh:description "The string form of every value node must have at least this many characters. Applies to both literals and IRIs (an IRI's length is measured too)."@en ;
        sh:name "minimum length"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:minListLength rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        rdfs:seeAlso sh:maxListLength ;
        skos:example "sh:path ex:coordinates ; sh:minListLength 2"@en ;
        sh:description "The value node must be a well-formed SHACL list with at least this many members."@en ;
        sh:name "minimum list length"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:name rdfs:comment "The value is checked when a shapes graph is validated: an xsd:string or language-tagged string (stsh:NameAndDescriptionShape)."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:name \"email address\"@en"@en ;
        sh:description "A short, human-readable label for a shape — this exact same annotation property is what this presentation file itself uses for every predicate's display label."@en ;
        sh:name "name"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:not rdfs:comment "Negating a shape with its own violations can be confusing to debug — the validation report shows that sh:not's inner shape *did* conform (which is why the outer shape failed), which reads backwards at first glance."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:not [ sh:hasValue ex:Deleted ]"@en ;
        sh:description "A value node conforms only if it does *not* conform to the given shape — logical negation. A common way to express \"must not be of this type\" or \"must not match this pattern.\""@en ;
        sh:name "not"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:parameter rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-sparql/> ;
        rdfs:seeAlso sh:ConstraintComponent ;
        skos:example "sh:parameter [ sh:path ex:minScore ; sh:optional false ]"@en ;
        sh:description "Declares one input parameter of a custom sh:ConstraintComponent — the parameter's own sh:path becomes the predicate a shape uses to supply that argument's value (e.g. ex:minScore in the example above)."@en ;
        sh:name "parameter"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:pattern rdfs:comment "SHACL patterns are *not* implicitly anchored — sh:pattern \"abc\" matches a value that merely *contains* \"abc\" anywhere, not one that equals it. Use ^...$ explicitly for a full-string match."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:flags ;
        skos:example "sh:path ex:productCode ; sh:pattern \"^[A-Z]{3}-[0-9]{4}$\""@en ;
        sh:description "Every value node's string form must match this regular expression (XPath/XSD regex syntax, not PCRE — mostly compatible, but check character class and anchoring differences for anything nontrivial)."@en ;
        sh:name "pattern"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:qualifiedValueShapesDisjoint rdfs:comment "Only affects counting against *sibling* qualified shapes on the same sh:property blank node list — it has no effect with only one sh:qualifiedValueShape present."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "When true, a value node counted toward *this* qualified shape's count is excluded from counting toward any sibling qualified shape on the same property shape — prevents one value from double-counting across two overlapping qualified constraints."@en ;
        sh:name "qualified value shapes disjoint"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:reifierShape rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        rdfs:seeAlso sh:reificationRequired ;
        skos:example "sh:path ex:claims ; sh:reifierShape [ sh:property [ sh:path ex:confidence ; sh:minCount 1 ] ] — every reifier of a claim must carry a confidence score."@en ;
        sh:description "Requires that the reifier of a triple term (the node connected to it via rdf:reifies) conforms to the given shape — a way to put constraints on the metadata *about* a statement, not just the statement's own subject/predicate/object."@en ;
        sh:name "reifier shape"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:rule rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-rules/> ;
        rdfs:seeAlso sh:SPARQLRule,
            sh:TripleRule,
            sh:condition ;
        skos:example "ex:R sh:rule [ a sh:TripleRule ; sh:subject sh:this ; sh:predicate ex:derived ; sh:object [ sh:path ex:source ] ]"@en ;
        sh:description "Attaches a SHACL-AF inference rule to a shape, applied to every focus node the shape targets when rule execution (not plain validation) is requested. sh:TripleRule and sh:SPARQLRule are the two concrete rule types."@en ;
        sh:name "rule"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:singleLine rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "sh:path ex:title ; sh:singleLine true"@en ;
        sh:description "When true, every value node's string form must not contain a line break — a lightweight way to reject accidentally-pasted multi-paragraph text in a field meant to hold a short label."@en ;
        sh:name "single line"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:someValue rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        rdfs:seeAlso sh:node ;
        skos:example "sh:path ex:contactMethod ; sh:someValue [ sh:datatype xsd:anyURI ] — at least one contact method must be a URI, others can be anything."@en ;
        sh:description "At least one value node must conform to the given shape. Unlike sh:node (which requires *every* value node to conform), a single non-conforming value here is not itself a violation — only the absence of *any* conforming value is."@en ;
        sh:name "some value"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:subsetOf rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        rdfs:seeAlso sh:equals ;
        skos:example "sh:path ex:selectedTags ; sh:subsetOf ex:availableTags"@en ;
        sh:description "The set of value nodes at this shape's path must be a subset of the set of value nodes at the given path — every value here must also appear there, but not vice versa."@en ;
        sh:name "subset of"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:targetClass rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:rootClass,
            sh:targetNode ;
        skos:example "ex:PersonShape sh:targetClass ex:Person ."@en ;
        sh:description "Every instance of this class (including subclasses, when RDFS/OWL reasoning is used) is a focus node for the shape. The most common way to attach a shape to \"all things of type X.\""@en ;
        sh:name "target class"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:uniqueMembers rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "sh:path ex:coordinates ; sh:uniqueMembers true"@en ;
        sh:description "When true, the value node must be a well-formed SHACL list with no duplicate members (by RDF term equality)."@en ;
        sh:name "unique members"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:uniqueValuesFor rdfs:comment "Because this checks *across* focus nodes rather than within one, it needs the *entire* batch of candidate focus nodes evaluated together — composing it inside sh:and/sh:or/sh:not/sh:node/sh:qualifiedValueShape requires special handling to still see the full batch (which starShacl's native components provide — see docs/shacl12-gap-matrix.md)."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "ex:PersonShape sh:targetClass ex:Person ; sh:uniqueValuesFor ex:username ."@en ;
        sh:description "Requires that the values reached via the given path (or list of paths) are unique *across every focus node* the shape applies to — not just within one focus node, like sh:uniqueLang/sh:uniqueMembers are. The classic use is enforcing a unique key (e.g. no two people share a username)."@en ;
        sh:name "unique values for"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:zeroOrMorePath rdfs:comment "Zero repetitions means the *starting node itself* is included in the match set — easy to forget when counting results."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:oneOrMorePath,
            sh:zeroOrOnePath ;
        skos:example "sh:path [ sh:zeroOrMorePath rdfs:subClassOf ]"@en ;
        sh:description "Matches the given path repeated zero or more times — the SHACL equivalent of a regular expression's *. Commonly used to walk a transitive hierarchy (e.g. every ancestor via rdfs:subClassOf*)."@en ;
        sh:name "zero-or-more path"@en ;
        stsh:requiredEngine stsh:PySHACL .

    shsh:PropertyShapeShape a sh:NodeShape ;
        sh:or ( [ sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:or ( shsh:PathShape [ sh:nodeKind sh:IRI ] ) ;
                            sh:path sh:path ] ] [ sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:node stsh:NodeExpressionShape ;
                            sh:path sh:expression ] ] ) ;
        sh:property [ sh:deactivated true ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:node shsh:PathShape ;
                sh:path sh:path ] ;
        sh:targetObjectsOf sh:property .

    stsh:IRIOrListOfIRIsShape a sh:NodeShape ;
        rdfs:label "IRI or list of IRIs"@en ;
        rdfs:comment "SHACL 1.2 widened several single-IRI-valued parameters (sh:class, sh:datatype, sh:rootClass, sh:uniqueValuesFor) to also accept a well-formed SHACL list of IRIs, meaning a union of the listed values."@en ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:node shsh:ListShape ;
                    sh:property [ sh:path [ sh:zeroOrMorePath rdf:rest ] ;
                            sh:property [ sh:nodeKind sh:IRI ;
                                    sh:path rdf:first ] ] ] ) .

    sh:ConstraintComponent rdfs:comment "Requires at least one non-optional sh:parameter — a component with only optional parameters fails to load."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-sparql/> ;
        rdfs:seeAlso sh:parameter,
            sh:validator ;
        skos:example "ex:MinScoreConstraintComponent a sh:ConstraintComponent ; sh:parameter [ sh:path ex:minScore ] ; sh:validator [ a sh:SPARQLAskValidator ; sh:ask \"...\" ]"@en ;
        sh:description "Declares a reusable, user-defined SHACL constraint type, similar to a built-in one like sh:minCount. Combines one or more sh:parameter declarations with a sh:validator (or sh:nodeValidator/sh:propertyValidator) that implements the check."@en ;
        sh:name "constraint component"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:alternativePath rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:path [ sh:alternativePath ( schema:name rdfs:label ) ]"@en ;
        sh:description "A list of paths, any one of which may match — like a logical OR over predicates. Useful when a value could arrive via one of several equivalent properties (e.g. schema:name or rdfs:label)."@en ;
        sh:name "alternative path"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:and rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:or,
            sh:xone ;
        skos:example "sh:and ( ex:HasNameShape ex:HasEmailShape )"@en ;
        sh:description "A value node must conform to every shape in this list — logical conjunction. Rarely needed for simple cases (a single node shape's own constraints are already implicitly ANDed), but useful for combining reusable shape fragments."@en ;
        sh:name "and"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:ask rdfs:comment "Unlike sh:select, false means *violation* here — the query must return true for conformance, the opposite polarity from a SELECT constraint's \"any row is a violation.\""@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-sparql/> ;
        rdfs:seeAlso sh:select ;
        skos:example "sh:validator [ a sh:SPARQLAskValidator ; sh:ask \"ASK { FILTER (?value >= ?minScore) }\" ]"@en ;
        sh:description "The SPARQL ASK query text for a custom sh:ConstraintComponent's generic sh:validator. The value node conforms only if the query returns true."@en ;
        sh:name "ASK query"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:class rdfs:comment "A list value here means \"any of these classes,\" not \"all of these classes\" — for an intersection, nest a separate sh:node shape instead."@en,
            "plain single-value form only — the SHACL 1.2 list-valued form requires stsh:StarShacl"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        rdfs:seeAlso sh:datatype,
            sh:nodeKind ;
        skos:example "sh:path ex:employer ; sh:class ex:Organization"@en ;
        sh:description "Every value node must be an instance of this class (or a subclass, under RDFS/OWL reasoning). SHACL 1.2 widens this to also accept a list of classes — the value must be an instance of *at least one* of them (a union, not an intersection)."@en ;
        sh:name "class"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:condition rdfs:comment "The condition shape needs a real constraint to be discriminating — a shape with only a target predicate (e.g. sh:targetClass) trivially \"conforms\" for any node when checked ad hoc, since targeting doesn't itself constrain anything."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-rules/> ;
        skos:example "sh:rule [ a sh:TripleRule ; sh:condition ex:AdultShape ; ... ]"@en ;
        sh:description "Restricts which focus nodes a rule actually applies to — only nodes conforming to the given shape have the rule run for them; every other focus node is skipped entirely for that rule."@en ;
        sh:name "condition"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:datatype rdfs:comment "plain single-value form only — the SHACL 1.2 list-valued form requires stsh:StarShacl"@en,
            "xsd:integer and xsd:int/xsd:decimal are *not* the same datatype to SHACL — the match is exact, not numerically-compatible."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "sh:path ex:age ; sh:datatype xsd:integer"@en ;
        sh:description "Every value node must be a literal with this exact XSD (or other) datatype IRI. SHACL 1.2 widens this to also accept a list of datatypes (a union, same as sh:class)."@en ;
        sh:name "datatype"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:flags rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "Regex flags to apply alongside sh:pattern (e.g. \"i\" for case-insensitive). Has no effect without a sh:pattern on the same shape."@en ;
        sh:name "flags"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:inversePath rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:path [ sh:inversePath ex:parent ] — matches a node's children, by walking ex:parent triples backwards."@en ;
        sh:description "Traverses a triple backwards — from object to subject — instead of the normal subject-to-object direction. Used to write constraints in terms of \"things that point at me\" rather than \"things I point at.\""@en ;
        sh:name "inverse path"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:maxInclusive rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:path ex:percentage ; sh:maxInclusive 100"@en ;
        sh:description "Every value node must be numerically or ordinally ≤ this value."@en ;
        sh:name "maximum inclusive value"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:maxLength rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "The string form of every value node must have at most this many characters."@en ;
        sh:name "maximum length"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:maxListLength rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        sh:description "The value node must be a well-formed SHACL list with at most this many members."@en ;
        sh:name "maximum list length"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:minExclusive rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:path ex:temperature ; sh:minExclusive 0 — must be above absolute freezing on some scale, never equal to it."@en ;
        sh:description "Every value node must be strictly greater than this value (boundary itself not allowed)."@en ;
        sh:name "minimum exclusive value"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:oneOrMorePath rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:path [ sh:oneOrMorePath ex:parent ] — every ancestor, not including the node itself."@en ;
        sh:description "Matches the given path repeated one or more times — like + in a regular expression. Same as sh:zeroOrMorePath but excludes the zero-repetition (starting-node) case."@en ;
        sh:name "one-or-more path"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:order rdfs:comment "The value is checked when a shapes graph is validated: at most one, a decimal (stsh:OrderShape)."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "A number suggesting where a property shape should appear relative to its siblings when a UI renders a form — lower numbers first. Purely a rendering hint."@en ;
        sh:name "order"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:property rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "ex:PersonShape sh:property [ sh:path ex:email ; sh:minCount 1 ]"@en ;
        sh:description "Attaches a property shape to a node shape. Nearly every real-world shape uses this — it's how a node shape says \"and also, here's a constraint on one of my properties.\""@en ;
        sh:name "property"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:qualifiedMaxCount rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "The maximum number of value nodes that may conform to the sibling sh:qualifiedValueShape."@en ;
        sh:name "qualified maximum count"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:qualifiedMinCount rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "The minimum number of value nodes that must conform to the sibling sh:qualifiedValueShape."@en ;
        sh:name "qualified minimum count"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:reificationRequired rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        sh:description "When true, every triple term reached by the shape's path must actually have at least one reifier in the data — not just be well-formed, but be genuinely annotated/reified somewhere."@en ;
        sh:name "reification required"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:sparql rdfs:comment "The query must project $this (or ?this); MINUS and VALUES against pre-bound variables are disallowed per spec."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-sparql/> ;
        rdfs:seeAlso sh:ConstraintComponent,
            sh:select ;
        skos:example "sh:sparql [ sh:select \"SELECT $this WHERE { FILTER NOT EXISTS { $this ex:email ?e } }\" ]"@en ;
        sh:description "Attaches a SPARQL-based constraint to a shape — the query is evaluated once per focus node, and any result row it returns is treated as a violation."@en ;
        sh:name "SPARQL constraint"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:targetNode rdfs:comment "Doesn't scale — for validating \"all instances of a class,\" use sh:targetClass instead."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "ex:AliceShape sh:targetNode ex:alice ."@en ;
        sh:description "A single, specific IRI or literal is a focus node for the shape, regardless of its type. Useful for validating one known resource directly, or in training examples where you want to point at exactly one node."@en ;
        sh:name "target node"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:targetObjectsOf rdfs:comment "Easy to mix up with sh:targetSubjectsOf — subjects-of targets the thing *with* the property, objects-of targets the thing *pointed to*."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:targetSubjectsOf ;
        skos:example "sh:targetObjectsOf ex:manager — targets every node that's someone's manager."@en ;
        sh:description "Any node that appears as the *object* of at least one triple with this predicate becomes a focus node — the mirror image of sh:targetSubjectsOf."@en ;
        sh:name "target objects of"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:targetSubjectsOf rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:targetObjectsOf ;
        skos:example "sh:targetSubjectsOf ex:email — targets every node with at least one ex:email value."@en ;
        sh:description "Any node that is the subject of at least one triple with this predicate becomes a focus node. A quick way to target \"everything that has an ex:email,\" without needing a shared class."@en ;
        sh:name "target subjects of"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:uniqueLang rdfs:comment "plain language-tag uniqueness only — `rdf:dirLangString` direction-awareness requires stsh:StarShacl"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "sh:path ex:label ; sh:uniqueLang true"@en ;
        sh:description "When true, at most one value node may use each language tag — prevents two \"Hello\"@en values on the same focus node, without restricting which languages are used at all. SHACL 1.2 extends the uniqueness condition to also consider base direction for rdf:dirLangString values (\"1\"@ar--rtl and \"1\"@ar--ltr are different, as is the pair \"1\"@ar--rtl and \"1\"@ar)."@en ;
        sh:name "unique language"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:validator rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-sparql/> ;
        rdfs:seeAlso sh:ask,
            sh:nodeValidator,
            sh:propertyValidator ;
        sh:description "The generic SPARQL ASK validator for a custom sh:ConstraintComponent, used when the component doesn't need to distinguish node vs. property shapes."@en ;
        sh:name "validator"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:zeroOrOnePath rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        sh:description "Matches the given path zero times (the node itself) or exactly once — like ? in a regular expression. Useful for \"this node, or its immediate parent if it has one.\""@en ;
        sh:name "zero-or-one path"@en ;
        stsh:requiredEngine stsh:PySHACL .

    shsh:ListShape a sh:NodeShape ;
        rdfs:label "List shape"@en ;
        rdfs:comment "A shape describing well-formed RDF lists. Currently does not check for non-recursion (this could be expressed using SHACL-SPARQL)."@en ;
        rdfs:seeAlso <https://www.w3.org/TR/shacl/#syntax-rule-SHACL-list> ;
        sh:property [ rdfs:comment "Each list member (including this node) must have the shape shsh:ListNodeShape."@en ;
                sh:hasValue () ;
                sh:node shsh:ListNodeShape ;
                sh:path [ sh:zeroOrMorePath rdf:rest ] ] .

    shsh:NodeShapeShape a sh:NodeShape ;
        sh:property [ sh:maxCount 0 ;
                sh:path sh:expression ],
            [ sh:maxCount 0 ;
                sh:path sh:path ],
            [ sh:maxCount 0 ;
                sh:path sh:lessThan ],
            [ sh:maxCount 0 ;
                sh:path sh:lessThanOrEquals ],
            [ sh:maxCount 0 ;
                sh:path sh:maxCount ],
            [ sh:maxCount 0 ;
                sh:path sh:minCount ],
            [ sh:maxCount 0 ;
                sh:path sh:qualifiedValueShape ],
            [ sh:maxCount 0 ;
                sh:path sh:uniqueLang ] ;
        sh:targetObjectsOf sh:node .

    shsh:PathNodeShape sh:xone ( [ sh:nodeKind sh:IRI ] [ sh:memberShape shsh:PathShape ;
                    sh:minListLength 2 ;
                    sh:nodeKind sh:BlankNode ] [ sh:closed true ;
                    sh:nodeKind sh:BlankNode ;
                    sh:property [ sh:maxCount 1 ;
                            sh:memberShape shsh:PathShape ;
                            sh:minCount 1 ;
                            sh:minListLength 2 ;
                            sh:path sh:alternativePath ] ] [ sh:closed true ;
                    sh:nodeKind sh:BlankNode ;
                    sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path sh:inversePath ] ] [ sh:closed true ;
                    sh:nodeKind sh:BlankNode ;
                    sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path sh:zeroOrMorePath ] ] [ sh:closed true ;
                    sh:nodeKind sh:BlankNode ;
                    sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path sh:oneOrMorePath ] ] [ sh:closed true ;
                    sh:nodeKind sh:BlankNode ;
                    sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path sh:zeroOrOnePath ] ] ) .

    shui:editor rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        rdfs:seeAlso shui:viewer ;
        skos:example "sh:property [ sh:path ex:birthDate ; shui:editor shui:DatePickerEditor ]"@en ;
        sh:description "Suggests which widget a form-generating UI should use to *edit* this property shape's values — one of the built-in editors below, or a custom one."@en ;
        sh:name "editor widget"@en ;
        stsh:requiredEngine stsh:StarShacl .

    shui:viewer rdfs:comment "ignored by validation; read by starlayer.shacl.ui_widget_selection when it chooses a widget (see docs/guides/04d-shacl-ui.ipynb)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        rdfs:seeAlso shui:editor ;
        skos:example "sh:property [ sh:path ex:homepage ; shui:viewer shui:HyperlinkViewer ]"@en ;
        sh:description "Suggests which widget a UI should use to *display* (read-only) this property shape's values, as opposed to editing them."@en ;
        sh:name "viewer widget"@en ;
        stsh:requiredEngine stsh:StarShacl .

    stsh:SelectValidatorShape a sh:NodeShape ;
        rdfs:label "Well-formed SELECT validator"@en ;
        rdfs:comment "The value of sh:nodeValidator/sh:propertyValidator on a custom sh:ConstraintComponent, and of sh:sparql's own SPARQLConstraint value - pySHACL requires exactly one sh:select (an xsd:string) (SelectConstraintValidator.__init__, SPARQLBasedConstraint.__init__)."@en ;
        sh:property [ sh:datatype xsd:string ;
                sh:maxCount 1 ;
                sh:minCount 1 ;
                sh:path sh:select ] .

    sh:SPARQLRule rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-rules/> ;
        rdfs:seeAlso sh:TripleRule,
            sh:construct ;
        skos:example "[ a sh:SPARQLRule ; sh:construct \"CONSTRUCT { $this ex:ancestor ?a } WHERE { $this ex:parent+ ?a }\" ]"@en ;
        sh:description "A rule type that derives new triples via an arbitrary SPARQL CONSTRUCT query (sh:construct), for derivations too complex for a single sh:TripleRule."@en ;
        sh:name "SPARQL rule"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:disjoint rdfs:comment "plain-IRI object only — the SHACL 1.2 path-valued form requires stsh:StarShacl"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "sh:path ex:blockedUsers ; sh:disjoint ex:friends — a user can't be both blocked and a friend."@en ;
        sh:description "The set of value nodes at this shape's path must share *no* members with the set of value nodes at the given path. SHACL 1.2 widens the object to any property path."@en ;
        sh:name "disjoint"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:languageIn rdfs:comment "plain literals only — `rdf:dirLangString` recognition requires stsh:StarShacl"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:path ex:label ; sh:languageIn ( \"en\" \"en-US\" \"fr\" )"@en ;
        sh:description "Every value node must be a language-tagged literal (or rdf:dirLangString under RDF 1.2) whose language tag is in this list. A plain literal with no language tag never matches."@en ;
        sh:name "language in"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:maxCount rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:minCount ;
        skos:example "sh:path ex:birthDate ; sh:maxCount 1"@en ;
        sh:description "The maximum number of value nodes a path may have for a given focus node. sh:maxCount 1 is the standard way to express \"at most one value\" (a functional property)."@en ;
        sh:name "maximum count"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:minCount rdfs:comment "A frequent mistake: writing sh:minCount 0 to mean \"optional.\" This is a no-op — 0 is already the default. Omit sh:minCount entirely for an optional property."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:maxCount ;
        skos:example "sh:path ex:email ; sh:minCount 1 — every focus node must have at least one ex:email value."@en ;
        sh:description "The minimum number of value nodes a path must have for a given focus node. sh:minCount 1 is the standard way to express \"this property is required.\" There is no default minimum — omitting sh:minCount means any number of values, including zero, is allowed."@en ;
        sh:name "minimum count"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:node rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:path ex:address ; sh:node ex:AddressShape"@en ;
        sh:description "Every value node must conform to the given (node) shape. The main way to nest shapes — validating the *shape* of a related resource, not just a scalar constraint on it."@en ;
        sh:name "node"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:nodeValidator rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-sparql/> ;
        rdfs:seeAlso sh:propertyValidator,
            sh:select ;
        sh:description "A SELECT-based validator for a custom sh:ConstraintComponent, used specifically when the component is applied via a node shape."@en ;
        sh:name "node validator"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:object rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-rules/> ;
        rdfs:seeAlso sh:TripleRule,
            sh:predicate,
            sh:subject ;
        sh:description "The node expression producing the object of the triple a sh:TripleRule derives — often a shnex:pathValues/sh:path expression pulling a value from elsewhere in the data."@en ;
        sh:name "object expression"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:or rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:or ( [ sh:datatype xsd:string ] [ sh:datatype xsd:integer ] )"@en ;
        sh:description "A value node must conform to at least one shape in this list — logical disjunction. Commonly used to allow a value to be one of several alternative shapes (e.g. either an IRI reference or an inline literal)."@en ;
        sh:name "or"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:predicate rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-rules/> ;
        rdfs:seeAlso sh:TripleRule,
            sh:object,
            sh:subject ;
        sh:description "The node expression producing the predicate of the triple a sh:TripleRule derives — typically a constant IRI naming the derived property."@en ;
        sh:name "predicate expression"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:propertyValidator rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-sparql/> ;
        rdfs:seeAlso sh:nodeValidator,
            sh:select ;
        sh:description "A SELECT-based validator for a custom sh:ConstraintComponent, used specifically when the component is applied via a property shape."@en ;
        sh:name "property validator"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:qualifiedValueShape rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:qualifiedMaxCount,
            sh:qualifiedMinCount ;
        skos:example "sh:path ex:contact ; sh:qualifiedValueShape ex:PhoneShape ; sh:qualifiedMinCount 1"@en ;
        sh:description "Works together with sh:qualifiedMinCount/sh:qualifiedMaxCount to count *how many* value nodes conform to a given shape (rather than requiring all or none to conform, like sh:node does)."@en ;
        sh:name "qualified value shape"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:rootClass rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        rdfs:seeAlso sh:class ;
        skos:example "sh:path ex:worksFor ; sh:rootClass ex:Organization — the value must be ex:Organization itself or a transitive subclass of it."@en ;
        sh:description "Every value node must be an IRI that is, or is a transitive rdfs:subClassOf subclass of, this class - like sh:class but subclass-aware without needing full RDFS/OWL reasoning enabled. Not a targeting mechanism (despite the similar name to implicit class-based targeting) - it constrains a property's value nodes, the same role as sh:class/sh:datatype/sh:nodeKind."@en ;
        sh:name "root class"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:subject rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-rules/> ;
        rdfs:seeAlso sh:TripleRule,
            sh:object,
            sh:predicate ;
        sh:description "The node expression producing the subject of the triple a sh:TripleRule derives — most commonly just sh:this, the rule's own focus node."@en ;
        sh:name "subject expression"@en ;
        stsh:requiredEngine stsh:PySHACL .

    shsh:PathShape a sh:NodeShape ;
        rdfs:label "Path shape"@en ;
        rdfs:comment "A shape that can be used to validate the syntax rules of well-formed SHACL paths."@en ;
        rdfs:seeAlso <https://www.w3.org/TR/shacl/#property-paths> ;
        sh:property [ sh:node shsh:PathNodeShape ;
                sh:path [ sh:zeroOrMorePath [ sh:alternativePath ( ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ( sh:alternativePath [ sh:zeroOrMorePath rdf:rest ] rdf:first ) sh:inversePath sh:zeroOrMorePath sh:oneOrMorePath sh:zeroOrOnePath ) ] ] ] .

    shui:propertyRole rdfs:comment "ignored by validation; not interpreted by starlayer.shacl (property roles are documented here but not implemented)"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
        skos:example "sh:property [ sh:path ex:name ; shui:propertyRole shui:LabelRole ]"@en ;
        sh:description "Marks a property shape as playing a special semantic role for UI purposes — currently just shui:LabelRole, marking \"this is the property whose value should be used as the resource's own display label.\""@en ;
        sh:name "property role"@en ;
        stsh:requiredEngine stsh:StarShacl .

    stsh:IRIOrPathShape a sh:NodeShape ;
        rdfs:label "IRI or SHACL property path"@en ;
        rdfs:comment "SHACL 1.2 widened sh:equals/sh:disjoint/sh:lessThan/sh:lessThanOrEquals from a single comparison-property IRI to a full SHACL property path expression. Reuses the Working Group's shsh:PathNodeShape (present once this file is merged with the Working Group's meta-shapes graph) rather than re-deriving SHACL's path grammar."@en ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:node shsh:PathNodeShape ] ) .

    stsh:ShapeReferenceShape a sh:NodeShape ;
        rdfs:label "Well-formed shape reference"@en ;
        rdfs:comment "Used for SHACL 1.2 predicates whose value must itself be a well-formed shape (sh:someValue, sh:memberShape, sh:reifierShape). sh:node's semantics evaluate the referenced shape's own constraint components regardless of that shape's own targets, so referencing shsh:ShapeShape here checks full shape well-formedness, not just the node/property-shape distinction. sh:nodeKind is added on top because the Working Group's shsh:ShapeShape doesn't itself enforce blank-node-or-IRI - a bare literal vacuously satisfies shsh:NodeShapeShape's xone branch (every one of its checks is a maxCount 0 'must not have' rule, trivially true for a literal with no outgoing properties at all), so without this a literal value would incorrectly pass as 'a well-formed shape'."@en ;
        sh:node shsh:ShapeShape ;
        sh:nodeKind sh:BlankNodeOrIRI .

    sh:equals rdfs:comment "plain-IRI object only — the SHACL 1.2 path-valued form requires stsh:StarShacl"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "sh:path ex:homeAddress ; sh:equals ex:mailingAddress"@en ;
        sh:description "The set of value nodes at this shape's path must be exactly equal (as a set) to the set of value nodes at the given path or property. SHACL 1.2 widens the object from a plain IRI to any property path."@en ;
        sh:name "equals"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:ignoredProperties rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:ignoredProperties ( rdf:type dcterms:created )"@en ;
        sh:description "A list of properties exempted from sh:closed's restriction — present without needing a matching sh:property entry."@en ;
        sh:name "ignored properties"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:lessThan rdfs:comment "plain-IRI object only — the SHACL 1.2 path-valued form requires stsh:StarShacl"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        rdfs:seeAlso sh:lessThanOrEquals ;
        skos:example "sh:path ex:startDate ; sh:lessThan ex:endDate"@en ;
        sh:description "Every value node at this shape's path must be strictly less than every value node at the given path, for the same focus node. Requires an orderable datatype. SHACL 1.2 widens the object to any property path."@en ;
        sh:name "less than"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:memberShape rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "sh:path ex:tags ; sh:memberShape [ sh:datatype xsd:string ]"@en ;
        sh:description "The value node must be a well-formed SHACL list, and every member of that list must conform to the given shape. Combines list-well-formedness checking with per-member validation in one predicate."@en ;
        sh:name "member shape"@en ;
        stsh:requiredEngine stsh:StarShacl .

    sh:nodeKind rdfs:comment "plain single-value form only — the SHACL 1.2 list-valued form requires stsh:StarShacl"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        skos:example "sh:path ex:homepage ; sh:nodeKind sh:IRI — the value must be a real IRI, not a literal string."@en ;
        sh:description "Restricts what *kind* of RDF term a value node may be, independent of class or datatype: sh:IRI, sh:BlankNode, sh:Literal, or one of the three compound kinds (sh:BlankNodeOrIRI, sh:BlankNodeOrLiteral, sh:IRIOrLiteral). SHACL 1.2 widens this to also accept a list of node kinds."@en ;
        sh:name "node kind"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:path rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:alternativePath,
            sh:inversePath ;
        skos:example "sh:path ex:email — the simple case, a single predicate."@en ;
        sh:description "Required on every property shape. Names the property more complex path expression that connects a focus node to its value nodes. The simplest form is a single IRI; SHACL also supports sequence, alternative, inverse, and repeated (*/+/?) paths."@en ;
        sh:name "path"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:select rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-sparql/> ;
        rdfs:seeAlso sh:ask,
            sh:sparql ;
        skos:example "sh:select \"SELECT $this ?value WHERE { ?value ex:score ?s . FILTER (?s < 0) }\""@en ;
        sh:description "The SPARQL SELECT query text for a sh:sparql constraint or a custom sh:ConstraintComponent's sh:nodeValidator/sh:propertyValidator. Any row returned counts as a violation; bindings for ?value/?path/?this in the result customize the reported focus/value/path."@en ;
        sh:name "SELECT query"@en ;
        stsh:requiredEngine stsh:PySHACL .

    stsh:NodeExpressionShape a sh:NodeShape ;
        rdfs:label "Well-formed SHACL node expression"@en ;
        rdfs:comment "Accepts a constant (IRI/literal), sh:this, a blank node carrying a known sh:/shnex: node-expression defining predicate, a blank node structurally shaped like a SHACL Function call or a custom List Parameter Function call, or a call to a declared custom Named Parameter Expression Function. Deliberately shallow beyond that - see rdfs:comment on stsh:NodeExpressionFunctionCallShape and the section header above for the exact scope boundary."@en ;
        sh:or ( [ sh:nodeKind sh:IRIOrLiteral ] [ sh:nodeKind sh:BlankNode ;
                    sh:or ( [ sh:property [ sh:minCount 1 ;
                                        sh:node shsh:PathNodeShape ;
                                        sh:path sh:path ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path sh:union ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path sh:intersection ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path sh:nodes ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path sh:filterShape ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:pathValues ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:filterShape ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:var ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:if ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:exists ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:distinct ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:remove ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:intersection ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:concat ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:orderBy ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:limit ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:offset ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:flatMap ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:findFirst ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:matchAll ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:count ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:min ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:max ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:sum ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:instancesOf ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:nodesMatching ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:conformsToShape ] ] [ sh:property [ sh:minCount 1 ;
                                        sh:path shnex:arg ] ] stsh:NodeExpressionFunctionCallShape stsh:NamedParameterFunctionCallShape ) ] ) .

    sh:TripleRule rdfs:isDefinedBy <https://www.w3.org/TR/shacl-af/>,
            <https://www.w3.org/TR/shacl12-rules/> ;
        rdfs:seeAlso sh:SPARQLRule,
            sh:object,
            sh:predicate,
            sh:subject ;
        skos:example "[ a sh:TripleRule ; sh:subject sh:this ; sh:predicate ex:ancestor ; sh:object [ sh:path ex:parent ] ]"@en ;
        sh:description "A rule type that derives one new triple per matching focus node from three independently-evaluated node expressions — sh:subject/sh:predicate/sh:object — without needing any SPARQL."@en ;
        sh:name "triple rule"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:lessThanOrEquals rdfs:comment "plain-IRI object only — the SHACL 1.2 path-valued form requires stsh:StarShacl"@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/>,
            <https://www.w3.org/TR/shacl12-core/> ;
        sh:description "Same as sh:lessThan, but allows equality. SHACL 1.2 widens the object to any property path."@en ;
        sh:name "less than or equal to"@en ;
        stsh:requiredEngine stsh:PySHACL .

    shsh:ShapeShape a sh:NodeShape ;
        rdfs:label "Shape shape"@en ;
        rdfs:comment "A shape that can be used to validate syntax rules for other shapes."@en ;
        sh:or ( [ sh:not [ sh:class rdfs:Class ;
                            sh:or ( [ sh:class sh:NodeShape ] [ sh:class sh:PropertyShape ] ) ] ] [ sh:nodeKind sh:IRI ] ),
            ( shsh:NodeShapeShape shsh:PropertyShapeShape ) ;
        sh:property [ sh:nodeKind sh:IRIOrLiteral ;
                sh:path sh:targetNode ],
            [ sh:nodeKind sh:IRI ;
                sh:path sh:targetClass ],
            [ sh:nodeKind sh:IRI ;
                sh:path sh:targetSubjectsOf ],
            [ sh:nodeKind sh:IRI ;
                sh:path sh:targetObjectsOf ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path sh:severity ],
            [ sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
                sh:path sh:message ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:path sh:deactivated ],
            [ sh:memberShape shsh:ShapeShape ;
                sh:path sh:and ],
            [ sh:or ( [ sh:nodeKind sh:IRI ] [ sh:memberShape [ a sh:NodeShape ;
                                    sh:nodeKind sh:IRI ] ] ) ;
                sh:path sh:class ],
            [ sh:maxCount 1 ;
                sh:or ( [ sh:datatype xsd:boolean ] [ sh:hasValue sh:ByTypes ] ) ;
                sh:path sh:closed ],
            [ sh:maxCount 1 ;
                sh:memberShape [ a sh:NodeShape ;
                        sh:nodeKind sh:IRI ] ;
                sh:minListLength 1 ;
                sh:path sh:ignoredProperties ],
            [ sh:maxCount 1 ;
                sh:or ( [ sh:nodeKind sh:IRI ] [ sh:memberShape [ a sh:NodeShape ;
                                    sh:nodeKind sh:IRI ] ] ) ;
                sh:path sh:datatype ],
            [ sh:deactivated true ;
                sh:nodeKind sh:IRI ;
                sh:path sh:disjoint ],
            [ sh:deactivated true ;
                sh:nodeKind sh:IRI ;
                sh:path sh:equals ],
            [ sh:maxCount 1 ;
                sh:path sh:in ],
            [ sh:maxCount 1 ;
                sh:memberShape [ a sh:NodeShape ;
                        sh:datatype xsd:string ] ;
                sh:minListLength 1 ;
                sh:path sh:languageIn ],
            [ sh:deactivated true ;
                sh:nodeKind sh:IRI ;
                sh:path sh:lessThan ],
            [ sh:deactivated true ;
                sh:nodeKind sh:IRI ;
                sh:path sh:lessThanOrEquals ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:minInclusive 0 ;
                sh:path sh:maxCount ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:path sh:maxExclusive ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:path sh:maxInclusive ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:minInclusive 0 ;
                sh:path sh:maxLength ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:minInclusive 0 ;
                sh:path sh:minCount ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:path sh:minExclusive ],
            [ sh:maxCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:path sh:minInclusive ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:minInclusive 0 ;
                sh:path sh:minLength ],
            [ sh:node shsh:NodeShapeShape ;
                sh:path sh:memberShape ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:minInclusive 0 ;
                sh:path sh:minListLength ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:minInclusive 0 ;
                sh:path sh:maxListLength ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:path sh:uniqueMembers ],
            [ sh:deactivated true ;
                sh:in ( sh:BlankNode sh:IRI sh:Literal sh:BlankNodeOrIRI sh:BlankNodeOrLiteral sh:IRIOrLiteral ) ;
                sh:maxCount 1 ;
                sh:path sh:nodeKind ],
            [ sh:memberShape shsh:ShapeShape ;
                sh:path sh:or ],
            [ sh:datatype xsd:string ;
                sh:maxCount 1 ;
                sh:path sh:pattern ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:path sh:singleLine ],
            [ sh:datatype xsd:string ;
                sh:maxCount 1 ;
                sh:path sh:flags ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:minInclusive 0 ;
                sh:path sh:qualifiedMaxCount ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:minInclusive 0 ;
                sh:path sh:qualifiedMinCount ],
            [ sh:maxCount 1 ;
                sh:node shsh:ShapeShape ;
                sh:path sh:qualifiedValueShape ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:path sh:qualifiedValueShapesDisjoint ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:path sh:uniqueLang ],
            [ sh:memberShape shsh:ShapeShape ;
                sh:path sh:xone ] ;
        sh:targetClass sh:NodeShape,
            sh:PropertyShape ;
        sh:targetObjectsOf sh:memberShape,
            sh:node,
            sh:not,
            sh:property,
            sh:qualifiedValueShape ;
        sh:targetSubjectsOf sh:and,
            sh:class,
            sh:closed,
            sh:datatype,
            sh:disjoint,
            sh:equals,
            sh:flags,
            sh:hasValue,
            sh:ignoredProperties,
            sh:in,
            sh:languageIn,
            sh:lessThan,
            sh:lessThanOrEquals,
            sh:maxCount,
            sh:maxExclusive,
            sh:maxInclusive,
            sh:maxLength,
            sh:maxListLength,
            sh:memberShape,
            sh:minCount,
            sh:minExclusive,
            sh:minInclusive,
            sh:minLength,
            sh:minListLength,
            sh:node,
            sh:nodeKind,
            sh:not,
            sh:or,
            sh:pattern,
            sh:property,
            sh:qualifiedMaxCount,
            sh:qualifiedMinCount,
            sh:qualifiedValueShape,
            sh:qualifiedValueShapesDisjoint,
            sh:singleLine,
            sh:targetClass,
            sh:targetNode,
            sh:targetObjectsOf,
            sh:targetSubjectsOf,
            sh:uniqueLang,
            sh:uniqueMembers,
            sh:xone ;
        sh:xone ( shsh:NodeShapeShape shsh:PropertyShapeShape ) .

    sh:in rdfs:comment "List membership is exact-value matching, including datatype — sh:in (1 2 3) (integers) will not match the string \"1\"."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        rdfs:seeAlso sh:hasValue ;
        skos:example "sh:path ex:status ; sh:in ( \"active\" \"inactive\" \"pending\" )"@en ;
        sh:description "Every value node must be exactly one of the members of this list — an enumeration/allow-list constraint."@en ;
        sh:name "in"@en ;
        stsh:requiredEngine stsh:PySHACL .

    sh:xone rdfs:comment "If two shapes in the list overlap (a value could satisfy both), a value that matches both fails sh:xone even though it would pass sh:or — easy to trip over when shapes aren't as mutually exclusive as intended."@en ;
        rdfs:isDefinedBy <https://www.w3.org/TR/shacl/> ;
        skos:example "sh:xone ( ex:IndividualShape ex:OrganizationShape ) — a party is one or the other, never both."@en ;
        sh:description "A value node must conform to *exactly one* shape in this list — not zero, not two or more. Stricter than sh:or, useful when alternatives are meant to be mutually exclusive."@en ;
        sh:name "exactly one"@en ;
        stsh:requiredEngine stsh:PySHACL .
}

starontology:skos-ontology.ttl {
    # Copyright (c) 2009 World Wide Web Consortium. https://www.w3.org/copyright/document-license-2023/
    # SKOS vocabulary: https://www.w3.org/TR/skos-reference/skos.rdf (original, RDF/XML)
    # Part of: SKOS Simple Knowledge Organization System Reference,
    #   W3C Recommendation, 18 August 2009, https://www.w3.org/TR/skos-reference/
    # This file includes material copied from that document, converted from RDF/XML to
    # Turtle with no change to its content.

    skos:altLabel a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "alternative label"@en ;
        rdfs:comment "The range of skos:altLabel is the class of RDF plain literals."@en,
            "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf rdfs:label ;
        skos:definition "An alternative lexical label for a resource."@en ;
        skos:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)."@en .

    skos:changeNote a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "change note"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:note ;
        skos:definition "A note about a modification to a concept."@en .

    skos:definition a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "definition"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:note ;
        skos:definition "A statement or formal explanation of the meaning of a concept."@en .

    skos:editorialNote a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "editorial note"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:note ;
        skos:definition "A note for an editor, translator or maintainer of the vocabulary."@en .

    skos:exactMatch a rdf:Property,
            owl:ObjectProperty,
            owl:SymmetricProperty,
            owl:TransitiveProperty ;
        rdfs:label "has exact match"@en ;
        rdfs:comment "skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch."@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:closeMatch ;
        skos:definition "skos:exactMatch is used to link two concepts, indicating a high degree of confidence that the concepts can be used interchangeably across a wide range of information retrieval applications. skos:exactMatch is a transitive property, and is a sub-property of skos:closeMatch."@en .

    skos:example a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "example"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:note ;
        skos:definition "An example of the use of a concept."@en .

    skos:hiddenLabel a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "hidden label"@en ;
        rdfs:comment "The range of skos:hiddenLabel is the class of RDF plain literals."@en,
            "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties."@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf rdfs:label ;
        skos:definition "A lexical label for a resource that should be hidden when generating visual displays of the resource, but should still be accessible to free text search operations."@en .

    skos:historyNote a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "history note"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:note ;
        skos:definition "A note about the past state/use/meaning of a concept."@en .

    skos:member a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "has member"@en ;
        rdfs:domain skos:Collection ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:range [ a owl:Class ;
                owl:unionOf ( skos:Concept skos:Collection ) ] ;
        skos:definition "Relates a collection to one of its members."@en .

    skos:memberList a rdf:Property,
            owl:FunctionalProperty,
            owl:ObjectProperty ;
        rdfs:label "has member list"@en ;
        rdfs:comment """For any resource, every item in the list given as the value of the
      skos:memberList property is also a value of the skos:member property."""@en ;
        rdfs:domain skos:OrderedCollection ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:range rdf:List ;
        skos:definition "Relates an ordered collection to the RDF list containing its members."@en .

    skos:notation a rdf:Property,
            owl:DatatypeProperty ;
        rdfs:label "notation"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        skos:definition "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme."@en ;
        skos:scopeNote "By convention, skos:notation is used with a typed literal in the object position of the triple."@en .

    skos:prefLabel a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "preferred label"@en ;
        rdfs:comment "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag."@en,
            "The range of skos:prefLabel is the class of RDF plain literals."@en,
            """skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise
      disjoint properties."""@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf rdfs:label ;
        skos:definition "The preferred lexical label for a resource, in a given language."@en .

    skos:relatedMatch a rdf:Property,
            owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:label "has related match"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:mappingRelation,
            skos:related ;
        skos:definition "skos:relatedMatch is used to state an associative mapping link between two conceptual resources in different concept schemes."@en .

    skos:scopeNote a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "scope note"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:note ;
        skos:definition "A note that helps to clarify the meaning and/or the use of a concept."@en .

    skos:OrderedCollection a owl:Class ;
        rdfs:label "Ordered Collection"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subClassOf skos:Collection ;
        skos:definition "An ordered collection of concepts, where both the grouping and the ordering are meaningful."@en ;
        skos:scopeNote "Ordered collections can be used where you would like a set of concepts to be displayed in a specific order, and optionally under a 'node label'."@en .

    skos:broadMatch a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "has broader match"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:broader,
            skos:mappingRelation ;
        owl:inverseOf skos:narrowMatch ;
        skos:definition "skos:broadMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .

    skos:closeMatch a rdf:Property,
            owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:label "has close match"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:mappingRelation ;
        skos:definition "skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of \"compound errors\" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property."@en .

    skos:hasTopConcept a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "has top concept"@en ;
        rdfs:domain skos:ConceptScheme ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:range skos:Concept ;
        owl:inverseOf skos:topConceptOf ;
        skos:definition "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies."@en .

    skos:inScheme a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "is in scheme"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:range skos:ConceptScheme ;
        skos:definition "Relates a resource (for example a concept) to a concept scheme in which it is included."@en ;
        skos:scopeNote "A concept may be a member of more than one concept scheme."@en .

    skos:narrowMatch a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "has narrower match"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:mappingRelation,
            skos:narrower ;
        owl:inverseOf skos:broadMatch ;
        skos:definition "skos:narrowMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes."@en .

    skos:related a rdf:Property,
            owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:label "has related"@en ;
        rdfs:comment "skos:related is disjoint with skos:broaderTransitive"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:semanticRelation ;
        skos:definition "Relates a concept to a concept with which there is an associative semantic relationship."@en .

    skos:topConceptOf a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "is top concept in scheme"@en ;
        rdfs:domain skos:Concept ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:range skos:ConceptScheme ;
        rdfs:subPropertyOf skos:inScheme ;
        owl:inverseOf skos:hasTopConcept ;
        skos:definition "Relates a concept to the concept scheme that it is a top level concept of."@en .

    skos:broader a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "has broader"@en ;
        rdfs:comment "Broader concepts are typically rendered as parents in a concept hierarchy (tree)."@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:broaderTransitive ;
        owl:inverseOf skos:narrower ;
        skos:definition "Relates a concept to a concept that is more general in meaning."@en ;
        skos:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .

    skos:broaderTransitive a rdf:Property,
            owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:label "has broader transitive"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:semanticRelation ;
        owl:inverseOf skos:narrowerTransitive ;
        skos:definition "skos:broaderTransitive is a transitive superproperty of skos:broader." ;
        skos:scopeNote "By convention, skos:broaderTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."@en .

    skos:narrower a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "has narrower"@en ;
        rdfs:comment "Narrower concepts are typically rendered as children in a concept hierarchy (tree)."@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:narrowerTransitive ;
        owl:inverseOf skos:broader ;
        skos:definition "Relates a concept to a concept that is more specific in meaning."@en ;
        skos:scopeNote "By convention, skos:broader is only used to assert an immediate (i.e. direct) hierarchical link between two conceptual resources."@en .

    skos:narrowerTransitive a rdf:Property,
            owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:label "has narrower transitive"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:semanticRelation ;
        owl:inverseOf skos:broaderTransitive ;
        skos:definition "skos:narrowerTransitive is a transitive superproperty of skos:narrower." ;
        skos:scopeNote "By convention, skos:narrowerTransitive is not used to make assertions. Rather, the properties can be used to draw inferences about the transitive closure of the hierarchical relation, which is useful e.g. when implementing a simple query expansion algorithm in a search application."@en .

    skos:Collection a owl:Class ;
        rdfs:label "Collection"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        owl:disjointWith skos:Concept,
            skos:ConceptScheme ;
        skos:definition "A meaningful collection of concepts."@en ;
        skos:scopeNote "Labelled collections can be used where you would like a set of concepts to be displayed under a 'node label' in the hierarchy."@en .

    skos:ConceptScheme a owl:Class ;
        rdfs:label "Concept Scheme"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        owl:disjointWith skos:Concept ;
        skos:definition "A set of concepts, optionally including statements about semantic relationships between those concepts."@en ;
        skos:example "Thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', and other types of controlled vocabulary are all examples of concept schemes. Concept schemes are also embedded in glossaries and terminologies."@en ;
        skos:scopeNote "A concept scheme may be defined to include concepts from different sources."@en .

    skos:mappingRelation a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "is in mapping relation with"@en ;
        rdfs:comment "These concept mapping relations mirror semantic relations, and the data model defined below is similar (with the exception of skos:exactMatch) to the data model defined for semantic relations. A distinct vocabulary is provided for concept mapping relations, to provide a convenient way to differentiate links within a concept scheme from links between concept schemes. However, this pattern of usage is not a formal requirement of the SKOS data model, and relies on informal definitions of best practice."@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:subPropertyOf skos:semanticRelation ;
        skos:definition "Relates two concepts coming, by convention, from different schemes, and that have comparable meanings"@en .

    skos:semanticRelation a rdf:Property,
            owl:ObjectProperty ;
        rdfs:label "is in semantic relation with"@en ;
        rdfs:domain skos:Concept ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        rdfs:range skos:Concept ;
        skos:definition "Links a concept to a concept related by meaning."@en ;
        skos:scopeNote "This property should not be used directly, but as a super-property for all properties denoting a relationship of meaning between concepts."@en .

    skos:note a rdf:Property,
            owl:AnnotationProperty ;
        rdfs:label "note"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        skos:definition "A general note, for any purpose."@en ;
        skos:scopeNote "This property may be used directly, or as a super-property for more specific note types."@en .

    skos:Concept a owl:Class ;
        rdfs:label "Concept"@en ;
        rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
        skos:definition "An idea or notion; a unit of thought."@en .

    <http://www.w3.org/2004/02/skos/core> a owl:Ontology ;
        dcterms:contributor "Dave Beckett",
            "Nikki Rogers",
            "Participants in W3C's Semantic Web Deployment Working Group." ;
        dcterms:creator "Alistair Miles",
            "Sean Bechhofer" ;
        dcterms:description "An RDF vocabulary for describing the basic structure and content of concept schemes such as thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', other types of controlled vocabulary, and also concept schemes embedded in glossaries and terminologies."@en ;
        dcterms:title "SKOS Vocabulary"@en ;
        rdfs:seeAlso <http://www.w3.org/TR/skos-reference/> .
}

starontology:skos_shapes.ttl {
    skshp:ShapesGraph a sh:ShapesGraph ;
        rdfs:member skshp:CollectionDisjointnessShape,
            skshp:CollectionFormShape,
            skshp:ConceptDisjointnessShape,
            skshp:ConceptFormShape,
            skshp:ConceptPrefLabelRecommendedShape,
            skshp:ConceptSchemeDisjointnessShape,
            skshp:ConceptSchemeFormShape,
            skshp:LexicalLabelShape,
            skshp:MappingRelationDisjointnessShape,
            skshp:OrderedCollectionMemberListConsistencyShape,
            skshp:RelatedDisjointWithHierarchicalShape,
            skshp:SemanticRelationDomainRangeShape .

    skshp:CollectionDisjointnessShape a sh:NodeShape ;
        sh:message "S37: skos:Collection is disjoint with skos:Concept and skos:ConceptScheme." ;
        sh:not [ sh:class skos:ConceptScheme ],
            [ sh:class skos:Concept ] ;
        sh:targetClass skos:Collection,
            skos:OrderedCollection .

    skshp:CollectionFormShape a sh:NodeShape ;
        sh:property [ sh:name "member"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 4 ;
                sh:path skos:member ;
                shui:editor shui:IRIEditor ;
                shui:viewer shui:HyperlinkViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "preferred label"@en ;
                sh:order 1 ;
                sh:path skos:prefLabel ;
                shui:editor shui:TextFieldWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "definition"@en ;
                sh:order 3 ;
                sh:path skos:definition ;
                shui:editor shui:TextAreaWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "alternative label"@en ;
                sh:order 2 ;
                sh:path skos:altLabel ;
                shui:editor shui:TextFieldWithLangEditor ;
                shui:viewer shui:LangStringViewer ] .

    skshp:ConceptDisjointnessShape a sh:NodeShape ;
        sh:message "S9/S37: skos:Concept is disjoint with skos:ConceptScheme and skos:Collection." ;
        sh:not [ sh:class skos:OrderedCollection ],
            [ sh:class skos:Collection ],
            [ sh:class skos:ConceptScheme ] ;
        sh:targetClass skos:Concept .

    skshp:ConceptFormShape a sh:NodeShape ;
        sh:property [ sh:datatype rdf:langString ;
                sh:name "change note"@en ;
                sh:order 9 ;
                sh:path skos:changeNote ;
                shui:editor shui:TextAreaWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "editorial note"@en ;
                sh:order 10 ;
                sh:path skos:editorialNote ;
                shui:editor shui:TextAreaWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:class skos:Concept ;
                sh:name "broader concept"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 11 ;
                sh:path skos:broader ;
                shui:editor shui:InstancesSelectEditor ;
                shui:viewer shui:LabelViewer ],
            [ sh:class skos:Concept ;
                sh:name "narrower concept"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 12 ;
                sh:path skos:narrower ;
                shui:editor shui:InstancesSelectEditor ;
                shui:viewer shui:LabelViewer ],
            [ sh:name "notation"@en ;
                sh:nodeKind sh:Literal ;
                sh:order 4 ;
                sh:path skos:notation ;
                shui:editor shui:TextFieldEditor ;
                shui:viewer shui:LiteralViewer ],
            [ sh:name "broader match"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 17 ;
                sh:path skos:broadMatch ;
                shui:editor shui:IRIEditor ;
                shui:viewer shui:HyperlinkViewer ],
            [ sh:name "narrower match"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 18 ;
                sh:path skos:narrowMatch ;
                shui:editor shui:IRIEditor ;
                shui:viewer shui:HyperlinkViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "hidden label"@en ;
                sh:order 3 ;
                sh:path skos:hiddenLabel ;
                shui:editor shui:TextFieldWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "history note"@en ;
                sh:order 8 ;
                sh:path skos:historyNote ;
                shui:editor shui:TextAreaWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:name "close match"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 16 ;
                sh:path skos:closeMatch ;
                shui:editor shui:IRIEditor ;
                shui:viewer shui:HyperlinkViewer ],
            [ sh:class skos:ConceptScheme ;
                sh:name "concept scheme"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 14 ;
                sh:path skos:inScheme ;
                shui:editor shui:InstancesSelectEditor ;
                shui:viewer shui:LabelViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "example"@en ;
                sh:order 7 ;
                sh:path skos:example ;
                shui:editor shui:TextAreaWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:class skos:Concept ;
                sh:name "related concept"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 13 ;
                sh:path skos:related ;
                shui:editor shui:InstancesSelectEditor ;
                shui:viewer shui:LabelViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "alternative label"@en ;
                sh:order 2 ;
                sh:path skos:altLabel ;
                shui:editor shui:TextFieldWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:name "related match"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 19 ;
                sh:path skos:relatedMatch ;
                shui:editor shui:IRIEditor ;
                shui:viewer shui:HyperlinkViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "definition"@en ;
                sh:order 5 ;
                sh:path skos:definition ;
                shui:editor shui:TextAreaWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:name "exact match"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 15 ;
                sh:path skos:exactMatch ;
                shui:editor shui:IRIEditor ;
                shui:viewer shui:HyperlinkViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "scope note"@en ;
                sh:order 6 ;
                sh:path skos:scopeNote ;
                shui:editor shui:TextAreaWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "preferred label"@en ;
                sh:order 1 ;
                sh:path skos:prefLabel ;
                shui:editor shui:TextFieldWithLangEditor ;
                shui:viewer shui:LangStringViewer ] .

    skshp:ConceptPrefLabelRecommendedShape a sh:NodeShape ;
        sh:property [ sh:message "Recommended: a skos:Concept should have at least one skos:prefLabel." ;
                sh:minCount 1 ;
                sh:path skos:prefLabel ;
                sh:severity sh:Info ] ;
        sh:targetClass skos:Concept .

    skshp:ConceptSchemeDisjointnessShape a sh:NodeShape ;
        sh:message "S9/S37: skos:ConceptScheme is disjoint with skos:Concept and skos:Collection." ;
        sh:not [ sh:class skos:Collection ],
            [ sh:class skos:Concept ],
            [ sh:class skos:OrderedCollection ] ;
        sh:targetClass skos:ConceptScheme .

    skshp:ConceptSchemeFormShape a sh:NodeShape ;
        sh:property [ sh:datatype rdf:langString ;
                sh:name "definition"@en ;
                sh:order 3 ;
                sh:path skos:definition ;
                shui:editor shui:TextAreaWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "alternative label"@en ;
                sh:order 2 ;
                sh:path skos:altLabel ;
                shui:editor shui:TextFieldWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:datatype rdf:langString ;
                sh:name "preferred label"@en ;
                sh:order 1 ;
                sh:path skos:prefLabel ;
                shui:editor shui:TextFieldWithLangEditor ;
                shui:viewer shui:LangStringViewer ],
            [ sh:class skos:Concept ;
                sh:name "top concept"@en ;
                sh:nodeKind sh:IRI ;
                sh:order 4 ;
                sh:path skos:hasTopConcept ;
                shui:editor shui:InstancesSelectEditor ;
                shui:viewer shui:LabelViewer ] .

    skshp:LexicalLabelShape a sh:NodeShape ;
        sh:property [ sh:disjoint skos:altLabel,
                    skos:prefLabel ;
                sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint." ;
                sh:path skos:hiddenLabel ],
            [ sh:datatype rdf:langString ;
                sh:disjoint skos:altLabel,
                    skos:hiddenLabel ;
                sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint. S14: no more than one skos:prefLabel per language tag." ;
                sh:path skos:prefLabel ;
                sh:uniqueLang true ],
            [ sh:disjoint skos:hiddenLabel,
                    skos:prefLabel ;
                sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint." ;
                sh:path skos:altLabel ] ;
        sh:targetSubjectsOf skos:altLabel,
            skos:hiddenLabel,
            skos:prefLabel .

    skshp:MappingRelationDisjointnessShape a sh:NodeShape ;
        sh:property [ sh:disjoint skos:broadMatch,
                    skos:narrowMatch,
                    skos:relatedMatch ;
                sh:message "S46: skos:exactMatch is disjoint with skos:broadMatch, skos:narrowMatch, and skos:relatedMatch." ;
                sh:path skos:exactMatch ] ;
        sh:targetSubjectsOf skos:exactMatch .

    skshp:OrderedCollectionMemberListConsistencyShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "skos:memberList and skos:member must describe the same set of members." ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
            SELECT DISTINCT $this
            WHERE {
                $this skos:memberList ?list .
                {
                    ?list rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { $this skos:member ?item }
                }
                UNION
                {
                    $this skos:member ?item .
                    FILTER NOT EXISTS { ?list rdf:rest*/rdf:first ?item }
                }
            }
        """ ] ;
        sh:targetClass skos:OrderedCollection .

    skshp:RelatedDisjointWithHierarchicalShape a sh:NodeShape ;
        sh:property [ sh:disjoint skos:broader,
                    skos:broaderTransitive,
                    skos:narrower,
                    skos:narrowerTransitive ;
                sh:message "S27: skos:related is disjoint with skos:broader(Transitive)/skos:narrower(Transitive)." ;
                sh:path skos:related ] ;
        sh:targetSubjectsOf skos:related .

    skshp:SemanticRelationDomainRangeShape a sh:NodeShape ;
        sh:class skos:Concept ;
        sh:message "S19/S20: the domain and range of every SKOS semantic relation is skos:Concept." ;
        sh:targetObjectsOf skos:broader,
            skos:broaderTransitive,
            skos:narrower,
            skos:narrowerTransitive,
            skos:related,
            skos:semanticRelation ;
        sh:targetSubjectsOf skos:broader,
            skos:broaderTransitive,
            skos:narrower,
            skos:narrowerTransitive,
            skos:related,
            skos:semanticRelation .
}

starontology:sparql_shapes.ttl {
    salg:ShapesGraph a sh:ShapesGraph ;
        rdfs:member salg:AddShape,
            salg:AggregateJoinShape,
            salg:AggregateListShape,
            salg:Aggregate_AvgShape,
            salg:Aggregate_CountShape,
            salg:Aggregate_GroupConcatShape,
            salg:Aggregate_MaxShape,
            salg:Aggregate_MinShape,
            salg:Aggregate_SampleShape,
            salg:Aggregate_SumShape,
            salg:AskQueryShape,
            salg:BGPShape,
            salg:BindingRowListShape,
            salg:BindingShape,
            salg:ClearShape,
            salg:ConstructQueryShape,
            salg:CopyShape,
            salg:CreateShape,
            salg:DatasetClauseListShape,
            salg:DatasetClauseShape,
            salg:DeleteClauseShape,
            salg:DeleteDataShape,
            salg:DeleteWhereShape,
            salg:DescribeQueryShape,
            salg:DistinctShape,
            salg:DropShape,
            salg:ExtendShape,
            salg:FilterShape,
            salg:GraphPatternShape,
            salg:GraphRefListShape,
            salg:GraphRefShape,
            salg:GraphShape,
            salg:GroupShape,
            salg:InsertClauseShape,
            salg:InsertDataShape,
            salg:JoinShape,
            salg:LeftJoinShape,
            salg:LoadShape,
            salg:MinusShape,
            salg:ModifyShape,
            salg:MoveShape,
            salg:ObjectOrVariableOrTripleTermShape,
            salg:ObjectOrVariableShape,
            salg:OrderByShape,
            salg:OrderConditionListShape,
            salg:OrderConditionShape,
            salg:PredicateOrVariableOrPathShape,
            salg:PredicateOrVariableShape,
            salg:ProjectShape,
            salg:QuadsForGraphListShape,
            salg:QuadsForGraphShape,
            salg:QueryCollectionShape,
            salg:QueryListShape,
            salg:ReducedShape,
            salg:SelectQueryShape,
            salg:ServiceGraphPatternShape,
            salg:SliceShape,
            salg:SubSelectShape,
            salg:SubjectOrVariableOrTripleTermShape,
            salg:SubjectOrVariableShape,
            salg:ToMultiSetShape,
            salg:TriplePatternListShape,
            salg:TriplePatternShape,
            salg:TripleTermShape,
            salg:UnionShape,
            salg:UpdateOperationListShape,
            salg:UpdateShape,
            salg:VariableListShape,
            salg:_AggregateBodyShape,
            salg:_FlatTriplesUpdateBodyShape,
            salg:_GraphRefListUpdateBodyShape,
            salg:_GraphRefUpdateBodyShape,
            salg:_GroupConcatAggregateBodyShape,
            salg:_SampleAggregateBodyShape,
            salg:valuesShape ;
        owl:imports spexpr:ShapesGraph .

    salg:AddShape a sh:NodeShape ;
        sh:node salg:_GraphRefListUpdateBodyShape ;
        sh:targetClass salg:Add .

    salg:AggregateJoinShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:AggregateJoin must have exactly one salg:p, a graph pattern (its own wrapped salg:Group)" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p ],
            [ sh:maxCount 1 ;
                sh:message "salg:AggregateJoin must have exactly one salg:A, a well-formed rdf:List of salg:Aggregate" ;
                sh:minCount 1 ;
                sh:node salg:AggregateListShape ;
                sh:path salg:A ] ;
        sh:targetClass salg:AggregateJoin .

    salg:Aggregate_AvgShape a sh:NodeShape ;
        sh:node salg:_AggregateBodyShape ;
        sh:targetClass salg:Aggregate_Avg .

    salg:Aggregate_CountShape a sh:NodeShape ;
        sh:node salg:_AggregateBodyShape ;
        sh:targetClass salg:Aggregate_Count .

    salg:Aggregate_GroupConcatShape a sh:NodeShape ;
        sh:node salg:_GroupConcatAggregateBodyShape ;
        sh:targetClass salg:Aggregate_GroupConcat .

    salg:Aggregate_MaxShape a sh:NodeShape ;
        sh:node salg:_AggregateBodyShape ;
        sh:targetClass salg:Aggregate_Max .

    salg:Aggregate_MinShape a sh:NodeShape ;
        sh:node salg:_AggregateBodyShape ;
        sh:targetClass salg:Aggregate_Min .

    salg:Aggregate_SampleShape a sh:NodeShape ;
        sh:node salg:_SampleAggregateBodyShape ;
        sh:targetClass salg:Aggregate_Sample .

    salg:Aggregate_SumShape a sh:NodeShape ;
        sh:node salg:_AggregateBodyShape ;
        sh:targetClass salg:Aggregate_Sum .

    salg:AskQueryShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:AskQuery must have exactly one salg:PV, a well-formed rdf:List of Variables (always rdf:nil for ASK, but the property itself is always present)" ;
                sh:minCount 1 ;
                sh:node salg:VariableListShape ;
                sh:path salg:PV ],
            [ sh:maxCount 1 ;
                sh:message "salg:AskQuery may have at most one salg:datasetClause, a well-formed rdf:List of salg:DatasetClause" ;
                sh:node salg:DatasetClauseListShape ;
                sh:path salg:datasetClause ],
            [ sh:maxCount 1 ;
                sh:message "salg:AskQuery must have exactly one salg:p, a subquery pattern" ;
                sh:minCount 1 ;
                sh:node salg:SubSelectShape ;
                sh:path salg:p ] ;
        sh:targetClass salg:AskQuery .

    salg:BGPShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:BGP must have exactly one salg:triples, a well-formed rdf:List of salg:TriplePattern" ;
                sh:minCount 1 ;
                sh:node salg:TriplePatternListShape ;
                sh:path salg:triples ] ;
        sh:targetClass salg:BGP .

    salg:BindingShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Binding must have exactly one salg:var, a Variable" ;
                sh:minCount 1 ;
                sh:node spexpr:VariableShape ;
                sh:path salg:var ],
            [ sh:maxCount 1 ;
                sh:message "salg:Binding must have exactly one salg:val (UNDEF is represented as a value, the spexpr:PlainString-tagged literal UNDEF - confirmed via to_rdf._encode_binding_row always adding this triple, never omitting it; the previous cardinality-only framing was factually wrong about the encoding and left the value completely unconstrained). Reuses ObjectOrVariableOrTripleTermShape rather than a narrower value-only shape - a VALUES row can never legally bind a Variable as a value, so this is slightly more permissive than the encoding actually produces, but still a real improvement over no constraint at all." ;
                sh:minCount 1 ;
                sh:node salg:ObjectOrVariableOrTripleTermShape ;
                sh:path salg:val ] ;
        sh:targetClass salg:Binding .

    salg:ClearShape a sh:NodeShape ;
        sh:node salg:_GraphRefUpdateBodyShape ;
        sh:targetClass salg:Clear .

    salg:ConstructQueryShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:ConstructQuery must have exactly one salg:template, a well-formed rdf:List of salg:TriplePattern" ;
                sh:minCount 1 ;
                sh:node salg:TriplePatternListShape ;
                sh:path salg:template ],
            [ sh:maxCount 1 ;
                sh:message "salg:ConstructQuery must have exactly one salg:p, a subquery pattern" ;
                sh:minCount 1 ;
                sh:node salg:SubSelectShape ;
                sh:path salg:p ],
            [ sh:maxCount 1 ;
                sh:message "salg:ConstructQuery may have at most one salg:datasetClause, a well-formed rdf:List of salg:DatasetClause" ;
                sh:node salg:DatasetClauseListShape ;
                sh:path salg:datasetClause ] ;
        sh:targetClass salg:ConstructQuery .

    salg:CopyShape a sh:NodeShape ;
        sh:node salg:_GraphRefListUpdateBodyShape ;
        sh:targetClass salg:Copy .

    salg:CreateShape a sh:NodeShape ;
        sh:node salg:_GraphRefUpdateBodyShape ;
        sh:targetClass salg:Create .

    salg:DatasetClauseShape a sh:NodeShape ;
        sh:message "salg:DatasetClause must have exactly one of salg:default (FROM) or salg:named (FROM NAMED), each an IRI, never both" ;
        sh:targetClass salg:DatasetClause ;
        sh:xone ( [ sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path salg:default ],
                        [ sh:maxCount 0 ;
                            sh:path salg:named ] ] [ sh:property [ sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:nodeKind sh:IRI ;
                            sh:path salg:named ],
                        [ sh:maxCount 0 ;
                            sh:path salg:default ] ] ) .

    salg:DeleteDataShape a sh:NodeShape ;
        sh:node salg:_FlatTriplesUpdateBodyShape ;
        sh:targetClass salg:DeleteData .

    salg:DeleteWhereShape a sh:NodeShape ;
        sh:node salg:_FlatTriplesUpdateBodyShape ;
        sh:targetClass salg:DeleteWhere .

    salg:DescribeQueryShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:DescribeQuery's salg:p, if present, must be a subquery pattern (absent for a bare DESCRIBE with no WHERE clause)" ;
                sh:node salg:SubSelectShape ;
                sh:path salg:p ],
            [ sh:maxCount 1 ;
                sh:message "salg:DescribeQuery may have at most one salg:datasetClause, a well-formed rdf:List of salg:DatasetClause" ;
                sh:node salg:DatasetClauseListShape ;
                sh:path salg:datasetClause ],
            [ sh:maxCount 1 ;
                sh:message "salg:DescribeQuery must have exactly one salg:PV (the described variables/IRIs)" ;
                sh:minCount 1 ;
                sh:path salg:PV ] ;
        sh:targetClass salg:DescribeQuery .

    salg:DistinctShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Distinct must have exactly one salg:p, a subquery pattern" ;
                sh:minCount 1 ;
                sh:node salg:SubSelectShape ;
                sh:path salg:p ] ;
        sh:targetClass salg:Distinct .

    salg:DropShape a sh:NodeShape ;
        sh:node salg:_GraphRefUpdateBodyShape ;
        sh:targetClass salg:Drop .

    salg:ExtendShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Extend must have exactly one salg:p, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p ],
            [ sh:maxCount 1 ;
                sh:message "salg:Extend must have exactly one salg:var, a Variable" ;
                sh:minCount 1 ;
                sh:node spexpr:VariableShape ;
                sh:path salg:var ],
            [ sh:maxCount 1 ;
                sh:message "salg:Extend must have exactly one salg:expr" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path salg:expr ] ;
        sh:targetClass salg:Extend .

    salg:FilterShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Filter must have exactly one salg:expr" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path salg:expr ],
            [ sh:maxCount 1 ;
                sh:message "salg:Filter must have exactly one salg:p, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p ] ;
        sh:targetClass salg:Filter .

    salg:GraphShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Graph must have exactly one salg:p, the wrapped graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p ],
            [ sh:maxCount 1 ;
                sh:message "salg:Graph must have exactly one salg:term, the graph name (an IRI or Variable)" ;
                sh:minCount 1 ;
                sh:or ( [ sh:nodeKind sh:IRI ] spexpr:VariableShape ) ;
                sh:path salg:term ] ;
        sh:targetClass salg:Graph .

    salg:GroupShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Group must have exactly one salg:p, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p ],
            [ sh:maxCount 1 ;
                sh:message "salg:Group's salg:expr, if present, must be a well-formed rdf:List of grouping-key expressions (absent means implicit single-group aggregation)" ;
                sh:node spexpr:ExpressionListShape ;
                sh:path salg:expr ] ;
        sh:targetClass salg:Group .

    salg:InsertDataShape a sh:NodeShape ;
        sh:node salg:_FlatTriplesUpdateBodyShape ;
        sh:targetClass salg:InsertData .

    salg:JoinShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Join must have exactly one salg:p1, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p1 ],
            [ sh:maxCount 1 ;
                sh:message "salg:Join must have exactly one salg:p2, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p2 ] ;
        sh:targetClass salg:Join .

    salg:LeftJoinShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:LeftJoin must have exactly one salg:expr (TrueFilter if OPTIONAL had no inline FILTER)" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path salg:expr ],
            [ sh:maxCount 1 ;
                sh:message "salg:LeftJoin must have exactly one salg:p1, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p1 ],
            [ sh:maxCount 1 ;
                sh:message "salg:LeftJoin must have exactly one salg:p2, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p2 ] ;
        sh:targetClass salg:LeftJoin .

    salg:LoadShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Load's own salg:graphiri (INTO GRAPH) is optional but, when present, must be a plain IRI, not a DEFAULT/NAMED/ALL keyword" ;
                sh:nodeKind sh:IRI ;
                sh:path salg:graphiri ],
            [ sh:maxCount 1 ;
                sh:message "salg:Load must have exactly one salg:iri, an IRI" ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path salg:iri ],
            [ sh:datatype spexpr:PlainString ;
                sh:maxCount 1 ;
                sh:message "salg:silent is optional but at most one, a spexpr:PlainString-tagged SILENT keyword" ;
                sh:nodeKind sh:Literal ;
                sh:path salg:silent ] ;
        sh:targetClass salg:Load .

    salg:MinusShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Minus must have exactly one salg:p2, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p2 ],
            [ sh:maxCount 1 ;
                sh:message "salg:Minus must have exactly one salg:p1, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p1 ] ;
        sh:targetClass salg:Minus .

    salg:ModifyShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Modify must have exactly one salg:where, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:where ],
            [ sh:maxCount 1 ;
                sh:message "salg:Modify's salg:insert, if present, must be a salg:InsertClause" ;
                sh:node salg:InsertClauseShape ;
                sh:path salg:insert ],
            [ sh:maxCount 1 ;
                sh:message "salg:Modify's salg:delete, if present, must be a salg:DeleteClause" ;
                sh:node salg:DeleteClauseShape ;
                sh:path salg:delete ] ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "salg:Modify must have at least one of salg:delete/salg:insert (SPARQL forbids a Modify with neither)" ;
                sh:select """
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { $this salg:delete ?d }
                FILTER NOT EXISTS { $this salg:insert ?i }
            }
        """ ] ;
        sh:targetClass salg:Modify .

    salg:MoveShape a sh:NodeShape ;
        sh:node salg:_GraphRefListUpdateBodyShape ;
        sh:targetClass salg:Move .

    salg:OrderByShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:OrderBy must have exactly one salg:p, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p ],
            [ sh:maxCount 1 ;
                sh:message "salg:OrderBy must have exactly one salg:expr, a well-formed rdf:List of salg:OrderCondition" ;
                sh:minCount 1 ;
                sh:node salg:OrderConditionListShape ;
                sh:path salg:expr ] ;
        sh:targetClass salg:OrderBy .

    salg:OrderConditionShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:OrderCondition must have exactly one salg:expr" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path salg:expr ],
            [ sh:datatype spexpr:PlainString ;
                sh:maxCount 1 ;
                sh:message "salg:OrderCondition may have at most one salg:order, a spexpr:PlainString-tagged ASC/DESC keyword (omitted means ASC)" ;
                sh:nodeKind sh:Literal ;
                sh:path salg:order ] ;
        sh:targetClass salg:OrderCondition .

    salg:ProjectShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Project must have exactly one salg:PV, a well-formed rdf:List of Variables (the projected-variables list)" ;
                sh:minCount 1 ;
                sh:node salg:VariableListShape ;
                sh:path salg:PV ],
            [ sh:maxCount 1 ;
                sh:message "salg:Project must have exactly one salg:p, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p ] ;
        sh:targetClass salg:Project ;
        salg:noUnboundProjectedVariables true .

    salg:QuadsForGraphShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:QuadsForGraph must have exactly one salg:graph, an IRI or Variable (a Variable for Modify's own GRAPH ?g {...} - see vocab.py's Update quads-by-graph maps section) - found unconstrained by 2026-08-15's exhaustive property-level audit" ;
                sh:minCount 1 ;
                sh:or ( [ sh:nodeKind sh:IRI ] spexpr:VariableShape ) ;
                sh:path salg:graph ],
            [ sh:maxCount 1 ;
                sh:message "salg:QuadsForGraph must have exactly one salg:triples, a well-formed rdf:List of salg:TriplePattern" ;
                sh:minCount 1 ;
                sh:node salg:TriplePatternListShape ;
                sh:path salg:triples ] ;
        sh:targetClass salg:QuadsForGraph .

    salg:QueryCollectionShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:QueryCollection must have exactly one salg:queries, a well-formed rdf:List of salg:Query" ;
                sh:minCount 1 ;
                sh:node salg:QueryListShape ;
                sh:path salg:queries ] ;
        sh:targetClass salg:QueryCollection .

    salg:ReducedShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Reduced must have exactly one salg:p, a subquery pattern" ;
                sh:minCount 1 ;
                sh:node salg:SubSelectShape ;
                sh:path salg:p ] ;
        sh:targetClass salg:Reduced .

    salg:SelectQueryShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:SelectQuery may have at most one salg:datasetClause, a well-formed rdf:List of salg:DatasetClause" ;
                sh:node salg:DatasetClauseListShape ;
                sh:path salg:datasetClause ],
            [ sh:maxCount 1 ;
                sh:message "salg:SelectQuery must have exactly one salg:p, a subquery pattern (Project, optionally wrapped in Slice/Distinct/Reduced)" ;
                sh:minCount 1 ;
                sh:node salg:SubSelectShape ;
                sh:path salg:p ],
            [ sh:maxCount 1 ;
                sh:message "salg:SelectQuery must have exactly one salg:PV, a well-formed rdf:List of Variables (the projected-variables list)" ;
                sh:minCount 1 ;
                sh:node salg:VariableListShape ;
                sh:path salg:PV ] ;
        sh:targetClass salg:SelectQuery .

    salg:ServiceGraphPatternShape a sh:NodeShape ;
        sh:property [ sh:datatype spexpr:PlainString ;
                sh:maxCount 1 ;
                sh:message "salg:silent is optional but at most one, a spexpr:PlainString-tagged SILENT keyword" ;
                sh:nodeKind sh:Literal ;
                sh:path salg:silent ],
            [ sh:maxCount 1 ;
                sh:message "salg:ServiceGraphPattern must have exactly one salg:graph (a raw, untranslated parse-tree fragment - out of scope to shape further, see this property's own comment)" ;
                sh:minCount 1 ;
                sh:path salg:graph ],
            [ sh:maxCount 1 ;
                sh:message "salg:ServiceGraphPattern must have exactly one salg:term, the endpoint IRI or Variable" ;
                sh:minCount 1 ;
                sh:or ( [ sh:nodeKind sh:IRI ] spexpr:VariableShape ) ;
                sh:path salg:term ] ;
        sh:targetClass salg:ServiceGraphPattern .

    salg:SliceShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Slice must have exactly one salg:p, a subquery pattern" ;
                sh:minCount 1 ;
                sh:node salg:SubSelectShape ;
                sh:path salg:p ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:message "salg:Slice must have exactly one salg:start, an xsd:integer" ;
                sh:minCount 1 ;
                sh:path salg:start ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:message "salg:Slice must have exactly one salg:length, an xsd:integer" ;
                sh:minCount 1 ;
                sh:path salg:length ] ;
        sh:targetClass salg:Slice .

    salg:ToMultiSetShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:ToMultiSet must have exactly one salg:p, a VALUES clause (salg:values) or a subquery" ;
                sh:minCount 1 ;
                sh:node [ sh:or ( salg:valuesShape salg:SubSelectShape ) ] ;
                sh:path salg:p ] ;
        sh:targetClass salg:ToMultiSet .

    salg:TriplePatternShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:TriplePattern must have exactly one salg:predicate, an IRI/Variable/property-path" ;
                sh:minCount 1 ;
                sh:node salg:PredicateOrVariableOrPathShape ;
                sh:path salg:predicate ],
            [ sh:maxCount 1 ;
                sh:message "salg:TriplePattern must have exactly one salg:object" ;
                sh:minCount 1 ;
                sh:node salg:ObjectOrVariableOrTripleTermShape ;
                sh:path salg:object ],
            [ sh:maxCount 1 ;
                sh:message "salg:TriplePattern must have exactly one salg:subject, an IRI/blank node/Variable/TripleTerm" ;
                sh:minCount 1 ;
                sh:node salg:SubjectOrVariableOrTripleTermShape ;
                sh:path salg:subject ] ;
        sh:targetClass salg:TriplePattern .

    salg:UnionShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Union must have exactly one salg:p2, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p2 ],
            [ sh:maxCount 1 ;
                sh:message "salg:Union must have exactly one salg:p1, a graph pattern" ;
                sh:minCount 1 ;
                sh:node salg:GraphPatternShape ;
                sh:path salg:p1 ] ;
        sh:targetClass salg:Union .

    salg:UpdateShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Update must have exactly one salg:operations, a well-formed rdf:List of salg:UpdateOperation" ;
                sh:minCount 1 ;
                sh:node salg:UpdateOperationListShape ;
                sh:path salg:operations ] ;
        sh:targetClass salg:Update .

    salg:AggregateListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of salg:Aggregate" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a salg:Aggregate }
                }
            }
        """ ] .

    salg:BindingRowListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of binding rows (each itself a well-formed rdf:List of salg:Binding)" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?row .
                    FILTER ( ?row != rdf:nil )
                    FILTER NOT EXISTS { ?row rdf:first ?rowHead }
                } UNION {
                    $this rdf:rest*/rdf:first ?row .
                    ?row rdf:rest*/rdf:first ?binding .
                    FILTER NOT EXISTS { ?binding a salg:Binding }
                }
            }
        """ ] .

    salg:DeleteClauseShape a sh:NodeShape ;
        sh:node salg:_FlatTriplesUpdateBodyShape ;
        sh:targetClass salg:DeleteClause .

    salg:GraphRefListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed 2-element rdf:List [source, dest] of graph references (IRI/BlankNode/PlainString DEFAULT keyword)" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER NOT EXISTS { $this rdf:first ?first }
                } UNION {
                    FILTER NOT EXISTS { $this rdf:rest/rdf:first ?second }
                } UNION {
                    $this rdf:rest/rdf:rest ?tail .
                    FILTER ( ?tail != rdf:nil )
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( !isIRI(?item) && !isBlank(?item) && !(isLiteral(?item) && datatype(?item) = spexpr:PlainString) )
                }
            }
        """ ] .

    salg:GraphRefShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:BlankNode ] [ sh:datatype spexpr:PlainString ;
                    sh:nodeKind sh:Literal ] ) .

    salg:InsertClauseShape a sh:NodeShape ;
        sh:node salg:_FlatTriplesUpdateBodyShape ;
        sh:targetClass salg:InsertClause .

    salg:ObjectOrVariableShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:BlankNode ] [ sh:nodeKind sh:Literal ] spexpr:VariableShape ) .

    salg:OrderConditionListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of salg:OrderCondition" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a salg:OrderCondition }
                }
            }
        """ ] .

    salg:PredicateOrVariableOrPathShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] spexpr:VariableShape spexpr:PathShape ) .

    salg:PredicateOrVariableShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] spexpr:VariableShape ) .

    salg:QuadsForGraphListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of salg:QuadsForGraph" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a salg:QuadsForGraph }
                }
            }
        """ ] .

    salg:QueryListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of salg:Query" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a salg:Query }
                }
            }
        """ ] .

    salg:SubjectOrVariableOrTripleTermShape a sh:NodeShape ;
        sh:or ( salg:SubjectOrVariableShape salg:TripleTermShape ) .

    salg:UpdateOperationListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of salg:UpdateOperation" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a salg:UpdateOperation }
                }
            }
        """ ] .

    salg:_GroupConcatAggregateBodyShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:separator is optional (absent means the SPARQL-default single-space separator) but at most one, a Literal when present" ;
                sh:nodeKind sh:Literal ;
                sh:path salg:separator ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:res, the aggregate's own output Variable" ;
                sh:minCount 1 ;
                sh:node spexpr:VariableShape ;
                sh:path salg:res ],
            [ sh:maxCount 1 ;
                sh:message "salg:distinct must have exactly one value (a spexpr:PlainString-tagged DISTINCT keyword, or rdf:nil when absent)" ;
                sh:minCount 1 ;
                sh:node spexpr:DistinctMarkerShape ;
                sh:path salg:distinct ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:vars" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path salg:vars ] .

    salg:_SampleAggregateBodyShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:res, the aggregate's own output Variable" ;
                sh:minCount 1 ;
                sh:node spexpr:VariableShape ;
                sh:path salg:res ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:vars" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path salg:vars ] .

    salg:valuesShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:values must have exactly one salg:res, a well-formed rdf:List of binding rows" ;
                sh:minCount 1 ;
                sh:node salg:BindingRowListShape ;
                sh:path salg:res ] ;
        sh:targetClass salg:values .

    salg:SubjectOrVariableShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:BlankNode ;
                    sh:not [ sh:class salg:TripleTerm ] ] spexpr:VariableShape ) .

    salg:TripleTermShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:TripleTerm must have exactly one salg:predicate, an IRI/Variable" ;
                sh:minCount 1 ;
                sh:node salg:PredicateOrVariableShape ;
                sh:path salg:predicate ],
            [ sh:maxCount 1 ;
                sh:message "salg:TripleTerm must have exactly one salg:subject, an IRI/blank node/Variable (nested TripleTerm not permitted here)" ;
                sh:minCount 1 ;
                sh:node salg:SubjectOrVariableShape ;
                sh:path salg:subject ],
            [ sh:maxCount 1 ;
                sh:message "salg:TripleTerm must have exactly one salg:object" ;
                sh:minCount 1 ;
                sh:node salg:ObjectOrVariableOrTripleTermShape ;
                sh:path salg:object ] ;
        sh:targetClass salg:TripleTerm .

    salg:ObjectOrVariableOrTripleTermShape a sh:NodeShape ;
        sh:or ( salg:ObjectOrVariableShape salg:TripleTermShape ) .

    salg:VariableListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of salg:Variable-tagged literals" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( !isLiteral(?item) || datatype(?item) != spexpr:Variable )
                }
            }
        """ ] .

    salg:_GraphRefListUpdateBodyShape a sh:NodeShape ;
        sh:property [ sh:datatype spexpr:PlainString ;
                sh:maxCount 1 ;
                sh:message "salg:silent is optional but at most one, a spexpr:PlainString-tagged SILENT keyword" ;
                sh:nodeKind sh:Literal ;
                sh:path salg:silent ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:graph, a 2-element rdf:List [source, dest] of graph references" ;
                sh:minCount 1 ;
                sh:node salg:GraphRefListShape ;
                sh:path salg:graph ] .

    salg:_GraphRefUpdateBodyShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:graphiri, a graph term or DEFAULT/NAMED/ALL keyword" ;
                sh:minCount 1 ;
                sh:node salg:GraphRefShape ;
                sh:path salg:graphiri ],
            [ sh:datatype spexpr:PlainString ;
                sh:maxCount 1 ;
                sh:message "salg:silent is optional but at most one, a spexpr:PlainString-tagged SILENT keyword" ;
                sh:nodeKind sh:Literal ;
                sh:path salg:silent ] .

    salg:DatasetClauseListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of salg:DatasetClause" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a salg:DatasetClause }
                }
            }
        """ ] .

    salg:TriplePatternListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of salg:TriplePattern" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a salg:TriplePattern }
                }
            }
        """ ] .

    salg:_AggregateBodyShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:distinct must have exactly one value (a spexpr:PlainString-tagged DISTINCT keyword, or rdf:nil when absent)" ;
                sh:minCount 1 ;
                sh:node spexpr:DistinctMarkerShape ;
                sh:path salg:distinct ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:res, the aggregate's own output Variable" ;
                sh:minCount 1 ;
                sh:node spexpr:VariableShape ;
                sh:path salg:res ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:vars" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path salg:vars ] .

    salg:_FlatTriplesUpdateBodyShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:quads, a well-formed rdf:List of salg:QuadsForGraph" ;
                sh:minCount 1 ;
                sh:node salg:QuadsForGraphListShape ;
                sh:path salg:quads ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:triples, a well-formed rdf:List of salg:TriplePattern" ;
                sh:minCount 1 ;
                sh:node salg:TriplePatternListShape ;
                sh:path salg:triples ] .

    salg:SubSelectShape a sh:NodeShape ;
        sh:class salg:SubSelect ;
        sh:message "expected a subquery pattern (Project, optionally wrapped in Slice/Distinct/Reduced)" .

    salg:GraphPatternShape a sh:NodeShape ;
        sh:class salg:GraphPattern ;
        sh:message "expected a recognized graph-pattern operator (see salg:GraphPattern in salg-ontology.ttl)" .
}

starontology:spexpr-ontology.ttl {
    spexpr:AdditiveExpression rdfs:subClassOf spexpr:ArithmeticExpression .

    spexpr:Aggregate_Avg rdfs:subClassOf spexpr:Aggregate .

    spexpr:Aggregate_Count rdfs:subClassOf spexpr:Aggregate .

    spexpr:Aggregate_GroupConcat rdfs:subClassOf spexpr:Aggregate .

    spexpr:Aggregate_Max rdfs:subClassOf spexpr:Aggregate .

    spexpr:Aggregate_Min rdfs:subClassOf spexpr:Aggregate .

    spexpr:Aggregate_Sample rdfs:subClassOf spexpr:Aggregate .

    spexpr:Aggregate_Sum rdfs:subClassOf spexpr:Aggregate .

    spexpr:AlternativePath rdfs:comment "path1|path2 (alternative) - salg:args, same list shape as SequencePath." ;
        rdfs:subClassOf spexpr:Path .

    spexpr:Builtin_ABS rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_BNODE rdfs:subClassOf spexpr:OptionalOneArgExpression .

    spexpr:Builtin_BOUND rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_CEIL rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_COALESCE rdfs:subClassOf spexpr:VariadicArgExpression .

    spexpr:Builtin_CONCAT rdfs:subClassOf spexpr:VariadicArgExpression .

    spexpr:Builtin_CONTAINS rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:Builtin_DATATYPE rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_DAY rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_ENCODE_FOR_URI rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_EXISTS rdfs:subClassOf spexpr:ExistsExpression .

    spexpr:Builtin_FLOOR rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_HOURS rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_IF rdfs:subClassOf spexpr:ThreeArgExpression .

    spexpr:Builtin_IRI rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_LANG rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_LANGDIR rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_LANGMATCHES rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:Builtin_LCASE rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_MD5 rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_MINUTES rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_MONTH rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_NOTEXISTS rdfs:subClassOf spexpr:ExistsExpression .

    spexpr:Builtin_NOW rdfs:subClassOf spexpr:ZeroArgExpression .

    spexpr:Builtin_OBJECT rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_PREDICATE rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_RAND rdfs:subClassOf spexpr:ZeroArgExpression .

    spexpr:Builtin_REGEX rdfs:subClassOf spexpr:RegexExpression .

    spexpr:Builtin_REPLACE rdfs:subClassOf spexpr:ReplaceExpression .

    spexpr:Builtin_ROUND rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_SECONDS rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_SHA1 rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_SHA256 rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_SHA384 rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_SHA512 rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_STR rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_STRAFTER rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:Builtin_STRBEFORE rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:Builtin_STRDT rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:Builtin_STRENDS rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:Builtin_STRLANG rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:Builtin_STRLANGDIR rdfs:subClassOf spexpr:StrLangDirExpression .

    spexpr:Builtin_STRLEN rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_STRSTARTS rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:Builtin_STRUUID rdfs:subClassOf spexpr:ZeroArgExpression .

    spexpr:Builtin_SUBJECT rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_SUBSTR rdfs:subClassOf spexpr:SubstrExpression .

    spexpr:Builtin_TIMEZONE rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_TZ rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_UCASE rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_URI rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_UUID rdfs:subClassOf spexpr:ZeroArgExpression .

    spexpr:Builtin_YEAR rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_hasLANG rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_hasLANGDIR rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_isBLANK rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_isIRI rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_isLITERAL rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_isNUMERIC rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_isTRIPLE rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_isURI rdfs:subClassOf spexpr:OneArgExpression .

    spexpr:Builtin_sameTerm rdfs:subClassOf spexpr:TwoArgExpression .

    spexpr:ConditionalAndExpression rdfs:subClassOf spexpr:ConditionalExpression .

    spexpr:ConditionalOrExpression rdfs:subClassOf spexpr:ConditionalExpression .

    spexpr:Function rdfs:subClassOf spexpr:FunctionExpression .

    spexpr:InvPath rdfs:comment "^path (inverse) - salg:arg the wrapped path/IRI." ;
        rdfs:subClassOf spexpr:Path .

    spexpr:MulPath rdfs:comment "path* / path+ / path? (repetition) - salg:path the repeated path/IRI, salg:mod the bare \"*\"/\"+\"/\"?\" modifier string. Not spexpr:PlainString-tagged, unlike salg:silent/salg:graphiri/salg:op - confirmed via to_rdf._encode_path's own MulPath branch (Literal(path.mod), no datatype argument), which is what makes shapes.py's own salg:MulPathShape sh:in (\"*\" \"+\" \"?\") check actually match (that check compares against plain literals; PlainString-tagging it would break the match, since sh:in's term-equality is exact and the two datatypes differ). This comment previously claimed PlainString-tagging incorrectly - found and corrected 2026-08-16, a dedicated ontology audit. The live rdflib object's own zero/more boolean flags are deliberately not encoded, since both are always fully derivable from salg:mod alone (confirmed by reading rdflib.paths.MulPath's own constructor)." ;
        rdfs:subClassOf spexpr:Path .

    spexpr:MultiplicativeExpression rdfs:subClassOf spexpr:ArithmeticExpression .

    spexpr:NegatedPath rdfs:comment "!path / !(path1|path2) (negated property set) - salg:args, same list shape as SequencePath/AlternativePath." ;
        rdfs:subClassOf spexpr:Path .

    spexpr:PlainString a rdfs:Datatype ;
        rdfs:comment "A plain, untagged bare string value (not a real RDF term) that needs a reserved datatype to survive RDF round-trip without colliding with an ordinary xsd:string-typed value - e.g. an operator symbol, a prefix label, a bare SPARQL grammar keyword. The shared, technology-neutral home for this concept (reused directly by salg:/sqe:, see vocab.py's PY_STR_DATATYPE) - renamed and moved here from salg:PyStr 2026-10-15, the same spexpr:-not-salg: reasoning already applied to Variable." .

    spexpr:RelationalExpression rdfs:comment "=, !=, <, >, <=, >=, IN, NOT IN." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:SequencePath rdfs:comment "path1/path2 (sequence) - salg:args a well-formed rdf:List of the sequenced paths/IRIs." ;
        rdfs:subClassOf spexpr:Path .

    spexpr:TrueFilter rdfs:comment "The constant-true expression rdflib substitutes for an OPTIONAL with no inline FILTER. No properties of its own." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:UnaryMinus rdfs:subClassOf spexpr:UnaryExpression .

    spexpr:UnaryNot rdfs:subClassOf spexpr:UnaryExpression .

    spexpr:UnaryPlus rdfs:subClassOf spexpr:UnaryExpression .

    spexpr:FunctionExpression rdfs:comment "A call to any registered/custom SPARQL function - salg:iri/distinct/expr." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:OptionalOneArgExpression rdfs:comment "Zero or one argument (salg:arg) - BNODE()/BNODE(?x) only." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:RegexExpression rdfs:comment "REGEX(text, pattern[, flags]) - unique key names." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:ReplaceExpression rdfs:comment "REPLACE(arg, pattern, replacement[, flags]) - unique key names." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:StrLangDirExpression rdfs:comment "STRLANGDIR(lex, lang, direction) - three required arguments under their own key names." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:SubstrExpression rdfs:comment "SUBSTR(arg, start[, length]) - unique key names." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:ThreeArgExpression rdfs:comment "Exactly three required arguments (salg:arg1/arg2/arg3) - IF() only." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:ArithmeticExpression rdfs:comment "+/-/*// chains - salg:expr, salg:op, salg:other (always a list)." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:ConditionalExpression rdfs:comment "&&/|| chains - salg:expr plus an optional salg:other list." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:ExistsExpression rdfs:comment "EXISTS{}/NOT EXISTS{} - salg:graph, not salg:expr (a raw, untranslated parse-tree fragment, deliberately unshaped further - see shapes.py)." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:VariadicArgExpression rdfs:comment "salg:arg is itself a list of arguments - CONCAT/COALESCE only." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:UnaryExpression rdfs:comment "Exactly one required operand (salg:expr) - !/-/+ prefix operators." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:ZeroArgExpression rdfs:comment "No arguments (NOW/UUID/STRUUID/RAND)." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:Path rdfs:comment "A SPARQL property-path expression - the salg: mirror of rdflib.paths.Path's own class hierarchy." .

    spexpr:Aggregate rdfs:comment "An aggregate call (COUNT/SUM/MIN/MAX/AVG/SAMPLE/GROUP_CONCAT) in a projection, HAVING or ORDER BY expression - spexpr:vars the aggregated expression (or the marker *), spexpr:distinct DISTINCT or empty." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:TwoArgExpression rdfs:comment "Exactly two required arguments (salg:arg1/arg2)." ;
        rdfs:subClassOf spexpr:Expression .

    spexpr:Expression rdfs:label "Expression" ;
        rdfs:comment "A SPARQL expression-tree node (a FILTER/BIND/ORDER BY expression, or any of rdflib's ~63 expression builtins)." .

    spexpr:OneArgExpression rdfs:comment "Exactly one required argument (salg:arg)." ;
        rdfs:subClassOf spexpr:Expression .
}

starontology:spexpr_shapes.ttl {
    spexpr:AggregateBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "an aggregate must have exactly one spexpr:vars, the aggregated expression (or the marker *)" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:vars ],
            [ sh:in ( () "DISTINCT"^^spexpr:PlainString ) ;
                sh:maxCount 1 ;
                sh:message "spexpr:distinct must be empty (rdf:nil) or the string DISTINCT" ;
                sh:path spexpr:distinct ],
            [ sh:maxCount 1 ;
                sh:message "spexpr:separator must be a single literal" ;
                sh:nodeKind sh:Literal ;
                sh:path spexpr:separator ] ;
        sh:targetClass spexpr:Aggregate_Avg,
            spexpr:Aggregate_Count,
            spexpr:Aggregate_GroupConcat,
            spexpr:Aggregate_Max,
            spexpr:Aggregate_Min,
            spexpr:Aggregate_Sample,
            spexpr:Aggregate_Sum .

    spexpr:AlternativePathShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:AlternativePath must have exactly one salg:args, a well-formed rdf:List of path/IRI values" ;
                sh:minCount 1 ;
                sh:node spexpr:PathArgsListShape ;
                sh:path spexpr:args ] ;
        sh:targetClass spexpr:AlternativePath .

    spexpr:InvPathShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:InvPath must have exactly one salg:arg, a path or IRI" ;
                sh:minCount 1 ;
                sh:node spexpr:PathOrIriShape ;
                sh:path spexpr:arg ] ;
        sh:targetClass spexpr:InvPath .

    spexpr:MulPathShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:MulPath must have exactly one salg:path, a path or IRI" ;
                sh:minCount 1 ;
                sh:node spexpr:PathOrIriShape ;
                sh:path spexpr:path ],
            [ sh:in ( "*" "+" "?" ) ;
                sh:maxCount 1 ;
                sh:message "salg:MulPath must have exactly one salg:mod, a bare asterisk/plus/question-mark modifier string" ;
                sh:minCount 1 ;
                sh:path spexpr:mod ] ;
        sh:targetClass spexpr:MulPath .

    spexpr:NegatedPathShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:NegatedPath must have exactly one salg:args, a well-formed rdf:List of path/IRI values" ;
                sh:minCount 1 ;
                sh:node spexpr:PathArgsListShape ;
                sh:path spexpr:args ] ;
        sh:targetClass spexpr:NegatedPath .

    spexpr:SequencePathShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:SequencePath must have exactly one salg:args, a well-formed rdf:List of path/IRI values" ;
                sh:minCount 1 ;
                sh:node spexpr:PathArgsListShape ;
                sh:path spexpr:args ] ;
        sh:targetClass spexpr:SequencePath .

    spexpr:_ArithmeticExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:other, a well-formed rdf:List of expressions" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionListShape ;
                sh:path spexpr:other ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:expr" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:expr ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:op, a well-formed rdf:List of spexpr:PlainString-tagged operator strings" ;
                sh:minCount 1 ;
                sh:node spexpr:OperatorStringListShape ;
                sh:path spexpr:op ] .

    spexpr:_ConditionalExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:expr" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:expr ],
            [ sh:maxCount 1 ;
                sh:message "salg:other is optional (absent means a single-condition expression) but a well-formed rdf:List of expressions when present" ;
                sh:node spexpr:ExpressionListShape ;
                sh:path spexpr:other ] .

    spexpr:_ExistsExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:graph" ;
                sh:minCount 1 ;
                sh:path spexpr:graph ] .

    spexpr:_FunctionExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:Function must have exactly one salg:iri, an IRI" ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path spexpr:iri ],
            [ sh:maxCount 1 ;
                sh:message "salg:Function's salg:distinct must have exactly one value (a spexpr:PlainString-tagged DISTINCT keyword, or rdf:nil when absent) - confirmed always present, empirically, same as the aggregate bodies' own salg:distinct above" ;
                sh:minCount 1 ;
                sh:node spexpr:DistinctMarkerShape ;
                sh:path spexpr:distinct ],
            [ sh:maxCount 1 ;
                sh:message "salg:Function must have exactly one salg:expr, a well-formed rdf:List of call arguments" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionListShape ;
                sh:path spexpr:expr ] .

    spexpr:_OneArgExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg ] .

    spexpr:_OptionalOneArgExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:arg is optional (absent means BNODE()'s no-argument form) but at most one" ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg ] .

    spexpr:_RegexExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:flags is optional but at most one" ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:flags ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:pattern" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:pattern ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:text" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:text ] .

    spexpr:_RelationalExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:other, an expression or (for IN/NOT IN) a well-formed rdf:List of expressions" ;
                sh:minCount 1 ;
                sh:node [ sh:or ( spexpr:ExpressionShape spexpr:ExpressionListShape ) ] ;
                sh:path spexpr:other ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:expr" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:expr ],
            [ sh:datatype spexpr:PlainString ;
                sh:in ( "="^^spexpr:PlainString "!="^^spexpr:PlainString "<"^^spexpr:PlainString ">"^^spexpr:PlainString "<="^^spexpr:PlainString ">="^^spexpr:PlainString "IN"^^spexpr:PlainString "NOT IN"^^spexpr:PlainString ) ;
                sh:maxCount 1 ;
                sh:message "expected exactly one salg:op, a spexpr:PlainString-tagged operator symbol" ;
                sh:minCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:path spexpr:op ] .

    spexpr:_ReplaceExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:replacement" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:replacement ],
            [ sh:maxCount 1 ;
                sh:message "salg:flags is optional but at most one" ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:flags ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:pattern" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:pattern ] .

    spexpr:_StrLangDirExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one spexpr:lex" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:lex ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one spexpr:lang" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:lang ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one spexpr:direction" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:direction ] .

    spexpr:_SubstrExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "salg:length is optional but at most one" ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:length ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:start" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:start ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg ] .

    spexpr:_ThreeArgExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg3" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg3 ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg1" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg1 ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg2" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg2 ] .

    spexpr:_TwoArgExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg2" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg2 ],
            [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg1" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:arg1 ] .

    spexpr:_UnaryExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:expr" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path spexpr:expr ] .

    spexpr:_VariadicArgExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:property [ sh:maxCount 1 ;
                sh:message "expected exactly one salg:arg, a well-formed rdf:List of expression values" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionListShape ;
                sh:path spexpr:arg ] .

    spexpr:_ZeroArgExprBodyShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph .

    spexpr:DistinctMarkerShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:or ( [ sh:datatype spexpr:PlainString ;
                    sh:nodeKind sh:Literal ] [ sh:hasValue () ] ) .

    spexpr:OperatorStringListShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of spexpr:PlainString-tagged operator strings, each one of the real Arithmetic operators (+/-/*//), shared by AdditiveExpression and MultiplicativeExpression alike" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( !isLiteral(?item) || datatype(?item) != spexpr:PlainString ||
                              ( str(?item) != "+" && str(?item) != "-" && str(?item) != "*" && str(?item) != "/" ) )
                }
            }
        """ ] .

    spexpr:PathShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:class spexpr:Path ;
        sh:message "expected a recognized property-path operator (see salg:Path in salg-ontology.ttl)" .

    spexpr:VariableShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:datatype spexpr:Variable ;
        sh:nodeKind sh:Literal .

    spexpr:PathOrIriShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:or ( [ sh:nodeKind sh:IRI ] spexpr:PathShape ) .

    spexpr:PathArgsListShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of path/IRI values" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest+ ?tail .
                    FILTER ( ?tail != rdf:nil )
                    FILTER NOT EXISTS { ?tail rdf:first ?tailHead }
                }
            }
        """ ] .

    spexpr:ExpressionListShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of expression values" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest+ ?tail .
                    FILTER ( ?tail != rdf:nil )
                    FILTER NOT EXISTS { ?tail rdf:first ?tailHead }
                }
            }
        """ ] .

    spexpr:ExpressionShape a sh:NodeShape ;
        rdfs:isDefinedBy spexpr:ShapesGraph ;
        sh:message "expected a legal expression value (a term/Variable, or a recognized expression builtin)" ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:Literal ] spexpr:VariableShape [ sh:class spexpr:Expression ;
                    sh:nodeKind sh:BlankNode ] ) .

    spexpr:ShapesGraph a sh:ShapesGraph .
}

starontology:sqe-ontology.ttl {
    sqe:Alias a rdfs:Class ;
        rdfs:comment "(expr AS ?var) in a projection or GROUP BY - sqe:expr the expression, sqe:var the variable it binds." .

    sqe:Bind a rdfs:Class ;
        rdfs:comment "A BIND(... AS ?var) element - sqe:expr -> an expression tree (spexpr:); sqe:var -> the bound variable." .

    sqe:Exists a rdfs:Class ;
        rdfs:comment "EXISTS { ... } (or NOT EXISTS when sqe:negated is true) inside an expression - sqe:where -> its own flat pattern list." ;
        rdfs:subClassOf spexpr:Expression .

    sqe:Filter a rdfs:Class ;
        rdfs:comment "A FILTER(...) element - sqe:expr -> an expression tree (the shared spexpr: vocabulary, not re-modeled here)." .

    sqe:Graph a rdfs:Class ;
        rdfs:comment "A GRAPH ?g { ... } block - sqe:graph the graph IRI or variable, sqe:where the flat pattern list." .

    sqe:Minus a rdfs:Class ;
        rdfs:comment "A MINUS { ... } block - sqe:where -> its own flat pattern list." .

    sqe:Optional a rdfs:Class ;
        rdfs:comment "An OPTIONAL { ... } block - sqe:where -> its own nested flat pattern list." .

    sqe:OrderCondition a rdfs:Class ;
        rdfs:comment "One ORDER BY condition - sqe:expr -> a variable or expression; sqe:descending true for DESC(...), absent for ascending." .

    sqe:SubSelect a rdfs:Class ;
        rdfs:comment "A nested SELECT in a pattern list - the same properties as a sqe:SelectQuery; not itself a sqe:Query." ;
        rdfs:subClassOf sqe:SelectQuery .

    sqe:TriplePattern a rdfs:Class ;
        rdfs:comment "One (subject, predicate, object) triple pattern - exactly one of each, via sqe:subject/sqe:predicate/sqe:object. A predicate that's a real property path uses the shared spexpr: path encoding." .

    sqe:TripleTerm a rdfs:Class ;
        rdfs:comment "An RDF 1.2 triple term <<( s p o )>> in a pattern's object position (or nested as another triple term's object) - sqe:subject/sqe:predicate/sqe:object, each a term or variable. Reified-triple and annotation shorthand is written out as its expansion: a rdf:reifies triple plus ordinary triples." ;
        rdfs:subClassOf spexpr:Expression .

    sqe:Union a rdfs:Class ;
        rdfs:comment "A { ... } UNION { ... } [UNION { ... }]* block - sqe:alternatives -> rdf:List of nested flat pattern lists, one per alternative." .

    sqe:Values a rdfs:Class ;
        rdfs:comment "A VALUES block, as a pattern or as a query's trailing sqe:values - sqe:vars the variables, sqe:rows an rdf:List of rows (rdf:List of terms, or sqe:undef)." .

    sqe:AskQuery rdfs:comment "An ASK query's root. sqe:where -> the flat pattern list; no projection." ;
        rdfs:subClassOf sqe:Query .

    sqe:alternatives a rdf:Property ;
        rdfs:domain sqe:Union .

    sqe:descending a rdf:Property ;
        rdfs:domain sqe:OrderCondition .

    sqe:distinct a rdf:Property ;
        rdfs:comment "true for SELECT DISTINCT." ;
        rdfs:domain sqe:SelectQuery .

    sqe:expr a rdf:Property ;
        rdfs:comment "Shared by several node types (sqe:Filter, Bind, Alias, OrderCondition); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

    sqe:graph a rdf:Property ;
        rdfs:domain sqe:Graph .

    sqe:groupBy a rdf:Property ;
        rdfs:domain sqe:SelectQuery .

    sqe:having a rdf:Property ;
        rdfs:domain sqe:SelectQuery .

    sqe:limit a rdf:Property ;
        rdfs:comment "LIMIT n (xsd:integer), on a SELECT or CONSTRUCT root." .

    sqe:negated a rdf:Property ;
        rdfs:domain sqe:Exists .

    sqe:object a rdf:Property ;
        rdfs:comment "Shared by several node types (sqe:TriplePattern, TripleTerm); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

    sqe:offset a rdf:Property ;
        rdfs:comment "OFFSET n (xsd:integer), on a SELECT or CONSTRUCT root." .

    sqe:orderBy a rdf:Property ;
        rdfs:comment "ORDER BY: a flat rdf:List of sqe:OrderCondition, on a SELECT or CONSTRUCT root." .

    sqe:predicate a rdf:Property ;
        rdfs:comment "Shared by several node types (sqe:TriplePattern, TripleTerm); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

    sqe:projection a rdf:Property ;
        rdfs:domain sqe:SelectQuery .

    sqe:reduced a rdf:Property ;
        rdfs:comment "true for SELECT REDUCED." ;
        rdfs:domain sqe:SelectQuery .

    sqe:rows a rdf:Property ;
        rdfs:domain sqe:Values .

    sqe:selectAll a rdf:Property ;
        rdfs:comment "true for SELECT *; replaces sqe:projection." ;
        rdfs:domain sqe:SelectQuery .

    sqe:subject a rdf:Property ;
        rdfs:comment "Shared by several node types (sqe:TriplePattern, TripleTerm); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

    sqe:template a rdf:Property ;
        rdfs:domain sqe:ConstructQuery .

    sqe:values a rdf:Property ;
        rdfs:comment "A query's trailing VALUES clause (a sqe:Values)." .

    sqe:var a rdf:Property ;
        rdfs:comment "Shared by several node types (sqe:Bind, Alias); deliberately no rdfs:domain, which would give each of them the wrong extra type under RDFS inference." .

    sqe:vars a rdf:Property ;
        rdfs:domain sqe:Values .

    sqe:where a rdf:Property ;
        rdfs:comment "A flat, ordered rdf:List of sibling pattern elements (sqe:TriplePattern/Optional/Union/Minus/Graph/Filter/Bind/Values/SubSelect) - mirrors the raw parse tree's own already-flat GroupGraphPatternSub.part shape, not the salg: algebra's nested LeftJoin/Filter wrapping." .

    sqe:ConstructQuery rdfs:comment "A CONSTRUCT query's root. sqe:template -> rdf:List of sqe:TriplePattern; sqe:where -> the flat pattern list." ;
        rdfs:subClassOf sqe:Query .

    sqe:Query rdfs:comment "The root of any encoded sqe: query, of any form - also typed sqe:Query regardless of query form, see to_rdf.query_to_sqe_rdf." .

    sqe:SelectQuery rdfs:comment "A SELECT query's root. sqe:projection -> rdf:List of variables and sqe:Alias nodes (or sqe:selectAll true for SELECT *); sqe:where -> the flat pattern list; optionally sqe:distinct/reduced, sqe:groupBy, sqe:having, sqe:orderBy, sqe:limit, sqe:offset and a trailing sqe:values." ;
        rdfs:subClassOf sqe:Query .
}

starontology:sqe_shapes.ttl {
    sqe:ShapesGraph a sh:ShapesGraph ;
        rdfs:member sqe:AliasShape,
            sqe:AlternativesListShape,
            sqe:AskQueryShape,
            sqe:BindShape,
            sqe:ConstructQueryShape,
            sqe:ExistsShape,
            sqe:FilterShape,
            sqe:GraphShape,
            sqe:GroupByListShape,
            sqe:HavingListShape,
            sqe:MinusShape,
            sqe:ObjectOrVariableShape,
            sqe:OptionalShape,
            sqe:OrderByListShape,
            sqe:OrderConditionShape,
            sqe:PredicateOrVariableOrPathShape,
            sqe:PrefixBindingShape,
            sqe:ProjectionListShape,
            sqe:PrologueShape,
            sqe:QueryValuesShape,
            sqe:RowsListShape,
            sqe:SelectModifierShape,
            sqe:SelectQueryShape,
            sqe:SolutionModifierShape,
            sqe:SubjectOrVariableShape,
            sqe:TemplateListShape,
            sqe:TriplePatternShape,
            sqe:TripleTermShape,
            sqe:UnionShape,
            sqe:ValuesShape,
            sqe:VariableListShape,
            sqe:WhereListShape ;
        owl:imports spexpr:ShapesGraph .

    sqe:AliasShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Alias must have exactly one sqe:expr, an expression" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path sqe:expr ],
            [ sh:maxCount 1 ;
                sh:message "sqe:Alias must have exactly one sqe:var, the variable it binds" ;
                sh:minCount 1 ;
                sh:node spexpr:VariableShape ;
                sh:path sqe:var ] ;
        sh:targetClass sqe:Alias .

    sqe:AskQueryShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:AskQuery must have exactly one sqe:where, a well-formed pattern list" ;
                sh:minCount 1 ;
                sh:node sqe:WhereListShape ;
                sh:path sqe:where ] ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having)/rdf:rest*/rdf:first ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:vars|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|rdf:rest|rdf:first)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/rdf:rest*/rdf:first/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """ ] ;
        sh:targetClass sqe:AskQuery .

    sqe:BindShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Bind must have exactly one sqe:expr, a well-formed expression" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path sqe:expr ],
            [ sh:maxCount 1 ;
                sh:message "sqe:Bind must have exactly one sqe:var, a Variable" ;
                sh:minCount 1 ;
                sh:node spexpr:VariableShape ;
                sh:path sqe:var ] ;
        sh:targetClass sqe:Bind .

    sqe:ConstructQueryShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:ConstructQuery must have exactly one sqe:where, a well-formed pattern list" ;
                sh:minCount 1 ;
                sh:node sqe:WhereListShape ;
                sh:path sqe:where ],
            [ sh:maxCount 1 ;
                sh:message "sqe:ConstructQuery must have exactly one sqe:template, an rdf:List of TriplePattern" ;
                sh:minCount 1 ;
                sh:node sqe:TemplateListShape ;
                sh:path sqe:template ] ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "Template variable {?var} is never bound anywhere in this query's own sqe:where pattern." ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                $this sqe:template/rdf:rest*/rdf:first ?tpl .
                ?tpl a sqe:TriplePattern ;
                    (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """ ],
            [ a sh:SPARQLConstraint ;
                sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having)/rdf:rest*/rdf:first ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:vars|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|rdf:rest|rdf:first)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/rdf:rest*/rdf:first/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """ ] ;
        sh:targetClass sqe:ConstructQuery .

    sqe:ExistsShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Exists must have exactly one sqe:where, a well-formed pattern list" ;
                sh:minCount 1 ;
                sh:node sqe:WhereListShape ;
                sh:path sqe:where ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:message "sqe:negated must be a single xsd:boolean" ;
                sh:path sqe:negated ] ;
        sh:targetClass sqe:Exists .

    sqe:FilterShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Filter must have exactly one sqe:expr, a well-formed expression" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path sqe:expr ] ;
        sh:targetClass sqe:Filter .

    sqe:GraphShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Graph must have exactly one sqe:where, a well-formed pattern list" ;
                sh:minCount 1 ;
                sh:node sqe:WhereListShape ;
                sh:path sqe:where ],
            [ sh:maxCount 1 ;
                sh:message "sqe:Graph must have exactly one sqe:graph, an IRI or variable" ;
                sh:minCount 1 ;
                sh:or ( [ sh:nodeKind sh:IRI ] spexpr:VariableShape ) ;
                sh:path sqe:graph ] ;
        sh:targetClass sqe:Graph .

    sqe:MinusShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Minus must have exactly one sqe:where, a well-formed pattern list" ;
                sh:minCount 1 ;
                sh:node sqe:WhereListShape ;
                sh:path sqe:where ] ;
        sh:targetClass sqe:Minus .

    sqe:OptionalShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Optional must have exactly one sqe:where, a well-formed pattern list" ;
                sh:minCount 1 ;
                sh:node sqe:WhereListShape ;
                sh:path sqe:where ] ;
        sh:targetClass sqe:Optional .

    sqe:OrderConditionShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:OrderCondition must have exactly one sqe:expr, a variable or well-formed expression" ;
                sh:minCount 1 ;
                sh:node spexpr:ExpressionShape ;
                sh:path sqe:expr ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:message "sqe:descending must be a single xsd:boolean" ;
                sh:path sqe:descending ] ;
        sh:targetClass sqe:OrderCondition .

    sqe:PrefixBindingShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:PrefixBinding must have exactly one sqe:namespace, an IRI" ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:path sqe:namespace ],
            [ sh:datatype spexpr:PlainString ;
                sh:maxCount 1 ;
                sh:message "sqe:PrefixBinding must have exactly one sqe:prefixLabel, a spexpr:PlainString-tagged string" ;
                sh:minCount 1 ;
                sh:nodeKind sh:Literal ;
                sh:path sqe:prefixLabel ] ;
        sh:targetClass sqe:PrefixBinding .

    sqe:PrologueShape a sh:NodeShape ;
        sh:property [ sh:class sqe:PrefixBinding ;
                sh:message "sqe:prologuePrefix must be a sqe:PrefixBinding node" ;
                sh:path sqe:prologuePrefix ],
            [ sh:maxCount 1 ;
                sh:message "sqe:base must be a single IRI" ;
                sh:nodeKind sh:IRI ;
                sh:path sqe:base ] ;
        sh:targetClass sqe:Query .

    sqe:QueryValuesShape a sh:NodeShape ;
        sh:property [ sh:class sqe:Values ;
                sh:maxCount 1 ;
                sh:message "a query's trailing sqe:values must be a single sqe:Values block" ;
                sh:path sqe:values ] ;
        sh:targetClass sqe:Query,
            sqe:SubSelect .

    sqe:SelectModifierShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:groupBy must be a single, non-empty rdf:List of variables, expressions or sqe:Alias" ;
                sh:node sqe:GroupByListShape ;
                sh:path sqe:groupBy ],
            [ sh:maxCount 1 ;
                sh:message "sqe:having must be a single, non-empty rdf:List of expressions" ;
                sh:node sqe:HavingListShape ;
                sh:path sqe:having ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:message "sqe:selectAll must be a single xsd:boolean" ;
                sh:path sqe:selectAll ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:message "sqe:distinct must be a single xsd:boolean" ;
                sh:path sqe:distinct ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:message "sqe:reduced must be a single xsd:boolean" ;
                sh:path sqe:reduced ] ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "A sqe:SelectQuery needs exactly one of sqe:projection (a variable list) or sqe:selectAll (SELECT *)." ;
                sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER NOT EXISTS { $this sqe:projection ?p }
                    FILTER NOT EXISTS { $this sqe:selectAll ?a }
                } UNION {
                    $this sqe:projection ?p ; sqe:selectAll ?a .
                }
            }
        """ ],
            [ a sh:SPARQLConstraint ;
                sh:message "A sqe:SelectQuery cannot be both sqe:distinct and sqe:reduced." ;
                sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE { $this sqe:distinct ?d ; sqe:reduced ?r . }
        """ ] ;
        sh:targetClass sqe:SelectQuery .

    sqe:SelectQueryShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:SelectQuery may have at most one sqe:projection, a non-empty rdf:List of variables and aliases" ;
                sh:node sqe:ProjectionListShape ;
                sh:path sqe:projection ],
            [ sh:maxCount 1 ;
                sh:message "sqe:SelectQuery must have exactly one sqe:where, a well-formed pattern list" ;
                sh:minCount 1 ;
                sh:node sqe:WhereListShape ;
                sh:path sqe:where ] ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "Projected variable {?var} is never bound anywhere in this query's own sqe:where pattern." ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                $this sqe:projection/rdf:rest*/rdf:first ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this sqe:groupBy/rdf:rest*/rdf:first/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """ ],
            [ a sh:SPARQLConstraint ;
                sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having)/rdf:rest*/rdf:first ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/rdf:rest*/rdf:first/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:vars|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|rdf:rest|rdf:first)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/rdf:rest*/rdf:first/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|rdf:rest|rdf:first)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/rdf:rest*/rdf:first/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/rdf:rest*/rdf:first ?var .
                    }
                }
            }
        """ ] ;
        sh:targetClass sqe:SelectQuery .

    sqe:SolutionModifierShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:orderBy must be a single, well-formed rdf:List of sqe:OrderCondition" ;
                sh:node sqe:OrderByListShape ;
                sh:path sqe:orderBy ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:message "sqe:limit must be a single non-negative xsd:integer" ;
                sh:minInclusive 0 ;
                sh:path sqe:limit ],
            [ sh:datatype xsd:integer ;
                sh:maxCount 1 ;
                sh:message "sqe:offset must be a single non-negative xsd:integer" ;
                sh:minInclusive 0 ;
                sh:path sqe:offset ] ;
        sh:targetClass sqe:ConstructQuery,
            sqe:SelectQuery .

    sqe:TriplePatternShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:TriplePattern must have exactly one sqe:subject, an IRI/blank node/Variable" ;
                sh:minCount 1 ;
                sh:node sqe:SubjectOrVariableShape ;
                sh:path sqe:subject ],
            [ sh:maxCount 1 ;
                sh:message "sqe:TriplePattern must have exactly one sqe:predicate, an IRI/Variable/property path" ;
                sh:minCount 1 ;
                sh:node sqe:PredicateOrVariableOrPathShape ;
                sh:path sqe:predicate ],
            [ sh:maxCount 1 ;
                sh:message "sqe:TriplePattern must have exactly one sqe:object" ;
                sh:minCount 1 ;
                sh:node sqe:ObjectOrVariableShape ;
                sh:path sqe:object ] ;
        sh:targetClass sqe:TriplePattern .

    sqe:TripleTermShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:TripleTerm must have exactly one sqe:subject (an IRI, blank node or variable - never a triple term)" ;
                sh:minCount 1 ;
                sh:node sqe:SubjectOrVariableShape ;
                sh:path sqe:subject ],
            [ sh:maxCount 1 ;
                sh:message "sqe:TripleTerm must have exactly one sqe:predicate (an IRI or variable)" ;
                sh:minCount 1 ;
                sh:or ( [ sh:nodeKind sh:IRI ] spexpr:VariableShape ) ;
                sh:path sqe:predicate ],
            [ sh:maxCount 1 ;
                sh:message "sqe:TripleTerm must have exactly one sqe:object" ;
                sh:minCount 1 ;
                sh:node sqe:ObjectOrVariableShape ;
                sh:path sqe:object ] ;
        sh:targetClass sqe:TripleTerm .

    sqe:UnionShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Union must have exactly one sqe:alternatives, an rdf:List of pattern lists" ;
                sh:minCount 1 ;
                sh:node sqe:AlternativesListShape ;
                sh:path sqe:alternatives ] ;
        sh:targetClass sqe:Union .

    sqe:ValuesShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "sqe:Values must have exactly one sqe:vars, an rdf:List of variables" ;
                sh:minCount 1 ;
                sh:node sqe:VariableListShape ;
                sh:path sqe:vars ],
            [ sh:maxCount 1 ;
                sh:message "sqe:Values must have exactly one sqe:rows, an rdf:List of rdf:List rows" ;
                sh:minCount 1 ;
                sh:node sqe:RowsListShape ;
                sh:path sqe:rows ] ;
        sh:targetClass sqe:Values .

    sqe:AlternativesListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List whose members are themselves well-formed pattern lists" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?alt .
                    {
                        FILTER ( ?alt != rdf:nil )
                        FILTER NOT EXISTS { ?alt rdf:first ?altHead }
                    } UNION {
                        ?alt rdf:rest*/rdf:first ?item .
                        FILTER NOT EXISTS {
                            ?item a ?t .
                            FILTER ( ?t IN ( sqe:TriplePattern, sqe:Optional, sqe:Union, sqe:Filter, sqe:Bind, sqe:Minus, sqe:Graph, sqe:Values, sqe:SubSelect ) )
                        }
                    }
                }
            }
        """ ] .

    sqe:GroupByListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "sqe:groupBy must be a non-empty rdf:List of variables, sqe:Alias nodes or expressions" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( isLiteral(?item) && datatype(?item) != spexpr:Variable || isIRI(?item) )
                }
            }
        """ ] .

    sqe:HavingListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "sqe:having must be a non-empty rdf:List of expressions" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                }
            }
        """ ] .

    sqe:OrderByListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed, non-empty rdf:List of sqe:OrderCondition" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a sqe:OrderCondition }
                }
            }
        """ ] .

    sqe:PredicateOrVariableOrPathShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] spexpr:VariableShape spexpr:PathShape ) .

    sqe:ProjectionListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "sqe:projection must be a non-empty rdf:List of variables and sqe:Alias nodes" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this = rdf:nil )
                } UNION {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a sqe:Alias }
                    FILTER NOT EXISTS { FILTER ( isLiteral(?item) && datatype(?item) = spexpr:Variable ) }
                }
            }
        """ ] .

    sqe:RowsListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "sqe:rows must be a well-formed rdf:List of rdf:List rows" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?row .
                    FILTER ( ?row != rdf:nil )
                    FILTER NOT EXISTS { ?row rdf:first ?cell }
                }
            }
        """ ] .

    sqe:TemplateListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of sqe:TriplePattern" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a sqe:TriplePattern }
                }
            }
        """ ] .

    sqe:VariableListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected an rdf:List of variables" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { FILTER ( isLiteral(?item) && datatype(?item) = spexpr:Variable ) }
                }
            }
        """ ] .

    sqe:ObjectOrVariableShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:BlankNode ] [ sh:nodeKind sh:Literal ] [ sh:class sqe:TripleTerm ] spexpr:VariableShape ) .

    sqe:SubjectOrVariableShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:BlankNode ] spexpr:VariableShape ) .

    sqe:WhereListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of sqe:TriplePattern/Optional/Union/Filter/Bind/Minus/Graph/Values/SubSelect" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS {
                        ?item a ?t .
                        FILTER ( ?t IN ( sqe:TriplePattern, sqe:Optional, sqe:Union, sqe:Filter, sqe:Bind, sqe:Minus, sqe:Graph, sqe:Values, sqe:SubSelect ) )
                    }
                }
            }
        """ ] .
}

starontology:srl-ontology.ttl {
    srl:AssignmentElement a rdfs:Class ;
        rdfs:comment "SET (?var := expr) - srl:var/srl:expr, §4.1. Never legal inside a negation element's own body." ;
        rdfs:subClassOf srl:BodyElement .

    srl:BodyElement a rdfs:Class ;
        rdfs:comment "The union of every rule-body element kind: TriplePattern, FilterElement, AssignmentElement, NegationElement." .

    srl:Data a rdfs:Class ;
        rdfs:comment "One top-level DATA {} block - srl:triples, ground only, §4.1." .

    srl:FilterElement a rdfs:Class ;
        rdfs:comment "FILTER Constraint - srl:expr, a real salg: expression tree, §4.1." ;
        rdfs:subClassOf srl:BodyElement,
            srl:NegationBodyElement .

    srl:NegationBodyElement a rdfs:Class ;
        rdfs:comment "The narrower union a negation element's own inner body is restricted to: TriplePattern or FilterElement only." .

    srl:NegationElement a rdfs:Class ;
        rdfs:comment "NOT DATA? {...} - srl:inner (a list of srl:NegationBodyElement), srl:negationEvaldata (bool: true = match the evaluation graph, false = NOT DATA), §4.1. Never legal inside another negation element's own body." ;
        rdfs:subClassOf srl:BodyElement .

    srl:Rule a rdfs:Class ;
        rdfs:comment "One RULE - srl:head/srl:body (lists), srl:ruleEvaldata (bool: true = match the evaluation graph, false = WHERE DATA), srl:id (optional IRI), §4.1." .

    srl:RuleSet a rdfs:Class ;
        rdfs:comment "A whole SRL rule set - srl:rules/srl:data/srl:imports, §4.1." .

    srl:TriplePattern a rdfs:Class ;
        rdfs:comment "A triple template (rule head) or triple pattern (rule body/DATA) - srl:subject/srl:predicate/srl:object, same shape either way per §4.1." ;
        rdfs:subClassOf srl:BodyElement,
            srl:NegationBodyElement .
}

starontology:srl_shapes.ttl {
    srl:ShapesGraph a sh:ShapesGraph ;
        rdfs:member srl:AssignmentElementShape,
            srl:BodyListShape,
            srl:DataListShape,
            srl:DataShape,
            srl:FilterElementShape,
            srl:ImportsListShape,
            srl:NegationElementShape,
            srl:NegationInnerListShape,
            srl:PredicateOrVariableShape,
            srl:RuleListShape,
            srl:RuleSetShape,
            srl:RuleShape,
            srl:TermOrVariableShape,
            srl:TripleListShape,
            srl:TriplePatternShape ;
        owl:imports spexpr:ShapesGraph .

    srl:AssignmentElementShape a sh:NodeShape ;
        sh:property [ sh:class spexpr:Expression ;
                sh:maxCount 1 ;
                sh:message "srl:AssignmentElement must have exactly one srl:expr, a salg: expression" ;
                sh:minCount 1 ;
                sh:path srl:expr ],
            [ sh:datatype spexpr:Variable ;
                sh:maxCount 1 ;
                sh:message "srl:AssignmentElement must have exactly one srl:var" ;
                sh:minCount 1 ;
                sh:path srl:var ] ;
        sh:targetClass srl:AssignmentElement .

    srl:DataShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "srl:Data must have exactly one srl:triples list" ;
                sh:minCount 1 ;
                sh:node srl:TripleListShape ;
                sh:path srl:triples ] ;
        sh:targetClass srl:Data .

    srl:FilterElementShape a sh:NodeShape ;
        sh:property [ sh:class spexpr:Expression ;
                sh:maxCount 1 ;
                sh:message "srl:FilterElement must have exactly one srl:expr, a salg: expression" ;
                sh:minCount 1 ;
                sh:path srl:expr ] ;
        sh:targetClass srl:FilterElement .

    srl:NegationElementShape a sh:NodeShape ;
        sh:property [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:message "srl:NegationElement must have exactly one boolean srl:negationEvaldata" ;
                sh:minCount 1 ;
                sh:path srl:negationEvaldata ],
            [ sh:maxCount 1 ;
                sh:message "srl:NegationElement must have exactly one srl:inner list" ;
                sh:minCount 1 ;
                sh:node srl:NegationInnerListShape ;
                sh:path srl:inner ] ;
        sh:targetClass srl:NegationElement .

    srl:RuleSetShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "srl:RuleSet must have exactly one srl:imports list" ;
                sh:minCount 1 ;
                sh:node srl:ImportsListShape ;
                sh:path srl:imports ],
            [ sh:maxCount 1 ;
                sh:message "srl:RuleSet must have exactly one srl:data list" ;
                sh:minCount 1 ;
                sh:node srl:DataListShape ;
                sh:path srl:data ],
            [ sh:maxCount 1 ;
                sh:message "srl:RuleSet must have exactly one srl:rules list" ;
                sh:minCount 1 ;
                sh:node srl:RuleListShape ;
                sh:path srl:rules ] ;
        sh:targetClass srl:RuleSet .

    srl:RuleShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "srl:Rule must have exactly one srl:head list" ;
                sh:minCount 1 ;
                sh:node srl:TripleListShape ;
                sh:path srl:head ],
            [ sh:maxCount 1 ;
                sh:message "srl:Rule must have exactly one srl:body list" ;
                sh:minCount 1 ;
                sh:node srl:BodyListShape ;
                sh:path srl:body ],
            [ sh:maxCount 1 ;
                sh:message "srl:id, if present, must be exactly one IRI" ;
                sh:nodeKind sh:IRI ;
                sh:path srl:id ],
            [ sh:datatype xsd:boolean ;
                sh:maxCount 1 ;
                sh:message "srl:Rule must have exactly one boolean srl:ruleEvaldata" ;
                sh:minCount 1 ;
                sh:path srl:ruleEvaldata ] ;
        sh:targetClass srl:Rule .

    srl:TriplePatternShape a sh:NodeShape ;
        sh:property [ sh:maxCount 1 ;
                sh:message "srl:TriplePattern must have exactly one srl:object" ;
                sh:minCount 1 ;
                sh:node srl:TermOrVariableShape ;
                sh:path srl:object ],
            [ sh:maxCount 1 ;
                sh:message "srl:TriplePattern must have exactly one srl:predicate, an IRI/Variable" ;
                sh:minCount 1 ;
                sh:node srl:PredicateOrVariableShape ;
                sh:path srl:predicate ],
            [ sh:maxCount 1 ;
                sh:message "srl:TriplePattern must have exactly one srl:subject" ;
                sh:minCount 1 ;
                sh:node srl:TermOrVariableShape ;
                sh:path srl:subject ] ;
        sh:targetClass srl:TriplePattern .

    srl:BodyListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of srl:BodyElement" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX srl: <https://github.com/hidden-graph/starlayer/ns/sparql/srl#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a srl:BodyElement }
                }
            }
        """ ] .

    srl:DataListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of srl:Data" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX srl: <https://github.com/hidden-graph/starlayer/ns/sparql/srl#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a srl:Data }
                }
            }
        """ ] .

    srl:ImportsListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of IRIs" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER ( !isIRI(?item) )
                }
            }
        """ ] .

    srl:NegationInnerListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of srl:NegationBodyElement (triple patterns/filters only)" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX srl: <https://github.com/hidden-graph/starlayer/ns/sparql/srl#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a srl:NegationBodyElement }
                }
            }
        """ ] .

    srl:PredicateOrVariableShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:datatype spexpr:Variable ] ) .

    srl:RuleListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of srl:Rule" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX srl: <https://github.com/hidden-graph/starlayer/ns/sparql/srl#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a srl:Rule }
                }
            }
        """ ] .

    srl:TermOrVariableShape a sh:NodeShape ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:nodeKind sh:BlankNode ] [ sh:datatype spexpr:Variable ] [ sh:nodeKind sh:Literal ] ) .

    srl:TripleListShape a sh:NodeShape ;
        sh:sparql [ a sh:SPARQLConstraint ;
                sh:message "expected a well-formed rdf:List of srl:TriplePattern" ;
                sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX srl: <https://github.com/hidden-graph/starlayer/ns/sparql/srl#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS { ?item a srl:TriplePattern }
                }
            }
        """ ] .
}

starontology:starlayer-profiles.ttl {
    # StarLayer's profiles and its conformance declaration, in one document.
    #
    # 1. Public layer: W3C specifications (tr:) and the public SHACL profiles
    #    (profile:). Defined elsewhere; only labelled here.
    # 2. StarLayer profiles (slp:): each is a prof:Profile that is a profile of a
    #    public specification or public SHACL profile, and lists its own ontology
    #    and shapes files as resources. A shapes graph checks conformance to the
    #    StarLayer profile that lists it; the link from that profile to the public
    #    specification is what makes the conformance claim reach the public layer
    #    (see starlayer.shacl.derive_conforms_to()).
    # 3. StarLayer's own modules (pkg:): the self-declared conformance of
    #    starlayer.graph, starlayer.sparql and starlayer.shacl, written out in full.
    #    dcterms:conformsTo is the claim; conformance:doesNotConformTo is this
    #    project's own term (no standard negative predicate exists in dx-prof or
    #    Dublin Core) and is used only where the excluded thing has its own IRI.
    #
    # This is a self-declaration, not a third-party certification. RDF 1.2, SPARQL
    # 1.2 and the SHACL 1.2 documents are still drafts, so treat the claims as a
    # dated snapshot; docs/graph/rdf12_sparql12_gap_analysis.md and
    # docs/shacl/shacl12-gap-matrix.md are the working sources they come from.
    #
    # SPARQL has no named-profile vocabulary like SHACL's, so starlayer.sparql
    # conforms to the SPARQL TR documents directly. SPARQL 1.2 Entailment Regimes
    # is not claimed as a document (three of its six regimes are unimplemented);
    # each supported regime is claimed by its own IRI instead, and the
    # unsupported D-Entailment regime is excluded by IRI. RDF/XML 1.2 and SPARQL
    # 1.2 RL are claimed within documented scope limits.

    slp:Manchester a prof:Profile ;
        rdfs:label "StarLayer OWL 2 Manchester Syntax profile" ;
        prof:hasResource [ a prof:ResourceDescriptor ;
                rdfs:label "manchester_owl" ;
                rdfs:comment "OWL 2 Manchester Syntax's own internal AST as RDF (manch:) - frames/clauses/class- and property-expressions/data-ranges, one level upstream of the compiled OWL RDF mapping." ;
                prof:hasArtifact starontology:manchester-ast-ontology.ttl ;
                prof:hasRole role:schema ],
            [ a prof:ResourceDescriptor ;
                rdfs:label "manchester_shacl" ;
                rdfs:comment "SHACL shapes validating a manch: AST graph's own structural well-formedness." ;
                prof:hasArtifact starontology:manchester_shapes.ttl ;
                prof:hasRole role:validation ] ;
        prof:isProfileOf tr:owl2-manchester-syntax .

    slp:Shacl a prof:Profile ;
        rdfs:label "StarLayer SHACL 1.2 profile" ;
        prof:hasResource [ a prof:ResourceDescriptor ;
                rdfs:label "shacl_shacl" ;
                rdfs:comment "The SHACL 1.2 meta-shapes: the shapes that check a shapes graph is well-formed." ;
                prof:hasArtifact starontology:shacl12-shacl.ttl ;
                prof:hasRole role:validation ] ;
        prof:isProfileOf profile:core,
            profile:node-expr,
            profile:profiling,
            profile:rules,
            profile:sparql .

    slp:Skos a prof:Profile ;
        rdfs:label "StarLayer SKOS profile" ;
        prof:hasResource [ a prof:ResourceDescriptor ;
                rdfs:label "skos_owl" ;
                rdfs:comment "The W3C's own SKOS vocabulary (skos.rdf from the SKOS Reference, W3C Recommendation 2009), over the real skos: namespace." ;
                prof:hasArtifact starontology:skos-ontology.ttl ;
                prof:hasRole role:schema ],
            [ a prof:ResourceDescriptor ;
                rdfs:label "skos_shacl" ;
                rdfs:comment "SHACL shapes for SKOS: the Reference's numbered conditions as validation shapes, plus form shapes carrying shui:editor/shui:viewer widgets chosen by each property's datatype." ;
                prof:hasArtifact starontology:skos_shapes.ttl ;
                prof:hasRole role:validation ] ;
        prof:isProfileOf tr:skos-reference .

    slp:SparqlQuery a prof:Profile ;
        rdfs:label "StarLayer SPARQL 1.2 Query profile" ;
        prof:hasResource [ a prof:ResourceDescriptor ;
                rdfs:label "sqe_shacl" ;
                rdfs:comment "SHACL shapes validating an sqe: query-edit graph's own structural well-formedness, designed for UI-editor field-level validation, not just decode-ability." ;
                prof:hasArtifact starontology:sqe_shapes.ttl ;
                prof:hasRole role:validation ],
            [ a prof:ResourceDescriptor ;
                rdfs:label "spexpr_owl" ;
                rdfs:comment "The SPARQL expression/variable/property-path vocabulary (spexpr:) - the one slice salg:/sqe:/srl: all need identically." ;
                prof:hasArtifact starontology:spexpr-ontology.ttl ;
                prof:hasRole role:schema ],
            [ a prof:ResourceDescriptor ;
                rdfs:label "sqe_owl" ;
                rdfs:comment "A SPARQL SELECT/ASK/CONSTRUCT query's own raw parse tree, pre-translateQuery, as a flat, human-readable RDF tree (sqe:) meant for hand/UI editing - deliberately not the resolved salg: algebra." ;
                prof:hasArtifact starontology:sqe-ontology.ttl ;
                prof:hasRole role:schema ],
            [ a prof:ResourceDescriptor ;
                rdfs:label "spexpr_shacl" ;
                rdfs:comment "SHACL shapes validating an spexpr: expression/variable/path value's own well-formedness - imported by salg:/sqe:/srl: alike (each via owl:imports), not defined separately by any one of them." ;
                prof:hasArtifact starontology:spexpr_shapes.ttl ;
                prof:hasRole role:validation ] ;
        prof:isProfileOf tr:sparql12-query .

    slp:SparqlRL a prof:Profile ;
        rdfs:label "StarLayer SPARQL 1.2 RL profile" ;
        prof:hasResource [ a prof:ResourceDescriptor ;
                rdfs:label "srl_owl" ;
                rdfs:comment "SRL/SPARQL-RL's own rule-set abstract syntax as RDF (srl:) - a Datalog-style rules language, general-purpose and SHACL-independent." ;
                prof:hasArtifact starontology:srl-ontology.ttl ;
                prof:hasRole role:schema ],
            [ a prof:ResourceDescriptor ;
                rdfs:label "srl_shacl" ;
                rdfs:comment "SHACL shapes validating an srl: rule-set graph's own structural well-formedness." ;
                prof:hasArtifact starontology:srl_shapes.ttl ;
                prof:hasRole role:validation ] ;
        prof:isProfileOf tr:sparql12-rl .

    pkg:graph rdfs:label "starlayer.graph" ;
        dcterms:conformsTo <http://www.w3.org/ns/entailment/OWL-Direct>,
            <http://www.w3.org/ns/entailment/OWL-RDF-Based>,
            <http://www.w3.org/ns/entailment/RDF>,
            <http://www.w3.org/ns/entailment/RDFS>,
            tr:rdf-canon,
            tr:rdf12-concepts,
            tr:rdf12-n-triples,
            tr:rdf12-schema,
            tr:rdf12-turtle,
            tr:rdf12-xml,
            tr:sparql12-protocol ;
        dcterms:modified "2026-10-17"^^xsd:date ;
        rdfs:comment "Not claimed: the full SPARQL 1.2 Entailment Regimes document (D-Entailment, full OWL 2 RDF-Based Semantics, and RIF Core Entailment are unimplemented - see the individually-listed supported regimes instead), nor JSON-LD \"1.2\"/TriX \"1.2\" (neither has a real RDF 1.2 companion spec to converge on at all)."@en,
            "RDF 1.2 graph management - the rdflib replacement, with triple-term and direction-tagged-literal support."@en ;
        conformance:doesNotConformTo <http://www.w3.org/ns/entailment/D> .

    pkg:shacl rdfs:label "starlayer.shacl" ;
        dcterms:conformsTo profile:core,
            profile:node-expr,
            profile:profiling,
            profile:rules,
            profile:sparql,
            tr:shacl12-ui ;
        dcterms:modified "2026-10-17"^^xsd:date ;
        rdfs:comment "Not claimed: the UI Profile. SHACL 1.2 Profiling defines it only as a subset of the SHACL Core vocabulary chosen for ease of UI implementation, lists no members and states no conformance requirements (Appendix A.3 is a TODO), so there is nothing to claim or exclude yet. The SHACL 1.2 UI widget-selection algorithm is implemented separately - see docs/shacl/shacl12-gap-matrix.md."@en,
            "SHACL 1.2 User Interfaces is claimed within documented scope limits: shui:editor, shui:viewer and the built-in widget annotations are accepted, documented and checked for well-formedness, and the Section 3 widget-selection algorithm is implemented (select_widget, select_widgets); shui:propertyRole annotations are accepted and documented but not interpreted, and no default widget scoring catalog ships with the library."@en,
            "pySHACL-based SHACL validation and rule execution with RDF 1.2 / triple-term support, part of the StarLayer stack."@en ;
        rdfs:seeAlso <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/docs/shacl/shacl12-gap-matrix.md> .

    pkg:sparql rdfs:label "starlayer.sparql" ;
        dcterms:conformsTo tr:sparql12-query,
            tr:sparql12-rl,
            tr:sparql12-update ;
        dcterms:modified "2026-10-17"^^xsd:date ;
        rdfs:comment "SPARQL 1.2 RL has documented grammar scope reductions - no ','-chained object lists, limited property paths, no reified-triple syntax yet, IMPORTS hard-rejected (see starlayer/sparql/CLAUDE.md)."@en,
            "SPARQL 1.2 query/update grammar, rewriting, and rule vocabularies (SRL/SQE) over RDF 1.2 graphs."@en .

    tr:owl2-manchester-syntax rdfs:label "OWL 2 Manchester Syntax" .

    tr:skos-reference rdfs:label "SKOS Reference" .

    tr:sparql12-query rdfs:label "SPARQL 1.2 Query" .

    tr:sparql12-rl rdfs:label "SPARQL 1.2 RL" .
}
