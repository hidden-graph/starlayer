@prefix manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix profile: <http://www.w3.org/ns/shacl/profile/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .
@prefix salg: <https://github.com/hidden-graph/starlayer/ns/sparql/algebra#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skshp: <https://github.com/hidden-graph/starlayer/ns/graph/skos-shapes#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#> .
@prefix srl: <https://github.com/hidden-graph/starlayer/ns/sparql/srl#> .
@prefix starontology: <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/starontology/> .
@prefix tr: <https://www.w3.org/TR/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shnex: <http://www.w3.org/ns/shacl-node-expr#> .
@prefix shsh: <http://www.w3.org/ns/shacl-shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui#> .
@prefix stsh: <https://github.com/hidden-graph/starlayer/ns/shacl#> .

starontology:skos-ontology.ttl {
    skos:altLabel a owl:AnnotationProperty ;
        rdfs:range rdfs:Literal ;
        rdfs:subPropertyOf rdfs:label .

    skos:changeNote a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:definition a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:editorialNote a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:exactMatch a owl:ObjectProperty,
            owl:SymmetricProperty,
            owl:TransitiveProperty ;
        rdfs:subPropertyOf skos:closeMatch .

    skos:example a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:hiddenLabel a owl:AnnotationProperty ;
        rdfs:range rdfs:Literal ;
        rdfs:subPropertyOf rdfs:label .

    skos:historyNote a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:member a owl:ObjectProperty ;
        rdfs:domain skos:Collection ;
        rdfs:range _:ndebcb4353754441bbdd729f23f4bd35fb1 .

    skos:memberList a owl:FunctionalProperty,
            owl:ObjectProperty ;
        rdfs:domain skos:OrderedCollection ;
        rdfs:range rdf:List .

    skos:narrowMatch a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:mappingRelation,
            skos:narrower ;
        owl:inverseOf skos:broadMatch .

    skos:notation a owl:DatatypeProperty .

    skos:prefLabel a owl:AnnotationProperty ;
        rdfs:range rdfs:Literal ;
        rdfs:subPropertyOf rdfs:label .

    skos:relatedMatch a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:subPropertyOf skos:mappingRelation,
            skos:related .

    skos:scopeNote a owl:AnnotationProperty ;
        rdfs:subPropertyOf skos:note .

    skos:topConceptOf a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:inScheme ;
        owl:inverseOf skos:hasTopConcept .

    skos:OrderedCollection a owl:Class ;
        rdfs:subClassOf skos:Collection .

    skos:broadMatch a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:broader,
            skos:mappingRelation .

    skos:closeMatch a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:subPropertyOf skos:mappingRelation .

    skos:hasTopConcept a owl:ObjectProperty ;
        rdfs:domain skos:ConceptScheme ;
        rdfs:range skos:Concept .

    skos:inScheme a owl:ObjectProperty ;
        rdfs:range skos:ConceptScheme .

    skos:narrower a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:narrowerTransitive ;
        owl:inverseOf skos:broader .

    skos:narrowerTransitive a owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:subPropertyOf skos:semanticRelation ;
        owl:inverseOf skos:broaderTransitive .

    skos:related a owl:ObjectProperty,
            owl:SymmetricProperty ;
        rdfs:subPropertyOf skos:semanticRelation .

    skos:broader a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:broaderTransitive .

    skos:broaderTransitive a owl:ObjectProperty,
            owl:TransitiveProperty ;
        rdfs:subPropertyOf skos:semanticRelation .

    skos:ConceptScheme a owl:Class ;
        owl:disjointWith skos:Collection .

    skos:Concept a owl:Class ;
        owl:disjointWith skos:Collection,
            skos:ConceptScheme .

    skos:mappingRelation a owl:ObjectProperty ;
        rdfs:subPropertyOf skos:semanticRelation .

    skos:semanticRelation a owl:ObjectProperty ;
        rdfs:domain skos:Concept ;
        rdfs:range skos:Concept .

    skos:Collection a owl:Class .

    skos:note a owl:AnnotationProperty .

    _:ndebcb4353754441bbdd729f23f4bd35fb1 a owl:Class ;
        owl:unionOf _:ndebcb4353754441bbdd729f23f4bd35fb2 .

    _:ndebcb4353754441bbdd729f23f4bd35fb2 rdf:first skos:Concept ;
        rdf:rest _:ndebcb4353754441bbdd729f23f4bd35fb3 .

    _:ndebcb4353754441bbdd729f23f4bd35fb3 rdf:first skos:Collection ;
        rdf:rest () .
}

starontology:ontology-shapes-profiles.ttl {
    starontology:manchester_shapes.ttl prof:isProfileOf tr:owl2-manchester-syntax .

    starontology:skos_shapes.ttl prof:isProfileOf tr:skos-reference .

    starontology:spexpr_shapes.ttl prof:isProfileOf tr:sparql12-query .

    starontology:sqe_shapes.ttl prof:isProfileOf tr:sparql12-query .

    starontology:srl_shapes.ttl prof:isProfileOf tr:sparql12-rl .

    starontology:shacl_meta_shapes.ttl prof:isProfileOf profile:core,
            profile:sparql,
            profile:node-expr,
            profile:rules,
            profile:profiling .

    tr:owl2-manchester-syntax rdfs:label "OWL 2 Manchester Syntax" ;
        prof:hasResource _:N28ea8dba3ff646cbb432cd5d96d197e9,
            _:N712878b48b0e494ca035592ffe57dd1f .

    tr:skos-reference rdfs:label "SKOS Reference" ;
        prof:hasResource _:N105b01bf5dd14840a016d9abf26eb3a0,
            _:N61db49617e1349c69ee7e9eaa20d6754 .

    tr:sparql12-rl rdfs:label "SPARQL 1.2 RL" ;
        prof:hasResource _:N2ac372caed214288944455f95edbc297,
            _:N803fbc5bac494bd6b092176f61bccd57 .

    tr:sparql12-query rdfs:label "SPARQL 1.2 Query" ;
        prof:hasResource _:N55d924414da94a0fab89c2d28a5028cc,
            _:N8090f4d133174524b461dc90a8c51f88,
            _:Na3e56f041a5f42118d650c6104d4c3a0,
            _:Naa5808a490d6415eb09025db23a8860a .

    _:N105b01bf5dd14840a016d9abf26eb3a0 a prof:ResourceDescriptor ;
        rdfs:label "skos_shacl" ;
        rdfs:comment "SHACL shapes checking SKOS's own numbered integrity conditions against a data graph." ;
        prof:hasArtifact starontology:skos_shapes.ttl ;
        prof:hasRole role:validation .

    _:N28ea8dba3ff646cbb432cd5d96d197e9 a prof:ResourceDescriptor ;
        rdfs:label "manchester_owl" ;
        rdfs:comment "OWL 2 Manchester Syntax's own internal AST as RDF (manch:) - frames/clauses/class- and property-expressions/data-ranges, one level upstream of the compiled OWL RDF mapping." ;
        prof:hasArtifact starontology:manchester-ast-ontology.ttl ;
        prof:hasRole role:schema .

    _:N2ac372caed214288944455f95edbc297 a prof:ResourceDescriptor ;
        rdfs:label "srl_shacl" ;
        rdfs:comment "SHACL shapes validating an srl: rule-set graph's own structural well-formedness." ;
        prof:hasArtifact starontology:srl_shapes.ttl ;
        prof:hasRole role:validation .

    _:N55d924414da94a0fab89c2d28a5028cc a prof:ResourceDescriptor ;
        rdfs:label "spexpr_owl" ;
        rdfs:comment "The SPARQL expression/variable/property-path vocabulary (spexpr:), carved out of salg: 2026-10-10 - the one slice salg:/sqe:/srl: all need identically (their own expression encoding, reused unchanged, not reimplemented per-vocabulary), originally minted under salg: only because salg: was built first, before sqe: existed to need sharing it." ;
        prof:hasArtifact starontology:spexpr-ontology.ttl ;
        prof:hasRole role:schema .

    _:N61db49617e1349c69ee7e9eaa20d6754 a prof:ResourceDescriptor ;
        rdfs:label "skos_owl" ;
        rdfs:comment "The W3C SKOS Reference's own formal axioms and numbered Documented Consistency and Integrity Conditions, over the real skos: namespace." ;
        prof:hasArtifact starontology:skos-ontology.ttl ;
        prof:hasRole role:schema .

    _:N712878b48b0e494ca035592ffe57dd1f a prof:ResourceDescriptor ;
        rdfs:label "manchester_shacl" ;
        rdfs:comment "SHACL shapes validating a manch: AST graph's own structural well-formedness." ;
        prof:hasArtifact starontology:manchester_shapes.ttl ;
        prof:hasRole role:validation .

    _:N803fbc5bac494bd6b092176f61bccd57 a prof:ResourceDescriptor ;
        rdfs:label "srl_owl" ;
        rdfs:comment "SRL/SPARQL-RL's own rule-set abstract syntax as RDF (srl:) - a Datalog-style rules language, general-purpose and SHACL-independent." ;
        prof:hasArtifact starontology:srl-ontology.ttl ;
        prof:hasRole role:schema .

    _:N8090f4d133174524b461dc90a8c51f88 a prof:ResourceDescriptor ;
        rdfs:label "spexpr_shacl" ;
        rdfs:comment "SHACL shapes validating an spexpr: expression/variable/path value's own well-formedness - imported by salg:/sqe:/srl: alike (each via owl:imports), not defined separately by any one of them." ;
        prof:hasArtifact starontology:spexpr_shapes.ttl ;
        prof:hasRole role:validation .

    _:Na3e56f041a5f42118d650c6104d4c3a0 a prof:ResourceDescriptor ;
        rdfs:label "sqe_shacl" ;
        rdfs:comment "SHACL shapes validating an sqe: query-edit graph's own structural well-formedness, designed for UI-editor field-level validation, not just decode-ability." ;
        prof:hasArtifact starontology:sqe_shapes.ttl ;
        prof:hasRole role:validation .

    _:Naa5808a490d6415eb09025db23a8860a a prof:ResourceDescriptor ;
        rdfs:label "sqe_owl" ;
        rdfs:comment "A SPARQL SELECT/ASK/CONSTRUCT query's own raw parse tree, pre-translateQuery, as a flat, human-readable RDF tree (sqe:) meant for hand/UI editing - deliberately not the resolved salg: algebra, which isn't readable or editable the same way. v1 scope reduction: no aggregates/subqueries/VALUES/Update yet (property paths ARE covered)." ;
        prof:hasArtifact starontology:sqe-ontology.ttl ;
        prof:hasRole role:schema .
}

starontology:srl-ontology.ttl {
    srl:AssignmentElement a rdfs:Class ;
        rdfs:comment "SET (?var := expr) - srl:var/srl:expr, §4.1. Never legal inside a negation element's own body." ;
        rdfs:subClassOf srl:BodyElement .

    srl:BodyElement a rdfs:Class ;
        rdfs:comment "The union of every rule-body element kind: TriplePattern, FilterElement, AssignmentElement, NegationElement." .

    srl:Data a rdfs:Class ;
        rdfs:comment "One top-level DATA {} block - srl:triples, ground only, §4.1." .

    srl:FilterElement a rdfs:Class ;
        rdfs:comment "FILTER Constraint - srl:expr, a real salg: expression tree, §4.1." ;
        rdfs:subClassOf srl:BodyElement,
            srl:NegationBodyElement .

    srl:NegationBodyElement a rdfs:Class ;
        rdfs:comment "The narrower union a negation element's own inner body is restricted to: TriplePattern or FilterElement only." .

    srl:NegationElement a rdfs:Class ;
        rdfs:comment "NOT DATA? {...} - srl:inner (a list of srl:NegationBodyElement), srl:negationData (bool), §4.1. Never legal inside another negation element's own body." ;
        rdfs:subClassOf srl:BodyElement .

    srl:Rule a rdfs:Class ;
        rdfs:comment "One RULE - srl:head/srl:body (lists), srl:ruleData (bool: match WHERE DATA), srl:id (optional IRI), §4.1." .

    srl:RuleSet a rdfs:Class ;
        rdfs:comment "A whole SRL rule set - srl:rules/srl:data/srl:imports, §4.1." .

    srl:TriplePattern a rdfs:Class ;
        rdfs:comment "A triple template (rule head) or triple pattern (rule body/DATA) - srl:subject/srl:predicate/srl:object, same shape either way per §4.1." ;
        rdfs:subClassOf srl:BodyElement,
            srl:NegationBodyElement .
}

