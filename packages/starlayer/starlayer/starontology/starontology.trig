    _:n0fc827eebb834aa59e55935693e77169b20 a sh:SPARQLConstraint ;
        sh:message "expected a well-formed rdf:List of sqe:TriplePattern/Optional/Union/Filter/Bind" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX sqe: <https://github.com/hidden-graph/starsparql/ns/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER ( $this != rdf:nil )
                    FILTER NOT EXISTS { $this rdf:first ?head }
                } UNION {
                    $this rdf:rest*/rdf:first ?item .
                    FILTER NOT EXISTS {
                        ?item a ?t .
                        FILTER ( ?t IN ( sqe:TriplePattern, sqe:Optional, sqe:Union, sqe:Filter, sqe:Bind ) )
                    }
                }
            }
        """ .

    _:n0fc827eebb834aa59e55935693e77169b21 sh:maxCount 1 ;
        sh:message "sqe:Optional must have exactly one sqe:where, a well-formed pattern list" ;
        sh:minCount 1 ;
        sh:node sqe:WhereListShape ;
        sh:path sqe:where .

    _:n0fc827eebb834aa59e55935693e77169b22 sh:maxCount 1 ;
        sh:message "sqe:Union must have exactly one sqe:alternatives, an rdf:List of pattern lists" ;
        sh:minCount 1 ;
        sh:path sqe:alternatives .

    _:n0fc827eebb834aa59e55935693e77169b23 sh:maxCount 1 ;
