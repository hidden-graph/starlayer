@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#> .
@prefix tree: <https://github.com/hidden-graph/starlayer/ns/tree#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


sqe:AskQueryShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|tree:value)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/sqe:expr ?exprRoot . }
                    UNION { $this (sqe:groupBy|sqe:having)/tree:value ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having) ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot a tree:Item }
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:args|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|tree:value)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|tree:value)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/tree:value ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/tree:value ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/tree:value?/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/tree:value ?var .
                    }
                }
            }
        """
    ] ;
    sh:targetClass sqe:AskQuery .

sqe:BindShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Bind must have exactly one sqe:expr, a well-formed expression" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path sqe:expr
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Bind must have exactly one sqe:var, a Variable" ;
        sh:minCount 1 ;
        sh:node spexpr:VariableShape ;
        sh:path sqe:var
    ] ;
    sh:targetClass sqe:Bind .

sqe:ConstructQueryShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ], [
        sh:message "sqe:template holds sqe:TriplePattern nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedTripleShape ;
        sh:path sqe:template
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Template variable {?var} is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                $this sqe:template/tree:value? ?tpl .
                ?tpl a sqe:TriplePattern ;
                    (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|tree:value)* ?node .
                    {
                        ?node a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node a sqe:Values ;
                            sqe:vars/tree:value ?var .
                    } UNION {
                        ?node a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/tree:value ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/tree:value?/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/tree:value ?var .
                    }
                }
            }
        """
    ], [
        a sh:SPARQLConstraint ;
        sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|tree:value)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/sqe:expr ?exprRoot . }
                    UNION { $this (sqe:groupBy|sqe:having)/tree:value ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having) ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot a tree:Item }
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:args|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|tree:value)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|tree:value)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/tree:value ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/tree:value ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/tree:value?/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/tree:value ?var .
                    }
                }
            }
        """
    ] ;
    sh:targetClass sqe:ConstructQuery .

sqe:FilterShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Filter must have exactly one sqe:expr, a well-formed expression" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path sqe:expr
    ] ;
    sh:targetClass sqe:Filter .

sqe:ObjectOrVariableShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] [
        sh:nodeKind sh:BlankNode
    ] [
        sh:nodeKind sh:Literal
    ] [
        sh:class sqe:TripleTerm
    ] spexpr:VariableShape ) .

sqe:OptionalShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ] ;
    sh:targetClass sqe:Optional .

sqe:PredicateOrVariableOrPathShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] spexpr:VariableShape spexpr:PathShape ) .

sqe:PrefixDeclShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:PrefixDecl must have exactly one sqe:namespace, an IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:namespace
    ], [
        sh:datatype spexpr:PlainString ;
        sh:maxCount 1 ;
        sh:message "sqe:PrefixDecl must have exactly one sqe:prefixLabel, a spexpr:PlainString-tagged string" ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:path sqe:prefixLabel
    ] ;
    sh:targetClass sqe:PrefixDecl .

sqe:SelectQueryShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:projection holds variables and sqe:Alias nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedProjectionShape ;
        sh:path sqe:projection
    ], [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Projected variable {?var} is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                $this sqe:projection/tree:value ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this sqe:groupBy/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|tree:value)* ?node .
                    {
                        ?node a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node a sqe:Values ;
                            sqe:vars/tree:value ?var .
                    } UNION {
                        ?node a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/tree:value ?var .
                    } UNION {
                        ?node a sqe:SubSelect ;
                            sqe:projection/tree:value?/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/tree:value ?var .
                    }
                }
            }
        """
    ], [
        a sh:SPARQLConstraint ;
        sh:message "Variable {?var} is used inside an expression but is never bound anywhere in this query's own sqe:where pattern." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?var
            WHERE {
                {
                    $this (sqe:where|sqe:alternatives|tree:value)* ?node .
                    {
                        ?node a sqe:Filter ; sqe:expr ?exprRoot .
                    } UNION {
                        ?node a sqe:Bind ; sqe:expr ?exprRoot .
                    }
                } UNION {
                    { $this (sqe:projection|sqe:orderBy)/sqe:expr ?exprRoot . }
                    UNION { $this (sqe:groupBy|sqe:having)/tree:value ?exprRoot . }
                    UNION {
                        $this (sqe:groupBy|sqe:having) ?exprRoot .
                        FILTER NOT EXISTS { ?exprRoot a tree:Item }
                        FILTER NOT EXISTS { ?exprRoot sqe:expr ?inner }
                    }
                    UNION { $this sqe:groupBy/sqe:expr ?exprRoot . }
                }
                ?exprRoot (spexpr:expr|spexpr:other|spexpr:arg|spexpr:arg1|spexpr:arg2|spexpr:arg3|spexpr:flags|spexpr:pattern|spexpr:text|spexpr:replacement|spexpr:start|spexpr:length|spexpr:args|spexpr:lex|spexpr:lang|spexpr:direction|sqe:subject|sqe:predicate|sqe:object|tree:value)* ?var .
                FILTER ( datatype(?var) = spexpr:Variable )
                FILTER NOT EXISTS { $this (sqe:projection|sqe:groupBy)/sqe:var ?var }
                FILTER NOT EXISTS {
                    $this (sqe:where|sqe:alternatives|tree:value)* ?node2 .
                    {
                        ?node2 a sqe:TriplePattern ;
                            (sqe:subject|sqe:predicate|sqe:object)+ ?var .
                    } UNION {
                        ?node2 a sqe:Bind ;
                            sqe:var ?var .
                    } UNION {
                        ?node2 a sqe:Values ;
                            sqe:vars/tree:value ?var .
                    } UNION {
                        ?node2 a sqe:Graph ;
                            sqe:graph ?var .
                    } UNION {
                        ?node2 a sqe:Service;
                            <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#service> ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/tree:value ?var .
                    } UNION {
                        ?node2 a sqe:SubSelect ;
                            sqe:projection/tree:value?/sqe:var ?var .
                    } UNION {
                        $this sqe:values/sqe:vars/tree:value ?var .
                    }
                }
            }
        """
    ] ;
    sh:targetClass sqe:SelectQuery .

sqe:SelectModifierShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:groupBy holds variables, expressions and sqe:Alias nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedGroupByShape ;
        sh:path sqe:groupBy
    ], [
        sh:message "sqe:having holds expressions, in order (tree:ord)" ;
        sh:node spexpr:OrderedExpressionShape ;
        sh:path sqe:having
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:selectAll must be a single xsd:boolean" ;
        sh:path sqe:selectAll
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:distinct must be a single xsd:boolean" ;
        sh:path sqe:distinct
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:reduced must be a single xsd:boolean" ;
        sh:path sqe:reduced
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A sqe:SelectQuery needs exactly one of sqe:projection (a variable list) or sqe:selectAll (SELECT *)." ;
        sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER NOT EXISTS { $this sqe:projection ?p }
                    FILTER NOT EXISTS { $this sqe:selectAll ?a }
                } UNION {
                    $this sqe:projection ?p ; sqe:selectAll ?a .
                }
            }
        """
    ], [
        a sh:SPARQLConstraint ;
        sh:message "A sqe:SelectQuery cannot be both sqe:distinct and sqe:reduced." ;
        sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE { $this sqe:distinct ?d ; sqe:reduced ?r . }
        """
    ] ;
    sh:targetClass sqe:SelectQuery .

sqe:SolutionModifierShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:orderBy holds sqe:OrderCondition nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedOrderConditionShape ;
        sh:path sqe:orderBy
    ], [
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:message "sqe:limit must be a single non-negative xsd:integer" ;
        sh:minInclusive 0 ;
        sh:path sqe:limit
    ], [
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:message "sqe:offset must be a single non-negative xsd:integer" ;
        sh:minInclusive 0 ;
        sh:path sqe:offset
    ] ;
    sh:targetClass sqe:AskQuery, sqe:ConstructQuery, sqe:DescribeQuery, sqe:SelectQuery .


sqe:OrderConditionShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:OrderCondition must have exactly one sqe:expr, a variable or well-formed expression" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path sqe:expr
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:descending must be a single xsd:boolean" ;
        sh:path sqe:descending
    ] ;
    sh:targetClass sqe:OrderCondition .

sqe:TripleTermShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:TripleTerm must have exactly one sqe:subject (an IRI, blank node, variable or triple term - never a literal)" ;
        sh:minCount 1 ;
        sh:node sqe:SubjectOrVariableShape ;
        sh:path sqe:subject
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:TripleTerm must have exactly one sqe:predicate (an IRI or variable)" ;
        sh:minCount 1 ;
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path sqe:predicate
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:TripleTerm must have exactly one sqe:object" ;
        sh:minCount 1 ;
        sh:node sqe:ObjectOrVariableShape ;
        sh:path sqe:object
    ] ;
    sh:targetClass sqe:TripleTerm .

sqe:ExistsShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ] ;
    sh:targetClass sqe:Exists, sqe:NotExists .

sqe:AliasShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Alias must have exactly one sqe:expr, an expression" ;
        sh:minCount 1 ;
        sh:node spexpr:ExpressionShape ;
        sh:path sqe:expr
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Alias must have exactly one sqe:var, the variable it binds" ;
        sh:minCount 1 ;
        sh:node spexpr:VariableShape ;
        sh:path sqe:var
    ] ;
    sh:targetClass sqe:Alias .

sqe:MinusShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ] ;
    sh:targetClass sqe:Minus .

sqe:GraphShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Graph must have exactly one sqe:graph, an IRI or variable" ;
        sh:minCount 1 ;
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path sqe:graph
    ] ;
    sh:targetClass sqe:Graph .

sqe:ValuesShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:vars holds variables, in order (tree:ord)" ;
        sh:node sqe:OrderedVariableShape ;
        sh:path sqe:vars
    ], [
        sh:message "sqe:rows holds sqe:Row nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedRowShape ;
        sh:path sqe:rows
    ] ;
    sh:targetClass sqe:Values .






sqe:QueryValuesShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:class sqe:Values ;
        sh:message "a query's trailing sqe:values must be a single sqe:Values block" ;
        sh:path sqe:values
    ] ;
    sh:targetClass sqe:Query, sqe:SubSelect .

sqe:PrologueShape a sh:NodeShape ;
    sh:property [
        sh:class sqe:PrefixDecl ;
        sh:message "sqe:prefixDecl must be a sqe:PrefixDecl node" ;
        sh:path sqe:prefixDecl
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:base must be a single IRI" ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:base
    ] ;
    sh:targetClass sqe:Query .

sqe:ShapesGraph a sh:ShapesGraph ;
    rdfs:member sqe:FilterShape, sqe:AskQueryShape, sqe:BindShape, sqe:ObjectOrVariableShape, sqe:ConstructQueryShape, sqe:OptionalShape, sqe:SubjectOrVariableShape, sqe:UnionShape, sqe:SelectQueryShape, sqe:PrefixDeclShape, sqe:TriplePatternShape, sqe:PredicateOrVariableOrPathShape, sqe:SelectModifierShape, sqe:SolutionModifierShape, sqe:OrderConditionShape, sqe:TripleTermShape, sqe:ExistsShape, sqe:AliasShape, sqe:MinusShape, sqe:GraphShape, sqe:ValuesShape, sqe:QueryValuesShape, sqe:PrologueShape, sqe:ServiceShape, sqe:DescribeQueryShape, sqe:DatasetClauseShape, sqe:GroupingModifierShape, sqe:DatasetShape, sqe:UpdateRequestShape, sqe:UpdateOperationShape, sqe:QuadGraphShape, sqe:InsertDataShape, sqe:DeleteDataShape, sqe:DeleteWhereShape, sqe:ModifyShape, sqe:LoadShape, sqe:ClearShape, sqe:DropShape, sqe:CreateShape, sqe:AddShape, sqe:MoveShape, sqe:CopyShape, sqe:GraphRefShape, sqe:AnyGraphRefShape, sqe:GraphOrDefaultShape, sqe:OrderedPatternShape, sqe:PatternElementShape, sqe:OrderedAlternativeShape, sqe:OrderedTripleShape, sqe:OrderedQuadShape, sqe:OrderedOperationShape, sqe:OrderedDatasetClauseShape, sqe:OrderedOrderConditionShape, sqe:OrderedProjectionShape, sqe:OrderedGroupByShape, sqe:OrderedVariableShape, sqe:OrderedTargetShape, sqe:OrderedRowShape, sqe:OrderedCellShape, sqe:GroupGraphPatternShape, sqe:RowShape ;
    owl:imports spexpr:ShapesGraph .

sqe:SubjectOrVariableShape a sh:NodeShape ;
    sh:or ( [
        sh:nodeKind sh:IRI
    ] [
        sh:nodeKind sh:BlankNode
    ] spexpr:VariableShape [
        sh:class sqe:TripleTerm
    ] ) .


sqe:TriplePatternShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:TriplePattern must have exactly one sqe:subject, an IRI/blank node/Variable" ;
        sh:minCount 1 ;
        sh:node sqe:SubjectOrVariableShape ;
        sh:path sqe:subject
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:TriplePattern must have exactly one sqe:predicate, an IRI/Variable/property path" ;
        sh:minCount 1 ;
        sh:node sqe:PredicateOrVariableOrPathShape ;
        sh:path sqe:predicate
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:TriplePattern must have exactly one sqe:object" ;
        sh:minCount 1 ;
        sh:node sqe:ObjectOrVariableShape ;
        sh:path sqe:object
    ] ;
    sh:targetClass sqe:TriplePattern .

sqe:UnionShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:alternatives holds sqe:GroupGraphPattern nodes, one per alternative, in order (tree:ord)" ;
        sh:minCount 1 ;
        sh:node sqe:OrderedAlternativeShape ;
        sh:path sqe:alternatives
    ] ;
    sh:targetClass sqe:Union .


sqe:ServiceShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Service must have exactly one sqe:service, an IRI or variable" ;
        sh:minCount 1 ;
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path sqe:service
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:silent must be a single xsd:boolean" ;
        sh:path sqe:silent
    ] ;
    sh:targetClass sqe:Service .

sqe:DescribeQueryShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ], [
        sh:message "sqe:describe holds IRIs and variables, in order (tree:ord)" ;
        sh:node sqe:OrderedTargetShape ;
        sh:path sqe:describe
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:describeAll must be a single xsd:boolean" ;
        sh:path sqe:describeAll
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A sqe:DescribeQuery needs exactly one of sqe:describe (a list of targets) or sqe:describeAll (DESCRIBE *)." ;
        sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                {
                    FILTER NOT EXISTS { $this sqe:describe ?p }
                    FILTER NOT EXISTS { $this sqe:describeAll ?a }
                } UNION {
                    $this sqe:describe ?p ; sqe:describeAll ?a .
                }
            }
        """
    ], [
        a sh:SPARQLConstraint ;
        sh:message "DESCRIBE * needs a sqe:where pattern (it describes the variables of the pattern)." ;
        sh:select """
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            SELECT $this
            WHERE {
                $this sqe:describeAll ?a .
                FILTER NOT EXISTS { $this sqe:where ?w }
            }
        """
    ] ;
    sh:targetClass sqe:DescribeQuery .


sqe:DatasetClauseShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:DatasetClause must have exactly one sqe:source, a graph IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:source
    ], [
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:message "sqe:named must be a single xsd:boolean" ;
        sh:path sqe:named
    ] ;
    sh:targetClass sqe:DatasetClause .


sqe:GroupingModifierShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:groupBy holds variables, expressions and sqe:Alias nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedGroupByShape ;
        sh:path sqe:groupBy
    ], [
        sh:message "sqe:having holds expressions, in order (tree:ord)" ;
        sh:node spexpr:OrderedExpressionShape ;
        sh:path sqe:having
    ] ;
    sh:targetClass sqe:AskQuery, sqe:ConstructQuery, sqe:DescribeQuery .

sqe:DatasetShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:dataset holds sqe:DatasetClause nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedDatasetClauseShape ;
        sh:path sqe:dataset
    ] ;
    sh:targetClass sqe:AskQuery, sqe:ConstructQuery, sqe:DescribeQuery, sqe:SelectQuery .

sqe:UpdateRequestShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:operations holds update operations, in order (tree:ord)" ;
        sh:node sqe:OrderedOperationShape ;
        sh:path sqe:operations
    ], [
        sh:class sqe:PrefixDecl ;
        sh:message "sqe:prefixDecl must be a sqe:PrefixDecl node" ;
        sh:path sqe:prefixDecl
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:base must be a single IRI" ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:base
    ] ;
    sh:targetClass sqe:UpdateRequest .

sqe:UpdateOperationShape a sh:NodeShape ;
    sh:property [
        sh:class sqe:PrefixDecl ;
        sh:message "sqe:prefixDecl must be a sqe:PrefixDecl node" ;
        sh:path sqe:prefixDecl
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:base must be a single IRI" ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:base
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:silent must be a single xsd:boolean" ;
        sh:datatype xsd:boolean ;
        sh:path sqe:silent
    ] ;
    sh:targetClass sqe:UpdateOperation .




sqe:QuadGraphShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:QuadGraph must have exactly one sqe:graphName, an IRI or variable" ;
        sh:minCount 1 ;
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path sqe:graphName
    ], [
        sh:message "sqe:triples holds sqe:TriplePattern nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedTripleShape ;
        sh:path sqe:triples
    ] ;
    sh:targetClass sqe:QuadGraph .

sqe:InsertDataShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:quads holds sqe:TriplePattern and sqe:QuadGraph nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedQuadShape ;
        sh:path sqe:quads
    ] ;
    sh:sparql     [
        a sh:SPARQLConstraint ;
        sh:message "Variables are not allowed in INSERT DATA." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:quads/(tree:value|sqe:triples|sqe:subject|sqe:predicate|sqe:object|sqe:graphName)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object|sqe:graphName) ?v .
                FILTER ( isLiteral(?v) && datatype(?v) = spexpr:Variable )
            }
        """
    ] ;
    sh:targetClass sqe:InsertData .

sqe:DeleteDataShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:quads holds sqe:TriplePattern and sqe:QuadGraph nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedQuadShape ;
        sh:path sqe:quads
    ] ;
    sh:sparql     [
        a sh:SPARQLConstraint ;
        sh:message "Variables are not allowed in DELETE DATA." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:quads/(tree:value|sqe:triples|sqe:subject|sqe:predicate|sqe:object|sqe:graphName)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object|sqe:graphName) ?v .
                FILTER ( isLiteral(?v) && datatype(?v) = spexpr:Variable )
            }
        """
    ],
    [
        a sh:SPARQLConstraint ;
        sh:message "Blank nodes are not allowed in DELETE DATA." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:quads/(tree:value|sqe:triples|sqe:subject|sqe:predicate|sqe:object)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object) ?v .
                FILTER ( isBlank(?v) )
                FILTER NOT EXISTS { ?v a sqe:TripleTerm }
            }
        """
    ] ;
    sh:targetClass sqe:DeleteData .

sqe:DeleteWhereShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:quads holds sqe:TriplePattern and sqe:QuadGraph nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedQuadShape ;
        sh:path sqe:quads
    ] ;
    sh:sparql     [
        a sh:SPARQLConstraint ;
        sh:message "Blank nodes are not allowed in DELETE WHERE." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:quads/(tree:value|sqe:triples|sqe:subject|sqe:predicate|sqe:object)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object) ?v .
                FILTER ( isBlank(?v) )
                FILTER NOT EXISTS { ?v a sqe:TripleTerm }
            }
        """
    ] ;
    sh:targetClass sqe:DeleteWhere .

sqe:ModifyShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:with must be a single IRI" ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:with
    ], [
        sh:message "sqe:delete holds sqe:TriplePattern and sqe:QuadGraph nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedQuadShape ;
        sh:path sqe:delete
    ], [
        sh:message "sqe:insert holds sqe:TriplePattern and sqe:QuadGraph nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedQuadShape ;
        sh:path sqe:insert
    ], [
        sh:message "sqe:using holds sqe:DatasetClause nodes, in order (tree:ord)" ;
        sh:node sqe:OrderedDatasetClauseShape ;
        sh:path sqe:using
    ], [
        sh:message "sqe:where holds the pattern elements of the group, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ] ;
    sh:sparql     [
        a sh:SPARQLConstraint ;
        sh:message "Blank nodes are not allowed in a DELETE template." ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX tree: <https://github.com/hidden-graph/starlayer/ns/tree#>
            PREFIX sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#>
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this
            WHERE {
                $this sqe:delete/(tree:value|sqe:triples|sqe:subject|sqe:predicate|sqe:object)* ?x .
                ?x (sqe:subject|sqe:predicate|sqe:object) ?v .
                FILTER ( isBlank(?v) )
                FILTER NOT EXISTS { ?v a sqe:TripleTerm }
            }
        """
    ] ;
    sh:targetClass sqe:Modify .

sqe:LoadShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Load must have exactly one sqe:loadFrom, an IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:loadFrom
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:into must be a single sqe:GraphRef" ;
        sh:class sqe:GraphRef ;
        sh:path sqe:into
    ] ;
    sh:targetClass sqe:Load .

sqe:ClearShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Clear must have exactly one sqe:target, a graph reference" ;
        sh:minCount 1 ;
        sh:node sqe:AnyGraphRefShape ;
        sh:path sqe:target
    ] ;
    sh:targetClass sqe:Clear .

sqe:DropShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Drop must have exactly one sqe:target, a graph reference" ;
        sh:minCount 1 ;
        sh:node sqe:AnyGraphRefShape ;
        sh:path sqe:target
    ] ;
    sh:targetClass sqe:Drop .

sqe:CreateShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Create must have exactly one sqe:target, a sqe:GraphRef" ;
        sh:minCount 1 ;
        sh:class sqe:GraphRef ;
        sh:path sqe:target
    ] ;
    sh:targetClass sqe:Create .

sqe:AddShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Add must have exactly one sqe:from, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:from
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Add must have exactly one sqe:to, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:to
    ] ;
    sh:targetClass sqe:Add .

sqe:MoveShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Move must have exactly one sqe:from, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:from
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Move must have exactly one sqe:to, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:to
    ] ;
    sh:targetClass sqe:Move .

sqe:CopyShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:Copy must have exactly one sqe:from, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:from
    ], [
        sh:maxCount 1 ;
        sh:message "sqe:Copy must have exactly one sqe:to, a sqe:GraphRef or sqe:DefaultGraph" ;
        sh:minCount 1 ;
        sh:node sqe:GraphOrDefaultShape ;
        sh:path sqe:to
    ] ;
    sh:targetClass sqe:Copy .

sqe:GraphRefShape a sh:NodeShape ;
    sh:property [
        sh:maxCount 1 ;
        sh:message "sqe:GraphRef must have exactly one sqe:graphIri, an IRI" ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:path sqe:graphIri
    ] ;
    sh:targetClass sqe:GraphRef .

sqe:AnyGraphRefShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:GraphRef
    ] [
        sh:class sqe:DefaultGraph
    ] [
        sh:class sqe:NamedGraphs
    ] [
        sh:class sqe:AllGraphs
    ] ) .

sqe:GraphOrDefaultShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:GraphRef
    ] [
        sh:class sqe:DefaultGraph
    ] ) .

# A warning, not a violation: the text is valid SPARQL 1.2 (ArgList ::= NIL | '(' 'DISTINCT'? Expression ... ')'), but Oxigraph does
# not parse DISTINCT in a call to an extension function. Delete this shape when a release does (starlayer #206).
sqe:FunctionDistinctShape a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "DISTINCT in a call to {?iri}: the SPARQL 1.2 grammar allows it, but Oxigraph does not parse it (starlayer #206)." ;
        sh:select """
            PREFIX spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#>
            SELECT $this ?iri
            WHERE {
                $this spexpr:distinct ?marker ;
                    spexpr:iri ?iri .
                FILTER ( isLiteral(?marker) )
            }
        """
    ] ;
    sh:targetClass spexpr:FunctionCall .

# ---- The ordered children (tree:ord): one shape per kind of sequence, used by the property shapes above -------------------------
# A child that is a blank node carries its own tree:ord and is the member itself; an IRI, a literal or a variable is the tree:value of a
# tree:Item that carries the ordinal (starontology/tree/tree_shapes.ttl). A named node directly under the property is not accepted.

sqe:PatternElementShape a sh:NodeShape ;
    sh:message "expected a pattern element: sqe:TriplePattern, Optional, Union, Filter, Bind, Minus, Graph, Service, Values or SubSelect" ;
    sh:or ( [
        sh:class sqe:TriplePattern
    ] [
        sh:class sqe:Optional
    ] [
        sh:class sqe:Union
    ] [
        sh:class sqe:Filter
    ] [
        sh:class sqe:Bind
    ] [
        sh:class sqe:Minus
    ] [
        sh:class sqe:Graph
    ] [
        sh:class sqe:Service
    ] [
        sh:class sqe:Values
    ] [
        sh:class sqe:SubSelect
    ] ) .

sqe:OrderedPatternShape a sh:NodeShape ;
    sh:or ( [
        sh:node sqe:PatternElementShape, tree:OrdShape ;
        sh:nodeKind sh:BlankNode
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:node sqe:PatternElementShape ;
            sh:path tree:value
        ]
    ] ) .

sqe:OrderedAlternativeShape a sh:NodeShape ;
    sh:node tree:OrdShape ;
    sh:class sqe:GroupGraphPattern ;
    sh:nodeKind sh:BlankNode .

sqe:OrderedTripleShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:TriplePattern ;
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:class sqe:TriplePattern ;
            sh:path tree:value
        ]
    ] ) .

sqe:OrderedQuadShape a sh:NodeShape ;
    sh:or ( [
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode ;
        sh:or ( [
            sh:class sqe:TriplePattern
        ] [
            sh:class sqe:QuadGraph
        ] )
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:or ( [
                sh:class sqe:TriplePattern
            ] [
                sh:class sqe:QuadGraph
            ] ) ;
            sh:path tree:value
        ]
    ] ) .

sqe:OrderedOperationShape a sh:NodeShape ;
    sh:or ( [
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode ;
        sh:class sqe:UpdateOperation
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:class sqe:UpdateOperation ;
            sh:path tree:value
        ]
    ] ) .

sqe:OrderedDatasetClauseShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:DatasetClause ;
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:class sqe:DatasetClause ;
            sh:path tree:value
        ]
    ] ) .

sqe:OrderedOrderConditionShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:OrderCondition ;
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:class sqe:OrderCondition ;
            sh:path tree:value
        ]
    ] ) .

sqe:OrderedProjectionShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:Alias ;
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:node spexpr:VariableShape ;
            sh:path tree:value
        ]
    ] ) .

sqe:OrderedGroupByShape a sh:NodeShape ;
    sh:or ( [
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode ;
        sh:or ( [
            sh:class sqe:Alias
        ] [
            sh:class spexpr:Expression
        ] )
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:node spexpr:VariableShape ;
            sh:path tree:value
        ]
    ] ) .

sqe:OrderedVariableShape a sh:NodeShape ;
    sh:node tree:ItemShape ;
    sh:property [
        sh:node spexpr:VariableShape ;
        sh:path tree:value
    ] .

sqe:OrderedTargetShape a sh:NodeShape ;
    sh:node tree:ItemShape ;
    sh:property [
        sh:or ( [
            sh:nodeKind sh:IRI
        ] spexpr:VariableShape ) ;
        sh:path tree:value
    ] .

sqe:OrderedRowShape a sh:NodeShape ;
    sh:class sqe:Row ;
    sh:node tree:OrdShape ;
    sh:nodeKind sh:BlankNode .

sqe:OrderedCellShape a sh:NodeShape ;
    sh:or ( [
        sh:class sqe:TripleTerm ;
        sh:node tree:OrdShape ;
        sh:nodeKind sh:BlankNode
    ] [
        sh:node tree:ItemShape ;
        sh:property [
            sh:or ( [
                sh:nodeKind sh:IRI
            ] [
                sh:nodeKind sh:Literal
            ] ) ;
            sh:path tree:value
        ]
    ] ) .

sqe:GroupGraphPatternShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:where holds the pattern elements of the alternative, in order (tree:ord)" ;
        sh:node sqe:OrderedPatternShape ;
        sh:path sqe:where
    ] ;
    sh:targetClass sqe:GroupGraphPattern .

sqe:RowShape a sh:NodeShape ;
    sh:property [
        sh:message "sqe:cells holds the terms of the row, in order (tree:ord); UNDEF is the IRI sqe:undef" ;
        sh:node sqe:OrderedCellShape ;
        sh:path sqe:cells
    ] ;
    sh:targetClass sqe:Row .
