GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_manchester_ast.py> {
    ns111:test_manchester_ast.py dcterms:identifier "tests.graph.unit.test_manchester_ast" ;
        a slkg:Module ;
        rdfs:comment """Round-trip tests for starontology.manchester (Manchester Syntax as a
syntax tree in RDF, mirroring the sibling starlayer.sparql package's
test_ast_ontology.py).

Verifies text -> manchester_parse_to_tree -> manchester_tree_to_text -> re-parse, by
compiling *both* the original text and the re-serialized text through the
real, unmodified manchester_parser.parse_manchester() and comparing the
resulting OWL-semantic triple sets via starlayer.graph.compare.isomorphic()
- proves structural faithfulness without requiring byte-identical text
(same idiom this project already uses for its own round-trip proofs
elsewhere).

The decode-only half of the pipeline (``_tree_to_document``) is private -
editing is meant to happen on the tree-RDF itself, not on a Python object
in between (see the module's own docstring) - so this file only reaches
for it directly in the one test that specifically verifies that internal
shape (``test_decoded_document_is_a_plain_namedtuple_tree``).""" ;
        rdfs:label "test_manchester_ast" ;
        slkg:declares ns232:test_decoded_document_is_a_plain_namedtuple_tree, ns232:test_ast_roundtrip_preserves_owl_semantics, ns232:test_tree_to_owl_matches_compiling_the_text_directly, ns232:test_ast_roundtrip_is_stable_under_a_second_pass ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast.py" ;
        slkg:importsModule ns4:pytest .

    ns232:test_ast_roundtrip_is_stable_under_a_second_pass dcterms:identifier "tests.graph.unit.test_manchester_ast.test_ast_roundtrip_is_stable_under_a_second_pass" ;
        a slkg:Function ;
        rdfs:comment """Encoding the re-rendered text again should reach a semantic fixed
point (no further drift on a second decode/re-render cycle).""" ;
        rdfs:label "test_ast_roundtrip_is_stable_under_a_second_pass" ;
        slkg:calls ns92:manchester_parse_to_tree, ns92:manchester_tree_to_text, ns278:isomorphic, ns12:parse_manchester ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast.py" ;
        slkg:lineEnd 152 ;
        slkg:lineStart 142 ;
        slkg:signature "def test_ast_roundtrip_is_stable_under_a_second_pass()" .

    ns232:test_ast_roundtrip_preserves_owl_semantics dcterms:identifier "tests.graph.unit.test_manchester_ast.test_ast_roundtrip_preserves_owl_semantics" ;
        a slkg:Function ;
        rdfs:label "test_ast_roundtrip_preserves_owl_semantics" ;
        slkg:calls ns12:parse_manchester, ns92:manchester_parse_to_tree, ns92:manchester_tree_to_text, ns278:isomorphic ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast.py" ;
        slkg:hasDecorator ns232:test_ast_roundtrip_preserves_owl_semantics.decorator.0 ;
        slkg:hasParameter ns232:test_ast_roundtrip_preserves_owl_semantics.param.text ;
        slkg:lineEnd 139 ;
        slkg:lineStart 129 ;
        slkg:signature "def test_ast_roundtrip_preserves_owl_semantics(text)" .

    ns232:test_ast_roundtrip_preserves_owl_semantics.decorator.0 a slkg:Decorator ;
        slkg:decoratorText "pytest.mark.parametrize('text', DOCUMENTS)" ;
        slkg:position 0 .

    ns232:test_ast_roundtrip_preserves_owl_semantics.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns232:test_decoded_document_is_a_plain_namedtuple_tree dcterms:identifier "tests.graph.unit.test_manchester_ast.test_decoded_document_is_a_plain_namedtuple_tree" ;
        a slkg:Function ;
        rdfs:comment """White-box: _tree_to_document is private (editing happens on the
tree-RDF, not this intermediate object - see the module's own
docstring), but this still verifies its internal shape directly.""" ;
        rdfs:label "test_decoded_document_is_a_plain_namedtuple_tree" ;
        slkg:calls ns92:_find_root, ns92:manchester_parse_to_tree, ns92:_tree_to_document ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast.py" ;
        slkg:lineEnd 164 ;
        slkg:lineStart 155 ;
        slkg:signature "def test_decoded_document_is_a_plain_namedtuple_tree()" .

    ns232:test_tree_to_owl_matches_compiling_the_text_directly dcterms:identifier "tests.graph.unit.test_manchester_ast.test_tree_to_owl_matches_compiling_the_text_directly" ;
        a slkg:Function ;
        rdfs:label "test_tree_to_owl_matches_compiling_the_text_directly" ;
        slkg:calls ns92:manchester_tree_to_owl, ns278:isomorphic, ns12:parse_manchester, ns92:manchester_parse_to_tree ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast.py" ;
        slkg:hasDecorator ns232:test_tree_to_owl_matches_compiling_the_text_directly.decorator.0 ;
        slkg:hasParameter ns232:test_tree_to_owl_matches_compiling_the_text_directly.param.text ;
        slkg:lineEnd 170 ;
