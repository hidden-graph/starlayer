        slkg:calls ns72:prepare_query_12, ns70:_translate_algebra_12 ;
        slkg:filePath "packages/starlayer/tests/sparql/w3c_sparql12/test_w3c_sparql12_oxigraph_roundtrip.py" ;
        slkg:hasParameter ns148:_regenerate.param.query_text ;
