    ns217:TestCustomNamedParameterFunctionNonKeyParameter dcterms:identifier "tests.shacl.integration.test_custom_node_expression_functions.TestCustomNamedParameterFunctionNonKeyParameter" ;
        a slkg:Class ;
        rdfs:comment """A named parameter function can declare more than one sh:parameter,
with only *some* of them marked sh:keyParameter true - the spec's own
syntax rule says "At least one of the parameters has sh:keyParameter
true", not "all of them". The non-key parameter(s) still need their
values read from the call site.

Found missing entirely (2026-09-11), prompted by a direct user question
asking for a two-parameter example with one non-key parameter: the
spec's own "EVALUATION OF CUSTOM NAMED PARAMETER EXPRESSIONS" algorithm
is explicit - "argScope is a map of (parameter) nodes as keys and
(argument) nodes as values, so that each parameter of f has the value
of the parameter's sh:path from expr" - not "each key parameter". A live
check confirmed the previous implementation only ever read the key
parameter(s) (since only key parameters are registered by
_custom_function_registry for call-site dispatch), so a call site
supplying a value for a declared-but-non-key parameter silently lost it
- the whole expression evaluated to an empty result instead of using it.""" ;
        rdfs:label "TestCustomNamedParameterFunctionNonKeyParameter" ;
        slkg:declares ns217:TestCustomNamedParameterFunctionNonKeyParameter.test_non_key_parameter_value_is_read_from_the_call_site, ns217:TestCustomNamedParameterFunctionNonKeyParameter.test_omitting_the_non_key_parameter_produces_an_empty_result_not_a_crash ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_custom_node_expression_functions.py" ;
        slkg:lineEnd 290 ;
        slkg:lineStart 221 .

    ns217:TestCustomNamedParameterFunctionNonKeyParameter.test_non_key_parameter_value_is_read_from_the_call_site dcterms:identifier "tests.shacl.integration.test_custom_node_expression_functions.TestCustomNamedParameterFunctionNonKeyParameter.test_non_key_parameter_value_is_read_from_the_call_site" ;
        a slkg:Method ;
        rdfs:label "test_non_key_parameter_value_is_read_from_the_call_site" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_custom_node_expression_functions.py" ;
        slkg:hasReturnValue ns217:TestCustomNamedParameterFunctionNonKeyParameter.test_non_key_parameter_value_is_read_from_the_call_site.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 266 ;
        slkg:lineStart 249 ;
        slkg:signature "def test_non_key_parameter_value_is_read_from_the_call_site(self) -> None" .

    ns217:TestCustomNamedParameterFunctionNonKeyParameter.test_non_key_parameter_value_is_read_from_the_call_site.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

