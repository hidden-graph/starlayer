    ns43:row_passes_filters dcterms:identifier "starlayer.graph.query.remote_decompose.row_passes_filters" ;
        a slkg:Function ;
        rdfs:comment """Re-check each stripped filter expression (see `decompose_for_remote`)
against `bindings` (the row *after* `evaluate_recipes_locally` has
merged in every recipe's computed value, so a filter depending on one
of those - not just on an ordinary matched variable - sees it too),
mirroring SPARQL FILTER's own semantics: the row is excluded if any
expression is false or raises, not just if it's literally ``False``
(a filter's own "effective boolean value" coercion - `EBV` - already
handles truthy non-boolean results the same way a real FILTER would).""" ;
        rdfs:label "row_passes_filters" ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        slkg:hasParameter ns43:row_passes_filters.param.filters, ns43:row_passes_filters.param.graph, ns43:row_passes_filters.param.bindings ;
        slkg:hasReturnValue ns43:row_passes_filters.returns ;
        slkg:lineEnd 322 ;
        slkg:lineStart 287 ;
        slkg:signature "def row_passes_filters(filters: list[Any], bindings: dict, graph: Any) -> bool" .

    ns43:row_passes_filters.param.bindings a slkg:Parameter ;
        rdfs:comment "The row's bindings after `evaluate_recipes_locally` has merged in every recipe's computed value." ;
        rdfs:label "bindings" ;
        slkg:annotationText "dict" ;
        slkg:hasType ns4:builtins.dict ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns43:row_passes_filters.param.filters a slkg:Parameter ;
        rdfs:comment "The boolean filter expressions from `decompose_for_remote`." ;
        rdfs:label "filters" ;
        slkg:annotationText "list[Any]" ;
        slkg:hasType ns4:typing.Any, ns4:builtins.list ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns43:row_passes_filters.param.graph a slkg:Parameter ;
        rdfs:comment "The graph to evaluate expressions against." ;
        rdfs:label "graph" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "positional" ;
        slkg:position 2 .

    ns43:row_passes_filters.returns a slkg:ReturnValue ;
        rdfs:comment "False if any filter expression is false or raises for `bindings`; True otherwise (including when `filters` is empty)." ;
        slkg:annotationText "bool" ;
        slkg:hasType ns4:builtins.bool .

    ns4:__future__ a slkg:ExternalModule .

