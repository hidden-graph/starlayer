    ns76:_build_unique_lang_component.UniqueLangConstraintComponent dcterms:identifier "starlayer.shacl.native_components._build_unique_lang_component.UniqueLangConstraintComponent" ;
        a slkg:Class ;
        rdfs:comment """Fully replaces pySHACL's own ``UniqueLangConstraintComponent``:
the SHACL 1.2 Core spec extends the uniqueness condition to include
base direction for ``rdf:dirLangString`` values (``"1"@ar--rtl`` and
``"1"@ar--ltr`` are different, as is the pair ``"1"@ar--rtl`` and
``"1"@ar``) - pySHACL has no notion of this, and since an encoded
``DirLangString`` value never has ``Literal.language`` set, pySHACL
doesn't even group it with same-language values at all, silently
missing genuine duplicates. One violation per over-used (language,
direction) pair, no ``sh:value`` - matching pySHACL's own
(already-correct) behavior for the plain-langString case.""" ;
        rdfs:label "UniqueLangConstraintComponent" ;
        rdfs:subClassOf ns4:pyshacl.constraints.constraint_component.ConstraintComponent ;
        slkg:declares ns76:_build_unique_lang_component.UniqueLangConstraintComponent.evaluate, ns76:_build_unique_lang_component.UniqueLangConstraintComponent.constraint_name, ns76:_build_unique_lang_component.UniqueLangConstraintComponent.__init__, ns76:_build_unique_lang_component.UniqueLangConstraintComponent.constraint_parameters ;
        slkg:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        slkg:lineEnd 2144 ;
        slkg:lineStart 2057 .

