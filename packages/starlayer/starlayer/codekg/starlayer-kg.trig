GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/ast_vocab.py> {
    ns48:ast_vocab.py dcterms:identifier "starlayer.sparql.ast_vocab" ;
        a slkg:Module ;
        rdfs:comment """The RDF vocabulary for the *parse-tree* (syntax tree) level SPARQL
representation — a prototype, sibling to ``vocab.py``'s ``salg:`` (algebra)
vocabulary, one level lower: it mirrors ``rdflib.plugins.sparql.parser.
parseQuery``'s raw output (before ``translateQuery`` runs) instead of the
compiled algebra. Abbreviated ``AST`` (Abstract Syntax Tree) below, same
sense that term has everywhere else in this codebase.

Same generic-mirror design as ``salg:`` (``node.name`` -> ``rdf:type``,
``key: value`` -> predicate, recursively), pointed at a different tree.
The raw parse tree is *already* almost entirely ``CompValue``-shaped, using
real SPARQL grammar production names (``OptionalGraphPattern``, ``Filter``,
``TriplesBlock``, ``ConditionalOrExpression``, ``PathAlternative``, ...) —
closer to spec terminology than ``salg:``'s compiled algebra names (see
``to_ast_rdf.py``'s own module docstring for the full account). This is
why this file exists as a *separate* namespace rather than trying to unify
with ``salg:``: some names collide (``Filter`` exists at both layers, with a
genuinely different shape — the algebra's ``Filter`` nests the pattern it
filters as ``salg:p``; the parse tree's ``Filter`` doesn't, the pattern is a
sibling in the enclosing group instead), so merging namespaces would be
actively ambiguous, not just redundant.

``PyStr``/``Variable`` are the one deliberate exception to "kept fully
self-contained" below: reused directly from ``vocab.py`` (``spexpr:
PlainString``/``spexpr:Variable`` - both ``spexpr:``-housed, not
``salg:``-housed; ``PY_STR_DATATYPE`` moved from ``salg:PyStr`` to
``spexpr:PlainString`` 2026-10-15, the same ``spexpr:``-not-``salg:``
reasoning already applied to ``Variable``), not re-minted here. These two
are pure encoding-
primitive tags — they mark "this Python value needs to survive RDF
round-tripping faithfully," not an AST or algebra *concept* whose meaning
differs by layer, unlike every other name in this file. Minting a separate
``sast:Variable`` was tried first and found to have a real cost, not just
redundancy: it made the *same* SPARQL variable decode to two unequal RDF
terms depending on which layer's encoder wrote it (``Literal`` equality
includes datatype), which breaks the one thing a shared variable identity
is for — matching "the same variable" across a layer boundary via ordinary
term equality, e.g. tracing which ``WHERE``-clause variable a ``salg:``-
encoded expression subtree references. Everything else here (grammar
production names, ``sast:Query``/``sast:prologue``) stays genuinely
separate from ``salg:``, since those *do* differ in meaning by layer — see
the rest of this docstring.""" ;
        rdfs:label "ast_vocab" ;
        slkg:filePath "packages/starlayer/starlayer/sparql/ast_vocab.py" ;
        slkg:importsModule ns4:__future__, ns4:rdflib .

    ns4:__future__ a slkg:ExternalModule .

    ns4:rdflib a slkg:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/serializers/trig12.py> {
    ns8:trig12.py dcterms:identifier "starlayer.graph.serializers.trig12" ;
        a slkg:Module ;
        rdfs:comment """starlayer.graph.serializers.trig12

Serialize a StarLayerGraph to TriG 1.2 text.

If the graph has a named identifier (URIRef) the triples are wrapped in a
``GRAPH <name> { ... }`` block.  If the identifier is a BNode (the rdflib
default) the content is emitted as plain Turtle 1.2 (the default-graph
convention in TriG).

Entry point:  serialize_trig12(g) -> str""" ;
        rdfs:label "trig12" ;
        slkg:declares ns10:_split_prefix_and_body_lines, ns10:serialize_trig12 ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/trig12.py" ;
        slkg:importsModule ns4:rdflib, ns4:__future__ .

    ns10:_split_prefix_and_body_lines dcterms:identifier "starlayer.graph.serializers.trig12._split_prefix_and_body_lines" ;
        a slkg:Function ;
        rdfs:comment """Split turtle_text's physical lines into (prefix_lines, body_lines) -
prefix_lines being every line that's a genuine top-level '@prefix'
directive, body_lines everything else.

Uses iter_lines_outside_strings() to tell a real directive line from
one that merely *starts with* the text '@prefix' while still inside an
open string literal (see that function's docstring for the full
rationale and the real bug this guards against - confirmed live via
this project's own code-KG extractor feeding this project's own
trig12.py, whose module docstring does exactly this, back through
itself).""" ;
        rdfs:label "_split_prefix_and_body_lines" ;
        slkg:calls ns24:iter_lines_outside_strings ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/trig12.py" ;
        slkg:hasParameter ns10:_split_prefix_and_body_lines.param.turtle_text ;
        slkg:hasReturnValue ns10:_split_prefix_and_body_lines.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 44 ;
        slkg:lineStart 24 ;
        slkg:signature "def _split_prefix_and_body_lines(turtle_text: str) -> tuple[list[str], list[str]]" .

    ns10:_split_prefix_and_body_lines.param.turtle_text a slkg:Parameter ;
        rdfs:label "turtle_text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns10:_split_prefix_and_body_lines.returns a slkg:ReturnValue ;
        slkg:annotationText "tuple[list[str], list[str]]" ;
        slkg:hasType ns4:builtins.list, ns4:builtins.str, ns4:builtins.tuple .

    ns10:serialize_trig12 dcterms:identifier "starlayer.graph.serializers.trig12.serialize_trig12" ;
        a slkg:Function ;
        rdfs:comment """Serialize *g* to TriG 1.2 text.

Named graph identifier → ``GRAPH <uri> { ... }``
BNode identifier        → plain Turtle 1.2 (default graph in TriG)""" ;
        rdfs:label "serialize_trig12" ;
