    ns42:processUpdate dcterms:identifier "starlayer.graph.query.sparql_api.processUpdate" ;
        a slkg:Function ;
        rdfs:comment """Execute a SPARQL 1.2 Update against a graph.

This is the SPARQL 1.2-aware replacement for
``rdflib.plugins.sparql.processUpdate``. The rdflib original calls
``parseUpdate()`` directly, bypassing any ``graph.update()`` override.

For ``StarLayerGraph``/``StarLayerDataset`` instances, this delegates
the *original* SPARQL 1.2 text straight to ``graph.update()`` so that
graph's own full update pipeline runs unmodified (registry rebuild,
``_invalidate_callback``, native-backend routing, INSERT/DELETE
template-position triple-term handling — all of which is specific to
those classes' own ``.update()``, not something to reimplement or
bypass here). For a plain ``rdflib.Graph`` (which has no notion of
SPARQL 1.2 syntax at all), ``updateString`` is first compiled via this
module's own ``prepareUpdate`` into a directly executable, already-
SPARQL-1.1 ``Update`` object, then handed to ``graph.update()`` — the
same general entry point, not the more narrowly-typed
``rdflib.plugins.sparql.processUpdate`` function, since ``Graph.update()``
already accepts a prepared object or text uniformly.

Checks via attribute (``_tt_registry``/``_sg_cache``) rather than
``isinstance`` to avoid a circular import.""" ;
        rdfs:label "processUpdate" ;
        slkg:calls ns42:prepareUpdate ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        slkg:hasParameter ns42:processUpdate.param.initBindings, ns42:processUpdate.param.updateString, ns42:processUpdate.param.base, ns42:processUpdate.param.initNs, ns42:processUpdate.param.graph ;
        slkg:hasReturnValue ns42:processUpdate.returns ;
        slkg:lineEnd 220 ;
        slkg:lineStart 173 ;
        slkg:signature "def processUpdate(graph, updateString: str, initBindings=None, initNs=None, base=None) -> None" .

    ns42:processUpdate.param.base a slkg:Parameter ;
        rdfs:comment "Optional base IRI for relative-IRI resolution." ;
        rdfs:label "base" ;
        slkg:defaultValue "None" ;
        slkg:parameterKind "positional" ;
        slkg:position 4 .

    ns42:processUpdate.param.graph a slkg:Parameter ;
        rdfs:comment "The graph to update - a ``StarLayerGraph``/ ``StarLayerDataset`` or a plain ``rdflib.Graph``." ;
        rdfs:label "graph" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns42:processUpdate.param.initBindings a slkg:Parameter ;
        rdfs:comment "Optional initial variable bindings." ;
        rdfs:label "initBindings" ;
        slkg:defaultValue "None" ;
        slkg:parameterKind "positional" ;
        slkg:position 2 .

    ns42:processUpdate.param.initNs a slkg:Parameter ;
