        a slkg:Function ;
        rdfs:label "_build_reifier_shape_component" ;
        slkg:declares ns76:_build_reifier_shape_component.ReifierShapeConstraintComponent ;
        slkg:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
