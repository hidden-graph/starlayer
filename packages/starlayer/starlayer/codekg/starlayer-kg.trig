        slkg:calls ns58:_render_expr_text, ns53:_decode ;
        slkg:filePath "packages/starlayer/starlayer/sparql/ssyn_to_text.py" ;
        slkg:hasParameter ns58:_expr_text.param.graph, ns58:_expr_text.param.expr_node ;
        slkg:hasReturnValue ns58:_expr_text.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 151 ;
        slkg:lineStart 149 ;
        slkg:signature "def _expr_text(graph: Graph, expr_node) -> str" .

    ns58:_expr_text.param.expr_node a slkg:Parameter ;
