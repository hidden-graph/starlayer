GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/extractor/imports.py> {
    ns276:imports.py dcterms:identifier "starlayer.codekg.extractor.imports" ;
        a slkg:Module ;
        rdfs:comment """starlayer.codekg.extractor.imports - per-file import table extraction.

``build_import_table()``: walks an already-parsed module AST and produces
a flat ``{bound_name: dotted_path}`` mapping covering every ``import``/
``from ... import ...`` statement in the file - not just the ones at
module top level. This codebase's own established convention is lazy/
deferred imports inside function bodies (e.g. ``from rdflib.term import
Node`` inside a function - see
``starlayer/graph/model/encoding.py::term_key``), so a visitor that only
looked at ``tree.body`` would silently miss every name bound that way. The
resulting table is what ``types.py``'s ``resolve_type_name()`` uses to turn
a bare annotation name like ``URIRef`` into a real, canonical dotted path.

``bindings_for_import_node()``: the same per-node binding logic, exposed
on its own for a caller needing just one node's own bindings rather than
a whole tree's - ``visitor.py``'s call-resolution uses this to build a
*function-scoped* import table (one function's own lazy imports only),
needed because a function-local import shadows a same-named module-level
function for the rest of that function's own body, and whole-file
``build_import_table()``'s flat table can't tell the two apart (confirmed
via a real case in this project's own ``shacl/validator.py``:
``_default_validate()`` does ``from pyshacl import validate`` then calls
bare ``validate(...)`` - genuinely pySHACL's function, not this module's
own same-named ``validate()``, even though both exist in the same file).""" ;
        rdfs:label "imports" ;
        slkg:declares ns277:bindings_for_import_node, ns277:build_import_table ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/imports.py" ;
        slkg:importsModule ns4:__future__, ns4:ast .

    ns277:bindings_for_import_node dcterms:identifier "starlayer.codekg.extractor.imports.bindings_for_import_node" ;
        a slkg:Function ;
        rdfs:comment """One ``Import``/``ImportFrom`` node's own ``{bound_name: dotted_path}``
bindings - the per-node logic ``build_import_table()`` applies across
a whole tree via ``ast.walk()``, factored out here so a caller needing
just *one* node's own bindings (e.g. ``visitor.py``'s function-local-
import-shadowing resolution, scoped to a single function's own direct
body rather than the whole file) doesn't have to re-derive this.""" ;
        rdfs:label "bindings_for_import_node" ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/imports.py" ;
        slkg:hasParameter ns277:bindings_for_import_node.param.module_dotted_path, ns277:bindings_for_import_node.param.node ;
        slkg:hasReturnValue ns277:bindings_for_import_node.returns ;
        slkg:lineEnd 122 ;
        slkg:lineStart 67 ;
        slkg:signature "def bindings_for_import_node(node: ast.Import | ast.ImportFrom, module_dotted_path: str) -> dict[str, str]" .

    ns277:bindings_for_import_node.param.module_dotted_path a slkg:Parameter ;
        rdfs:comment "Same as ``build_import_table()``'s own parameter - needed to resolve a relative (``from .x import y``) import." ;
        rdfs:label "module_dotted_path" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns277:bindings_for_import_node.param.node a slkg:Parameter ;
        rdfs:comment "One ``ast.Import`` or ``ast.ImportFrom`` node." ;
        rdfs:label "node" ;
        slkg:annotationText "ast.Import | ast.ImportFrom" ;
        slkg:hasType ns4:ast.Import, ns4:ast.ImportFrom ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns277:bindings_for_import_node.returns a slkg:ReturnValue ;
        rdfs:comment "The bindings this one node introduces (usually one, more for a multi-name ``import a, b``/``from x import a, b``)." ;
        slkg:annotationText "dict[str, str]" ;
        slkg:hasType ns4:builtins.dict, ns4:builtins.str .

    ns277:build_import_table dcterms:identifier "starlayer.codekg.extractor.imports.build_import_table" ;
        a slkg:Function ;
        rdfs:comment """Build a flat ``{bound_name: dotted_path}`` table for every import
statement anywhere in ``tree`` (module-level and nested inside function/
class bodies alike).""" ;
        rdfs:label "build_import_table" ;
        slkg:calls ns277:bindings_for_import_node ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/imports.py" ;
        slkg:hasParameter ns277:build_import_table.param.tree, ns277:build_import_table.param.module_dotted_path ;
        slkg:hasReturnValue ns277:build_import_table.returns ;
        slkg:lineEnd 64 ;
        slkg:lineStart 32 ;
        slkg:signature "def build_import_table(tree: ast.Module, module_dotted_path: str) -> dict[str, str]" .

    ns277:build_import_table.param.module_dotted_path a slkg:Parameter ;
        rdfs:comment "This module's own fully dotted import path (e.g. ``\"starlayer.graph.model.encoding\"``), used to resolve any relative (``from .x import y``) imports found inside it." ;
        rdfs:label "module_dotted_path" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns277:build_import_table.param.tree a slkg:Parameter ;
        rdfs:comment "The module's parsed AST (``ast.parse(source)``)." ;
        rdfs:label "tree" ;
        slkg:annotationText "ast.Module" ;
        slkg:hasType ns4:ast.Module ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns277:build_import_table.returns a slkg:ReturnValue ;
        rdfs:comment "A dict mapping each bound local name to the dotted path it resolves to. Star imports (``from x import *``) contribute no binding at all, since there's no single name to bind." ;
        slkg:annotationText "dict[str, str]" ;
        slkg:hasType ns4:builtins.dict, ns4:builtins.str .

    ns4:__future__ a slkg:ExternalModule .

    ns4:ast a slkg:ExternalModule .

    ns4:ast.Import dcterms:identifier "ast.Import" ;
        a slkg:ExternalType ;
        rdfs:label "Import" ;
        rdfs:subClassOf slkg:Type .

    ns4:ast.ImportFrom dcterms:identifier "ast.ImportFrom" ;
        a slkg:ExternalType ;
        rdfs:label "ImportFrom" ;
        rdfs:subClassOf slkg:Type .

    ns4:ast.Module dcterms:identifier "ast.Module" ;
        a slkg:ExternalType ;
        rdfs:label "Module" ;
        rdfs:subClassOf slkg:Type .

    ns4:builtins.dict dcterms:identifier "builtins.dict" ;
        a slkg:ExternalType ;
        rdfs:label "dict" ;
        rdfs:subClassOf slkg:Type .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a slkg:ExternalType ;
        rdfs:label "str" ;
        rdfs:subClassOf slkg:Type .
}

