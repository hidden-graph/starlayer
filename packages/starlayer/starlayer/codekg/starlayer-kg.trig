        slkg:position 4 .

    ns75:StarShaclSchema.validate.param.shapes_graph_resource a slkg:Parameter ;
        rdfs:comment "One value with two possible meanings, depending on what's actually true of this instance's own bound ``shacl_graph`` - see ``_resolve_shapes_graph_and_provenance()``'s own docstring for the full design. If it names a real ``a sh:ShapesGraph`` module within ``shacl_graph``, that module alone is validated against, and its own IRI becomes the report's ``sh:usedShapesGraph`` identity. If ``shacl_graph`` is bound but doesn't contain it as a module, it's used purely as the report's ``sh:usedShapesGraph`` identity, and the whole bound ``shacl_graph`` is validated against unchanged. Raises if given with no bound ``shacl_graph`` at all. Falls back to ``shacl_graph.identifier`` the same way ``data_graph_iri`` falls back to ``data_graph.identifier``, when left ``None``." ;
        rdfs:label "shapes_graph_resource" ;
