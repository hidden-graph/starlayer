    ns88:normalize_to_starlayer_graph dcterms:identifier "starlayer.shacl.engine.normalization.normalize_to_starlayer_graph" ;
        a slkg:Function ;
        rdfs:comment """Normalize input graph to StarLayerGraph.

A plain rdflib.Graph is always converted. Existing StarLayerGraph
instances are returned as-is.""" ;
        rdfs:label "normalize_to_starlayer_graph" ;
        slkg:calls ns28:StarLayerGraph.from_rdflib ;
        slkg:filePath "packages/starlayer/starlayer/shacl/engine/normalization.py" ;
        slkg:hasParameter ns88:normalize_to_starlayer_graph.param.value, ns88:normalize_to_starlayer_graph.param.name, ns88:normalize_to_starlayer_graph.param.force_default_union ;
        slkg:hasReturnValue ns88:normalize_to_starlayer_graph.returns ;
        slkg:lineEnd 56 ;
        slkg:lineStart 8 ;
        slkg:signature "def normalize_to_starlayer_graph(value: Any, *, name: str, force_default_union: bool=False) -> Any" .

    ns88:normalize_to_starlayer_graph.param.force_default_union a slkg:Parameter ;
        rdfs:comment "When ``value`` is an ``rdflib.Dataset`` (or ``StarLayerDataset``, a subclass), setting this mutates ``value.default_union = True`` before conversion - matching pySHACL's own native behavior when given a raw ``Dataset`` directly as ``ont_graph`` (``pyshacl/validator.py``: ``if isinstance(self.ont_graph, rdflib.Dataset): self.ont_graph.default_union = True``), so ontology triples across all named graphs are visible for inference regardless of how the caller constructed the dataset. Not used for ``data_graph``/``shacl_graph`` - pySHACL doesn't auto-union those either, only ``ont_graph``." ;
        rdfs:label "force_default_union" ;
        slkg:annotationText "bool" ;
        slkg:defaultValue "False" ;
        slkg:hasType ns4:builtins.bool ;
        slkg:parameterKind "kwonly" ;
        slkg:position 2 .

