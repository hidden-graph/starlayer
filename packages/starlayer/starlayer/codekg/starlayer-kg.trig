    ns90:TripleTermAdapter.clear_registry.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns90:TripleTermAdapter.decode_graph dcterms:identifier "starlayer.shacl.adapters.TripleTermAdapter.decode_graph" ;
        a slkg:Method ;
        rdfs:comment """Returns the inverse of ``encode_graph()``: a copy of ``graph``
with every encoded term resolved back to its real form.

Every registered ``tt:HASH`` URIRef is resolved back to a real
triple term, and a dirlang-encoded Literal back to a
``DirLangString``. Drops the
``rdf:subject``/``rdf:predicate``/``rdf:object`` encoding triples
``encode_graph()`` added for each registered term - those are
internal bookkeeping, not part of the decoded graph's own
content.""" ;
        rdfs:label "decode_graph" ;
        slkg:calls ns90:TripleTermAdapter._decode_node_for_graph, ns90:TripleTermAdapter._new_output_graph ;
        slkg:filePath "packages/starlayer/starlayer/shacl/adapters.py" ;
        slkg:hasParameter ns90:TripleTermAdapter.decode_graph.param.graph ;
        slkg:hasReturnValue ns90:TripleTermAdapter.decode_graph.returns ;
