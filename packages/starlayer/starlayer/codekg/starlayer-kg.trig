        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns17:extract_version_directive.returns a slkg:ReturnValue ;
        rdfs:comment "The first rdf:version attribute value found anywhere in the document, or None if there isn't one." ;
        slkg:annotationText "str | None" ;
        slkg:hasType ns4:builtins.str ;
        slkg:optional true .

    ns17:parse_rdfxml12 dcterms:identifier "starlayer.graph.parsers.rdfxml12.parse_rdfxml12" ;
        a slkg:Function ;
        rdfs:comment """Parse RDF/XML 1.2 text; return list of (s, p, o) triples.

rdf:parseType="Triple" (triple terms in object position) and
rdf:annotation/rdf:annotationNodeID (the reifier-shorthand attributes) are
the two RDF 1.2 additions to RDF/XML; both are preprocessed at the XML
tree level (see _Preprocessor) into the bnode-based rdf:TripleTerm
intermediate encoding, then handed to rdflib's real (RDF 1.1) 'xml'
parser, then converted to TripleTerm objects exactly as before.
Subjects and objects may be TripleTerm instances.""" ;
        rdfs:label "parse_rdfxml12" ;
        slkg:calls ns17:_convert_bnodes ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/rdfxml12.py" ;
        slkg:hasParameter ns17:parse_rdfxml12.param.text ;
        slkg:hasReturnValue ns17:parse_rdfxml12.returns ;
        slkg:instantiates ns17:_Preprocessor ;
        slkg:lineEnd 357 ;
        slkg:lineStart 333 ;
        slkg:signature "def parse_rdfxml12(text: str) -> list[tuple]" .

    ns17:parse_rdfxml12.param.text a slkg:Parameter ;
        rdfs:comment "The RDF/XML 1.2 document text to parse." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns17:parse_rdfxml12.returns a slkg:ReturnValue ;
        rdfs:comment "A list of (s, p, o) triples." ;
