    ns61:_subst_head_triple dcterms:identifier "starlayer.sparql.srl_eval._subst_head_triple" ;
        a slkg:Function ;
        rdfs:comment """§6.4: ``subst(mu, TT)`` for a head triple template - substitutes
every variable per ``mu``. A literal blank node in the head is *not* a
variable, so ``subst`` itself never touches it - but the spec's own
§6.6 worked-example commentary ("instantiating the head creates a
fresh blank node") makes clear head blank nodes get a fresh identity
per solution, the same well-established convention ordinary SPARQL
CONSTRUCT already uses. ``bnode_map`` is shared across every triple
template of *one* rule instantiated for *one* solution, so multiple
head triples referencing the same blank node label (e.g. this
project's own §6.6 R5 test: ``{ [] a :Notification ; :concerns ?x }``)
still share one fresh blank node per solution, distinct across
solutions.""" ;
        rdfs:label "_subst_head_triple" ;
        slkg:calls ns61:_graph_term ;
        slkg:declares ns61:_subst_head_triple._sub ;
        slkg:filePath "packages/starlayer/starlayer/sparql/srl_eval.py" ;
        slkg:hasParameter ns61:_subst_head_triple.param.bnode_map, ns61:_subst_head_triple.param.triple, ns61:_subst_head_triple.param.mu ;
        slkg:hasReturnValue ns61:_subst_head_triple.returns ;
        slkg:instantiates ns61:SRLEvalError ;
        slkg:isPrivate true ;
        slkg:lineEnd 569 ;
        slkg:lineStart 526 ;
        slkg:signature "def _subst_head_triple(triple: srl_ast.TriplePattern, mu: dict, bnode_map: dict[BNode, BNode]) -> tuple" .

