    ns236:TestSurrogateEscapes dcterms:identifier "tests.graph.unit.test_turtle_parser.TestSurrogateEscapes" ;
        a slkg:Class ;
        rdfs:comment """Turtle's UCHAR (\\uXXXX/\\UXXXXXXXX) grammar directly encodes a
Unicode codepoint - the UTF-16 surrogate range (U+D800-U+DFFF) is
excluded, since surrogates are a UTF-16 encoding artifact, not a valid
standalone codepoint (a supplementary-plane character is written with
a single \\U escape of its real codepoint, not a \\u\\u surrogate pair
the way JSON/JavaScript encode it). Confirmed against the W3C RDF 1.2
Turtle syntax test suite (turtle12-surrogate*/turtle12-surrogates-bad-*
- see tests/w3c_turtle12/).""" ;
        rdfs:label "TestSurrogateEscapes" ;
        slkg:declares ns236:TestSurrogateEscapes.test_lone_high_surrogate_rejected, ns236:TestSurrogateEscapes.test_lone_low_surrogate_rejected, ns236:TestSurrogateEscapes.test_non_surrogate_uchar_accepted, ns236:TestSurrogateEscapes.test_surrogate_pair_rejected ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser.py" ;
        slkg:lineEnd 529 ;
        slkg:lineStart 502 .

    ns236:TestSurrogateEscapes.test_lone_high_surrogate_rejected dcterms:identifier "tests.graph.unit.test_turtle_parser.TestSurrogateEscapes.test_lone_high_surrogate_rejected" ;
