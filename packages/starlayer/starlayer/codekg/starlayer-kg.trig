    ns158:TestSparqlQueryStructureValidation dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions.TestSparqlQueryStructureValidation" ;
        a slkg:Class ;
        rdfs:comment """check_sparql_query_text(): a literal that *parses* fine can still
have a real, silent defect a bare parse never catches - most notably
an unbound projected variable (compiles and runs, just never binds
one of its own SELECT variables). After a successful parse, the query
is additionally encoded as a salg: graph and validated against
starlayer.sparql.salg's own general-purpose SPARQL-structure shapes,
which already has a real check for exactly this
(salg:noUnboundProjectedVariables) - just never pointed at a SHACL
shape's own embedded query text before. Always runs whenever
check_sparql_query_text() itself runs - i.e. whenever meta_shacl=True
(the default), same as the parse check alongside it - not a separate
opt-in, since it's cached and the whole point is to actually catch
this class of bug in real shape libraries, not require remembering to
turn it on.""" ;
        rdfs:label "TestSparqlQueryStructureValidation" ;
        slkg:declares ns158:TestSparqlQueryStructureValidation.test_unbound_this_in_a_sparql_target_is_a_real_defect_not_exempted, ns158:TestSparqlQueryStructureValidation._shapes_with_sparql_constraint, ns158:TestSparqlQueryStructureValidation.test_repeated_call_hits_cache_not_salg_again, ns158:TestSparqlQueryStructureValidation._shapes_with_sparql_target, ns158:TestSparqlQueryStructureValidation.test_disabled_via_meta_shacl_false, ns158:TestSparqlQueryStructureValidation._shapes_with, ns158:TestSparqlQueryStructureValidation.test_unbound_projected_variable_parses_but_fails_structure_check, ns158:TestSparqlQueryStructureValidation.test_genuinely_unbound_non_prebound_variable_still_raises_alongside_this, ns158:TestSparqlQueryStructureValidation.test_this_only_validator_is_not_a_false_positive, ns158:TestSparqlQueryStructureValidation.test_bundled_validation_shapes_conform, ns158:TestSparqlQueryStructureValidation.test_meta_shacl_is_off_by_default, ns158:TestSparqlQueryStructureValidation.test_well_formed_query_passes_structure_check, ns158:TestSparqlQueryStructureValidation.test_end_to_end_validate_raises_when_meta_shacl_is_requested, ns158:TestSparqlQueryStructureValidation.test_well_formed_sparql_target_passes ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py" ;
        slkg:lineEnd 1570 ;
        slkg:lineStart 1394 .

