    ns15:_parse_nt_line.returns a slkg:ReturnValue ;
        rdfs:comment "(s, p, o)        for N-Triples (s, p, o, g)     for N-Quads  (g is None for default graph) None             for blank / comment lines" ;
        slkg:annotationText "tuple | None" ;
        slkg:hasType ns4:builtins.tuple ;
        slkg:optional true .

    ns15:_token_to_node dcterms:identifier "starlayer.graph.parsers.ntriples12._token_to_node" ;
