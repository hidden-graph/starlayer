    ns299:reject_surrogate_escapes dcterms:identifier "starlayer.sparql._syntax_checks.reject_surrogate_escapes" ;
        a slkg:Function ;
        rdfs:comment """Reject a ``\\uD800``-``\\uDFFF`` codepoint escape.

A surrogate is not a Unicode scalar value, so SPARQL 1.2 forbids it even
as half of a valid pair; a character outside the BMP is written
``\\UXXXXXXXX``.

Raises:
    SPARQLSyntaxError: If ``text`` contains such an escape.""" ;
        rdfs:label "reject_surrogate_escapes" ;
        slkg:filePath "packages/starlayer/starlayer/sparql/_syntax_checks.py" ;
        slkg:hasParameter ns299:reject_surrogate_escapes.param.text ;
        slkg:hasReturnValue ns299:reject_surrogate_escapes.returns ;
        slkg:instantiates ns299:SPARQLSyntaxError ;
        slkg:lineEnd 41 ;
        slkg:lineStart 26 ;
        slkg:signature "def reject_surrogate_escapes(text: str) -> None" .

    ns299:reject_surrogate_escapes.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns299:reject_surrogate_escapes.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns4:__future__ a slkg:ExternalModule .

