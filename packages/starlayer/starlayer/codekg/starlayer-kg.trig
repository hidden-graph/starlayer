        slkg:signature "def _node_conforms(node: Any, shape: Any, *, base_graph: Any, shapes_graph: Any) -> bool" .

    ns308:_node_conforms.param.base_graph a slkg:Parameter ;
        rdfs:label "base_graph" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
