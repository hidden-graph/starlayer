        slkg:filePath "packages/starlayer/starlayer/graph/query/evaluate_patches.py" ;
        slkg:hasReturnValue ns40:patch_construct_skips_encoding_solutions.returns ;
        slkg:lineEnd 772 ;
        slkg:lineStart 684 ;
        slkg:signature "def patch_construct_skips_encoding_solutions() -> bool" .

