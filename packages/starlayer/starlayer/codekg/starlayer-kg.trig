    ns170:TestSameLineStatements dcterms:identifier "tests.graph.unit.test_syntax.TestSameLineStatements" ;
        a slkg:Class ;
        rdfs:comment """Two or more statements crammed onto one physical line must still
split correctly - previously a '.' only counted as a statement
terminator when immediately followed by a newline, so anything after
it on the same line got silently merged into the preceding statement
and dropped (worst for a directive, whose regex-based field extractor
only matches its own leading portion and ignores the rest).""" ;
        rdfs:label "TestSameLineStatements" ;
        slkg:declares ns170:TestSameLineStatements.test_dot_inside_iri_with_dots_not_split, ns170:TestSameLineStatements.test_two_triples_one_line, ns170:TestSameLineStatements.test_multiple_dotted_prefixes_and_triples_one_line, ns170:TestSameLineStatements.test_dotted_prefix_then_triple_one_line, ns170:TestSameLineStatements.test_dotless_prefix_still_works, ns170:TestSameLineStatements.test_decimal_literal_then_another_statement_same_line, ns170:TestSameLineStatements.test_decimal_literal_not_split ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_syntax.py" ;
        slkg:lineEnd 187 ;
        slkg:lineStart 134 .

    ns170:TestSameLineStatements.test_decimal_literal_not_split dcterms:identifier "tests.graph.unit.test_syntax.TestSameLineStatements.test_decimal_literal_not_split" ;
        a slkg:Method ;
        rdfs:comment """Guards the fix itself: a '.' terminates a statement unless
immediately followed by a digit (the decimal point of a DECIMAL/
DOUBLE literal like "3.14"), not "unless followed by a newline".""" ;
        rdfs:label "test_decimal_literal_not_split" ;
        slkg:calls ns18:split_statements ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_syntax.py" ;
        slkg:lineEnd 167 ;
        slkg:lineStart 162 ;
        slkg:signature "def test_decimal_literal_not_split(self)" .

    ns170:TestSameLineStatements.test_decimal_literal_then_another_statement_same_line dcterms:identifier "tests.graph.unit.test_syntax.TestSameLineStatements.test_decimal_literal_then_another_statement_same_line" ;
        a slkg:Method ;
        rdfs:label "test_decimal_literal_then_another_statement_same_line" ;
        slkg:calls ns18:split_statements ;
