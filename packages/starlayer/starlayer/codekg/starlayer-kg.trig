    ns208:test_meta_shacl_reports_a_genuine_blank_node_violation_without_crashing.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns208:test_meta_shacl_snapshots_a_remote_shapes_graph_to_in_memory dcterms:identifier "tests.shacl.integration.test_native_backend_oxigraph.test_meta_shacl_snapshots_a_remote_shapes_graph_to_in_memory" ;
        a slkg:Function ;
        rdfs:comment """The fix that closed the one remaining gap in the compatibility
matrix, found via a direct user suggestion: rather than chase down
every individual pySHACL-internal code path that breaks on a bound
blank node against a SPARQLUpdateStore (a class-membership check,
report-stringification, and a query(initBindings=...) call in the
sh:sparql-based constraint evaluator were each found and would keep
surfacing more), meta_validate() (starlayer.shacl/meta_shapes.py) now
snapshots shapes_graph into a plain in-memory StarLayerGraph before
running meta-shacl at all, whenever the original is backed by a
SPARQLUpdateStore (StarLayerGraph._needs_bnode_skolemization, reused
here for exactly the check it already computes). Correct specifically
because meta-shacl checks the shapes graph's own structural
well-formedness against a fixed, bundled meta-shapes graph - it never
reads data_graph and has no legitimate need for live remote-store
behavior at all; a one-time snapshot is the right shape for a one-time
preflight check. Confirmed live on both Oxigraph and Fuseki, both
backend modes - meta_shacl is now on at its real default everywhere in
the compatibility matrix, no exceptions.""" ;
        rdfs:label "test_meta_shacl_snapshots_a_remote_shapes_graph_to_in_memory" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_native_backend_oxigraph.py" ;
        slkg:hasReturnValue ns208:test_meta_shacl_snapshots_a_remote_shapes_graph_to_in_memory.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 397 ;
        slkg:lineStart 350 ;
        slkg:signature "def test_meta_shacl_snapshots_a_remote_shapes_graph_to_in_memory() -> None" .

    ns208:test_meta_shacl_snapshots_a_remote_shapes_graph_to_in_memory.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

