GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/extractor/__init__.py> {
    ns276:__init__.py dcterms:identifier "starlayer.codekg.extractor.__init__" ;
        a slkg:Module ;
        rdfs:comment """starlayer.codekg.extractor - pure-logic pieces of the code-KG extractor.

Each sibling module here (``imports``, ``types``, ``docstrings``) is
self-contained and independently importable, with no dependency on each
other or on the not-yet-built AST visitor/build orchestration/CLI. This
``__init__.py`` deliberately re-exports nothing - callers import the
specific module they need (``from starlayer.codekg.extractor import
imports`` etc.) rather than a flattened namespace, so each module's own
docstring stays the one place describing its contract.""" ;
        rdfs:label "__init__" ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/__init__.py" .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/model/dirlangstring.py> {
    ns1:dirlangstring.py dcterms:identifier "starlayer.graph.model.dirlangstring" ;
        a slkg:Module ;
        rdfs:comment """starlayer.graph.model.dirlangstring

Core RDF 1.2 type: DirLangString — a language-tagged string literal carrying
an explicit base text direction ('ltr' or 'rtl'), per rdf:dirLangString
(RDF 1.2 Concepts sec 3.4). Lexical form: "text"@lang--dir.

Encoding follows the same "invisible to public APIs" approach as TripleTerm:
rdflib.Literal(text, lang="en--rtl") raises (rdflib has no notion of the
--dir suffix), so a DirLangString is stored as a plain Literal whose datatype
URI packs (language, direction) - see encode_dirlang_datatype in
starlayer.graph.model.encoding. StarLayerGraph encodes/decodes at its read/write
boundary so callers only ever see DirLangString or plain rdflib terms.""" ;
        rdfs:label "dirlangstring" ;
        slkg:declares ns6:DirLangString, ns6:decode_dirlangstring, ns6:encode_dirlangstring ;
        slkg:filePath "packages/starlayer/starlayer/graph/model/dirlangstring.py" ;
        slkg:importsModule ns4:rdflib .

    ns6:DirLangString dcterms:identifier "starlayer.graph.model.dirlangstring.DirLangString" ;
        a slkg:Class ;
        rdfs:comment """An RDF 1.2 directional language-tagged string literal.

Value-typed: two instances with the same (value, language, direction) are
equal and have the same hash. Per RDF 1.2 Concepts sec 3.4.1, a language
tag's case does not participate in the abstract syntax - it is folded to
lowercase here, mirroring rdflib.Literal's existing behaviour for lang=.""" ;
        rdfs:label "DirLangString" ;
        slkg:declares ns6:DirLangString.__setattr__, ns6:DirLangString.__hash__, ns6:DirLangString.__repr__, ns6:DirLangString._key, ns6:DirLangString.__eq__, ns6:DirLangString.n3, ns6:DirLangString.__init__, ns6:DirLangString.__str__ ;
