GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/w3c_turtle12/test_w3c_turtle.py> {
    ns201:test_w3c_turtle.py dcterms:identifier "tests.graph.w3c_turtle12.test_w3c_turtle" ;
        a slkg:Module ;
        rdfs:comment """W3C Turtle 1.2 conformance tests.

Parametrized over tests/w3c_turtle12/data/manifest.csv, which covers three test
types from the two W3C-published manifests for RDF 1.2 Turtle:

  rdft:TestTurtleEval           - parse the .ttl, compare against the
                                   expected .nt (test_w3c_turtle_eval)
  rdft:TestTurtlePositiveSyntax - must parse without raising, result
                                   content not checked (test_w3c_turtle_
                                   positive_syntax)
  rdft:TestTurtleNegativeSyntax - must fail to parse (test_w3c_turtle_
                                   negative_syntax)

For Eval: build the expected graph from the .nt file using parse_nt12(),
which expands the RDF 1.2 <<( )>> triple-term notation into the same
starlayer.graph internal blank-node encoding the parser produces, then assert
graph isomorphism (handles blank-node renaming automatically).""" ;
        rdfs:label "test_w3c_turtle" ;
        slkg:declares ns202:_load_manifest, ns202:parse_nt12, ns202:test_w3c_turtle_positive_syntax, ns202:test_w3c_turtle_negative_syntax, ns202:test_w3c_turtle_eval ;
        slkg:filePath "packages/starlayer/tests/graph/w3c_turtle12/test_w3c_turtle.py" ;
        slkg:importsModule ns4:rdflib.compare, ns4:csv, ns4:rdflib.namespace, ns4:pytest, ns4:pathlib, ns4:rdflib .

    ns202:_load_manifest dcterms:identifier "tests.graph.w3c_turtle12.test_w3c_turtle._load_manifest" ;
        a slkg:Function ;
        rdfs:comment """Split manifest.csv into three buckets by test_type - Eval needs a
matching .nt to compare against; Positive/NegativeSyntax only need the
.ttl to exist, since they test parse success/failure, not content.""" ;
        rdfs:label "_load_manifest" ;
        slkg:filePath "packages/starlayer/tests/graph/w3c_turtle12/test_w3c_turtle.py" ;
        slkg:isPrivate true ;
        slkg:lineEnd 201 ;
        slkg:lineStart 181 ;
        slkg:signature "def _load_manifest()" .

    ns202:parse_nt12 dcterms:identifier "tests.graph.w3c_turtle12.test_w3c_turtle.parse_nt12" ;
        a slkg:Function ;
        rdfs:comment """Parse N-Triples 1.2 text into an rdflib.Graph using the starlayer.graph
internal encoding for <<( s p o )>> triple terms.

Blank-node labels within a single file are de-duplicated: the same label
always maps to the same BNode instance, so the resulting graph is suitable
for isomorphism comparison with the parser's output.""" ;
        rdfs:label "parse_nt12" ;
        slkg:calls ns202:parse_nt12.resolve_token, ns20:next_token, ns202:parse_nt12.expand_triple_term, ns202:parse_nt12.get_bnode ;
        slkg:declares ns202:parse_nt12.expand_triple_term, ns202:parse_nt12.get_bnode, ns202:parse_nt12.resolve_token ;
        slkg:filePath "packages/starlayer/tests/graph/w3c_turtle12/test_w3c_turtle.py" ;
        slkg:hasParameter ns202:parse_nt12.param.text ;
        slkg:lineEnd 174 ;
        slkg:lineStart 45 ;
        slkg:signature "def parse_nt12(text)" .

    ns202:parse_nt12.expand_triple_term dcterms:identifier "tests.graph.w3c_turtle12.test_w3c_turtle.parse_nt12.expand_triple_term" ;
        a slkg:Function ;
        rdfs:comment "Expand <<( s p o )>> into a starlayer.graph TripleTerm bnode. Handles nesting." ;
        rdfs:label "expand_triple_term" ;
        slkg:calls ns202:parse_nt12.expand_triple_term, ns202:parse_nt12.resolve_token, ns20:next_token ;
        slkg:filePath "packages/starlayer/tests/graph/w3c_turtle12/test_w3c_turtle.py" ;
        slkg:hasParameter ns202:parse_nt12.expand_triple_term.param.tok ;
        slkg:lineEnd 134 ;
        slkg:lineStart 94 ;
        slkg:signature "def expand_triple_term(tok)" .

    ns202:parse_nt12.expand_triple_term.param.tok a slkg:Parameter ;
        rdfs:label "tok" ;
        slkg:parameterKind "positional" ;
