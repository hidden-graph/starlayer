GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py> {
    ns97:test_rule_layers_and_run_once.py dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once" ;
        a slkg:Module ;
        rdfs:comment """sh:layer / sh:runOnce (SHACL 1.2 SPARQL Extensions section 8.2.4/8.2.6).

pySHACL's own rule loop (``pyshacl.rules.apply_rules``) processes shapes
*sequentially* - one shape's rules reach their own independent fixpoint,
then the next shape's rules run, in ``shape.order`` order. The spec's layer
model is a *global* fixpoint across every rule in a layer regardless of
which shape it's attached to, which that per-shape loop cannot express.
``starlayer.shacl/validator.py::_patch_rules_apply_for_layer_and_run_once``
replaces the loop, but only when a shapes graph actually declares
``sh:layer``/``sh:runOnce`` - see that function's docstring.""" ;
        rdfs:label "test_rule_layers_and_run_once" ;
        slkg:declares ns130:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop, ns130:test_sh_order_within_a_layer_is_compared_globally_not_per_shape, ns130:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes, ns130:test_cross_shape_layering_orders_by_layer_not_by_shape_order ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        slkg:importsModule ns4:rdflib, ns4:pytest .

    ns130:test_cross_shape_layering_orders_by_layer_not_by_shape_order dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_cross_shape_layering_orders_by_layer_not_by_shape_order" ;
        a slkg:Function ;
        rdfs:comment """ShapeA's rule (layer 0) must produce ex:stage1 before ShapeB's rule
(layer 1) can produce ex:stage2 from it. ShapeA is deliberately given a
*higher* sh:order (10) than ShapeB (0) - under pySHACL's original
per-shape-sequential loop, shapes are processed in ascending shape.order,
so ShapeB (order 0) would run to its own fixpoint *first*, see no
ex:stage1 yet, produce nothing, and never be revisited once ShapeA
(order 10) runs afterward - ex:stage2 would never appear. Only a real
cross-shape, layer-ordered fixpoint gets this right.""" ;
        rdfs:label "test_cross_shape_layering_orders_by_layer_not_by_shape_order" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        slkg:hasReturnValue ns130:test_cross_shape_layering_orders_by_layer_not_by_shape_order.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 75 ;
        slkg:lineStart 25 ;
        slkg:signature "def test_cross_shape_layering_orders_by_layer_not_by_shape_order() -> None" .

    ns130:test_cross_shape_layering_orders_by_layer_not_by_shape_order.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns130:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes" ;
        a slkg:Function ;
        rdfs:comment """A rule that mints a fresh blank node every execution would, if
(mis)treated as an ordinary iterating rule, keep producing a "new" triple
every pass forever - hitting pySHACL's own 100-iteration cap and raising
ReportableRuntimeError. Marking it sh:runOnce must make it fire exactly
once and let the call succeed.""" ;
        rdfs:label "test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        slkg:hasReturnValue ns130:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 112 ;
        slkg:lineStart 78 ;
        slkg:signature "def test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes() -> None" .

    ns130:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns130:test_sh_order_within_a_layer_is_compared_globally_not_per_shape dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_sh_order_within_a_layer_is_compared_globally_not_per_shape" ;
        a slkg:Function ;
        rdfs:comment """Two run-once rules, same layer, on two different shapes: the
precursor (sh:order 1) is on a shape with a *higher* shape.order (10)
than the dependent rule's shape (sh:order 2 on a shape with order 0).
Run-once rules fire exactly once, in sh:order sequence, with no
fixpoint re-try - so if the implementation accidentally grouped/sorted
by shape.order first (the old per-shape nesting) rather than comparing
every rule's own sh:order globally within the layer, the dependent rule
would run before the precursor and never see its output.""" ;
        rdfs:label "test_sh_order_within_a_layer_is_compared_globally_not_per_shape" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        slkg:hasReturnValue ns130:test_sh_order_within_a_layer_is_compared_globally_not_per_shape.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 168 ;
        slkg:lineStart 115 ;
        slkg:signature "def test_sh_order_within_a_layer_is_compared_globally_not_per_shape() -> None" .

    ns130:test_sh_order_within_a_layer_is_compared_globally_not_per_shape.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns130:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop" ;
        a slkg:Function ;
        rdfs:comment """No regression: a shapes graph using ordinary sh:rule with no
sh:layer/sh:runOnce anywhere must still produce the correct result via
pySHACL's own original per-shape loop (the patch delegates straight
through, unmodified) - reuses the existing reach-fixpoint fixture
already covered by test_rule_iteration.py, through apply_rules() this
time rather than validate() directly, to exercise the actual patched
call site.""" ;
        rdfs:label "test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop" ;
        slkg:calls ns99:load_shape ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        slkg:hasReturnValue ns130:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 192 ;
        slkg:lineStart 171 ;
        slkg:signature "def test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop() -> None" .

    ns130:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns4:pytest a slkg:ExternalModule .

    ns4:rdflib a slkg:ExternalModule .
}

