GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/w3c_shacl12/stores.py> {
    ns100:stores.py dcterms:identifier "tests.shacl.w3c_shacl12.stores" ;
        a slkg:Module ;
        rdfs:comment """Graph factories for running the W3C SHACL 1.2 suites through different
stores. Every suite starts by cloning a parsed document into a fresh graph
(``manifest.clone_graph``), so a store axis is just a different ``new_graph``
factory handed to that one function.

``default`` is the ordinary in-memory ``StarLayerGraph()``. ``oxigraph-store``
is an in-process Oxigraph (oxrdflib's ``OxigraphStore`` over a path-less
``pyoxigraph.Store``) in ``rdf-1.2`` native mode - no server, a fresh
independent store per call.""" ;
        rdfs:label "stores" ;
        slkg:declares ns305:oxigraph_store_graph, ns305:StoreUnderTest, ns305:oxigraph_store_installed, ns305:persisted_oxigraph_store, ns305:http_engine_available, ns305:http_store ;
