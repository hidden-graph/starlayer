GRAPH <https://github.com/hidden-graph/starlayer/ns/codekg/derived> {
    ql:call-chain-from slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT DISTINCT ?reached
WHERE { ?a slkg:calls+ ?b . ?a dcterms:identifier ?symbol . ?b dcterms:identifier ?reached . }
ORDER BY ?reached""" .

    ql:call-cycles slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?first ?second
WHERE { ?a slkg:calls ?b . ?b slkg:calls ?a . ?a dcterms:identifier ?first . ?b dcterms:identifier ?second . FILTER(STR(?a) < STR(?b)) }
ORDER BY ?first ?second""" .

    ql:callees-of slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?callee ?file ?line
WHERE { ?c slkg:calls ?t . ?c dcterms:identifier ?symbol . ?t dcterms:identifier ?callee . OPTIONAL { ?t slkg:filePath ?file . } OPTIONAL { ?t slkg:lineStart ?line . } }
ORDER BY ?callee""" .

    ql:callers-of slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?caller ?file ?line
WHERE { ?c slkg:calls ?target . ?c dcterms:identifier ?caller . ?target dcterms:identifier ?symbol . OPTIONAL { ?c slkg:filePath ?file . } OPTIONAL { ?c slkg:lineStart ?line . } }
ORDER BY ?caller""" .

    ql:capabilities slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?area ?capability ?status ?symbol ?file ?line
WHERE { VALUES ?text { UNDEF } ?cap <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> slkg:Capability . ?cap slkg:inCapabilityArea ?a . ?cap rdfs:comment ?capability . ?cap slkg:hasStatus ?status . ?a rdfs:label ?area . FILTER((!BOUND(?text)) || CONTAINS(LCASE(?capability), LCASE(?text))) OPTIONAL { ?cap slkg:implementedByIdentifier ?symbol . OPTIONAL { ?s dcterms:identifier ?symbol . OPTIONAL { ?s slkg:filePath ?file . } OPTIONAL { ?s slkg:lineStart ?line . } } } }
ORDER BY ?area ?capability ?symbol""" .

    ql:capabilities-by-role slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?area ?capability ?status ?symbol ?file ?line
WHERE { ?cap <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> slkg:Capability . ?cap slkg:inCapabilityArea ?a . ?cap rdfs:comment ?capability . ?cap slkg:appRole ?role . ?cap slkg:hasStatus ?status . ?a rdfs:label ?area . OPTIONAL { ?cap slkg:implementedByIdentifier ?symbol . OPTIONAL { ?s dcterms:identifier ?symbol . OPTIONAL { ?s slkg:filePath ?file . } OPTIONAL { ?s slkg:lineStart ?line . } } } }
ORDER BY ?area ?capability ?symbol""" .

    ql:capabilities-by-specification slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?area ?capability ?status ?specification ?symbol ?file ?line
WHERE { VALUES ?spec { UNDEF } ?cap <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> slkg:Capability . ?cap slkg:inCapabilityArea ?a . ?cap rdfs:comment ?capability . ?cap slkg:hasStatus ?status . ?cap slkg:implementsSpecification ?specification . ?a rdfs:label ?area . FILTER((!BOUND(?spec)) || CONTAINS(LCASE(STR(?specification)), LCASE(?spec))) OPTIONAL { ?cap slkg:implementedByIdentifier ?symbol . OPTIONAL { ?s dcterms:identifier ?symbol . OPTIONAL { ?s slkg:filePath ?file . } OPTIONAL { ?s slkg:lineStart ?line . } } } }
ORDER BY ?specification ?area ?capability ?symbol""" .

    ql:capability-of-symbol slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?area ?capability ?status
WHERE { ?cap <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> slkg:Capability . ?cap slkg:inCapabilityArea ?a . ?cap rdfs:comment ?capability . ?cap slkg:hasStatus ?status . ?cap slkg:implementedByIdentifier ?symbol . ?a rdfs:label ?area . }
ORDER BY ?area ?capability""" .

    ql:find-symbol slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?symbol ?kind ?file ?line ?summary
WHERE { VALUES ?text { UNDEF } ?s dcterms:identifier ?symbol . FILTER(CONTAINS(LCASE(?symbol), LCASE(?text))) ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type . FILTER(?type IN (slkg:Class, slkg:Function, slkg:Method, slkg:Module)) BIND(LCASE(REPLACE(STR(?type), "^.*#", "")) AS ?kind) OPTIONAL { ?s slkg:filePath ?file . } OPTIONAL { ?s slkg:lineStart ?line . } OPTIONAL { ?s rdfs:comment ?summary . } }
ORDER BY ?symbol""" .

    ql:leaky-private-functions slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?private ?callerModule ?caller
WHERE { VALUES ?prefix { UNDEF } ?f slkg:isPrivate "true"^^<http://www.w3.org/2001/XMLSchema#boolean> . ?f <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> slkg:Function . ?f dcterms:identifier ?private . FILTER((!BOUND(?prefix)) || STRSTARTS(?private, ?prefix)) ?c dcterms:identifier ?caller . ?c slkg:calls ?f . BIND(STRBEFORE(STR(?c), "#") AS ?callerFile) FILTER(?callerFile != STRBEFORE(STR(?f), "#")) BIND(REPLACE(?callerFile, "^.*/blob/main/", "") AS ?callerModule) }
ORDER BY ?private ?caller""" .

    ql:longest-functions slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?symbol ?lines ?file ?line
WHERE { VALUES ?prefix { UNDEF } ?f dcterms:identifier ?symbol . ?f <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type . ?f slkg:filePath ?file . ?f slkg:lineEnd ?end . ?f slkg:lineStart ?line . FILTER(?type IN (slkg:Function, slkg:Method)) FILTER(STRSTARTS(?file, "packages/starlayer/starlayer/")) FILTER((!BOUND(?prefix)) || STRSTARTS(?symbol, ?prefix)) BIND(?end - ?line + 1 AS ?lines) }
ORDER BY DESC(?lines) ?symbol""" .

    ql:members-of-class slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?member ?kind ?line
WHERE { ?c slkg:declares|slkg:hasAttribute ?m . ?m <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type . ?m rdfs:label ?member . ?c dcterms:identifier ?symbol . FILTER(?type IN (slkg:Method, slkg:Attribute)) BIND(LCASE(REPLACE(STR(?type), "^.*#", "")) AS ?kind) FILTER(!STRSTARTS(?member, "_")) FILTER(NOT EXISTS { ?m slkg:isPrivate "true"^^<http://www.w3.org/2001/XMLSchema#boolean> . }) OPTIONAL { ?m slkg:lineStart ?line . } }
ORDER BY ?line ?member""" .

    ql:module-imports slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?imported
WHERE { ?m dcterms:identifier ?symbol . ?m slkg:importsModule ?i . BIND(REPLACE(STR(?i), "^.*#", "") AS ?imported) }
ORDER BY ?imported""" .

    ql:overrides slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?relation ?method
WHERE { ?m dcterms:identifier ?symbol . { ?m slkg:overrides ?o . ?o dcterms:identifier ?method . BIND("overrides" AS ?relation) } UNION { ?o dcterms:identifier ?method . ?o slkg:overrides ?m . BIND("overridden by" AS ?relation) } }
ORDER BY ?relation ?method""" .

    ql:parameters-of slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?position ?name ?kind ?annotation ?default
WHERE { ?f slkg:hasParameter ?p . ?f dcterms:identifier ?symbol . ?p rdfs:label ?name . OPTIONAL { ?p slkg:position ?position . } OPTIONAL { ?p slkg:parameterKind ?kind . } OPTIONAL { ?p slkg:annotationText ?annotation . } OPTIONAL { ?p slkg:defaultValue ?default . } }
ORDER BY ?position""" .

    ql:public-api-of-module slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?name ?kind ?line ?summary
WHERE { ?mod slkg:declares ?s . ?s dcterms:identifier ?name . ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type . ?mod dcterms:identifier ?symbol . FILTER(?type IN (slkg:Class, slkg:Function)) BIND(LCASE(REPLACE(STR(?type), "^.*#", "")) AS ?kind) FILTER(NOT EXISTS { ?s slkg:isPrivate "true"^^<http://www.w3.org/2001/XMLSchema#boolean> . }) OPTIONAL { ?s slkg:lineStart ?line . } OPTIONAL { ?s rdfs:comment ?summary . } }
ORDER BY ?line""" .

    ql:public-without-docstring slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?symbol ?kind ?file ?line
WHERE { VALUES ?prefix { UNDEF } ?s dcterms:identifier ?symbol . ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type . ?s slkg:filePath ?file . FILTER(?type IN (slkg:Class, slkg:Function, slkg:Method)) BIND(LCASE(REPLACE(STR(?type), "^.*#", "")) AS ?kind) FILTER(STRSTARTS(?file, "packages/starlayer/starlayer/")) FILTER((!BOUND(?prefix)) || STRSTARTS(?symbol, ?prefix)) FILTER(NOT EXISTS { ?s slkg:isPrivate "true"^^<http://www.w3.org/2001/XMLSchema#boolean> . }) FILTER(NOT EXISTS { ?s rdfs:comment ?c . }) OPTIONAL { ?s slkg:lineStart ?line . } }
ORDER BY ?symbol""" .

    ql:subpackage-coupling slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?from ?to (COUNT(*) AS ?calls)
WHERE { ?a slkg:calls ?b . ?a dcterms:identifier ?id1 . ?b dcterms:identifier ?id2 . FILTER(STRSTARTS(?id1, "starlayer.") && STRSTARTS(?id2, "starlayer.")) BIND(REPLACE(?id1, "^(starlayer\\\\.[^.]+).*$", "$1") AS ?from) BIND(REPLACE(?id2, "^(starlayer\\\\.[^.]+).*$", "$1") AS ?to) FILTER(?from != ?to) }
GROUP BY ?from ?to
ORDER BY DESC(?calls) ?from ?to""" .

    ql:symbol-info slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?kind ?file ?line ?lineEnd ?signature ?summary
WHERE { ?s dcterms:identifier ?symbol . ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type . FILTER(?type IN (slkg:Class, slkg:Function, slkg:Method, slkg:Module)) BIND(LCASE(REPLACE(STR(?type), "^.*#", "")) AS ?kind) OPTIONAL { ?s slkg:filePath ?file . } OPTIONAL { ?s slkg:lineStart ?line . } OPTIONAL { ?s slkg:lineEnd ?lineEnd . } OPTIONAL { ?s slkg:signature ?signature . } OPTIONAL { ?s rdfs:comment ?summary . } }""" .

    ql:tests-of slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?test ?file ?line
WHERE { ?t slkg:calls ?target . ?t dcterms:identifier ?test . ?t slkg:filePath ?file . ?target dcterms:identifier ?symbol . FILTER(STRSTARTS(?file, "packages/starlayer/tests/")) OPTIONAL { ?t slkg:lineStart ?line . } }
ORDER BY ?test""" .

    ql:unreferenced-functions slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?symbol ?file ?line
WHERE { VALUES ?prefix { UNDEF } ?f dcterms:identifier ?symbol . ?f <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type . ?f slkg:filePath ?file . FILTER(?type IN (slkg:Function, slkg:Method)) FILTER(STRSTARTS(?file, "packages/starlayer/starlayer/")) FILTER((!BOUND(?prefix)) || STRSTARTS(?symbol, ?prefix)) FILTER(NOT EXISTS { ?f slkg:isPrivate "true"^^<http://www.w3.org/2001/XMLSchema#boolean> . }) FILTER(NOT EXISTS { ?c slkg:calls ?f . }) OPTIONAL { ?f slkg:lineStart ?line . } }
ORDER BY ?symbol""" .

    ql:untested-functions slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?symbol ?file ?line
WHERE { VALUES ?prefix { UNDEF } ?f dcterms:identifier ?symbol . ?f <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?type . ?f slkg:filePath ?file . FILTER(?type IN (slkg:Function, slkg:Method)) FILTER(STRSTARTS(?file, "packages/starlayer/starlayer/")) FILTER((!BOUND(?prefix)) || STRSTARTS(?symbol, ?prefix)) FILTER(NOT EXISTS { ?f slkg:isPrivate "true"^^<http://www.w3.org/2001/XMLSchema#boolean> . }) FILTER(NOT EXISTS { ?t slkg:calls ?f . ?t slkg:filePath ?testFile . FILTER(STRSTARTS(?testFile, "packages/starlayer/tests/")) }) OPTIONAL { ?f slkg:lineStart ?line . } }
ORDER BY ?symbol""" .

    ql:upstream-workarounds slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?upstream ?number ?issue ?status ?workaround ?file ?line
WHERE { VALUES ?project { UNDEF } VALUES ?symbol { UNDEF } ?i <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> slkg:UpstreamIssue . ?i rdfs:label ?issue . ?i slkg:issueStatus ?status . ?i slkg:upstreamProject ?upstream . OPTIONAL { ?i slkg:issueNumber ?number . } OPTIONAL { ?i slkg:workedAroundByIdentifier ?workaround . OPTIONAL { ?s dcterms:identifier ?workaround . OPTIONAL { ?s slkg:filePath ?file . } OPTIONAL { ?s slkg:lineStart ?line . } } } FILTER((!BOUND(?project)) || (LCASE(?upstream) = LCASE(?project))) FILTER((!BOUND(?symbol)) || (?workaround = ?symbol)) }
ORDER BY ?upstream ?number ?workaround""" .

    ql:who-instantiates slkg:queryText """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
SELECT ?constructor ?file ?line
WHERE { ?f slkg:instantiates ?class . ?class dcterms:identifier ?symbol . ?f dcterms:identifier ?constructor . OPTIONAL { ?f slkg:filePath ?file . } OPTIONAL { ?f slkg:lineStart ?line . } }
ORDER BY ?constructor""" .
}

