GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_phase2_forms.py> {
    ns120:test_phase2_forms.py dcterms:identifier "tests.sparql.unit.test_phase2_forms" ;
        a slkg:Module ;
        rdfs:comment """Phase 2a: query forms and operators that turned out to already work with
the generic encoder/decoder from Phase 1, with no new vocabulary or code —
CONSTRUCT, ASK, DESCRIBE (with and without WHERE), and MINUS. Locked in here
as regression tests.

SERVICE is checked structurally only (algebra tree equality after decode),
not executed — evaluating it would require a live network call to a SPARQL
endpoint, which this test suite must not do.""" ;
        rdfs:label "test_phase2_forms" ;
        slkg:declares ns133:test_service_structural_roundtrip, ns133:_strip_bookkeeping, ns133:_canon, ns133:test_roundtrip_result_equivalence ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        slkg:importsModule ns4:pytest, ns4:rdflib.plugins.sparql.processor, ns4:rdflib.plugins.sparql.evaluate .

    ns133:_canon dcterms:identifier "tests.sparql.unit.test_phase2_forms._canon" ;
        a slkg:Function ;
        rdfs:label "_canon" ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        slkg:hasParameter ns133:_canon.param.res ;
        slkg:isPrivate true ;
        slkg:lineEnd 41 ;
        slkg:lineStart 30 ;
        slkg:signature "def _canon(res)" .

    ns133:_canon.param.res a slkg:Parameter ;
        rdfs:label "res" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns133:_strip_bookkeeping dcterms:identifier "tests.sparql.unit.test_phase2_forms._strip_bookkeeping" ;
        a slkg:Function ;
        rdfs:comment """Deep-copy an algebra tree with the _vars/lazy bookkeeping keys removed
and None-valued keys dropped, so two independently-built trees (one via
translateQuery, one via rdf_to_query) can be compared by their real
structure/content. A key explicitly set to None (translateQuery always
sets "datasetClause", even when there's no FROM clause) and an absent
key are behaviorally identical everywhere in rdflib — CompValue.__getattr__
returns None for a missing key too — so encoding skips None values
entirely rather than emitting a triple that would just decode back to
the same key: None.""" ;
        rdfs:label "_strip_bookkeeping" ;
        slkg:calls ns133:_strip_bookkeeping ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        slkg:hasParameter ns133:_strip_bookkeeping.param.node ;
        slkg:isPrivate true ;
        slkg:lineEnd 82 ;
        slkg:lineStart 59 ;
        slkg:signature "def _strip_bookkeeping(node)" .

    ns133:_strip_bookkeeping.param.node a slkg:Parameter ;
        rdfs:label "node" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns133:test_roundtrip_result_equivalence dcterms:identifier "tests.sparql.unit.test_phase2_forms.test_roundtrip_result_equivalence" ;
        a slkg:Function ;
        rdfs:label "test_roundtrip_result_equivalence" ;
