document spans.""" ;
        rdfs:label "__init__" ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/errors.py" ;
        slkg:hasParameter ns19:MultipleGraphsError.__init__.param.format, ns19:MultipleGraphsError.__init__.param.graph_ids ;
