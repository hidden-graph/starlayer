GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/w3c_shacl12/ids.py> {
    ns100:ids.py dcterms:identifier "tests.shacl.w3c_shacl12.ids" ;
        a slkg:Module ;
        rdfs:comment """Portable, machine-independent identifiers for manifest entries.

Deliberately *not* ``str(entry.iri)`` - an entry's IRI is a ``file://``
absolute path (see manifest.py), which differs across machines/checkouts
(a different clone path, CI's checkout directory, ...). A stable id needs to
be relative to the vendored suite's own root instead, so it can be committed
in known_failures.py and still match on any machine. This is also used as
the pytest parametrize id, so a failing test's node id can be pasted
directly into known_failures.py's dict.""" ;
        rdfs:label "ids" ;
        slkg:declares ns103:portable_id ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/ids.py" ;
        slkg:importsModule ns4:pathlib, ns4:__future__ .

    ns103:portable_id dcterms:identifier "tests.shacl.w3c_shacl12.ids.portable_id" ;
        a slkg:Function ;
        rdfs:label "portable_id" ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/ids.py" ;
        slkg:hasParameter ns103:portable_id.param.vendor_root, ns103:portable_id.param.entry ;
        slkg:hasReturnValue ns103:portable_id.returns ;
        slkg:lineEnd 29 ;
        slkg:lineStart 19 ;
        slkg:signature "def portable_id(entry: ManifestEntry, vendor_root: Path) -> str" .

    ns103:portable_id.param.entry a slkg:Parameter ;
        rdfs:label "entry" ;
        slkg:annotationText "ManifestEntry" ;
        slkg:hasType ns4:tests.shacl.w3c_shacl12.manifest.ManifestEntry ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns103:portable_id.param.vendor_root a slkg:Parameter ;
        rdfs:label "vendor_root" ;
        slkg:annotationText "Path" ;
        slkg:hasType ns4:pathlib.Path ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns103:portable_id.returns a slkg:ReturnValue ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns4:__future__ a slkg:ExternalModule .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a slkg:ExternalType ;
        rdfs:label "str" ;
        rdfs:subClassOf slkg:Type .

    ns4:pathlib a slkg:ExternalModule .

    ns4:pathlib.Path dcterms:identifier "pathlib.Path" ;
        a slkg:ExternalType ;
        rdfs:label "Path" ;
        rdfs:subClassOf slkg:Type .

