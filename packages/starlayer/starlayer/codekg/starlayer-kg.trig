        a slkg:Function ;
        rdfs:comment """A TripleTerm is legal as a TriplePattern's subject/object but never
its predicate — RDF has always restricted predicate position to IRIs.
Construct this directly (rather than via the parser, which already
rejects it at parse time — see grammar12.py) to confirm the SHACL shape
itself would catch a malformed graph asserting this, not just the parser.""" ;
        rdfs:label "test_triple_term_as_predicate_of_triple_pattern_fails" ;
        slkg:calls ns72:prepare_query_12 ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        slkg:lineEnd 402 ;
