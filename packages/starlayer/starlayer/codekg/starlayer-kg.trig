    ns111:test_ntriples12.py dcterms:identifier "tests.graph.unit.test_ntriples12" ;
        a slkg:Module ;
        rdfs:comment """Unit tests for starlayer.graph.parsers.ntriples12.

Minimal coverage for the N-Triples 1.2 parser's own string-escape handling -
previously had no dedicated test file at all.""" ;
