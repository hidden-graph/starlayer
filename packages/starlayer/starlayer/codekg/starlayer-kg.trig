    ns31:StarLayerDataset.update dcterms:identifier "starlayer.graph.graph.starlayer_dataset.StarLayerDataset.update" ;
        a slkg:Method ;
        rdfs:comment """Execute a SPARQL UPDATE across named graphs with SPARQL-star support.

Triple-term patterns in WHERE clauses are rewritten to SPARQL 1.1
(rdf-1.1 backend only — see below). All cached per-graph registries
are rebuilt after execution so that newly added triple terms are
immediately visible.

Remote-store (Fuseki/Oxigraph) updates bypass rdflib's own
``Dataset(store=...).update()`` and go directly over HTTP instead
(see ``starlayer.graph.backends.native.native_update``), for both
backends: rdflib's ``SPARQLStore._is_contextual()`` treats any
string graph identifier other than the literal ``"__UNION__"`` as
needing a wrapping ``GRAPH { }`` block, so ``Dataset.update()``
would wrap the whole update text in an extra ``GRAPH { }`` block
that nests illegally around a plain ``INSERT DATA { GRAPH <uri>
{...} }`` against a real Oxigraph/Fuseki endpoint.

For the rdf-1.2 backend the update text is sent unmodified (the
endpoint understands ``<<( )>>`` natively); for rdf-1.1 it is
parsed and lowered to the tt:HASH encoding first (native_update
itself, via starlayer.sparql).""" ;
        rdfs:label "update" ;
        slkg:calls ns71:rdf11_to_update, ns41:contains_triple_term, ns72:prepare_update_12, ns3:check_version_conformance, ns38:native_update, ns38:_in_process, ns71:update_to_rdf11, ns41:strip_version_directive ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/starlayer_dataset.py" ;
        slkg:hasParameter ns31:StarLayerDataset.update.param.initBindings, ns31:StarLayerDataset.update.param.use_store_provided, ns31:StarLayerDataset.update.param.initNs, ns31:StarLayerDataset.update.param.kwargs, ns31:StarLayerDataset.update.param.processor, ns31:StarLayerDataset.update.param.update_object ;
        slkg:hasReturnValue ns31:StarLayerDataset.update.returns ;
        slkg:lineEnd 895 ;
        slkg:lineStart 824 ;
        slkg:signature "def update(self, update_object, processor='sparql', initNs=None, initBindings=None, use_store_provided=True, **kwargs) -> None" .

