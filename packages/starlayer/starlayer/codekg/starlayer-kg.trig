    ns102:clone_graph dcterms:identifier "tests.shacl.w3c_shacl12.manifest.clone_graph" ;
        a slkg:Function ;
        rdfs:comment """Return an independent copy of a StarLayerGraph.

``new_graph`` is the factory for the empty graph copied into - the default
in-memory ``StarLayerGraph`` unless a suite is being run through another
store (see stores.py).

Round-trips through the public ``.triples()`` view (real, decoded
TripleTerm values) and ``.add()`` (which re-encodes/re-registers them for
the new graph's own store), rather than a plain rdflib-level union -
needed because ``load_document`` caches and reuses graph objects for the
lifetime of the test session, and a self-contained fixture commonly
passes the *same* cached document as both data_graph and shacl_graph;
without an independent copy per role, a mutation validate() makes to one
role (e.g. target-type injection augmenting the shapes graph) could leak
into the other role or into a later test that reuses the same cached
document.""" ;
        rdfs:label "clone_graph" ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/manifest.py" ;
        slkg:hasParameter ns102:clone_graph.param.new_graph, ns102:clone_graph.param.source ;
        slkg:hasReturnValue ns102:clone_graph.returns ;
        slkg:lineEnd 98 ;
        slkg:lineStart 67 ;
        slkg:signature "def clone_graph(source: StarLayerGraph, new_graph=StarLayerGraph) -> StarLayerGraph" .

    ns102:clone_graph.param.new_graph a slkg:Parameter ;
        rdfs:label "new_graph" ;
        slkg:defaultValue "StarLayerGraph" ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns102:clone_graph.param.source a slkg:Parameter ;
        rdfs:label "source" ;
        slkg:annotationText "StarLayerGraph" ;
        slkg:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns102:clone_graph.returns a slkg:ReturnValue ;
        slkg:annotationText "StarLayerGraph" ;
        slkg:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

