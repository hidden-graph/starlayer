    ns115:test_debug_and_trace_severities_never_block_conforms dcterms:identifier "tests.shacl.integration.test_conformance_disallows.test_debug_and_trace_severities_never_block_conforms" ;
        a slkg:Function ;
        rdfs:comment """Found 2026-07-31 via the W3C SHACL 1.2 test suite's severity-004/
severity-005 fixtures: sh:Debug and sh:Trace are SHACL 1.2 Core's two
new severity levels, below sh:Warning - unlike sh:Warning/sh:Info
(which block sh:conforms *by default*, only excluded via
allow_warnings/allow_infos), sh:Debug/sh:Trace must never block
sh:conforms at all, unconditionally - regardless of any flag, since
pySHACL doesn't know they exist and so never puts them in the "allowed"
exception set the way it does for sh:Info/sh:Warning. The violation
itself must still be reported (present in sh:result, with the correct
sh:resultSeverity) - only the aggregate sh:conforms is affected.""" ;
        rdfs:label "test_debug_and_trace_severities_never_block_conforms" ;
        slkg:calls ns115:_shapes_with_severity, ns115:_data_with_bad_age ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_conformance_disallows.py" ;
        slkg:hasDecorator ns115:test_debug_and_trace_severities_never_block_conforms.decorator.0 ;
        slkg:hasParameter ns115:test_debug_and_trace_severities_never_block_conforms.param.severity ;
        slkg:hasReturnValue ns115:test_debug_and_trace_severities_never_block_conforms.returns ;
        slkg:lineEnd 120 ;
        slkg:lineStart 101 ;
        slkg:signature "def test_debug_and_trace_severities_never_block_conforms(severity: str) -> None" .

    ns115:test_debug_and_trace_severities_never_block_conforms.decorator.0 a slkg:Decorator ;
        slkg:decoratorText "pytest.mark.parametrize('severity', ['Debug', 'Trace'])" ;
        slkg:position 0 .

