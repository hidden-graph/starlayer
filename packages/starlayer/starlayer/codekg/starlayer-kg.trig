        slkg:calls ns7:term_key, ns7:tt_hash, ns7:remember_tt_hash ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        slkg:hasParameter ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.p, ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.o, ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.s ;
        slkg:isPrivate true ;
        slkg:lineEnd 96 ;
        slkg:lineStart 93 ;
        slkg:signature "def _make_tt_uri(s, p, o)" .

    ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.o a slkg:Parameter ;
        rdfs:label "o" ;
        slkg:parameterKind "positional" ;
        slkg:position 2 .

