            a sqe:Filter ;
            sqe:expr [
                a sqe:Exists ;
                sqe:negated true ;
                sqe:where ( [
                    a sqe:TriplePattern ;
                    sqe:object "f"^^spexpr:Variable ;
                    sqe:predicate slkg:calls ;
                    sqe:subject "t"^^spexpr:Variable
                ] [
                    a sqe:TriplePattern ;
                    sqe:object "testFile"^^spexpr:Variable ;
