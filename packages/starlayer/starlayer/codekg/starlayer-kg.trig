    ns17:_Preprocessor._append_term_component.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns17:_Preprocessor._emit_triple_term_block dcterms:identifier "starlayer.graph.parsers.rdfxml12._Preprocessor._emit_triple_term_block" ;
        a slkg:Method ;
        rdfs:comment """Append an rdf:TripleTerm intermediate block for (s, p, o) as a new
sibling node element; return its rdf:nodeID.""" ;
        rdfs:label "_emit_triple_term_block" ;
