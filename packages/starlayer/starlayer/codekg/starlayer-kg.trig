        slkg:signature "def test_base_relative_iri_resolution_survives_roundtrip()" .

    ns246:test_prefix_bindings_survive_roundtrip dcterms:identifier "tests.sparql.unit.test_phase4_prologue.test_prefix_bindings_survive_roundtrip" ;
        a slkg:Function ;
        rdfs:label "test_prefix_bindings_survive_roundtrip" ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_phase4_prologue.py" ;
        slkg:lineEnd 50 ;
        slkg:lineStart 42 ;
        slkg:signature "def test_prefix_bindings_survive_roundtrip()" .

    ns246:test_translate_algebra_output_unaffected_by_prologue dcterms:identifier "tests.sparql.unit.test_phase4_prologue.test_translate_algebra_output_unaffected_by_prologue" ;
