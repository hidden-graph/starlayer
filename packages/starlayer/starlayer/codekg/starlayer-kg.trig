    ns75:_annotate_conformance_disallows dcterms:identifier "starlayer.shacl.validator._annotate_conformance_disallows" ;
        a slkg:Function ;
        rdfs:comment """Add ``sh:conformanceDisallows`` to the report per SHACL 1.2 Core:
the set of severities whose presence makes ``sh:conforms`` false.
``sh:Violation`` is always disallowed; ``sh:Warning``/``sh:Info`` are
disallowed unless ``options['allow_warnings']``/``['allow_infos']``
is set, letting a caller opt into treating warning/info-level results
as non-blocking.

Also recomputes ``sh:conforms`` itself from the report's actual
result severities (rewriting the triple in ``report_graph`` to
match) rather than trusting pySHACL's own boolean as-is, since
pySHACL's default notion of conformance only ever considers
``sh:Violation``.""" ;
        rdfs:label "_annotate_conformance_disallows" ;
        slkg:calls ns75:_find_genuine_report_node ;
        slkg:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
        slkg:hasParameter ns75:_annotate_conformance_disallows.param.conforms, ns75:_annotate_conformance_disallows.param.report_graph, ns75:_annotate_conformance_disallows.param.options ;
        slkg:hasReturnValue ns75:_annotate_conformance_disallows.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 2595 ;
        slkg:lineStart 2549 ;
        slkg:signature "def _annotate_conformance_disallows(report_graph: Any, options: dict[str, Any], conforms: bool) -> bool" .

