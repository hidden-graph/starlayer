    ns278:_decompose dcterms:identifier "starlayer.graph.compare._decompose" ;
        a slkg:Function ;
        rdfs:comment """Return a plain ``rdflib.Graph`` with every triple term replaced by a
synthetic reification fragment - see module docstring for why this is
sufficient for correct isomorphism/canonicalization.""" ;
        rdfs:label "_decompose" ;
        slkg:calls ns278:_decompose._term, ns7:encode_dirlang_datatype ;
