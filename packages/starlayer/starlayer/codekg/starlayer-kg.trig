        slkg:filePath "packages/starlayer/starlayer/graph/parsers/rdfxml12.py" ;
        slkg:hasParameter ns17:_Preprocessor._emit_triple_term_block.param.s, ns17:_Preprocessor._emit_triple_term_block.param.p, ns17:_Preprocessor._emit_triple_term_block.param.o ;
        slkg:hasReturnValue ns17:_Preprocessor._emit_triple_term_block.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 264 ;
