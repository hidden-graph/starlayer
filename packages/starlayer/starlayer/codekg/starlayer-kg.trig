    ns236:TestCollectionElementLiteralCoercion dcterms:identifier "tests.graph.unit.test_turtle_parser.TestCollectionElementLiteralCoercion" ;
        a slkg:Class ;
        rdfs:comment """A bare numeric/boolean Turtle literal used as an RDF collection member
(e.g. "( 42 )") needs the same string->Python-value coercion an ordinary
(non-list) object already gets - previously only non-list objects were
coerced, so a bare literal *inside* a collection reached final term
conversion as a raw string and was rejected as an unrecognized term.""" ;
        rdfs:label "TestCollectionElementLiteralCoercion" ;
