        slkg:isPrivate true ;
        slkg:lineEnd 328 ;
        slkg:lineStart 323 ;
        slkg:signature "def _specification_graph(self, shapes_graph_iri, specification_iri)" .

    ns167:TestValidateSpecificationGraphParameter._specification_graph.param.shapes_graph_iri a slkg:Parameter ;
