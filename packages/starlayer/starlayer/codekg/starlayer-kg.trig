        slkg:hasParameter ns300:TestDirLangStringEquality.test_value_equality_aborts_the_process_known_engine_bug.param.query ;
        slkg:lineEnd 387 ;
        slkg:lineStart 367 ;
        slkg:signature "def test_value_equality_aborts_the_process_known_engine_bug(self, query)" .

