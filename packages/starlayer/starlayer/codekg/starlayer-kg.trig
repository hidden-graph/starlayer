        slkg:hasParameter ns70:_AlgebraTranslator12.convert_node_arg.param.node_arg ;
        slkg:hasReturnValue ns70:_AlgebraTranslator12.convert_node_arg.returns ;
        slkg:lineEnd 191 ;
        slkg:lineStart 158 ;
        slkg:signature "def convert_node_arg(self, node_arg)" .

    ns70:_AlgebraTranslator12.convert_node_arg.param.node_arg a slkg:Parameter ;
        rdfs:comment "The algebra node to render - an ordinary RDF term/Variable/Path, or any other value the base class's own ``convert_node_arg`` already handles." ;
        rdfs:label "node_arg" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

