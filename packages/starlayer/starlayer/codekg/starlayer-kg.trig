        sqe:projection ( "kind"^^spexpr:Variable "file"^^spexpr:Variable "line"^^spexpr:Variable "lineEnd"^^spexpr:Variable "signature"^^spexpr:Variable "summary"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
