        slkg:calls ns222:_canon, ns52:rdf_ast_to_query, ns56:query_ast_to_rdf ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_ast_ontology.py" ;
        slkg:hasDecorator ns222:test_ast_roundtrip_result_equivalence.decorator.0 ;
        slkg:hasParameter ns222:test_ast_roundtrip_result_equivalence.param.query_text, ns222:test_ast_roundtrip_result_equivalence.param.fixture_graph ;
        slkg:lineEnd 73 ;
        slkg:lineStart 61 ;
        slkg:signature "def test_ast_roundtrip_result_equivalence(fixture_graph, query_text)" .

    ns222:test_ast_roundtrip_result_equivalence.decorator.0 a slkg:Decorator ;
