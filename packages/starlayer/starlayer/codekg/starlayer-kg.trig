    ns178:test_sparql_constraint_own_severity_overrides_shape_severity dcterms:identifier "tests.shacl.integration.test_sparql_shacl_integration.test_sparql_constraint_own_severity_overrides_shape_severity" ;
        a slkg:Function ;
        rdfs:comment """Found 2026-07-31 via the W3C SHACL 1.2 test suite's sparql-001
fixture: sh:sparql's own constraint node (the value of sh:sparql,
distinct from the shape it's attached to) can carry its own
sh:severity, per the spec's SPARQL-based Constraints section - the same
way it already carries its own sh:message/sh:deactivated (both already
correctly read by pySHACL). pySHACL's own SPARQLBasedConstraint never
read sh:severity from that node, always reporting the shape's own
severity (sh:Violation by default here, since the shape itself has no
sh:severity override) regardless of what the constraint declares.""" ;
        rdfs:label "test_sparql_constraint_own_severity_overrides_shape_severity" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_sparql_shacl_integration.py" ;
        slkg:hasReturnValue ns178:test_sparql_constraint_own_severity_overrides_shape_severity.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 88 ;
        slkg:lineStart 46 ;
        slkg:signature "def test_sparql_constraint_own_severity_overrides_shape_severity() -> None" .

    ns178:test_sparql_constraint_own_severity_overrides_shape_severity.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns178:test_sparql_constraint_resolves_prefix_via_ambient_shapes_graph_declare dcterms:identifier "tests.shacl.integration.test_sparql_shacl_integration.test_sparql_constraint_resolves_prefix_via_ambient_shapes_graph_declare" ;
        a slkg:Function ;
        rdfs:comment """Found 2026-07-31 via the W3C SHACL 1.2 test suite's prefixes-002
fixture: with no explicit sh:prefixes reference on the sh:sparql
constraint at all, prefix resolution should still fall back to any
sh:ShapesGraph-typed node's own sh:declare, found anywhere in the
shapes graph (SHACL 1.2 Core). pySHACL's own
SPARQLQueryHelper.collect_prefixes() only ever consults such ambient
declares as an *addition* to an explicit sh:prefixes reference - if
that reference is absent, it returns immediately, never falling back to
ambient discovery at all. Deliberately does not also honor an
owl:Ontology-declared prefix the way the already-covered
explicit-sh:prefixes-reference case does - the fixture's own
owl:Ontology declares the same prefix letter mapped to a *different*,
wrong namespace as a deliberate distractor.""" ;
        rdfs:label "test_sparql_constraint_resolves_prefix_via_ambient_shapes_graph_declare" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_sparql_shacl_integration.py" ;
        slkg:hasReturnValue ns178:test_sparql_constraint_resolves_prefix_via_ambient_shapes_graph_declare.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 141 ;
        slkg:lineStart 91 ;
        slkg:signature "def test_sparql_constraint_resolves_prefix_via_ambient_shapes_graph_declare() -> None" .

    ns178:test_sparql_constraint_resolves_prefix_via_ambient_shapes_graph_declare.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns178:test_sparql_constraint_resolves_prefix_via_sh_declare_not_turtle_prefix dcterms:identifier "tests.shacl.integration.test_sparql_shacl_integration.test_sparql_constraint_resolves_prefix_via_sh_declare_not_turtle_prefix" ;
        a slkg:Function ;
        rdfs:comment """sh:declare/sh:prefixes (pyshacl/helper/sparql_query_helper.py::
SPARQLQueryHelper.collect_prefixes()) is a separate mechanism from
ordinary Turtle @prefix bindings - the SPARQL query text is just a
string literal as far as Turtle parsing is concerned, so a prefix used
only inside the query string must be resolved via sh:declare at query
time, not via any @prefix in the surrounding shapes-graph Turtle. This
shape deliberately declares no @prefix myex: at all.""" ;
        rdfs:label "test_sparql_constraint_resolves_prefix_via_sh_declare_not_turtle_prefix" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_sparql_shacl_integration.py" ;
        slkg:hasReturnValue ns178:test_sparql_constraint_resolves_prefix_via_sh_declare_not_turtle_prefix.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 277 ;
        slkg:lineStart 243 ;
        slkg:signature "def test_sparql_constraint_resolves_prefix_via_sh_declare_not_turtle_prefix() -> None" .

    ns178:test_sparql_constraint_resolves_prefix_via_sh_declare_not_turtle_prefix.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

