GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/shacl/ui_widget_selection.py> {
    ns74:ui_widget_selection.py dcterms:identifier "starlayer.shacl.ui_widget_selection" ;
        a slkg:Module ;
        rdfs:comment """SHACL 1.2 User Interfaces' widget *selection* algorithm
(``shui:WidgetScore``/``shui:WidgetAcceptMatcher``,
https://www.w3.org/TR/shacl12-ui/ Section 3 "Scoring System") - not a
pySHACL patch, new additive public surface built entirely on the existing
public ``starlayer.shacl.validate()``. The spec's own Matcher Function is
"two ordinary SHACL validations" (the shape node against a scoring-graph
shape, the focus node against a data-graph shape), confirmed via a direct
spec fetch - see ``docs/shacl/implementation-plan.md`` item 3 for the full
design history this module executes.

``shui:editor``/``shui:viewer`` annotations (compatibility, not selection)
are a separate, already-shipped concern - see
``starlayer.starontology``'s ``stsh:ShuiPredicateShapes`` and
``docs/guides/04d-shacl-ui.ipynb``.

**Deliberately tolerant of `shui:WidgetAcceptMatcher`'s own cardinality**:
as of the 2026-10-16 spec re-check, `shui:WidgetAcceptMatcher` has no
formal upstream shape at all (unlike `shui:WidgetScore`, which does - see
`starontology`'s own `stsh:WidgetScoreShape`), and is actively contested
upstream (w3c/data-shapes#1249, open/unmerged, proposing to change its
`shui:widget` cardinality from "exactly one" to "at least one"). This
module reads whatever `shui:widget`/`shui:dataGraphShape`/
`shui:shapesGraphShape` triples are actually present on a matcher node
directly, assuming no particular cardinality, so it tolerates either
reading without needing to change if/when that PR lands.""" ;
        rdfs:label "ui_widget_selection" ;
        slkg:declares ns308:select_widget, ns308:select_widgets, ns308:_find_matcher, ns308:_matcher_accepts, ns308:_node_conforms ;
        slkg:filePath "packages/starlayer/starlayer/shacl/ui_widget_selection.py" ;
        slkg:importsModule ns4:__future__, ns4:typing, ns4:rdflib .

    ns308:_find_matcher dcterms:identifier "starlayer.shacl.ui_widget_selection._find_matcher" ;
        a slkg:Function ;
        rdfs:comment """The ``shui:WidgetAcceptMatcher`` naming ``widget`` via its own
``shui:widget`` value(s), or ``None`` if ``widget`` has none - no
cardinality assumed on either side (see module docstring).""" ;
        rdfs:label "_find_matcher" ;
        slkg:filePath "packages/starlayer/starlayer/shacl/ui_widget_selection.py" ;
        slkg:hasParameter ns308:_find_matcher.param.scoring_graph, ns308:_find_matcher.param.widget ;
        slkg:hasReturnValue ns308:_find_matcher.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 68 ;
        slkg:lineStart 61 ;
        slkg:signature "def _find_matcher(widget: Any, scoring_graph: Any) -> Any | None" .

    ns308:_find_matcher.param.scoring_graph a slkg:Parameter ;
        rdfs:label "scoring_graph" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns308:_find_matcher.param.widget a slkg:Parameter ;
        rdfs:label "widget" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns308:_find_matcher.returns a slkg:ReturnValue ;
        slkg:annotationText "Any | None" ;
        slkg:hasType ns4:typing.Any ;
        slkg:optional true .

    ns308:_matcher_accepts dcterms:identifier "starlayer.shacl.ui_widget_selection._matcher_accepts" ;
        a slkg:Function ;
        rdfs:comment """Section 3.4 Matcher Function, step for step:

1. No focus node, a ``shui:dataGraphShape`` present and no
   ``shui:shapesGraphShape``: reject - the only condition cannot be checked.
2. The shape node is validated in the *shapes graph* against the
   matcher's ``shui:shapesGraphShape``, whose definition is read from the
   *scoring graph*. Reject on failure.
3. No focus node: accept.
4. The focus node is validated in the *data graph* against the
   matcher's ``shui:dataGraphShape``. The spec reads that shape from the
   shapes graph; the scoring graph is searched too, so a catalog that
   defines it alongside the matcher also works.""" ;
        rdfs:label "_matcher_accepts" ;
        slkg:calls ns308:_node_conforms ;
        slkg:filePath "packages/starlayer/starlayer/shacl/ui_widget_selection.py" ;
        slkg:hasParameter ns308:_matcher_accepts.param.focus_node, ns308:_matcher_accepts.param.shape_node, ns308:_matcher_accepts.param.scoring_graph, ns308:_matcher_accepts.param.matcher, ns308:_matcher_accepts.param.data_graph, ns308:_matcher_accepts.param.shapes_graph ;
        slkg:hasReturnValue ns308:_matcher_accepts.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:isPrivate true ;
        slkg:lineEnd 118 ;
        slkg:lineStart 71 ;
        slkg:signature "def _matcher_accepts(matcher: Any, *, shape_node: Any, focus_node: Any | None, data_graph: Any | None, shapes_graph: Any, scoring_graph: Any) -> bool" .

    ns308:_matcher_accepts.param.data_graph a slkg:Parameter ;
        rdfs:label "data_graph" ;
        slkg:annotationText "Any | None" ;
        slkg:hasType ns4:typing.Any ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 3 .

    ns308:_matcher_accepts.param.focus_node a slkg:Parameter ;
        rdfs:label "focus_node" ;
        slkg:annotationText "Any | None" ;
        slkg:hasType ns4:typing.Any ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 2 .

    ns308:_matcher_accepts.param.matcher a slkg:Parameter ;
        rdfs:label "matcher" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns308:_matcher_accepts.param.scoring_graph a slkg:Parameter ;
        rdfs:label "scoring_graph" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "kwonly" ;
        slkg:position 5 .

    ns308:_matcher_accepts.param.shape_node a slkg:Parameter ;
        rdfs:label "shape_node" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "kwonly" ;
        slkg:position 1 .

    ns308:_matcher_accepts.param.shapes_graph a slkg:Parameter ;
        rdfs:label "shapes_graph" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "kwonly" ;
        slkg:position 4 .

    ns308:_matcher_accepts.returns a slkg:ReturnValue ;
        slkg:annotationText "bool" ;
        slkg:hasType ns4:builtins.bool .

    ns308:_node_conforms dcterms:identifier "starlayer.shacl.ui_widget_selection._node_conforms" ;
        a slkg:Function ;
        rdfs:comment """True iff ``node`` (a resource in ``base_graph``) conforms to
``shape`` (a shape already defined somewhere in ``shapes_graph``) -
built by wrapping ``shape`` in a throwaway ``sh:targetNode``/``sh:node``
probe shape, rather than a private helper, so this stays on
``starlayer.shacl``'s own public surface only.""" ;
        rdfs:label "_node_conforms" ;
        slkg:calls ns75:validate ;
