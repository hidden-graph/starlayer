        slkg:position 0 .

    ns285:_dotted_name.returns a slkg:ReturnValue ;
        slkg:annotationText "str | None" ;
        slkg:hasType ns4:builtins.str ;
        slkg:optional true .

    ns285:_introspect dcterms:identifier "starlayer.codekg.extractor.types._introspect" ;
        a slkg:Function ;
        rdfs:comment """Resolve dotted path ``candidate`` to a real live object via
``importlib``: try progressively shorter dotted prefixes as a module
name until one actually imports, then ``getattr``-walk the remainder.

Raises (``ImportError``/``AttributeError``) if no prefix imports at
all, or if the remainder doesn't resolve once a module is found -
callers are expected to catch this and fall back gracefully, per
``resolve_type_name``'s own contract.""" ;
        rdfs:label "_introspect" ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/types.py" ;
        slkg:hasParameter ns285:_introspect.param.candidate ;
        slkg:hasReturnValue ns285:_introspect.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 179 ;
        slkg:lineStart 148 ;
        slkg:signature "def _introspect(candidate: str) -> object" .

    ns285:_introspect.param.candidate a slkg:Parameter ;
        rdfs:label "candidate" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns285:_introspect.returns a slkg:ReturnValue ;
