        slkg:annotationText "bool" ;
        slkg:hasType ns4:builtins.bool .

    ns317:new_graph dcterms:identifier "tests.graph.integration.test_blank_node_identity.new_graph" ;
        a slkg:Function ;
        rdfs:comment "A factory for a fresh, empty default-graph StarLayerGraph on the engine." ;
        rdfs:label "new_graph" ;
        slkg:calls ns317:_up, ns317:new_graph.clear ;
        slkg:declares ns317:new_graph.clear, ns317:new_graph.make ;
        slkg:filePath "packages/starlayer/tests/graph/integration/test_blank_node_identity.py" ;
        slkg:hasDecorator ns317:new_graph.decorator.0 ;
        slkg:hasParameter ns317:new_graph.param.request ;
