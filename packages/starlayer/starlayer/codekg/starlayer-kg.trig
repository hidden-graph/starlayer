GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/trig12.py> {
    ns11:trig12.py dcterms:identifier "starlayer.graph.parsers.trig12" ;
        a slkg:Module ;
        rdfs:comment """starlayer.graph.parsers.trig12

Parse TriG 1.2 text into triples, preserving or merging named-graph structure.

TriG 1.2 is Turtle 1.2 with optional ``GRAPH <name> { ... }`` blocks.  Each
block's content is Turtle 1.2, so this parser:

  1. Extracts PREFIX / @prefix declarations.
  2. Splits the document into graph blocks (default graph + each GRAPH block).
  3. Prepends the prefix declarations to each block's content.
  4. Parses each chunk as Turtle 1.2 via StarLayerTurtleParser.

Entry points:
    parse_trig12(text)        -> list of (s, p, o)            (merges all graphs)
    parse_trig12_named(text)  -> list of (graph_id, triples, namespaces)""" ;
        rdfs:label "trig12" ;
        slkg:declares ns21:parse_trig12_named, ns21:_resolve_graph_id, ns21:_mask_string_literals, ns21:_consume_balanced, ns21:_extract_prefix_lines, ns21:_extract_prefix_map, ns21:parse_trig12, ns21:_split_trig_blocks_with_ids, ns21:extract_version_directive, ns21:_split_trig_blocks ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:importsModule ns4:__future__, ns4:rdflib, ns4:re .

    ns21:_consume_balanced dcterms:identifier "starlayer.graph.parsers.trig12._consume_balanced" ;
        a slkg:Function ;
        rdfs:comment "Consume from text[start] (must be '{') to the matching '}', return (block, end)." ;
        rdfs:label "_consume_balanced" ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:_consume_balanced.param.text, ns21:_consume_balanced.param.start ;
        slkg:hasReturnValue ns21:_consume_balanced.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 107 ;
        slkg:lineStart 47 ;
        slkg:signature "def _consume_balanced(text: str, start: int) -> tuple[str, int]" .

    ns21:_consume_balanced.param.start a slkg:Parameter ;
        rdfs:label "start" ;
        slkg:annotationText "int" ;
        slkg:hasType ns4:builtins.int ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns21:_consume_balanced.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:_consume_balanced.returns a slkg:ReturnValue ;
        slkg:annotationText "tuple[str, int]" ;
        slkg:hasType ns4:builtins.tuple, ns4:builtins.str, ns4:builtins.int .

    ns21:_extract_prefix_lines dcterms:identifier "starlayer.graph.parsers.trig12._extract_prefix_lines" ;
        a slkg:Function ;
        rdfs:comment """Return a string of all @prefix / PREFIX declarations found in text.

Matches against a string-literal-masked copy of text (see
_mask_string_literals()), not text itself - a genuine declaration is
never inside a string literal, so it's completely unaffected by
masking, but text that merely *looks* like one inside a string's own
content (e.g. a docstring quoting "@prefix : <http://example.org/> .")
is masked away and correctly never matches.""" ;
        rdfs:label "_extract_prefix_lines" ;
        slkg:calls ns21:_mask_string_literals ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:_extract_prefix_lines.param.text ;
        slkg:hasReturnValue ns21:_extract_prefix_lines.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 164 ;
        slkg:lineStart 152 ;
        slkg:signature "def _extract_prefix_lines(text: str) -> str" .

    ns21:_extract_prefix_lines.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:_extract_prefix_lines.returns a slkg:ReturnValue ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns21:_extract_prefix_map dcterms:identifier "starlayer.graph.parsers.trig12._extract_prefix_map" ;
        a slkg:Function ;
        rdfs:comment """Return {prefix_str: namespace_uri} for all prefix declarations in
text. See _extract_prefix_lines() for why this matches against a
string-literal-masked copy rather than text itself.""" ;
        rdfs:label "_extract_prefix_map" ;
        slkg:calls ns21:_mask_string_literals ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:_extract_prefix_map.param.text ;
        slkg:hasReturnValue ns21:_extract_prefix_map.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 181 ;
        slkg:lineStart 167 ;
        slkg:signature "def _extract_prefix_map(text: str) -> dict[str, str]" .

    ns21:_extract_prefix_map.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:_extract_prefix_map.returns a slkg:ReturnValue ;
        slkg:annotationText "dict[str, str]" ;
        slkg:hasType ns4:builtins.dict, ns4:builtins.str .

    ns21:_mask_string_literals dcterms:identifier "starlayer.graph.parsers.trig12._mask_string_literals" ;
        a slkg:Function ;
        rdfs:comment """Return a same-length copy of text with the contents of every quoted
string literal (long or short) replaced by '#' filler (newlines left
untouched, so line-oriented matching elsewhere is unaffected).

Used to protect the regex-based structural scans below
(_GRAPH_BLOCK_RE, _PREFIX_RE, the prefix-map regex) from being fooled
by literal text that merely *looks* like a GRAPH block or a @prefix/
PREFIX declaration but is really just a string's own content - e.g. a
docstring that quotes "@prefix : <http://example.org/> ." as part of
its prose, or one that shows a literal "GRAPH <...> { ... }" example
(this module's own docstrings do both). Positions/length are
preserved so a match's span still slices correctly into the
*original*, unmasked text.""" ;
        rdfs:label "_mask_string_literals" ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:_mask_string_literals.param.text ;
        slkg:hasReturnValue ns21:_mask_string_literals.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 149 ;
        slkg:lineStart 110 ;
        slkg:signature "def _mask_string_literals(text: str) -> str" .

    ns21:_mask_string_literals.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:_mask_string_literals.returns a slkg:ReturnValue ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns21:_resolve_graph_id dcterms:identifier "starlayer.graph.parsers.trig12._resolve_graph_id" ;
        a slkg:Function ;
        rdfs:comment "Resolve a GRAPH identifier token (<IRI> or prefix:local) to a URIRef." ;
        rdfs:label "_resolve_graph_id" ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:_resolve_graph_id.param.prefix_map, ns21:_resolve_graph_id.param.token ;
        slkg:hasReturnValue ns21:_resolve_graph_id.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 195 ;
        slkg:lineStart 184 ;
        slkg:signature "def _resolve_graph_id(token: str, prefix_map: dict[str, str]) -> URIRef" .

    ns21:_resolve_graph_id.param.prefix_map a slkg:Parameter ;
        rdfs:label "prefix_map" ;
        slkg:annotationText "dict[str, str]" ;
        slkg:hasType ns4:builtins.dict, ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns21:_resolve_graph_id.param.token a slkg:Parameter ;
        rdfs:label "token" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:_resolve_graph_id.returns a slkg:ReturnValue ;
        slkg:annotationText "URIRef" ;
        slkg:hasType ns4:rdflib.term.URIRef .

    ns21:_split_trig_blocks dcterms:identifier "starlayer.graph.parsers.trig12._split_trig_blocks" ;
        a slkg:Function ;
        rdfs:comment """Split a TriG document into Turtle 1.2 chunks (merges all graphs).

Each chunk has the document's prefix declarations prepended so it can be
parsed independently by StarLayerTurtleParser.""" ;
        rdfs:label "_split_trig_blocks" ;
        slkg:calls ns21:_split_trig_blocks_with_ids ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:_split_trig_blocks.param.text ;
        slkg:hasReturnValue ns21:_split_trig_blocks.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 269 ;
        slkg:lineStart 263 ;
        slkg:signature "def _split_trig_blocks(text: str) -> list[str]" .

    ns21:_split_trig_blocks.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:_split_trig_blocks.returns a slkg:ReturnValue ;
        slkg:annotationText "list[str]" ;
        slkg:hasType ns4:builtins.str, ns4:builtins.list .

    ns21:_split_trig_blocks_with_ids dcterms:identifier "starlayer.graph.parsers.trig12._split_trig_blocks_with_ids" ;
        a slkg:Function ;
        rdfs:comment """Split a TriG document into (graph_id, turtle_chunk) pairs.

graph_id is None for the default graph, a URIRef for each named graph.
Each chunk has the document's prefix declarations prepended.""" ;
        rdfs:label "_split_trig_blocks_with_ids" ;
        slkg:calls ns21:_consume_balanced, ns21:_extract_prefix_lines, ns21:_extract_prefix_map, ns21:_resolve_graph_id, ns21:_mask_string_literals ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:_split_trig_blocks_with_ids.param.text ;
        slkg:hasReturnValue ns21:_split_trig_blocks_with_ids.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 260 ;
        slkg:lineStart 198 ;
        slkg:signature "def _split_trig_blocks_with_ids(text: str) -> list[tuple[URIRef | None, str]]" .

    ns21:_split_trig_blocks_with_ids.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:_split_trig_blocks_with_ids.returns a slkg:ReturnValue ;
        slkg:annotationText "list[tuple[URIRef | None, str]]" ;
        slkg:hasType ns4:rdflib.term.URIRef, ns4:builtins.tuple, ns4:builtins.str, ns4:builtins.list .

    ns21:extract_version_directive dcterms:identifier "starlayer.graph.parsers.trig12.extract_version_directive" ;
        a slkg:Function ;
        rdfs:comment """Return the document-level declared VERSION label, or None.

TriG's VERSION directive (if present) applies to the whole document, not
per-GRAPH-block - it must be the very first statement, before any
@prefix/PREFIX declaration or GRAPH block. Each per-block chunk handed to
StarLayerTurtleParser by _split_trig_blocks*() never includes this
leading directive as such (it either lands, stripped of significance,
in the default-graph chunk, or is absent from every GRAPH-block chunk
entirely), so callers need this dedicated top-level scan instead - see
StarLayerGraph.parse()/StarLayerDataset.parse()'s 'trig12' branches,
which use it for the RDF12ConformanceWarning check
(starlayer.graph.model.conformance). Reuses starlayer.graph.parsers.syntax's
existing statement splitter/classifier rather than duplicating that
grammar.""" ;
        rdfs:label "extract_version_directive" ;
        slkg:calls ns18:split_statements, ns18:classify_statement, ns18:extract_fields ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:extract_version_directive.param.text ;
        slkg:hasReturnValue ns21:extract_version_directive.returns ;
        slkg:lineEnd 303 ;
        slkg:lineStart 272 ;
        slkg:signature "def extract_version_directive(text: str) -> str | None" .

    ns21:extract_version_directive.param.text a slkg:Parameter ;
        rdfs:comment "The full TriG 1.2 document text." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:extract_version_directive.returns a slkg:ReturnValue ;
        rdfs:comment "The declared VERSION label (e.g. \"1.2\"), or None if the document's first statement isn't a VERSION directive." ;
        slkg:annotationText "str | None" ;
        slkg:hasType ns4:builtins.str ;
        slkg:optional true .

    ns21:parse_trig12 dcterms:identifier "starlayer.graph.parsers.trig12.parse_trig12" ;
        a slkg:Function ;
        rdfs:comment """Parse TriG 1.2 text; return list of (s, p, o) triples.

All named graphs are merged.  Returns tt:-encoded triples ready for
super().add() + _build_registry_from_store() (same pattern as turtle12).

Each block is parsed via its own, independent call to
_skolemize_encoding() - no cross-block coordination needed for anonymous
reifiers, since they're left as ordinary BNodes (globally unique per
instantiation, not numbered), unlike the old rr:N scheme this replaced.""" ;
        rdfs:label "parse_trig12" ;
        slkg:calls ns14:_skolemize_encoding, ns21:_split_trig_blocks ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:parse_trig12.param.text ;
        slkg:hasReturnValue ns21:parse_trig12.returns ;
        slkg:instantiates ns14:StarLayerTurtleParser ;
        slkg:lineEnd 336 ;
        slkg:lineStart 310 ;
        slkg:signature "def parse_trig12(text: str) -> list[tuple]" .

    ns21:parse_trig12.param.text a slkg:Parameter ;
        rdfs:comment "The TriG 1.2 document text to parse." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:parse_trig12.returns a slkg:ReturnValue ;
        rdfs:comment "A list of tt:-encoded (s, p, o) triples, all named graphs merged together with the default graph." ;
        slkg:annotationText "list[tuple]" ;
        slkg:hasType ns4:builtins.list, ns4:builtins.tuple .

    ns21:parse_trig12_named dcterms:identifier "starlayer.graph.parsers.trig12.parse_trig12_named" ;
        a slkg:Function ;
        rdfs:comment """Parse TriG 1.2 text; return per-graph data preserving named-graph structure.

Each graph block stays its own separate Graph (unlike parse_trig12(),
which merges them). No cross-block reifier-numbering coordination is
needed - see parse_trig12()'s docstring.""" ;
        rdfs:label "parse_trig12_named" ;
        slkg:calls ns14:_skolemize_encoding, ns21:_split_trig_blocks_with_ids ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        slkg:hasParameter ns21:parse_trig12_named.param.text ;
        slkg:hasReturnValue ns21:parse_trig12_named.returns ;
        slkg:instantiates ns14:StarLayerTurtleParser ;
        slkg:lineEnd 367 ;
        slkg:lineStart 339 ;
        slkg:signature "def parse_trig12_named(text: str) -> list[tuple[URIRef | None, list[tuple], list[tuple]]]" .

    ns21:parse_trig12_named.param.text a slkg:Parameter ;
        rdfs:comment "The TriG 1.2 document text to parse." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns21:parse_trig12_named.returns a slkg:ReturnValue ;
        rdfs:comment "A list of (graph_id, triples, namespaces) entries, one per graph block: graph_id is None for the default graph or a URIRef for a named graph; triples is a list of tt:-encoded (s, p, o) triples ready for Graph.add() + _build_registry_from_store(); namespaces is a list of (prefix, namespace) pairs declared in that block." ;
        slkg:annotationText "list[tuple[URIRef | None, list[tuple], list[tuple]]]" ;
        slkg:hasType ns4:builtins.list, ns4:rdflib.term.URIRef, ns4:builtins.tuple .

    ns4:__future__ a slkg:ExternalModule .

