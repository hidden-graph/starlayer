    ns338:normalise_oracle_noise dcterms:identifier "tests.starontology.manchester_conformance.helpers.normalise_oracle_noise" ;
        a slkg:Function ;
        rdfs:comment """Remove differences that come from how the OWL API writes RDF, not from parsing:

- ``owl:distinctMembers`` (OWL 1 name) is the same axiom as ``owl:members`` on ``owl:AllDifferent``.
- Language tags are case-insensitive (BCP 47); the oracle lower-cases them.
- The harness always creates an ontology named by its request IRI, so an ``owl:Ontology`` triple for
  it appears even when the document had no ``Ontology:`` IRI. Dropped unless ``other`` has it too.""" ;
        rdfs:label "normalise_oracle_noise" ;
        slkg:filePath "packages/starlayer/tests/starontology/manchester_conformance/helpers.py" ;
        slkg:hasParameter ns338:normalise_oracle_noise.param.graph, ns338:normalise_oracle_noise.param.other ;
        slkg:hasReturnValue ns338:normalise_oracle_noise.returns ;
        slkg:lineEnd 93 ;
        slkg:lineStart 76 ;
        slkg:signature "def normalise_oracle_noise(graph: Graph, *, other: Graph | None=None) -> Graph" .

    ns338:normalise_oracle_noise.param.graph a slkg:Parameter ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns338:normalise_oracle_noise.param.other a slkg:Parameter ;
        rdfs:label "other" ;
        slkg:annotationText "Graph | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 1 .

    ns338:normalise_oracle_noise.returns a slkg:ReturnValue ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph .

    ns338:owlapi_graph_from_golden dcterms:identifier "tests.starontology.manchester_conformance.helpers.owlapi_graph_from_golden" ;
        a slkg:Function ;
        rdfs:comment """The oracle's Turtle as a graph.

The harness sets the Turtle writer's default prefix to the ontology IRI (``http://example.org/o``),
which has no trailing ``#`` although the corpus declares ``Prefix: : <http://example.org/o#>``; the
writer's own ``###  http://example.org/o#p`` comments show it meant ``#``-terminated names. Without
this repair every name would differ from ours by a missing ``#`` for a reason unrelated to parsing.""" ;
        rdfs:label "owlapi_graph_from_golden" ;
        slkg:filePath "packages/starlayer/tests/starontology/manchester_conformance/helpers.py" ;
        slkg:hasParameter ns338:owlapi_graph_from_golden.param.golden ;
