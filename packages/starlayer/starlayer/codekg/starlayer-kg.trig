        rdfs:label "initNs" ;
        slkg:defaultValue "None" ;
        slkg:parameterKind "positional" ;
        slkg:position 3 .

    ns28:StarLayerGraph.query.param.kwargs a slkg:Parameter ;
        rdfs:label "kwargs" ;
        slkg:parameterKind "varkw" .

    ns28:StarLayerGraph.query.param.processor a slkg:Parameter ;
        rdfs:comment "Passed through to the underlying rdflib/native query call." ;
