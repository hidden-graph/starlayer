    ns152:test_closed_plain_boolean_parity_still_violates_on_unlisted_property dcterms:identifier "tests.shacl.integration.test_native_component_composition.test_closed_plain_boolean_parity_still_violates_on_unlisted_property" ;
        a slkg:Function ;
        rdfs:comment """Parity check for the non-extended case: plain boolean sh:closed
(not sh:ByTypes) must keep behaving exactly like pySHACL's own
ClosedConstraintComponent, since the new component fully replaces
pySHACL's dispatch entry for sh:closed/sh:ignoredProperties rather than
adding a second one alongside it. Confirmed byte-for-byte equivalent to
unregistered pySHACL's own behavior (including the well-known gotcha
that rdf:type itself gets closed off unless explicitly allowed).""" ;
        rdfs:label "test_closed_plain_boolean_parity_still_violates_on_unlisted_property" ;
        slkg:calls ns152:_validate, ns152:_violation_components ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_native_component_composition.py" ;
