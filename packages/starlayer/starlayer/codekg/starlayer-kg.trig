GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_dirlangstring.py> {
    ns111:test_dirlangstring.py dcterms:identifier "tests.graph.unit.test_dirlangstring" ;
        a slkg:Module ;
        rdfs:comment """Unit tests for rdf:dirLangString (RDF 1.2 base-direction-tagged literals).

Covers the DirLangString value type, StarLayerGraph read/write interception,
Turtle/N-Triples/N-Quads/TriG/RDF-XML/TriX/JSON-LD 1.2 parser and serializer
round-trips, and the SPARQL 1.2 base-direction functions.""" ;
        rdfs:label "test_dirlangstring" ;
        slkg:declares ns122:round_trip, ns122:ex, ns122:TestNTriples12, ns122:TestStarLayerGraphIntegration, ns122:TestTrig12, ns122:TestSparqlFunctions, ns122:TestDirLangStringType, ns122:TestNativeBackend, ns122:TestTurtle12, ns122:TestOtherFormats, ns122:TestEncodeDecode ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_dirlangstring.py" ;
        slkg:importsModule ns4:rdflib, ns4:pytest .

