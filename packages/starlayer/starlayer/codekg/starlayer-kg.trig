GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_shacl_shapes.py> {
    ns120:test_shacl_shapes.py dcterms:identifier "tests.sparql.unit.test_shacl_shapes" ;
        a slkg:Module ;
        rdfs:comment """SHACL shape tests for the Phase-1-core slice of the salg: vocabulary
(BGP/Filter/LeftJoin/Union + the SELECT wrapper) — see shapes.py.

Two directions get tested:

1. Every real Phase 1 query (imported from test_roundtrip.QUERIES, so this
   suite can't silently drift from what the encoder actually produces)
   encodes to a graph that *conforms*.
2. A handful of deliberately malformed graphs, built by mutating a valid
   encoded query, each *fail* validation for the specific structural reason
   the mutation introduces - not just "conforms is False somewhere".""" ;
        rdfs:label "test_shacl_shapes" ;
        slkg:declares ns181:test_quadsforgraph_graph_wrong_type_fails, ns181:test_expression_family_queries_conform, ns181:test_arithmetic_op_wrong_member_fails, ns181:test_dataset_clause_well_formed_conforms, ns181:test_relational_op_illegal_value_fails, ns181:test_valid_aggregate_queries_conform, ns181:test_join_missing_p2_fails, ns181:test_triple_pattern_subject_as_plain_literal_fails, ns181:test_aggregate_distinct_wrong_type_fails, ns181:test_modify_missing_both_delete_and_insert_fails, ns181:test_query_collection_of_valid_queries_conforms, ns181:test_triple_term_predicate_as_path_fails, ns181:test_insert_data_missing_triples_fails, ns181:test_expression_shape_rejects_untyped_blank_node, ns181:test_triple_term_missing_object_fails, ns181:test_valid_path_queries_conform, ns181:test_add_graph_with_three_elements_fails, ns181:test_top_level_slice_distinct_reduced_orderby_conform, ns181:test_union_p1_pointing_at_unrecognized_node_fails, ns181:test_project_pv_wrong_member_fails, ns181:test_graph_pattern_missing_p_fails, ns181:test_leftjoin_missing_p2_fails, ns181:test_service_term_wrong_nodekind_fails, ns181:test_aggregate_count_missing_vars_fails, ns181:test_clear_silent_wrong_datatype_fails, ns181:test_bogus_node_reused_as_p1_via_another_operator_still_fails, ns181:test_service_missing_term_fails, ns181:test_no_shape_recursion_warnings, ns181:test_slice_missing_start_fails, ns181:test_construct_missing_template_fails, ns181:test_extend_missing_var_fails, ns181:test_bind_extend_conforms, ns181:test_groupconcat_separator_wrong_nodekind_fails, ns181:_encode_simple_select, ns181:test_clear_graphiri_neither_term_nor_pystr_fails, ns181:test_graph_term_wrong_nodekind_fails, ns181:test_service_conforms, ns181:test_order_condition_order_wrong_datatype_fails, ns181:test_valid_rdf12_queries_conform, ns181:test_arithmetic_op_illegal_value_fails, ns181:test_expression_shape_relies_on_rdfs_reasoning_not_enumeration, ns181:test_dataset_clause_both_default_and_named_fails, ns181:t