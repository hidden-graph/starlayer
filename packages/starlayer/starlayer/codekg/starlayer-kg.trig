        slkg:filePath "packages/starlayer/starlayer/starontology/__init__.py" ;
        slkg:hasParameter ns94:get_resource_iri.param.name ;
        slkg:hasReturnValue ns94:get_resource_iri.returns ;
        slkg:lineEnd 642 ;
        slkg:lineStart 610 ;
