        slkg:hasReturnValue ns78:_eval_custom_function_call.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 267 ;
        slkg:lineStart 209 ;
        slkg:signature "def _eval_custom_function_call(expr: Any, call_predicates: set, registry: dict[Any, Any], focus_node: Any, data_graph: Any, sg: Any, recurse_depth: int) -> list[Any]" .

