    ns200:TestOntGraphDatasetAutoUnion dcterms:identifier "tests.shacl.integration.test_starlayergraph_dataset_input.TestOntGraphDatasetAutoUnion" ;
        a slkg:Class ;
        rdfs:comment """pySHACL's own native handling of a raw ``rdflib.Dataset`` passed as
``ont_graph`` forces ``default_union = True`` on it before use
(``pyshacl/validator.py``), regardless of how the caller constructed it -
unlike ``data_graph``/``shacl_graph``, which respect whatever
``default_union`` the caller set. starShacl's own normalization
(``starlayer.shacl/engine/normalization.py``) mirrors this exactly, so an
``ont_graph`` Dataset's named-graph content is never silently invisible
to inference just because the caller didn't explicitly opt into
``default_union=True``.""" ;
        rdfs:label "TestOntGraphDatasetAutoUnion" ;
        slkg:declares ns200:TestOntGraphDatasetAutoUnion.test_ont_graph_named_graph_content_visible_without_explicit_default_union ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_starlayergraph_dataset_input.py" ;
        slkg:lineEnd 143 ;
        slkg:lineStart 90 .

    ns200:TestOntGraphDatasetAutoUnion.test_ont_graph_named_graph_content_visible_without_explicit_default_union dcterms:identifier "tests.shacl.integration.test_starlayergraph_dataset_input.TestOntGraphDatasetAutoUnion.test_ont_graph_named_graph_content_visible_without_explicit_default_union" ;
