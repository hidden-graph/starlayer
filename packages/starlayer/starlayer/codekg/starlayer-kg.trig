GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_path_valued_property_pairs.py> {
    ns97:test_path_valued_property_pairs.py dcterms:identifier "tests.shacl.integration.test_path_valued_property_pairs" ;
