        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns32:_run_rustdl_subprocess.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns32:classify_owl_dl_rustdl dcterms:identifier "starlayer.graph.graph.owl_dl_rustdl.classify_owl_dl_rustdl" ;
        a slkg:Function ;
        rdfs:comment """Run OWL 2 DL classification (RustDL) over `graph`, returning
(before, delta) in the same shape classify_owl_dl() (engine="hermit")
returns, so infer()'s mode="full"/"delta"/"in-place" branches treat
both engines uniformly without knowing which one ran.

Raises InconsistentOntologyError if the data is logically inconsistent.
See this module's own docstring for what RustDL does and doesn't
guarantee relative to engine="hermit" - notably, forced *property*
assignments derived only through disjunctive reasoning (no search)
won't reproduce the same way this engine did under HermiT.""" ;
        rdfs:label "classify_owl_dl_rustdl" ;
        slkg:calls ns32:_require_rustdl, ns26:run_with_timeout, ns30:_complete_type_closure, ns278:_decompose, ns32:_check_rustdl_hang_risk, ns32:_infer_missing_owl_types ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/owl_dl_rustdl.py" ;
        slkg:hasParameter ns32:classify_owl_dl_rustdl.param.timeout, ns32:classify_owl_dl_rustdl.param.graph ;
        slkg:hasReturnValue ns32:classify_owl_dl_rustdl.returns ;
        slkg:instantiates ns30:InconsistentOntologyError ;
        slkg:lineEnd 335 ;
        slkg:lineStart 253 ;
        slkg:signature "def classify_owl_dl_rustdl(graph, timeout: float | None=_timeout.DEFAULT_TIMEOUT_SECONDS)" .

    ns32:classify_owl_dl_rustdl.param.graph a slkg:Parameter ;
        rdfs:comment "The graph to classify." ;
        rdfs:label "graph" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns32:classify_owl_dl_rustdl.param.timeout a slkg:Parameter ;
        rdfs:comment "Wall-clock budget in seconds for the actual RustDL call (default `_timeout.DEFAULT_TIMEOUT_SECONDS`, 120s) - defense-in-depth for any hang pattern other than the one `_check_rustdl_hang_risk()` already catches pre-flight (point 4 of this module's own docstring). Pass `None` to disable entirely. See `classify_owl_dl()`'s own docstring / `_timeout.py`'s module docstring for the full rationale, shared between both engines." ;
        rdfs:label "timeout" ;
        slkg:annotationText "float | None" ;
        slkg:defaultValue "_timeout.DEFAULT_TIMEOUT_SECONDS" ;
        slkg:hasType ns4:builtins.float ;
