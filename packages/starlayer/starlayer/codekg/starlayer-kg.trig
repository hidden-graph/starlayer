    ns27:_close_shape dcterms:identifier "starlayer.graph.graph.shape_derivation._close_shape" ;
        a slkg:Function ;
        rdfs:comment """Set sh:closed true + sh:ignoredProperties directly - two triples,
no recursive walk needed. Deliberately not starlayer.shacl.close_shape():
that function's value is walking sh:node/sh:qualifiedValueShape/logical-
connective nesting to find every shape that also needs closing, and
derive_shape()'s own output never has any (sh:class only, never sh:node -
see module docstring) - there's nothing for that walk to find beyond
the one flat shape being closed directly here.""" ;
