        slkg:position 0 .

    ns337:test_matches_owlapi.decorator.1 a slkg:Decorator ;
        slkg:decoratorText "pytest.mark.parametrize('case', GOLDEN_CASES, ids=lambda c: c.id)" ;
        slkg:position 1 .

    ns337:test_matches_owlapi.param.case a slkg:Parameter ;
        rdfs:label "case" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns337:test_matches_owlapi.param.request a slkg:Parameter ;
        rdfs:label "request" ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

