        slkg:lineEnd 222 ;
        slkg:lineStart 193 ;
        slkg:signature "def translateAlgebra(self) -> str" .

    ns70:_AlgebraTranslator12.translateAlgebra.returns a slkg:ReturnValue ;
        rdfs:comment "The final SPARQL query text, with no unresolved ``-*-SELECT-*-``/``{GroupBy}``/``{Having}`` placeholders left in it regardless of whether the query contains a BGP." ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns70:_dirlang_n3 dcterms:identifier "starlayer.sparql.serialize12._dirlang_n3" ;
        a slkg:Function ;
        rdfs:comment """The real ``"text"@lang--dir`` SPARQL 1.2 syntax for `term`, if it's a
Literal using this project's own ``dirlang:`` datatype encoding (see
``_grammar12.py``'s ``LangDirLiteral`` for why that encoding is used at
all in the algebra in the first place - rdflib's own ``Literal`` can't
hold ``lang="en--rtl"`` directly, so a plain ``term.n3()`` would emit
the *internal* encoding datatype IRI verbatim - syntactically valid
SPARQL, but a real, different, wrong literal value once sent to a real
RDF 1.2 endpoint, not the base-direction string it's supposed to mean).""" ;
        rdfs:label "_dirlang_n3" ;
        slkg:calls ns55:decode_dirlang_datatype ;
        slkg:filePath "packages/starlayer/starlayer/sparql/serialize12.py" ;
        slkg:hasParameter ns70:_dirlang_n3.param.term ;
        slkg:hasReturnValue ns70:_dirlang_n3.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 96 ;
        slkg:lineStart 71 ;
        slkg:signature "def _dirlang_n3(term) -> str | None" .

    ns70:_dirlang_n3.param.term a slkg:Parameter ;
        rdfs:comment "The algebra node to check - any term type is accepted, since callers invoke this unconditionally before falling back to their own ordinary rendering." ;
        rdfs:label "term" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns70:_dirlang_n3.returns a slkg:ReturnValue ;
        rdfs:comment "The ``\"text\"@lang--dir`` syntax, or ``None`` for any other term, so callers fall through to the ordinary ``term.n3()`` path unchanged." ;
        slkg:annotationText "str | None" ;
        slkg:hasType ns4:builtins.str ;
        slkg:optional true .

    ns70:_term_text dcterms:identifier "starlayer.sparql.serialize12._term_text" ;
        a slkg:Function ;
        rdfs:comment """``.n3()`` for an ordinary RDF term/Variable/Path; ``<<( s p o )>>`` —
built recursively, so a nested triple term renders correctly too — for
a ``TripleTermNode``; ``"text"@lang--dir`` for a dirlang-encoded
Literal (see ``_dirlang_n3``).""" ;
        rdfs:label "_term_text" ;
        slkg:calls ns70:_term_text, ns70:_dirlang_n3 ;
        slkg:filePath "packages/starlayer/starlayer/sparql/serialize12.py" ;
        slkg:hasParameter ns70:_term_text.param.term ;
        slkg:hasReturnValue ns70:_term_text.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 117 ;
        slkg:lineStart 99 ;
        slkg:signature "def _term_text(term) -> str" .

    ns70:_term_text.param.term a slkg:Parameter ;
        rdfs:label "term" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns70:_term_text.returns a slkg:ReturnValue ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns70:_translate_algebra_12 dcterms:identifier "starlayer.sparql.serialize12._translate_algebra_12" ;
        a slkg:Function ;
        rdfs:comment """SPARQL 1.2 counterpart to rdflib's ``algebra.translateAlgebra`` —
turns a ``Query`` whose algebra may contain ``TripleTermNode`` nodes
back into SPARQL 1.2 query text, emitting ``<<( s p o )>>`` syntax for
each one. Full IRIs only, never prefixed names, for the same reason as
``translateAlgebra`` itself: ``query.prologue`` is never read by this
machinery — see CLAUDE.md finding #3.

Private (was ``translate_algebra_12``, public, until 2026-10-06): it
has zero real production callers, internal or external - every use is
a test file exercising it as a text-roundtrip correctness oracle (W3C
conformance suite, adversarial roundtrip). Even this project's own
"give me real text" path (``lower_rdf11.rdf11_to_sparql11_text``)
deliberately bypasses it in favor of plain rdflib ``translateAlgebra``,
since production code never needs the 1.2-specific triple-term/
dirLangString handling this function exists for - parse-edit-
reserialize a SPARQL 1.2 query's *algebra* back to *text* isn't a real
workflow this project has, or needs.""" ;
        rdfs:label "_translate_algebra_12" ;
        slkg:filePath "packages/starlayer/starlayer/sparql/serialize12.py" ;
        slkg:hasParameter ns70:_translate_algebra_12.param.query ;
        slkg:hasReturnValue ns70:_translate_algebra_12.returns ;
        slkg:instantiates ns70:_AlgebraTranslator12 ;
        slkg:isPrivate true ;
        slkg:lineEnd 531 ;
        slkg:lineStart 513 ;
        slkg:signature "def _translate_algebra_12(query: Query) -> str" .

    ns70:_translate_algebra_12.param.query a slkg:Parameter ;
        rdfs:label "query" ;
        slkg:annotationText "Query" ;
        slkg:hasType ns4:rdflib.plugins.sparql.sparql.Query ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns70:_translate_algebra_12.returns a slkg:ReturnValue ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

