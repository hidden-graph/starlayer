        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "kwonly" ;
        slkg:position 5 .

    ns280:StarQuery.__init__.param.initBindings a slkg:Parameter ;
        rdfs:comment "Initial variable bindings, bound once." ;
        rdfs:label "initBindings" ;
        slkg:annotationText "Mapping[str, Any] | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:builtins.str, ns4:typing.Any, ns4:collections.abc.Mapping ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 3 .

    ns280:StarQuery.__init__.param.initNs a slkg:Parameter ;
        rdfs:comment "Namespace bindings for the query - bound once here rather than repeated on every :meth:`run` call." ;
        rdfs:label "initNs" ;
        slkg:annotationText "Mapping[str, Any] | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:typing.Any, ns4:collections.abc.Mapping, ns4:builtins.str ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 2 .

    ns280:StarQuery.__init__.param.text a slkg:Parameter ;
        rdfs:comment "The SPARQL query text (SPARQL 1.2, including RDF 1.2 triple-term/annotation syntax)." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns280:StarQuery.__init__.param.timeout a slkg:Parameter ;
        rdfs:comment "Passed through to ``StarLayerGraph.query()``. Left unset by default (the sentinel below), in which case ``StarLayerGraph.query()``'s own default is used instead of this module duplicating that default's actual value." ;
        rdfs:label "timeout" ;
        slkg:annotationText "Any" ;
        slkg:defaultValue "_TIMEOUT_NOT_BOUND" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "kwonly" ;
        slkg:position 7 .

    ns280:StarQuery.__init__.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns280:StarQuery.run dcterms:identifier "starlayer.sparql.star_query.StarQuery.run" ;
        a slkg:Method ;
        rdfs:comment """Run the bound query against ``graph``.

Any option bound at construction can be overridden for just this
one call via ``**overrides`` - the bound value itself is never
changed.""" ;
        rdfs:label "run" ;
        slkg:filePath "packages/starlayer/starlayer/sparql/star_query.py" ;
        slkg:hasParameter ns280:StarQuery.run.param.graph, ns280:StarQuery.run.param.overrides ;
        slkg:hasReturnValue ns280:StarQuery.run.returns ;
        slkg:lineEnd 155 ;
        slkg:lineStart 114 ;
        slkg:signature "def run(self, graph: Any, **overrides: Any) -> Result" .

    ns280:StarQuery.run.param.graph a slkg:Parameter ;
        rdfs:comment "The graph to query (a ``StarLayerGraph``, or anything else ``StarLayerGraph.query()``'s own ``query_object`` parameter already accepts a prepared ``Query`` against). ``infer``/``engine``/``timeout``/``processor``/``result``/ ``use_store_provided``, overriding the bound value (or ``StarLayerGraph.query()``'s own default) for this call only." ;
        rdfs:label "graph" ;
