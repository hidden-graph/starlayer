    ns209:TestParseQueryNestedTripleTermInObjectPosition.test_outer_object_is_triple_term dcterms:identifier "tests.graph.unit.test_sparql12_parse.TestParseQueryNestedTripleTermInObjectPosition.test_outer_object_is_triple_term" ;
        a slkg:Method ;
        rdfs:label "test_outer_object_is_triple_term" ;
