    ns111:test_dataset.py dcterms:identifier "tests.graph.unit.test_dataset" ;
        a slkg:Module ;
        rdfs:comment """Unit tests for StarLayerDataset.

Covers: multi-graph TriG 1.2 parsing, named-graph context access,
quad iteration, TriG 1.2 / N-Quads 1.2 serialization, and round-trip.""" ;
        rdfs:label "test_dataset" ;
        slkg:declares ns143:TestContextAPI, ns143:TestDatasetStoreLifecycle, ns143:TestDefaultUnionPropagation, ns143:TestQuads, ns143:TestSerialize, ns143:TestSkolemizeDeskolemize, ns143:TestDatasetWideReifiers, ns143:TestSerializeSingleGraphFormats, ns143:TestCBD, ns143:TestRoundTrip, ns143:TestChainingContractMatchesRdflib, ns143:TestParseTriG12, ns143:TestRawCacheInvalidation, ns143:TestToGraph, ns143:TestConstruction, ns143:TestNQ12MultiGraph, ns143:TestDefaultGraphIsAStarLayerGraph, ns143:TestSingleDocumentFormatsParseIntoDefaultGraph, ns143:ex, ns143:TestTriplesChoicesRestoresTripleTerms ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_dataset.py" ;
        slkg:importsModule ns4:pytest, ns4:rdflib .

    ns143:TestCBD dcterms:identifier "tests.graph.unit.test_dataset.TestCBD" ;
        a slkg:Class ;
        rdfs:comment """Without StarLayerDataset's own cbd() override, rdflib's inherited
Graph.cbd() hardcodes a plain rdflib.Graph() as the default target -
previously a real, undiscovered bug: it crashed the moment the CBD'd
data contained a real TripleTerm, since plain Graph.add() asserts its
object is an rdflib Node, which TripleTerm is not. The override mirrors
StarLayerGraph.cbd()'s own pattern exactly (default target_graph to a
new StarLayerGraph, reject a plain Graph passed explicitly).""" ;
        rdfs:label "TestCBD" ;
        slkg:declares ns143:TestCBD.test_cbd_rejects_a_plain_rdflib_graph_as_target, ns143:TestCBD.test_cbd_scoped_by_default_union_like_triples, ns143:TestCBD.test_cbd_with_triple_term_does_not_crash_and_preserves_it ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_dataset.py" ;
        slkg:lineEnd 439 ;
        slkg:lineStart 388 .

    ns143:TestCBD.test_cbd_rejects_a_plain_rdflib_graph_as_target dcterms:identifier "tests.graph.unit.test_dataset.TestCBD.test_cbd_rejects_a_plain_rdflib_graph_as_target" ;
        a slkg:Method ;
        rdfs:label "test_cbd_rejects_a_plain_rdflib_graph_as_target" ;
        slkg:calls ns143:ex ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_dataset.py" ;
        slkg:lineEnd 418 ;
        slkg:lineStart 408 ;
        slkg:signature "def test_cbd_rejects_a_plain_rdflib_graph_as_target(self)" .

    ns143:TestCBD.test_cbd_scoped_by_default_union_like_triples dcterms:identifier "tests.graph.unit.test_dataset.TestCBD.test_cbd_scoped_by_default_union_like_triples" ;
        a slkg:Method ;
        rdfs:comment """cbd() delegates internally to self.triples()/self.subjects(),
so it inherits the same default_union scoping those honor - a
blank node's own data living in a different named graph is only
pulled in when default_union=True.""" ;
        rdfs:label "test_cbd_scoped_by_default_union_like_triples" ;
        slkg:calls ns143:ex ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_dataset.py" ;
        slkg:lineEnd 439 ;
        slkg:lineStart 420 ;
        slkg:signature "def test_cbd_scoped_by_default_union_like_triples(self)" .

