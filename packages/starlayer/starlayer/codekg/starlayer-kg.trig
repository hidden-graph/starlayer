        slkg:hasParameter ns308:_node_conforms.param.base_graph, ns308:_node_conforms.param.shape, ns308:_node_conforms.param.node, ns308:_node_conforms.param.shapes_graph ;
        slkg:hasReturnValue ns308:_node_conforms.returns ;
