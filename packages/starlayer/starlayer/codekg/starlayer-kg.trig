    ns140:TestLogicalConstraints dcterms:identifier "tests.shacl.integration.test_extract_subgraph.TestLogicalConstraints" ;
        a slkg:Class ;
        rdfs:comment """Decision 3 (revised): sh:or includes *every* disjunct that passes -
not just the first in list order, since sh:or only requires at least
one to pass and more than one may legitimately conform at once. sh:xone
includes just the one that passes, since sh:xone requires *exactly*
one - not an arbitrary determinism choice, but the only value that can
ever legitimately exist (see test_sh_xone below for the consequence
when data later makes a second disjunct pass too).""" ;
        rdfs:label "TestLogicalConstraints" ;
        slkg:declares ns140:TestLogicalConstraints.test_sh_or_includes_every_passing_branch, ns140:TestLogicalConstraints.test_sh_or_excludes_the_failing_branch, ns140:TestLogicalConstraints.test_sh_xone_second_passing_branch_breaks_conformance, ns140:TestLogicalConstraints.test_sh_xone_includes_the_one_passing_branch ;
