    ns300:TestEmbeddedCloseReopen dcterms:identifier "tests.graph.integration.test_oxigraph_store_rdf12.TestEmbeddedCloseReopen" ;
        a slkg:Class ;
        rdfs:comment """EmbeddedOxigraphStore.close() must actually release pyoxigraph's
RocksDB single-writer lock, not just no-op - confirmed live elsewhere
this session that the lock is held for the Store object's own lifetime,
released only on GC, with no close() on pyoxigraph's own Store at all.
A silent no-op here would make this test hang or raise
intermittently (GC-timing-dependent), not reliably.""" ;
        rdfs:label "TestEmbeddedCloseReopen" ;
        slkg:declares ns300:TestEmbeddedCloseReopen.test_close_releases_lock_for_reopen_on_same_path ;
        slkg:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_store_rdf12.py" ;
