GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_node_by_expression.py> {
    ns97:test_node_by_expression.py dcterms:identifier "tests.shacl.integration.test_node_by_expression" ;
        a slkg:Module ;
        rdfs:comment """sh:nodeByExpression (SHACL 1.2 Core): like sh:node, but the referenced
shape is computed via a node expression rather than given directly. Found
missing entirely via the W3C SHACL 1.2 test suite's nodeByExpression-001
fixtures (at both node-shape and property-shape level) - pySHACL has no
notion of this predicate at all.""" ;
        rdfs:label "test_node_by_expression" ;
        slkg:declares ns225:test_node_by_expression_at_property_shape_violates_when_value_does_not_conform, ns225:test_node_by_expression_conforms_when_value_conforms, ns225:test_node_by_expression_at_node_shape_violates_when_value_does_not_conform ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_node_by_expression.py" ;
        slkg:importsModule ns4:rdflib, ns4:pytest .

    ns225:test_node_by_expression_at_node_shape_violates_when_value_does_not_conform dcterms:identifier "tests.shacl.integration.test_node_by_expression.test_node_by_expression_at_node_shape_violates_when_value_does_not_conform" ;
        a slkg:Function ;
