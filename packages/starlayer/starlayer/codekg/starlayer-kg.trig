    ns76:register_native_components dcterms:identifier "starlayer.shacl.native_components.register_native_components" ;
        a slkg:Function ;
        rdfs:comment """Register starShacl's SHACL 1.2 native constraint components into
pySHACL's own dispatch map.

Idempotent - safe to call many times, only registers once per process.
Mutates ``CONSTRAINT_PARAMETERS_MAP``/``ALL_CONSTRAINT_COMPONENTS``/
``ALL_CONSTRAINT_PARAMETERS`` *in place* rather than rebinding them:
``pyshacl/shape.py``'s ``Shape.validate()`` lazily caches a reference to
these same list/dict objects the first time it runs in a process
(``module.CONSTRAINT_PARAMS``); in-place mutation stays visible through
that cache, reassignment would not.""" ;
        rdfs:label "register_native_components" ;
        slkg:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        slkg:hasReturnValue ns76:register_native_components.returns ;
        slkg:lineEnd 128 ;
        slkg:lineStart 88 ;
        slkg:signature "def register_native_components() -> None" .

    ns76:register_native_components.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns76:shape_reference_nodes dcterms:identifier "starlayer.shacl.native_components.shape_reference_nodes" ;
        a slkg:Function ;
        rdfs:comment """Resolve a SHAPE_EXPECTING_PREDICATES value to the actual shape
node(s) it references.

Most of these predicates (``sh:someValue``, ``sh:memberShape``,
``sh:reifierShape``) take a single shape reference directly, but
``sh:condition`` also accepts a SHACL list of shape references
(``SHACLRule.get_conditions()``) - if ``value`` is itself a well-formed
SHACL list (has ``rdf:first``), its members are the real references and
``value`` itself is not a shape at all.""" ;
        rdfs:label "shape_reference_nodes" ;
        slkg:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
