        slkg:signature "def test_does_not_entail_universal_rdfs_resource_typing(self)" .

    ns144:TestDomainAndRange dcterms:identifier "tests.sparql.unit.test_entailment_rdfs.TestDomainAndRange" ;
        a slkg:Class ;
        rdfs:label "TestDomainAndRange" ;
        slkg:declares ns144:TestDomainAndRange.test_domain_composes_with_subclass_chain, ns144:TestDomainAndRange.test_range_entailment, ns144:TestDomainAndRange.test_domain_entailment ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_entailment_rdfs.py" ;
