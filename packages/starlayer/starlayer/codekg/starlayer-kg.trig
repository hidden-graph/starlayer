    ns31:StarLayerDataset.__len__ dcterms:identifier "starlayer.graph.graph.starlayer_dataset.StarLayerDataset.__len__" ;
        a slkg:Method ;
        rdfs:comment """Total triple count across the entire dataset (default graph plus
every named graph).

The native backend needs its own override: SPARQLStore.__len__
(context=None) - what the inherited Dataset.__len__ calls - only
counts the endpoint's true default graph, so named-graph content
would otherwise be silently excluded. This runs a UNION-based
SPARQL COUNT query instead, covering both the default graph and
every named graph.""" ;
        rdfs:label "__len__" ;
        slkg:calls ns38:execute_select ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/starlayer_dataset.py" ;
