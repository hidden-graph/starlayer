        slkg:position 0 .

    ns90:TripleTermAdapter._decode_node.returns a slkg:ReturnValue ;
        rdfs:comment "The decoded value, always a ``term_factory`` instance for a decoded triple term (never a plain tuple) - see ``_decode_node_for_graph()`` for the target-graph-aware variant that can return a tuple instead." ;
        slkg:annotationText "Any" ;
