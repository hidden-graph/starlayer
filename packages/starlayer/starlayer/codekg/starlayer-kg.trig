        rdfs:comment "A `(graph, root)` tuple - the RDF graph for the lowered 1.1 update, and the node for its root." ;
        slkg:annotationText "tuple[Graph, URIRef]" ;
        slkg:hasType ns4:rdflib.term.URIRef, ns4:builtins.tuple, ns4:rdflib.graph.Graph .

