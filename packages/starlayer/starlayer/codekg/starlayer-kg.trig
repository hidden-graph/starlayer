        slkg:annotationText "None" ;
        slkg:optional true .

    ns183:test_without_expected_predicate_default_value_is_never_materialized dcterms:identifier "tests.shacl.integration.test_expected_predicate.test_without_expected_predicate_default_value_is_never_materialized" ;
        a slkg:Function ;
        rdfs:comment """Same shapes minus sh:expectedPredicate - proves the feature is doing
