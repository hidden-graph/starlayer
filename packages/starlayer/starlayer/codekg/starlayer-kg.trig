    ns67:sqe_parse_to_tree dcterms:identifier "starlayer.sparql.sqe.to_rdf.sqe_parse_to_tree" ;
        a slkg:Function ;
        rdfs:comment """Encode SPARQL ``SELECT``/``ASK``/``CONSTRUCT`` query text as
``sqe:`` RDF, and validate the result. The one public encoding entry
point - parses ``text`` with the same ``parseQuery`` every other
SPARQL 1.2 entry point in this package uses, delegates to
``_query_to_sqe_rdf`` below, then validates via :func:`sqe_validate`
before returning - a caller only ever gets back a tree already
confirmed to satisfy ``sqe:``'s own shapes (including the
unbound-projected-variable check), never one silently known to fail.

Validation only runs here, at creation time - it has no way to see,
and does not re-run for, any edit made to the tree afterward (see
the guide notebook's own section on this). Call :func:`sqe_validate`
yourself again after editing a tree directly.""" ;
        rdfs:label "sqe_parse_to_tree" ;
        slkg:calls ns67:_query_to_sqe_rdf, ns69:sqe_validate, ns72:parse_query_12 ;
        slkg:filePath "packages/starlayer/starlayer/sparql/sqe/to_rdf.py" ;
        slkg:hasParameter ns67:sqe_parse_to_tree.param.graph, ns67:sqe_parse_to_tree.param.text, ns67:sqe_parse_to_tree.param.root ;
        slkg:hasReturnValue ns67:sqe_parse_to_tree.returns ;
        slkg:instantiates ns67:SQEValidationError ;
        slkg:lineEnd 241 ;
        slkg:lineStart 186 ;
        slkg:signature "def sqe_parse_to_tree(text: str, graph: Graph | None=None, root: IdentifiedNode | None=None) -> tuple[Graph, IdentifiedNode]" .

    ns67:sqe_parse_to_tree.param.graph a slkg:Parameter ;
        rdfs:comment "The graph to add the ``sqe:`` RDF to. Defaults to a fresh ``StarLayerGraph`` (see ``to_rdf._new_starlayer_graph``)." ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:optional true ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns67:sqe_parse_to_tree.param.root a slkg:Parameter ;
        rdfs:comment "The node to use as the query's own root - any ``URIRef``/ ``BNode``. Defaults to a fresh ``BNode()``. Give a real ``URIRef`` to make the query findable by that identity later (e.g. ``graph.value(my_iri, RDF.type, SQE.Query)``), rather than only via the ``root`` value this function itself returns - useful once a graph accumulates more than one encoded query (via repeated calls sharing one ``graph=``), where a bare `?s a sqe:Query` lookup can no longer tell them apart on its own." ;
        rdfs:label "root" ;
        slkg:annotationText "IdentifiedNode | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:rdflib.term.IdentifiedNode ;
        slkg:optional true ;
        slkg:parameterKind "positional" ;
        slkg:position 2 .

    ns67:sqe_parse_to_tree.param.text a slkg:Parameter ;
        rdfs:comment "The SPARQL query text to encode." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns67:sqe_parse_to_tree.returns a slkg:ReturnValue ;
        rdfs:comment "A ``(graph, root)`` tuple." ;
        slkg:annotationText "tuple[Graph, IdentifiedNode]" ;
        slkg:hasType ns4:rdflib.term.IdentifiedNode, ns4:builtins.tuple, ns4:rdflib.graph.Graph .

