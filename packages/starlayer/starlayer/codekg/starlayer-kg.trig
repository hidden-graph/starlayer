        slkg:hasParameter ns72:prepare_query_12.param.text, ns72:prepare_query_12.param.base, ns72:prepare_query_12.param.initNs ;
        slkg:hasReturnValue ns72:prepare_query_12.returns ;
        slkg:lineEnd 159 ;
        slkg:lineStart 125 ;
        slkg:signature "def prepare_query_12(text: str, base: str | None=None, initNs: Mapping[str, Any] | None=None) -> Query" .

