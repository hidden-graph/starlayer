        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns70:_AlgebraTranslator12.translateAlgebra dcterms:identifier "starlayer.sparql.serialize12._AlgebraTranslator12.translateAlgebra" ;
        a slkg:Method ;
        rdfs:comment """Render this translator's accumulated algebra text, then resolve
