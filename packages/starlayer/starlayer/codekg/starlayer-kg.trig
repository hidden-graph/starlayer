GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/sqe/shapes.py> {
    ns65:shapes.py dcterms:identifier "starlayer.sparql.sqe.shapes" ;
        a slkg:Module ;
        rdfs:comment """SHACL validation for ``sqe:`` graphs - a thin wrapper combining this
vocabulary's own hand-authored shapes (``sqe_shapes.ttl``) with the shared
expression shapes and ontology (``spexpr:``, from ``..expr_validation``),
since ``sqe:Filter``/``sqe:Bind`` reference ``spexpr:ExpressionShape`` by name
(``sh:node``) - that shape's own *definition* has to be present in the shapes
graph being validated against, not just its ontology class for RDFS reasoning.
Nothing here imports or loads ``salg``.

No public ``ontology_graph()``/``shapes_graph()`` of its own - same choice
``srl.py`` already made ("to avoid two paths to the same two graphs"; see
that module's own comment) and the same reason Manchester doesn't have
them either (`starontology.get_ontology_graph("sqe_owl")`/`"sqe_shacl"`
is the one real path to those graphs). ``sqe_validate()`` combines them
privately below.""" ;
        rdfs:label "shapes" ;
        slkg:declares ns69:sqe_validate, ns69:_shapes_graph, ns69:_ontology_graph ;
        slkg:filePath "packages/starlayer/starlayer/sparql/sqe/shapes.py" ;
        slkg:importsModule ns4:rdflib, ns4:warnings, ns4:__future__ .

    ns69:_ontology_graph dcterms:identifier "starlayer.sparql.sqe.shapes._ontology_graph" ;
        a slkg:Function ;
        rdfs:comment """A fresh ``rdflib.Graph`` combining ``sqe:``'s own RDFS ontology with the shared ``spexpr:`` one, which
the RDFS-subclass entailment behind ``sh:node spexpr:ExpressionShape`` depends on.""" ;
        rdfs:label "_ontology_graph" ;
        slkg:calls ns349:ontology_graph ;
        slkg:filePath "packages/starlayer/starlayer/sparql/sqe/shapes.py" ;
        slkg:hasReturnValue ns69:_ontology_graph.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 46 ;
        slkg:lineStart 39 ;
        slkg:signature "def _ontology_graph() -> Graph" .

    ns69:_ontology_graph.returns a slkg:ReturnValue ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph .

    ns69:_shapes_graph dcterms:identifier "starlayer.sparql.sqe.shapes._shapes_graph" ;
        a slkg:Function ;
        rdfs:comment """A fresh ``rdflib.Graph`` combining ``sqe:``'s own shapes with the shared expression shapes
(``spexpr:``; see ``..expr_validation``). SHACL graphs are mutated by pyshacl during validation, so callers
get their own copy rather than a shared module-level instance. Nothing here comes from ``salg:``.""" ;
        rdfs:label "_shapes_graph" ;
        slkg:calls ns349:shapes_graph ;
        slkg:filePath "packages/starlayer/starlayer/sparql/sqe/shapes.py" ;
        slkg:hasReturnValue ns69:_shapes_graph.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 36 ;
        slkg:lineStart 28 ;
        slkg:signature "def _shapes_graph() -> Graph" .

    ns69:_shapes_graph.returns a slkg:ReturnValue ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph .

    ns69:sqe_validate dcterms:identifier "starlayer.sparql.sqe.shapes.sqe_validate" ;
        a slkg:Function ;
        rdfs:comment """Validate ``data_graph`` (e.g. from ``to_rdf.sqe_parse_to_tree``, or
an LLM-/UI-authored ``sqe:`` graph not yet decoded) against the shapes
above.

Goes through ``starlayer.shacl``, never bare ``pyshacl`` - same reason
``salg:``'s own ``validate_query()`` does: a ``sqe:`` graph may embed
genuine RDF 1.2 content (a triple term) that only ``starlayer.shacl``
understands correctly.""" ;
        rdfs:label "sqe_validate" ;
        slkg:calls ns69:_shapes_graph, ns69:_ontology_graph ;
        slkg:filePath "packages/starlayer/starlayer/sparql/sqe/shapes.py" ;
        slkg:hasParameter ns69:sqe_validate.param.data_graph ;
        slkg:hasReturnValue ns69:sqe_validate.returns ;
        slkg:lineEnd 80 ;
        slkg:lineStart 49 ;
        slkg:signature "def sqe_validate(data_graph: Graph) -> tuple[bool, Graph, str]" .

    ns69:sqe_validate.param.data_graph a slkg:Parameter ;
        rdfs:comment "The ``sqe:`` RDF graph to validate." ;
        rdfs:label "data_graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns69:sqe_validate.returns a slkg:ReturnValue ;
        rdfs:comment "A ``(conforms, report_graph, report_text)`` tuple." ;
        slkg:annotationText "tuple[bool, Graph, str]" ;
        slkg:hasType ns4:rdflib.graph.Graph, ns4:builtins.tuple, ns4:builtins.bool, ns4:builtins.str .

    ns4:__future__ a slkg:ExternalModule .

    ns4:builtins.bool dcterms:identifier "builtins.bool" ;
        a slkg:ExternalType ;
        rdfs:label "bool" ;
        rdfs:subClassOf slkg:Type .

