    ns102:iter_manifest_entries dcterms:identifier "tests.shacl.w3c_shacl12.manifest.iter_manifest_entries" ;
        a slkg:Function ;
        rdfs:comment """Recursively walk a manifest, yielding one ManifestEntry per mf:entries member.

Follows mf:include at every level. A file with no mf:entries of its own
(a pure router, e.g. the suite's top-level tests/manifest.ttl) yields
nothing directly - only its included descendants contribute entries.

An mf:include target that fails to parse yields one synthetic
parse_error entry for that file (see ManifestEntry.parse_error) and does
not recurse further into it, rather than raising and aborting the whole
walk - a handful of the vendored suite's own fixtures use Turtle
constructs the young StarLayerTurtleParser doesn't yet support (see
docs/starlayergraph-upstream-change-log.md), and one bad fixture shouldn't
hide every other entry from collection.""" ;
        rdfs:label "iter_manifest_entries" ;
        slkg:calls ns102:uri_to_path, ns102:iter_manifest_entries, ns102:load_document, ns102:file_uri ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/manifest.py" ;
        slkg:hasParameter ns102:iter_manifest_entries.param.manifest_path, ns102:iter_manifest_entries.param._visited ;
        slkg:instantiates ns102:ManifestEntry ;
        slkg:lineEnd 165 ;
        slkg:lineStart 117 ;
        slkg:signature "def iter_manifest_entries(manifest_path: Path, *, _visited: set[Path] | None=None)" .

    ns102:iter_manifest_entries.param._visited a slkg:Parameter ;
        rdfs:label "_visited" ;
        slkg:annotationText "set[Path] | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:builtins.set, ns4:pathlib.Path ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 1 .

    ns102:iter_manifest_entries.param.manifest_path a slkg:Parameter ;
        rdfs:label "manifest_path" ;
        slkg:annotationText "Path" ;
        slkg:hasType ns4:pathlib.Path ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns102:load_document dcterms:identifier "tests.shacl.w3c_shacl12.manifest.load_document" ;
        a slkg:Function ;
        rdfs:comment """Parse ``path`` as Turtle 1.2, cached, with its own file:// IRI as base.

Uses ``format="turtle12"`` (StarLayerGraph's own RDF-1.2-aware parser,
``starlayer.graph.parsers.turtle_parser.StarLayerTurtleParser``), not plain
``"turtle"`` - confirmed empirically that several suite fixtures use
genuine RDF 1.2 Turtle syntax plain rdflib's parser rejects outright:
triple-term literals (``<<( s p o )>>``), inline reification annotations
(``{| ... |}``), and direction-tagged language strings
(``"txt"@en--ltr``).

``publicID`` resolves ``<>`` and every other relative IRI (including
``mf:include`` targets) against the file's own IRI - fixed upstream in
``starlayer.graph`` 2026-07-30 (see
docs/starlayergraph-upstream-change-log.md); previously this needed a local
post-parse workaround here, now removed.""" ;
        rdfs:label "load_document" ;
        slkg:calls ns102:file_uri ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/manifest.py" ;
        slkg:hasParameter ns102:load_document.param.path ;
        slkg:hasReturnValue ns102:load_document.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 64 ;
        slkg:lineStart 42 ;
        slkg:signature "def load_document(path: Path) -> StarLayerGraph" .

    ns102:load_document.param.path a slkg:Parameter ;
        rdfs:label "path" ;
        slkg:annotationText "Path" ;
        slkg:hasType ns4:pathlib.Path ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns102:load_document.returns a slkg:ReturnValue ;
        slkg:annotationText "StarLayerGraph" ;
        slkg:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

    ns102:uri_to_path dcterms:identifier "tests.shacl.w3c_shacl12.manifest.uri_to_path" ;
        a slkg:Function ;
