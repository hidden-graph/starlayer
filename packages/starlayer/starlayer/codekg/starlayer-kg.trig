        rdfs:label "test_shapes_graph_without_expected_predicate_uses_original_pyshacl_loop" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_expected_predicate.py" ;
        slkg:hasReturnValue ns183:test_shapes_graph_without_expected_predicate_uses_original_pyshacl_loop.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 152 ;
        slkg:lineStart 123 ;
        slkg:signature "def test_shapes_graph_without_expected_predicate_uses_original_pyshacl_loop() -> None" .

