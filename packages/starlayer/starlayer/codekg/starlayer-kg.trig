        rdfs:label "tuple" ;
        rdfs:subClassOf slkg:Type .

    ns4:rdflib a slkg:ExternalModule .

    ns4:rdflib.graph.Graph dcterms:identifier "rdflib.graph.Graph" ;
        a slkg:ExternalType ;
        rdfs:label "Graph" ;
        rdfs:subClassOf slkg:Type .

    ns4:warnings a slkg:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/from_rdf.py> {
    ns48:from_rdf.py dcterms:identifier "starlayer.sparql.from_rdf" ;
        a slkg:Module ;
        rdfs:comment """Decode RDF triples (as produced by ``to_rdf.py``) back into an rdflib
SPARQL algebra tree / ``Query`` object — runnable directly via
``rdflib.plugins.sparql.evaluate.evalQuery`` or serializable back to query
text via ``rdflib.plugins.sparql.algebra.translateAlgebra``.

The hard part decoding has that encoding doesn't: rdflib's evaluator
requires *expression* nodes (``RelationalExpression``, ``Builtin_BOUND``,
``Function``, ...) to be actual ``Expr`` instances with a bound ``_evalfn``
(``rdflib.plugins.sparql.parserutils.value()`` raises on a plain
``CompValue`` used as an expression — "What do I do with this CompValue?").
That binding happens once, at *parse* time, via each grammar production's
``Comp(name, ...).setEvalFn(fn)`` call in ``rdflib.plugins.sparql.parser``.
Rather than hand-transcribing that table (name -> evalfn) — which would
silently drift out of sync with whatever rdflib version is actually
installed — ``_discover_expr_evalfns()`` below rebuilds it by walking the
live pyparsing grammar object graph in that module and collecting every
``Comp`` with a bound ``evalfn``. Same generic-mirror principle as the
encoder in ``to_rdf.py`` and the design note in ``vocab.py``.""" ;
        rdfs:label "from_rdf" ;
        slkg:declares ns53:_strip_vocab_ns, ns53:rdf_to_query, ns53:rdf_to_collection, ns53:_decode_list_field, ns53:_decode_binding_row, ns53:_decode_quads_map, ns53:_to_python_deep, ns53:_decode_path, ns53:_decode, ns53:_discover_expr_evalfns, ns53:rdf_to_update, ns53:_decode_triple_pattern, ns53:_decode_comp_value, ns53:_decode_prologue, ns53:_comp_value_type, ns53:_decode_list ;
        slkg:filePath "packages/starlayer/starlayer/sparql/from_rdf.py" ;
        slkg:importsModule ns4:rdflib.plugins.sparql.parserutils, ns4:__future__, ns4:pyparsing, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib.paths, ns4:rdflib.collection, ns4:contextvars, ns4:rdflib.namespace, ns4:rdflib .

    ns53:_comp_value_type dcterms:identifier "starlayer.sparql.from_rdf._comp_value_type" ;
        a slkg:Function ;
        rdfs:comment """The real CompValue-style ``rdf:type`` for ``node`` — a salg:/spexpr:
type, distinguished from the auxiliary root-marker types ``to_rdf.py``
layers onto a query/update root alongside its real CompValue type.""" ;
        rdfs:label "_comp_value_type" ;
        slkg:calls ns53:_strip_vocab_ns ;
        slkg:filePath "packages/starlayer/starlayer/sparql/from_rdf.py" ;
        slkg:hasParameter ns53:_comp_value_type.param.graph, ns53:_comp_value_type.param.node ;
