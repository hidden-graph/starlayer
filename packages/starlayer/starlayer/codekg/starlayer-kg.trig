        slkg:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        slkg:hasParameter ns28:StarLayerGraph.update.param.kwargs, ns28:StarLayerGraph.update.param.processor, ns28:StarLayerGraph.update.param.initBindings, ns28:StarLayerGraph.update.param.use_store_provided, ns28:StarLayerGraph.update.param.initNs, ns28:StarLayerGraph.update.param.update_object ;
