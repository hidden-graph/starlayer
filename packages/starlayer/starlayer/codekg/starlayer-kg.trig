    ns67:_query_to_sqe_rdf dcterms:identifier "starlayer.sparql.sqe.to_rdf._query_to_sqe_rdf" ;
        a slkg:Function ;
        rdfs:comment """Encode a ``SELECT``/``ASK``/``CONSTRUCT`` query's raw parse tree
(``parseQuery(text)``'s output — ``[prologue, query]``) as ``sqe:``
RDF.

Private: ``sqe_parse_to_tree`` above is the public entry point. Taking
an already-``parseQuery()``'d tree directly (rather than text) is a
low-level, non-obvious input shape for a public API to expose, and
nothing in this package currently needs that flexibility - kept as a
separate function purely so the actual encoding logic stays testable/
reusable without forcing a real parse through ``sqe_parse_to_tree`` on
every call.""" ;
        rdfs:label "_query_to_sqe_rdf" ;
        slkg:calls ns67:_encode_query_body, ns67:_encode_raw_prologue, ns54:_new_starlayer_graph ;
        slkg:filePath "packages/starlayer/starlayer/sparql/sqe/to_rdf.py" ;
        slkg:hasParameter ns67:_query_to_sqe_rdf.param.graph, ns67:_query_to_sqe_rdf.param.parse_result, ns67:_query_to_sqe_rdf.param.root ;
        slkg:hasReturnValue ns67:_query_to_sqe_rdf.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 295 ;
        slkg:lineStart 244 ;
        slkg:signature "def _query_to_sqe_rdf(parse_result: ParseResults, graph: Graph | None=None, root: IdentifiedNode | None=None) -> tuple[Graph, IdentifiedNode]" .

    ns67:_query_to_sqe_rdf.param.graph a slkg:Parameter ;
        rdfs:comment "The graph to add the ``sqe:`` RDF to. Defaults to a fresh ``StarLayerGraph``." ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
