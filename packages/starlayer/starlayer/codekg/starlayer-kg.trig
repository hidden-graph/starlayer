GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/graph/starlayer_graph.py> {
    ns25:starlayer_graph.py dcterms:identifier "starlayer.graph.graph.starlayer_graph" ;
        a slkg:Module ;
        rdfs:comment """starlayer.graph.graph.starlayer_graph

StarLayerGraph — rdflib.Graph subclass with RDF 1.2 triple-term support.

A plain Python 3-tuple in any node position is treated as an inline TripleTerm.
All rdflib.Graph methods work identically; core traversal methods are extended
to accept and return TripleTerm objects while hiding the internal encoding.

Encoding: triple terms are stored as content-addressed URIRefs under TT_NS
(same triple content always maps to the same URI). The rdf:subject/predicate/object
triples that define the encoding are hidden from callers.""" ;
        rdfs:label "starlayer_graph" ;
        slkg:declares ns28:_read_source_text, ns28:_unfold_native_triple_terms, ns28:StarLayerGraph, ns28:_UnionForQuery, ns28:_is_tt_like, ns28:_check_single_graph, ns28:can_resolve_import, ns28:_needs_encoding, ns28:_unfold_tt_encoding ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        slkg:importsModule ns4:collections.abc, ns4:rdflib.query, ns4:rdflib.namespace, ns4:rdflib.graph, ns4:__future__, ns4:typing, ns4:rdflib, ns4:rdflib.term, ns4:rdflib.paths .

    ns28:StarLayerGraph dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph" ;
        a slkg:Class ;
        rdfs:comment """rdflib.Graph extended with RDF 1.2 triple-term support.

Triple terms are represented as Python 3-tuples or TripleTerm objects.
Internally they are encoded as content-addressed URIRefs under TT_NS in
the rdflib store; that encoding is completely hidden from callers.

All unoverridden rdflib.Graph methods (namespace management, SPARQL,
serialization, etc.) are inherited and work without modification.""" ;
        rdfs:label "StarLayerGraph" ;
        rdfs:subClassOf ns4:rdflib.graph.Graph ;
        slkg:declares ns28:StarLayerGraph.de_skolemize, ns28:StarLayerGraph.triples_choices, ns28:StarLayerGraph.has_import_locally, ns28:StarLayerGraph.serialize, ns28:StarLayerGraph._native_triples, ns28:StarLayerGraph._intern_tt, ns28:StarLayerGraph._triples_tt_wildcard, ns28:StarLayerGraph._coerce_tt_read, ns28:StarLayerGraph._adopt_basic_encoding, ns28:StarLayerGraph.print, ns28:StarLayerGraph._native_add, ns28:StarLayerGraph.parse, ns28:StarLayerGraph.qname_term, ns28:StarLayerGraph.skolemize, ns28:StarLayerGraph.addN, ns28:StarLayerGraph._coerce_tt, ns28:StarLayerGraph.__len__, ns28:StarLayerGraph._resolve_owlrl_semantics, ns28:StarLayerGraph._native_remove, ns28:StarLayerGraph._needs_bnode_skolemization, ns28:StarLayerGraph._coerce_choices, ns28:StarLayerGraph.open, ns28:StarLayerGraph._before_and_delta_for, ns28:StarLayerGraph.from_rdflib, ns28:StarLayerGraph.query, ns28:StarLayerGraph._is_tt_wildcard, ns28:StarLayerGraph.owl_imports, ns28:StarLayerGraph._native_reifiers, ns28:StarLayerGraph.add_reification, ns28:StarLayerGraph._is_encoding_triple, ns28:StarLayerGraph._encode_init_bindings, ns28:StarLayerGraph._infer_before_and_delta, ns28:StarLayerGraph.reifiers, ns28:StarLayerGraph._native_triples_choices, ns28:StarLayerGraph.derive_shape, ns28:StarLayerGraph._native_skolem_node_exists, ns28:StarLayerGraph._build_registry_from_store, ns28:StarLayerGraph.cbd, ns28:StarLayerGraph.update, ns28:StarLayerGraph.reifier_annotations, ns28:StarLayerGraph.add, ns28:StarLayerGraph.close, ns28:StarLayerGraph.remove, ns28:StarLayerGraph.infer, ns28:StarLayerGraph._infer_rdf_before_and_delta, ns28:StarLayerGraph.triple_terms, ns28:StarLayerGraph.reifications, ns28:StarLayerGraph._matching_tt_uris, ns28:StarLayerGraph.triples, ns28:StarLayerGraph.empty_like, ns28:StarLayerGraph._is_native, ns28:StarLayerGraph._on_mutated, ns28:StarLayerGraph.resolve_imports, ns28:StarLayerGraph._restore, ns28:StarLayerGraph._native_scoped, ns28:StarLayerGraph.add_reifier_annotation, ns2