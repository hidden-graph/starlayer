    ns28:StarLayerGraph._adopt_basic_encoding dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph._adopt_basic_encoding" ;
        a slkg:Method ;
        rdfs:comment """Convert the RDF 1.2 Interoperability "basic encoding" into this
graph's own encoding: every blank node typed ``rdf:PropositionForm``
(with exactly one ``rdf:propositionFormSubject/Predicate/Object``)
becomes the content-addressed triple-term node for the same
subject/predicate/object, and every other triple mentioning it is
rewritten to that node. A node that does not have exactly one of each
property is left alone (the spec names that an error; we do not guess).

Called after parsing a plain RDF 1.1 format (Turtle, RDF/XML, N-Triples,
...), the only place basic-encoded data can arrive. Does nothing when
there is no such node. The inverse is ``_deskolemize_to_graph()``,
which is what ``serialize()`` uses for those same formats.""" ;
        rdfs:label "_adopt_basic_encoding" ;
        slkg:calls ns7:encoding_triples, ns7:tt_hash, ns7:term_key, ns28:StarLayerGraph._adopt_basic_encoding.uri_for, ns28:StarLayerGraph._build_registry_from_store ;
        slkg:declares ns28:StarLayerGraph._adopt_basic_encoding.uri_for ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        slkg:hasReturnValue ns28:StarLayerGraph._adopt_basic_encoding.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 1080 ;
        slkg:lineStart 1025 ;
        slkg:signature "def _adopt_basic_encoding(self) -> None" .

    ns28:StarLayerGraph._adopt_basic_encoding.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

