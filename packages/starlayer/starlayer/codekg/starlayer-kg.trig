GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/serializers/trix12.py> {
    ns8:trix12.py dcterms:identifier "starlayer.graph.serializers.trix12" ;
        a slkg:Module ;
        rdfs:comment """starlayer.graph.serializers.trix12

Serialize a StarLayerGraph or StarLayerDataset context to TriX 1.2 XML.

TriX is an XML-based named-graph format (http://www.w3.org/2004/03/trix/).
Each graph is a <graph> element containing <triple> elements. RDF 1.2 triple
terms are represented by nesting another <triple> element in a term position
(subject or object) - the same tag used for an asserted statement, since
TriX disambiguates by structural position, not a distinct tag name. This
matches Apache Jena's real TriX writer (confirmed empirically 2026-07-17
against a live Fuseki 5.5.0), including its lowercase <trix> root element -
the only production TriX implementation found to support RDF 1.2 triple
terms at all, since Oxigraph doesn't implement TriX. See the parser module
(starlayer.graph.parsers.trix12) for the corresponding read side, which still
accepts starlayer.graph's original <TriX>/<tripleTerm> spelling for backward
compatibility even though it's no longer emitted here.

Entry point:  serialize_trix12(g) -> str""" ;
        rdfs:label "trix12" ;
        slkg:declares ns16:_term_elem, ns16:serialize_trix12_dataset, ns16:_append_graph, ns16:_sort_triple, ns16:serialize_trix12 ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/trix12.py" ;
        slkg:importsModule ns4:xml.etree.ElementTree, ns4:__future__, ns4:rdflib .

    ns16:_append_graph dcterms:identifier "starlayer.graph.serializers.trix12._append_graph" ;
        a slkg:Function ;
        rdfs:comment "Append a <graph> element for *g* to *root*." ;
        rdfs:label "_append_graph" ;
        slkg:calls ns16:_term_elem ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/trix12.py" ;
        slkg:hasParameter ns16:_append_graph.param.root, ns16:_append_graph.param.g ;
        slkg:hasReturnValue ns16:_append_graph.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 99 ;
        slkg:lineStart 88 ;
        slkg:signature "def _append_graph(g, root: ET.Element) -> None" .

    ns16:_append_graph.param.g a slkg:Parameter ;
        rdfs:label "g" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns16:_append_graph.param.root a slkg:Parameter ;
        rdfs:label "root" ;
        slkg:annotationText "ET.Element" ;
        slkg:hasType ns4:xml.etree.ElementTree.Element ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns16:_append_graph.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns16:_sort_triple dcterms:identifier "starlayer.graph.serializers.trix12._sort_triple" ;
        a slkg:Function ;
        rdfs:label "_sort_triple" ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/trix12.py" ;
        slkg:hasParameter ns16:_sort_triple.param.t ;
        slkg:hasReturnValue ns16:_sort_triple.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 85 ;
        slkg:lineStart 84 ;
        slkg:signature "def _sort_triple(t: tuple) -> tuple" .

    ns16:_sort_triple.param.t a slkg:Parameter ;
        rdfs:label "t" ;
        slkg:annotationText "tuple" ;
        slkg:hasType ns4:builtins.tuple ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns16:_sort_triple.returns a slkg:ReturnValue ;
        slkg:annotationText "tuple" ;
        slkg:hasType ns4:builtins.tuple .

    ns16:_term_elem dcterms:identifier "starlayer.graph.serializers.trix12._term_elem" ;
        a slkg:Function ;
        rdfs:comment "Append a TriX term element for *node* to *parent* and return it." ;
        rdfs:label "_term_elem" ;
        slkg:calls ns16:_term_elem, ns7:encode_dirlang_datatype ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/trix12.py" ;
        slkg:hasParameter ns16:_term_elem.param.node, ns16:_term_elem.param.parent ;
        slkg:hasReturnValue ns16:_term_elem.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 81 ;
        slkg:lineStart 38 ;
        slkg:signature "def _term_elem(node, parent: ET.Element) -> ET.Element" .

    ns16:_term_elem.param.node a slkg:Parameter ;
        rdfs:label "node" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns16:_term_elem.param.parent a slkg:Parameter ;
        rdfs:label "parent" ;
        slkg:annotationText "ET.Element" ;
        slkg:hasType ns4:xml.etree.ElementTree.Element ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns16:_term_elem.returns a slkg:ReturnValue ;
        slkg:annotationText "ET.Element" ;
        slkg:hasType ns4:xml.etree.ElementTree.Element .

    ns16:serialize_trix12 dcterms:identifier "starlayer.graph.serializers.trix12.serialize_trix12" ;
        a slkg:Function ;
        rdfs:comment """Serialize a StarLayerGraph to TriX 1.2 XML text.

Named graph identifier → <uri> as first child of <graph>.
BNode identifier        → anonymous <graph> (default/unnamed graph).
Triple terms emitted as a nested <triple> (Jena convention), not a
distinct <tripleTerm> tag.""" ;
        rdfs:label "serialize_trix12" ;
        slkg:calls ns16:_append_graph ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/trix12.py" ;
        slkg:hasParameter ns16:serialize_trix12.param.g ;
        slkg:hasReturnValue ns16:serialize_trix12.returns ;
        slkg:lineEnd 124 ;
        slkg:lineStart 102 ;
        slkg:signature "def serialize_trix12(g) -> str" .

    ns16:serialize_trix12.param.g a slkg:Parameter ;
        rdfs:comment "The StarLayerGraph to serialize." ;
        rdfs:label "g" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns16:serialize_trix12.returns a slkg:ReturnValue ;
        rdfs:comment "The TriX 1.2 XML serialization of g." ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns16:serialize_trix12_dataset dcterms:identifier "starlayer.graph.serializers.trix12.serialize_trix12_dataset" ;
        a slkg:Function ;
        rdfs:comment """Serialize a StarLayerDataset to TriX 1.2 XML text.

Each non-empty named graph becomes a separate <graph> block.""" ;
        rdfs:label "serialize_trix12_dataset" ;
        slkg:calls ns16:_append_graph ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/trix12.py" ;
        slkg:hasParameter ns16:serialize_trix12_dataset.param.ds ;
        slkg:hasReturnValue ns16:serialize_trix12_dataset.returns ;
        slkg:lineEnd 149 ;
        slkg:lineStart 127 ;
        slkg:signature "def serialize_trix12_dataset(ds) -> str" .

    ns16:serialize_trix12_dataset.param.ds a slkg:Parameter ;
        rdfs:comment "The StarLayerDataset to serialize." ;
        rdfs:label "ds" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns16:serialize_trix12_dataset.returns a slkg:ReturnValue ;
        rdfs:comment "The TriX 1.2 XML serialization of ds." ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns4:__future__ a slkg:ExternalModule .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a slkg:ExternalType ;
        rdfs:label "str" ;
