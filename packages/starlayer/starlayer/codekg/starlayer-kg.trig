GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_roundtrip.py> {
    ns120:test_roundtrip.py dcterms:identifier "tests.sparql.unit.test_roundtrip" ;
        a slkg:Module ;
        rdfs:comment """Phase 1 round-trip tests: SELECT + BGP + FILTER + OPTIONAL + UNION.

Verifies text -> algebra -> RDF -> algebra -> results, by *executing* both
the original prepared query and the RDF-round-tripped reconstruction against
the same fixture graph and comparing result sets — not by comparing
regenerated query text, which isn't guaranteed stable (see algebra.py's
translateAlgebra: it always emits full IRIs, never prefixed names).""" ;
        rdfs:label "test_roundtrip" ;
        slkg:declares ns128:test_regenerated_text_is_also_executable, ns128:_canon, ns128:test_roundtrip_result_equivalence ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_roundtrip.py" ;
        slkg:importsModule ns4:rdflib.plugins.sparql.algebra, ns4:pytest, ns4:rdflib.plugins.sparql.processor, ns4:rdflib.plugins.sparql.evaluate .

    ns128:_canon dcterms:identifier "tests.sparql.unit.test_roundtrip._canon" ;
        a slkg:Function ;
        rdfs:label "_canon" ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_roundtrip.py" ;
        slkg:hasParameter ns128:_canon.param.res ;
        slkg:isPrivate true ;
        slkg:lineEnd 74 ;
        slkg:lineStart 70 ;
        slkg:signature "def _canon(res)" .

    ns128:_canon.param.res a slkg:Parameter ;
        rdfs:label "res" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns128:test_regenerated_text_is_also_executable dcterms:identifier "tests.sparql.unit.test_roundtrip.test_regenerated_text_is_also_executable" ;
        a slkg:Function ;
        rdfs:comment """Bonus check: algebra.translateAlgebra (rdflib's own algebra -> text
serializer) should also be able to turn the round-tripped algebra back
into query text that re-parses and produces the same results.""" ;
        rdfs:label "test_regenerated_text_is_also_executable" ;
        slkg:calls ns128:_canon ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_roundtrip.py" ;
        slkg:hasDecorator ns128:test_regenerated_text_is_also_executable.decorator.0 ;
        slkg:hasParameter ns128:test_regenerated_text_is_also_executable.param.query_text, ns128:test_regenerated_text_is_also_executable.param.fixture_graph ;
        slkg:lineEnd 128 ;
        slkg:lineStart 114 ;
        slkg:signature "def test_regenerated_text_is_also_executable(fixture_graph, query_text)" .

    ns128:test_regenerated_text_is_also_executable.decorator.0 a slkg:Decorator ;
        slkg:decoratorText "pytest.mark.parametrize('query_text', _TRANSLATE_ALGEBRA_QUERIES)" ;
        slkg:position 0 .

    ns128:test_regenerated_text_is_also_executable.param.fixture_graph a slkg:Parameter ;
        rdfs:label "fixture_graph" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns128:test_regenerated_text_is_also_executable.param.query_text a slkg:Parameter ;
        rdfs:label "query_text" ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns128:test_roundtrip_result_equivalence dcterms:identifier "tests.sparql.unit.test_roundtrip.test_roundtrip_result_equivalence" ;
        a slkg:Function ;
