        rdfs:comment "Canonical string form of the triple term's resolved subject." ;
        rdfs:label "s_str" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns7:tt_hash.returns a slkg:ReturnValue ;
        rdfs:comment "A 16-character hexadecimal digest derived from (s_str, p_str, o_str)." ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

