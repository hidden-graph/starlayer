        a slkg:Function ;
        rdfs:comment """Convert a native pyoxigraph term to an rdflib node, DirLangString, or
TripleTerm. Mirrors native.py's ``_parse_json_term()`` for the HTTP
transport, minus the JSON dispatch - pyoxigraph hands back typed objects.""" ;
        rdfs:label "_parse_ox_term" ;
        slkg:calls ns44:_canonicalize_decimal_lexical_form, ns312:_parse_ox_term ;
