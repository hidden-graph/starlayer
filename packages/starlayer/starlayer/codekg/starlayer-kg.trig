    ns238:TestRoundtripResultEquivalence.test_original_prefix_survives_into_rendered_text dcterms:identifier "tests.sparql.unit.test_sqe_ontology.TestRoundtripResultEquivalence.test_original_prefix_survives_into_rendered_text" ;
        a slkg:Method ;
        rdfs:comment """The whole reason to_text.py exists instead of reusing
