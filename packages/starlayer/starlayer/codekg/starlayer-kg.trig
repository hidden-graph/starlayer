        slkg:hasType ns4:builtins.str .

    ns9:_split_iri dcterms:identifier "starlayer.graph.serializers.rdfxml12._split_iri" ;
        a slkg:Function ;
        rdfs:comment """Split an IRI into (namespace_uri, local_name).

Tries '#' first, then '/'.  Raises ValueError if the local name cannot
form a valid XML name start character.""" ;
        rdfs:label "_split_iri" ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/rdfxml12.py" ;
        slkg:hasParameter ns9:_split_iri.param.iri ;
        slkg:hasReturnValue ns9:_split_iri.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 66 ;
        slkg:lineStart 54 ;
        slkg:signature "def _split_iri(iri: str) -> tuple[str, str]" .

    ns9:_split_iri.param.iri a slkg:Parameter ;
        rdfs:label "iri" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns9:_split_iri.returns a slkg:ReturnValue ;
        slkg:annotationText "tuple[str, str]" ;
        slkg:hasType ns4:builtins.tuple, ns4:builtins.str .

    ns9:serialize_rdfxml12 dcterms:identifier "starlayer.graph.serializers.rdfxml12.serialize_rdfxml12" ;
        a slkg:Function ;
        rdfs:comment """Serialize a StarLayerGraph to RDF/XML 1.2 text.

Triple terms in object position → ``rdf:parseType="Triple"`` wrapping a
single ``<rdf:Description>`` (RDF 1.2 XML Syntax sec 2.19). Reification is
the ordinary ``rdf:reifies`` predicate with a triple-term-valued object -
the same "formal pattern" used as the canonical form everywhere else in
this codebase, not the ``rdf:annotation``/``rdf:annotationNodeID``
shorthand (which the parser accepts for reading, but this serializer
never emits).""" ;
        rdfs:label "serialize_rdfxml12" ;
        slkg:calls ns9:_set_object, ns9:_register_ns, ns28:StarLayerGraph.from_rdflib, ns9:_clark ;
        slkg:filePath "packages/starlayer/starlayer/graph/serializers/rdfxml12.py" ;
        slkg:hasParameter ns9:serialize_rdfxml12.param.graph ;
        slkg:hasReturnValue ns9:serialize_rdfxml12.returns ;
        slkg:lineEnd 184 ;
        slkg:lineStart 141 ;
        slkg:signature "def serialize_rdfxml12(graph) -> str" .

    ns9:serialize_rdfxml12.param.graph a slkg:Parameter ;
        rdfs:comment "The graph to serialize - a StarLayerGraph, or a plain rdflib.Graph wrapped via StarLayerGraph.from_rdflib()." ;
        rdfs:label "graph" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns9:serialize_rdfxml12.returns a slkg:ReturnValue ;
        rdfs:comment "The RDF/XML 1.2 serialization of graph." ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns4:__future__ a slkg:ExternalModule .

