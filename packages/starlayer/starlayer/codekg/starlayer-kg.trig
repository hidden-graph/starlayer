    ns102:file_uri.param.path a slkg:Parameter ;
        rdfs:label "path" ;
        slkg:annotationText "Path" ;
        slkg:hasType ns4:pathlib.Path ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns102:file_uri.returns a slkg:ReturnValue ;
