GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/extractor/build.py> {
    ns276:build.py dcterms:identifier "starlayer.codekg.extractor.build" ;
        a slkg:Module ;
        rdfs:comment """starlayer.codekg.extractor.build - the wholesale-replace orchestration.

One public function, ``refresh()``: parse the existing ``codekg.trig`` (if
any), drop every per-module named graph (leaving the ontology's own graph
and the reserved curated graph untouched, and replacing the build-stamp graph - neither is ever file-backed by
this extractor), re-extract each target path fresh via ``visitor.py``, and
re-serialize. "Wholesale replace" per module: a module that's no longer in
``target_paths`` simply stays dropped (its old graph was removed and never
rebuilt) - this function only ever adds back exactly the graphs it's told
to extract.

Before any single file's own triples are extracted, a whole-project
``symbol_index.build_symbol_index()`` pass runs once across every target
path - this is what lets ``slkg:calls`` resolve a call to a function
defined in a different file than the one making the call (see
``symbol_index.py``'s own module docstring).""" ;
        rdfs:label "build" ;
        slkg:declares ns287:refresh ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/build.py" ;
        slkg:importsModule ns4:pathlib, ns4:__future__ .

    ns287:refresh dcterms:identifier "starlayer.codekg.extractor.build.refresh" ;
        a slkg:Function ;
        rdfs:comment """Re-extract every path in ``target_paths`` and wholesale-replace
their named graphs in ``codekg.trig``.""" ;
        rdfs:label "refresh" ;
        slkg:calls ns283:module_identity, ns353:write_stamp, ns283:build_symbol_index, ns279:extract_module ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/build.py" ;
        slkg:hasParameter ns287:refresh.param.trig_path, ns287:refresh.param.target_paths, ns287:refresh.param.repo_root ;
        slkg:hasReturnValue ns287:refresh.returns ;
        slkg:instantiates ns31:StarLayerDataset ;
        slkg:lineEnd 81 ;
        slkg:lineStart 32 ;
        slkg:signature "def refresh(target_paths: list[Path], repo_root: Path, *, trig_path: Path | None=None) -> None" .

    ns287:refresh.param.repo_root a slkg:Parameter ;
        rdfs:comment "The repository root, used to compute each path's repo-relative identity (module IRI and dotted import path) via ``symbol_index.module_identity()`` - every entry in ``target_paths`` must live under one of that function's own known roots (``packages/starlayer/starlayer/`` or ``packages/starlayer/tests/`` - see ``symbol_index.resolve_root()``)." ;
        rdfs:label "repo_root" ;
        slkg:annotationText "Path" ;
        slkg:hasType ns4:pathlib.Path ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns287:refresh.param.target_paths a slkg:Parameter ;
        rdfs:comment "The ``.py`` files to extract (already resolved to individual files, not directories - see ``cli.py`` for the directory-globbing step)." ;
        rdfs:label "target_paths" ;
        slkg:annotationText "list[Path]" ;
        slkg:hasType ns4:builtins.list, ns4:pathlib.Path ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns287:refresh.param.trig_path a slkg:Parameter ;
        rdfs:comment "Override for where ``codekg.trig`` is read from/written to - defaults to the real ``CODEKG_TRIG_PATH`` module constant. Exists for testability (so a test never touches the real, checked-in file)." ;
        rdfs:label "trig_path" ;
        slkg:annotationText "Path | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:pathlib.Path ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 2 .

    ns287:refresh.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns4:__future__ a slkg:ExternalModule .

    ns4:builtins.list dcterms:identifier "builtins.list" ;
        a slkg:ExternalType ;
        rdfs:label "list" ;
        rdfs:subClassOf slkg:Type .

    ns4:pathlib a slkg:ExternalModule .

    ns4:pathlib.Path dcterms:identifier "pathlib.Path" ;
        a slkg:ExternalType ;
        rdfs:label "Path" ;
        rdfs:subClassOf slkg:Type .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_native_backend_oxigraph_store.py> {
    ns97:test_native_backend_oxigraph_store.py dcterms:identifier "tests.shacl.integration.test_native_backend_oxigraph_store" ;
        a slkg:Module ;
        rdfs:comment """SHACL validate()/apply_rules() against graphs backed by oxrdflib's
OxigraphStore in rdf-1.2 native mode (in-process, no server).

Regression: with meta_shacl on, a blank node in the shapes graph (e.g. an
inline sh:property [ ... ]) that appears in a violation report is looked up
via the find_node_named_graph fallback in starlayer.shacl.validator. A graph
built with no explicit identifier lives in the store's true default graph,
which that fallback's "GRAPH ?g" discovery query can never enumerate - it
used to raise LookupError.""" ;
        rdfs:label "test_native_backend_oxigraph_store" ;
        slkg:declares ns302:test_validate_and_apply_rules_with_default_graph_store, ns302:_graph ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_native_backend_oxigraph_store.py" ;
        slkg:importsModule ns4:rdflib, ns4:pytest .

