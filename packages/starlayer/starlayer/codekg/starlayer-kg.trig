        slkg:isPrivate true ;
        slkg:lineEnd 90 ;
        slkg:lineStart 39 ;
        slkg:signature "def _parse_ox_term(term)" .

    ns312:_parse_ox_term.param.term a slkg:Parameter ;
        rdfs:label "term" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

