        rdfs:label "sparql_query_text" ;
        slkg:calls ns70:_term_text, ns70:_triples_text, ns70:_AlgebraTranslator12.convert_node_arg ;
        slkg:filePath "packages/starlayer/starlayer/sparql/serialize12.py" ;
        slkg:hasParameter ns70:_AlgebraTranslator12.sparql_query_text.param.node ;
