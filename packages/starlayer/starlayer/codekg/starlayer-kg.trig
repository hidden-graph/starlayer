    ns149:test_conformance.py dcterms:identifier "tests.test_conformance" ;
        a slkg:Module ;
        rdfs:comment """starlayer.conformance.declared_conformance() - a multi-resource,
SHACL-1.2-Profiling-S3-style self-declaration: one graph with three real
resources (starlayer.shacl, starlayer.graph, starlayer.sparql), each
asserting dcterms:conformsTo only the spec documents specific to what
that subpackage actually implements - not one flattened "whole library"
node (see this module's own CLAUDE.md entry for why that design was
chosen over the original flat one). A minority of exclusions also get an
explicit conformance:doesNotConformTo triple (project-minted, no standard
predicate exists) rather than only prose - see this module's own
docstring for exactly which two cases qualify and why the rest don't.""" ;
        rdfs:label "test_conformance" ;
        slkg:declares ns191:test_ui_specification_is_claimed_with_its_scope_limits_stated, ns191:test_each_resource_states_what_it_does_not_claim, ns191:test_shacl_resource_matches_declared_conformance_profile, ns191:test_claims_stay_on_their_own_resource_not_cross_contaminated, ns191:test_each_resource_has_identity_metadata, ns191:test_does_not_conform_to_never_contradicts_a_positive_claim, ns191:test_graph_resource_does_not_conform_to_d_entailment_explicitly, ns191:test_sparql_resource_has_every_expected_document, ns191:test_shacl_resource_claims_the_five_profiles_and_the_ui_specification, ns191:test_shacl_resource_neither_claims_nor_excludes_the_ui_profile, ns191:test_graph_resource_has_every_expected_document_and_regime, ns191:test_entailment_regimes_are_individual_iris_not_the_whole_document, ns191:test_fresh_graph_every_call_not_shared ;
