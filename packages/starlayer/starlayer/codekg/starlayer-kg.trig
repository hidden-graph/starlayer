GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/backends/native_oxigraph.py> {
    ns37:native_oxigraph.py dcterms:identifier "starlayer.graph.backends.native_oxigraph" ;
        a slkg:Module ;
        rdfs:comment """In-process transport for the native (``backend='rdf-1.2'``) backend, using
``oxrdflib``'s ordinary ``OxigraphStore`` as the store.

The native backend normally talks SPARQL text to a remote endpoint over HTTP
(``native.py``'s ``http_*`` functions). ``oxrdflib.OxigraphStore`` wraps a
``pyoxigraph.Store`` - the same Rust engine, run in-process - so the same
SPARQL text can be handed to it directly, with real RDF 1.2 triple terms and
SPARQL 1.2 evaluation, and no HTTP at all.

Opt-in and explicit: only a graph constructed with
``StarLayerGraph(store=<OxigraphStore>, backend='rdf-1.2')`` uses this path.
Every other graph is unaffected. ``oxrdflib`` and ``pyoxigraph`` are optional
dependencies, never imported at module level elsewhere.""" ;
        rdfs:label "native_oxigraph" ;
        slkg:declares ns312:ox_select, ns312:_engine, ns312:_parse_ox_term, ns312:is_oxigraph_store, ns312:ox_ask, ns312:ox_construct, ns312:ox_update ;
        slkg:filePath "packages/starlayer/starlayer/graph/backends/native_oxigraph.py" ;
        slkg:importsModule ns4:rdflib.namespace, ns4:rdflib.term, ns4:__future__, ns4:rdflib .

    ns312:_engine dcterms:identifier "starlayer.graph.backends.native_oxigraph._engine" ;
        a slkg:Function ;
        rdfs:comment "The wrapped ``pyoxigraph.Store`` of an ``OxigraphStore``." ;
        rdfs:label "_engine" ;
        slkg:filePath "packages/starlayer/starlayer/graph/backends/native_oxigraph.py" ;
        slkg:hasParameter ns312:_engine.param.store ;
        slkg:isPrivate true ;
