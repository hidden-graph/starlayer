        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns9:_set_object.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns9:_sort_key dcterms:identifier "starlayer.graph.serializers.rdfxml12._sort_key" ;
        a slkg:Function ;
