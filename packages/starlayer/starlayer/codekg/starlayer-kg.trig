    ns182:test_select_based_target_node_targets_query_results dcterms:identifier "tests.shacl.integration.test_new_target_types.test_select_based_target_node_targets_query_results" ;
        a slkg:Function ;
        rdfs:comment """sh:targetNode [ sh:select "..." ] (SHACL 1.2 Core): a SPARQL-computed
target node set given directly as sh:targetNode's own value - a blank
node carrying sh:select, distinct from sh:targetWhere (whose value is a
whole shape, matched via conformance) and from pySHACL's own existing
sh:target [ sh:select ... ] (a different predicate, SHACL-AF's
SPARQLTarget, already natively supported). Found missing entirely via
the W3C SHACL 1.2 test suite's targetNode-select-001 fixture.""" ;
        rdfs:label "test_select_based_target_node_targets_query_results" ;
        slkg:calls ns182:_violating_focus_nodes ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_new_target_types.py" ;
