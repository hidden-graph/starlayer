        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns15:_unescape_nt.returns a slkg:ReturnValue ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns15:extract_version_directive dcterms:identifier "starlayer.graph.parsers.ntriples12.extract_version_directive" ;
        a slkg:Function ;
        rdfs:comment """Return the declared VERSION label (e.g. "1.2-basic"), or None.

_parse_nt_line() already recognizes a VERSION line but only to discard it
like a comment - it never surfaces the label. This is a separate,
lightweight scan so parse_ntriples12()/parse_nquads12() keep their
existing list[tuple] return signature; StarLayerGraph.parse() calls this
alongside them for the RDF12ConformanceWarning check (see
starlayer.graph.model.conformance). Per the grammar, VERSION - if present -
must be the first statement, so only the first non-blank/comment line is
examined.""" ;
        rdfs:label "extract_version_directive" ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/ntriples12.py" ;
        slkg:hasParameter ns15:extract_version_directive.param.text ;
        slkg:hasReturnValue ns15:extract_version_directive.returns ;
        slkg:lineEnd 261 ;
        slkg:lineStart 236 ;
        slkg:signature "def extract_version_directive(text: str) -> str | None" .

    ns15:extract_version_directive.param.text a slkg:Parameter ;
        rdfs:comment "The N-Triples/N-Quads 1.2 document text to scan." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns15:extract_version_directive.returns a slkg:ReturnValue ;
        rdfs:comment "The declared VERSION label (e.g. \"1.2-basic\"), or None if the document's first non-blank/comment line isn't a VERSION line." ;
        slkg:annotationText "str | None" ;
        slkg:hasType ns4:builtins.str ;
        slkg:optional true .

    ns15:parse_nquads12 dcterms:identifier "starlayer.graph.parsers.ntriples12.parse_nquads12" ;
        a slkg:Function ;
        rdfs:comment """Parse N-Quads 1.2 text; return list of (s, p, o, g) quads.

Subjects and objects may be TripleTerm instances.""" ;
        rdfs:label "parse_nquads12" ;
        slkg:calls ns15:_parse_nt_line ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/ntriples12.py" ;
        slkg:hasParameter ns15:parse_nquads12.param.text ;
        slkg:hasReturnValue ns15:parse_nquads12.returns ;
        slkg:lineEnd 304 ;
        slkg:lineStart 287 ;
        slkg:signature "def parse_nquads12(text: str) -> list[tuple]" .

    ns15:parse_nquads12.param.text a slkg:Parameter ;
        rdfs:comment "The N-Quads 1.2 document text to parse." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns15:parse_nquads12.returns a slkg:ReturnValue ;
        rdfs:comment "A list of (s, p, o, g) quads, one per non-blank/comment line - g is a URIRef for a named graph, None for the default graph." ;
        slkg:annotationText "list[tuple]" ;
        slkg:hasType ns4:builtins.tuple, ns4:builtins.list .

    ns15:parse_ntriples12 dcterms:identifier "starlayer.graph.parsers.ntriples12.parse_ntriples12" ;
        a slkg:Function ;
        rdfs:comment """Parse N-Triples 1.2 text; return list of (s, p, o) triples.

Subjects and objects may be TripleTerm instances.""" ;
        rdfs:label "parse_ntriples12" ;
        slkg:calls ns15:_parse_nt_line ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/ntriples12.py" ;
        slkg:hasParameter ns15:parse_ntriples12.param.text ;
        slkg:hasReturnValue ns15:parse_ntriples12.returns ;
        slkg:lineEnd 284 ;
        slkg:lineStart 268 ;
        slkg:signature "def parse_ntriples12(text: str) -> list[tuple]" .

    ns15:parse_ntriples12.param.text a slkg:Parameter ;
        rdfs:comment "The N-Triples 1.2 document text to parse." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
