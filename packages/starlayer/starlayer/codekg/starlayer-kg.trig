        slkg:signature "def _register_ns(sg) -> None" .

    ns9:_register_ns.param.sg a slkg:Parameter ;
        rdfs:label "sg" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns9:_register_ns.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

