        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 83 ;
        slkg:lineStart 52 ;
        slkg:signature "def test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none() -> None" .

    ns261:test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns261:test_global_rule_runs_once_against_whole_graph dcterms:identifier "tests.shacl.integration.test_global_sparql_rules.test_global_rule_runs_once_against_whole_graph" ;
