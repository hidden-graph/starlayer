        a slkg:Method ;
        rdfs:comment """'^^<full-iri>' (as opposed to '^^prefixed:name') is ordinary
Turtle syntax - e.g. any canonical/no-prefixes document - but was
previously broken end to end (Turtle12SyntaxError: unexpected
trailing content), since split_obj_and_annotations's '^^'-suffix
handling only correctly consumed the prefixed-name form.""" ;
        rdfs:label "test_typed_literal_with_bracketed_iri_datatype" ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser.py" ;
