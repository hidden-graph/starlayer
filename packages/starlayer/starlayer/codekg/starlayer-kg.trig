GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/_syntax_checks.py> {
    ns48:_syntax_checks.py dcterms:identifier "starlayer.sparql._syntax_checks" ;
        a slkg:Module ;
        rdfs:comment """Syntax rules the SPARQL 1.2 grammar states but rdflib's parser never
enforces, checked here on the raw text or on rdflib's parse tree, before
translation. See ``docs/upstream-issues/rdflib-upstream-issues.md`` items 13
and 14 for a minimal example of each.

Not covered: a ``\\uXXXX`` escape spelling a keyword, and a ``SELECT``
expression variable that is already in scope in the ``WHERE`` pattern.""" ;
        rdfs:label "_syntax_checks" ;
        slkg:declares ns299:_walk, ns299:reject_surrogate_escapes, ns299:_as_list, ns299:_check_group_by_scope, ns299:SPARQLSyntaxError, ns299:check_parse_tree ;
        slkg:filePath "packages/starlayer/starlayer/sparql/_syntax_checks.py" ;
        slkg:importsModule ns4:rdflib.plugins.sparql.parserutils, ns4:__future__, ns4:rdflib, ns4:re .

