        slkg:position 0 .

    ns43:_strip_custom_extends.param.recipes a slkg:Parameter ;
        rdfs:comment "Mutated in place - accumulates (variable, expression) pairs for each stripped Extend, in dependency order." ;
        rdfs:label "recipes" ;
        slkg:annotationText "list" ;
        slkg:hasType ns4:builtins.list ;
        slkg:parameterKind "positional" ;
        slkg:position 2 .

    ns43:_strip_custom_extends.returns a slkg:ReturnValue ;
        rdfs:comment "``node`` with any matching Extend/Filter wrapper removed (replaced by its inner pattern), or ``node`` unchanged if it isn't a CompValue or doesn't match." ;
        slkg:annotationText "Any" ;
