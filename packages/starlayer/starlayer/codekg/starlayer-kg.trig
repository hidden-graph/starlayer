GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py> {
    ns111:test_manchester_ast_shapes.py dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes" ;
        a slkg:Module ;
        rdfs:comment """SHACL shape tests for the manch: vocabulary (see manchester_shapes.ttl/.py)
- mirrors the sibling starlayer.sparql package's test_shacl_shapes.py structure.

Two directions get tested:

1. Every representative document (imported from test_manchester_ast.DOCUMENTS,
   so this suite can't silently drift from what the encoder actually
   produces) encodes to a graph that *conforms*.
2. A handful of deliberately malformed graphs, built by mutating a valid
   encoded document, each *fail* validation for the specific structural
   reason the mutation introduces - not just "conforms is False somewhere".""" ;
        rdfs:label "test_manchester_ast_shapes" ;
        slkg:declares ns194:test_misc_axiom_item_of_wrong_family_fails, ns194:test_wrong_item_type_under_data_prop_range_clause_fails, ns194:test_broken_mid_chain_rdf_list_fails, ns194:test_valid_documents_conform, ns194:test_shapes_graph_is_valid_shacl_and_reusable, ns194:_encode_data_prop_range ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py" ;
        slkg:importsModule ns4:pytest, ns4:tests.graph.unit.test_manchester_ast, ns4:rdflib.collection, ns4:rdflib .

    ns194:_encode_data_prop_range dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes._encode_data_prop_range" ;
        a slkg:Function ;
        rdfs:label "_encode_data_prop_range" ;
        slkg:calls ns92:manchester_parse_to_tree ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py" ;
        slkg:isPrivate true ;
        slkg:lineEnd 47 ;
        slkg:lineStart 39 ;
        slkg:signature "def _encode_data_prop_range()" .

    ns194:test_broken_mid_chain_rdf_list_fails dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes.test_broken_mid_chain_rdf_list_fails" ;
        a slkg:Function ;
        rdfs:comment """A rdf:List missing rdf:first partway through must fail the generic
WellFormedListShape check - not just at the head.""" ;
        rdfs:label "test_broken_mid_chain_rdf_list_fails" ;
        slkg:calls ns194:_encode_data_prop_range, ns92:manchester_validate ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py" ;
        slkg:lineEnd 112 ;
        slkg:lineStart 97 ;
        slkg:signature "def test_broken_mid_chain_rdf_list_fails()" .

    ns194:test_misc_axiom_item_of_wrong_family_fails dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes.test_misc_axiom_item_of_wrong_family_fails" ;
        a slkg:Function ;
        rdfs:comment """A MiscEquivalentClassesAxiom's items must each be a manch:ClassExpression
(or a bare IRI) - substituting a manch:PropertyExpression-typed node (the
wrong family entirely) must be caught, even though MiscAxiom items are
bare values with no ClauseItem wrapper to hang a value-kind check off of
(see manch:ClassExpressionListShape, reused directly here).""" ;
        rdfs:label "test_misc_axiom_item_of_wrong_family_fails" ;
        slkg:calls ns92:manchester_parse_to_tree, ns92:manchester_validate ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py" ;
        slkg:lineEnd 94 ;
