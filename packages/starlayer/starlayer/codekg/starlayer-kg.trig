        slkg:calls ns18:classify_statement, ns18:split_statements ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_syntax.py" ;
        slkg:lineEnd 239 ;
        slkg:lineStart 225 ;
        slkg:signature "def test_directive_keyword_inside_long_string_not_misdetected(self)" .

