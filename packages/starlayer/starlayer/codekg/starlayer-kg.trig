    ns237:test_construct_rule_repeated_per_focus_node_matches_pyshacl_pattern dcterms:identifier "tests.graph.unit.test_query_prepare_cache.test_construct_rule_repeated_per_focus_node_matches_pyshacl_pattern" ;
