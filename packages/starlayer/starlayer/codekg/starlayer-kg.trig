    ns189:TestSparqlUpdateVersionDirective dcterms:identifier "tests.graph.unit.test_conformance.TestSparqlUpdateVersionDirective" ;
        a slkg:Class ;
        rdfs:comment """StarLayerGraph.update()/StarLayerDataset.update() - found 2026-10-13
to have the identical gap TestSparqlVersionDirective's own docstring
already documented for .query(): both called prepare_update_12()
directly with no VERSION-stripping at all, so a VERSION-prefixed
Update (legal per the same SPARQL 1.2 Query sec 4.3 prologue grammar
Update shares) raised a bare ParseException. Checked precisely which
entry points were actually affected before fixing (not assumed
symmetric with .query()) - StarLayerDataset.update()'s own *remote*
HTTP-store branch is unaffected (it POSTs text directly, no local
parse at all), only its local-store branch shares this bug with
StarLayerGraph.update().""" ;
        rdfs:label "TestSparqlUpdateVersionDirective" ;
        slkg:declares ns189:TestSparqlUpdateVersionDirective.test_update_no_version_directive_does_not_warn, ns189:TestSparqlUpdateVersionDirective.test_update_version_directive_no_longer_raises, ns189:TestSparqlUpdateVersionDirective.test_dataset_update_version_1_1_with_triple_term_warns, ns189:TestSparqlUpdateVersionDirective.test_update_version_1_1_with_triple_term_warns, ns189:TestSparqlUpdateVersionDirective.test_dataset_update_version_directive_no_longer_raises ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_conformance.py" ;
        slkg:lineEnd 156 ;
