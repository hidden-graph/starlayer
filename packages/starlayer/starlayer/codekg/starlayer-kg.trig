    ns4:builtins.tuple dcterms:identifier "builtins.tuple" ;
        a slkg:ExternalType ;
        rdfs:label "tuple" ;
        rdfs:subClassOf slkg:Type .

    ns4:rdflib a slkg:ExternalModule .

    ns4:xml.etree.ElementTree a slkg:ExternalModule .

    ns4:xml.etree.ElementTree.Element dcterms:identifier "xml.etree.ElementTree.Element" ;
        a slkg:ExternalType ;
        rdfs:label "Element" ;
        rdfs:subClassOf slkg:Type .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/srl_semantic_checks.py> {
    ns48:srl_semantic_checks.py dcterms:identifier "starlayer.sparql.srl_semantic_checks" ;
        a slkg:Module ;
        rdfs:comment """SRL §4.2 "Well-formedness Conditions" - e.g. ``SET(...)`` must
not reuse an already-bound variable, and every filter/assignment/head
variable must be bound. These conditions are cross-referential and
sequence-position-dependent (whether a variable is "already bound" depends
on every element before it in the same rule body), which SHACL's own
per-node shape model structurally can't express - so this lives here as a
function over the decoded ``srl_ast`` tree, not a SHACL shape.

Private: ``srl.parse_ruleset()`` runs ``_check_ruleset`` on every
successfully-parsed ``RuleSet`` and raises ``SRLParseError`` if any issue is
found - the same "one real gate" contract plain SPARQL's own
``prepareQuery()`` has (succeed with a usable object, or raise - never hand
back something that looks fine but silently misbehaves later). Without
this gate, a ruleset violating the "SET(...) must not reuse an already-
bound variable" condition parses *and evaluates* with zero error, just
silently rebinding the variable to the wrong value.

Implements the spec's own formalism directly and verbatim (not an
approximation): for a sequence of rule elements given an initial variable
set V0, ``Vi`` is V0 plus every variable contributed by elements before
position i, and ``Vall`` is V0 plus every variable contributed by the whole
sequence. A rule is well-formed iff its body is a well-formed sequence
(V0 = empty set) and every variable in a head triple template is in the
body's own ``Vall``. See each check function's docstring for the exact
per-element-kind condition it enforces.""" ;
        rdfs:label "srl_semantic_checks" ;
        slkg:declares ns62:_triple_vars, ns62:_triples_of, ns62:_has_aggregate, ns62:_SRLWellFormednessIssue, ns62:_check_ruleset, ns62:_expr_vars, ns62:_check_triple_term_positions, ns62:_check_rule, ns62:_check_sequence, ns62:_term_vars ;
        slkg:filePath "packages/starlayer/starlayer/sparql/srl_semantic_checks.py" ;
        slkg:importsModule ns4:__future__, ns4:rdflib.plugins.sparql, ns4:dataclasses, ns4:rdflib .

    ns62:_SRLWellFormednessIssue dcterms:identifier "starlayer.sparql.srl_semantic_checks._SRLWellFormednessIssue" ;
        a slkg:Class ;
        rdfs:label "_SRLWellFormednessIssue" ;
        slkg:filePath "packages/starlayer/starlayer/sparql/srl_semantic_checks.py" ;
        slkg:hasAttribute ns62:_SRLWellFormednessIssue.attr.context, ns62:_SRLWellFormednessIssue.attr.variable, ns62:_SRLWellFormednessIssue.attr.kind, ns62:_SRLWellFormednessIssue.attr.rule ;
        slkg:hasDecorator ns62:_SRLWellFormednessIssue.decorator.0 ;
        slkg:isPrivate true ;
        slkg:lineEnd 46 ;
        slkg:lineStart 40 .

    ns62:_SRLWellFormednessIssue.attr.context a slkg:Attribute ;
        rdfs:label "context" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:position 3 .

    ns62:_SRLWellFormednessIssue.attr.kind a slkg:Attribute ;
        rdfs:label "kind" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:position 1 .

    ns62:_SRLWellFormednessIssue.attr.rule a slkg:Attribute ;
        rdfs:label "rule" ;
        slkg:annotationText "srl_ast._Rule | None" ;
        slkg:hasType ns4:starlayer.sparql._srl_ast._Rule ;
        slkg:optional true ;
        slkg:position 0 .

    ns62:_SRLWellFormednessIssue.attr.variable a slkg:Attribute ;
        rdfs:label "variable" ;
        slkg:annotationText "Variable | None" ;
        slkg:hasType ns4:rdflib.term.Variable ;
        slkg:optional true ;
        slkg:position 2 .

    ns62:_SRLWellFormednessIssue.decorator.0 a slkg:Decorator ;
        slkg:decoratorText "dataclass(frozen=True)" ;
        slkg:position 0 .

    ns62:_check_rule dcterms:identifier "starlayer.sparql.srl_semantic_checks._check_rule" ;
        a slkg:Function ;
        rdfs:comment """§4.2: is ``rule`` a well-formed rule? Its body must be a well-formed
sequence given V0 = the empty set, and every variable in a head triple
template must be in the body's own ``Vall``.""" ;
        rdfs:label "_check_rule" ;
        slkg:calls ns62:_triple_vars, ns62:_check_sequence, ns62:_triples_of, ns62:_check_triple_term_positions ;
        slkg:filePath "packages/starlayer/starlayer/sparql/srl_semantic_checks.py" ;
        slkg:hasParameter ns62:_check_rule.param.rule ;
        slkg:hasReturnValue ns62:_check_rule.returns ;
        slkg:instantiates ns62:_SRLWellFormednessIssue ;
        slkg:isPrivate true ;
        slkg:lineEnd 199 ;
        slkg:lineStart 188 ;
        slkg:signature "def _check_rule(rule: srl_ast._Rule) -> list[_SRLWellFormednessIssue]" .

    ns62:_check_rule.param.rule a slkg:Parameter ;
        rdfs:label "rule" ;
        slkg:annotationText "srl_ast._Rule" ;
        slkg:hasType ns4:starlayer.sparql._srl_ast._Rule ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns62:_check_rule.returns a slkg:ReturnValue ;
        slkg:annotationText "list[_SRLWellFormednessIssue]" ;
        slkg:hasType ns4:builtins.list, ns62:_SRLWellFormednessIssue .

    ns62:_check_ruleset dcterms:identifier "starlayer.sparql.srl_semantic_checks._check_ruleset" ;
        a slkg:Function ;
        rdfs:comment """§4.2: ``ruleset`` is well-formed iff every rule in it is - the
per-rule issues found, flattened across all rules (empty list means
