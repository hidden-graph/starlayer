    ns61:SRLImportsNotSupportedError dcterms:identifier "starlayer.sparql.srl_eval.SRLImportsNotSupportedError" ;
        a slkg:Class ;
        rdfs:comment """§4.5: ``IMPORTS`` support is optional for SRL processors, but an
implementation that does not support it MUST reject a rule set
containing ``IMPORTS`` statements with an error - this project does
not yet resolve imports, so this is that required hard rejection.""" ;
        rdfs:label "SRLImportsNotSupportedError" ;
