    ns53:rdf_to_query dcterms:identifier "starlayer.sparql.from_rdf.rdf_to_query" ;
        a slkg:Function ;
        rdfs:comment """Decode ``root`` (as produced by ``to_rdf.query_to_rdf``) back into an
rdflib ``Query`` — same type ``prepareQuery``/``translateQuery`` return.

The returned ``Query``'s ``Prologue`` is reconstructed from
``salg:base``/``salg:prologuePrefix`` on ``root`` (see vocab.py's
"Prologue (BASE/PREFIX)" section) — this fixes real evaluation-time
behavior (``BASE``-relative ``IRI()``/``URI()`` builtin resolution), but
does *not* make ``algebra.translateAlgebra`` emit prefixed names: that
function never reads ``query.prologue`` at all, confirmed empirically,
so its output stays full-IRI-only regardless.""" ;
        rdfs:label "rdf_to_query" ;
        slkg:calls ns53:_decode_prologue, ns53:_decode, ns59:_reject_triple_term_pattern_subjects ;
        slkg:filePath "packages/starlayer/starlayer/sparql/from_rdf.py" ;
        slkg:hasParameter ns53:rdf_to_query.param.graph, ns53:rdf_to_query.param.root ;
        slkg:hasReturnValue ns53:rdf_to_query.returns ;
        slkg:lineEnd 172 ;
        slkg:lineStart 135 ;
        slkg:signature "def rdf_to_query(graph: Graph, root: BNode) -> Query" .

    ns53:rdf_to_query.param.graph a slkg:Parameter ;
        rdfs:comment "The graph holding the encoded query." ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns53:rdf_to_query.param.root a slkg:Parameter ;
        rdfs:comment "The query's root node, as returned by ``to_rdf.query_to_rdf``." ;
        rdfs:label "root" ;
        slkg:annotationText "BNode" ;
        slkg:hasType ns4:rdflib.term.BNode ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns53:rdf_to_query.returns a slkg:ReturnValue ;
        rdfs:comment "A fully reconstructed, evaluator-ready ``Query``." ;
        slkg:annotationText "Query" ;
        slkg:hasType ns4:rdflib.plugins.sparql.sparql.Query .

    ns53:rdf_to_update dcterms:identifier "starlayer.sparql.from_rdf.rdf_to_update" ;
        a slkg:Function ;
        rdfs:comment """Decode ``root`` (as produced by ``to_rdf.update_to_rdf``) back into an
rdflib ``Update`` — same type ``prepareUpdate``/``translateUpdate``
return, runnable via ``rdflib.plugins.sparql.update.evalUpdate``.

Unlike a Query's algebra, an Update operation's WHERE clause (Modify)
never gets the _vars/lazy bookkeeping pass in stock rdflib either —
``translateUpdate`` never calls ``_addVars``/``analyse`` the way
``translateQuery`` does for a SELECT/etc. — so there's nothing to
recompute here to match. The request's single shared Prologue (see
``update_to_rdf``) is reconstructed the same way as a Query's, and
assigned to every operation — ``evalUpdate`` reads ``u.prologue`` off
each operation individually, even though it's the same object for all
of them in a real ``prepareUpdate`` result too.""" ;
        rdfs:label "rdf_to_update" ;
        slkg:calls ns53:_decode_list_field, ns59:_reject_triple_term_pattern_subjects, ns53:_decode_prologue ;
        slkg:filePath "packages/starlayer/starlayer/sparql/from_rdf.py" ;
        slkg:hasParameter ns53:rdf_to_update.param.root, ns53:rdf_to_update.param.graph ;
        slkg:hasReturnValue ns53:rdf_to_update.returns ;
        slkg:lineEnd 207 ;
        slkg:lineStart 175 ;
        slkg:signature "def rdf_to_update(graph: Graph, root: BNode) -> Update" .

    ns53:rdf_to_update.param.graph a slkg:Parameter ;
        rdfs:comment "The graph holding the encoded update." ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns53:rdf_to_update.param.root a slkg:Parameter ;
        rdfs:comment "The update's root node, as returned by ``to_rdf.update_to_rdf``." ;
        rdfs:label "root" ;
        slkg:annotationText "BNode" ;
        slkg:hasType ns4:rdflib.term.BNode ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns53:rdf_to_update.returns a slkg:ReturnValue ;
        rdfs:comment "A fully reconstructed ``Update``." ;
        slkg:annotationText "Update" ;
        slkg:hasType ns4:rdflib.plugins.sparql.sparql.Update .

