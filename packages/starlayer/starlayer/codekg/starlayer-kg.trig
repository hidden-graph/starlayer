    ns66:sqe_tree_to_query dcterms:identifier "starlayer.sparql.sqe.from_rdf.sqe_tree_to_query" ;
        a slkg:Function ;
        rdfs:comment """Decode ``root`` (one of ``sqe:SelectQuery``/``sqe:AskQuery``/
``sqe:ConstructQuery``, as produced by
``to_rdf.sqe_parse_to_tree``) back into a real rdflib ``Query``.

The returned ``Query``'s own ``.prologue`` is empty (rdflib's default,
no prefixes) — execution never needs prefixes once every term is
already a resolved ``URIRef``. The *original* preserved prefixes live
on ``root`` itself (``salg:prologuePrefix``, via ``to_rdf.py``'s
``_encode_prologue``) and are read directly by ``to_text.py`` for
prefix-aware rendering, not threaded through here.""" ;
        rdfs:label "sqe_tree_to_query" ;
        slkg:calls ns66:_decode_query_cv, ns66:_query_name_for_root ;
        slkg:filePath "packages/starlayer/starlayer/sparql/sqe/from_rdf.py" ;
        slkg:hasParameter ns66:sqe_tree_to_query.param.graph, ns66:sqe_tree_to_query.param.root ;
        slkg:hasReturnValue ns66:sqe_tree_to_query.returns ;
        slkg:lineEnd 119 ;
        slkg:lineStart 98 ;
        slkg:signature "def sqe_tree_to_query(graph: Graph, root) -> Query" .

    ns66:sqe_tree_to_query.param.graph a slkg:Parameter ;
        rdfs:comment "The ``sqe:`` RDF graph containing ``root``." ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns66:sqe_tree_to_query.param.root a slkg:Parameter ;
        rdfs:comment "The query root node to decode." ;
        rdfs:label "root" ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

