    ql:call-chain-from a slkg:NamedQuery ;
        rdfs:comment "All functions and methods reachable from a symbol by following calls any number of steps (a property-path query). Large for entry points; narrow the symbol first." ;
        rdfs:label "Everything a function reaches through calls" ;
        slkg:aboutTopic ql:topic-call-graph ;
        slkg:answersCompetencyQuestion ql:cq-what-s-the-call-chain-from-entry ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of the starting function or method" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true
        ] ;
        slkg:queryRoot ql:call-chain-from-tree .

    ql:call-chain-from-tree a sqe:Query, sqe:SelectQuery ;
        sqe:distinct true ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "reached"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "reached"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:TriplePattern ;
            sqe:object "b"^^spexpr:Variable ;
            sqe:predicate [
                a spexpr:MulPath ;
                spexpr:mod "+" ;
                spexpr:path slkg:calls
            ] ;
            sqe:subject "a"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "a"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "reached"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "b"^^spexpr:Variable
        ] ) .

    ql:call-cycles a slkg:NamedQuery ;
        rdfs:comment "Direct two-step call cycles (A calls B and B calls A). Longer cycles are not found." ;
        rdfs:label "Pairs of functions that call each other" ;
        slkg:aboutTopic ql:topic-call-graph ;
        slkg:answersCompetencyQuestion ql:cq-are-there-call-cycles-a-calls-b ;
        slkg:queryRoot ql:call-cycles-tree .

    ql:call-cycles-tree a sqe:Query, sqe:SelectQuery ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "first"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "second"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "first"^^spexpr:Variable "second"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:TriplePattern ;
            sqe:object "b"^^spexpr:Variable ;
            sqe:predicate slkg:calls ;
            sqe:subject "a"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "a"^^spexpr:Variable ;
            sqe:predicate slkg:calls ;
            sqe:subject "b"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "first"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "a"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "second"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "b"^^spexpr:Variable
        ] [
            a sqe:Filter ;
            sqe:expr [
                a spexpr:RelationalExpression ;
                spexpr:expr [
                    a spexpr:Builtin_STR ;
                    spexpr:arg "a"^^spexpr:Variable
                ] ;
                spexpr:op "<"^^spexpr:PlainString ;
                spexpr:other [
                    a spexpr:Builtin_STR ;
                    spexpr:arg "b"^^spexpr:Variable
                ]
            ]
        ] ) .

    ql:callees-of a slkg:NamedQuery ;
        rdfs:comment "The direct callees of a symbol, from the call graph." ;
        rdfs:label "What does a function or method call?" ;
        slkg:aboutTopic ql:topic-call-graph ;
        slkg:answersCompetencyQuestion ql:cq-what-functions-methods-does-function-x-call ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a function or method" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true
        ] ;
        slkg:queryRoot ql:callees-of-tree .

    ql:callees-of-tree a sqe:Query, sqe:SelectQuery ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "callee"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "callee"^^spexpr:Variable "file"^^spexpr:Variable "line"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:TriplePattern ;
            sqe:object "t"^^spexpr:Variable ;
            sqe:predicate slkg:calls ;
            sqe:subject "c"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "c"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "callee"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "t"^^spexpr:Variable
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "file"^^spexpr:Variable ;
                sqe:predicate slkg:filePath ;
                sqe:subject "t"^^spexpr:Variable
            ] )
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "line"^^spexpr:Variable ;
                sqe:predicate slkg:lineStart ;
                sqe:subject "t"^^spexpr:Variable
            ] )
        ] ) .

    ql:callers-of a slkg:NamedQuery ;
        rdfs:comment "The direct callers of a symbol, from the call graph. No rows means no caller this extractor could resolve, which is a lead, not proof that nothing calls it." ;
        rdfs:label "Who calls a function or method?" ;
        slkg:aboutTopic ql:topic-call-graph ;
        slkg:answersCompetencyQuestion ql:cq-if-i-change-x-s-signature-what, ql:cq-what-calls-function-x-reverse-lookup ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a function or method" ;
            slkg:paramExample "starlayer.graph.model.encoding.tt_hash" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true
        ] ;
        slkg:queryRoot ql:callers-of-tree .

    ql:callers-of-tree a sqe:Query, sqe:SelectQuery ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "caller"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "caller"^^spexpr:Variable "file"^^spexpr:Variable "line"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:TriplePattern ;
            sqe:object "target"^^spexpr:Variable ;
            sqe:predicate slkg:calls ;
            sqe:subject "c"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "caller"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "c"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "target"^^spexpr:Variable
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "file"^^spexpr:Variable ;
                sqe:predicate slkg:filePath ;
                sqe:subject "c"^^spexpr:Variable
            ] )
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "line"^^spexpr:Variable ;
                sqe:predicate slkg:lineStart ;
                sqe:subject "c"^^spexpr:Variable
            ] )
        ] ) .

    ql:capabilities a slkg:NamedQuery ;
        rdfs:comment "The curated capability list with the symbols that implement each, optionally limited to words in the capability text. Capabilities with no implementing symbol are roadmap items or are implemented by a SHACL or OWL file." ;
        rdfs:label "What StarLayer does, and which code does it" ;
        slkg:aboutTopic ql:topic-capabilities ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "only capabilities whose description contains this, case-insensitive" ;
            slkg:paramExample "SHACL" ;
            slkg:paramName "text" ;
            slkg:paramRequired false
        ] ;
        slkg:queryRoot ql:capabilities-tree .

    ql:capabilities-by-role a slkg:NamedQuery ;
        rdfs:comment "The capabilities tagged with an app role (storage, interchange, query, validate, infer, ui-generate or reference), with the symbols that implement each. Start here when you know what the app must do but not which StarLayer parts to use." ;
        rdfs:label "Which capabilities serve a job when building an app?" ;
        slkg:aboutTopic ql:topic-capabilities ;
        slkg:answersCompetencyQuestion ql:cq-which-capabilities-serve-a-job-when-building-an-app ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "the job: storage, interchange, query, validate, infer, ui-generate or reference" ;
            slkg:paramExample "ui-generate" ;
            slkg:paramName "role" ;
            slkg:paramRequired true
        ] ;
        slkg:queryRoot ql:capabilities-by-role-tree .

    ql:capabilities-by-role-tree a sqe:SelectQuery, sqe:Query ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "area"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "capability"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "symbol"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "area"^^spexpr:Variable "capability"^^spexpr:Variable "status"^^spexpr:Variable "symbol"^^spexpr:Variable "file"^^spexpr:Variable "line"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:TriplePattern ;
            sqe:object slkg:Capability ;
            sqe:predicate rdf:type ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "a"^^spexpr:Variable ;
            sqe:predicate slkg:inCapabilityArea ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "capability"^^spexpr:Variable ;
            sqe:predicate rdfs:comment ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "role"^^spexpr:Variable ;
            sqe:predicate slkg:appRole ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "status"^^spexpr:Variable ;
            sqe:predicate slkg:hasStatus ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "area"^^spexpr:Variable ;
            sqe:predicate rdfs:label ;
            sqe:subject "a"^^spexpr:Variable
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "symbol"^^spexpr:Variable ;
                sqe:predicate slkg:implementedByIdentifier ;
                sqe:subject "cap"^^spexpr:Variable
            ] [
                a sqe:Optional ;
                sqe:where ( [
                    a sqe:TriplePattern ;
                    sqe:object "symbol"^^spexpr:Variable ;
                    sqe:predicate dcterms:identifier ;
                    sqe:subject "s"^^spexpr:Variable
                ] [
                    a sqe:Optional ;
                    sqe:where ( [
                        a sqe:TriplePattern ;
                        sqe:object "file"^^spexpr:Variable ;
                        sqe:predicate slkg:filePath ;
                        sqe:subject "s"^^spexpr:Variable
                    ] )
                ] [
                    a sqe:Optional ;
                    sqe:where ( [
                        a sqe:TriplePattern ;
                        sqe:object "line"^^spexpr:Variable ;
                        sqe:predicate slkg:lineStart ;
                        sqe:subject "s"^^spexpr:Variable
                    ] )
                ] )
            ] )
        ] ) .

    ql:capabilities-by-specification a slkg:NamedQuery ;
        rdfs:comment "The capabilities that implement a W3C specification (wholly or in part), with the symbols that implement each; optionally limited to specifications whose IRI contains some text, such as shacl12-core or sparql12." ;
        rdfs:label "Which capabilities implement a specification?" ;
        slkg:aboutTopic ql:topic-capabilities ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "only specifications whose IRI contains this, case-insensitive" ;
            slkg:paramExample "shacl12" ;
            slkg:paramName "spec" ;
            slkg:paramRequired false
        ] ;
        slkg:queryRoot ql:capabilities-by-specification-tree .

    ql:capabilities-by-specification-tree a sqe:Query, sqe:SelectQuery ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "specification"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "area"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "capability"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "symbol"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "area"^^spexpr:Variable "capability"^^spexpr:Variable "status"^^spexpr:Variable "specification"^^spexpr:Variable "symbol"^^spexpr:Variable "file"^^spexpr:Variable "line"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:Values ;
            sqe:rows ( ( sqe:undef ) ) ;
            sqe:vars ( "spec"^^spexpr:Variable )
        ] [
            a sqe:TriplePattern ;
            sqe:object slkg:Capability ;
            sqe:predicate rdf:type ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "a"^^spexpr:Variable ;
            sqe:predicate slkg:inCapabilityArea ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "capability"^^spexpr:Variable ;
            sqe:predicate rdfs:comment ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "status"^^spexpr:Variable ;
            sqe:predicate slkg:hasStatus ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "specification"^^spexpr:Variable ;
            sqe:predicate slkg:implementsSpecification ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "area"^^spexpr:Variable ;
            sqe:predicate rdfs:label ;
            sqe:subject "a"^^spexpr:Variable
        ] [
            a sqe:Filter ;
            sqe:expr [
                a spexpr:ConditionalOrExpression ;
                spexpr:expr [
                    a spexpr:UnaryNot ;
                    spexpr:expr [
                        a spexpr:Builtin_BOUND ;
                        spexpr:arg "spec"^^spexpr:Variable
                    ]
                ] ;
                spexpr:other ( [
                    a spexpr:Builtin_CONTAINS ;
                    spexpr:arg1 [
                        a spexpr:Builtin_LCASE ;
                        spexpr:arg [
                            a spexpr:Builtin_STR ;
                            spexpr:arg "specification"^^spexpr:Variable
                        ]
                    ] ;
                    spexpr:arg2 [
                        a spexpr:Builtin_LCASE ;
                        spexpr:arg "spec"^^spexpr:Variable
                    ]
                ] )
            ]
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "symbol"^^spexpr:Variable ;
                sqe:predicate slkg:implementedByIdentifier ;
                sqe:subject "cap"^^spexpr:Variable
            ] [
                a sqe:Optional ;
                sqe:where ( [
                    a sqe:TriplePattern ;
                    sqe:object "symbol"^^spexpr:Variable ;
                    sqe:predicate dcterms:identifier ;
                    sqe:subject "s"^^spexpr:Variable
                ] [
                    a sqe:Optional ;
                    sqe:where ( [
                        a sqe:TriplePattern ;
                        sqe:object "file"^^spexpr:Variable ;
                        sqe:predicate slkg:filePath ;
                        sqe:subject "s"^^spexpr:Variable
                    ] )
                ] [
                    a sqe:Optional ;
                    sqe:where ( [
                        a sqe:TriplePattern ;
                        sqe:object "line"^^spexpr:Variable ;
                        sqe:predicate slkg:lineStart ;
                        sqe:subject "s"^^spexpr:Variable
                    ] )
                ] )
            ] )
        ] ) .

