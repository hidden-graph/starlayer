    ns299:_walk dcterms:identifier "starlayer.sparql._syntax_checks._walk" ;
        a slkg:Function ;
        rdfs:comment "Yield every ``CompValue`` under ``node`` (including ``node``)." ;
        rdfs:label "_walk" ;
        slkg:calls ns299:_walk ;
        slkg:filePath "packages/starlayer/starlayer/sparql/_syntax_checks.py" ;
