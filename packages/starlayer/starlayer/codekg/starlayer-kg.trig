        a slkg:Function ;
        rdfs:comment """A plain rdflib.Graph used to be silently accepted, normalized into a
*new*, disconnected StarLayerGraph - so apply_rules()'s in-place
mutation guarantee (result.data_graph is the object you passed in)
silently didn't hold for this input type. Reject it instead of letting
that divergence pass quietly.""" ;
        rdfs:label "test_apply_rules_rejects_plain_rdflib_graph_data_graph" ;
        slkg:filePath "packages/starlayer/tests/shacl/unit/test_validator.py" ;
