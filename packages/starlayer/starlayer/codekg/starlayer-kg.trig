        slkg:declares ns238:TestRoundtripResultEquivalence.test_original_prefix_survives_into_rendered_text, ns238:TestRoundtripResultEquivalence.test_rdf_roundtrip, ns238:TestRoundtripResultEquivalence.test_text_roundtrip ;
