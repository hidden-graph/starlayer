        slkg:annotationText "list[_SRLWellFormednessIssue]" ;
        slkg:hasType ns62:_SRLWellFormednessIssue, ns4:builtins.list .

    ns62:_check_sequence dcterms:identifier "starlayer.sparql.srl_semantic_checks._check_sequence" ;
        a slkg:Function ;
        rdfs:comment """Checks ``elements`` as a well-formed sequence given initial variables
