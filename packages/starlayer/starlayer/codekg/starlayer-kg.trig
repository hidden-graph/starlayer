GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/w3c_shacl12/comparison.py> {
    ns100:comparison.py dcterms:identifier "tests.shacl.w3c_shacl12.comparison" ;
        a slkg:Module ;
        rdfs:comment """Blank-node-identity-independent comparison of sh:ValidationReport graphs.

Neither starlayer.shacl's actual report nor the W3C suite's expected report
promises stable blank-node identifiers (for sh:result nodes, or for
structured values like SHACL paths or RDF-1.2 triple terms nested under
sh:value/sh:resultPath) - comparing by raw term equality would spuriously
fail on every blank node. term_key() instead fingerprints a blank node by its
own outgoing-triple structure, recursively, so two differently-labeled but
structurally identical blank-node values compare equal.""" ;
        rdfs:label "comparison" ;
        slkg:declares ns104:find_report_node, ns104:result_multiset, ns104:conforms_of, ns104:term_key ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/comparison.py" ;
        slkg:importsModule ns4:rdflib.term, ns4:rdflib.namespace, ns4:__future__, ns4:collections, ns4:rdflib .

    ns104:conforms_of dcterms:identifier "tests.shacl.w3c_shacl12.comparison.conforms_of" ;
        a slkg:Function ;
        rdfs:label "conforms_of" ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/comparison.py" ;
        slkg:hasParameter ns104:conforms_of.param.graph, ns104:conforms_of.param.report_node ;
        slkg:hasReturnValue ns104:conforms_of.returns ;
        slkg:lineEnd 66 ;
        slkg:lineStart 62 ;
        slkg:signature "def conforms_of(graph: Graph, report_node: Node) -> bool" .

    ns104:conforms_of.param.graph a slkg:Parameter ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns104:conforms_of.param.report_node a slkg:Parameter ;
        rdfs:label "report_node" ;
        slkg:annotationText "Node" ;
        slkg:hasType ns4:rdflib.term.Node ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns104:conforms_of.returns a slkg:ReturnValue ;
        slkg:annotationText "bool" ;
        slkg:hasType ns4:builtins.bool .

    ns104:find_report_node dcterms:identifier "tests.shacl.w3c_shacl12.comparison.find_report_node" ;
        a slkg:Function ;
        rdfs:comment """Find the real, top-level sh:ValidationReport node.

Usually there's exactly one. But for a self-referential W3C-suite
fixture (sht:dataGraph <> loading the whole document, including its own
mf:result expected-result block - itself a well-formed
sh:ValidationReport structure) a *real* violation's sh:value/sh:focusNode
can coincidentally equal that embedded block, and pySHACL's own report
construction copies its triples into the actual report graph as part of
representing that value - producing a second, incidental
sh:ValidationReport-typed node. Disambiguated the same way
starlayer.shacl.validator._find_genuine_report_node does: the real
report is always a fresh node nothing else in the graph points to;
an incidental one was pulled in specifically because something else
references it.""" ;
        rdfs:label "find_report_node" ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/comparison.py" ;
        slkg:hasParameter ns104:find_report_node.param.graph ;
        slkg:hasReturnValue ns104:find_report_node.returns ;
        slkg:lineEnd 59 ;
        slkg:lineStart 36 ;
        slkg:signature "def find_report_node(graph: Graph) -> Node" .

    ns104:find_report_node.param.graph a slkg:Parameter ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns104:find_report_node.returns a slkg:ReturnValue ;
        slkg:annotationText "Node" ;
        slkg:hasType ns4:rdflib.term.Node .

    ns104:result_multiset dcterms:identifier "tests.shacl.w3c_shacl12.comparison.result_multiset" ;
        a slkg:Function ;
        rdfs:comment """Fingerprint each sh:result as (focusNode, resultPath, sourceConstraintComponent, value, severity).

sh:sourceShape is deliberately excluded - see
docs/w3c-shacl12-test-suite-plan.md's "Open questions" section: neither
implementation's sourceShape blank-node identity is guaranteed to match,
and unlike the other fields a blank-node sourceShape's own structure
(the whole shape definition) isn't a meaningful fingerprint to compare -
two different shapes can be structurally different yet both correctly
produce a given violation.""" ;
        rdfs:label "result_multiset" ;
        slkg:calls ns104:term_key ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/comparison.py" ;
        slkg:hasParameter ns104:result_multiset.param.report_node, ns104:result_multiset.param.graph ;
        slkg:hasReturnValue ns104:result_multiset.returns ;
        slkg:lineEnd 95 ;
        slkg:lineStart 69 ;
        slkg:signature "def result_multiset(graph: Graph, report_node: Node) -> Counter" .

    ns104:result_multiset.param.graph a slkg:Parameter ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns104:result_multiset.param.report_node a slkg:Parameter ;
        rdfs:label "report_node" ;
        slkg:annotationText "Node" ;
        slkg:hasType ns4:rdflib.term.Node ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns104:result_multiset.returns a slkg:ReturnValue ;
        slkg:annotationText "Counter" ;
        slkg:hasType ns4:collections.Counter .

    ns104:term_key dcterms:identifier "tests.shacl.w3c_shacl12.comparison.term_key" ;
        a slkg:Function ;
        rdfs:label "term_key" ;
        slkg:calls ns104:term_key ;
        slkg:filePath "packages/starlayer/tests/shacl/w3c_shacl12/comparison.py" ;
        slkg:hasParameter ns104:term_key.param.graph, ns104:term_key.param.term ;
        slkg:hasReturnValue ns104:term_key.returns ;
        slkg:lineEnd 33 ;
        slkg:lineStart 25 ;
        slkg:signature "def term_key(graph: Graph, term: Node | None) -> TermKey | None" .

    ns104:term_key.param.graph a slkg:Parameter ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns104:term_key.param.term a slkg:Parameter ;
        rdfs:label "term" ;
        slkg:annotationText "Node | None" ;
        slkg:hasType ns4:rdflib.term.Node ;
        slkg:optional true ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns104:term_key.returns a slkg:ReturnValue ;
        slkg:annotationText "TermKey | None" ;
        slkg:hasType ns4:TermKey ;
        slkg:optional true .

    ns4:TermKey dcterms:identifier "TermKey" ;
        a slkg:ExternalType ;
        rdfs:label "TermKey" ;
        rdfs:subClassOf slkg:Type .

    ns4:__future__ a slkg:ExternalModule .

    ns4:builtins.bool dcterms:identifier "builtins.bool" ;
        a slkg:ExternalType ;
        rdfs:label "bool" ;
        rdfs:subClassOf slkg:Type .

    ns4:collections a slkg:ExternalModule .

    ns4:collections.Counter dcterms:identifier "collections.Counter" ;
        a slkg:ExternalType ;
        rdfs:label "Counter" ;
        rdfs:subClassOf slkg:Type .

    ns4:rdflib a slkg:ExternalModule .

    ns4:rdflib.graph.Graph dcterms:identifier "rdflib.graph.Graph" ;
        a slkg:ExternalType ;
        rdfs:label "Graph" ;
        rdfs:subClassOf slkg:Type .

    ns4:rdflib.namespace a slkg:ExternalModule .

    ns4:rdflib.term a slkg:ExternalModule .

    ns4:rdflib.term.Node dcterms:identifier "rdflib.term.Node" ;
        a slkg:ExternalType ;
        rdfs:label "Node" ;
        rdfs:subClassOf slkg:Type .
}

