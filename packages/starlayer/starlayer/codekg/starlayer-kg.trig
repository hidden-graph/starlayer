    ns76:_build_class_component.ClassConstraintComponent dcterms:identifier "starlayer.shacl.native_components._build_class_component.ClassConstraintComponent" ;
        a slkg:Class ;
        rdfs:comment """Shadows pySHACL's own ``ClassConstraintComponent`` to add SHACL
1.2's list-valued ``sh:class`` (union of choices - a value matches
if it's a SHACL instance of *any* class in the list). Multiple
separate ``sh:class`` triples on one shape remain AND'd together
(pySHACL's own pre-existing semantics) - each triple's value can
independently be a plain IRI (one required class) or a list
(any-of-these), combined with AND across triples.

If none of the shape's ``sh:class`` values are list-valued, this
delegates entirely to a real instance of pySHACL's own component
for byte-for-byte parity (its transitive-subclass walk and
Literal/debug-logging behavior are non-trivial to reproduce by
hand) - native evaluation only kicks in once a list value is
present, the case with no prior pySHACL behavior to match.""" ;
        rdfs:label "ClassConstraintComponent" ;
        rdfs:subClassOf ns4:pyshacl.constraints.constraint_component.ConstraintComponent ;
        slkg:declares ns76:_build_class_component.ClassConstraintComponent.__init__, ns76:_build_class_component.ClassConstraintComponent.constraint_name, ns76:_build_class_component.ClassConstraintComponent.evaluate, ns76:_build_class_component.ClassConstraintComponent.constraint_parameters ;
        slkg:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        slkg:lineEnd 1700 ;
        slkg:lineStart 1614 .

