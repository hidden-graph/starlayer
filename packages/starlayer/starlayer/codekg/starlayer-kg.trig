        rdfs:comment "The ``\"text\"@lang--dir`` syntax for a dirlang-encoded Literal (see ``_dirlang_n3``); otherwise whatever the base class returns." .

    ns70:_AlgebraTranslator12.sparql_query_text dcterms:identifier "starlayer.sparql.serialize12._AlgebraTranslator12.sparql_query_text" ;
