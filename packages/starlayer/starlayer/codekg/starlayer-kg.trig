    ns195:TestFromRdflibDataset dcterms:identifier "tests.graph.unit.test_starlayer_graph.TestFromRdflibDataset" ;
        a slkg:Class ;
        rdfs:comment """from_rdflib() used to crash on a Dataset/ConjunctiveGraph input:
_skolemize_encoding did bare ``for s, p, o in g:`` iteration, but
Dataset.__iter__ yields 4-tuples (s, p, o, context), not 3 - ValueError:
too many values to unpack. Fixed by reading via
g.triples((None, None, None)) instead (what Graph.__iter__ itself does
under the hood), which for a Dataset correctly respects its own
default_union setting rather than crashing or silently unioning
regardless of it.""" ;
        rdfs:label "TestFromRdflibDataset" ;
        slkg:declares ns195:TestFromRdflibDataset.test_default_union_true_sees_all_graphs, ns195:TestFromRdflibDataset.test_default_union_false_sees_only_default_graph ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_starlayer_graph.py" ;
        slkg:lineEnd 446 ;
        slkg:lineStart 413 .

    ns195:TestFromRdflibDataset.test_default_union_false_sees_only_default_graph dcterms:identifier "tests.graph.unit.test_starlayer_graph.TestFromRdflibDataset.test_default_union_false_sees_only_default_graph" ;
        a slkg:Method ;
        rdfs:label "test_default_union_false_sees_only_default_graph" ;
        slkg:calls ns28:StarLayerGraph.from_rdflib ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_starlayer_graph.py" ;
        slkg:lineEnd 434 ;
        slkg:lineStart 424 ;
        slkg:signature "def test_default_union_false_sees_only_default_graph(self)" .

