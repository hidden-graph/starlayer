    ns80:target_nodes dcterms:identifier "starlayer.shacl.engine.core.target_nodes" ;
        a slkg:Function ;
        rdfs:comment """Resolve ``shape_node``'s SHACL targets against ``data_graph``.

``shacl_graph=None`` falls back to ``data_graph`` itself - matching
``validate()``'s own "data graph doubles as shapes graph" allowance,
for a data file carrying its own embedded shapes.

``shacl_graph``'s own declared ``sh:entailment`` regime(s) (SHACL 1.2
Core sec 1.4), plus the optional ``inference=`` keyword (same
``ENTAILMENT.*`` vocabulary), are applied once, up front, onto a
private, non-mutating copy of ``data_graph`` - computed over
``data_graph`` union ``ont_graph`` when given (so an axiom declared
only in ``ont_graph``, e.g. ``rdfs:domain``, actually widens
``sh:targetClass`` membership), but only the newly-entailed delta is
materialized - ``ont_graph``'s own raw triples are never copied in.
Neither ``data_graph`` nor ``ont_graph`` is mutated. A no-op when
neither is declared nor passed (the common case).""" ;
        rdfs:label "target_nodes" ;
        slkg:calls ns88:normalize_graph_inputs, ns85:apply_entailment ;
        slkg:filePath "packages/starlayer/starlayer/shacl/engine/core.py" ;
        slkg:hasParameter ns80:target_nodes.param.data_graph, ns80:target_nodes.param.shape_node, ns80:target_nodes.param.shacl_graph, ns80:target_nodes.param.ont_graph, ns80:target_nodes.param.inference ;
        slkg:hasReturnValue ns80:target_nodes.returns ;
        slkg:lineEnd 100 ;
        slkg:lineStart 26 ;
        slkg:signature "def target_nodes(*, data_graph: Any, shacl_graph: Any | None=None, shape_node: Any, ont_graph: Any | None=None, inference: Any | None=None) -> tuple[Any, ...]" .

    ns80:target_nodes.param.data_graph a slkg:Parameter ;
        rdfs:comment "The graph to resolve targets against." ;
        rdfs:label "data_graph" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "kwonly" ;
        slkg:position 0 .

    ns80:target_nodes.param.inference a slkg:Parameter ;
        rdfs:comment "An optional ``ENTAILMENT.*`` IRI (or iterable of them) to apply alongside any regime(s) ``shacl_graph`` itself declares." ;
