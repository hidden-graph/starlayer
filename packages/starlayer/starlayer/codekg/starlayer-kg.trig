    ns57:_encode_where_group dcterms:identifier "starlayer.sparql.to_ssyn_rdf._encode_where_group" ;
        a slkg:Function ;
        rdfs:comment """Encode a ``GroupGraphPatternSub`` as a flat, ordered rdf:List of
sibling pattern elements — its ``.part`` is already exactly this shape
in the raw parse tree, just walked here instead of copied as-is, since
each element still needs its own contents simplified/encoded.

A ``TriplesBlock`` sibling splices in *multiple* nodes (one per real
triple, via ``algebra.triples``' own grouping) rather than one wrapper
node — each triple reads more naturally as its own flat sibling than as
a member of a BGP-shaped sub-list, matching this layer's "no more
verbose than the text" goal.""" ;
        rdfs:label "_encode_where_group" ;
        slkg:calls ns57:_build_rdf_list, ns57:_encode_triple_pattern, ns57:_encode_where_element ;
        slkg:filePath "packages/starlayer/starlayer/sparql/to_ssyn_rdf.py" ;
        slkg:hasParameter ns57:_encode_where_group.param.graph, ns57:_encode_where_group.param.group ;
        slkg:hasReturnValue ns57:_encode_where_group.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 152 ;
        slkg:lineStart 125 ;
