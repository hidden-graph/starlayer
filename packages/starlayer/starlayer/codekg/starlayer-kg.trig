        a slkg:Function ;
        rdfs:comment """Return the algebra node replacing one BGP: a Join of a "simple" BGP
(every triple whose entailment is exactly one alternative, folded
together for efficiency, matching what a plain BGP already does) with
one Union node per triple that needs multiple alternatives (currently
only rdf:type, via rdfs9+rdfs2+rdfs3).""" ;
        rdfs:label "_rewrite_bgp" ;
        slkg:calls ns51:_type_union ;
        slkg:filePath "packages/starlayer/starlayer/sparql/entailment_rdfs.py" ;
        slkg:hasParameter ns51:_rewrite_bgp.param.bgp, ns51:_rewrite_bgp.param.fresh ;
        slkg:hasReturnValue ns51:_rewrite_bgp.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 127 ;
        slkg:lineStart 83 ;
        slkg:signature "def _rewrite_bgp(bgp: CompValue, fresh: itertools.count) -> CompValue" .

    ns51:_rewrite_bgp.param.bgp a slkg:Parameter ;
        rdfs:comment "The BGP algebra node to rewrite." ;
        rdfs:label "bgp" ;
        slkg:annotationText "CompValue" ;
        slkg:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue ;
        slkg:parameterKind "positional" ;
