                    spexpr:arg2 "prefix"^^spexpr:Variable
                ] )
            ]
        ] [
            a sqe:Filter ;
            sqe:expr [
                a sqe:Exists ;
                sqe:negated true ;
                sqe:where ( [
                    a sqe:TriplePattern ;
                    sqe:object true ;
