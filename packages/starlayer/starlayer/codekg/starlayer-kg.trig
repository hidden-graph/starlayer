            sqe:vars ( "prefix"^^spexpr:Variable )
        ] [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "f"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "type"^^spexpr:Variable ;
            sqe:predicate rdf:type ;
            sqe:subject "f"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "file"^^spexpr:Variable ;
            sqe:predicate slkg:filePath ;
            sqe:subject "f"^^spexpr:Variable
        ] [
            a sqe:Filter ;
            sqe:expr [
                a spexpr:RelationalExpression ;
                spexpr:expr "type"^^spexpr:Variable ;
                spexpr:op "IN"^^spexpr:PlainString ;
                spexpr:other ( slkg:Function slkg:Method )
            ]
        ] [
            a sqe:Filter ;
            sqe:expr [
                a spexpr:Builtin_STRSTARTS ;
                spexpr:arg1 "file"^^spexpr:Variable ;
