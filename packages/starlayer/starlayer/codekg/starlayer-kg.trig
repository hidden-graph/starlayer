erty [ sh:path ex:p ; sh:lessThanOrEquals ( ex:q ex:r ) ] .\\n            '), ('sh:closed sh:ByTypes', '\\n            @prefix ex: <http://example.org/> . @prefix sh: <http://www.w3.org/ns/shacl#> .\\n            ex:S a sh:NodeShape ; sh:targetClass ex:Record ; sh:closed sh:ByTypes .\\n            ')])" ;
