    ns279:_bare_name_call_candidates dcterms:identifier "starlayer.codekg.extractor.visitor._bare_name_call_candidates" ;
        a slkg:Function ;
        rdfs:comment """Candidate full dotted paths for a bare ``name()`` call, innermost
scope outward: a helper nested directly inside the calling function
itself, then each progressively-shallower enclosing scope (e.g. a
sibling method on the same class), then the bare module level.
Approximates Python's own lexical scoping for the common cases - not a
full closure-resolution implementation (see this module's own
docstring and the plan this was built against).""" ;
        rdfs:label "_bare_name_call_candidates" ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/visitor.py" ;
        slkg:hasParameter ns279:_bare_name_call_candidates.param.calling_fn_nesting_path, ns279:_bare_name_call_candidates.param.name, ns279:_bare_name_call_candidates.param.module_dotted_path ;
        slkg:hasReturnValue ns279:_bare_name_call_candidates.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 853 ;
        slkg:lineStart 839 ;
