GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/query/version_directive.py> {
    ns33:version_directive.py dcterms:identifier "starlayer.graph.query.version_directive" ;
        a slkg:Module ;
        rdfs:comment """SPARQL 1.2 Query prologue's optional ``VERSION "label"`` directive
(SPARQL 1.2 Query sec 4.3), e.g. the spec's own example::

    VERSION "1.2"
    PREFIX : <http://example/>
    SELECT ...

Not real SPARQL 1.1 syntax at all — rdflib's parser (and
``starlayer.sparql``'s own grammar, which extends it) has no notion of this
directive and raises a ``ParseException`` on it unconditionally, so it must
always be stripped before ordinary parsing, regardless of pipeline or
backend.

**``VERSION`` is not always the first token.** Per the real grammar
(``tests/graph/vendor/spec_snapshots/sparql12-query.txt``):
``Prologue ::= ( BaseDecl | PrefixDecl | VersionDecl )*`` - the three
prologue declaration kinds may appear in *any* order and ``VersionDecl`` may
appear more than once. That's why this module scans the whole leading
prologue token-by-token (recognizing ``BaseDecl``/``PrefixDecl`` well enough
to skip over them unmodified, removing only ``VersionDecl`` tokens wherever
they appear) rather than anchor-matching ``VERSION`` as the very first
token of the document, which the grammar does not guarantee.

Kept as its own small, self-contained module (not part of the retired
``sparql12_to_11.py`` text rewriter it used to live in): a prologue-only
token scan has none of the nested/ambiguous-structure fragility (ordering-
sensitive splicing, join-order bugs) that motivated replacing the rest of
that module with a real grammar/algebra pipeline — there's no *query body*
structure to get wrong here, only the three known prologue declaration
shapes to recognize and either pass through (``BaseDecl``/``PrefixDecl``) or
remove (``VersionDecl``).

See ``starlayer.graph.model.conformance`` for what happens with the extracted
label (a warning, never a hard error, if it doesn't match what the query
actually uses), and ``starlayer.graph.backends.native.check_native_version_conformance``
for the equivalent used by the native rdf-1.2 backend, which sends VERSION
straight through to the endpoint unmodified instead of stripping it.""" ;
        rdfs:label "version_directive" ;
        slkg:declares ns41:contains_triple_term, ns41:strip_version_directive ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/version_directive.py" ;
        slkg:importsModule ns4:re, ns4:__future__ .

    ns41:contains_triple_term dcterms:identifier "starlayer.graph.query.version_directive.contains_triple_term" ;
        a slkg:Function ;
        rdfs:comment """Recursively check whether a parsed SPARQL 1.2 parse tree/algebra
contains a ``TripleTermNode`` anywhere — used for VERSION-directive
conformance checking (see ``starlayer.graph.model.conformance``). More
reliable than a text-presence heuristic: this walks the real parsed
structure, so it can't be fooled by e.g. ``<<(`` appearing inside a
string literal or comment.""" ;
        rdfs:label "contains_triple_term" ;
        slkg:calls ns41:contains_triple_term ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/version_directive.py" ;
        slkg:hasParameter ns41:contains_triple_term.param.node ;
        slkg:hasReturnValue ns41:contains_triple_term.returns ;
        slkg:lineEnd 122 ;
        slkg:lineStart 97 ;
        slkg:signature "def contains_triple_term(node) -> bool" .

    ns41:contains_triple_term.param.node a slkg:Parameter ;
        rdfs:comment "A parse tree/algebra node, list, tuple, or leaf value to search." ;
        rdfs:label "node" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns41:contains_triple_term.returns a slkg:ReturnValue ;
        rdfs:comment "True if a ``TripleTermNode`` appears anywhere in ``node``." ;
        slkg:annotationText "bool" ;
        slkg:hasType ns4:builtins.bool .

    ns41:strip_version_directive dcterms:identifier "starlayer.graph.query.version_directive.strip_version_directive" ;
        a slkg:Function ;
        rdfs:comment """Strip every ``VERSION "label"`` directive out of the leading
prologue, leaving any ``BASE``/``PREFIX`` declarations - and their
original relative order - untouched.

If more than one ``VersionDecl`` is present (legal per the grammar's own
``( ... )*``, though the spec gives no precedence rule for it), the
*last* one scanned is returned - an arbitrary but documented choice for
a case real queries are not expected to actually use.""" ;
        rdfs:label "strip_version_directive" ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/version_directive.py" ;
        slkg:hasParameter ns41:strip_version_directive.param.query ;
        slkg:hasReturnValue ns41:strip_version_directive.returns ;
        slkg:lineEnd 94 ;
        slkg:lineStart 56 ;
        slkg:signature "def strip_version_directive(query: str) -> tuple[str, str | None]" .

    ns41:strip_version_directive.param.query a slkg:Parameter ;
        rdfs:comment "The raw SPARQL 1.2 query/update text, possibly carrying one or more leading ``VERSION`` directives." ;
        rdfs:label "query" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns41:strip_version_directive.returns a slkg:ReturnValue ;
        rdfs:comment "A ``(stripped_query, label)`` tuple: the query text with every ``VersionDecl`` removed, and the declared version label, or ``None`` if no ``VERSION`` directive was present." ;
        slkg:annotationText "tuple[str, str | None]" ;
        slkg:hasType ns4:builtins.tuple, ns4:builtins.str .

    ns4:__future__ a slkg:ExternalModule .

    ns4:builtins.bool dcterms:identifier "builtins.bool" ;
        a slkg:ExternalType ;
        rdfs:label "bool" ;
        rdfs:subClassOf slkg:Type .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a slkg:ExternalType ;
        rdfs:label "str" ;
        rdfs:subClassOf slkg:Type .

    ns4:builtins.tuple dcterms:identifier "builtins.tuple" ;
        a slkg:ExternalType ;
        rdfs:label "tuple" ;
        rdfs:subClassOf slkg:Type .

    ns4:re a slkg:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_conformance.py> {
    ns111:test_conformance.py dcterms:identifier "tests.graph.unit.test_conformance" ;
        a slkg:Module ;
        rdfs:comment """End-to-end tests for VERSION-directive handling, RDF12ConformanceWarning,
and SPARQL12ConformanceWarning.

RDF 1.2 Concepts sec 2.1 and SPARQL 1.2 Query sec 4.3 define three version
labels - "1.2" (full), "1.2-basic" (excludes triple terms and dirLangString),
"1.1" (legacy) - and explicitly say the VERSION directive is only a hint: a
processor "is not required to reject features that are outside the
announced version (but could signal them with a warning)". StarLayer signals
via a warning, never a hard error - see starlayer.graph/model/conformance.py.

Two distinct warning classes are used: RDF12ConformanceWarning for RDF
document formats (Turtle, TriG, N-Triples/N-Quads, RDF/XML) and
SPARQL12ConformanceWarning for a SPARQL query/update's own VERSION directive
- per SPARQL 1.2 Query sec 4.3's own distinction that "the SPARQL version
labels refer to SPARQL syntax and semantics, while the RDF version labels
refer to RDF syntax and semantics".

Also regression-tests a real bug found while checking this against the live
spec text: a SPARQL 1.2 query starting with VERSION "1.2" (the spec's own
example form) previously raised a ParseException on the in-memory backend,
since sparql12_to_11.py never stripped the directive before handing the
query to rdflib's SPARQL 1.1 parser.""" ;
        rdfs:label "test_conformance" ;
        slkg:declares ns189:TestTrigVersionDirective, ns189:TestNTriplesNQuadsVersionDirective, ns189:TestNativeBackendRemoteRdf11UpdateVersionDirective, ns189:ex, ns189:TestSparqlApiVersionDirective, ns189:TestNativeIdentifierDefault, ns189:TestSparqlUpdateVersionDirective, ns189:TestTurtleVersionDirective, ns189:TestSparqlVersionDirective, ns189:TestRdfXmlVersionAttribute, ns189:TestNativeBackendVersionConformance ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_conformance.py" ;
        slkg:importsModule ns4:rdflib, ns4:rdflib.graph, ns4:pytest .

    ns189:TestNTriplesNQuadsVersionDirective dcterms:identifier "tests.graph.unit.test_conformance.TestNTriplesNQuadsVersionDirective" ;
        a slkg:Class ;
        rdfs:comment """N-Triples/N-Quads: the VERSION line was already recognized by the
parser but only to discard it like a comment, never extracting the
label - found by asking "does our VERSION support extend to other
formats?" and actually checking, same day as the Turtle/SPARQL fix.""" ;
        rdfs:label "TestNTriplesNQuadsVersionDirective" ;
        slkg:declares ns189:TestNTriplesNQuadsVersionDirective.test_1_2_basic_with_triple_term_warns_nq, ns189:TestNTriplesNQuadsVersionDirective.test_dataset_nq12_warns, ns189:TestNTriplesNQuadsVersionDirective.test_1_2_basic_with_triple_term_warns_nt, ns189:TestNTriplesNQuadsVersionDirective.test_no_version_directive_does_not_warn, ns189:TestNTriplesNQuadsVersionDirective.test_version_1_2_full_does_not_warn ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_conformance.py" ;
        slkg:lineEnd 440 ;
        slkg:lineStart 390 .

    ns189:TestNTriplesNQuadsVersionDirective.test_1_2_basic_with_triple_term_warns_nq dcterms:identifier "tests.graph.unit.test_conformance.TestNTriplesNQuadsVersionDirective.test_1_2_basic_with_triple_term_warns_nq" ;
        a slkg:Method ;
        rdfs:label "test_1_2_basic_with_triple_term_warns_nq" ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_conformance.py" ;
