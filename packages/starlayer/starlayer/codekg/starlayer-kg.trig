        rdfs:label "_infer_missing_owl_types" ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/owl_dl_rustdl.py" ;
        slkg:hasParameter ns32:_infer_missing_owl_types.param.g ;
        slkg:hasReturnValue ns32:_infer_missing_owl_types.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 202 ;
        slkg:lineStart 175 ;
        slkg:signature "def _infer_missing_owl_types(g: Graph) -> None" .

    ns32:_infer_missing_owl_types.param.g a slkg:Parameter ;
        rdfs:label "g" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns32:_infer_missing_owl_types.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns32:_require_rustdl dcterms:identifier "starlayer.graph.graph.owl_dl_rustdl._require_rustdl" ;
        a slkg:Function ;
        rdfs:comment """Import and return the rustdl module, or raise a clear, actionable
RuntimeError naming exactly what to install - the same "loud, not a
bare ImportError" contract owl_dl._require_owlready2() sets for the
other engine.""" ;
        rdfs:label "_require_rustdl" ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/owl_dl_rustdl.py" ;
        slkg:isPrivate true ;
        slkg:lineEnd 172 ;
        slkg:lineStart 158 ;
        slkg:signature "def _require_rustdl()" .

    ns32:_run_rustdl_subprocess dcterms:identifier "starlayer.graph.graph.owl_dl_rustdl._run_rustdl_subprocess" ;
        a slkg:Function ;
        rdfs:comment """The actual blocking RustDL calls (`is_consistent()` +
`materialize_inferred_*()`), isolated as a module-level
(picklable-by-reference) function so `_timeout.run_with_timeout()` can
run it in its own child process/process group and forcibly kill it if
it doesn't finish in time - the same mechanism `owl_dl._run_hermit_subprocess()`
uses, for the same reason: RustDL's own native PyO3 call is just as
opaque/uninterruptible from Python as a JVM subprocess wait is.

Puts exactly one `(status, ...)` tuple onto `queue`:
- `('ok', None)` - success; the four materialized result lists are
  already pickled to `result_path`, not sent through the queue.
- `('inconsistent', None)` - `is_consistent()` returned False.

`rustdl.UnsupportedAxiomError` (HasKey:/long role chains - real,
RustDL-native rejections distinct from `_check_rustdl_hang_risk()`'s
own pre-flight check, which runs in the parent process *before* this
function is ever called) propagates up through this subprocess boundary
the same way any other exception would if left uncaught - multiprocessing
itself re-raises it in the parent via the process's exit, but since
this function's own contract is "always put something on queue," an
uncaught exception here instead surfaces to the caller as a
ReasoningTimeoutError (subprocess exited without a result) rather than
the original exception type - acceptable because
`_check_rustdl_hang_risk()` already catches the one exception this
project's own parser can trigger before ever reaching this function;
an exception here would be a genuinely new, unhandled RustDL rejection
worth investigating on its own terms regardless of exact type.""" ;
        rdfs:label "_run_rustdl_subprocess" ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/owl_dl_rustdl.py" ;
        slkg:hasParameter ns32:_run_rustdl_subprocess.param.queue, ns32:_run_rustdl_subprocess.param.result_path, ns32:_run_rustdl_subprocess.param.owl_path ;
        slkg:hasReturnValue ns32:_run_rustdl_subprocess.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 250 ;
        slkg:lineStart 205 ;
        slkg:signature "def _run_rustdl_subprocess(owl_path: str, result_path: str, queue) -> None" .

    ns32:_run_rustdl_subprocess.param.owl_path a slkg:Parameter ;
        rdfs:label "owl_path" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns32:_run_rustdl_subprocess.param.queue a slkg:Parameter ;
        rdfs:label "queue" ;
        slkg:parameterKind "positional" ;
        slkg:position 2 .

    ns32:_run_rustdl_subprocess.param.result_path a slkg:Parameter ;
        rdfs:label "result_path" ;
