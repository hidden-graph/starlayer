        a slkg:Method ;
        rdfs:comment """FILTER only ever constrains an already-bound variable - it can
never bind a new one, so a variable appearing only inside a
FILTER's own expression still fails, the same as not appearing at
all.""" ;
        rdfs:label "test_filter_alone_does_not_count_as_binding" ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_sqe_ontology.py" ;
