    ns170:TestCoerceObject dcterms:identifier "tests.graph.unit.test_syntax.TestCoerceObject" ;
        a slkg:Class ;
        rdfs:comment """Numeric literals come back as a correctly-typed, lexical-form-
preserving Literal, not a Python int/float - see coerce_object's own
docstring: a Python numeric type can't tell INTEGER/DECIMAL/DOUBLE
apart from the lexical shape alone (e.g. "123e0" is xsd:double despite
having no decimal point), and converting through one would also
silently canonicalize the lexical form (e.g. "04" -> "4").""" ;
        rdfs:label "TestCoerceObject" ;
        slkg:declares ns170:TestCoerceObject.test_negative, ns170:TestCoerceObject.test_leading_zero_lexical_form_preserved, ns170:TestCoerceObject.test_false, ns170:TestCoerceObject.test_whitespace, ns170:TestCoerceObject.test_float_exp, ns170:TestCoerceObject.test_integer, ns170:TestCoerceObject.test_positive, ns170:TestCoerceObject.test_float, ns170:TestCoerceObject.test_integer_with_exponent_is_double, ns170:TestCoerceObject.test_string, ns170:TestCoerceObject.test_true ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_syntax.py" ;
        slkg:lineEnd 76 ;
        slkg:lineStart 21 .

