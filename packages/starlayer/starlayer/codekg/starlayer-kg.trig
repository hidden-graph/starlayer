GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_ast_ontology.py> {
    ns120:test_ast_ontology.py dcterms:identifier "tests.sparql.unit.test_ast_ontology" ;
        a slkg:Module ;
        rdfs:comment """Prototype: encode/decode a *raw parse tree* (rdflib's parseQuery output,
before translateQuery) as sast: RDF — one layer below salg:'s algebra.

Verifies text -> parse tree -> sast: RDF -> parse tree -> translateQuery ->
results, by *executing* both the originally-prepared query and the
RDF-round-tripped reconstruction and comparing result sets — same standard
as test_roundtrip.py.""" ;
        rdfs:label "test_ast_ontology" ;
        slkg:declares ns222:test_ast_roundtrip_result_equivalence, ns222:_canon ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_ast_ontology.py" ;
        slkg:importsModule ns4:rdflib.plugins.sparql.evaluate, ns4:rdflib.plugins.sparql.parser, ns4:pytest, ns4:rdflib.plugins.sparql.processor .

    ns222:_canon dcterms:identifier "tests.sparql.unit.test_ast_ontology._canon" ;
        a slkg:Function ;
        rdfs:label "_canon" ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_ast_ontology.py" ;
        slkg:hasParameter ns222:_canon.param.res ;
        slkg:isPrivate true ;
        slkg:lineEnd 57 ;
        slkg:lineStart 53 ;
        slkg:signature "def _canon(res)" .

    ns222:_canon.param.res a slkg:Parameter ;
        rdfs:label "res" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

