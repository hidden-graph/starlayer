    ns143:TestSerialize dcterms:identifier "tests.graph.unit.test_dataset.TestSerialize" ;
        a slkg:Class ;
        rdfs:label "TestSerialize" ;
        slkg:declares ns143:TestSerialize.test_prefixes_before_graph_blocks, ns143:TestSerialize.test_serialize_produces_graph_blocks, ns143:TestSerialize.test_literal_line_resembling_a_prefix_directive_round_trips, ns143:TestSerialize.test_serialize_triple_terms_present ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_dataset.py" ;
