    ql:capability-of-symbol a slkg:NamedQuery ;
        rdfs:comment "The curated capability, if any, that names a symbol as its implementation." ;
        rdfs:label "Which capability does a symbol implement?" ;
        slkg:aboutTopic ql:topic-capabilities ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of the implementing symbol" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true
        ] ;
        slkg:queryRoot ql:capability-of-symbol-tree .

    ql:capability-of-symbol-tree a sqe:Query, sqe:SelectQuery ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "area"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "capability"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "area"^^spexpr:Variable "capability"^^spexpr:Variable "status"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:TriplePattern ;
            sqe:object slkg:Capability ;
            sqe:predicate rdf:type ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "a"^^spexpr:Variable ;
            sqe:predicate slkg:inCapabilityArea ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "capability"^^spexpr:Variable ;
            sqe:predicate rdfs:comment ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "status"^^spexpr:Variable ;
            sqe:predicate slkg:hasStatus ;
            sqe:subject "cap"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
