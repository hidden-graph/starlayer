    ns308:select_widget dcterms:identifier "starlayer.shacl.ui_widget_selection.select_widget" ;
        a slkg:Function ;
        rdfs:comment """Select the ``shui:editor``/``shui:viewer`` widget ``shape_node``
should use for ``focus_node``, per the spec's own Section 3.2 "Select
Function" procedure:

1. If ``shape_node`` already has an explicit ``shui:editor``/
   ``shui:viewer`` (per ``role``), look up its ``shui:WidgetAcceptMatcher``
   - no matcher found means accept unconditionally; a matcher that
   accepts also means accept; a matcher that rejects falls through to
   step 2 rather than failing outright.
2. Otherwise (or on fallthrough), collect every ``shui:WidgetScore`` in
   ``scoring_graph`` with both a ``shui:widget`` and a ``shui:score``,
   ranked highest-score-first.
3. Walk that ranked list, running the same matcher check on each,
   returning the first one that's either unmatched or accepted.

Returns ``None`` if nothing matches at all. ``data_graph``/
``shapes_graph``/``scoring_graph`` may be the same object - the spec
doesn't require them to be separate graphs, just separate *roles*.

``focus_node`` and ``data_graph`` are optional. They are used only to
check a matcher's ``shui:dataGraphShape``. With no ``focus_node`` a matcher
that has only a data condition rejects its widget (Section 3.4 step 1),
while one with a ``shui:shapesGraphShape`` is decided by that alone, so
the choice is per shape rather than per node. Passing a ``focus_node``
without a ``data_graph`` raises ``ValueError``.

``scoring_graph`` is optional: omit it (or pass ``None``) when widgets
are fixed in the shapes graph and there is no scoring catalog - an
explicit ``shui:editor``/``shui:viewer`` is then accepted outright, and a
property with none gets ``None``.""" ;
        rdfs:label "select_widget" ;
        slkg:calls ns308:_find_matcher, ns308:_matcher_accepts ;
        slkg:filePath "packages/starlayer/starlayer/shacl/ui_widget_selection.py" ;
        slkg:hasParameter ns308:select_widget.param.data_graph, ns308:select_widget.param.focus_node, ns308:select_widget.param.shapes_graph, ns308:select_widget.param.role, ns308:select_widget.param.scoring_graph, ns308:select_widget.param.shape_node ;
        slkg:hasReturnValue ns308:select_widget.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 203 ;
        slkg:lineStart 121 ;
        slkg:signature "def select_widget(*, shape_node: Any, focus_node: Any | None=None, data_graph: Any | None=None, shapes_graph: Any, scoring_graph: Any | None=None, role: Role) -> URIRef | None" .

    ns308:select_widget.param.data_graph a slkg:Parameter ;
        rdfs:label "data_graph" ;
        slkg:annotationText "Any | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:typing.Any ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 2 .

    ns308:select_widget.param.focus_node a slkg:Parameter ;
        rdfs:label "focus_node" ;
        slkg:annotationText "Any | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:typing.Any ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 1 .

    ns308:select_widget.param.role a slkg:Parameter ;
        rdfs:label "role" ;
        slkg:annotationText "Role" ;
        slkg:hasType ns4:Role ;
        slkg:parameterKind "kwonly" ;
        slkg:position 5 .

    ns308:select_widget.param.scoring_graph a slkg:Parameter ;
        rdfs:label "scoring_graph" ;
        slkg:annotationText "Any | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:typing.Any ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 4 .

    ns308:select_widget.param.shape_node a slkg:Parameter ;
        rdfs:label "shape_node" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "kwonly" ;
        slkg:position 0 .

    ns308:select_widget.param.shapes_graph a slkg:Parameter ;
        rdfs:label "shapes_graph" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "kwonly" ;
        slkg:position 3 .

    ns308:select_widget.returns a slkg:ReturnValue ;
        slkg:annotationText "URIRef | None" ;
        slkg:hasType ns4:rdflib.term.URIRef ;
        slkg:optional true .

    ns308:select_widgets dcterms:identifier "starlayer.shacl.ui_widget_selection.select_widgets" ;
        a slkg:Function ;
        rdfs:comment """Batch sibling of :func:`select_widget` - walks ``shape_node``'s own
``sh:property`` list and runs :func:`select_widget` once per property,
returning ``{property_shape: widget}`` for the given ``role``
(``"editor"`` or ``"viewer"``). Every ``sh:property`` of ``shape_node``
is a key.

``shape_node`` is a ``sh:NodeShape`` here (unlike :func:`select_widget`,
whose own ``shape_node`` is a single property shape) - its
``sh:property`` list is exactly what's walked.

A property for which :func:`select_widget` returns ``None`` maps to
``None``, so the dict always lists every property of the shape.

``focus_node``, ``data_graph`` and ``scoring_graph`` are optional, as
for :func:`select_widget`.""" ;
        rdfs:label "select_widgets" ;
        slkg:calls ns308:select_widget ;
        slkg:filePath "packages/starlayer/starlayer/shacl/ui_widget_selection.py" ;
        slkg:hasParameter ns308:select_widgets.param.shape_node, ns308:select_widgets.param.focus_node, ns308:select_widgets.param.role, ns308:select_widgets.param.scoring_graph, ns308:select_widgets.param.data_graph, ns308:select_widgets.param.shapes_graph ;
        slkg:hasReturnValue ns308:select_widgets.returns ;
        slkg:lineEnd 238 ;
        slkg:lineStart 206 ;
        slkg:signature "def select_widgets(*, shape_node: Any, focus_node: Any | None=None, data_graph: Any | None=None, shapes_graph: Any, scoring_graph: Any | None=None, role: Role) -> dict[Any, URIRef | None]" .

    ns308:select_widgets.param.data_graph a slkg:Parameter ;
        rdfs:label "data_graph" ;
        slkg:annotationText "Any | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:typing.Any ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 2 .

    ns308:select_widgets.param.focus_node a slkg:Parameter ;
        rdfs:label "focus_node" ;
        slkg:annotationText "Any | None" ;
        slkg:defaultValue "None" ;
