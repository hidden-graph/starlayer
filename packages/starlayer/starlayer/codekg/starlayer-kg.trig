    ns244:TestOwlDlSubClassClosure dcterms:identifier "tests.graph.unit.test_infer_owl_dl.TestOwlDlSubClassClosure" ;
        a slkg:Class ;
        rdfs:comment """HermiT's own CLI realization output only reports each individual's
most-specific type(s), not every ancestor class - confirmed live while
implementing this bridge. Every other entailment regime gives the full
transitive rdf:type closure, so entailment=ENTAILMENT['OWL-Direct'] needs to match that
(see owl_dl._complete_type_closure), not just the disjunctive case.""" ;
        rdfs:label "TestOwlDlSubClassClosure" ;
        slkg:declares ns244:TestOwlDlSubClassClosure.test_multi_hop_subclass_entailment ;
