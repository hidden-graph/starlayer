GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/integration/test_oxigraph_backend.py> {
    ns155:test_oxigraph_backend.py dcterms:identifier "tests.graph.integration.test_oxigraph_backend" ;
        a slkg:Module ;
        rdfs:comment """tests/integration/test_oxigraph_backend.py

Integration tests for StarLayerGraph backed by Oxigraph via rdf-1.2 native mode.

Oxigraph speaks the final W3C RDF 1.2 <<( )>> syntax natively and returns
"type":"triple" in SPARQL JSON results.

Requires a running Oxigraph instance:
    docker run -d --name oxigraph-test -p 7878:7878 \\
      ghcr.io/oxigraph/oxigraph serve --location /data --bind 0.0.0.0:7878

Run:
    .venv/bin/pytest tests/integration/ -v""" ;
        rdfs:label "test_oxigraph_backend" ;
        slkg:declares ns224:TestOxigraphIsomorphicAndSerialize, ns224:TestOxigraphSPARQL, ns224:TestOxigraphRdf12SparqlFunctions, ns224:TestOxigraphRdf11BlankNodes, ns224:TestOxigraphDatasetQuery, ns224:TestOxigraphRemove, ns224:TestOxigraphRdfxml12Parse, ns224:TestOxigraphGraphUpdateRdf11Mode, ns224:sg_rdf11, ns224:TestOxigraphTrix12Parse, ns224:TestOxigraphAddN, ns224:_clear_all, ns224:TestOxigraphReificationAPI, ns224:TestOxigraphGraphUpdate, ns224:TestOxigraphBoundBnodeQuery, ns224:TestOxigraphTriplesChoices, ns224:TestOxigraphReconnect, ns224:TestOxigraphNt12Parse, ns224:_clear_graph, ns224:TestOxigraphDatasetUpdate, ns224:_make_store, ns224:sg, ns224:TestOxigraphTurtle12Parse, ns224:TestOxigraphRoundTrip, ns224:TestOxigraphNq12Parse, ns224:_oxigraph_available, ns224:TestOxigraphDatasetTrig12Parse, ns224:TestOxigraphLen ;
        slkg:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_backend.py" ;
        slkg:importsModule ns4:requests, ns4:rdflib.namespace, ns4:rdflib, ns4:rdflib.plugins.stores.sparqlstore, ns4:pytest .

