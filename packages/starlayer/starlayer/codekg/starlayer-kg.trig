    ns129:TestMultilineStringLiterals.test_embedded_triple_quote_run_round_trips dcterms:identifier "tests.graph.unit.test_turtle12_serializer.TestMultilineStringLiterals.test_embedded_triple_quote_run_round_trips" ;
        a slkg:Method ;
        rdfs:comment """A real bug found while running this project's own code-KG
extractor over this project's own docstrings: a multi-line
literal containing an unescaped '\"\"\"' run (e.g. a docstring
describing Turtle's own triple-quote syntax) is indistinguishable
from - and was being misread by this project's own parser as -
the literal's real closing delimiter, truncating it there and
corrupting every statement that followed in the document.""" ;
        rdfs:label "test_embedded_triple_quote_run_round_trips" ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_turtle12_serializer.py" ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 545 ;
        slkg:lineStart 531 ;
        slkg:signature "def test_embedded_triple_quote_run_round_trips(self)" .

