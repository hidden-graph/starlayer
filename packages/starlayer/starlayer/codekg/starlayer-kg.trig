GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/query/result_patches.py> {
    ns33:result_patches.py dcterms:identifier "starlayer.graph.query.result_patches" ;
        a slkg:Module ;
        rdfs:comment """Targeted compatibility shim for a confirmed bug in plain rdflib's own
``rdflib.query.Result`` - result *materialization*, a different module and
phase from every other patch in this package (parsing/algebra translation:
``algebra_translator_patches.py``; SPARQL arithmetic: ``operator_patches.py``;
evaluation: ``evaluate_patches.py``). See ``docs/upstream-issues/rdflib-upstream-issues.md``
issue 6 for the full write-up.

Same idempotent apply-once pattern as the other ``*_patches.py`` modules in
this package.""" ;
        rdfs:label "result_patches" ;
        slkg:declares ns39:patch_result_iter_empty_binding_row ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/result_patches.py" ;
        slkg:importsModule ns4:rdflib.query, ns4:__future__ .

    ns39:patch_result_iter_empty_binding_row dcterms:identifier "starlayer.graph.query.result_patches.patch_result_iter_empty_binding_row" ;
        a slkg:Function ;
        rdfs:comment """Fix a confirmed rdflib bug: ``Result.__iter__``'s ``SELECT`` handling
guards on ``if b:`` before yielding each row's binding dict - meant to
mean "skip past the end," but an empty dict (``{}``) is also falsy in
Python, so a *real* solution row that happens to have zero variable
bindings is silently dropped too, indistinguishable at this check from
"no more rows."

A zero-variable binding is a real, correct SPARQL solution - it's what
``SELECT *`` over a WHERE pattern with no variables anywhere produces
when it matches (e.g. ``SELECT * WHERE { <a> <b> <c> . }`` - a "does
this exact fact exist?" query). ``Result.bindings`` (the property) and
``len(result)`` both correctly report one row for such a query, and
``ASK`` on the identical pattern correctly returns ``True`` - only
iterating the ``Result`` object (``list(result)``, ``for row in
result``) silently returns nothing. This is purely rdflib's own
client-side bug in ``__iter__``, unrelated to which backend produced
the data - a remote SPARQLStore-backed result carries the same
``{"bindings": [{}]}`` shape and is affected identically.

Fix: yield every row in ``self._bindings``/``self._genbindings``
unconditionally - there is no sentinel value ever placed in either
list to mean "not a real row," so the truthiness check was never
actually distinguishing anything real to begin with.""" ;
        rdfs:label "patch_result_iter_empty_binding_row" ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/result_patches.py" ;
        slkg:hasReturnValue ns39:patch_result_iter_empty_binding_row.returns ;
        slkg:lineEnd 76 ;
        slkg:lineStart 19 ;
        slkg:signature "def patch_result_iter_empty_binding_row() -> bool" .

    ns39:patch_result_iter_empty_binding_row.returns a slkg:ReturnValue ;
        slkg:annotationText "bool" ;
        slkg:hasType ns4:builtins.bool .

    ns4:__future__ a slkg:ExternalModule .

    ns4:builtins.bool dcterms:identifier "builtins.bool" ;
        a slkg:ExternalType ;
        rdfs:label "bool" ;
        rdfs:subClassOf slkg:Type .

    ns4:rdflib.query a slkg:ExternalModule .
}

