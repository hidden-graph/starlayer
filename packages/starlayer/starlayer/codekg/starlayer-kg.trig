    ns169:TestMethodOverrideCrossFile.test_override_reached_through_a_cross_file_chain dcterms:identifier "tests.codekg.unit.test_visitor.TestMethodOverrideCrossFile.test_override_reached_through_a_cross_file_chain" ;
        a slkg:Method ;
        rdfs:comment """Child (mod_c) -> Middle (mod_b, same file as Child's own base
reference but the method itself lives even further back) ->
Base (mod_a) defines greet. The old same-file-only walk would have
stopped dead at Middle (already a cross-file hop from Child) and
never reached Base at all - proof this is a real multi-hop,
project-wide walk, not just "also checks one more file".""" ;
        rdfs:label "test_override_reached_through_a_cross_file_chain" ;
        slkg:calls ns169:_extract_multi ;
        slkg:filePath "packages/starlayer/tests/codekg/unit/test_visitor.py" ;
