        slkg:lineEnd 127 ;
        slkg:lineStart 118 ;
        slkg:signature "def test_rdf12_construct_roundtrip(starlayer_graph, query_text)" .

    ns131:test_rdf12_construct_roundtrip.decorator.0 a slkg:Decorator ;
        slkg:decoratorText "pytest.mark.parametrize('query_text', CONSTRUCT_QUERIES)" ;
        slkg:position 0 .

    ns131:test_rdf12_construct_roundtrip.param.query_text a slkg:Parameter ;
        rdfs:label "query_text" ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

