GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/starontology/unit/test_starontology.py> {
    ns265:test_starontology.py dcterms:identifier "tests.starontology.unit.test_starontology" ;
        a slkg:Module ;
        rdfs:comment """tests/unit/test_starontology.py

starontology is pure data (one TriG dataset, starontology.trig, holding
every registered entry including shacl_shacl as of 2026-10-12) behind a
thin registry (get_ontology_list()/get_ontology_graph()) -
this suite confirms every registered entry loads and parses, and the
registry's own list/lookup behavior is correct. The underlying
*_TTL_PATH constants are private as of 2026-10-02
(internal to this module's own registry, not public API) - there's no
dedicated "does the file exist" test anymore, since
TestGetOntologyGraph::test_every_registered_name_loads_and_parses already
proves it implicitly (a missing file would fail to parse). Not that any
vocabulary's own content is correct - that's each consuming package's own
test suite's job (packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py,
test_skos_shapes.py; packages/starlayer/tests/sparql/unit/test_shacl_shapes.py,
test_srl_shapes.py).""" ;
        rdfs:label "test_starontology" ;
        slkg:declares ns266:TestGetOntologyList, ns266:TestGetOntologyGraph, ns266:TestGetConformanceProfiles, ns266:TestPublishedFiles, ns266:TestGetRawUrl, ns266:TestConformanceProfilesContent, ns266:TestLocalLoader, ns266:TestGetResourceIri ;
        slkg:filePath "packages/starlayer/tests/starontology/unit/test_starontology.py" ;
        slkg:importsModule ns4:pytest .

    ns266:TestConformanceProfilesContent dcterms:identifier "tests.starontology.unit.test_starontology.TestConformanceProfilesContent" ;
        a slkg:Class ;
        rdfs:comment """The StarLayer profiles in starlayer-profiles.ttl, checked directly
against get_conformance_profiles()'s own full graph. Each StarLayer
profile (slp:) is a prof:Profile that is prof:isProfileOf the public
specification (or public SHACL profiles) it relates to, and lists its
ontology (role:schema) and shapes (role:validation) files with
prof:hasResource. A shapes graph is not itself declared a profile of the
public specification: data that conforms to it conforms to the
StarLayer profile that lists it, and that profile's own isProfileOf link
carries the claim up.

sparql_shacl/sparql_owl (salg:) are deliberately not in any profile -
salg: is this project's own internal SPARQL algebra encoding, not
something meant to carry a public-facing conformance claim.""" ;
        rdfs:label "TestConformanceProfilesContent" ;
        slkg:declares ns266:TestConformanceProfilesContent.test_each_profile_is_a_profile_of_the_public_layer, ns266:TestConformanceProfilesContent.test_sparql_shacl_is_registered_but_in_no_profile, ns266:TestConformanceProfilesContent.test_shapes_graphs_are_not_declared_profiles_of_the_public_layer, ns266:TestConformanceProfilesContent.test_each_profile_lists_its_shapes_and_ontology_files ;
        slkg:filePath "packages/starlayer/tests/starontology/unit/test_starontology.py" ;
        slkg:lineEnd 200 ;
        slkg:lineStart 143 .

    ns266:TestConformanceProfilesContent.test_each_profile_is_a_profile_of_the_public_layer dcterms:identifier "tests.starontology.unit.test_starontology.TestConformanceProfilesContent.test_each_profile_is_a_profile_of_the_public_layer" ;
