        slkg:hasReturnValue ns9:_clark.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 72 ;
        slkg:lineStart 69 ;
        slkg:signature "def _clark(iri: str) -> str" .

    ns9:_clark.param.iri a slkg:Parameter ;
        rdfs:label "iri" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
