    ns61:_terms_compatible dcterms:identifier "starlayer.sparql.srl_eval._terms_compatible" ;
        a slkg:Function ;
        rdfs:comment """Could ``template_term`` (from a rule head's triple template) and
``pattern_term`` (from a rule body's triple pattern) refer to the same
RDF term? A variable on either side is compatible with anything;
otherwise the two ground terms must be equal.

Deliberately conservative (a documented, safe simplification, not a
bug): this checks each subject/predicate/object *position*
independently, without also requiring that a variable repeated across
two positions of the *same* pattern/template be replaced by the same
term on both sides. That refinement would only ever narrow whether a
match is reported - never widen it - so omitting it can produce a
dependency edge the spec's own stricter reading wouldn't, but never
misses a real one. The spec's own §4.3.2 is explicit that "conformance
depends on producing a dependency graph that meets the definitions...
not on the use of this procedure" - an extra, spurious edge only costs
a coarser (still correct) stratification, never a wrong inferred
graph, since every genuine dependency is still found.""" ;
        rdfs:label "_terms_compatible" ;
        slkg:calls ns61:_terms_compatible ;
        slkg:filePath "packages/starlayer/starlayer/sparql/srl_eval.py" ;
        slkg:hasParameter ns61:_terms_compatible.param.pattern_term, ns61:_terms_compatible.param.template_term ;
        slkg:hasReturnValue ns61:_terms_compatible.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 119 ;
        slkg:lineStart 83 ;
        slkg:signature "def _terms_compatible(pattern_term, template_term) -> bool" .

    ns61:_terms_compatible.param.pattern_term a slkg:Parameter ;
        rdfs:comment "A term from a rule body's triple pattern." ;
        rdfs:label "pattern_term" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns61:_terms_compatible.param.template_term a slkg:Parameter ;
        rdfs:comment "A term from a rule head's triple template." ;
        rdfs:label "template_term" ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns61:_terms_compatible.returns a slkg:ReturnValue ;
        rdfs:comment "True if the two terms could refer to the same RDF term." ;
        slkg:annotationText "bool" ;
        slkg:hasType ns4:builtins.bool .

