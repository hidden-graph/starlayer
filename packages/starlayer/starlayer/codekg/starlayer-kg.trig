        slkg:position 0 .

    ns77:ValidationResult dcterms:identifier "starlayer.shacl.results.ValidationResult" ;
        a slkg:Class ;
        rdfs:comment """Result of ``validate()`` - a richer replacement for pyshacl's own
bare ``(conforms, report_graph, report_text)`` tuple.

``data_graph`` is only populated when the call used ``inplace=True``
(the ``"rules"`` mode's own default) - the caller's own data graph,
mutated with any in-place changes decoded back; ``None`` otherwise,
not an error. ``diagnostics`` is internal adapter bookkeeping (see
``ExecutionDiagnostics``), not general-purpose validation statistics.""" ;
        rdfs:label "ValidationResult" ;
        slkg:filePath "packages/starlayer/starlayer/shacl/results.py" ;
        slkg:hasAttribute ns77:ValidationResult.attr.report_graph, ns77:ValidationResult.attr.conforms, ns77:ValidationResult.attr.data_graph, ns77:ValidationResult.attr.diagnostics, ns77:ValidationResult.attr.report_text ;
        slkg:hasDecorator ns77:ValidationResult.decorator.0 ;
        slkg:lineEnd 42 ;
