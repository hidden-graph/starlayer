        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns54:_encode_list.param.items a slkg:Parameter ;
        rdfs:label "items" ;
        slkg:annotationText "list" ;
        slkg:hasType ns4:builtins.list ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

