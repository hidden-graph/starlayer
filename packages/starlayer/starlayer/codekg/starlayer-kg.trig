        rdfs:label "_check_sequence" ;
        slkg:calls ns62:_check_sequence, ns62:_has_aggregate, ns62:_triple_vars, ns62:_expr_vars ;
        slkg:filePath "packages/starlayer/starlayer/sparql/srl_semantic_checks.py" ;
        slkg:hasParameter ns62:_check_sequence.param.issues, ns62:_check_sequence.param.rule, ns62:_check_sequence.param.v0, ns62:_check_sequence.param.elements ;
        slkg:hasReturnValue ns62:_check_sequence.returns ;
        slkg:instantiates ns62:_SRLWellFormednessIssue ;
        slkg:isPrivate true ;
        slkg:lineEnd 156 ;
        slkg:lineStart 102 ;
        slkg:signature "def _check_sequence(elements: list[srl_ast.BodyElement], v0: set[Variable], rule: srl_ast._Rule, issues: list[_SRLWellFormednessIssue]) -> set[Variable]" .

    ns62:_check_sequence.param.elements a slkg:Parameter ;
        rdfs:comment "The body elements to check, in sequence order." ;
        rdfs:label "elements" ;
        slkg:annotationText "list[srl_ast.BodyElement]" ;
        slkg:hasType ns4:builtins.list, ns4:typing.Union ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns62:_check_sequence.param.issues a slkg:Parameter ;
        rdfs:comment "Violations found are appended here." ;
        rdfs:label "issues" ;
        slkg:annotationText "list[_SRLWellFormednessIssue]" ;
        slkg:hasType ns4:builtins.list, ns62:_SRLWellFormednessIssue ;
