GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_rdf_nil_roundtrip.py> {
    ns120:test_rdf_nil_roundtrip.py dcterms:identifier "tests.sparql.unit.test_rdf_nil_roundtrip" ;
        a slkg:Module ;
        rdfs:comment """Regression coverage for a real, general bug in from_rdf.py's algebra
decoder: `_decode()` used to treat *any* node equal to `rdf:nil` as the
empty Python list `[]`, unconditionally - correct for the handful of
algebra fields that are genuinely list-valued (BGP.triples, Project.PV,
...), but wrong for every ordinary term-valued field, silently corrupting
any query referencing the literal `rdf:nil` URIRef as real data (a common
RDF-List-processing idiom: `?s ?p rdf:nil`, `FILTER(?x != rdf:nil)`, an
empty `IN ()`/`GROUP_CONCAT`/`COUNT(...)` with no DISTINCT, an UPDATE whose
INSERT DATA/DELETE DATA is entirely inside `GRAPH <...> { }` blocks, ...).

Found while routing starlayer.ontology.manchester_shapes.validate()
through starlayer.shacl (never bare pyshacl) - an adversarial SHACL test with a
deliberately malformed `rdf:List` (`?this rdf:rest* ?cell . FILTER NOT
EXISTS { ?cell rdf:first ?x }`) silently stopped detecting the malformed
cell once StarLayerGraph.query() was in the loop, because the query's own
`rdf:nil` comparison got corrupted the same way.

Verified by *executing* both the original prepared query/update and the
RDF-round-tripped reconstruction and comparing real results, not by
inspecting the decoded algebra tree directly - the same discipline
test_roundtrip.py's own module docstring documents and this file mirrors.""" ;
        rdfs:label "test_rdf_nil_roundtrip" ;
        slkg:declares ns184:test_rdf_nil_as_literal_term_roundtrips, ns184:malformed_list_graph, ns184:test_malformed_cell_is_still_detected_after_roundtrip, ns184:test_update_with_empty_default_graph_triples_roundtrips, ns184:_canon ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_rdf_nil_roundtrip.py" ;
        slkg:importsModule ns4:rdflib.plugins.sparql.processor, ns4:pytest, ns4:rdflib.plugins.sparql.evaluate, ns4:rdflib.plugins.sparql.update, ns4:rdflib .

    ns184:_canon dcterms:identifier "tests.sparql.unit.test_rdf_nil_roundtrip._canon" ;
        a slkg:Function ;
        rdfs:label "_canon" ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_rdf_nil_roundtrip.py" ;
        slkg:hasParameter ns184:_canon.param.res ;
        slkg:isPrivate true ;
        slkg:lineEnd 81 ;
        slkg:lineStart 77 ;
        slkg:signature "def _canon(res)" .

    ns184:_canon.param.res a slkg:Parameter ;
        rdfs:label "res" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns184:malformed_list_graph dcterms:identifier "tests.sparql.unit.test_rdf_nil_roundtrip.malformed_list_graph" ;
        a slkg:Function ;
        rdfs:label "malformed_list_graph" ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_rdf_nil_roundtrip.py" ;
        slkg:hasDecorator ns184:malformed_list_graph.decorator.0 ;
        slkg:hasReturnValue ns184:malformed_list_graph.returns ;
        slkg:lineEnd 88 ;
        slkg:lineStart 85 ;
        slkg:signature "def malformed_list_graph() -> Graph" .

    ns184:malformed_list_graph.decorator.0 a slkg:Decorator ;
        slkg:decoratorText "pytest.fixture" ;
        slkg:position 0 .

    ns184:malformed_list_graph.returns a slkg:ReturnValue ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph .

    ns184:test_malformed_cell_is_still_detected_after_roundtrip dcterms:identifier "tests.sparql.unit.test_rdf_nil_roundtrip.test_malformed_cell_is_still_detected_after_roundtrip" ;
        a slkg:Function ;
        rdfs:comment """The adversarial case, in isolation: the round-tripped query must
still find *both* :items (the zero-length path) and :extra (the
malformed cell) - the exact result plain, un-round-tripped rdflib
produces against the same data.""" ;
