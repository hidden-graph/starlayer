    ns316:_report.param.order a slkg:Parameter ;
        rdfs:label "order" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns316:test_a_graph_with_one_or_no_report_is_unchanged dcterms:identifier "tests.shacl.unit.test_genuine_report_node.test_a_graph_with_one_or_no_report_is_unchanged" ;
        a slkg:Function ;
        rdfs:label "test_a_graph_with_one_or_no_report_is_unchanged" ;
        slkg:calls ns75:_find_genuine_report_node ;
        slkg:filePath "packages/starlayer/tests/shacl/unit/test_genuine_report_node.py" ;
        slkg:lineEnd 80 ;
        slkg:lineStart 75 ;
        slkg:signature "def test_a_graph_with_one_or_no_report_is_unchanged()" .

    ns316:test_genuine_report_is_chosen_whatever_the_insertion_order dcterms:identifier "tests.shacl.unit.test_genuine_report_node.test_genuine_report_is_chosen_whatever_the_insertion_order" ;
