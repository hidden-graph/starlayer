GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/query/operator_patches.py> {
    ns33:operator_patches.py dcterms:identifier "starlayer.graph.query.operator_patches" ;
        a slkg:Module ;
        rdfs:comment """Targeted compatibility shims for confirmed bugs in plain rdflib's own
SPARQL arithmetic/numeric-function evaluation (``rdflib.plugins.sparql``) -
not bugs in this repo's own query rewriting. Found via the W3C SHACL 1.2
test suite's Node Expressions and Rules fixtures
(``docs/w3c-shacl12-test-suite-plan.md`` in the ``starShacl`` repo); each
bug reproduces against plain ``rdflib.Graph().query()`` with no
starlayer.graph/pySHACL involvement.

Every patch here follows the same idempotent apply-once pattern used elsewhere
in this project for third-party monkeypatches: a module-level
``_xxx_patch_status: bool | None`` flag plus a marker attribute on the
patched callable, so repeated calls (e.g. from multiple import sites) are
safe no-ops.""" ;
        rdfs:label "operator_patches" ;
        slkg:declares ns44:patch_sameterm_simple_literal_is_xsd_string, ns44:apply_all_operator_patches, ns44:_canonicalize_decimal_lexical_form, ns44:patch_integer_cast_from_numeric_and_boolean, ns44:_iter_subexpressions, ns44:patch_strlang_rejects_empty_language_tag, ns44:_string_identity_key, ns44:patch_decimal_result_lexical_form, ns44:_find_comp, ns44:patch_multiplicative_expression_type_promotion ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/operator_patches.py" ;
        slkg:importsModule ns4:math, ns4:rdflib.plugins.sparql.parserutils, ns4:rdflib.plugins.sparql.operators, ns4:decimal, ns4:rdflib.namespace, ns4:__future__, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib, ns4:rdflib.plugins.sparql.datatypes .

    ns44:_canonicalize_decimal_lexical_form dcterms:identifier "starlayer.graph.query.operator_patches._canonicalize_decimal_lexical_form" ;
        a slkg:Function ;
        rdfs:comment """XSD decimal's canonical lexical form requires a decimal point with
at least one digit on each side (e.g. ``"42.0"``, not ``"42"``) - but
rdflib's own CEIL/FLOOR/ROUND/division construct a whole-number decimal
result via a Python ``int``/exact ``Decimal``, whose default string form
omits the trailing ``.0``.""" ;
        rdfs:label "_canonicalize_decimal_lexical_form" ;
        slkg:filePath "packages/starlayer/starlayer/graph/query/operator_patches.py" ;
        slkg:hasParameter ns44:_canonicalize_decimal_lexical_form.param.literal ;
        slkg:hasReturnValue ns44:_canonicalize_decimal_lexical_form.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 86 ;
        slkg:lineStart 69 ;
        slkg:signature "def _canonicalize_decimal_lexical_form(literal: Literal) -> Literal" .

    ns44:_canonicalize_decimal_lexical_form.param.literal a slkg:Parameter ;
        rdfs:comment "The ``Literal`` to canonicalize." ;
        rdfs:label "literal" ;
        slkg:annotationText "Literal" ;
        slkg:hasType ns4:rdflib.term.Literal ;
