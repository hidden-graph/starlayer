            ]
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "line"^^spexpr:Variable ;
                sqe:predicate slkg:lineStart ;
                sqe:subject "f"^^spexpr:Variable
            ] )
        ] ) .

    ql:upstream-workarounds a slkg:NamedQuery ;
        rdfs:comment "The documented bugs in rdflib, pySHACL, Fuseki and Oxigraph and the code that works around each, optionally limited to one library or to one symbol (to ask whether a function exists because of an upstream bug). The curated list is in curated/upstream-issues.ttl; the write-ups are in docs/upstream-issues/." ;
        rdfs:label "Which code works around a bug in a library we build on?" ;
        slkg:aboutTopic ql:topic-upstream-bugs ;
        slkg:answersCompetencyQuestion ql:cq-which-functions-exist-specifically-to-work-around ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "only issues in this library: rdflib, pyshacl, fuseki or oxigraph" ;
            slkg:paramExample "rdflib" ;
            slkg:paramName "project" ;
            slkg:paramRequired false
        ], [
            a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a function to ask about" ;
            slkg:paramExample "starlayer.graph.query.evaluate_patches.patch_evalfilter_forgotten_vars" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired false
        ] ;
        slkg:queryRoot ql:upstream-workarounds-tree .

    ql:upstream-workarounds-tree a sqe:Query, sqe:SelectQuery ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "upstream"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "number"^^spexpr:Variable
        ] [
            a sqe:OrderCondition ;
            sqe:expr "workaround"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "upstream"^^spexpr:Variable "number"^^spexpr:Variable "issue"^^spexpr:Variable "status"^^spexpr:Variable "workaround"^^spexpr:Variable "file"^^spexpr:Variable "line"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:Values ;
            sqe:rows ( ( sqe:undef ) ) ;
            sqe:vars ( "project"^^spexpr:Variable )
        ] [
            a sqe:Values ;
            sqe:rows ( ( sqe:undef ) ) ;
            sqe:vars ( "symbol"^^spexpr:Variable )
        ] [
            a sqe:TriplePattern ;
            sqe:object slkg:UpstreamIssue ;
            sqe:predicate rdf:type ;
            sqe:subject "i"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "issue"^^spexpr:Variable ;
            sqe:predicate rdfs:label ;
            sqe:subject "i"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "status"^^spexpr:Variable ;
            sqe:predicate slkg:issueStatus ;
            sqe:subject "i"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "upstream"^^spexpr:Variable ;
            sqe:predicate slkg:upstreamProject ;
            sqe:subject "i"^^spexpr:Variable
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "number"^^spexpr:Variable ;
                sqe:predicate slkg:issueNumber ;
                sqe:subject "i"^^spexpr:Variable
            ] )
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "workaround"^^spexpr:Variable ;
                sqe:predicate slkg:workedAroundByIdentifier ;
                sqe:subject "i"^^spexpr:Variable
            ] [
                a sqe:Optional ;
                sqe:where ( [
                    a sqe:TriplePattern ;
                    sqe:object "workaround"^^spexpr:Variable ;
                    sqe:predicate dcterms:identifier ;
                    sqe:subject "s"^^spexpr:Variable
                ] [
                    a sqe:Optional ;
                    sqe:where ( [
                        a sqe:TriplePattern ;
                        sqe:object "file"^^spexpr:Variable ;
                        sqe:predicate slkg:filePath ;
                        sqe:subject "s"^^spexpr:Variable
                    ] )
                ] [
                    a sqe:Optional ;
                    sqe:where ( [
                        a sqe:TriplePattern ;
                        sqe:object "line"^^spexpr:Variable ;
                        sqe:predicate slkg:lineStart ;
                        sqe:subject "s"^^spexpr:Variable
                    ] )
                ] )
            ] )
        ] [
            a sqe:Filter ;
            sqe:expr [
                a spexpr:ConditionalOrExpression ;
                spexpr:expr [
                    a spexpr:UnaryNot ;
                    spexpr:expr [
                        a spexpr:Builtin_BOUND ;
                        spexpr:arg "project"^^spexpr:Variable
                    ]
                ] ;
                spexpr:other ( [
                    a spexpr:RelationalExpression ;
                    spexpr:expr [
                        a spexpr:Builtin_LCASE ;
                        spexpr:arg "upstream"^^spexpr:Variable
                    ] ;
                    spexpr:op "="^^spexpr:PlainString ;
                    spexpr:other [
                        a spexpr:Builtin_LCASE ;
                        spexpr:arg "project"^^spexpr:Variable
                    ]
                ] )
            ]
        ] [
            a sqe:Filter ;
            sqe:expr [
                a spexpr:ConditionalOrExpression ;
                spexpr:expr [
                    a spexpr:UnaryNot ;
                    spexpr:expr [
                        a spexpr:Builtin_BOUND ;
                        spexpr:arg "symbol"^^spexpr:Variable
                    ]
                ] ;
                spexpr:other ( [
                    a spexpr:RelationalExpression ;
                    spexpr:expr "workaround"^^spexpr:Variable ;
                    spexpr:op "="^^spexpr:PlainString ;
                    spexpr:other "symbol"^^spexpr:Variable
                ] )
            ]
        ] ) .

    ql:who-instantiates a slkg:NamedQuery ;
        rdfs:comment "The functions and methods that construct an instance of a class." ;
        rdfs:label "Where is a class instantiated?" ;
        slkg:aboutTopic ql:topic-call-graph ;
        slkg:answersCompetencyQuestion ql:cq-which-classes-are-ever-instantiated-and-from ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a class" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true
        ] ;
        slkg:queryRoot ql:who-instantiates-tree .

    ql:who-instantiates-tree a sqe:SelectQuery, sqe:Query ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "constructor"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "constructor"^^spexpr:Variable "file"^^spexpr:Variable "line"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:TriplePattern ;
            sqe:object "class"^^spexpr:Variable ;
            sqe:predicate slkg:instantiates ;
            sqe:subject "f"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "class"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "constructor"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "f"^^spexpr:Variable
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "file"^^spexpr:Variable ;
                sqe:predicate slkg:filePath ;
                sqe:subject "f"^^spexpr:Variable
            ] )
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "line"^^spexpr:Variable ;
                sqe:predicate slkg:lineStart ;
                sqe:subject "f"^^spexpr:Variable
            ] )
        ] ) .

