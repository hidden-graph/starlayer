        slkg:lineEnd 1553 ;
        slkg:lineStart 1526 ;
        slkg:signature "def test_closed_plain_boolean_parity_still_violates_on_unlisted_property() -> None" .

    ns152:test_closed_plain_boolean_parity_still_violates_on_unlisted_property.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns152:test_cross_node_reachability_correct_through_a_cycle dcterms:identifier "tests.shacl.integration.test_native_component_composition.test_cross_node_reachability_correct_through_a_cycle" ;
        a slkg:Function ;
        rdfs:comment """Same cyclic shape graph as above, but C (reachable from the cycle)
genuinely declares a cross-node predicate - confirms the cycle guard
stops infinite recursion without also suppressing real reachability
through the cyclic part of the graph.""" ;
        rdfs:label "test_cross_node_reachability_correct_through_a_cycle" ;
        slkg:calls ns76:_cross_node_reachable_shapes ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_native_component_composition.py" ;
        slkg:hasReturnValue ns152:test_cross_node_reachability_correct_through_a_cycle.returns ;
        slkg:lineEnd 2057 ;
        slkg:lineStart 2035 ;
        slkg:signature "def test_cross_node_reachability_correct_through_a_cycle() -> None" .

    ns152:test_cross_node_reachability_correct_through_a_cycle.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns152:test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed dcterms:identifier "tests.shacl.integration.test_native_component_composition.test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed" ;
        a slkg:Function ;
        rdfs:comment """The bug the test above was written to catch turned out to only
manifest under specific ``PYTHONHASHSEED`` values (a DFS+memo
implementation memoized a node's answer using its cycle guard's early
``False`` return, which is unsound and order-dependent - fixed by
replacing it with fixed-point/worklist propagation, which is order-
independent by construction). A single in-process run can't exercise
more than one hash seed, so this drives the same check across several
fixed seeds in subprocesses - the actual regression-catching test for
this bug, not just the single-seed case above.""" ;
        rdfs:label "test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed" ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_native_component_composition.py" ;
        slkg:hasReturnValue ns152:test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed.returns ;
        slkg:lineEnd 2099 ;
        slkg:lineStart 2060 ;
        slkg:signature "def test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed() -> None" .

    ns152:test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

