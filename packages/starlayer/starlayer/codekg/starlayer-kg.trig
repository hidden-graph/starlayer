GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/to_rdf.py> {
    ns48:to_rdf.py dcterms:identifier "starlayer.sparql.to_rdf" ;
        a slkg:Module ;
        rdfs:comment """Encode a SPARQL algebra tree (rdflib CompValue/Expr nodes) as RDF triples.

One generic recursive walker handles every algebra operator and every
expression builtin uniformly — see ``vocab.py``'s module docstring for why
that is the design (and not one function per operator name).""" ;
        rdfs:label "to_rdf" ;
        slkg:declares ns54:_build_rdf_list, ns54:_encode_triple_pattern, ns54:update_to_rdf, ns54:_encode_list, ns54:queries_to_collection, ns54:_encode_comp_value, ns54:_encode, ns54:_encode_prologue, ns54:_new_starlayer_graph, ns54:_encode_quads_map, ns54:_encode_binding_row, ns54:_expr_comp_value_names, ns54:query_to_rdf, ns54:_comp_value_ns, ns54:_encode_path ;
        slkg:filePath "packages/starlayer/starlayer/sparql/to_rdf.py" ;
        slkg:importsModule ns4:__future__, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib.paths, ns4:rdflib.collection, ns4:contextvars, ns4:rdflib.namespace, ns4:rdflib, ns4:rdflib.plugins.sparql.parserutils .

    ns54:_build_rdf_list dcterms:identifier "starlayer.sparql.to_rdf._build_rdf_list" ;
        a slkg:Function ;
        rdfs:label "_build_rdf_list" ;
        slkg:filePath "packages/starlayer/starlayer/sparql/to_rdf.py" ;
        slkg:hasParameter ns54:_build_rdf_list.param.graph, ns54:_build_rdf_list.param.nodes ;
        slkg:hasReturnValue ns54:_build_rdf_list.returns ;
        slkg:isPrivate true ;
