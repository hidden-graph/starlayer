GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/star_query.py> {
    ns48:star_query.py dcterms:identifier "starlayer.sparql.star_query" ;
        a slkg:Module ;
        rdfs:comment """``StarQuery`` - binds a SPARQL query (prepared once) plus every per-call
option ``StarLayerGraph.query()`` otherwise takes, so the same query can be
run against several different graphs without re-passing the same
``entailment=``/``initNs=``/etc. arguments every time.

Mirrors ``starlayer.shacl.StarShaclSchema``'s own "bind the thing to
interpret, plus cross-cutting config, once at construction" shape -
``StarShaclSchema`` binds a shapes graph; this binds a query instead.
Deliberately does not validate a ``CONSTRUCT`` query's own result graph
against a SHACL shape - considered and rejected as out of scope for this
class.

**A real, pre-existing ``StarLayerGraph.query()`` gap, found while building
this class, not assumed away**: ``entailment=ENTAILMENT.RDF``/``RDFS``
rewrites a query's algebra to express the entailment rule - but that
rewrite only ever runs when ``query_object`` is a plain string (inside
``query_cache.prepare_query_cached``, which ``StarLayerGraph.query()``
only calls on the ``isinstance(query_object, str)`` branch). Hand it an
*already-prepared* ``Query`` object instead (exactly what preparing once
via :func:`starlayer.sparql.parse12.prepare_query_12` and reusing it would
otherwise do) with ``entailment=ENTAILMENT.RDFS`` and the rewrite silently
never happens - confirmed live: the same query returns results against
raw text + ``entailment=ENTAILMENT.RDFS``, and an empty result against a
pre-prepared ``Query`` object + the identical ``entailment=``, no error
either way. Since this class's own purpose is exactly "prepare once, reuse
across calls with a bound entailment regime," silently shipping that bug
through it would make the entailment-binding feature actively wrong for
two of the four real regimes. Worked around here (see :meth:`run`) rather
than fixed at the ``StarLayerGraph.query()`` level - that method's own
algebra-rewrite step mutates a tree in place with no safe, cheap way to
copy an ``rdflib`` ``CompValue`` tree first (confirmed: a plain
``copy.deepcopy`` fails outright, ``CompValue.__init__()`` has no
zero-argument reconstruction path pickle/copy needs), so fixing it
properly there is a larger, riskier change to a heavily-shared method -
out of scope for building this class. Flagged in
``StarLayerGraph.query()``'s own docstring too.""" ;
        rdfs:label "star_query" ;
        slkg:declares ns280:StarQuery ;
        slkg:filePath "packages/starlayer/starlayer/sparql/star_query.py" ;
        slkg:importsModule ns4:rdflib.query, ns4:collections.abc, ns4:__future__, ns4:typing .

    ns280:StarQuery dcterms:identifier "starlayer.sparql.star_query.StarQuery" ;
        a slkg:Class ;
        rdfs:comment """A SPARQL query, prepared once, bound with the options
``StarLayerGraph.query()`` otherwise takes per call - run it against as
many graphs as you like via :meth:`run`.""" ;
        rdfs:label "StarQuery" ;
        slkg:declares ns280:StarQuery.run, ns280:StarQuery.__init__ ;
        slkg:filePath "packages/starlayer/starlayer/sparql/star_query.py" ;
        slkg:lineEnd 155 ;
        slkg:lineStart 62 .

    ns280:StarQuery.__init__ dcterms:identifier "starlayer.sparql.star_query.StarQuery.__init__" ;
        a slkg:Method ;
        rdfs:comment """Parse and prepare ``text`` once; bind every other
``StarLayerGraph.query()`` option alongside it.""" ;
        rdfs:label "__init__" ;
        slkg:calls ns72:prepare_query_12 ;
        slkg:filePath "packages/starlayer/starlayer/sparql/star_query.py" ;
        slkg:hasParameter ns280:StarQuery.__init__.param.base, ns280:StarQuery.__init__.param.initBindings, ns280:StarQuery.__init__.param.infer, ns280:StarQuery.__init__.param.initNs, ns280:StarQuery.__init__.param.timeout, ns280:StarQuery.__init__.param.text, ns280:StarQuery.__init__.param.engine, ns280:StarQuery.__init__.param.entailment ;
        slkg:hasReturnValue ns280:StarQuery.__init__.returns ;
        slkg:isDunder true ;
        slkg:lineEnd 112 ;
        slkg:lineStart 68 ;
        slkg:signature "def __init__(self, text: str, *, base: str | None=None, initNs: Mapping[str, Any] | None=None, initBindings: Mapping[str, Any] | None=None, entailment: Any | None=None, infer: str='changed', engine: str='hermit', timeout: Any=_TIMEOUT_NOT_BOUND) -> None" .

    ns280:StarQuery.__init__.param.base a slkg:Parameter ;
        rdfs:comment "Optional base IRI, passed through to query preparation." ;
        rdfs:label "base" ;
        slkg:annotationText "str | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:builtins.str ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 1 .

    ns280:StarQuery.__init__.param.engine a slkg:Parameter ;
        rdfs:comment "Passed through to ``StarLayerGraph.query()`` - only consulted for ``entailment=ENTAILMENT[\"OWL-Direct\"]``." ;
        rdfs:label "engine" ;
        slkg:annotationText "str" ;
        slkg:defaultValue "'hermit'" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "kwonly" ;
        slkg:position 6 .

    ns280:StarQuery.__init__.param.entailment a slkg:Parameter ;
        rdfs:comment "The entailment regime to use on every :meth:`run` call, unless overridden per call - see ``StarLayerGraph.query()``'s own ``entailment=`` for the full set of accepted values." ;
        rdfs:label "entailment" ;
        slkg:annotationText "Any | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:typing.Any ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
