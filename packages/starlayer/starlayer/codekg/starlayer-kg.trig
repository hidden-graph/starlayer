        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "kwonly" ;
        slkg:position 1 .

    ns88:normalize_to_starlayer_graph.param.value a slkg:Parameter ;
        rdfs:comment "The graph to normalize - a StarLayerGraph, a plain rdflib.Graph, or an rdflib.Dataset/StarLayerDataset." ;
        rdfs:label "value" ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns88:normalize_to_starlayer_graph.returns a slkg:ReturnValue ;
        rdfs:comment "The normalized StarLayerGraph." ;
        slkg:annotationText "Any" ;
        slkg:hasType ns4:typing.Any .

