                    ]
                ] ;
                spexpr:other ( [
                    a spexpr:Builtin_STRSTARTS ;
                    spexpr:arg1 "symbol"^^spexpr:Variable ;
                    spexpr:arg2 "prefix"^^spexpr:Variable
                ] )
            ]
        ] [
            a sqe:Filter ;
            sqe:expr [
                a sqe:Exists ;
                sqe:negated true ;
                sqe:where ( [
                    a sqe:TriplePattern ;
                    sqe:object true ;
                    sqe:predicate slkg:isPrivate ;
                    sqe:subject "f"^^spexpr:Variable
