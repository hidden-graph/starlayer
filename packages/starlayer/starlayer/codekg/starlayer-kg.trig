    ns264:TestJsonld12IsRejectedAsUnrecognized.test_dataset_serialize_rejects dcterms:identifier "tests.graph.unit.test_jsonld12_format.TestJsonld12IsRejectedAsUnrecognized.test_dataset_serialize_rejects" ;
