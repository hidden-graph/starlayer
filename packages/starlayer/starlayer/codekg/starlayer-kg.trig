            ] )
        ] ) .

    ql:tests-of a slkg:NamedQuery ;
        rdfs:comment "The test functions and methods that call a symbol directly." ;
        rdfs:label "Which tests exercise a function?" ;
        slkg:aboutTopic ql:topic-testing ;
        slkg:answersCompetencyQuestion ql:cq-does-this-function-have-a-test-that ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a function or method" ;
            slkg:paramExample "starlayer.graph.model.encoding.tt_hash" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true
        ] ;
        slkg:queryRoot ql:tests-of-tree .

    ql:tests-of-tree a sqe:Query, sqe:SelectQuery ;
        sqe:orderBy ( [
            a sqe:OrderCondition ;
            sqe:expr "test"^^spexpr:Variable
        ] ) ;
        sqe:projection ( "test"^^spexpr:Variable "file"^^spexpr:Variable "line"^^spexpr:Variable ) ;
        sqe:prologuePrefix [
            a sqe:PrefixBinding ;
            sqe:namespace slkg: ;
            sqe:prefixLabel "slkg"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace rdfs: ;
            sqe:prefixLabel "rdfs"^^spexpr:PlainString
        ], [
            a sqe:PrefixBinding ;
            sqe:namespace dcterms: ;
            sqe:prefixLabel "dcterms"^^spexpr:PlainString
        ] ;
        sqe:where ( [
            a sqe:TriplePattern ;
            sqe:object "target"^^spexpr:Variable ;
            sqe:predicate slkg:calls ;
            sqe:subject "t"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "test"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "t"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "file"^^spexpr:Variable ;
            sqe:predicate slkg:filePath ;
            sqe:subject "t"^^spexpr:Variable
        ] [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate dcterms:identifier ;
            sqe:subject "target"^^spexpr:Variable
        ] [
            a sqe:Filter ;
            sqe:expr [
                a spexpr:Builtin_STRSTARTS ;
                spexpr:arg1 "file"^^spexpr:Variable ;
                spexpr:arg2 "packages/starlayer/tests/"
            ]
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "line"^^spexpr:Variable ;
                sqe:predicate slkg:lineStart ;
                sqe:subject "t"^^spexpr:Variable
            ] )
        ] ) .

    ql:topic-api-surface a slkg:Topic ;
        rdfs:comment "What is public, what is private, and where private names leak." ;
        rdfs:label "Visibility and API surface" .

    ql:topic-architecture a slkg:Topic ;
        rdfs:comment "Imports between modules and subpackages; where the size is." ;
        rdfs:label "Architecture and coupling" .

    ql:topic-call-graph a slkg:Topic ;
        rdfs:comment "Who calls what, call chains, instantiation." ;
        rdfs:label "Relationships and the call graph" .

    ql:topic-capabilities a slkg:Topic ;
        rdfs:comment "The curated list of what StarLayer does, and the code behind each item." ;
        rdfs:label "Capabilities" .

    ql:topic-dead-code a slkg:Topic ;
        rdfs:comment "Functions nothing calls." ;
        rdfs:label "Dead code and unused surface" .

    ql:topic-inheritance a slkg:Topic ;
        rdfs:comment "Overrides and base classes." ;
        rdfs:label "Inheritance" .

    ql:topic-navigation a slkg:Topic ;
        rdfs:comment "Finding a symbol and seeing what it is: kind, location, parameters." ;
        rdfs:label "Structure and navigation" .

    ql:topic-specifications a slkg:Topic ;
        rdfs:comment "Which code cites which specification." ;
        rdfs:label "Specifications and standards grounding" .

    ql:topic-testing a slkg:Topic ;
        rdfs:comment "Which tests exercise which code." ;
        rdfs:label "Testing linkage" .

    ql:topic-upstream-bugs a slkg:Topic ;
        rdfs:comment "Code that exists to work around a bug in another project." ;
        rdfs:label "Known upstream bugs and workarounds" .

    ql:unreferenced-functions a slkg:NamedQuery ;
        rdfs:comment "Public functions and methods with no incoming call edge at all, optionally limited to a dotted prefix. Entry points, hooks and anything called through indirection show up here, so treat it as a lead." ;
        rdfs:label "Functions nothing calls" ;
        slkg:aboutTopic ql:topic-dead-code ;
        slkg:answersCompetencyQuestion ql:cq-is-this-function-ever-called-by-anything ;
        slkg:queryParameter [
            a slkg:QueryParameter ;
            rdfs:comment "only symbols whose dotted identifier starts with this" ;
            slkg:paramExample "starlayer.sparql" ;
            slkg:paramName "prefix" ;
            slkg:paramRequired false
        ] ;
