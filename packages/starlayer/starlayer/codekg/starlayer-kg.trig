    ns61:_evaluate_ruleset dcterms:identifier "starlayer.sparql.srl_eval._evaluate_ruleset" ;
        a slkg:Function ;
        rdfs:comment """§6.5's rule-set evaluation algorithm, translated directly -
including its one easy-to-miss subtlety, confirmed against the raw
spec text (not just the informal prose): every ``evalRule`` call's own
``GD`` argument is ``G0``, the *original* base graph passed in here -
**not** the ruleset's own ``DATA`` blocks unioned in (``GD = G0 ∪ D``
is a *different*, evaluation-graph-seeding variable in the spec's own
algorithm, despite the name collision with ``evalRule``'s own ``GD``
parameter). A ``WHERE DATA {...}``/``NOT DATA {...}`` match is
therefore scoped to the rule set's original ground facts only, not to
anything any rule (including this one) has already inferred.""" ;
        rdfs:label "_evaluate_ruleset" ;
        slkg:calls ns61:_new_graph, ns61:_is_starlayer_graph, ns61:_add_all, ns61:_as_graph_kind, ns61:_ruleset_uses_triple_terms, ns61:_eval_rule, ns61:_stratify, ns61:_graph_term ;
        slkg:filePath "packages/starlayer/starlayer/sparql/srl_eval.py" ;
        slkg:hasParameter ns61:_evaluate_ruleset.param.ruleset, ns61:_evaluate_ruleset.param.base_graph ;
        slkg:hasReturnValue ns61:_evaluate_ruleset.returns ;
        slkg:instantiates ns61:SRLEvalError, ns61:SRLImportsNotSupportedError ;
        slkg:isPrivate true ;
        slkg:lineEnd 695 ;
        slkg:lineStart 625 ;
        slkg:signature "def _evaluate_ruleset(base_graph: Graph, ruleset: srl_ast.RuleSet) -> Graph" .

