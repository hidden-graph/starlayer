GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/extractor/types.py> {
    ns276:types.py dcterms:identifier "starlayer.codekg.extractor.types" ;
        a slkg:Module ;
        rdfs:comment """starlayer.codekg.extractor.types - annotation -> resolved Type node(s).

Implements the code-KG plan's "Type resolution" design: walk a parameter/
return annotation expression, pull out every ``Name``/``Attribute``-derived
dotted name it mentions, and resolve each one through the file's own import
table (see ``imports.py``) plus live ``importlib`` introspection to a
canonical dotted path - the same path for ``rdflib.Literal`` written
directly and for ``Literal`` imported from ``rdflib.term``, so both
converge on one real graph node instead of minting two.

Three functions:

- ``resolve_annotation_names(node)`` - every distinct type name mentioned.
- ``has_none_member(node)`` - whether the annotation is an optional union.
- ``resolve_type_name(name, import_table, local_classes)`` - one name ->
  ``(canonical_dotted_path, is_local)``.""" ;
        rdfs:label "types" ;
        slkg:declares ns285:_introspect, ns285:resolve_annotation_names, ns285:_is_union_marker, ns285:_dotted_name, ns285:has_none_member, ns285:_is_optional_marker, ns285:resolve_type_name ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/types.py" ;
        slkg:importsModule ns4:builtins, ns4:ast, ns4:importlib, ns4:logging, ns4:__future__ .

    ns285:_dotted_name dcterms:identifier "starlayer.codekg.extractor.types._dotted_name" ;
        a slkg:Function ;
        rdfs:comment """Reconstruct a dotted name string from a pure ``Name``/``Attribute``
chain (e.g. ``rdflib.term.Literal``), or ``None`` if ``node`` isn't one
(e.g. it's a call, a subscript, anything else).""" ;
        rdfs:label "_dotted_name" ;
        slkg:calls ns285:_dotted_name ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/types.py" ;
        slkg:hasParameter ns285:_dotted_name.param.node ;
        slkg:hasReturnValue ns285:_dotted_name.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 40 ;
        slkg:lineStart 29 ;
        slkg:signature "def _dotted_name(node: ast.expr) -> str | None" .

    ns285:_dotted_name.param.node a slkg:Parameter ;
