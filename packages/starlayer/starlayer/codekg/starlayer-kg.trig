                sqe:predicate slkg:lineEnd ;
                sqe:subject "s"^^spexpr:Variable
            ] )
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "signature"^^spexpr:Variable ;
                sqe:predicate slkg:signature ;
                sqe:subject "s"^^spexpr:Variable
            ] )
        ] [
            a sqe:Optional ;
            sqe:where ( [
                a sqe:TriplePattern ;
                sqe:object "summary"^^spexpr:Variable ;
