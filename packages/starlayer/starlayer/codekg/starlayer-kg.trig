GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/extractor/nesting.py> {
    ns276:nesting.py dcterms:identifier "starlayer.codekg.extractor.nesting" ;
        a slkg:Module ;
        rdfs:comment """starlayer.codekg.extractor.nesting - the dotted-nesting-path convention
shared between ``visitor.py`` (per-file extraction) and ``symbol_index.py``
(the whole-project pre-pass) - factored out here, not defined in either
one and imported by the other, since those two modules otherwise form a
genuine import cycle (``symbol_index`` needs this to build its project-
wide index; ``visitor`` needs ``symbol_index.SymbolIndex`` as a type for
``extract_module()``'s own new parameter).

Three functions:

- ``namedtuple_definition(node)`` - recognize ``Name = namedtuple("Name", [...])`` (or
  ``typing.NamedTuple``'s functional form) as a class definition.

- ``dotted_nesting(prefix, name)`` - join one more name onto a nesting
  path.
- ``collect_local_classes(body, ...)`` - pre-pass walk recording every
  local class's bare name -> full nesting path, before any real
  extraction/indexing happens, so a forward reference (an annotation, or a
  base class, naming a class defined later in the same file) still
  resolves correctly.""" ;
        rdfs:label "nesting" ;
        slkg:declares ns284:dotted_nesting, ns284:_call_name, ns284:namedtuple_definition, ns284:collect_local_classes ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/nesting.py" ;
        slkg:importsModule ns4:ast, ns4:__future__ .

    ns284:_call_name dcterms:identifier "starlayer.codekg.extractor.nesting._call_name" ;
        a slkg:Function ;
        rdfs:label "_call_name" ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/nesting.py" ;
        slkg:hasParameter ns284:_call_name.param.func ;
        slkg:hasReturnValue ns284:_call_name.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 33 ;
        slkg:lineStart 28 ;
        slkg:signature "def _call_name(func: ast.expr) -> str | None" .

    ns284:_call_name.param.func a slkg:Parameter ;
        rdfs:label "func" ;
        slkg:annotationText "ast.expr" ;
        slkg:hasType ns4:ast.expr ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns284:_call_name.returns a slkg:ReturnValue ;
        slkg:annotationText "str | None" ;
        slkg:hasType ns4:builtins.str ;
        slkg:optional true .

    ns284:collect_local_classes dcterms:identifier "starlayer.codekg.extractor.nesting.collect_local_classes" ;
        a slkg:Function ;
        rdfs:comment """Pre-pass mirroring the main visit's own nesting-prefix construction
(see ``dotted_nesting()``), run once before any triple is emitted (or,
in ``symbol_index.py``'s case, before any index entry is recorded) so
that an earlier definition's annotation/base-class can reference a
class defined later in the same file.""" ;
        rdfs:label "collect_local_classes" ;
        slkg:calls ns284:namedtuple_definition, ns284:collect_local_classes, ns284:dotted_nesting ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/nesting.py" ;
        slkg:hasParameter ns284:collect_local_classes.param.body, ns284:collect_local_classes.param.nesting_prefix, ns284:collect_local_classes.param.class_path_by_name, ns284:collect_local_classes.param.local_classes ;
        slkg:hasReturnValue ns284:collect_local_classes.returns ;
        slkg:lineEnd 95 ;
        slkg:lineStart 73 ;
        slkg:signature "def collect_local_classes(body: list[ast.stmt], nesting_prefix: str, local_classes: set[str], class_path_by_name: dict[str, str]) -> None" .

    ns284:collect_local_classes.param.body a slkg:Parameter ;
        rdfs:label "body" ;
        slkg:annotationText "list[ast.stmt]" ;
        slkg:hasType ns4:ast.stmt, ns4:builtins.list ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns284:collect_local_classes.param.class_path_by_name a slkg:Parameter ;
        rdfs:label "class_path_by_name" ;
        slkg:annotationText "dict[str, str]" ;
        slkg:hasType ns4:builtins.dict, ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 3 .

    ns284:collect_local_classes.param.local_classes a slkg:Parameter ;
        rdfs:label "local_classes" ;
        slkg:annotationText "set[str]" ;
        slkg:hasType ns4:builtins.set, ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 2 .

    ns284:collect_local_classes.param.nesting_prefix a slkg:Parameter ;
        rdfs:label "nesting_prefix" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns284:collect_local_classes.returns a slkg:ReturnValue ;
        slkg:annotationText "None" ;
        slkg:optional true .

    ns284:dotted_nesting dcterms:identifier "starlayer.codekg.extractor.nesting.dotted_nesting" ;
        a slkg:Function ;
        rdfs:label "dotted_nesting" ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/nesting.py" ;
        slkg:hasParameter ns284:dotted_nesting.param.name, ns284:dotted_nesting.param.nesting_prefix ;
        slkg:hasReturnValue ns284:dotted_nesting.returns ;
        slkg:lineEnd 70 ;
        slkg:lineStart 69 ;
        slkg:signature "def dotted_nesting(nesting_prefix: str, name: str) -> str" .

    ns284:dotted_nesting.param.name a slkg:Parameter ;
        rdfs:label "name" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns284:dotted_nesting.param.nesting_prefix a slkg:Parameter ;
        rdfs:label "nesting_prefix" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns284:dotted_nesting.returns a slkg:ReturnValue ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str .

    ns284:namedtuple_definition dcterms:identifier "starlayer.codekg.extractor.nesting.namedtuple_definition" ;
        a slkg:Function ;
        rdfs:comment """``(class_name, field_names, default_text_by_field)`` when ``node`` is a functional named-tuple definition
(``Name = namedtuple("Name", ["a", "b"], defaults=[None])``, ``collections.namedtuple`` or
``typing.NamedTuple`` spelled the same way), else ``None``.

The class is named after the assignment target, which is what code imports and calls. A field list that
cannot be read statically (not a literal list, tuple or string) gives an empty field list, so the class is
still recorded. Defaults apply to the last fields, as ``namedtuple`` does.""" ;
        rdfs:label "namedtuple_definition" ;
        slkg:calls ns284:_call_name ;
        slkg:filePath "packages/starlayer/starlayer/codekg/extractor/nesting.py" ;
        slkg:hasParameter ns284:namedtuple_definition.param.node ;
        slkg:hasReturnValue ns284:namedtuple_definition.returns ;
        slkg:lineEnd 66 ;
        slkg:lineStart 36 ;
        slkg:signature "def namedtuple_definition(node: ast.stmt) -> tuple[str, list[str], dict[str, str]] | None" .

    ns284:namedtuple_definition.param.node a slkg:Parameter ;
        rdfs:label "node" ;
        slkg:annotationText "ast.stmt" ;
        slkg:hasType ns4:ast.stmt ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns284:namedtuple_definition.returns a slkg:ReturnValue ;
        slkg:annotationText "tuple[str, list[str], dict[str, str]] | None" ;
