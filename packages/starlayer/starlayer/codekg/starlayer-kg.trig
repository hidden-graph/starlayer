GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/from_ast_rdf.py> {
    ns48:from_ast_rdf.py dcterms:identifier "starlayer.sparql.from_ast_rdf" ;
        a slkg:Module ;
        rdfs:comment """Decode ``sast:`` RDF back into a real, executable rdflib ``Query`` — the
mirror of ``to_ast_rdf.py``, feeding the reconstructed parse tree straight
into rdflib's own, completely unmodified ``translateQuery`` (the same
function ``parse12.prepare_query_12`` calls on a fresh parse).

Confirmed empirically that ``translateQuery``/``translatePrologue`` only
ever read ``q[0]``/``q[1]`` by indexing/iteration and write ``q[1] = ...``
by item assignment — a plain Python ``list`` supports all of that, so the
decoded tree never needs to reconstruct real ``pyparsing.ParseResults``
objects, just plain ``list``s standing in for them. This also matches
CLAUDE.md finding #11: rdflib's own tree-walking (``_traverse``/
``_traverseAgg``) is already generic over ``CompValue``/``list``/``tuple``/
``ParseResults`` — nothing that follows in the pipeline cares which of
those a bare sequence actually is.""" ;
        rdfs:label "from_ast_rdf" ;
        slkg:declares ns52:_decode, ns52:rdf_ast_to_query, ns52:_decode_comp_value, ns52:_comp_value_type ;
        slkg:filePath "packages/starlayer/starlayer/sparql/from_ast_rdf.py" ;
        slkg:importsModule ns4:rdflib.namespace, ns4:__future__, ns4:typing, ns4:rdflib, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib.collection, ns4:rdflib.plugins.sparql.parserutils, ns4:rdflib.plugins.sparql.algebra .

    ns52:_comp_value_type dcterms:identifier "starlayer.sparql.from_ast_rdf._comp_value_type" ;
        a slkg:Function ;
        rdfs:label "_comp_value_type" ;
        slkg:filePath "packages/starlayer/starlayer/sparql/from_ast_rdf.py" ;
        slkg:hasParameter ns52:_comp_value_type.param.graph, ns52:_comp_value_type.param.node ;
        slkg:isPrivate true ;
        slkg:lineEnd 88 ;
        slkg:lineStart 83 ;
        slkg:signature "def _comp_value_type(node, graph: Graph)" .

    ns52:_comp_value_type.param.graph a slkg:Parameter ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns52:_comp_value_type.param.node a slkg:Parameter ;
