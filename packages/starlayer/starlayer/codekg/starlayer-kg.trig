    ns64:resolve_imports dcterms:identifier "starlayer.sparql.srl.resolve_imports" ;
        a slkg:Function ;
        rdfs:comment """Return the *resolved* rule set (§4.5): ``ruleset`` with every ``IMPORTS``
document read, recursively, and its rules and ``DATA`` merged in. The result
has no imports left. ``ruleset`` itself is not changed.

Reading a document from the web has security implications, so nothing is read
unless the caller supplies ``loader`` - there is no default. The loader decides
where documents come from: a directory, a verified copy, a dictionary.

Each document is imported only once (§3.7), so a diamond or a cycle among the
imports does not repeat or loop. The merge follows Appendix B: the importing rule
set's rules come first, then each import's, in order; ``DATA`` blocks are
combined as an RDF merge, so a blank node in an imported document stays distinct
from a same-labelled blank node in another document.""" ;
        rdfs:label "resolve_imports" ;
        slkg:calls ns64:_rename_blank_nodes, ns64:resolve_imports._merge, ns64:parse_ruleset ;
        slkg:declares ns64:resolve_imports._merge ;
        slkg:filePath "packages/starlayer/starlayer/sparql/srl.py" ;
        slkg:hasParameter ns64:resolve_imports.param.ruleset, ns64:resolve_imports.param.loader, ns64:resolve_imports.param.location ;
        slkg:hasReturnValue ns64:resolve_imports.returns ;
        slkg:instantiates ns63:RuleSet, ns63:_Data, ns64:SRLImportError, ns63:TriplePattern ;
        slkg:lineEnd 847 ;
        slkg:lineStart 776 ;
        slkg:signature "def resolve_imports(ruleset: srl_ast.RuleSet, loader, *, location: str | None=None) -> srl_ast.RuleSet" .

