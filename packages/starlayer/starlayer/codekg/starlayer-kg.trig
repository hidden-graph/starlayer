    ns28:StarLayerGraph.resolve_imports dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.resolve_imports" ;
        a slkg:Method ;
        rdfs:comment """Follow this graph's own ``owl:imports`` (and, transitively,
whatever each imported graph itself further imports) and merge
the result.

Recursive by construction, not an opt-in extra - that's what
"import" actually means (§3.4's imports closure). Cycle protection:
an IRI already fetched, or a graph whose own ``owl:versionIRI``
already matched something already imported, is never
fetched/merged twice - when a fetched graph declares the IRI it
was fetched under as its own ``owl:versionIRI``, further imports
are followed from that graph's own *base* IRI (the subject of the
``owl:versionIRI`` triple), not the version IRI itself, so
importing a versioned module and importing its unversioned base
both correctly converge on one shared identity for deduplication.
This mirrors ``_resolve_shapes_graph_imports()``'s own
``^owl:versionIRI?/owl:imports`` handling, which this generalizes.""" ;
        rdfs:label "resolve_imports" ;
        slkg:calls ns28:StarLayerGraph.add, ns28:StarLayerGraph._on_mutated, ns28:StarLayerGraph._native_add_many, ns28:StarLayerGraph.has_import_locally, ns28:StarLayerGraph.owl_imports ;
        slkg:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        slkg:hasParameter ns28:StarLayerGraph.resolve_imports.param.loader, ns28:StarLayerGraph.resolve_imports.param.mode, ns28:StarLayerGraph.resolve_imports.param.target_graph ;
        slkg:hasReturnValue ns28:StarLayerGraph.resolve_imports.returns ;
        slkg:instantiates ns28:StarLayerGraph ;
        slkg:lineEnd 3588 ;
        slkg:lineStart 3456 ;
        slkg:signature "def resolve_imports(self, *, loader: Callable[[Any], Any | None] | None=None, mode: str='full', target_graph=None) -> StarLayerGraph" .

    ns28:StarLayerGraph.resolve_imports.param.loader a slkg:Parameter ;
        rdfs:comment "Given an import IRI, returns a graph for it, or ``None`` if it can't be resolved (skipped, not an error). ``None`` (the default) means \"don't attempt any external resolution at all\" - every declared import that isn't already satisfied by ``has_import_locally()`` is then simply skipped, same as an unresolvable one. This is a genuine, safe default, not a relaxation of the \"never decide retrieval policy for the caller\" rule: it doesn't silently reach anywhere, it just resolves whatever's already co-located in self. For a genuinely external import, this library still never decides on your behalf how to fetch it - that policy is entirely the caller's, via whatever ``loader`` they supply when one is needed." ;
        rdfs:label "loader" ;
        slkg:annotationText "Callable[[Any], Any | None] | None" ;
        slkg:defaultValue "None" ;
        slkg:hasType ns4:collections.abc.Callable, ns4:typing.Any ;
        slkg:optional true ;
        slkg:parameterKind "kwonly" ;
        slkg:position 0 .

    ns28:StarLayerGraph.resolve_imports.param.mode a slkg:Parameter ;
        rdfs:comment "Matches ``infer()``'s own three-way ``mode=`` contract exactly: \"full\" (default) returns a NEW graph with self's own triples plus every resolved import merged in; \"delta\" returns a NEW graph with only the newly-pulled-in triples (a true set difference against self - anything an import happens to also assert that self already has is not \"new\"); \"in-place\" adds just the delta into self directly and returns self. target_graph must not be given together with \"in-place\" (raises ValueError)." ;
        rdfs:label "mode" ;
        slkg:annotationText "str" ;
        slkg:defaultValue "'full'" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "kwonly" ;
        slkg:position 1 .

    ns28:StarLayerGraph.resolve_imports.param.target_graph a slkg:Parameter ;
        rdfs:comment "Only meaningful for mode=\"full\"; defaults to a new StarLayerGraph, or if given, entailed triples are added to it (never cleared first) - must be a StarLayerGraph, not a plain rdflib.Graph." ;
        rdfs:label "target_graph" ;
        slkg:defaultValue "None" ;
        slkg:parameterKind "kwonly" ;
        slkg:position 2 .

    ns28:StarLayerGraph.resolve_imports.returns a slkg:ReturnValue ;
        rdfs:comment "A StarLayerGraph: a new graph for mode=\"full\"/\"delta\", or self for mode=\"in-place\"." ;
        slkg:annotationText "StarLayerGraph" ;
        slkg:hasType ns28:StarLayerGraph .

