GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/trix12.py> {
    ns11:trix12.py dcterms:identifier "starlayer.graph.parsers.trix12" ;
        a slkg:Module ;
        rdfs:comment """starlayer.graph.parsers.trix12

Parse TriX 1.2 XML into triples, preserving or merging named-graph structure.

TriX is an XML-based named-graph format. Each <graph> block contains <triple>
elements whose three children are term nodes. RDF 1.2 triple terms are
represented by nesting another <triple> element in a term position (subject
or object) - the same element used for an asserted statement, disambiguated
only by structural position, not a distinct tag name. This matches Apache Jena's real TriX writer, including its lowercase
<trix> root element - it also nests <triple> for a triple term, the only
production TriX implementation found to actually support RDF 1.2 triple
terms, since Oxigraph doesn't implement TriX at all. StarLayer originally
invented its own <TriX>/<tripleTerm> spelling before this was checked
against a real implementation; both the
old root-tag capitalization and <tripleTerm> are still accepted here for
backward compatibility with anything already serialized by this parser's
own prior convention, but are no longer emitted (see trix12.py serializer).

Entry points:
    parse_trix12(text)        -> list of (s, p, o)            (merges all graphs)
    parse_trix12_named(text)  -> list of (graph_id, triples)  (preserves structure)""" ;
        rdfs:label "trix12" ;
        slkg:declares ns23:_iter_graphs, ns23:parse_trix12_named, ns23:parse_trix12, ns23:_parse_term, ns23:_parse_graph ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        slkg:importsModule ns4:rdflib, ns4:xml.etree.ElementTree, ns4:__future__ .

    ns23:_iter_graphs dcterms:identifier "starlayer.graph.parsers.trix12._iter_graphs" ;
        a slkg:Function ;
        rdfs:comment "Yield (graph_id, triples) pairs from a TriX document." ;
        rdfs:label "_iter_graphs" ;
        slkg:calls ns23:_parse_graph ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        slkg:hasParameter ns23:_iter_graphs.param.text ;
        slkg:isPrivate true ;
        slkg:lineEnd 124 ;
        slkg:lineStart 113 ;
        slkg:signature "def _iter_graphs(text: str)" .

    ns23:_iter_graphs.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns23:_parse_graph dcterms:identifier "starlayer.graph.parsers.trix12._parse_graph" ;
        a slkg:Function ;
        rdfs:comment """Parse a <graph> element; return (graph_id, triples).

The graph is named when its first child is a <uri> element.""" ;
        rdfs:label "_parse_graph" ;
        slkg:calls ns23:_parse_term ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        slkg:hasParameter ns23:_parse_graph.param.graph_elem ;
        slkg:hasReturnValue ns23:_parse_graph.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 110 ;
        slkg:lineStart 83 ;
        slkg:signature "def _parse_graph(graph_elem: ET.Element) -> tuple[URIRef | None, list[tuple]]" .

    ns23:_parse_graph.param.graph_elem a slkg:Parameter ;
        rdfs:label "graph_elem" ;
        slkg:annotationText "ET.Element" ;
        slkg:hasType ns4:xml.etree.ElementTree.Element ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns23:_parse_graph.returns a slkg:ReturnValue ;
        slkg:annotationText "tuple[URIRef | None, list[tuple]]" ;
        slkg:hasType ns4:builtins.tuple, ns4:builtins.list, ns4:rdflib.term.URIRef .

    ns23:_parse_term dcterms:identifier "starlayer.graph.parsers.trix12._parse_term" ;
        a slkg:Function ;
        rdfs:comment "Convert a TriX term element to an rdflib node or TripleTerm." ;
        rdfs:label "_parse_term" ;
        slkg:calls ns23:_parse_term ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        slkg:hasParameter ns23:_parse_term.param.elem ;
        slkg:instantiates ns5:TripleTerm ;
        slkg:isPrivate true ;
        slkg:lineEnd 80 ;
        slkg:lineStart 47 ;
        slkg:signature "def _parse_term(elem: ET.Element)" .

    ns23:_parse_term.param.elem a slkg:Parameter ;
        rdfs:label "elem" ;
        slkg:annotationText "ET.Element" ;
        slkg:hasType ns4:xml.etree.ElementTree.Element ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns23:parse_trix12 dcterms:identifier "starlayer.graph.parsers.trix12.parse_trix12" ;
        a slkg:Function ;
        rdfs:comment """Parse TriX 1.2 text; return list of (s, p, o) triples.

All named graphs are merged. Subjects and objects may be TripleTerm
instances for RDF 1.2 triple terms.""" ;
        rdfs:label "parse_trix12" ;
        slkg:calls ns23:_iter_graphs ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        slkg:hasParameter ns23:parse_trix12.param.text ;
        slkg:hasReturnValue ns23:parse_trix12.returns ;
        slkg:lineEnd 142 ;
        slkg:lineStart 127 ;
        slkg:signature "def parse_trix12(text: str) -> list[tuple]" .

    ns23:parse_trix12.param.text a slkg:Parameter ;
        rdfs:comment "The TriX 1.2 document text to parse." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns23:parse_trix12.returns a slkg:ReturnValue ;
        rdfs:comment "A list of (s, p, o) triples from every graph in the document." ;
        slkg:annotationText "list[tuple]" ;
        slkg:hasType ns4:builtins.tuple, ns4:builtins.list .

    ns23:parse_trix12_named dcterms:identifier "starlayer.graph.parsers.trix12.parse_trix12_named" ;
        a slkg:Function ;
        rdfs:comment """Parse TriX 1.2 text; return list of (graph_id, triples).

Subjects and objects may be TripleTerm instances.""" ;
        rdfs:label "parse_trix12_named" ;
        slkg:calls ns23:_iter_graphs ;
        slkg:filePath "packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        slkg:hasParameter ns23:parse_trix12_named.param.text ;
        slkg:hasReturnValue ns23:parse_trix12_named.returns ;
        slkg:lineEnd 158 ;
        slkg:lineStart 145 ;
        slkg:signature "def parse_trix12_named(text: str) -> list[tuple[URIRef | None, list[tuple]]]" .

    ns23:parse_trix12_named.param.text a slkg:Parameter ;
        rdfs:comment "The TriX 1.2 document text to parse." ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns23:parse_trix12_named.returns a slkg:ReturnValue ;
        rdfs:comment "A list of (graph_id, triples) pairs, one per graph with at least one triple - graph_id is None for an anonymous/default graph, a URIRef for a named graph." ;
        slkg:annotationText "list[tuple[URIRef | None, list[tuple]]]" ;
        slkg:hasType ns4:builtins.list, ns4:rdflib.term.URIRef, ns4:builtins.tuple .

    ns4:__future__ a slkg:ExternalModule .

    ns4:builtins.list dcterms:identifier "builtins.list" ;
