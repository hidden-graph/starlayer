        slkg:hasReturnValue ns43:_cv_get.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 55 ;
        slkg:lineStart 51 ;
        slkg:signature "def _cv_get(node: CompValue, key: str, default: Any=None) -> Any" .

