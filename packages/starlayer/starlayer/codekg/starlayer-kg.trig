    ns300:TestDirLangStringEquality.test_value_equality_aborts_the_process_known_engine_bug dcterms:identifier "tests.graph.integration.test_oxigraph_store_rdf12.TestDirLangStringEquality.test_value_equality_aborts_the_process_known_engine_bug" ;
        a slkg:Method ;
        rdfs:comment """Documents the engine bug by running raw pyoxigraph (no StarLayer
guard in between) in a subprocess - a panic is a hard process abort,
not a catchable exception. Opt-in - see _engine_abort above for why and
how to run it. If this starts PASSING the query - Oxigraph fixed it
upstream - update docs/upstream-issues/oxigraph-upstream-issues.md and
retire the equality guard (starlayer/graph/backends/dirlang_equality.py).""" ;
        rdfs:label "test_value_equality_aborts_the_process_known_engine_bug" ;
        slkg:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_store_rdf12.py" ;
