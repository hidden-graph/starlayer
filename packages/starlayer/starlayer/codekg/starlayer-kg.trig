    ns92:_preflight dcterms:identifier "starlayer.starontology.manchester._preflight" ;
        a slkg:Function ;
        rdfs:comment """Structural problems visible only in the *asserted* graph, as ``(focus_node, message)`` pairs.

``manchester_validate`` runs SHACL with RDFS inference, and several ``manch:`` properties declare an
``rdfs:domain`` - so a node whose ``rdf:type`` was deleted gets a type inferred back from its
properties and looks fine to every shape, while the decoder, which reads the asserted types, cannot
handle it. This check looks before inference does:

- exactly one ``manch:Document``;
- every node that has a ``manch:`` property is asserted with a concrete ``manch:`` type;
- every asserted ``manch:`` type is a class of the vocabulary;
- no ``rdf:List`` loops back on itself (pySHACL itself raises on a cyclic list while cloning the data
  graph, before any shape runs, so this one has to be caught here).""" ;
        rdfs:label "_preflight" ;
        slkg:calls ns92:_known_classes, ns92:_concrete_classes ;
        slkg:filePath "packages/starlayer/starlayer/starontology/manchester.py" ;
        slkg:hasParameter ns92:_preflight.param.data_graph ;
        slkg:hasReturnValue ns92:_preflight.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 1168 ;
        slkg:lineStart 1123 ;
        slkg:signature "def _preflight(data_graph: Graph) -> list[tuple]" .

    ns92:_preflight.param.data_graph a slkg:Parameter ;
        rdfs:label "data_graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns92:_preflight.returns a slkg:ReturnValue ;
        slkg:annotationText "list[tuple]" ;
        slkg:hasType ns4:builtins.list, ns4:builtins.tuple .

