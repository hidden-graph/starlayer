GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_proposition_form_encoding.py> {
    ns111:test_proposition_form_encoding.py dcterms:identifier "tests.graph.unit.test_proposition_form_encoding" ;
        a slkg:Module ;
        rdfs:comment """The internal triple-term encoding uses the RDF 1.2 Interoperability
vocabulary: each triple term is a node typed ``rdf:PropositionForm`` with
``rdf:propositionFormSubject/Predicate/Object``. Only the node's name differs
from the spec's "basic encoding" (a stable content hash instead of a fresh blank
node), and ``serialize()``/``parse()`` of plain RDF formats convert between the
two.""" ;
        rdfs:label "test_proposition_form_encoding" ;
        slkg:declares ns323:TestHiddenFromReaders, ns323:_graph, ns323:TestStoredShape, ns323:TestBasicEncodingExchange, ns323:TestRetrieval, ns323:_raw ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_proposition_form_encoding.py" ;
        slkg:importsModule ns4:rdflib, ns4:rdflib.compare, ns4:rdflib.namespace .

