    ns148:_new_oxigraph_graph dcterms:identifier "tests.sparql.w3c_sparql12.test_w3c_sparql12_oxigraph_roundtrip._new_oxigraph_graph" ;
        a slkg:Function ;
        rdfs:comment """A fixture's data may define named graphs (TriG/N-Quads) - those need
a real multi-graph StarLayerDataset, matching starlayer.graph's own
test_w3c_sparql12_eval.py::_new_oxigraph_graph(). A plain (non-dataset)
StarLayerGraph is given DATASET_DEFAULT_GRAPH_ID as its identifier so
its triples land in the endpoint's real (unnamed) default graph - what
an unmodified query with no GRAPH clause looks at by default (see
StarLayerGraph._native_scoped()'s own docstring in the sibling package).
Name kept as `_new_oxigraph_graph` (not renamed to something backend-
generic) since Oxigraph remains the default/primary target - `backend`
lets the parametrized `backend` fixture route the identical fixture data
at a second engine (Fuseki) instead, to distinguish a genuine translation
bug from an engine-specific quirk.""" ;
        rdfs:label "_new_oxigraph_graph" ;
        slkg:calls ns148:_data_format ;
        slkg:filePath "packages/starlayer/tests/sparql/w3c_sparql12/test_w3c_sparql12_oxigraph_roundtrip.py" ;
        slkg:hasParameter ns148:_new_oxigraph_graph.param.backend, ns148:_new_oxigraph_graph.param.entry ;
        slkg:hasReturnValue ns148:_new_oxigraph_graph.returns ;
        slkg:instantiates ns28:StarLayerGraph, ns31:StarLayerDataset ;
        slkg:isPrivate true ;
        slkg:lineEnd 172 ;
        slkg:lineStart 148 ;
        slkg:signature "def _new_oxigraph_graph(entry, backend: str='oxigraph') -> StarLayerGraph | StarLayerDataset" .

    ns148:_new_oxigraph_graph.param.backend a slkg:Parameter ;
        rdfs:label "backend" ;
        slkg:annotationText "str" ;
        slkg:defaultValue "'oxigraph'" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns148:_new_oxigraph_graph.param.entry a slkg:Parameter ;
        rdfs:label "entry" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns148:_new_oxigraph_graph.returns a slkg:ReturnValue ;
        slkg:annotationText "StarLayerGraph | StarLayerDataset" ;
        slkg:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph, ns4:starlayer.graph.graph.starlayer_dataset.StarLayerDataset .

    ns148:_regenerate dcterms:identifier "tests.sparql.w3c_sparql12.test_w3c_sparql12_oxigraph_roundtrip._regenerate" ;
        a slkg:Function ;
        rdfs:comment "Q -> this project's RDF algebra -> Q' (SPARQL 1.2 text)." ;
