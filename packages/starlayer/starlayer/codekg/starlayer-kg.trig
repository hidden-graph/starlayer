    ns228:test_refresh_handles_docstring_resembling_a_prefix_directive dcterms:identifier "tests.codekg.unit.test_build.test_refresh_handles_docstring_resembling_a_prefix_directive" ;
        a slkg:Function ;
        rdfs:comment """Regression test for a real bug found while running this extractor
over this project's own trig12.py: a docstring whose word-wrapping
happens to put the literal text '@prefix' at the very start of one of
its own physical lines (e.g. describing Turtle's own @prefix syntax)
was misread by several line-based post-processing steps (TriG block
splitting/prefix extraction in graph.parsers.trig12, and the
prefix/body line split in graph.graph.starlayer_dataset.serialize())
as a real directive, tearing it out of the docstring literal it's
part of and corrupting the whole document - it no longer parsed back
at all. Also covers a line starting with 'GRAPH <' and a line
starting with '@version', the same category of false positive for
the other two directive-like keywords this pipeline recognizes.""" ;
        rdfs:label "test_refresh_handles_docstring_resembling_a_prefix_directive" ;
        slkg:calls ns228:_make_repo_root, ns287:refresh ;
        slkg:filePath "packages/starlayer/tests/codekg/unit/test_build.py" ;
        slkg:hasParameter ns228:test_refresh_handles_docstring_resembling_a_prefix_directive.param.tmp_path ;
        slkg:instantiates ns31:StarLayerDataset ;
        slkg:lineEnd 165 ;
        slkg:lineStart 124 ;
        slkg:signature "def test_refresh_handles_docstring_resembling_a_prefix_directive(tmp_path)" .

