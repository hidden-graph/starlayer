        a slkg:Class ;
        rdfs:label "TestEntailmentNative" ;
        slkg:declares ns275:TestEntailmentNative.test_owl_rl_delta_does_not_duplicate_what_the_backend_already_entails, ns275:TestEntailmentNative.test_plain_query_without_entailment_still_works, ns275:TestEntailmentNative.test_domain_entailment_via_fuseki_rdfs_flag, ns275:TestEntailmentNative.test_no_explicit_identifier_needed_anymore, ns275:TestEntailmentNative.test_subclass_entailment_via_fuseki_rdfs_flag ;
        slkg:filePath "packages/starlayer/tests/graph/integration/test_entailment_native.py" ;
