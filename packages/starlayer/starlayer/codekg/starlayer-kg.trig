    ns54:_comp_value_ns dcterms:identifier "starlayer.sparql.to_rdf._comp_value_ns" ;
        a slkg:Function ;
        rdfs:comment """Which namespace a given CompValue.name encodes under - spexpr: for
the expression-family names that moved out of salg: (2026-10-10), salg:
for every other algebra operator (Join/Filter/Project/etc. - salg:'s
own, unmoved vocabulary).""" ;
        rdfs:label "_comp_value_ns" ;
        slkg:calls ns54:_expr_comp_value_names ;
        slkg:filePath "packages/starlayer/starlayer/sparql/to_rdf.py" ;
        slkg:hasParameter ns54:_comp_value_ns.param.name ;
        slkg:hasReturnValue ns54:_comp_value_ns.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 92 ;
        slkg:lineStart 84 ;
        slkg:signature "def _comp_value_ns(name: str) -> Namespace" .

    ns54:_comp_value_ns.param.name a slkg:Parameter ;
        rdfs:label "name" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns54:_comp_value_ns.returns a slkg:ReturnValue ;
        slkg:annotationText "Namespace" ;
        slkg:hasType ns4:rdflib.namespace.Namespace .

    ns54:_encode dcterms:identifier "starlayer.sparql.to_rdf._encode" ;
        a slkg:Function ;
        rdfs:comment "Encode one algebra-tree value; return the RDF term/node representing it." ;
        rdfs:label "_encode" ;
        slkg:calls ns54:_encode_binding_row, ns54:_encode_path, ns54:_encode_triple_pattern, ns54:_encode_list, ns54:_encode_comp_value ;
        slkg:filePath "packages/starlayer/starlayer/sparql/to_rdf.py" ;
        slkg:hasParameter ns54:_encode.param.value, ns54:_encode.param.graph ;
        slkg:isPrivate true ;
        slkg:lineEnd 318 ;
        slkg:lineStart 256 ;
        slkg:signature "def _encode(value, graph: Graph)" .

    ns54:_encode.param.graph a slkg:Parameter ;
        rdfs:label "graph" ;
        slkg:annotationText "Graph" ;
        slkg:hasType ns4:rdflib.graph.Graph ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns54:_encode.param.value a slkg:Parameter ;
        rdfs:label "value" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns54:_encode_binding_row dcterms:identifier "starlayer.sparql.to_rdf._encode_binding_row" ;
        a slkg:Function ;
        rdfs:comment """Encode one VALUES-clause row (one of Values.res's list elements) as
an rdf:List of salg:Binding nodes. See vocab.py's "Binding rows" section.

Every variable in a VALUES clause gets a dict entry for every row,
including an UNDEF one — rdflib represents that not as Python None but
as the bare *string* "UNDEF" (evalValues in rdflib's own evaluate.py
checks ``if v != "UNDEF"`` before binding). No special-casing needed
here for it: the generic bare-str handling in _encode (see vocab.py's
"Bare Python strings" section) already round-trips that bare string
faithfully, distinctly from a real Literal("UNDEF") term.""" ;
