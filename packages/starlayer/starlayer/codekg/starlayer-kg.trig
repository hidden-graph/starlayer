        a slkg:Function ;
        rdfs:label "test_matches_owlapi" ;
        slkg:calls ns338:load_golden, ns338:same_owl, ns338:owlapi_graph_from_golden, ns338:parse_to_graph ;
        slkg:filePath "packages/starlayer/tests/starontology/manchester_conformance/test_mc_differential.py" ;
        slkg:hasDecorator ns337:test_matches_owlapi.decorator.0, ns337:test_matches_owlapi.decorator.1 ;
        slkg:hasParameter ns337:test_matches_owlapi.param.request, ns337:test_matches_owlapi.param.case ;
        slkg:lineEnd 49 ;
        slkg:lineStart 23 ;
        slkg:signature "def test_matches_owlapi(case, request)" .

    ns337:test_matches_owlapi.decorator.0 a slkg:Decorator ;
