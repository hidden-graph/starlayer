    ns236:TestTripleTermPositionValidation dcterms:identifier "tests.graph.unit.test_turtle_parser.TestTripleTermPositionValidation" ;
        a slkg:Class ;
        rdfs:comment """RDF 1.2 grammar restricts what can appear in each slot of
<<( s p o )>>/<< s p o >>: the verb is always an IRI, ttSubject/
rtSubject is iri|BlankNode (no literal), and a tripleTerm/reifiedTriple
itself can never appear as an outer triple's predicate. Confirmed
against the W3C RDF 1.2 Turtle syntax test suite (tests/w3c_turtle12/).""" ;
        rdfs:label "TestTripleTermPositionValidation" ;
        slkg:declares ns236:TestTripleTermPositionValidation.test_literal_as_triple_term_subject_rejected, ns236:TestTripleTermPositionValidation.test_over_long_reified_triple_rejected, ns236:TestTripleTermPositionValidation.test_bnode_as_verb_rejected, ns236:TestTripleTermPositionValidation.test_triple_term_as_predicate_rejected, ns236:TestTripleTermPositionValidation.test_literal_as_verb_rejected, ns236:TestTripleTermPositionValidation.test_reified_triple_as_predicate_rejected ;
