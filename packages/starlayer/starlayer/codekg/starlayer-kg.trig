        slkg:hasReturnValue ns302:_graph.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 29 ;
        slkg:lineStart 28 ;
        slkg:signature "def _graph() -> StarLayerGraph" .

    ns302:_graph.returns a slkg:ReturnValue ;
        slkg:annotationText "StarLayerGraph" ;
        slkg:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

    ns302:test_validate_and_apply_rules_with_default_graph_store dcterms:identifier "tests.shacl.integration.test_native_backend_oxigraph_store.test_validate_and_apply_rules_with_default_graph_store" ;
        a slkg:Function ;
        rdfs:label "test_validate_and_apply_rules_with_default_graph_store" ;
        slkg:calls ns302:_graph ;
        slkg:filePath "packages/starlayer/tests/shacl/integration/test_native_backend_oxigraph_store.py" ;
        slkg:hasDecorator ns302:test_validate_and_apply_rules_with_default_graph_store.decorator.0, ns302:test_validate_and_apply_rules_with_default_graph_store.decorator.1 ;
        slkg:hasParameter ns302:test_validate_and_apply_rules_with_default_graph_store.param.bnode_focus, ns302:test_validate_and_apply_rules_with_default_graph_store.param.meta_shacl ;
        slkg:lineEnd 43 ;
        slkg:lineStart 34 ;
        slkg:signature "def test_validate_and_apply_rules_with_default_graph_store(bnode_focus, meta_shacl)" .

    ns302:test_validate_and_apply_rules_with_default_graph_store.decorator.0 a slkg:Decorator ;
        slkg:decoratorText "pytest.mark.parametrize('bnode_focus', [False, True], ids=['uri_focus', 'bnode_focus'])" ;
        slkg:position 0 .

