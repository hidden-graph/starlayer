        slkg:hasParameter ns202:parse_nt12.get_bnode.param.label ;
        slkg:lineEnd 60 ;
        slkg:lineStart 57 ;
        slkg:signature "def get_bnode(label)" .

    ns202:parse_nt12.get_bnode.param.label a slkg:Parameter ;
