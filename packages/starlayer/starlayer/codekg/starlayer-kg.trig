    ns224:TestOxigraphGraphUpdateRdf11Mode.test_insert_data_with_a_ground_triple_term dcterms:identifier "tests.graph.integration.test_oxigraph_backend.TestOxigraphGraphUpdateRdf11Mode.test_insert_data_with_a_ground_triple_term" ;
        a slkg:Method ;
        rdfs:comment """A shape that actually needs the RDF-1.2-to-1.1 lowering (not
just plain SPARQL 1.1 text passed straight through): the triple
term becomes a content-addressed tt:HASH URI plus its own
rdf:subject/predicate/object encoding triples - all ordinary
ground text, so (unlike a triple-term *pattern* in a WHERE clause,
which needs a starlayer.graph-only custom SPARQL function no
external engine recognizes - a separate, pre-existing limitation,
not this bug) this executes correctly against a real remote
engine that has never heard of starlayer.graph.""" ;
        rdfs:label "test_insert_data_with_a_ground_triple_term" ;
        slkg:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_backend.py" ;
