        a slkg:Method ;
        rdfs:label "test_per_call_override_does_not_disturb_the_bound_value" ;
        slkg:calls ns294:TestEntailmentBinding._graph_with_subclass ;
        slkg:filePath "packages/starlayer/tests/sparql/unit/test_star_query.py" ;
        slkg:lineEnd 73 ;
