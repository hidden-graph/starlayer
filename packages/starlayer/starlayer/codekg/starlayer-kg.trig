        a slkg:Module ;
        rdfs:comment """Extended checks of SRL's stratification (SRL §4.3.2 dependency
graph, §4.4.2 stratification) beyond the spec's one worked example in
``test_srl_eval.py``: indirect negation cycles, long chains, edge cases of
the dependency graph, and the deliberately loose pattern match.

Opt-in, like the store matrix - left out of an ordinary run, see
``tests/conftest.py``:

    pytest --srl-stratification""" ;
        rdfs:label "test_srl_stratification_extended" ;
        slkg:declares ns303:_ruleset, ns303:test_negation_cycle_through_three_rules_is_rejected, ns303:_strata, ns303:_two_rules, ns303:test_chain_result_depends_on_evaluating_in_stratum_order, ns303:test_positive_mutual_recursion_stays_in_one_stratum, ns303:test_chain_of_negations_gives_one_stratum_per_link, ns303:test_negation_cycle_through_two_rules_is_rejected, ns303:test_open_and_closed_dependency_on_the_same_rule_is_closed, ns303:test_clearly_unrelated_patterns_give_no_edge, ns303:test_plan_is_repeatable_and_does_not_change_the_rule_set, ns303:test_a_repeated_variable_does_not_narrow_the_match, ns303:test_two_rules_producing_the_same_predicate_both_feed_a_consumer, ns303:_labels, ns303:test_not_with_several_patterns_depends_on_every_rule_that_could_feed_it, ns303:test_every_dependency_of_a_run_once_rule_is_closed, ns303:test_long_negation_chain_gets_one_stratum_per_rule, ns303:test_negation_of_something_nothing_produces_is_not_a_cycle, ns303:test_many_independent_rules_share_one_stratum_with_no_edges, ns303:test_a_real_dependency_is_never_missed ;
