GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/vendor/spec_snapshots/refresh_snapshots.py> {
    ns255:refresh_snapshots.py dcterms:identifier "tests.graph.vendor.spec_snapshots.refresh_snapshots" ;
        a slkg:Module ;
        rdfs:comment """tests/vendor/spec_snapshots/refresh_snapshots.py

Re-fetches the current W3C RDF 1.2 / SPARQL 1.2 spec documents and overwrites
the local .txt snapshots in this directory. Run this, then `git diff
tests/vendor/spec_snapshots/` to see exactly what changed in the spec text since the
last snapshot - the whole point of keeping these files (see README.md).

Requires: pip install html2text (dev-only, not a project dependency)

Run from anywhere:
    python3 tests/vendor/spec_snapshots/refresh_snapshots.py""" ;
        rdfs:label "refresh_snapshots" ;
        slkg:declares ns256:fetch, ns256:main ;
        slkg:filePath "packages/starlayer/tests/graph/vendor/spec_snapshots/refresh_snapshots.py" ;
        slkg:importsModule ns4:re, ns4:urllib.request, ns4:os, ns4:subprocess .

    ns256:fetch dcterms:identifier "tests.graph.vendor.spec_snapshots.refresh_snapshots.fetch" ;
        a slkg:Function ;
        rdfs:label "fetch" ;
        slkg:filePath "packages/starlayer/tests/graph/vendor/spec_snapshots/refresh_snapshots.py" ;
        slkg:hasParameter ns256:fetch.param.title, ns256:fetch.param.slug ;
        slkg:lineEnd 62 ;
        slkg:lineStart 33 ;
        slkg:signature "def fetch(slug, title)" .

    ns256:fetch.param.slug a slkg:Parameter ;
        rdfs:label "slug" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns256:fetch.param.title a slkg:Parameter ;
        rdfs:label "title" ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns256:main dcterms:identifier "tests.graph.vendor.spec_snapshots.refresh_snapshots.main" ;
        a slkg:Function ;
        rdfs:label "main" ;
        slkg:calls ns256:fetch ;
        slkg:filePath "packages/starlayer/tests/graph/vendor/spec_snapshots/refresh_snapshots.py" ;
        slkg:lineEnd 68 ;
        slkg:lineStart 65 ;
        slkg:signature "def main()" .

    ns4:os a slkg:ExternalModule .

    ns4:re a slkg:ExternalModule .

    ns4:subprocess a slkg:ExternalModule .

    ns4:urllib.request a slkg:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/__init__.py> {
    ns291:__init__.py dcterms:identifier "starlayer.codekg.__init__" ;
        a slkg:Module ;
        rdfs:comment """starlayer.codekg - loader for the code knowledge graph extracted from
this project's own Python source.

Two files, two very different lifecycles:

- ``ontology.ttl`` is the hand-maintained vocabulary (``slkg:``/
  ``externaltype:``) this subpackage defines - never touched by the
  extractor, edited by hand like any other vocabulary in
  ``starlayer.starontology``.
- ``codekg.trig`` is the auto-generated dataset the extractor produces: one
  named graph per extracted module, wholesale-replaced on every extractor
  run (see ``starlayer.codekg.extractor``, built separately). It does not
  exist until the extractor has run at least once.

A third named graph, identified by ``CURATED_GRAPH_IRI``, holds the hand-maintained
curated layer: every ``curated/*.ttl`` file (the capabilities in ``functionality.ttl``,
the named queries in ``query-library.ttl``). It is read from those files on request,
``get_codekg_dataset(include_curated=True)``, and is never written into ``codekg.trig``.

Mirrors ``starlayer.starontology``'s own loader pattern: parse once,
never hand back a shared mutable object, copy out a fresh graph/dataset
per call instead.""" ;
        rdfs:label "__init__" ;
        slkg:declares ns292:get_codekg_dataset, ns292:get_ontology_graph, ns292:get_module_graph, ns292:_derive_demonstrated_by ;
        slkg:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        slkg:importsModule ns4:__future__, ns4:typing, ns4:rdflib, ns4:pathlib .

    ns292:_derive_demonstrated_by dcterms:identifier "starlayer.codekg.__init__._derive_demonstrated_by" ;
        a slkg:Function ;
        rdfs:comment """Add ``entity slkg:demonstratedBy example`` for each ``slkg:demonstratesIdentifier`` that names an extracted entity.

The curated files name code by dotted identifier (stable across refactors); this resolves them to the entities'
IRIs once the module graphs are loaded, the same way ``slkg:implementedByIdentifier`` is resolved at query time.""" ;
        rdfs:label "_derive_demonstrated_by" ;
        slkg:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        slkg:hasParameter ns292:_derive_demonstrated_by.param.dataset, ns292:_derive_demonstrated_by.param.curated ;
        slkg:hasReturnValue ns292:_derive_demonstrated_by.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 140 ;
        slkg:lineStart 122 ;
        slkg:signature "def _derive_demonstrated_by(dataset: StarLayerDataset, curated: StarLayerGraph) -> None" .

    ns292:_derive_demonstrated_by.param.curated a slkg:Parameter ;
        rdfs:label "curated" ;
