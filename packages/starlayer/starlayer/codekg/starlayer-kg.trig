    ns226:TestFusekiRemoteStoreSparqlCoverage.test_construct_minting_a_ground_triple_term dcterms:identifier "tests.graph.integration.test_fuseki_backend.TestFusekiRemoteStoreSparqlCoverage.test_construct_minting_a_ground_triple_term" ;
        a slkg:Method ;
        rdfs:comment """A *ground* triple term in a CONSTRUCT template used to fail the
same way test_construct_minting_a_nonground_triple_term_not_yet_supported
below still does (silently dropped, before the NotImplementedError
guard existed) - fixed by computing its hash eagerly in Python at
lowering time instead of via a starlayer.graph-only custom SPARQL
function, so there's nothing left for the remote engine to not
understand.""" ;
        rdfs:label "test_construct_minting_a_ground_triple_term" ;
        slkg:filePath "packages/starlayer/tests/graph/integration/test_fuseki_backend.py" ;
        slkg:hasParameter ns226:TestFusekiRemoteStoreSparqlCoverage.test_construct_minting_a_ground_triple_term.param.sg ;
