    ns72:_parse_with_recovery dcterms:identifier "starlayer.sparql.parse12._parse_with_recovery" ;
        a slkg:Function ;
        rdfs:comment """Shared body for ``parse_query_12``/``parse_update_12``: re-verify the
grammar installation (cheap - see ``grammar12._already_installed``'s
own docstring) before parsing, and if the parse still fails with a
``ParseBaseException`` anyway, force a full unconditional re-install
(``grammar12.install(force=True)``) and retry exactly once before
giving up.

Re-verification alone isn't sufficient: some pytest runs hit a residual
grammar corruption that ``_already_installed()``'s own live-object
check doesn't catch (the trigger lives somewhere in pytest's import
machinery, not reproducible via a plain script). A forced reinstall
immediately before retrying the *same* text recovers it. If the retry
*also* fails, that reliably means the query text itself is genuinely
invalid syntax, not a grammar-state artifact - propagates normally, no
third attempt.""" ;
        rdfs:label "_parse_with_recovery" ;
        slkg:calls ns73:install ;
        slkg:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        slkg:hasParameter ns72:_parse_with_recovery.param.parse_fn, ns72:_parse_with_recovery.param.text ;
        slkg:isPrivate true ;
        slkg:lineEnd 55 ;
        slkg:lineStart 33 ;
        slkg:signature "def _parse_with_recovery(parse_fn, text: str)" .

    ns72:_parse_with_recovery.param.parse_fn a slkg:Parameter ;
        rdfs:label "parse_fn" ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns72:_parse_with_recovery.param.text a slkg:Parameter ;
        rdfs:label "text" ;
        slkg:annotationText "str" ;
        slkg:hasType ns4:builtins.str ;
        slkg:parameterKind "positional" ;
        slkg:position 1 .

    ns72:_reject_blank_nodes_in_delete dcterms:identifier "starlayer.sparql.parse12._reject_blank_nodes_in_delete" ;
        a slkg:Function ;
        rdfs:comment """SPARQL Update forbids a blank node appearing in ``DELETE DATA``'s
``QuadData`` or in ``Modify``'s ``DELETE`` template - deleting requires
matching a specific, already-existing term, and a blank node (whether
written directly as ``_:x`` or minted implicitly by an anonymous
``{| ... |}`` annotation reifier - see ``grammar12.py``'s ``_reify``)
can never identify one. Plain, unmodified rdflib doesn't enforce this
syntactically either, so it's checked here, post-translate, against the
two operation shapes that carry a delete template: ``DeleteData.triples``/
``.quads`` directly, and ``Modify.delete.triples``/``.quads``
(``Modify.delete`` is ``None`` for an INSERT-only Modify, per
``algebra.translateUpdate1``).""" ;
        rdfs:label "_reject_blank_nodes_in_delete" ;
        slkg:calls ns72:_check_no_blank_nodes ;
        slkg:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        slkg:hasParameter ns72:_reject_blank_nodes_in_delete.param.update ;
        slkg:hasReturnValue ns72:_reject_blank_nodes_in_delete.returns ;
        slkg:isPrivate true ;
        slkg:lineEnd 214 ;
        slkg:lineStart 185 ;
        slkg:signature "def _reject_blank_nodes_in_delete(update: Update) -> Update" .

    ns72:_reject_blank_nodes_in_delete.param.update a slkg:Parameter ;
        rdfs:comment "The translated ``Update`` to check." ;
        rdfs:label "update" ;
        slkg:annotationText "Update" ;
        slkg:hasType ns4:rdflib.plugins.sparql.sparql.Update ;
        slkg:parameterKind "positional" ;
        slkg:position 0 .

    ns72:_reject_blank_nodes_in_delete.returns a slkg:ReturnValue ;
        rdfs:comment "``update`` unchanged, if no blank node was found in a delete template." ;
        slkg:annotationText "Update" ;
        slkg:hasType ns4:rdflib.plugins.sparql.sparql.Update .

    ns72:parse_query_12 dcterms:identifier "starlayer.sparql.parse12.parse_query_12" ;
        a slkg:Function ;
