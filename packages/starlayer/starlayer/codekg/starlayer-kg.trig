    ns236:TestPlainTurtle.test_typed_literal_preserves_non_canonical_lexical_form dcterms:identifier "tests.graph.unit.test_turtle_parser.TestPlainTurtle.test_typed_literal_preserves_non_canonical_lexical_form" ;
        a slkg:Method ;
        rdfs:comment """"04"^^xsd:integer must stay "04", not be silently rewritten to
the canonical "4" - RDF 1.2's own literal term-equality definition
(https://www.w3.org/TR/rdf12-concepts/#dfn-literal-term-equality)
requires the lexical form to match, not just the value, so a parser
that normalizes on construction makes two genuinely different terms
indistinguishable.""" ;
        rdfs:label "test_typed_literal_preserves_non_canonical_lexical_form" ;
        slkg:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser.py" ;
        slkg:hasParameter ns236:TestPlainTurtle.test_typed_literal_preserves_non_canonical_lexical_form.param.parser ;
