    ns163:test_recursion.py dcterms:identifier "tests.shacl.integration.test_recursion" ;
        a ns2:Module ;
        rdfs:comment """Recursive shapes are cut where the data cycles, not where the shapes repeat (GitHub issue #26).

pySHACL 0.40.1 backs out of a self-referencing shape from the sequence of shapes alone, so a chain of three or more nodes with a
violation at the end was reported as conforming. The oracle here is the same schema written out as many distinct copies of the
shape (no recursion at all): on data without a cycle the recursive shape must give the same answer.""" ;
        rdfs:label "test_recursion" ;
        ns2:declares ns214:test_a_node_reached_through_another_target_is_not_mistaken_for_a_cycle, ns214:test_a_valid_chain_conforms_and_meets_no_cycle, ns214:test_recursion_through_the_logical_constraints_finds_the_violation, ns214:_validate, ns214:_unrolled, ns214:test_a_nested_shapes_graph_is_checked_against_shacl_shacl_at_depth, ns214:_chain, ns214:test_plain_pyshacl_in_the_same_process_is_correct_too, ns214:test_a_cycle_that_is_valid_conforms_and_the_revisit_is_counted, ns214:test_a_violation_at_the_end_of_a_chain_is_found_at_any_length, ns214:test_on_data_without_a_cycle_the_recursive_shape_agrees_with_the_unrolled_one, ns214:test_no_shape_recursion_warning_is_raised, ns214:_graph, ns214:pyshacl_sh, ns214:test_a_cycle_with_a_violation_in_it_is_found, ns214:_acyclic_data, ns214:test_mutual_recursion_between_two_shapes ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_recursion.py" ;
