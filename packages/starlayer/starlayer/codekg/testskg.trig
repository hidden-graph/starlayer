    ns229:TestDefaultValueAsNodeExpression.test_default_value_as_a_path_expression_falls_back_to_a_sibling_property.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns229:TestDefaultValueAsNodeExpression.test_default_value_as_a_path_expression_is_skipped_once_a_real_value_exists dcterms:identifier "tests.shacl.integration.test_sh_values.TestDefaultValueAsNodeExpression.test_default_value_as_a_path_expression_is_skipped_once_a_real_value_exists" ;
        a ns2:Method ;
        rdfs:label "test_default_value_as_a_path_expression_is_skipped_once_a_real_value_exists" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_sh_values.py" ;
        ns2:hasReturnValue ns229:TestDefaultValueAsNodeExpression.test_default_value_as_a_path_expression_is_skipped_once_a_real_value_exists.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 295 ;
        ns2:lineStart 268 ;
        ns2:signature "def test_default_value_as_a_path_expression_is_skipped_once_a_real_value_exists(self) -> None" .

    ns229:TestDefaultValueAsNodeExpression.test_default_value_as_a_path_expression_is_skipped_once_a_real_value_exists.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns229:TestDefaultValueFallback dcterms:identifier "tests.shacl.integration.test_sh_values.TestDefaultValueFallback" ;
        a ns2:Class ;
        rdfs:comment """sh:defaultValue: the third step of SHACL 1.2 Core's own "Value Nodes
of Property Shapes" algorithm - "if the set is still empty and d is the
value of sh:defaultValue ..., then add the output nodes of
evalExpr(d, ...)" - the only one of the three steps that's conditional.

Found missing entirely (2026-09-09) by trying to write a notebook demo
for it: this file's own module docstring, and
``_patch_shape_value_nodes_for_sh_values``'s docstring in validator.py,
both already quoted this exact three-step algorithm - but the patch
itself only ever implemented steps 1 and 2 (path values, sh:values),
never step 3. A live check (a property shape with sh:defaultValue and
sh:hasValue matching it, and no stored value at all) confirmed
validate() reported a violation instead of conforming - a real,
previously-undetected gap between the documented algorithm and the
actual code, not merely an absent example.""" ;
        rdfs:label "TestDefaultValueFallback" ;
        ns2:declares ns229:TestDefaultValueFallback.test_default_value_is_ignored_once_a_real_value_exists, ns229:TestDefaultValueFallback.test_default_value_alone_with_no_sh_values_at_all_still_falls_back, ns229:TestDefaultValueFallback.test_default_value_is_ignored_once_sh_values_computes_something, ns229:TestDefaultValueFallback.test_default_value_fills_in_when_no_real_value_is_stored ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_sh_values.py" ;
        ns2:lineEnd 224 ;
        ns2:lineStart 122 .

    ns229:TestDefaultValueFallback.test_default_value_alone_with_no_sh_values_at_all_still_falls_back dcterms:identifier "tests.shacl.integration.test_sh_values.TestDefaultValueFallback.test_default_value_alone_with_no_sh_values_at_all_still_falls_back" ;
        a ns2:Method ;
        rdfs:comment """The gate must trigger on sh:defaultValue alone, not just when
sh:values is also present - a plain property shape carrying only
sh:defaultValue (the common, simpler case) needs the same fallback.""" ;
        rdfs:label "test_default_value_alone_with_no_sh_values_at_all_still_falls_back" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_sh_values.py" ;
