    ns146:TestDirLangStringCaseSensitivity dcterms:identifier "tests.graph.unit.test_turtle_parser.TestDirLangStringCaseSensitivity" ;
        a ns2:Class ;
        rdfs:comment """RDF 1.2 Concepts sec 3.4: base direction MUST be exactly "ltr" or
"rtl" (lowercase only - not case-folded the way the language tag
itself is, per sec 3.4.1). Confirmed against the W3C RDF 1.2 Turtle
syntax test suite (nt-ttl12-langdir-bad-2 - see tests/w3c_turtle12/).""" ;
        rdfs:label "TestDirLangStringCaseSensitivity" ;
