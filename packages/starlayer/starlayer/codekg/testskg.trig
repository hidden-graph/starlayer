    ns325:test_bind_extend_conforms dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_bind_extend_conforms" ;
        a ns2:Function ;
        rdfs:comment """The counter-example that found this whole gap: BIND's algebra node
(Extend) was missing from GraphPatternShape's recognized-operator list
entirely, and nothing caught it - the old sh:node-based sh:or dispatch
silently gave up (pyshacl's shape-recursion guard) before ever
reaching the check. A real regression test, not just a positive-
conformance one.""" ;
        rdfs:label "test_bind_extend_conforms" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 428 ;
        ns2:lineStart 413 ;
        ns2:signature "def test_bind_extend_conforms()" .

    ns325:test_binding_val_missing_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_binding_val_missing_fails" ;
        a ns2:Function ;
        rdfs:comment """salg:Binding's own salg:val was "at most one" (0 or 1) - but
to_rdf._encode_binding_row unconditionally adds this triple for every
row/variable pair, including UNDEF (represented as the spexpr:PlainString
literal "UNDEF", not by omitting the property) - so a genuinely
missing salg:val, which the old shape allowed, can never actually be
produced by this encoder and should be rejected as malformed.""" ;
        rdfs:label "test_binding_val_missing_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1216 ;
        ns2:lineStart 1201 ;
        ns2:signature "def test_binding_val_missing_fails()" .

