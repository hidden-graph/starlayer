GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_lower_rdf11.py> {
    ns300:test_lower_rdf11.py dcterms:identifier "tests.sparql.unit.test_lower_rdf11" ;
        a ns2:Module ;
        rdfs:comment """Verify ``starlayer.sparql.lower_rdf11`` — the algebra-level SPARQL 1.2 ->
SPARQL 1.1 lowering transform (see the module's own docstring for the full
design rationale).

Two layers:

1. Unit-level: hand-built small algebra snippets through
   ``lower_algebra_to_rdf11``/the full ``query_to_rdf11`` ->
   ``rdf11_to_query`` pipeline, executed *directly as a Query object*
   (no SPARQL 1.1 text involved at all — see ``lower_rdf11.py``'s module
   docstring for why ``rdf11_to_query`` is preferred over
   ``rdf11_to_sparql11_text`` for execution) against a real
   ``StarLayerGraph``, for each branch documented in ``lower_rdf11.py``'s
   own module docstring (ground/non-ground pattern position, expression
   position, ``isTRIPLE``/accessor builtins, CONSTRUCT template, VALUES
   row). Small, hand-built data rather than reusing W3C fixtures here:
   these are meant to isolate one branch at a time, the way
   ``test_roundtrip.py``/``test_phase6_*`` already do for ``to_rdf.py``/
   ``from_rdf.py``.
2. End-to-end, reusing the *existing* W3C SPARQL 1.2 fixtures already
   wired up in ``tests/test_w3c_sparql12.py`` (not duplicating them) - for
   every ``QueryEvaluationTest`` (SELECT-shaped) entry, compares this new
   lowering path's result against the same official ``.srj`` ground truth
   ``test_w3c_sparql12.py::test_eval_select`` already checks the *existing*
   (``serialize12._translate_algebra_12`` + starlayer.graph's text-based
   ``sparql12_to_11``) path against - directly testing this task's own
   acceptance criterion: same result as the already-proven-correct process,
   via a structurally different (tree-level, not text-level) route.

``test_rdf11_to_sparql11_text_still_works`` is the one dedicated test for
the text-producing path — everything else above exercises
``rdf11_to_query`` instead, so without it that path would silently lose
coverage.""" ;
        rdfs:label "test_lower_rdf11" ;
        ns2:declares ns309:test_prepare_update_12_initns, ns309:_run_update, ns309:test_prepare_query_12_base, ns309:TestInsertDataGroundTripleTermPersistsEncoding, ns309:test_langdir_hasLangdir_false_for_plain_literal, ns309:test_delete_where_nonground_triple_term_rewrites_to_modify, ns309:test_haslang_false_for_untagged_literal, ns309:test_filter_not_exists_with_multi_triple_block_executes, ns309:test_substr_binds_correctly, ns309:test_rdf11_to_sparql11_text_still_works, ns309:test_non_ground_pattern_position_match_decomposes, ns309:test_strlangdir_constructs_dirlangstring, ns309:test_construct_with_limit_lowers_and_runs, ns309:test_graph_pattern_executes_against_named_graph, ns309:test_langdir_hasLangdir, ns309:_run_update_via_text, ns309:test_prepare_query_12_initns, ns309:_run_lowered, ns309:test_delete_where_ground_triple_term, ns309:test_prepare_query_12_initns_overridden_by_query_own_prefix, ns309:test_is_triple_and_accessors, ns309:test_modify_delete_nonground_triple_term_pattern, ns309:test_lang_on_plain_langtagged_literal_still_works, ns309:test_filter_exists_with_multi_triple_block_executes, ns309:test_lang_on_dirlangstring_extracts_language_subtag, ns309:test_values_row_eager_hash, ns309:test_ground_pattern_position_binds_hash, ns309:test_eval_construct_via_lowering, ns309:test_haslang_true_for_dirlangstring_and_plain_langtagged, ns309:test_construct_template_mints_triple_term, ns309:_data_format, ns309:TestUpdateToSparql11Text, ns309:test_expression_position_inlines_hash_call, ns309:test_eval_select_via_lowering, ns309:test_modify_insert_only_nonground_triple_term_pattern, ns309:_new_graph, ns309:_eval_select_param ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_lower_rdf11.py" ;
        ns2:importsModule ns4:rdflib, ns4:rdflib.compare, ns4:json, ns4:__future__, ns4:rdflib.plugins.sparql.update, ns4:tests.sparql.w3c_sparql12.harness, ns4:pytest .

    ns309:TestInsertDataGroundTripleTermPersistsEncoding dcterms:identifier "tests.sparql.unit.test_lower_rdf11.TestInsertDataGroundTripleTermPersistsEncoding" ;
        a ns2:Class ;
        rdfs:comment """Regression test for a real gap found while `starlayer.graph` was
scoping the full removal of its old text-based rewriter: a ground
triple term used as an ordinary *value* in InsertData (not a Modify
template) was hashed correctly, but its own encoding triples
(rdf:subject/predicate/object on the tt:HASH URI) were never persisted
to the graph - only registered in the ephemeral, process-global
`remember_tt_hash` cache `_eager_lower_value` alone populates. A
same-process `.triples()` read appeared to work (it consults that
cache), masking the gap; `has_triple_term()`/`triple_terms()` (which
both rebuild their registry from the store's own *persisted* encoding
triples) never saw the triple term at all. Fixed by giving InsertData
its own lowering (`_lower_flat_triples_for_insert`/
`_lower_flat_triples_term_for_insert`) instead of reusing the shared
pattern-position one (correct for DeleteData/DeleteWhere/VALUES rows/
ordinary WHERE matching, all of which only ever *match* an existing
value, never introduce a new one).""" ;
        rdfs:label "TestInsertDataGroundTripleTermPersistsEncoding" ;
        ns2:declares ns309:TestInsertDataGroundTripleTermPersistsEncoding.test_nested_ground_triple_term_both_levels_persist_encoding, ns309:TestInsertDataGroundTripleTermPersistsEncoding.test_encoding_triples_written_for_ground_triple_term_value, ns309:TestInsertDataGroundTripleTermPersistsEncoding.test_encoding_triples_written_via_text_round_trip_too ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_lower_rdf11.py" ;
        ns2:lineEnd 695 ;
        ns2:lineStart 623 .

    ns309:TestInsertDataGroundTripleTermPersistsEncoding.test_encoding_triples_written_for_ground_triple_term_value dcterms:identifier "tests.sparql.unit.test_lower_rdf11.TestInsertDataGroundTripleTermPersistsEncoding.test_encoding_triples_written_for_ground_triple_term_value" ;
