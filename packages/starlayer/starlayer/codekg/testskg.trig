    ns250:test_meta_validate_works_as_the_first_call_in_a_fresh_process dcterms:identifier "tests.shacl.integration.test_wg_overrides.test_meta_validate_works_as_the_first_call_in_a_fresh_process" ;
        a ns2:Function ;
        rdfs:comment """The Working Group's meta-shapes use sh:memberShape, which pySHACL only knows once starlayer has registered its
native components. validate() does that on its first call, but meta_validate() can be called first: it must
register them itself, or the shipped shacl_shacl graph rejects *itself* (found 2026-10-21).""" ;
        rdfs:label "test_meta_validate_works_as_the_first_call_in_a_fresh_process" ;
