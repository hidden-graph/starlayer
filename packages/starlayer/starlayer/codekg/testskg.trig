    ns359:normalise_oracle_noise dcterms:identifier "tests.starontology.manchester_conformance.helpers.normalise_oracle_noise" ;
        a ns2:Function ;
        rdfs:comment """Remove differences that come from how the OWL API writes RDF, not from parsing:

- ``owl:distinctMembers`` (OWL 1 name) is the same axiom as ``owl:members`` on ``owl:AllDifferent``.
- Language tags are case-insensitive (BCP 47); the oracle lower-cases them.
- The harness always creates an ontology named by its request IRI, so an ``owl:Ontology`` triple for
  it appears even when the document had no ``Ontology:`` IRI. Dropped unless ``other`` has it too.""" ;
        rdfs:label "normalise_oracle_noise" ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/helpers.py" ;
        ns2:hasParameter ns359:normalise_oracle_noise.param.graph, ns359:normalise_oracle_noise.param.other ;
        ns2:hasReturnValue ns359:normalise_oracle_noise.returns ;
        ns2:lineEnd 93 ;
        ns2:lineStart 76 ;
        ns2:signature "def normalise_oracle_noise(graph: Graph, *, other: Graph | None=None) -> Graph" .

