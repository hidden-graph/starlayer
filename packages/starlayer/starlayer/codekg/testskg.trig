    ns163:test_select_widgets_role.py dcterms:identifier "tests.shacl.integration.test_select_widgets_role" ;
        a ns2:Module ;
        rdfs:comment """``select_widgets(role=...)`` only considers widgets of that role from the scoring catalog (GitHub issue #9).

The draft's Select Function takes a widget predicate and its Score Function lists every ``shui:WidgetScore``, but its
Sections 4.1 and 4.2 pick an editor for ``shui:editor`` and a viewer for ``shui:viewer``, and the built-in scores are
written per role.""" ;
        rdfs:label "test_select_widgets_role" ;
        ns2:declares ns227:test_a_widget_the_catalog_types_as_an_editor_is_an_editor, ns227:test_select_widget_single_applies_the_same_filter, ns227:test_one_catalog_serves_both_roles, ns227:test_every_builtin_widget_is_only_a_candidate_for_its_own_role, ns227:test_single_and_multi_classes_count, ns227:_graph, ns227:shapes, ns227:test_a_widget_with_no_known_role_is_a_candidate_for_both, ns227:test_a_viewer_only_catalog_gives_no_editor, ns227:test_an_editor_only_catalog_gives_no_viewer, ns227:test_the_type_may_be_declared_in_the_shapes_graph_instead, ns227:_pick, ns227:test_a_higher_scoring_widget_of_the_other_role_does_not_win, ns227:test_a_widget_the_shape_names_itself_is_not_checked_against_the_role, ns227:test_builtin_lists_match_the_widgets_the_shipped_shapes_document ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_select_widgets_role.py" ;
