GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_global_sparql_rules.py> {
    ns163:test_global_sparql_rules.py dcterms:identifier "tests.shacl.integration.test_global_sparql_rules" ;
        a ns2:Module ;
        rdfs:comment """"Global" (shape-independent) sh:SPARQLRule (SHACL 1.2): a rule node that
exists standalone, never referenced by any shape's own sh:rule property,
meant to execute once against the whole graph regardless of shape targeting.
Found missing entirely via the W3C SHACL 1.2 test suite's global-symmetric
fixture - pySHACL's own gather_rules() only discovers rules reachable via
some shape's sh:rule, so a standalone rule node is invisible to it and
silently never executes.""" ;
        rdfs:label "test_global_sparql_rules" ;
        ns2:declares ns180:test_shape_attached_rule_still_works_alongside_a_global_one, ns180:test_global_rule_deactivated_produces_nothing, ns180:test_global_rule_runs_once_against_whole_graph, ns180:test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_global_sparql_rules.py" ;
        ns2:importsModule ns4:rdflib, ns4:pytest .

    ns180:test_global_rule_deactivated_produces_nothing dcterms:identifier "tests.shacl.integration.test_global_sparql_rules.test_global_rule_deactivated_produces_nothing" ;
        a ns2:Function ;
        rdfs:label "test_global_rule_deactivated_produces_nothing" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_global_sparql_rules.py" ;
        ns2:hasReturnValue ns180:test_global_rule_deactivated_produces_nothing.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 114 ;
