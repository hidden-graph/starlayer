    ns238:test_pre_resolved_imports_need_ignore_imports_too dcterms:identifier "tests.shacl.integration.test_shapes_graph_imports.test_pre_resolved_imports_need_ignore_imports_too" ;
        a ns2:Function ;
        rdfs:comment """The exact scenario this flag exists for: the caller resolves
imports into shacl_graph themselves first (the two-call pattern),
producing a single, already-complete graph. The owl:imports triple
is still physically present in it (resolve_imports() doesn't strip
it - it's still a true fact about the document), so validate() still
has no way to tell "already handled" from "genuinely missing" just by
looking at the graph, and still raises unless told explicitly.""" ;
        rdfs:label "test_pre_resolved_imports_need_ignore_imports_too" ;
        ns2:calls ns238:_myapp_shapes ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_shapes_graph_imports.py" ;
        ns2:hasReturnValue ns238:test_pre_resolved_imports_need_ignore_imports_too.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 212 ;
        ns2:lineStart 179 ;
        ns2:signature "def test_pre_resolved_imports_need_ignore_imports_too() -> None" .

    ns238:test_pre_resolved_imports_need_ignore_imports_too.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

