GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_remainders_93.py> {
    ns300:test_remainders_93.py dcterms:identifier "tests.sparql.unit.test_remainders_93" ;
        a ns2:Module ;
        rdfs:comment """Leftovers of issue #93: annotations and reifiers wherever the grammar allows
them, MINUS over a triple-term pattern, TRIPLE() arguments, and the syntax rules
for VALUES triple terms, BIND scope and SELECT * with grouping.""" ;
        rdfs:label "test_remainders_93" ;
        ns2:declares ns323:test_a_reifier_cannot_be_a_literal_or_nil, ns323:test_annotation_forms_parse_in_a_query_and_in_insert_data, ns323:test_triple_accepts_triple_term_and_accessor_arguments, ns323:test_annotation_forms_parse_in_a_construct_template, ns323:test_a_bare_reifier_inside_a_reified_triple_parses, ns323:test_valid_forms_next_to_those_rules_still_parse, ns323:test_a_reifier_on_a_property_path_is_rejected, ns323:test_a_reifier_and_annotation_after_a_list_continuation_mean_the_expanded_triples, ns323:test_sparql11_text_for_ask_and_describe_is_not_implemented, ns323:test_syntax_rules_the_grammar_states_are_enforced, ns323:test_minus_over_a_triple_term_pattern_removes_the_matching_solution ;
