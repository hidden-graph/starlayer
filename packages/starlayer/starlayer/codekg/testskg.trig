    ns171:test_expected_predicate_does_not_override_an_existing_value dcterms:identifier "tests.shacl.integration.test_expected_predicate.test_expected_predicate_does_not_override_an_existing_value" ;
        a ns2:Function ;
        rdfs:comment """ex:rect2 already asserts a real (large) ex:area - sh:defaultValue must
not be materialized on top of it, and the rule must see the real
