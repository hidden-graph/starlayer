        ns2:declares ns134:TestRunWithTimeoutFailureModes.test_hang_raises_reasoning_timeout_error_near_the_deadline, ns134:TestRunWithTimeoutFailureModes.test_crashed_child_raises_promptly_not_after_the_full_budget, ns134:TestRunWithTimeoutFailureModes.test_grandchild_process_does_not_survive_the_timeout_kill ;
