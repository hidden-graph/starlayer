    ns330:test_worked_example_end_to_end dcterms:identifier "tests.sparql.unit.test_srl_eval.test_worked_example_end_to_end" ;
        a ns2:Function ;
        rdfs:comment """§6.6.3's final inference graph, reproduced exactly - 13 triples:
3 :exposedTo, 3 :status :criticallyExposed, 3x2 Notification triples
(fresh blank node per critically-exposed component), 1 :safeToDeploy
