    ns45:test_contracts_hunt3.py dcterms:identifier "tests.graph.unit.test_contracts_hunt3" ;
        a ns2:Module ;
        rdfs:comment """Regression tests for GitHub issues #139 (API contracts) and #140 (regressions): copies and pickles of a graph,
illegal triple positions, REGEX/REPLACE/ROUND/FLOOR/CEIL errors, ordering of language-tagged strings, and parser speed.

The oracle for the builtins is the XPath fn:matches/fn:replace/fn:round text that SPARQL 1.1 17.4 points to.""" ;
        rdfs:label "test_contracts_hunt3" ;
        ns2:declares ns55:test_deepcopy_of_dataset_keeps_triple_terms, ns55:_value, ns55:test_rounding_infinity_is_itself, ns55:test_owl_rl_inconsistency_message_is_not_repeated_per_pass, ns55:test_add_rejects_illegal_subject_or_predicate, ns55:test_rounding_ordinary_values_unchanged, ns55:test_rounding_nan_is_nan, ns55:test_invalid_regex_drops_the_row_and_does_not_abort, ns55:test_replace_groups_and_escapes, ns55:test_split_statements_line_numbers, ns55:test_deepcopy_is_independent, ns55:test_regex_valid_patterns_still_match, ns55:test_replace_with_zero_length_match_is_an_error, ns55:_names, ns55:test_replace_dollar_zero_is_the_whole_match, ns55:test_replace_with_invalid_replacement_string_is_an_error, ns55:test_query_encoders_raise_type_errors, ns55:test_language_tagged_string_is_not_greater_than_a_number, ns55:test_invalid_regex_pattern_from_data_does_not_abort, ns55:test_rounding_special_double_in_data_does_not_abort_the_query, ns55:test_invalid_regex_flag_is_an_error, ns55:test_replace_flags_are_flags, ns55:test_rounding_a_huge_double_is_itself, ns55:test_copy_of_graph_keeps_type_and_triple_terms, ns55:test_split_statements_line_numbers_do_not_rescan_the_prefix ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_contracts_hunt3.py" ;
