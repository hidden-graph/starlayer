        ns2:signature "def test_all_projected_variables_bound_conforms(self)" .

    ns327:TestUnboundProjectedVariable.test_bound_only_via_bind_conforms dcterms:identifier "tests.sparql.unit.test_sqe_ontology.TestUnboundProjectedVariable.test_bound_only_via_bind_conforms" ;
