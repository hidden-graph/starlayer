GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_timeout.py> {
    ns45:test_timeout.py dcterms:identifier "tests.graph.unit.test_timeout" ;
        a ns2:Module ;
        rdfs:comment """Tests for starlayer.graph.graph._timeout - the general wall-clock
timeout mechanism `infer(entailment=ENTAILMENT["OWL-Direct"], timeout=...)`/
`query(entailment=ENTAILMENT["OWL-Direct"], timeout=...)` share across both reasoning
engines. Uses synthetic worker functions, not real HermiT/RustDL calls -
the mechanism (subprocess spawn, deadline, process-group kill) is what's
under test here, independent of any specific reasoner; engine-specific
wiring (does infer()/query() actually pass timeout= through correctly) is
covered separately in test_infer_owl_dl.py/test_infer_owl_dl_rustdl.py.

Worker functions are module-level (not closures/lambdas) because
`multiprocessing`'s "spawn" start method needs them picklable by
reference - see _timeout.py's own module docstring for why "spawn" is
used deliberately, not left to the platform default.""" ;
        rdfs:label "test_timeout" ;
        ns2:declares ns134:TestRunWithTimeoutHappyPath, ns134:_fast_worker, ns134:TestRunWithTimeoutFailureModes, ns134:_raising_status_worker, ns134:_hang_with_grandchild_worker, ns134:_hang_worker, ns134:_crashing_worker ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_timeout.py" ;
        ns2:importsModule ns4:os, ns4:pytest, ns4:time, ns4:sys, ns4:subprocess .

    ns134:TestRunWithTimeoutFailureModes dcterms:identifier "tests.graph.unit.test_timeout.TestRunWithTimeoutFailureModes" ;
        a ns2:Class ;
