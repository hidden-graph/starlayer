        a ns2:Function ;
        rdfs:label "main" ;
        ns2:calls ns370:run_oracle_batch ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/tools/regen_owlapi_goldens.py" ;
        ns2:hasReturnValue ns370:main.returns ;
        ns2:lineEnd 85 ;
