    ns113:test_stripped_filter_recipe_correctly_excludes_non_matching_rows dcterms:identifier "tests.graph.unit.test_remote_decompose.test_stripped_filter_recipe_correctly_excludes_non_matching_rows" ;
        a ns2:Function ;
        rdfs:comment """End-to-end simulation of what StarLayerGraph.query() does with the
decomposed recipes/filters against raw (unrestored) remote result rows -
