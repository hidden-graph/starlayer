        a ns2:Function ;
        rdfs:comment """An ordinary Modify (not DeleteWhere) with a non-ground triple-term
pattern in its own WHERE clause - the case that was already working
before the DeleteWhere-specific gap, kept here as a regression test
since no Update-lowering test existed for it at all before this
session.""" ;
        rdfs:label "test_modify_delete_nonground_triple_term_pattern" ;
        ns2:calls ns309:_run_update ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_lower_rdf11.py" ;
