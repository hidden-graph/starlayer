        ns2:decoratorText "pytest.mark.parametrize('query', ['SELECT * WHERE { ?s ?p ?t . FILTER(?t = ?t) }', 'SELECT * WHERE { ?s ?p ?t . FILTER(?t != ?u) }', 'SELECT * WHERE { ?s ?p ?t . FILTER(?t = \"hi\"@en--ltr) }', 'SELECT * WHERE { ?s ?p ?t . FILTER(?t = STRLANGDIR(\"x\", \"en\", \"ltr\")) }', 'SELECT * WHERE { ?s ?p ?a . FILTER(?x + 1 = ?y) }', 'SELECT (?a = ?b AS ?eq) WHERE { ?s ?p ?a . ?s ?q ?b }', 'SELECT * WHERE { ?s ?p ?a . BIND(?a = ?b AS ?e) }', 'SELECT * WHERE { ?s ?p ?a . FILTER(?a IN (?b, ?c)) }', 'SELECT * WHERE { ?s ?p ?a . FILTER(?a NOT IN (?b)) }', 'INSERT { ?s <http://e/same> ?o } WHERE { ?s <http://e/a> ?x . ?o <http://e/a> ?y . FILTER(?x = ?y) }'])" ;
        ns2:position 0 .

