    ns196:test_unique_values_for_inside_and_correctly_detects_duplicate dcterms:identifier "tests.shacl.integration.test_native_component_composition.test_unique_values_for_inside_and_correctly_detects_duplicate" ;
        a ns2:Function ;
        rdfs:comment """sh:and/sh:or/sh:xone/sh:not shadow pySHACL's own logical-operator
components (see AndConstraintComponent's docstring in
starlayer.shacl/native_components.py): when a nested shape declares
sh:uniqueValuesFor (or any other cross-node predicate), it's invoked
ONCE with the full batch of value nodes as focus - not one node at a
time, pySHACL's own default - so it can genuinely compare candidates
against each other. This used to vacuously conform (silently missing
the real duplicate); it's now correctly data-sensitive.""" ;
        rdfs:label "test_unique_values_for_inside_and_correctly_detects_duplicate" ;
        ns2:calls ns196:_validate ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_native_component_composition.py" ;
