GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/codekg/unit/test_build.py> {
    ns6:test_build.py dcterms:identifier "tests.codekg.unit.test_build" ;
        a ns2:Module ;
        rdfs:comment """End-to-end test for starlayer.codekg.extractor.build.refresh() - the
wholesale-replace orchestration.

Writes tiny synthetic module files to a tmp dir structured to mimic
packages/starlayer/starlayer/<something>/, points refresh() at a tmp
trig_path override (never the real, checked-in codekg.trig), and
confirms: the result parses back with the expected triples, and running
refresh() a second time with a MODIFIED fixture file produces updated
triples rather than stale ones - the real behavior this design hinges on.""" ;
        rdfs:label "test_build" ;
        ns2:declares ns7:test_refresh_handles_docstring_resembling_a_prefix_directive, ns7:test_refresh_produces_expected_triples, ns7:test_refresh_removes_graph_for_module_no_longer_in_target_paths, ns7:test_refresh_writes_the_file_from_scratch_and_does_not_read_the_old_one, ns7:test_refresh_writes_test_modules_to_their_own_file, ns7:_make_repo_root, ns7:test_refresh_second_run_replaces_stale_triples_not_stacks_them ;
        ns2:filePath "packages/starlayer/tests/codekg/unit/test_build.py" ;
        ns2:importsModule ns4:rdflib.namespace, ns4:rdflib, ns4:__future__, ns4:pathlib .

    ns7:_make_repo_root dcterms:identifier "tests.codekg.unit.test_build._make_repo_root" ;
        a ns2:Function ;
        rdfs:label "_make_repo_root" ;
        ns2:filePath "packages/starlayer/tests/codekg/unit/test_build.py" ;
        ns2:hasParameter ns7:_make_repo_root.param.tmp_path ;
        ns2:hasReturnValue ns7:_make_repo_root.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 29 ;
        ns2:lineStart 25 ;
        ns2:signature "def _make_repo_root(tmp_path: Path) -> Path" .

    ns7:_make_repo_root.param.tmp_path a ns2:Parameter ;
        rdfs:label "tmp_path" ;
        ns2:annotationText "Path" ;
        ns2:hasType ns4:pathlib.Path ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:_make_repo_root.returns a ns2:ReturnValue ;
        ns2:annotationText "Path" ;
        ns2:hasType ns4:pathlib.Path .

    ns7:test_refresh_handles_docstring_resembling_a_prefix_directive dcterms:identifier "tests.codekg.unit.test_build.test_refresh_handles_docstring_resembling_a_prefix_directive" ;
        a ns2:Function ;
        rdfs:comment """Regression test for a real bug found while running this extractor
over this project's own trig12.py: a docstring whose word-wrapping
happens to put the literal text '@prefix' at the very start of one of
its own physical lines (e.g. describing Turtle's own @prefix syntax)
was misread by several line-based post-processing steps (TriG block
splitting/prefix extraction in graph.parsers.trig12, and the
prefix/body line split in graph.graph.starlayer_dataset.serialize())
as a real directive, tearing it out of the docstring literal it's
part of and corrupting the whole document - it no longer parsed back
at all. Also covers a line starting with 'GRAPH <' and a line
starting with '@version', the same category of false positive for
the other two directive-like keywords this pipeline recognizes.""" ;
        rdfs:label "test_refresh_handles_docstring_resembling_a_prefix_directive" ;
        ns2:calls ns7:_make_repo_root, ns8:refresh ;
        ns2:filePath "packages/starlayer/tests/codekg/unit/test_build.py" ;
        ns2:hasParameter ns7:test_refresh_handles_docstring_resembling_a_prefix_directive.param.tmp_path ;
        ns2:instantiates ns9:StarLayerDataset ;
        ns2:lineEnd 165 ;
        ns2:lineStart 124 ;
        ns2:signature "def test_refresh_handles_docstring_resembling_a_prefix_directive(tmp_path)" .

    ns7:test_refresh_handles_docstring_resembling_a_prefix_directive.param.tmp_path a ns2:Parameter ;
        rdfs:label "tmp_path" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

