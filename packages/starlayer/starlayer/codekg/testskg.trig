    ns125:TestQ15 dcterms:identifier "tests.graph.unit.test_sparql12_query.TestQ15" ;
        a ns2:Class ;
        rdfs:comment """An unbound ?s ?p ?o scan must return exactly the visible triples.

Encoding triples (tt:HASH rdf:subject/predicate/object ...) are an internal
implementation detail of starlayer.graph's triple-term storage.  They must never
appear in SPARQL SELECT results, even when the query has no triple-term
patterns of its own and would otherwise match every triple in the store.""" ;
        rdfs:label "TestQ15" ;
        ns2:declares ns125:TestQ15.test_open_scan_row_count_matches_triples, ns125:TestQ15.test_open_scan_no_encoding_predicates ;
