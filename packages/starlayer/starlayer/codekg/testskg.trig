        ns2:hasParameter ns275:node_closure.param.graph, ns275:node_closure.param.root ;
        ns2:hasReturnValue ns275:node_closure.returns ;
        ns2:lineEnd 30 ;
        ns2:lineStart 16 ;
        ns2:signature "def node_closure(graph: Graph, root: Node) -> Graph" .

