    ns163:test_score_conditions.py dcterms:identifier "tests.shacl.integration.test_score_conditions" ;
        a ns2:Module ;
        rdfs:comment """A condition written on a shui:WidgetScore (shui:shapesGraphShape / shui:dataGraphShape) applies to that score only, as in
the Working Group's own widget files. A score with no condition applies to everything. Layers therefore stack: a score
added by a higher layer is never blocked by a condition in a lower one (which a per-widget shui:WidgetAcceptMatcher,
shared by every layer, would do).""" ;
        rdfs:label "test_score_conditions" ;
        ns2:declares ns224:_graph, ns224:_pick, ns224:test_a_per_widget_matcher_is_a_gate_every_layer_shares, ns224:test_a_condition_on_the_focus_node_needs_a_focus_node, ns224:test_a_condition_on_a_score_applies_to_that_score_only, ns224:shapes, ns224:test_a_higher_layer_can_add_a_widget_a_lower_layer_conditioned, ns224:test_a_score_without_a_condition_applies_to_everything, ns224:test_select_widgets_applies_score_conditions_to_every_property ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_score_conditions.py" ;
