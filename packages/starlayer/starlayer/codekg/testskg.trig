        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 128 ;
        ns2:lineStart 105 ;
        ns2:signature "def test_rule_targeting_entailed_class_fires(self) -> None" .

    ns228:TestApplyRulesSeesEntailmentBeforeRulesRun.test_rule_targeting_entailed_class_fires.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns228:TestApplyRulesValidatesGlobalRuleOutput dcterms:identifier "tests.shacl.integration.test_sh_entailment.TestApplyRulesValidatesGlobalRuleOutput" ;
        a ns2:Class ;
        rdfs:comment """The other gap this same session's design closes, independent of
sh:entailment: apply_rules()'s conforms/report_graph used to only ever
reflect the state BEFORE the global sh:SPARQLRule pass - triples that
pass produces were never actually validated at all. See
starlayer/shacl/CLAUDE.md's dated entry and the comment at
apply_rules()'s own final re-validation call site.""" ;
        rdfs:label "TestApplyRulesValidatesGlobalRuleOutput" ;
        ns2:declares ns228:TestApplyRulesValidatesGlobalRuleOutput.test_conforms_reflects_a_shape_violated_only_by_global_rule_output ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_sh_entailment.py" ;
