    ns45:test_dataset.py dcterms:identifier "tests.graph.unit.test_dataset" ;
        a ns2:Module ;
        rdfs:comment """Unit tests for StarLayerDataset.

Covers: multi-graph TriG 1.2 parsing, named-graph context access,
quad iteration, TriG 1.2 / N-Quads 1.2 serialization, and round-trip.""" ;
        rdfs:label "test_dataset" ;
        ns2:declares ns59:TestCBD, ns59:ex, ns59:TestSerializeSingleGraphFormats, ns59:TestToGraph, ns59:TestSkolemizeDeskolemize, ns59:TestQuads, ns59:TestParseTriG12, ns59:TestNQ12MultiGraph, ns59:TestDefaultUnionPropagation, ns59:TestChainingContractMatchesRdflib, ns59:TestContextAPI, ns59:TestDatasetStoreLifecycle, ns59:TestRoundTrip, ns59:TestDatasetWideReifiers, ns59:TestSerialize, ns59:TestSingleDocumentFormatsParseIntoDefaultGraph, ns59:TestRawCacheInvalidation, ns59:TestTriplesChoicesRestoresTripleTerms, ns59:TestDefaultGraphIsAStarLayerGraph, ns59:TestConstruction ;
