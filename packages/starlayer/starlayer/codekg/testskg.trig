    ns327:TestUnboundProjectedVariable dcterms:identifier "tests.sparql.unit.test_sqe_ontology.TestUnboundProjectedVariable" ;
        a ns2:Class ;
        rdfs:comment """A real sh:sparql constraint on sqe:SelectQueryShape (added 2026-10-15):
valid SPARQL syntactically - SPARQL allows projecting a variable the
WHERE clause never binds, it just comes back unbound in every result
row - but flagged as a SHACL violation here, since it almost always
signals a typo or an incomplete edit (an "output" with no matching
"input"). Mirrors salg:noUnboundProjectedVariables' own semantics
(Filter never binds; OPTIONAL/UNION/BIND do), but as a declarative
sh:sparql property-path query over sqe:'s own raw tree shape, not a
custom Python ConstraintComponent - sqe:'s tree needs no algebra
resolution to answer this, unlike salg:'s resolved Project node.

sqe_parse_to_tree() itself validates and raises SQEValidationError on
a non-conforming result (2026-10-15) - these tests exercise that
raise directly, not a separate sqe_validate() call after a
successful parse.""" ;
        rdfs:label "TestUnboundProjectedVariable" ;
        ns2:declares ns327:TestUnboundProjectedVariable.test_bound_only_via_union_conforms, ns327:TestUnboundProjectedVariable.test_unbound_projected_variable_fails, ns327:TestUnboundProjectedVariable.test_bound_only_via_bind_conforms, ns327:TestUnboundProjectedVariable.test_all_projected_variables_bound_conforms, ns327:TestUnboundProjectedVariable.test_filter_alone_does_not_count_as_binding, ns327:TestUnboundProjectedVariable.test_bound_only_via_optional_conforms ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_sqe_ontology.py" ;
        ns2:lineEnd 274 ;
        ns2:lineStart 209 .

    ns327:TestUnboundProjectedVariable.test_all_projected_variables_bound_conforms dcterms:identifier "tests.sparql.unit.test_sqe_ontology.TestUnboundProjectedVariable.test_all_projected_variables_bound_conforms" ;
