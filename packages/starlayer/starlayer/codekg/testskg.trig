    ns50:TestNativeBackendRemoteRdf11UpdateVersionDirective dcterms:identifier "tests.graph.unit.test_conformance.TestNativeBackendRemoteRdf11UpdateVersionDirective" ;
        a ns2:Class ;
        rdfs:comment """native_update()'s backend='rdf-1.1' (remote, non-native) branch -
unlike the backend='rdf-1.2' branch (which sends VERSION straight
through unmodified, see TestNativeBackendVersionConformance above),
this branch locally parses the text via prepare_update_12() first (to
re-render it as plain SPARQL 1.1 text for a remote endpoint with no
triple-term notion at all) - the exact same local-parse gap
TestSparqlUpdateVersionDirective found in StarLayerGraph.update(),
just reached through native_update() instead. Found 2026-10-13.

http_update() itself is monkeypatched to capture the final text
instead of making a real HTTP request - resolve_store_http() only
needs query_endpoint/update_endpoint attributes to exist, not a live
server.""" ;
        rdfs:label "TestNativeBackendRemoteRdf11UpdateVersionDirective" ;
        ns2:declares ns50:TestNativeBackendRemoteRdf11UpdateVersionDirective.test_remote_rdf11_update_version_1_1_with_triple_term_warns, ns50:TestNativeBackendRemoteRdf11UpdateVersionDirective.test_remote_rdf11_update_version_directive_no_longer_raises ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_conformance.py" ;
        ns2:lineEnd 257 ;
        ns2:lineStart 210 .

