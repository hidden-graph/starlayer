GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/unit/test_fixture_sparql_syntax.py> {
    ns251:test_fixture_sparql_syntax.py dcterms:identifier "tests.shacl.unit.test_fixture_sparql_syntax" ;
        a ns2:Module ;
        rdfs:comment """Guards against a real class of bug that shipped silently before this test
existed: an `sh:select`/`sh:ask`/`sh:construct` query embedded in a shape -
either a test fixture or the shipped meta-shape/UI-hint assets - referencing
a function name the current SPARQL grammar doesn't actually support. Two
real instances: `isTripleTerm(...)` in two fixtures (the grammar only ever
recognized `isTRIPLE`, left over from the old text-rewriter this project
replaced) and a stale `stsh:` namespace in the shipped meta-shapes pointing
at the pre-rename `pyshacl-starlight` vocabulary. Both would have failed
this test immediately instead of sitting broken until something happened to
execute them.

Only *parses* each embedded query (via `starlayer.sparql.parse12.prepare_query_12`
- the same grammar `StarLayerGraph.query()` uses at runtime), doesn't
execute it - fast, and needs no fixture data or focus/value bindings.""" ;
        rdfs:label "test_fixture_sparql_syntax" ;
        ns2:declares ns261:test_embedded_sparql_parses, ns261:_collect_embedded_queries, ns261:test_found_at_least_one_embedded_query, ns261:_parse_ttl ;
        ns2:filePath "packages/starlayer/tests/shacl/unit/test_fixture_sparql_syntax.py" ;
        ns2:importsModule ns4:glob, ns4:pytest, ns4:__future__, ns4:rdflib, ns4:os .

    ns261:_collect_embedded_queries dcterms:identifier "tests.shacl.unit.test_fixture_sparql_syntax._collect_embedded_queries" ;
        a ns2:Function ;
        rdfs:label "_collect_embedded_queries" ;
        ns2:calls ns261:_parse_ttl ;
        ns2:filePath "packages/starlayer/tests/shacl/unit/test_fixture_sparql_syntax.py" ;
        ns2:hasReturnValue ns261:_collect_embedded_queries.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 66 ;
        ns2:lineStart 49 ;
        ns2:signature "def _collect_embedded_queries() -> list[tuple[str, str]]" .

    ns261:_collect_embedded_queries.returns a ns2:ReturnValue ;
        ns2:annotationText "list[tuple[str, str]]" ;
        ns2:hasType ns4:builtins.list, ns4:builtins.tuple, ns4:builtins.str .

    ns261:_parse_ttl dcterms:identifier "tests.shacl.unit.test_fixture_sparql_syntax._parse_ttl" ;
        a ns2:Function ;
        rdfs:comment """Plain Turtle covers the large majority of fixtures; only the ones
using real RDF 1.2 syntax (triple terms, annotations) need the turtle12
parser instead.""" ;
