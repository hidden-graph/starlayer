    ns124:TestParseQueryNestedTripleTermInObjectPosition.test_outer_object_is_triple_term dcterms:identifier "tests.graph.unit.test_sparql12_parse.TestParseQueryNestedTripleTermInObjectPosition.test_outer_object_is_triple_term" ;
        a ns2:Method ;
        rdfs:label "test_outer_object_is_triple_term" ;
        ns2:calls ns124:_is_triple_term, ns124:_first_triples_block ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_sparql12_parse.py" ;
        ns2:lineEnd 148 ;
        ns2:lineStart 144 ;
