    ns325:test_aggregate_distinct_missing_entirely_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_aggregate_distinct_missing_entirely_fails" ;
        a ns2:Function ;
        rdfs:comment """Companion to the above: confirms the cardinality half of the fix too
- salg:distinct is genuinely always present (rdf:nil when DISTINCT is
absent), so removing it entirely must now fail (minCount 1), where
the previous "at most one" framing would have allowed it.""" ;
        rdfs:label "test_aggregate_distinct_missing_entirely_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1181 ;
        ns2:lineStart 1168 ;
        ns2:signature "def test_aggregate_distinct_missing_entirely_fails()" .

    ns325:test_aggregate_distinct_wrong_type_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_aggregate_distinct_wrong_type_fails" ;
        a ns2:Function ;
        rdfs:comment """salg:distinct (Count/Sum/Min/Max/Avg/GroupConcat/Function) was
checked for cardinality only ("at most one"), and its own message
claimed the property was optional - both wrong: confirmed empirically
it is ALWAYS present (an empty Python list `[]` becomes a real
`salg:distinct rdf:nil` triple when DISTINCT is absent, never an
omitted property), so a wrongly-typed value, or the property missing
entirely, both silently conformed before this fix.""" ;
        rdfs:label "test_aggregate_distinct_wrong_type_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1165 ;
        ns2:lineStart 1147 ;
        ns2:signature "def test_aggregate_distinct_wrong_type_fails()" .

    ns325:test_arithmetic_op_every_real_operator_conforms dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_arithmetic_op_every_real_operator_conforms" ;
        a ns2:Function ;
        rdfs:comment """Positive companion - all four real Arithmetic operators (shared by
Additive and Multiplicative alike) still conform, including */ which
a first draft of this enum missed entirely (found by the existing
test_expression_family_queries_conform fixture failing on a real
multiplicative query, not assumed).""" ;
        rdfs:label "test_arithmetic_op_every_real_operator_conforms" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:hasDecorator ns325:test_arithmetic_op_every_real_operator_conforms.decorator.0 ;
        ns2:hasParameter ns325:test_arithmetic_op_every_real_operator_conforms.param.text, ns325:test_arithmetic_op_every_real_operator_conforms.param.op ;
        ns2:lineEnd 1383 ;
        ns2:lineStart 1373 ;
        ns2:signature "def test_arithmetic_op_every_real_operator_conforms(op, text)" .

    ns325:test_arithmetic_op_every_real_operator_conforms.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('op,text', [('+', 'SELECT * WHERE { ?s ?p ?o . FILTER(?o + 1 > 0) }'), ('-', 'SELECT * WHERE { ?s ?p ?o . FILTER(?o - 1 > 0) }'), ('*', 'SELECT * WHERE { ?s ?p ?o . FILTER(?o * 1 > 0) }'), ('/', 'SELECT * WHERE { ?s ?p ?o . FILTER(?o / 1 > 0) }')])" ;
        ns2:position 0 .

    ns325:test_arithmetic_op_every_real_operator_conforms.param.op a ns2:Parameter ;
