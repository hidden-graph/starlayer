    ns311:test_unaliased_expression_group_by_key_roundtrips dcterms:identifier "tests.sparql.unit.test_phase2_aggregates.test_unaliased_expression_group_by_key_roundtrips" ;
        a ns2:Function ;
        rdfs:comment """`GROUP BY (?age+1)` — a parenthesized, computed grouping key with no
`AS ?var` alias — is legal per SPARQL 1.1's own grammar, but confirmed
to crash plain, unmodified rdflib's own evaluator outright
(`evalAggregateJoin`: "Cannot eval thing: None"), independent of this
project entirely — see the sibling `starlayer.graph` repo's
`docs/upstream-issues/rdflib-upstream-issues.md` Issue 9 for the full trace. Unlike
every other query in this file, this test needs `starlayer.graph` imported
(not just plain rdflib): the actual fix is a parse-tree patch applied
at `import starlayer.graph` time
(`evaluate_patches.py::patch_group_by_unaliased_expression_key`), not
something `to_rdf.py`/`from_rdf.py`'s own generic encoder/decoder can
or should work around on their own — see `to_rdf._encode_list`'s own
docstring for why. Confirms the *round-trip* (not just direct
execution) works once the patch is active: encode, decode, execute
both, compare results.""" ;
        rdfs:label "test_unaliased_expression_group_by_key_roundtrips" ;
        ns2:calls ns311:_canon ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_aggregates.py" ;
        ns2:lineEnd 115 ;
        ns2:lineStart 78 ;
        ns2:signature "def test_unaliased_expression_group_by_key_roundtrips()" .

    ns4:pytest a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.evaluate a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.processor a ns2:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_phase2_forms.py> {
    ns300:test_phase2_forms.py dcterms:identifier "tests.sparql.unit.test_phase2_forms" ;
        a ns2:Module ;
        rdfs:comment """Phase 2a: query forms and operators that turned out to already work with
the generic encoder/decoder from Phase 1, with no new vocabulary or code —
CONSTRUCT, ASK, DESCRIBE (with and without WHERE), and MINUS. Locked in here
as regression tests.

SERVICE is checked structurally only (algebra tree equality after decode),
not executed — evaluating it would require a live network call to a SPARQL
endpoint, which this test suite must not do.""" ;
        rdfs:label "test_phase2_forms" ;
        ns2:declares ns312:_canon, ns312:_strip_bookkeeping, ns312:test_service_structural_roundtrip, ns312:test_roundtrip_result_equivalence ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        ns2:importsModule ns4:rdflib.plugins.sparql.evaluate, ns4:rdflib.plugins.sparql.processor, ns4:pytest .

    ns312:_canon dcterms:identifier "tests.sparql.unit.test_phase2_forms._canon" ;
        a ns2:Function ;
        rdfs:label "_canon" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        ns2:hasParameter ns312:_canon.param.res ;
        ns2:isPrivate true ;
        ns2:lineEnd 41 ;
        ns2:lineStart 30 ;
        ns2:signature "def _canon(res)" .

    ns312:_canon.param.res a ns2:Parameter ;
        rdfs:label "res" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns312:_strip_bookkeeping dcterms:identifier "tests.sparql.unit.test_phase2_forms._strip_bookkeeping" ;
        a ns2:Function ;
        rdfs:comment """Deep-copy an algebra tree with the _vars/lazy bookkeeping keys removed
and None-valued keys dropped, so two independently-built trees (one via
translateQuery, one via rdf_to_query) can be compared by their real
structure/content. A key explicitly set to None (translateQuery always
sets "datasetClause", even when there's no FROM clause) and an absent
key are behaviorally identical everywhere in rdflib — CompValue.__getattr__
returns None for a missing key too — so encoding skips None values
entirely rather than emitting a triple that would just decode back to
the same key: None.""" ;
        rdfs:label "_strip_bookkeeping" ;
        ns2:calls ns312:_strip_bookkeeping ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        ns2:hasParameter ns312:_strip_bookkeeping.param.node ;
        ns2:isPrivate true ;
        ns2:lineEnd 82 ;
        ns2:lineStart 59 ;
        ns2:signature "def _strip_bookkeeping(node)" .

