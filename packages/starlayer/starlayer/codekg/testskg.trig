    ns163:test_select_widgets_batching.py dcterms:identifier "tests.shacl.integration.test_select_widgets_batching" ;
        a ns2:Module ;
        rdfs:comment """``select_widgets()`` checks the catalog's matchers for all of a shape's properties in one pass per matcher shape
(GitHub issue #14: one ``validate()`` per (property, matcher) pair re-encoded the whole shapes graph each time and took
seconds for a shape with a few dozen properties). The answers must not change, so each is checked against the
one-property-at-a-time ``select_widget()`` and against the widget expected by hand.""" ;
        rdfs:label "test_select_widgets_batching" ;
        ns2:declares ns225:test_validation_runs_once_per_matcher_shape_not_once_per_property, ns225:test_a_data_matcher_with_a_focus_node_still_works, ns225:test_each_property_gets_the_widget_expected_by_hand, ns225:test_batched_answers_equal_one_property_at_a_time, ns225:graphs, ns225:test_a_wrong_batch_answer_would_be_noticed ;
