GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_compare.py> {
    ns45:test_compare.py dcterms:identifier "tests.graph.unit.test_compare" ;
        a ns2:Module ;
        rdfs:comment """Regression coverage for starlayer.graph.compare's RDF-1.2 (triple-term)
fix to isomorphism/canonicalization.

Confirmed live, before this fix existed, that plain rdflib.compare against a
StarLayerGraph containing a triple term:
- isomorphic() gave the WRONG answer for two graphs that are genuinely
  isomorphic but differ only in an arbitrary blank-node label nested inside
  a triple term.
- to_isomorphic() crashed outright (AssertionError: Term <<(...)>> must be
  an rdflib term), since TripleTerm isn't an rdflib.term.Node subclass.

Each test below would fail against that old, unpatched behavior - see
starlayer.graph/compare.py's own module docstring for why the decomposition
fix is correct.""" ;
        rdfs:label "test_compare" ;
        ns2:declares ns48:_graph, ns48:TestPlainGraphRegressionSafety, ns48:TestTripleTermIsomorphism, ns48:_people, ns48:TestSimpleLiteralVsExplicitXsdStringIsomorphism, ns48:test_isomorphic_is_false_when_the_graphs_differ_in_size, ns48:test_isomorphic_still_treats_a_simple_literal_and_xsd_string_as_equal, ns48:test_isomorphic_does_not_need_rdflibs_refinement_for_many_similar_blank_nodes, ns48:TestDirLangStringIsomorphism ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_compare.py" .

    ns48:TestDirLangStringIsomorphism dcterms:identifier "tests.graph.unit.test_compare.TestDirLangStringIsomorphism" ;
        a ns2:Class ;
        rdfs:comment """DirLangString decodes to a plain, non-Node Python object on public
iteration, exactly like TripleTerm - confirmed live this broke the same
way once _decompose() started rebuilding a real graph via .add().""" ;
        rdfs:label "TestDirLangStringIsomorphism" ;
        ns2:declares ns48:TestDirLangStringIsomorphism.test_triple_term_and_dirlangstring_together, ns48:TestDirLangStringIsomorphism.test_same_direction_is_isomorphic, ns48:TestDirLangStringIsomorphism.test_different_direction_is_not_isomorphic ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_compare.py" ;
        ns2:lineEnd 128 ;
        ns2:lineStart 98 .

