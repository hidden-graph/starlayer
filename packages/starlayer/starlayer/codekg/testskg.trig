    ns59:TestSerialize.test_literal_line_resembling_a_prefix_directive_round_trips dcterms:identifier "tests.graph.unit.test_dataset.TestSerialize.test_literal_line_resembling_a_prefix_directive_round_trips" ;
        a ns2:Method ;
        rdfs:comment """Real bug: this dataset's own trig12 serialization used to split
turtle_text into prefix/body lines via a blind
`line.startswith('@prefix')` check with no string-literal
awareness - so a multi-line literal whose word-wrapping happens to
put the literal text '@prefix' at the very start of one of its own
lines (e.g. a docstring describing Turtle's own @prefix syntax)
was torn out of its own literal and emitted as bare, unquoted
top-level text, corrupting the serialized document so it could no
longer even be parsed back.""" ;
        rdfs:label "test_literal_line_resembling_a_prefix_directive_round_trips" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_dataset.py" ;
        ns2:lineEnd 653 ;
        ns2:lineStart 630 ;
        ns2:signature "def test_literal_line_resembling_a_prefix_directive_round_trips(self)" .

