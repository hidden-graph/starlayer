    ns300:test_roundtrip.py dcterms:identifier "tests.sparql.unit.test_roundtrip" ;
        a ns2:Module ;
        rdfs:comment """Phase 1 round-trip tests: SELECT + BGP + FILTER + OPTIONAL + UNION.

Verifies text -> algebra -> RDF -> algebra -> results, by *executing* both
the original prepared query and the RDF-round-tripped reconstruction against
the same fixture graph and comparing result sets — not by comparing
regenerated query text, which isn't guaranteed stable (see algebra.py's
translateAlgebra: it always emits full IRIs, never prefixed names).""" ;
        rdfs:label "test_roundtrip" ;
        ns2:declares ns321:test_regenerated_text_is_also_executable, ns321:_canon, ns321:test_roundtrip_result_equivalence ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_roundtrip.py" ;
        ns2:importsModule ns4:rdflib.plugins.sparql.algebra, ns4:rdflib.plugins.sparql.evaluate, ns4:rdflib.plugins.sparql.processor, ns4:pytest .

