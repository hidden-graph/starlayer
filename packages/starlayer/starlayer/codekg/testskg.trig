    ns309:TestUpdateToSparql11Text dcterms:identifier "tests.sparql.unit.test_lower_rdf11.TestUpdateToSparql11Text" ;
        a ns2:Class ;
        rdfs:comment """``rdf11_update_to_sparql11_text`` - needed for a remote HTTP store
that hard-requires a plain string (SPARQLUpdateStore.update() asserts
isinstance(query, str)), unlike the direct-Update-object execution path
every other Update test in this file uses. Each case here runs the
*same* update through both ``_run_update`` (object) and
``_run_update_via_text`` (text round-trip) against separately-seeded,
identical starting graphs, and asserts they reach the same final
state - the real parity claim, not just "the text reparses.\"""" ;
        rdfs:label "TestUpdateToSparql11Text" ;
        ns2:declares ns309:TestUpdateToSparql11Text.test_modify_where_insert_with_triple_term, ns309:TestUpdateToSparql11Text.test_insert_data_with_graph_clause, ns309:TestUpdateToSparql11Text.test_delete_data_ground_triple_term, ns309:TestUpdateToSparql11Text.test_clear_graph ;
