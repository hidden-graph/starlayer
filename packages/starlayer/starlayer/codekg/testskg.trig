GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py> {
    ns163:test_rule_layers_and_run_once.py dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once" ;
        a ns2:Module ;
        rdfs:comment """sh:layer / sh:runOnce (SHACL 1.2 SPARQL Extensions section 8.2.4/8.2.6).

pySHACL's own rule loop (``pyshacl.rules.apply_rules``) processes shapes
*sequentially* - one shape's rules reach their own independent fixpoint,
then the next shape's rules run, in ``shape.order`` order. The spec's layer
model is a *global* fixpoint across every rule in a layer regardless of
which shape it's attached to, which that per-shape loop cannot express.
``starlayer.shacl/validator.py::_patch_rules_apply_for_layer_and_run_once``
replaces the loop, but only when a shapes graph actually declares
``sh:layer``/``sh:runOnce`` - see that function's docstring.""" ;
        rdfs:label "test_rule_layers_and_run_once" ;
        ns2:declares ns221:test_cross_shape_layering_orders_by_layer_not_by_shape_order, ns221:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop, ns221:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes, ns221:test_sh_order_within_a_layer_is_compared_globally_not_per_shape ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:importsModule ns4:rdflib, ns4:pytest .

    ns221:test_cross_shape_layering_orders_by_layer_not_by_shape_order dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_cross_shape_layering_orders_by_layer_not_by_shape_order" ;
        a ns2:Function ;
        rdfs:comment """ShapeA's rule (layer 0) must produce ex:stage1 before ShapeB's rule
(layer 1) can produce ex:stage2 from it. ShapeA is deliberately given a
*higher* sh:order (10) than ShapeB (0) - under pySHACL's original
per-shape-sequential loop, shapes are processed in ascending shape.order,
so ShapeB (order 0) would run to its own fixpoint *first*, see no
ex:stage1 yet, produce nothing, and never be revisited once ShapeA
(order 10) runs afterward - ex:stage2 would never appear. Only a real
cross-shape, layer-ordered fixpoint gets this right.""" ;
        rdfs:label "test_cross_shape_layering_orders_by_layer_not_by_shape_order" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:hasReturnValue ns221:test_cross_shape_layering_orders_by_layer_not_by_shape_order.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 75 ;
        ns2:lineStart 25 ;
        ns2:signature "def test_cross_shape_layering_orders_by_layer_not_by_shape_order() -> None" .

    ns221:test_cross_shape_layering_orders_by_layer_not_by_shape_order.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns221:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes" ;
        a ns2:Function ;
        rdfs:comment """A rule that mints a fresh blank node every execution would, if
(mis)treated as an ordinary iterating rule, keep producing a "new" triple
every pass forever - hitting pySHACL's own 100-iteration cap and raising
ReportableRuntimeError. Marking it sh:runOnce must make it fire exactly
once and let the call succeed.""" ;
        rdfs:label "test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:hasReturnValue ns221:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 112 ;
        ns2:lineStart 78 ;
        ns2:signature "def test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes() -> None" .

    ns221:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns221:test_sh_order_within_a_layer_is_compared_globally_not_per_shape dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_sh_order_within_a_layer_is_compared_globally_not_per_shape" ;
        a ns2:Function ;
        rdfs:comment """Two run-once rules, same layer, on two different shapes: the
precursor (sh:order 1) is on a shape with a *higher* shape.order (10)
than the dependent rule's shape (sh:order 2 on a shape with order 0).
Run-once rules fire exactly once, in sh:order sequence, with no
fixpoint re-try - so if the implementation accidentally grouped/sorted
by shape.order first (the old per-shape nesting) rather than comparing
every rule's own sh:order globally within the layer, the dependent rule
would run before the precursor and never see its output.""" ;
        rdfs:label "test_sh_order_within_a_layer_is_compared_globally_not_per_shape" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:hasReturnValue ns221:test_sh_order_within_a_layer_is_compared_globally_not_per_shape.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 168 ;
        ns2:lineStart 115 ;
        ns2:signature "def test_sh_order_within_a_layer_is_compared_globally_not_per_shape() -> None" .

    ns221:test_sh_order_within_a_layer_is_compared_globally_not_per_shape.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns221:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop" ;
        a ns2:Function ;
        rdfs:comment """No regression: a shapes graph using ordinary sh:rule with no
sh:layer/sh:runOnce anywhere must still produce the correct result via
pySHACL's own original per-shape loop (the patch delegates straight
through, unmodified) - reuses the existing reach-fixpoint fixture
already covered by test_rule_iteration.py, through apply_rules() this
time rather than validate() directly, to exercise the actual patched
call site.""" ;
        rdfs:label "test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop" ;
        ns2:calls ns164:load_shape ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:hasReturnValue ns221:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 192 ;
        ns2:lineStart 171 ;
        ns2:signature "def test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop() -> None" .

    ns221:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns4:pytest a ns2:ExternalModule .

    ns4:rdflib a ns2:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_rule_set_selection.py> {
    ns163:test_rule_set_selection.py dcterms:identifier "tests.shacl.integration.test_rule_set_selection" ;
        a ns2:Module ;
        rdfs:comment """sh:RuleSet / sh:hasRule / sh:includesRuleSet (SHACL 1.2 SPARQL Extensions
section 8.2.1, added upstream 2026-08-21, re-verified live 2026-08-26):
StarShaclSchema.apply_rules(..., rule_set=<IRI>) restricts execution to
a named, caller-selected subset of a shapes graph's rules. The spec's own
default rule set ("the set of all rules in the graph") is exactly
apply_rules()'s pre-existing no-`rule_set` behavior, so that case is a pure
regression guard here, not new functionality.

Covers both rule-execution paths, since each needed its own hook:
- global (shape-independent) sh:SPARQLRule, filtered in
  validator.py::_global_sparql_rules directly (starlayer.shacl's own code).
- shape-attached sh:rule (sh:TripleRule/sh:SPARQLRule), filtered via
  _patch_rule_apply_for_rule_set_filtering wrapping TripleRule.apply/
  SPARQLRule.apply - the same style, and independent of,
  _patch_rule_apply_for_source_rule_provenance.""" ;
        rdfs:label "test_rule_set_selection" ;
        ns2:declares ns222:TestShapeAttachedRulesPath, ns222:TestGlobalRulesPath, ns222:_data_with_knows ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_set_selection.py" ;
