    ns112:test_every_contract_entry_matches_the_live_signature.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns112:test_every_property_contract_entry_still_exists_and_is_a_property dcterms:identifier "tests.graph.unit.test_rdflib_inherited_contract.test_every_property_contract_entry_still_exists_and_is_a_property" ;
        a ns2:Function ;
        rdfs:comment """Properties have no signature to drift (they take no arguments), so
the one thing worth confirming on every run is simpler: the attribute
still exists and is still a real ``property`` (rdflib could in theory
turn one into a plain method, or remove it, in a future version).""" ;
        rdfs:label "test_every_property_contract_entry_still_exists_and_is_a_property" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_rdflib_inherited_contract.py" ;
