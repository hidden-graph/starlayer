        rdfs:label "TestNTriplesNQuadsVersionDirective" ;
        ns2:declares ns50:TestNTriplesNQuadsVersionDirective.test_1_2_basic_with_triple_term_warns_nq, ns50:TestNTriplesNQuadsVersionDirective.test_1_2_basic_with_triple_term_warns_nt, ns50:TestNTriplesNQuadsVersionDirective.test_no_version_directive_does_not_warn, ns50:TestNTriplesNQuadsVersionDirective.test_dataset_nq12_warns, ns50:TestNTriplesNQuadsVersionDirective.test_version_1_2_full_does_not_warn ;
