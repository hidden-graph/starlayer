        a ns2:Function ;
        rdfs:comment """salg:Binding must have exactly one salg:var - a row entry can't be
ambiguous about which variable it binds.""" ;
        rdfs:label "test_binding_with_two_vars_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 280 ;
        ns2:lineStart 271 ;
        ns2:signature "def test_binding_with_two_vars_fails()" .

    ns325:test_bogus_node_reused_as_p1_via_another_operator_still_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_bogus_node_reused_as_p1_via_another_operator_still_fails" ;
        a ns2:Function ;
        rdfs:comment """A second-order version of the test above: rather than the bogus
node being directly assigned to salg:p1, give it a salg:p1 property of
its own first (which - if salg:p1 still had rdfs:domain
salg:GraphPattern - would falsely entail the bogus node itself as
salg:GraphPattern), then use *that* bogus node as another Union's own
p1. Confirms removing salg:p1/p2's rdfs:domain (not just rdfs:range)
was necessary - domain entailment on the subject side of p1 is just as
exploitable as range entailment on the object side, one hop removed.""" ;
        rdfs:label "test_bogus_node_reused_as_p1_via_another_operator_still_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 244 ;
        ns2:lineStart 218 ;
        ns2:signature "def test_bogus_node_reused_as_p1_via_another_operator_still_fails()" .

