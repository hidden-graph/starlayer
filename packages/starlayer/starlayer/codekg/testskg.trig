GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py> {
    ns163:test_meta_shapes_extensions.py dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions" ;
        a ns2:Module ;
        rdfs:comment """Regression suite for starShacl's own meta-shacl preflight
(``starlayer.shacl/meta_shapes.py``), which replaces reliance on pySHACL's own
``meta_shacl`` kwarg (confirmed to have no extension point - it always
validates against its own hardcoded, process-cached ``shacl-shacl.pickle``).

Two confirmed problems motivated this: 11 brand-new SHACL 1.2 predicates
were silently under-validated (no rule at all), and 8 shadowed predicates
whose value space SHACL 1.2 widened (list-valued sh:class/sh:datatype/
sh:nodeKind, path-valued sh:equals/sh:disjoint/sh:lessThan/
sh:lessThanOrEquals, sh:closed sh:ByTypes) were *actively rejected* by
pySHACL's still-SHACL-1.0/1.1-era bundled meta-shapes, under starShacl's
own default ``meta_shacl=True``.""" ;
        rdfs:label "test_meta_shapes_extensions" ;
        ns2:declares ns192:TestConditionWellFormedness, ns192:TestNodeExpressionWellFormedness, ns192:test_load_meta_shapes_graph_returns_independent_copies, ns192:TestRuleWellFormedness, ns192:TestShuiWellFormedness, ns192:test_well_formed_new_predicate_usage_still_passes, ns192:test_empty_sh_ignored_properties_now_caught, ns192:test_malformed_member_shape_now_caught, ns192:TestShapesGraphFormCoverage, ns192:test_malformed_some_value_now_caught, ns192:test_empty_sh_xone_list_still_rejected_by_meta_shacl_even_with_allow_warnings, ns192:_validate, ns192:test_malformed_unique_values_for_now_caught, ns192:test_the_working_group_file_is_only_added_to_never_edited, ns192:test_malformed_subset_of_now_caught, ns192:test_malformed_reification_required_now_caught, ns192:test_widened_shadowed_predicate_passes_default_meta_shacl, ns192:test_meta_shacl_false_still_skips_preflight_entirely, ns192:test_meta_validate_reads_the_stored_file_and_the_library_has_no_build_code, ns192:test_allow_warnings_on_validate_relaxes_warning_severity_meta_shacl_check, ns192:test_non_empty_sh_in_and_xone_still_pass, ns192:_shui_ui_graph, ns192:test_malformed_max_list_length_now_caught_cleanly_not_a_raw_crash, ns192:test_member_shape_value_must_be_a_node_shape_not_a_property_shape, ns192:test_data_graph_with_owl_ontology_type_passes, ns192:TestSparqlQueryTextValidation, ns192:test_data_graph_owl_imports_without_ontology_type_now_caught, ns192:test_malformed_reifier_shape_now_caught, ns192:test_meta_validate_raises_reportable_runtime_error_with_expected_message, ns192:test_meta_shapes_extra_hook_enforced_end_to_end, ns192:test_malformed_min_list_length_now_caught_cleanly_not_a_raw_crash, ns192:TestSparqlWellFormedness, ns192:TestSparqlPrefixesWellFormedness, ns192:test_empty_sh_language_in_now_caught, ns192:test_malformed_unique_members_now_caught, ns192:TestConstraintComponentWellFormedness, ns192:test_non_empty_sh_ignored_properties_and_language_in_still_pass, ns192:test_empty_sh_in_list_now_caugh