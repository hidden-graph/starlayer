    ns132:TestTripleQuotedStringWithEmbeddedQuote dcterms:identifier "tests.graph.unit.test_syntax.TestTripleQuotedStringWithEmbeddedQuote" ;
        a ns2:Class ;
        rdfs:comment """A long (triple-quoted) string literal may legally contain a single
embedded quote character identical to its own delimiter (Turtle's
STRING_LITERAL_LONG_QUOTE/_SINGLE_QUOTE grammar allows up to 2
consecutive unescaped quote chars mid-string) - e.g. a docstring
quoting a short phrase like "@prefix : <http://example.org/> .".
_split_statements_impl() previously tracked only a single-char quote
state with no memory of whether the opening delimiter was the long
(triple) form or the short (single-char) form - so a lone embedded
quote was misread as closing the string early, corrupting everything
that followed it in the document. Confirmed via the code-KG
extractor's own docstrings (e.g. starlayer.graph.parsers.syntax
itself) round-tripping through serialize_turtle12() and back through
this parser - see tests/graph/unit/test_turtle_parser.py's matching
real-source repro.""" ;
        rdfs:label "TestTripleQuotedStringWithEmbeddedQuote" ;
        ns2:declares ns132:TestTripleQuotedStringWithEmbeddedQuote.test_embedded_single_quote_does_not_split_statement, ns132:TestTripleQuotedStringWithEmbeddedQuote.test_blank_line_inside_long_string_preserved_by_splitter, ns132:TestTripleQuotedStringWithEmbeddedQuote.test_embedded_single_quote_in_single_quote_delim_string, ns132:TestTripleQuotedStringWithEmbeddedQuote.test_directive_keyword_inside_long_string_not_misdetected ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_syntax.py" ;
        ns2:lineEnd 249 ;
        ns2:lineStart 190 .

    ns132:TestTripleQuotedStringWithEmbeddedQuote.test_blank_line_inside_long_string_preserved_by_splitter dcterms:identifier "tests.graph.unit.test_syntax.TestTripleQuotedStringWithEmbeddedQuote.test_blank_line_inside_long_string_preserved_by_splitter" ;
