GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/w3c_turtle12/download_w3c_turtle_tests.py> {
    ns159:download_w3c_turtle_tests.py dcterms:identifier "tests.graph.w3c_turtle12.download_w3c_turtle_tests" ;
        a ns2:Module ;
        rdfs:comment """W3C RDF 1.2 Turtle Test Suite download script.

Downloads every file referenced by both manifests W3C publishes for RDF 1.2
Turtle (eval/ - TestTurtleEval, parser output must match expected .nt; and
syntax/ - TestTurtlePositiveSyntax/TestTurtleNegativeSyntax, parse
success/failure only) from a single pinned-commit tarball snapshot of
w3c/rdf-tests (below), not from N individual live HTTP requests - mirrors
scripts/sync_w3c_shacl12_suite.py's own fetch shape (one tarball request,
pinned SHA, deliberate bump) rather than this script's own prior per-file
``requests.get()`` design, which risked GitHub's 60-req/hour unauthenticated
rate limit across this suite's 130+ files and left no record of exactly what
was fetched or when.

Both manifests land in the same flat data/ directory and one combined
manifest.csv - their filenames and test names don't collide (verified when
this was added).

Writes data/VENDORED_FROM.md recording the source, pinned SHA, and sync
date, so a reviewer can see exactly what changed by diffing one file -
same convention scripts/sync_w3c_shacl12_suite.py established.

Bumping PINNED_SHA is a deliberate, one-line, reviewable change - this
script never auto-follows ``main``'s tip. The companion SPARQL 1.2
downloaders (tests/graph/w3c_sparql12/, tests/sparql/w3c_sparql12/) pull
from the same w3c/rdf-tests repo at their own independently-pinned SHA;
bump all affected scripts together when investigating a specific upstream
change, but there's no requirement they share one SHA otherwise.

Can be run from anywhere - writes into tests/w3c_turtle12/data/ next to this
script. Always re-fetches and overwrites (the source is a pinned, immutable
commit, so there's nothing to gain from skipping files already on disk -
unlike a live, unpinned fetch, re-running this can never produce different
output until PINNED_SHA is bumped).

Usage: python download_w3c_turtle_tests.py""" ;
        rdfs:label "download_w3c_turtle_tests" ;
        ns2:declares ns160:main, ns160:parse_manifest_tests, ns160:_fetch_tarball_members ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_turtle12/download_w3c_turtle_tests.py" ;
        ns2:importsModule ns4:urllib.request, ns4:datetime, ns4:tarfile, ns4:io, ns4:re, ns4:os, ns4:__future__ .

    ns160:_fetch_tarball_members dcterms:identifier "tests.graph.w3c_turtle12.download_w3c_turtle_tests._fetch_tarball_members" ;
        a ns2:Function ;
        rdfs:comment "{category: {relative_filename: bytes}} for eval/ and syntax/." ;
        rdfs:label "_fetch_tarball_members" ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_turtle12/download_w3c_turtle_tests.py" ;
        ns2:hasReturnValue ns160:_fetch_tarball_members.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 81 ;
        ns2:lineStart 63 ;
        ns2:signature "def _fetch_tarball_members() -> dict[str, bytes]" .

    ns160:_fetch_tarball_members.returns a ns2:ReturnValue ;
        ns2:annotationText "dict[str, bytes]" ;
        ns2:hasType ns4:builtins.dict, ns4:builtins.str, ns4:builtins.bytes .

    ns160:main dcterms:identifier "tests.graph.w3c_turtle12.download_w3c_turtle_tests.main" ;
        a ns2:Function ;
        rdfs:label "main" ;
        ns2:calls ns160:parse_manifest_tests, ns160:_fetch_tarball_members ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_turtle12/download_w3c_turtle_tests.py" ;
        ns2:hasReturnValue ns160:main.returns ;
        ns2:lineEnd 184 ;
        ns2:lineStart 123 ;
        ns2:signature "def main() -> None" .

    ns160:main.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns160:parse_manifest_tests dcterms:identifier "tests.graph.w3c_turtle12.download_w3c_turtle_tests.parse_manifest_tests" ;
        a ns2:Function ;
        rdfs:comment """Parse one source's manifest.ttl into a list of (name, type, ttl, nt)
tuples (nt is None/'' for syntax-only tests).""" ;
        rdfs:label "parse_manifest_tests" ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_turtle12/download_w3c_turtle_tests.py" ;
        ns2:hasParameter ns160:parse_manifest_tests.param.manifest_text ;
        ns2:hasReturnValue ns160:parse_manifest_tests.returns ;
        ns2:lineEnd 120 ;
        ns2:lineStart 84 ;
        ns2:signature "def parse_manifest_tests(manifest_text: str) -> list[tuple[str, str, str, str]]" .

    ns160:parse_manifest_tests.param.manifest_text a ns2:Parameter ;
        rdfs:label "manifest_text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns160:parse_manifest_tests.returns a ns2:ReturnValue ;
        ns2:annotationText "list[tuple[str, str, str, str]]" ;
        ns2:hasType ns4:builtins.str, ns4:builtins.list, ns4:builtins.tuple .

    ns4:__future__ a ns2:ExternalModule .

    ns4:builtins.bytes dcterms:identifier "builtins.bytes" ;
        a ns2:ExternalType ;
        rdfs:label "bytes" ;
        rdfs:subClassOf ns2:Type .

