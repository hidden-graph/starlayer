GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_query_prepare_cache.py> {
    ns45:test_query_prepare_cache.py dcterms:identifier "tests.graph.unit.test_query_prepare_cache" ;
        a ns2:Module ;
        rdfs:comment """Regression tests for the prepared-query cache (starlayer.graph.query.query_cache).

StarLayerGraph.query()/StarLayerDataset.query() used to rewrite (SPARQL 1.2 ->
1.1) and parse the query text fresh on every call, even when the same query
text is evaluated repeatedly with only initBindings differing - exactly how
pySHACL evaluates a SHACL-AF sh:construct rule or sh:sparql constraint (once
per focus node, per iteration). These tests confirm the cache actually
eliminates the redundant work, stays correct across differing
initNs/initBindings/data mutations, and doesn't change any query's result.""" ;
        rdfs:label "test_query_prepare_cache" ;
        ns2:declares ns105:test_store_accepts_prepared_query_true_for_default_memory_store, ns105:test_repeated_query_with_different_bindings_gives_correct_results, ns105:test_store_accepts_prepared_query_false_for_sparql_update_store, ns105:test_dataset_query_correct_across_repeated_calls_with_bindings, ns105:test_construct_rule_repeated_per_focus_node_matches_pyshacl_pattern, ns105:test_cache_does_not_serve_stale_data_after_mutation, ns105:test_starlayer_graph_over_sparql_update_store_falls_back_to_string, ns105:test_triple_term_query_still_correct_with_cache, ns105:test_different_query_text_parses_again, ns105:test_repeated_identical_query_parses_once, ns105:counting_prepare_query, ns105:test_different_effective_namespaces_do_not_collide, ns105:test_dataset_repeated_query_parses_once ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_query_prepare_cache.py" ;
        ns2:importsModule ns4:pytest, ns4:rdflib.plugins.sparql, ns4:rdflib .

    ns105:counting_prepare_query dcterms:identifier "tests.graph.unit.test_query_prepare_cache.counting_prepare_query" ;
        a ns2:Function ;
        rdfs:comment """Count real calls to the actual parse+prepare entry point, patched at
every site that could do the real work: starlayer.sparql's
prepare_query_12 (starlayer.graph.query.query_cache's own local-store path,
the thing this cache exists to avoid redoing) and plain rdflib's own
prepareQuery (still used by StarLayerGraph.query()'s remote-store
fallback branch, which serializes back to text for a store that can't
accept a prepared object - see query_cache.py's own module docstring).""" ;
        rdfs:label "counting_prepare_query" ;
        ns2:declares ns105:counting_prepare_query.counting_prepare_query_12, ns105:counting_prepare_query.counting_prepareQuery ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_query_prepare_cache.py" ;
        ns2:hasDecorator ns105:counting_prepare_query.decorator.0 ;
        ns2:hasParameter ns105:counting_prepare_query.param.monkeypatch ;
        ns2:lineEnd 48 ;
        ns2:lineStart 23 ;
        ns2:signature "def counting_prepare_query(monkeypatch)" .

