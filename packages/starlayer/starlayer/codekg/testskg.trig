GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_node_shape_expression.py> {
    ns163:test_node_shape_expression.py dcterms:identifier "tests.shacl.integration.test_node_shape_expression" ;
        a ns2:Module ;
        rdfs:comment """sh:expression on a node shape (SHACL 1.2 Node Expressions 7.1: expression constraints "can be used in any shape").

A shape with sh:expression and no sh:path is a node shape (Core: a node shape is a shape that is not the subject of
sh:path). The meta-shapes used to forbid sh:expression on a node shape; the W3C test suite's own
node-expr/constraints/expression-001 uses `sh:expression false` on a node shape.""" ;
        rdfs:label "test_node_shape_expression" ;
        ns2:declares ns203:test_a_shape_with_neither_path_nor_expression_is_a_node_shape, ns203:test_a_complex_expression_on_a_node_shape_checks_each_focus_node, ns203:test_a_constant_false_expression_on_a_node_shape_fails_every_person, ns203:test_a_sh_property_value_without_sh_path_is_still_rejected, ns203:_failures, ns203:_validate, ns203:test_a_node_shape_with_an_expression_passes_the_meta_shapes, ns203:test_no_meta_shape_caps_sh_expression_at_zero_on_node_shapes, ns203:test_a_malformed_expression_on_a_node_shape_is_rejected, ns203:_graph, ns203:test_a_property_shape_may_carry_an_expression_too, ns203:test_a_constant_true_expression_on_a_node_shape_passes, ns203:_meta, ns203:test_a_node_shape_nested_through_sh_node_may_carry_an_expression, ns203:test_a_shape_with_a_path_and_an_expression_is_a_property_shape_and_not_a_node_shape ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_node_shape_expression.py" ;
        ns2:importsModule ns4:pyshacl.errors, ns4:rdflib, ns4:pytest .

    ns203:_failures dcterms:identifier "tests.shacl.integration.test_node_shape_expression._failures" ;
        a ns2:Function ;
        rdfs:comment "focus node -> source constraint component, for every violation." ;
        rdfs:label "_failures" ;
