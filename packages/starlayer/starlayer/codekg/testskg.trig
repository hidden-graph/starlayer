    ns124:TestParseQueryNestedTripleTermInSubjectPosition dcterms:identifier "tests.graph.unit.test_sparql12_parse.TestParseQueryNestedTripleTermInSubjectPosition" ;
        a ns2:Class ;
        rdfs:comment """A triple term nested in *subject* position - <<( <<(...)>> :p :o )>>
- is syntactically parseable SPARQL (the W3C suite even labels this
shape a PositiveSyntaxTest: compound-tripleterm-subject/
nested-tripleterm-02) but not a legal RDF 1.2 term: per the grammar
(https://www.w3.org/TR/rdf12-turtle/#grammar-production-tripleTerm),
nesting a triple term is legal only in *object* position. Confirmed via
a live Oxigraph instance rejecting exactly this shape (HTTP 500) - see
starlayer.sparql/triple_term.py's own InvalidTripleTermError docstring
for the full investigation. Rejecting it here (construction time, not
just at the grammar level) is the correct, spec-compliant behavior;
this class previously asserted the opposite (silent acceptance), which
was itself the bug.""" ;
        rdfs:label "TestParseQueryNestedTripleTermInSubjectPosition" ;
        ns2:declares ns124:TestParseQueryNestedTripleTermInSubjectPosition.test_raises_invalid_triple_term_error ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_sparql12_parse.py" ;
        ns2:lineEnd 127 ;
        ns2:lineStart 102 .

    ns124:TestParseQueryNestedTripleTermInSubjectPosition.test_raises_invalid_triple_term_error dcterms:identifier "tests.graph.unit.test_sparql12_parse.TestParseQueryNestedTripleTermInSubjectPosition.test_raises_invalid_triple_term_error" ;
        a ns2:Method ;
        rdfs:label "test_raises_invalid_triple_term_error" ;
