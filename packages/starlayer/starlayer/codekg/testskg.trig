        rdfs:label "test_constant_triple_terms_compare_by_value" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_triple_term_value_equality.py" ;
        ns2:hasDecorator ns143:test_constant_triple_terms_compare_by_value.decorator.0 ;
        ns2:hasParameter ns143:test_constant_triple_terms_compare_by_value.param.expr, ns143:test_constant_triple_terms_compare_by_value.param.expected ;
        ns2:lineEnd 27 ;
        ns2:lineStart 25 ;
        ns2:signature "def test_constant_triple_terms_compare_by_value(expr, expected)" .

    ns143:test_constant_triple_terms_compare_by_value.decorator.0 a ns2:Decorator ;
