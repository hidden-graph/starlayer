    ns350:TestEntailmentBinding.test_per_call_override_does_not_disturb_the_bound_value dcterms:identifier "tests.sparql.unit.test_star_query.TestEntailmentBinding.test_per_call_override_does_not_disturb_the_bound_value" ;
        a ns2:Method ;
        rdfs:label "test_per_call_override_does_not_disturb_the_bound_value" ;
        ns2:calls ns350:TestEntailmentBinding._graph_with_subclass ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_star_query.py" ;
