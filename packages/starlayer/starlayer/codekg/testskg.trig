GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/integration/test_blank_node_identity.py> {
    ns34:test_blank_node_identity.py dcterms:identifier "tests.graph.integration.test_blank_node_identity" ;
        a ns2:Module ;
        rdfs:comment """Blank-node identity through a store: the same behaviour on every engine.

A blank node's label is only meaningful inside the response that carried it
(SPARQL 1.1 Query Results JSON sec 3.2.2). Oxigraph happens to return stable
ids; Fuseki numbers them per response (b0, b1, ...), so two different nodes can
carry the same label in successive queries. On an engine like that this
library stores blank nodes as skolem IRIs, turns them back into BNodes on the
way out, and rewrites isBLANK / isIRI / ORDER BY so they still behave as for
real blank nodes (graph/backends/skolem_semantics.py).

These tests run against an in-process Oxigraph always, and against the Oxigraph
and Fuseki servers when they are running. They are the focused regression for
what the W3C store matrix found (lists losing elements, merged annotations).""" ;
        rdfs:label "test_blank_node_identity" ;
        ns2:declares ns35:test_two_lists_sharing_a_value_are_read_back_correctly, ns35:_ttl, ns35:_up, ns35:test_two_reifiers_of_one_triple_keep_their_own_annotations, ns35:test_order_by_puts_blank_nodes_before_iris_before_literals, ns35:test_isblank_and_isiri_see_blank_nodes_as_blank, ns35:test_a_blank_node_with_no_such_triple_returns_nothing, ns35:new_graph ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_blank_node_identity.py" ;
        ns2:importsModule ns4:rdflib.plugins.stores.sparqlstore, ns4:__future__, ns4:requests, ns4:rdflib.graph, ns4:pytest, ns4:rdflib .

