    ns105:test_cache_does_not_serve_stale_data_after_mutation dcterms:identifier "tests.graph.unit.test_query_prepare_cache.test_cache_does_not_serve_stale_data_after_mutation" ;
        a ns2:Function ;
        rdfs:comment """The cache is keyed on query text/namespaces/base, not graph content -
confirms new triples added between two identical-query calls are still
visible (the parsed query is reused, but it's evaluated fresh against
current data each time, not memoized results).""" ;
        rdfs:label "test_cache_does_not_serve_stale_data_after_mutation" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_query_prepare_cache.py" ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 126 ;
