    ns356:test_mc_negative.py dcterms:identifier "tests.starontology.manchester_conformance.test_mc_negative" ;
        a ns2:Module ;
        rdfs:comment """Negative corpus (N in the plan's P/T/R/O/V/N): malformed input must raise ``ManchesterSyntaxError``,
never mis-parse silently.

The most dangerous failure for a parser is not rejecting good input but quietly accepting bad input and
dropping or reinterpreting part of the document. The ``truncation`` group targets exactly that.""" ;
        rdfs:label "test_mc_negative" ;
        ns2:declares ns364:test_lenient_where_owlapi_is_lenient, ns364:test_malformed_input_raises ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/test_mc_negative.py" ;
