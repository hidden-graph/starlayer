        ns2:declares ns82:TestJsonld12IsRejectedAsUnrecognized.test_dataset_parse_rejects, ns82:TestJsonld12IsRejectedAsUnrecognized.test_graph_serialize_rejects, ns82:TestJsonld12IsRejectedAsUnrecognized.test_dataset_serialize_rejects, ns82:TestJsonld12IsRejectedAsUnrecognized.test_graph_parse_rejects ;
