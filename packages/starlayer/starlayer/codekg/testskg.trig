        a ns2:Class ;
        rdfs:comment """A second, broader unbound-variable check than
TestUnboundProjectedVariable above (added 2026-10-15): that one only
ever inspects sqe:projection's own members (SELECT-specific) - a
variable referenced only inside a FILTER/BIND expression, that is
never itself projected, was never checked at all, for any query form.
This generalizes to "every variable used inside any expression must
be bound somewhere in scope," reused identically across
SelectQueryShape/AskQueryShape/ConstructQueryShape.""" ;
        rdfs:label "TestUnboundExpressionVariable" ;
        ns2:declares ns327:TestUnboundExpressionVariable.test_select_filter_unbound_variable_fails, ns327:TestUnboundExpressionVariable.test_bind_then_filter_on_bound_variable_conforms, ns327:TestUnboundExpressionVariable.test_select_filter_all_bound_conforms, ns327:TestUnboundExpressionVariable.test_ask_filter_unbound_variable_fails, ns327:TestUnboundExpressionVariable.test_ask_filter_all_bound_conforms, ns327:TestUnboundExpressionVariable.test_construct_filter_unbound_variable_fails ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_sqe_ontology.py" ;
        ns2:lineEnd 436 ;
        ns2:lineStart 380 .

