    ns214:test_recursion_through_the_logical_constraints_finds_the_violation.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('shape', ['sh:or ( [ sh:property [ sh:path ex:friend ; sh:node ex:P ] ] [ sh:property [ sh:path ex:name ; sh:minCount 99 ] ] ) ; sh:property [ sh:path ex:name ; sh:minCount 1 ]', 'sh:and ( [ sh:property [ sh:path ex:friend ; sh:node ex:P ] ] ) ; sh:property [ sh:path ex:name ; sh:minCount 1 ]', 'sh:xone ( [ sh:property [ sh:path ex:friend ; sh:node ex:P ] ] [ sh:property [ sh:path ex:name ; sh:minCount 99 ] ] ) ; sh:property [ sh:path ex:name ; sh:minCount 1 ]', 'sh:property [ sh:path ex:name ; sh:minCount 1 ] , [ sh:path ex:friend ; sh:not [ sh:not [ sh:node ex:P ] ] ]'], ids=['or', 'and', 'xone', 'not'])" ;
        ns2:position 0 .

