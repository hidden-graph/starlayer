GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_sparql12_update.py> {
    ns45:test_sparql12_update.py dcterms:identifier "tests.graph.unit.test_sparql12_update" ;
        a ns2:Module ;
        rdfs:comment """Integration tests for StarLayerGraph.update() with SPARQL 1.2 triple-term syntax.

Covers:
  U1 — DELETE WHERE with triple term in WHERE clause
  U2 — INSERT WHERE with triple term in WHERE clause
  U3 — INSERT DATA with ground triple term
  U4 — DELETE DATA with ground triple term
  U5 — Combined DELETE/INSERT WHERE with triple term""" ;
        rdfs:label "test_sparql12_update" ;
        ns2:declares ns126:TestU5, ns126:TestU1, ns126:g, ns126:TestU2, ns126:TestU4, ns126:TestU6, ns126:TestU3, ns126:TestU7 ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_sparql12_update.py" ;
        ns2:importsModule ns4:rdflib, ns4:pytest .

    ns126:TestU1 dcterms:identifier "tests.graph.unit.test_sparql12_update.TestU1" ;
