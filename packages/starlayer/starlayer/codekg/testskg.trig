    ns327:TestUnboundProjectedVariable.test_filter_alone_does_not_count_as_binding dcterms:identifier "tests.sparql.unit.test_sqe_ontology.TestUnboundProjectedVariable.test_filter_alone_does_not_count_as_binding" ;
        a ns2:Method ;
        rdfs:comment """FILTER only ever constrains an already-bound variable - it can
never bind a new one, so a variable appearing only inside a
FILTER's own expression still fails, the same as not appearing at
all.""" ;
        rdfs:label "test_filter_alone_does_not_count_as_binding" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_sqe_ontology.py" ;
        ns2:lineEnd 274 ;
        ns2:lineStart 264 ;
        ns2:signature "def test_filter_alone_does_not_count_as_binding(self)" .

