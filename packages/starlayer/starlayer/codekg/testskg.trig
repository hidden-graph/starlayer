    ns249:TestAutomaticConformsToDerivation dcterms:identifier "tests.shacl.integration.test_used_graphs_and_configuration.TestAutomaticConformsToDerivation" ;
        a ns2:Class ;
        rdfs:comment """validate() automatically derives and merges SHACL 1.2 Profiling
S5.5's sh:conformsTo triple into report_graph (2026-10-09), whenever
both data_graph_iri=/shapes_graph_resource= resolve to real values - no
separate derive_conforms_to() call needed. Fires on either the IRIs
being given explicitly, or via the .identifier fallback/shapes_graph_resource=
naming a real module (2026-10-10, see TestValidateShapesGraph in
test_extract_shapes_graph.py for the full module-vs-tag design) - the
merge itself doesn't care which path produced them.""" ;
        rdfs:label "TestAutomaticConformsToDerivation" ;
        ns2:declares ns249:TestAutomaticConformsToDerivation.test_bare_validate_function_also_derives_automatically, ns249:TestAutomaticConformsToDerivation.test_both_iris_given_conforming_report_gets_conforms_to, ns249:TestAutomaticConformsToDerivation.test_non_conforming_report_gets_no_conforms_to, ns249:TestAutomaticConformsToDerivation.test_neither_iri_given_no_conforms_to, ns249:TestAutomaticConformsToDerivation.test_only_one_iri_given_no_conforms_to_attempted, ns249:TestAutomaticConformsToDerivation.test_fires_via_the_identifier_fallback_too ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_used_graphs_and_configuration.py" ;
