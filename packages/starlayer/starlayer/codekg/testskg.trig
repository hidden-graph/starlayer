    ns192:test_empty_sh_xone_list_now_caught dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions.test_empty_sh_xone_list_now_caught" ;
        a ns2:Function ;
        rdfs:comment """Unlike sh:in above, this is Violation severity, not Warning like the
official draft's own shsh:xoneSubjectsShape - pySHACL's own shape
loader unconditionally rejects an empty sh:and/sh:or/sh:xone list with
a raw ShapeLoadError the moment real validation runs, regardless of
allow_warnings, so a Warning severity here would advertise a working
opt-out that doesn't actually exist. See test_allow_warnings_below for
the confirmation that allow_warnings genuinely works for sh:in but not
sh:xone.""" ;
        rdfs:label "test_empty_sh_xone_list_now_caught" ;
        ns2:calls ns192:_validate ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py" ;
        ns2:hasReturnValue ns192:test_empty_sh_xone_list_now_caught.returns ;
        ns2:lineEnd 424 ;
        ns2:lineStart 407 ;
        ns2:signature "def test_empty_sh_xone_list_now_caught() -> None" .

    ns192:test_empty_sh_xone_list_now_caught.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns192:test_empty_sh_xone_list_still_rejected_by_meta_shacl_even_with_allow_warnings dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions.test_empty_sh_xone_list_still_rejected_by_meta_shacl_even_with_allow_warnings" ;
        a ns2:Function ;
        rdfs:comment """Confirms the severity choice above is honest, and specifically that
it's OUR meta-shacl preflight (not pySHACL's own independent
ShapeLoadError, which fires regardless of severity and would make this
test pass for the wrong reason) that's still rejecting it:
allow_warnings=True does NOT let an empty sh:xone list through - it's
Violation severity (never suppressible) here, not Warning like sh:in
(see test_allow_warnings_on_validate_relaxes_warning_severity_meta_shacl_check,
where allow_warnings genuinely does let sh:in () through). Asserting
"metashacl" in the message - not just any Exception - is essential:
without the severity fix, this same call still raises (pySHACL's own
loader crashes independently), but with a plain ShapeLoadError that
never mentions "metashacl" at all - confirmed by temporarily reverting
the severity to sh:Warning and re-running this exact assertion, which
then fails as expected.""" ;
        rdfs:label "test_empty_sh_xone_list_still_rejected_by_meta_shacl_even_with_allow_warnings" ;
        ns2:calls ns192:_validate ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py" ;
        ns2:hasReturnValue ns192:test_empty_sh_xone_list_still_rejected_by_meta_shacl_even_with_allow_warnings.returns ;
        ns2:lineEnd 452 ;
        ns2:lineStart 427 ;
        ns2:signature "def test_empty_sh_xone_list_still_rejected_by_meta_shacl_even_with_allow_warnings() -> None" .

    ns192:test_empty_sh_xone_list_still_rejected_by_meta_shacl_even_with_allow_warnings.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

