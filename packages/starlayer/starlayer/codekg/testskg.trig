    ns327:TestTemplateListShape dcterms:identifier "tests.sparql.unit.test_sqe_ontology.TestTemplateListShape" ;
        a ns2:Class ;
        rdfs:comment """sqe:ConstructQuery's sqe:template had zero structural shape at all
(added 2026-10-15) - bare sh:minCount/sh:maxCount 1, no sh:node - so
the whole template could be replaced with a bare string literal and
still conform. sqe:TemplateListShape closes this the same way
WhereListShape already does for sqe:where, just restricted to
sqe:TriplePattern only (CONSTRUCT's own template can never contain
OPTIONAL/UNION/FILTER/BIND).""" ;
        rdfs:label "TestTemplateListShape" ;
        ns2:declares ns327:TestTemplateListShape.test_template_corrupted_to_bare_literal_fails, ns327:TestTemplateListShape.test_valid_construct_conforms ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_sqe_ontology.py" ;
        ns2:lineEnd 304 ;
        ns2:lineStart 277 .

