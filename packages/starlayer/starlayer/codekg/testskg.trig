GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_bind_scoping.py> {
    ns45:test_bind_scoping.py dcterms:identifier "tests.graph.unit.test_bind_scoping" ;
        a ns2:Module ;
        rdfs:comment """A BIND sees only the group it is written in (SPARQL 1.1 section 18.2.2.6).

Groups are evaluated on their own and then joined, so a variable bound in a
sibling group is not visible to a BIND (GitHub issue #54). starlayer used to
reorder lazy joins so such a BIND saw it; plain rdflib, and every other
engine, does not.""" ;
        rdfs:label "test_bind_scoping" ;
        ns2:declares ns47:test_bind_still_sees_variables_bound_earlier_in_its_own_group, ns47:test_bind_does_not_see_a_variable_bound_in_a_sibling_group, ns47:_rows, ns47:test_filter_over_a_bind_that_could_not_see_its_input_removes_the_row ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_bind_scoping.py" ;
        ns2:importsModule ns4:rdflib, ns4:pytest .

    ns47:_rows dcterms:identifier "tests.graph.unit.test_bind_scoping._rows" ;
        a ns2:Function ;
        rdfs:label "_rows" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_bind_scoping.py" ;
        ns2:hasParameter ns47:_rows.param.query ;
        ns2:hasReturnValue ns47:_rows.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 18 ;
        ns2:lineStart 14 ;
        ns2:signature "def _rows(query: str) -> list[dict[str, str]]" .

    ns47:_rows.param.query a ns2:Parameter ;
        rdfs:label "query" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns47:_rows.returns a ns2:ReturnValue ;
        ns2:annotationText "list[dict[str, str]]" ;
        ns2:hasType ns4:builtins.str, ns4:builtins.list, ns4:builtins.dict .

    ns47:test_bind_does_not_see_a_variable_bound_in_a_sibling_group dcterms:identifier "tests.graph.unit.test_bind_scoping.test_bind_does_not_see_a_variable_bound_in_a_sibling_group" ;
        a ns2:Function ;
        rdfs:label "test_bind_does_not_see_a_variable_bound_in_a_sibling_group" ;
        ns2:calls ns47:_rows ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_bind_scoping.py" ;
        ns2:hasDecorator ns47:test_bind_does_not_see_a_variable_bound_in_a_sibling_group.decorator.0 ;
        ns2:hasParameter ns47:test_bind_does_not_see_a_variable_bound_in_a_sibling_group.param.query ;
        ns2:lineEnd 30 ;
        ns2:lineStart 29 ;
        ns2:signature "def test_bind_does_not_see_a_variable_bound_in_a_sibling_group(query)" .

    ns47:test_bind_does_not_see_a_variable_bound_in_a_sibling_group.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('query', ['SELECT * WHERE { VALUES ?x {1 2} { BIND(?x+1 AS ?y) } }', 'SELECT * WHERE { BIND(?x+1 AS ?y) { VALUES ?x {1 2} } }', 'SELECT * WHERE { { VALUES ?x {1 2} } { BIND(?x+1 AS ?y) } }'])" ;
        ns2:position 0 .

    ns47:test_bind_does_not_see_a_variable_bound_in_a_sibling_group.param.query a ns2:Parameter ;
        rdfs:label "query" ;
        ns2:parameterKind "positional" ;
