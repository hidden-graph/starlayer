        ns2:hasReturnValue ns195:_graph.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 29 ;
        ns2:lineStart 28 ;
        ns2:signature "def _graph() -> StarLayerGraph" .

    ns195:_graph.returns a ns2:ReturnValue ;
