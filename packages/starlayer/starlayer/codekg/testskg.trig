    ns105:test_starlayer_graph_over_sparql_update_store_falls_back_to_string dcterms:identifier "tests.graph.unit.test_query_prepare_cache.test_starlayer_graph_over_sparql_update_store_falls_back_to_string" ;
        a ns2:Function ;
        rdfs:comment """A StarLayerGraph backed directly by a SPARQLUpdateStore (the rdf-1.1
encoding path, not the native rdf-1.2 backend, which bypasses this code
entirely) must never hand this store's own query() method a prepared
Query object - it can't safely accept one (confirmed via real Fuseki
testing). prepare_query_cached (the cross-call cache) is skipped
entirely for this store type. A local, uncached prepareQuery() call
still happens once per query() call, though - starlayer.graph/query/
remote_decompose.py needs a real algebra tree to find and strip any
Extend that depends on a custom SPARQL function starlayer.graph registers
only in this process (TRIPLE()/SUBJECT()/etc. - see that module's
docstring) - but its output is always translated back to a plain string
before reaching the store.""" ;
        rdfs:label "test_starlayer_graph_over_sparql_update_store_falls_back_to_string" ;
        ns2:declares ns105:test_starlayer_graph_over_sparql_update_store_falls_back_to_string.fake_graph_query ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_query_prepare_cache.py" ;
        ns2:hasParameter ns105:test_starlayer_graph_over_sparql_update_store_falls_back_to_string.param.monkeypatch, ns105:test_starlayer_graph_over_sparql_update_store_falls_back_to_string.param.counting_prepare_query ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 258 ;
        ns2:lineStart 218 ;
        ns2:signature "def test_starlayer_graph_over_sparql_update_store_falls_back_to_string(monkeypatch, counting_prepare_query)" .

