        ns2:signature "def test_hand_authored_returns_are_still_genuinely_unannotated() -> None" .

    ns112:test_hand_authored_returns_are_still_genuinely_unannotated.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns112:test_property_deprecation_warnings_still_fire_as_recorded dcterms:identifier "tests.graph.unit.test_rdflib_inherited_contract.test_property_deprecation_warnings_still_fire_as_recorded" ;
        a ns2:Function ;
        rdfs:comment """Entries recording a ``deprecated`` message exist because accessing
that property genuinely emits a ``DeprecationWarning`` today (confirmed
live, not assumed) - if rdflib ever actually removes the deprecated
property instead of just warning about it, this catches that too (the
attribute access itself would raise instead of warn).""" ;
        rdfs:label "test_property_deprecation_warnings_still_fire_as_recorded" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_rdflib_inherited_contract.py" ;
        ns2:hasReturnValue ns112:test_property_deprecation_warnings_still_fire_as_recorded.returns ;
        ns2:lineEnd 98 ;
        ns2:lineStart 82 ;
        ns2:signature "def test_property_deprecation_warnings_still_fire_as_recorded() -> None" .

    ns112:test_property_deprecation_warnings_still_fire_as_recorded.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns4:inspect a ns2:ExternalModule .

    ns4:warnings a ns2:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_remote_decompose.py> {
    ns45:test_remote_decompose.py dcterms:identifier "tests.graph.unit.test_remote_decompose" ;
        a ns2:Module ;
        rdfs:comment """Unit tests for starlayer.graph.query.remote_decompose - the mechanism that lets
a query depending on starlayer.graph's own custom SPARQL functions (TT_HASH_FN,
the SUBJECT/PREDICATE/OBJECT accessors, STRLANGDIR) still run against a
genuinely remote store, by stripping every algebra node that depends on one
of those functions and re-evaluating it locally against each result row.

Regression coverage for a real bug found via live Fuseki testing while
scoping the removal of starlayer.graph's old text-based SPARQL 1.2 rewriter: the
new starlayer.sparql-based pipeline can lower a non-ground triple-term
pattern's predicate constraint into a bare
``FILTER(PREDICATE(?tt) = :knows)`` - a custom-function call directly
inside a Filter's own expression, not wrapped in an Extend/BIND the way
every case this module was originally built against used. Sent to a real
remote engine as-is, that FILTER raises on the unknown function and SPARQL's
own FILTER semantics exclude the row - silently, no exception, every row
gone. decompose_for_remote() must strip that Filter too, not just Extend
nodes, and re-check its condition locally per row after the round trip.""" ;
        rdfs:label "test_remote_decompose" ;
        ns2:declares ns113:test_row_passes_filters_empty_list_is_always_true, ns113:test_ground_pattern_needs_no_filter_stripping, ns113:test_non_ground_triple_term_pattern_strips_filter_not_just_extend, ns113:_prepare, ns113:test_stripped_filter_recipe_correctly_excludes_non_matching_rows ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        ns2:importsModule ns4:rdflib, ns4:__future__ .

    ns113:_prepare dcterms:identifier "tests.graph.unit.test_remote_decompose._prepare" ;
        a ns2:Function ;
