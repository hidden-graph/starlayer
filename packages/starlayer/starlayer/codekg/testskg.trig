        ns2:lineEnd 79 ;
        ns2:lineStart 71 ;
        ns2:signature "def test_every_property_contract_entry_still_exists_and_is_a_property() -> None" .

    ns112:test_every_property_contract_entry_still_exists_and_is_a_property.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns112:test_hand_authored_returns_are_still_genuinely_unannotated dcterms:identifier "tests.graph.unit.test_rdflib_inherited_contract.test_hand_authored_returns_are_still_genuinely_unannotated" ;
        a ns2:Function ;
        rdfs:comment """Entries flagged ``hand_authored_returns=True`` exist because rdflib's
own source had no return annotation to introspect at the time this file
was written. If rdflib later adds one, the hand-authored value in this
file becomes redundant (and could quietly drift from the real one) -
this test catches that so the entry can be switched back to
introspection instead of staying hand-maintained forever.""" ;
        rdfs:label "test_hand_authored_returns_are_still_genuinely_unannotated" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_rdflib_inherited_contract.py" ;
