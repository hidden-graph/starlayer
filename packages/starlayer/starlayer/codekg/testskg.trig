    ns192:TestConditionWellFormedness.test_untyped_condition_passes_meta_validate_standalone dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions.TestConditionWellFormedness.test_untyped_condition_passes_meta_validate_standalone" ;
        a ns2:Method ;
        rdfs:comment """meta_validate() called standalone (not through the full
validate() pipeline) doesn't see the auto-typing injection that
starlayer.shacl.validator.StarShaclSchema._ensure_native_component_shapes_typed()
applies before meta-validation runs as part of a real validate()/
apply_rules() call - so, exactly like sh:someValue/sh:memberShape/
sh:reifierShape already do, an untyped reference here still
vacuously conforms in isolation. That's fine: the real guarantee
(an untyped sh:condition value works correctly, auto-typed
transparently) is tested end-to-end via the full pipeline in
tests/integration/test_rule_condition.py, not via this function in
isolation - see that file's test_condition_shape_does_not_need_explicit_typing.""" ;
        rdfs:label "test_untyped_condition_passes_meta_validate_standalone" ;
        ns2:calls ns122:meta_validate ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py" ;
        ns2:hasReturnValue ns192:TestConditionWellFormedness.test_untyped_condition_passes_meta_validate_standalone.returns ;
        ns2:lineEnd 1017 ;
        ns2:lineStart 992 ;
        ns2:signature "def test_untyped_condition_passes_meta_validate_standalone(self) -> None" .

