    ns45:test_manchester_hunt3.py dcterms:identifier "tests.graph.unit.test_manchester_hunt3" ;
        a ns2:Module ;
        rdfs:comment """Regression tests for the Manchester syntax findings of GitHub issue #101 (third hunt).

The oracle is the OWL 2 Manchester syntax note's grammar (https://www.w3.org/TR/owl2-manchester-syntax/):
one ontology per document, ``languageTag`` non-empty, ``description2List`` with two or more members,
``literal`` without a boolean form, and the round trip parse -> serialize -> parse being stable.""" ;
        rdfs:label "test_manchester_hunt3" ;
        ns2:declares ns90:test_good_language_tag_still_parses, ns90:test_data_restrictions_round_trip, ns90:test_ordinary_float_is_unchanged, ns90:test_true_stays_a_boolean_for_a_declared_data_property, ns90:test_overflowing_float_is_INF, ns90:test_single_member_misc_axiom_is_a_syntax_error, ns90:test_bad_language_tag_is_a_syntax_error, ns90:test_true_in_a_value_restriction_on_an_object_property_is_a_name, ns90:test_empty_graph_is_not_a_bare_stopiteration, ns90:test_literal_one_of_filler_is_rendered_as_literals, ns90:test_true_is_a_name_when_the_property_is_undeclared, ns90:test_true_is_an_individual_name_for_an_object_property, ns90:test_deeply_nested_expression_is_a_syntax_error, ns90:_round_trip, ns90:test_second_ontology_header_is_a_syntax_error ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_manchester_hunt3.py" ;
        ns2:importsModule ns4:rdflib, ns4:pytest, ns4:rdflib.namespace .

