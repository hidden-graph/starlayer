    ns87:test_tree_to_owl_matches_compiling_the_text_directly dcterms:identifier "tests.graph.unit.test_manchester_ast.test_tree_to_owl_matches_compiling_the_text_directly" ;
        a ns2:Function ;
        rdfs:label "test_tree_to_owl_matches_compiling_the_text_directly" ;
        ns2:calls ns72:parse_manchester, ns88:manchester_tree_to_owl, ns49:isomorphic, ns88:manchester_parse_to_tree ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast.py" ;
        ns2:hasDecorator ns87:test_tree_to_owl_matches_compiling_the_text_directly.decorator.0 ;
        ns2:hasParameter ns87:test_tree_to_owl_matches_compiling_the_text_directly.param.text ;
        ns2:lineEnd 170 ;
        ns2:lineStart 168 ;
