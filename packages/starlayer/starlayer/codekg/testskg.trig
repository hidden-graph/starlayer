    ns174:test_owl_imports_to_a_module_present_but_not_typed_shapesgraph_raises dcterms:identifier "tests.shacl.integration.test_extract_shapes_graph.test_owl_imports_to_a_module_present_but_not_typed_shapesgraph_raises" ;
