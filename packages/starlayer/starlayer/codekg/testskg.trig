    ns215:test_reification_required_alternate_boolean_lexical_form_leaves_constraint_inactive dcterms:identifier "tests.shacl.integration.test_reification_constraints.test_reification_required_alternate_boolean_lexical_form_leaves_constraint_inactive" ;
        a ns2:Function ;
        rdfs:comment """Found 2026-07-31 via the W3C SHACL 1.2 test suite's uniqueLang-002
fixture (same underlying bug, different predicate) - see
tests/integration/test_single_line_and_some_value.py's identical test
for sh:singleLine for the full reasoning. bool(value.value) accepts
"1"^^xsd:boolean as true (XSD value-space conversion); the spec only
ever mentions "true" for this family of on/off boolean parameters, so
"1"^^xsd:boolean must leave the constraint inactive - here, a focus node
with no reifier at all must still conform. Needs format="turtle12"
specifically - see the sh:singleLine test's docstring for why plain
"turtle" parsing can't exercise this at all (rdflib's own Literal()
constructor already normalizes "1" to "true" before starlayer.shacl
ever sees it).""" ;
        rdfs:label "test_reification_required_alternate_boolean_lexical_form_leaves_constraint_inactive" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_reification_constraints.py" ;
        ns2:hasReturnValue ns215:test_reification_required_alternate_boolean_lexical_form_leaves_constraint_inactive.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 155 ;
        ns2:lineStart 119 ;
        ns2:signature "def test_reification_required_alternate_boolean_lexical_form_leaves_constraint_inactive() -> None" .

    ns215:test_reification_required_alternate_boolean_lexical_form_leaves_constraint_inactive.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns215:test_reification_required_string_literal_false_is_rejected_not_silently_enabled dcterms:identifier "tests.shacl.integration.test_reification_constraints.test_reification_required_string_literal_false_is_rejected_not_silently_enabled" ;
        a ns2:Function ;
        rdfs:comment """Found 2026-07-20 via the same audit that caught the analogous
sh:closed "false" bug (see tests/integration/test_closed_by_types.py):
ReifierShapeConstraintComponent.__init__ used bare bool(value) for
sh:reificationRequired instead of checking the literal's datatype -
bool("false") is True in Python regardless of the string's content, so
sh:reificationRequired "false" was silently *enabling* the check
instead of disabling it. Now raises a clean ValueError instead.""" ;
        rdfs:label "test_reification_required_string_literal_false_is_rejected_not_silently_enabled" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_reification_constraints.py" ;
        ns2:hasReturnValue ns215:test_reification_required_string_literal_false_is_rejected_not_silently_enabled.returns ;
        ns2:instantiates ns51:StarLayerGraph ;
        ns2:lineEnd 116 ;
        ns2:lineStart 87 ;
        ns2:signature "def test_reification_required_string_literal_false_is_rejected_not_silently_enabled() -> None" .

    ns215:test_reification_required_string_literal_false_is_rejected_not_silently_enabled.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

