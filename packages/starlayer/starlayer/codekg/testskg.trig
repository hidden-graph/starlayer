    ns132:TestCoerceObject dcterms:identifier "tests.graph.unit.test_syntax.TestCoerceObject" ;
        a ns2:Class ;
        rdfs:comment """Numeric literals come back as a correctly-typed, lexical-form-
preserving Literal, not a Python int/float - see coerce_object's own
docstring: a Python numeric type can't tell INTEGER/DECIMAL/DOUBLE
apart from the lexical shape alone (e.g. "123e0" is xsd:double despite
having no decimal point), and converting through one would also
silently canonicalize the lexical form (e.g. "04" -> "4").""" ;
        rdfs:label "TestCoerceObject" ;
        ns2:declares ns132:TestCoerceObject.test_leading_zero_lexical_form_preserved, ns132:TestCoerceObject.test_whitespace, ns132:TestCoerceObject.test_float, ns132:TestCoerceObject.test_integer_with_exponent_is_double, ns132:TestCoerceObject.test_true, ns132:TestCoerceObject.test_integer, ns132:TestCoerceObject.test_false, ns132:TestCoerceObject.test_string, ns132:TestCoerceObject.test_positive, ns132:TestCoerceObject.test_negative, ns132:TestCoerceObject.test_float_exp ;
