GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_shacl_shapes.py> {
    ns300:test_shacl_shapes.py dcterms:identifier "tests.sparql.unit.test_shacl_shapes" ;
        a ns2:Module ;
        rdfs:comment """SHACL shape tests for the Phase-1-core slice of the salg: vocabulary
(BGP/Filter/LeftJoin/Union + the SELECT wrapper) — see shapes.py.

Two directions get tested:

1. Every real Phase 1 query (imported from test_roundtrip.QUERIES, so this
   suite can't silently drift from what the encoder actually produces)
   encodes to a graph that *conforms*.
2. A handful of deliberately malformed graphs, built by mutating a valid
   encoded query, each *fail* validation for the specific structural reason
   the mutation introduces - not just "conforms is False somewhere".""" ;
        rdfs:label "test_shacl_shapes" ;
        ns2:declares ns325:test_modify_missing_both_delete_and_insert_fails, ns325:test_aggregate_distinct_missing_entirely_fails, ns325:test_describe_with_no_where_clause_conforms, ns325:test_expression_shape_relies_on_rdfs_reasoning_not_enumeration, ns325:test_order_condition_order_wrong_datatype_fails, ns325:test_clear_silent_wrong_datatype_fails, ns325:test_orderby_missing_expr_fails, ns325:_encode_simple_select, ns325:test_valid_phase1_queries_conform, ns325:test_insert_data_missing_triples_fails, ns325:test_nested_triple_term_in_subject_position_fails, ns325:test_arithmetic_op_every_real_operator_conforms, ns325:test_service_silent_wrong_datatype_fails, ns325:test_bgp_with_two_triples_lists_fails, ns325:test_clear_graphiri_neither_term_nor_pystr_fails, ns325:test_aggregate_distinct_wrong_type_fails, ns325:test_slice_missing_start_fails, ns325:test_shapes_graph_is_valid_shacl_and_reusable, ns325:test_relational_expression_op_wrong_datatype_fails, ns325:test_bogus_node_reused_as_p1_via_another_operator_still_fails, ns325:test_dataset_clause_well_formed_conforms, ns325:test_binding_val_missing_fails, ns325:test_expression_family_queries_conform, ns325:test_tomultiset_p_pointing_at_unrecognized_node_fails, ns325:test_construct_missing_template_fails, ns325:test_top_level_slice_distinct_reduced_orderby_conform, ns325:test_minus_missing_p2_fails, ns325:test_valid_updates_conform, ns325:test_binding_with_two_vars_fails, ns325:test_triple_term_missing_object_fails, ns325:test_leftjoin_missing_p2_fails, ns325:test_valid_values_and_subquery_queries_conform, ns325:test_triple_term_with_two_predicates_fails, ns325:test_triple_pattern_subject_as_plain_literal_fails, ns325:test_join_missing_p2_fails, ns325:test_mulpath_missing_mod_fails, ns325:test_service_missing_term_fails, ns325:test_values_missing_res_fails, ns325:test_bind_extend_conforms, ns325:test_triple_term_predicate_as_path_fails, ns325:test_ordinary_blank_node_subject_conforms, ns325:test_function_missing_iri_fails, ns325:test_service_conforms, ns325:test_triple_pattern_predicate_neither_iri_variable_nor_path_fails, ns325:test_dataset_clause_both_default_and_named_fails, ns325:test_valid_path_queries_conform, ns325:test_expression_shape_still_accepts_true_filter, ns325:test_quadsforgraph_graph_wrong_type_fails, ns325:test_filter_missing_expr_fails, ns325:test_union_p1_pointing_at_unrecognized_node_fails, ns325:test_add_graph_with_three_elements_fails, ns325:test_graph_term_wrong_nodekind_fails, ns325:test_one_arg_builtin_missing_arg_fails, ns325:test_valid_aggregate_queries_conform, ns325:test_triple_term_as_predicate_of_triple_pattern_fails, ns325:test_groupconcat_separator_wrong_nodekind_fails, ns325:test_bgp_missing_triples_fails, ns325:test_no_shape_recursion_warnings, ns325:_bgp_node, ns325:test_arithmetic_op_wrong_member_fails, ns325:test_graph_pattern_missing_p_fails, ns325:test_update_operations_list_with_bogus_member_fails, ns325:test_query_collection_of_valid_queries_conforms, ns325:test_dataset_clause_missing_both_default_and_named_fails, ns325:test_extend_missing_var_fails, ns325:test_valid_rdf12_queries_conform, ns325:test_arithmetic_op_illegal_value_fails, ns325:test_load_graphiri_pystr_keyword_fails, ns325:test_valid_forms_queries_conform, ns325:test_regex_missing_text_fails, ns325:test_aggregate_count_missing_vars_fails, ns325:test_mulpath_mod_invalid_value_fails, ns325:test_relational_op_every_real_operator_conforms, ns325:test_ask_missing_p_fails, ns325:test_service_term_wrong_nodekind_fails, ns325:test_query_collection_with_bogus_member_fails, ns325:test_relational_op_illegal_value_fails, ns325:test_project_pv_wrong_member_fails, ns325:test_expression_shape_rejects_untyped_blank_node ;
