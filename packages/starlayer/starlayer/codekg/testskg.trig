    ns196:test_closed_plain_boolean_parity_still_violates_on_unlisted_property dcterms:identifier "tests.shacl.integration.test_native_component_composition.test_closed_plain_boolean_parity_still_violates_on_unlisted_property" ;
        a ns2:Function ;
        rdfs:comment """Parity check for the non-extended case: plain boolean sh:closed
(not sh:ByTypes) must keep behaving exactly like pySHACL's own
ClosedConstraintComponent, since the new component fully replaces
pySHACL's dispatch entry for sh:closed/sh:ignoredProperties rather than
adding a second one alongside it. Confirmed byte-for-byte equivalent to
unregistered pySHACL's own behavior (including the well-known gotcha
that rdf:type itself gets closed off unless explicitly allowed).""" ;
        rdfs:label "test_closed_plain_boolean_parity_still_violates_on_unlisted_property" ;
        ns2:calls ns196:_validate, ns196:_violation_components ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_native_component_composition.py" ;
        ns2:hasReturnValue ns196:test_closed_plain_boolean_parity_still_violates_on_unlisted_property.returns ;
        ns2:lineEnd 1553 ;
        ns2:lineStart 1526 ;
        ns2:signature "def test_closed_plain_boolean_parity_still_violates_on_unlisted_property() -> None" .

    ns196:test_closed_plain_boolean_parity_still_violates_on_unlisted_property.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns196:test_cross_node_reachability_correct_through_a_cycle dcterms:identifier "tests.shacl.integration.test_native_component_composition.test_cross_node_reachability_correct_through_a_cycle" ;
        a ns2:Function ;
        rdfs:comment """Same cyclic shape graph as above, but C (reachable from the cycle)
genuinely declares a cross-node predicate - confirms the cycle guard
stops infinite recursion without also suppressing real reachability
through the cyclic part of the graph.""" ;
        rdfs:label "test_cross_node_reachability_correct_through_a_cycle" ;
        ns2:calls ns197:_cross_node_reachable_shapes ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_native_component_composition.py" ;
        ns2:hasReturnValue ns196:test_cross_node_reachability_correct_through_a_cycle.returns ;
        ns2:lineEnd 2057 ;
        ns2:lineStart 2035 ;
        ns2:signature "def test_cross_node_reachability_correct_through_a_cycle() -> None" .

    ns196:test_cross_node_reachability_correct_through_a_cycle.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns196:test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed dcterms:identifier "tests.shacl.integration.test_native_component_composition.test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed" ;
        a ns2:Function ;
        rdfs:comment """The bug the test above was written to catch turned out to only
manifest under specific ``PYTHONHASHSEED`` values (a DFS+memo
implementation memoized a node's answer using its cycle guard's early
``False`` return, which is unsound and order-dependent - fixed by
replacing it with fixed-point/worklist propagation, which is order-
independent by construction). A single in-process run can't exercise
more than one hash seed, so this drives the same check across several
fixed seeds in subprocesses - the actual regression-catching test for
this bug, not just the single-seed case above.""" ;
        rdfs:label "test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_native_component_composition.py" ;
        ns2:hasReturnValue ns196:test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed.returns ;
        ns2:lineEnd 2099 ;
        ns2:lineStart 2060 ;
        ns2:signature "def test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed() -> None" .

    ns196:test_cross_node_reachability_correct_through_a_cycle_regardless_of_hash_seed.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

