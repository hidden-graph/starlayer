        a ns2:Function ;
        rdfs:comment """The head ?v :p ?v can only produce triples whose subject equals its
object, so a stricter reading than the spec's procedure would find no
dependency on the body :a :p :b. This implementation checks each position
on its own and reports one: a coarser plan, never a wrong result.""" ;
        rdfs:label "test_a_repeated_variable_does_not_narrow_the_match" ;
        ns2:calls ns341:_two_rules, ns341:_labels ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_srl_stratification_extended.py" ;
        ns2:lineEnd 207 ;
        ns2:lineStart 201 ;
        ns2:signature "def test_a_repeated_variable_does_not_narrow_the_match()" .

