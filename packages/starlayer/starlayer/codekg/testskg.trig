GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_extract_shapes_graph.py> {
    ns163:test_extract_shapes_graph.py dcterms:identifier "tests.shacl.integration.test_extract_shapes_graph" ;
        a ns2:Module ;
        rdfs:comment """Coverage for StarShaclSchema.extract_shapes_graph() - pulls one named
sh:ShapesGraph "module" back out of a larger shacl_graph that bundles
several modules together (the inverse of SHACL 1.2 Profiling S2's own
packaging convention). Built on StarLayerGraph.cbd() - see that method's
own docstring for the Concise Bounded Description algorithm this relies
on (follows blank-node objects recursively, never named-IRI ones).""" ;
        rdfs:label "test_extract_shapes_graph" ;
        ns2:declares ns174:test_named_nested_property_shape_is_left_dangling_by_design, ns174:test_raises_without_a_bound_shacl_graph, ns174:test_owl_imports_to_a_module_absent_entirely_raises, ns174:test_returns_none_for_an_iri_not_typed_sh_shapesgraph, ns174:test_returns_none_for_an_unknown_iri, ns174:test_extracted_module_includes_the_shapesgraph_and_member_triples, ns174:test_caller_can_inject_a_replacement_for_a_dangling_named_shape_reference, ns174:_two_module_graph, ns174:test_rdfs_isdefinedby_inverse_direction_is_honored, ns174:test_owl_imports_cycle_does_not_hang, ns174:_adult_shapes_graph, ns174:test_extracts_only_the_named_modules_own_shape, ns174:TestShapesGraphOnOtherMethods, ns174:TestValidateShapesGraph, ns174:test_owl_imports_to_a_module_present_but_not_typed_shapesgraph_raises, ns174:test_nested_blank_node_property_shape_is_included, ns174:test_does_not_mutate_the_original_shacl_graph, ns174:test_owl_imports_transitively_pulls_in_another_locally_present_modules_members, ns174:test_extracted_module_validates_independently ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_extract_shapes_graph.py" ;
        ns2:importsModule ns4:pytest, ns4:rdflib .

    ns174:TestShapesGraphOnOtherMethods dcterms:identifier "tests.shacl.integration.test_extract_shapes_graph.TestShapesGraphOnOtherMethods" ;
        a ns2:Class ;
        rdfs:comment """shapes_graph_resource= (renamed from shapes_graph_module= 2026-10-10)
extended consistently (2026-10-09) to every other StarShaclSchema
method that takes a shapes graph - a thin convenience over
_resolve_shacl_graph(), the same helper TestValidateShapesGraph above
exercises through validate(). Unlike validate()'s own dual-purpose
shapes_graph_resource=, these methods have no report to fall back to tagging -
a value that isn't really a module still raises here, via
_resolve_shacl_graph().""" ;
        rdfs:label "TestShapesGraphOnOtherMethods" ;
