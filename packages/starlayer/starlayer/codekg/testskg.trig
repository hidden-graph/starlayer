    ns174:test_named_nested_property_shape_is_left_dangling_by_design dcterms:identifier "tests.shacl.integration.test_extract_shapes_graph.test_named_nested_property_shape_is_left_dangling_by_design" ;
        a ns2:Function ;
        rdfs:comment """A member shape's own sh:property can point at a *named* property
shape (not a blank node) - extract_shapes_graph() deliberately does
NOT recurse into it (CBD alone won't follow a named-IRI object
either). SHACL 1.2 Profiling itself gives no completeness rule for
this (confirmed directly against the spec text - S2.7 "Calculating
Dependencies" is a literal TODO), so there's no closure to compute;
leaving the reference dangling is what lets a caller extract one
shape and then inject their own replacement for whatever it points
at, without a stale copy of the old definition silently riding
along and conflicting with the injected one.""" ;
        rdfs:label "test_named_nested_property_shape_is_left_dangling_by_design" ;
        ns2:calls ns174:_adult_shapes_graph ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_extract_shapes_graph.py" ;
        ns2:hasReturnValue ns174:test_named_nested_property_shape_is_left_dangling_by_design.returns ;
