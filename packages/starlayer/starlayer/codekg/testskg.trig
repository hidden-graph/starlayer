GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_wg_overrides.py> {
    ns163:test_wg_overrides.py dcterms:identifier "tests.shacl.integration.test_wg_overrides" ;
        a ns2:Module ;
        rdfs:comment """The meta-shapes graph is the W3C Working Group's SHACL-for-SHACL plus additions (scripts/build_meta_shapes.py).

These tests keep the additions honest as the Working Group's file evolves. Each addition exists because the pinned file
rejects a shapes graph SHACL 1.2 allows, so each test shows that the pinned file *still* rejects it. When a test here
fails after the pinned copy is updated, upstream has fixed the problem: drop the matching addition from
build_meta_shapes.py and rebuild. Run ``python scripts/check_wg_shacl_shacl.py`` to see whether upstream has moved.""" ;
        rdfs:label "test_wg_overrides" ;
        ns2:declares ns250:test_the_pinned_file_matches_its_provenance_record, ns250:test_the_working_group_file_still_rejects_it_and_the_assembled_graph_accepts_it, ns250:_conforms, ns250:test_the_working_group_file_accepts_sh_expression_on_a_node_shape_so_nothing_overrides_it, ns250:test_the_assembled_graph_still_rejects_what_it_should, ns250:test_the_working_group_still_has_the_rules_our_asset_does_not_repeat, ns250:wg_alone, ns250:test_every_predicate_the_working_group_file_constrains_is_constrained_by_the_assembled_graph, ns250:test_what_the_working_group_has_fixed_it_still_accepts, ns250:assembled, ns250:test_the_overrides_cover_every_relaxed_path, ns250:test_meta_validate_works_as_the_first_call_in_a_fresh_process ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_wg_overrides.py" ;
        ns2:importsModule ns4:rdflib, ns4:pyshacl, ns4:pytest, ns4:re, ns4:build_meta_shapes .

