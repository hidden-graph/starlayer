    ns34:test_oxigraph_store_rdf12.py dcterms:identifier "tests.graph.integration.test_oxigraph_store_rdf12" ;
        a ns2:Module ;
        rdfs:comment """tests/graph/integration/test_oxigraph_store_rdf12.py

StarLayerGraph/StarLayerDataset backed by oxrdflib's standard OxigraphStore
(an in-process pyoxigraph engine) in rdf-1.2 native mode - real triple terms
and SPARQL 1.2, no HTTP. See starlayer.graph.backends.native_oxigraph.

The store is chosen explicitly at construction (store=..., backend='rdf-1.2');
nothing here relies on, or sets, a global default. No live server needed, so
no pytest.mark.integration.

Requires: pip install oxrdflib pyoxigraph""" ;
        rdfs:label "test_oxigraph_store_rdf12" ;
        ns2:declares ns42:TestEmbeddedBoundBnodeQuery, ns42:TestDirLangStringEquality, ns42:embedded_oxigraph_store, ns42:TestQueryConstructIsCreatedLikeTheSource, ns42:_oxigraph_graph, ns42:TestEmbeddedLen, ns42:TestEmbeddedRoundTrip, ns42:TestEmptyLike, ns42:TestEmbeddedTurtle12Parse, ns42:TestEmbeddedCloseReopen, ns42:_is_oxigraph_backed, ns42:TestDirLangStringEqualityGuard, ns42:sg, ns42:TestBoundBlankNodeLookups, ns42:TestInferIsCreatedLikeTheSource, ns42:TestPlainTupleIsATripleTerm ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_store_rdf12.py" ;
        ns2:importsModule ns4:os, ns4:rdflib, ns4:pytest .

