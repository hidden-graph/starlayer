    ns59:TestDefaultGraphIsAStarLayerGraph dcterms:identifier "tests.graph.unit.test_dataset.TestDefaultGraphIsAStarLayerGraph" ;
        a ns2:Class ;
        rdfs:comment """rdflib's own Dataset.__init__ hardcodes self._default_context as a
plain rdflib.Graph (default_graph/default_context both just return it
directly) - a real, previously-undiscovered bug: ds.default_graph.add()
crashed on a real TripleTerm, since plain Graph.add() rejects it as
"not an rdflib term". Fixed in StarLayerDataset.__init__ by routing
_default_context through get_context() instead, same as every other
named context.""" ;
        rdfs:label "TestDefaultGraphIsAStarLayerGraph" ;
        ns2:declares ns59:TestDefaultGraphIsAStarLayerGraph.test_default_graph_is_a_starlayergraph, ns59:TestDefaultGraphIsAStarLayerGraph.test_default_graph_accepts_a_triple_term_without_crashing, ns59:TestDefaultGraphIsAStarLayerGraph.test_graphs_yields_the_default_graph_as_a_starlayergraph, ns59:TestDefaultGraphIsAStarLayerGraph.test_default_graph_stays_current_after_turtle12_reroute_parse, ns59:TestDefaultGraphIsAStarLayerGraph.test_default_context_is_a_starlayergraph ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_dataset.py" ;
        ns2:lineEnd 499 ;
        ns2:lineStart 442 .

    ns59:TestDefaultGraphIsAStarLayerGraph.test_default_context_is_a_starlayergraph dcterms:identifier "tests.graph.unit.test_dataset.TestDefaultGraphIsAStarLayerGraph.test_default_context_is_a_starlayergraph" ;
