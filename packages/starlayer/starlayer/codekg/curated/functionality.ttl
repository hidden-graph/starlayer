@prefix slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#> .
@prefix cur: <https://github.com/hidden-graph/starlayer/ns/codekg/curated/functionality#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The hand-curated list of what StarLayer does, as slkg:CapabilityArea /
# slkg:Capability instances (the vocabulary in ../ontology.ttl). It is the source
# of docs/generated/functionality-overview.generated.md.
#
# - slkg:position orders the areas, and the capabilities within an area.
# - slkg:hasStatus is "implemented" or "roadmap". A roadmap item stays in the
#   area it belongs to and may cite a document with slkg:seeAlsoPath.
# - slkg:implementedByIdentifier is a dotted Python path that exists as a
#   dcterms:identifier in ../codekg.trig. A capability implemented only by a SHACL
#   or OWL file has none. Packages are identified by their __init__ module
#   ("starlayer.sparql.__init__"), because the code KG has no package entity.
# - Where several entities could anchor a capability, prefer the public entry
#   point (a method over a module, a function over a thin method that delegates
#   to it) and never a whole module standing in for many per-format files.

### RDF graph

cur:area-rdf-graph a slkg:CapabilityArea ;
    rdfs:label "RDF graph" ;
    slkg:position 1 ;
    slkg:implementedByIdentifier "starlayer.graph.__init__" .

cur:cap-rdf-graph-1 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 1 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Manage RDF 1.2 graphs, including triple terms and direction-tagged literals." ;
    slkg:implementedByIdentifier "starlayer.graph.model.encoding" .

cur:cap-rdf-graph-2 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 2 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "In-memory graph management through rdflib using an RDF 1.1 transformation of RDF 1.2 graphs (the default backend)." ;
    slkg:implementedByIdentifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph" .

cur:cap-rdf-graph-3 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 3 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Parse and serialize various RDF formats including both 1.1 and 1.2 versions of Turtle, LongTurtle, N-Triples, N-Quads, TriG, RDF/XML, and TriX 1.2. Parse and serialize JSON-LD 1.1 (1.2 pending)." ;
    slkg:implementedByIdentifier 
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.parse",
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.serialize" .

cur:cap-rdf-graph-4 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 4 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Multi-graph datasets with named graphs." ;
    slkg:implementedByIdentifier "starlayer.graph.graph.starlayer_dataset.StarLayerDataset" .

cur:cap-rdf-graph-5 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 5 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Storage backends: the default in-memory rdflib store; Oxigraph in memory, on disk or as a server; Fuseki as a server; and SQLAlchemy-backed storage through a store plugin. Oxigraph and Fuseki use their own RDF 1.2 support when available." ;
    slkg:implementedByIdentifier "starlayer.graph.backends.native" .

cur:cap-rdf-graph-6 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 6 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "RDF-1.2-aware graph isomorphism and comparison." ;
    slkg:implementedByIdentifier 
        "starlayer.graph.compare.graph_diff",
        "starlayer.graph.compare.isomorphic" .

cur:cap-rdf-graph-7 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 7 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "RDFC-1.0 canonicalization and hashing of RDF 1.2 graphs." ;
    slkg:implementedByIdentifier 
        "starlayer.graph.rdfc.CanonicalizationComplexityError",
        "starlayer.graph.rdfc.rdfc10_hash",
        "starlayer.graph.rdfc.to_canonical_nquads" .

cur:cap-rdf-graph-8 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 8 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Resolve owl:imports using a loader you supply, so you decide how an imported document is fetched. There is no built-in fetching." ;
    slkg:implementedByIdentifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.resolve_imports" .

cur:cap-rdf-graph-9 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 9 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Concise bounded descriptions of a resource, and lookup of the triple terms that have at least one reifier." ;
    slkg:implementedByIdentifier 
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.cbd",
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.reifications" .

cur:cap-rdf-graph-13 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 10 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Triple terms are stored using the vocabulary of the RDF 1.2 Interoperability specification (each one a node typed rdf:PropositionForm), found by that type, and converted to and from the standard's blank-node form when writing or reading plain RDF formats." ;
    slkg:implementedByIdentifier "starlayer.graph.model.encoding" .

cur:cap-rdf-graph-10 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 10 ;
    slkg:hasStatus "roadmap" ;
    rdfs:comment "rdflib 8 compatibility (currently pinned to rdflib 7.x; revisit once a stable rdflib 8 ships)." .

cur:cap-rdf-graph-11 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-rdf-graph ;
    slkg:position 11 ;
    slkg:hasStatus "roadmap" ;
    rdfs:comment "Built-in fetching of owl:imports, and one import mechanism shared by graphs, SHACL and SRL." ;
    slkg:seeAlsoPath "packages/starlayer/docs/future_enhancements.md" .


### SPARQL

cur:area-sparql a slkg:CapabilityArea ;
    rdfs:label "SPARQL" ;
    slkg:position 2 ;
    slkg:implementedByIdentifier "starlayer.sparql.__init__" .

cur:cap-sparql-1 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-sparql ;
    slkg:position 1 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "SPARQL 1.2 queries over StarLayer graphs." ;
    slkg:implementedByIdentifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.query" .

cur:cap-sparql-2 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-sparql ;
    slkg:position 2 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "A StarLayer RDF vocabulary for representing SPARQL queries as graphs, for hand or UI editing (the sqe namespace). It covers SELECT, ASK and CONSTRUCT with every clause, aggregates, sub-selects, VALUES and the SPARQL 1.2 additions; DESCRIBE and Update are not covered." ;
    slkg:implementedByIdentifier "starlayer.sparql.sqe.__init__" .

cur:cap-sparql-3 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-sparql ;
    slkg:position 3 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "SHACL shapes for sqe graphs." .

cur:cap-sparql-4 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-sparql ;
    slkg:position 4 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Prepared queries: prepare a query once, with options such as entailment, and run it against any number of graphs." ;
    slkg:implementedByIdentifier "starlayer.sparql.star_query.StarQuery" .


### SRL (SPARQL Rules)

cur:area-srl a slkg:CapabilityArea ;
    rdfs:label "SRL (SPARQL Rules)" ;
    slkg:position 3 ;
    slkg:implementedByIdentifier "starlayer.sparql.srl" .

cur:cap-srl-1 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 1 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "A Datalog-style rules language from the W3C SPARQL 1.2 working draft (2026-10-14), general-purpose and independent of SHACL." ;
    slkg:implementedByIdentifier "starlayer.sparql.srl" .

cur:cap-srl-2 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 2 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Parse rule sets and represent them as RDF graphs that convert back to the same rule set (the srl namespace), with SHACL shapes that validate them." ;
    slkg:implementedByIdentifier "starlayer.sparql.srl.parse_ruleset" .

cur:cap-srl-3 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 3 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Rule sets are checked against those shapes as they are parsed, so a malformed rule set is rejected up front." ;
    slkg:implementedByIdentifier 
        "starlayer.sparql.srl.parse_ruleset",
        "starlayer.sparql.srl_semantic_checks" .

cur:cap-srl-4 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 4 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Rule bodies and heads can use RDF 1.2 triple terms, reified triples and annotations; bodies can use the / and ^ property paths." .

cur:cap-srl-5 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 5 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "IMPORTS of other rule sets, resolved through a loader you supply." ;
    slkg:implementedByIdentifier "starlayer.sparql.srl.resolve_imports" .

cur:cap-srl-6 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 6 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Stratified evaluation: infer new triples, query the result, and show the order in which rules run." ;
    slkg:implementedByIdentifier 
        "starlayer.sparql._srl_ast.RuleSet.infer",
        "starlayer.sparql._srl_ast.RuleSet.query",
        "starlayer.sparql._srl_ast.RuleSet.plan",
        "starlayer.sparql.srl_eval" .

cur:cap-srl-7 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 7 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Optional entailment and SHACL validation of the result." ;
    slkg:implementedByIdentifier "starlayer.sparql._srl_ast.RuleSet.infer" .

cur:cap-srl-8 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 8 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Verified against the specification's own worked example." .

cur:cap-srl-9 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-srl ;
    slkg:position 9 ;
    slkg:hasStatus "roadmap" ;
    rdfs:comment "Aggregation, and converting a rule set to SPARQL - waiting on the specification." ;
    slkg:seeAlsoPath "packages/starlayer/docs/future_enhancements.md" .


### Manchester Syntax

cur:area-manchester a slkg:CapabilityArea ;
    rdfs:label "Manchester Syntax" ;
    slkg:position 4 .

cur:cap-manchester-1 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-manchester ;
    slkg:position 1 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Manchester OWL syntax support for parse and serialize." ;
    slkg:implementedByIdentifier 
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.parse",
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.serialize" .

cur:cap-manchester-2 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-manchester ;
    slkg:position 2 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "A StarLayer RDF vocabulary for representing a Manchester document (the manch namespace)." ;
    slkg:implementedByIdentifier "starlayer.starontology.manchester" .

cur:cap-manchester-3 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-manchester ;
    slkg:position 3 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "SHACL shapes for manch graphs." .


### Reasoning

cur:area-reasoning a slkg:CapabilityArea ;
    rdfs:label "Reasoning" ;
    slkg:position 5 .

cur:cap-reasoning-1 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-reasoning ;
    slkg:position 1 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Support for reasoning and inference using various entailment regimes: RDF, RDFS, OWL-RL, and OWL-DL." ;
    slkg:implementedByIdentifier 
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer",
        "starlayer.sparql.entailment_rdf",
        "starlayer.sparql.entailment_rdfs" .

cur:cap-reasoning-2 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-reasoning ;
    slkg:position 2 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "OWL-DL support via two engines: HermiT (through owlready2, which needs Java) or a Rust engine." ;
    slkg:implementedByIdentifier 
        "starlayer.graph.graph.owl_dl",
        "starlayer.graph.graph.owl_dl_rustdl" .

cur:cap-reasoning-3 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-reasoning ;
    slkg:position 3 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Support for both graph reasoning and query-time reasoning." ;
    slkg:implementedByIdentifier 
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer",
        "starlayer.graph.graph.starlayer_graph.StarLayerGraph.query" .


### SHACL

cur:area-shacl a slkg:CapabilityArea ;
    rdfs:label "SHACL" ;
    slkg:position 6 ;
    slkg:implementedByIdentifier "starlayer.shacl.__init__" .

cur:cap-shacl-1 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 1 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Support for SHACL 1.2 over RDF 1.2 graphs." ;
    slkg:implementedByIdentifier 
        "starlayer.shacl.validator.StarShaclSchema",
        "starlayer.shacl.validator.StarShaclSchema.validate" .

cur:cap-shacl-2 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 2 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Support for additional SHACL 1.2 specifications: SPARQL Extensions, Node Expressions, Rules, User Interfaces, Profiling." ;
    slkg:implementedByIdentifier 
        "starlayer.shacl.shacl_profiling",
        "starlayer.shacl.validator.StarShaclSchema.apply_rules",
        "starlayer.shacl.validator.StarShaclSchema.evaluate" .

cur:cap-shacl-3 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 3 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "SHACL 1.2 meta-shapes for checking shapes graphs." .

cur:cap-shacl-4 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 4 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "SHACL-driven subgraph extraction." ;
    slkg:implementedByIdentifier 
        "starlayer.shacl.subgraph_extraction.extract_subgraph",
        "starlayer.shacl.validator.StarShaclSchema.close_shape",
        "starlayer.shacl.validator.StarShaclSchema.extract_shapes_graph" .

cur:cap-shacl-5 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 5 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Derive a SHACL shape from a graph's own data." ;
    slkg:implementedByIdentifier "starlayer.graph.graph.shape_derivation.derive_shape" .

cur:cap-shacl-6 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 6 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "SHACL 1.2 User Interfaces widget selection: choose a widget for each property of a shape using the specification's scoring and matcher rules." ;
    slkg:implementedByIdentifier 
        "starlayer.shacl.ui_widget_selection.select_widget",
        "starlayer.shacl.ui_widget_selection.select_widgets",
        "starlayer.shacl.validator.StarShaclSchema.select_widgets" .

cur:cap-shacl-7 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 7 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Validation reports record the data and shapes graphs used and derive sh:conformsTo, and dcterms:conformsTo when given a profiles graph." ;
    slkg:implementedByIdentifier 
        "starlayer.shacl.profiling.derive_conforms_to",
        "starlayer.shacl.validator.validate" .

cur:cap-shacl-8 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 8 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Named shapes graph modules: validate against one module, extract one, and resolve owl:imports using a loader you supply." ;
    slkg:implementedByIdentifier "starlayer.shacl.validator.StarShaclSchema.extract_shapes_graph" .

cur:cap-shacl-9 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 9 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "Entailment during validation: a shapes graph's sh:entailment declarations, or an inference option, run the same entailment regimes as graph reasoning." ;
    slkg:implementedByIdentifier "starlayer.shacl.entailment.apply_entailment" .

cur:cap-shacl-10 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 10 ;
    slkg:hasStatus "roadmap" ;
    rdfs:comment "SHACL 1.2 User Interfaces: property roles (shui:propertyRole) are accepted but not interpreted, and no default widget scoring catalog ships (the specification publishes none)." ;
    slkg:seeAlsoPath "packages/starlayer/docs/shacl/shacl12-gap-matrix.md" .

cur:cap-shacl-11 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 11 ;
    slkg:hasStatus "roadmap" ;
    rdfs:comment "SHACL Compact syntax support, plus an ontology and shapes over that syntax (mirroring the Manchester and SPARQL syntax-as-RDF pattern) to drive validation and an editor." ;
    slkg:seeAlsoPath "packages/starlayer/docs/shacl/shacl12-gap-matrix.md" .

cur:cap-shacl-12 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-shacl ;
    slkg:position 12 ;
    slkg:hasStatus "roadmap" ;
    rdfs:comment "SHACL UI shapes for the SHACL validation shapes, so a form can edit a shapes graph, starting from the archived presentation shapes." ;
    slkg:seeAlsoPath "packages/starlayer/docs/future_enhancements.md" .


### Other

cur:area-other a slkg:CapabilityArea ;
    rdfs:label "Other" ;
    slkg:position 7 .

cur:cap-other-1 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-other ;
    slkg:position 1 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "VERSION-directive conformance warnings." ;
    slkg:implementedByIdentifier "starlayer.graph.parsers.syntax" .

cur:cap-other-2 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-other ;
    slkg:position 2 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "SKOS: the W3C's own SKOS vocabulary as an OWL/RDFS ontology (skos.rdf from the SKOS Reference, converted to Turtle with no change to its content)." ;
    slkg:implementedByIdentifier "starlayer.starontology.skos" .

cur:cap-other-3 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-other ;
    slkg:position 3 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "SHACL shapes for SKOS: the Reference's numbered conditions as validation shapes, some non-normative recommendations, and form shapes with datatype-based UI widgets." .

cur:cap-other-4 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-other ;
    slkg:position 4 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "A registry of the bundled ontologies and SHACL shapes (Manchester Syntax, SKOS, SPARQL algebra, SQE, SPARQL expressions, SRL), the SHACL 1.2 meta-shapes, and the profiles document, each available by name and as a file on GitHub." ;
    slkg:implementedByIdentifier "starlayer.starontology.__init__" .

cur:cap-other-5 a slkg:Capability ;
    slkg:inCapabilityArea cur:area-other ;
    slkg:position 5 ;
    slkg:hasStatus "implemented" ;
    rdfs:comment "StarLayer declares its conformance in one profiles document: StarLayer profiles for SKOS, Manchester Syntax, SPARQL 1.2 Query, SRL and SHACL 1.2, each a profile of the public specification, plus the declared conformance of the graph, SPARQL and SHACL packages. Data validated against a shapes graph is reported as conforming to the matching profile and, through it, to the specification." ;
    slkg:implementedByIdentifier 
        "starlayer.conformance.declared_conformance",
        "starlayer.shacl.profiling.derive_conforms_to",
        "starlayer.starontology.__init__.get_conformance_profiles" .
