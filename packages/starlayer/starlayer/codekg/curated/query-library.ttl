                                    ns1:subject "s"^^ns2:Variable ] ) ] ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "line"^^ns2:Variable ;
                            ns1:predicate slkg:lineStart ;
                            ns1:subject "s"^^ns2:Variable ] ) ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "summary"^^ns2:Variable ;
                            ns1:predicate rdfs:comment ;
                            ns1:subject "s"^^ns2:Variable ] ) ] ) .

