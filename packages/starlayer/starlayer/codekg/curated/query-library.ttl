ql:public-api-of-module-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "line"^^ns2:Variable ] ) ;
    ns1:projection ( "name"^^ns2:Variable "kind"^^ns2:Variable "line"^^ns2:Variable "summary"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
