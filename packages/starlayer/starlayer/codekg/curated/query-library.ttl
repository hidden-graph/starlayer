                ns1:expr [ a ns2:Builtin_LCASE ;
                        ns2:arg [ a ns2:Builtin_REPLACE ;
                                ns2:arg [ a ns2:Builtin_STR ;
                                        ns2:arg "type"^^ns2:Variable ] ;
                                ns2:pattern "^.*#" ;
                                ns2:replacement "" ] ] ;
                ns1:var "kind"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns1:Exists ;
                        ns1:negated true ;
                        ns1:where ( [ a ns1:TriplePattern ;
                                    ns1:object true ;
