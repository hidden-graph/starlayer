# Generated by scripts/build_query_library.py from codekg/query-library/*.rq and
# codekg/competency-questions.md. Do not edit by hand: change a .rq file and rebuild.
# Each query is an sqe: tree (the RDF form of a SPARQL query) reached through slkg:queryRoot.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#> .
@prefix ns2: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix ql: <https://github.com/hidden-graph/starlayer/ns/codekg/curated/query-library#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ql:call-chain-from a slkg:NamedQuery ;
    rdfs:label "Everything a function reaches through calls" ;
    rdfs:comment "All functions and methods reachable from a symbol by following calls any number of steps (a property-path query). Large for entry points; narrow the symbol first." ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-what-s-the-call-chain-from-entry ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of the starting function or method" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:call-chain-from-tree .

ql:call-cycles a slkg:NamedQuery ;
    rdfs:label "Pairs of functions that call each other" ;
    rdfs:comment "Direct two-step call cycles (A calls B and B calls A). Longer cycles are not found." ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-are-there-call-cycles-a-calls-b ;
    slkg:queryRoot ql:call-cycles-tree .

ql:callees-of a slkg:NamedQuery ;
    rdfs:label "What does a function or method call?" ;
    rdfs:comment "The direct callees of a symbol, from the call graph." ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-what-functions-methods-does-function-x-call ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a function or method" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:callees-of-tree .

ql:callers-of a slkg:NamedQuery ;
    rdfs:label "Who calls a function or method?" ;
    rdfs:comment "The direct callers of a symbol, from the call graph. No rows means no caller this extractor could resolve, which is a lead, not proof that nothing calls it." ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-if-i-change-x-s-signature-what,
        ql:cq-what-calls-function-x-reverse-lookup ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a function or method" ;
            slkg:paramExample "starlayer.graph.model.encoding.tt_hash" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:callers-of-tree .

ql:capabilities a slkg:NamedQuery ;
    rdfs:label "What StarLayer does, and which code does it" ;
    rdfs:comment "The curated capability list with the symbols that implement each, optionally limited to words in the capability text. Capabilities with no implementing symbol are roadmap items or are implemented by a SHACL or OWL file." ;
    slkg:aboutTopic ql:topic-capabilities ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "only capabilities whose description contains this, case-insensitive" ;
            slkg:paramExample "SHACL" ;
            slkg:paramName "text" ;
            slkg:paramRequired false ] ;
    slkg:queryRoot ql:capabilities-tree .

ql:capability-of-symbol a slkg:NamedQuery ;
    rdfs:label "Which capability does a symbol implement?" ;
    rdfs:comment "The curated capability, if any, that names a symbol as its implementation." ;
    slkg:aboutTopic ql:topic-capabilities ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of the implementing symbol" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:capability-of-symbol-tree .

ql:cq-is-a-given-function-class-method-public a slkg:CompetencyQuestion ;
    rdfs:label "Is a given function/class/method public or private (leading-underscore convention)?" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:cqStatus "answerable" .

ql:cq-is-this-parameter-ever-passed-a-non a slkg:CompetencyQuestion ;
    rdfs:label "Is this parameter ever passed a non-default value anywhere?" ;
    rdfs:comment "harder than the rest: requires resolving real argument values at every call site (positional/keyword/splat), not just whether a call exists. Lower-fidelity, may not be worth building; revisit if it turns out to matter." ;
    slkg:aboutTopic ql:topic-dead-code ;
    slkg:cqStatus "roadmap" .

ql:cq-what-classes-functions-and-methods-does-a a slkg:CompetencyQuestion ;
    rdfs:label "What classes, functions, and methods does a given module define?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-does-a-class-inherit-from-what a slkg:CompetencyQuestion ;
    rdfs:label "What does a class inherit from? What attributes/decorators does it have?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-does-a-function-method-return-and a slkg:CompetencyQuestion ;
    rdfs:label "What does a function/method return, and what type?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-s-the-cleaned-docstring-summary-for a slkg:CompetencyQuestion ;
    rdfs:label "What's the cleaned docstring/summary for a given class/function/method/module?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-which-functions-cite-a-specific-w3c-spec a slkg:CompetencyQuestion ;
    rdfs:label "Which functions cite a specific W3C spec section as their rationale?" ;
    rdfs:comment "deliberately out of scope for this graph (explicit decision); if wanted, build as a separate index outside `codekg`, not inside it." ;
    slkg:aboutTopic ql:topic-specifications ;
    slkg:cqStatus "out-of-scope" .

ql:cq-which-functions-exist-specifically-to-work-around a slkg:CompetencyQuestion ;
    rdfs:label "Which functions exist specifically to work around a known upstream bug (rdflib/pyshacl/etc.), and which bug?" ;
    rdfs:comment "not derivable from the AST at all; this is a human judgment that only exists in a comment or a person's head. Needs a separate, curated mechanism: a small hand-maintained set of \"known bug\" entities (seeded from `docs/upstream-issues/rdflib-upstream-issues.md` and the scattered `xfail` comments flagged in this session's own `future_enhancements.md` entry), with an explicit link from each affected function to the bug it works around. Closer to the long-deferred \"curated graph layered on top of the auto-generated one\" idea than to anything the extractor computes." ;
    slkg:aboutTopic ql:topic-upstream-bugs ;
    slkg:cqStatus "curated" .

ql:cq-which-starlayer-modules-import-which-other-starlayer a slkg:CompetencyQuestion ;
    rdfs:label "Which starlayer modules import which other starlayer modules?" ;
    rdfs:comment "not answerable yet: `slkg:importsModule` only records imports of *external* modules (third-party and standard library); imports between this project's own modules are not extracted. Found 2026-10-19 while building the query library. Use the call graph (`slkg:calls`) for dependencies inside the project." ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:cqStatus "roadmap" .

ql:cq-which-two-subpackages-are-most-tightly-coupled a slkg:CompetencyQuestion ;
    rdfs:label "Which two subpackages are most tightly coupled?" ;
    rdfs:comment "answered from the call graph (calls between subpackages), not from imports, because imports between this project's modules are not extracted (see the question above)." ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:cqStatus "answerable" .

ql:find-symbol a slkg:NamedQuery ;
    rdfs:label "Find a symbol by part of its name" ;
    rdfs:comment "Start here when you know a word but not the full dotted path: lists the classes, functions, methods and modules whose dotted identifier contains the text (ignoring case), with where each is defined." ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "part of a dotted identifier, case-insensitive" ;
            slkg:paramExample "tt_hash" ;
            slkg:paramName "text" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:find-symbol-tree .

ql:leaky-private-functions a slkg:NamedQuery ;
    rdfs:label "Private functions called from another module" ;
    rdfs:comment "Functions whose name starts with an underscore but that a different module (file) calls anyway, which usually means the abstraction leaks or the function should be public." ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:answersCompetencyQuestion ql:cq-is-a-private-function-called-from-outside ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "only private functions whose dotted identifier starts with this" ;
            slkg:paramExample "starlayer.graph" ;
            slkg:paramName "prefix" ;
            slkg:paramRequired false ] ;
    slkg:queryRoot ql:leaky-private-functions-tree .

ql:longest-functions a slkg:NamedQuery ;
    rdfs:label "The longest functions and methods" ;
    rdfs:comment "Functions and methods ordered by number of lines, optionally limited to a dotted prefix. A rough guide to where complexity lives." ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "only symbols whose dotted identifier starts with this" ;
            slkg:paramExample "starlayer.graph" ;
            slkg:paramName "prefix" ;
            slkg:paramRequired false ] ;
    slkg:queryRoot ql:longest-functions-tree .

ql:members-of-class a slkg:NamedQuery ;
    rdfs:label "Public members of a class" ;
    rdfs:comment "The methods and attributes of a class that do not start with an underscore." ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:answersCompetencyQuestion ql:cq-what-s-the-public-api-surface-of ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a class" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:members-of-class-tree .

ql:module-imports a slkg:NamedQuery ;
    rdfs:label "What external modules does a module import?" ;
    rdfs:comment "The third-party and standard-library modules a module imports at its top level. Imports of other starlayer modules are not recorded in the graph (the extractor only extracts external imports), so use callers-of and callees-of for dependencies inside the project." ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:answersCompetencyQuestion ql:cq-what-does-a-given-module-import-at ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a module" ;
            slkg:paramExample "starlayer.sparql.srl" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:module-imports-tree .

ql:overrides a slkg:NamedQuery ;
    rdfs:label "What overrides a method, and what does it override?" ;
    rdfs:comment "Both directions of the override relation for one method: the base-class method it overrides, and the subclass methods that override it." ;
    slkg:aboutTopic ql:topic-inheritance ;
    slkg:answersCompetencyQuestion ql:cq-does-method-x-on-a-subclass-override ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a method" ;
            slkg:paramExample "starlayer.graph.parsers.manchester_parser._Cursor.record_prefix" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:overrides-tree .

ql:parameters-of a slkg:NamedQuery ;
    rdfs:label "Parameters of a function or method" ;
    rdfs:comment "Each parameter's position, name, kind, type annotation and default value." ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:answersCompetencyQuestion ql:cq-what-are-a-function-method-s-parameters ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a function or method" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:parameters-of-tree .

ql:public-api-of-module a slkg:NamedQuery ;
    rdfs:label "Public classes and functions of a module" ;
    rdfs:comment "What a module defines at its top level that does not start with an underscore." ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:answersCompetencyQuestion ql:cq-what-s-the-public-api-surface-of ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a module" ;
            slkg:paramExample "starlayer.graph.model.encoding" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:public-api-of-module-tree .

ql:public-without-docstring a slkg:NamedQuery ;
    rdfs:label "Public symbols with no docstring" ;
    rdfs:comment "Public classes, functions and methods that have no summary, optionally limited to a dotted prefix." ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:answersCompetencyQuestion ql:cq-which-public-functions-have-no-docstring-already ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "only symbols whose dotted identifier starts with this" ;
            slkg:paramExample "starlayer.shacl" ;
            slkg:paramName "prefix" ;
            slkg:paramRequired false ] ;
    slkg:queryRoot ql:public-without-docstring-tree .

ql:subpackage-coupling a slkg:NamedQuery ;
    rdfs:label "Which subpackages call into each other most?" ;
    rdfs:comment "Counts calls between the top-level subpackages of starlayer (graph, sparql, shacl, ...), largest first. It uses the call graph, because the graph does not record imports between starlayer modules." ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:answersCompetencyQuestion ql:cq-finer-grained-coupling-which-function-in-module ;
    slkg:queryRoot ql:subpackage-coupling-tree .

ql:symbol-info a slkg:NamedQuery ;
    rdfs:label "What is this symbol, and where is it?" ;
    rdfs:comment "The kind, location, signature and one-line summary of one symbol, by its dotted identifier." ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:answersCompetencyQuestion ql:cq-what-are-a-function-method-s-parameters ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a class, function, method or module" ;
            slkg:paramExample "starlayer.graph.model.encoding.tt_hash" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:symbol-info-tree .

ql:tests-of a slkg:NamedQuery ;
    rdfs:label "Which tests exercise a function?" ;
    rdfs:comment "The test functions and methods that call a symbol directly." ;
    slkg:aboutTopic ql:topic-testing ;
    slkg:answersCompetencyQuestion ql:cq-does-this-function-have-a-test-that ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a function or method" ;
            slkg:paramExample "starlayer.graph.model.encoding.tt_hash" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:tests-of-tree .

ql:unreferenced-functions a slkg:NamedQuery ;
    rdfs:label "Functions nothing calls" ;
    rdfs:comment "Public functions and methods with no incoming call edge at all, optionally limited to a dotted prefix. Entry points, hooks and anything called through indirection show up here, so treat it as a lead." ;
    slkg:aboutTopic ql:topic-dead-code ;
    slkg:answersCompetencyQuestion ql:cq-is-this-function-ever-called-by-anything ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "only symbols whose dotted identifier starts with this" ;
            slkg:paramExample "starlayer.sparql" ;
            slkg:paramName "prefix" ;
            slkg:paramRequired false ] ;
    slkg:queryRoot ql:unreferenced-functions-tree .

ql:untested-functions a slkg:NamedQuery ;
    rdfs:label "Functions no test calls directly" ;
    rdfs:comment "Public functions and methods with no direct call from any test, optionally limited to a dotted prefix. A function exercised only through another function shows up here too, so treat it as a lead." ;
    slkg:aboutTopic ql:topic-testing ;
    slkg:answersCompetencyQuestion ql:cq-which-functions-have-zero-test-coverage-by ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "only symbols whose dotted identifier starts with this" ;
            slkg:paramExample "starlayer.shacl" ;
            slkg:paramName "prefix" ;
            slkg:paramRequired false ] ;
    slkg:queryRoot ql:untested-functions-tree .

ql:who-instantiates a slkg:NamedQuery ;
    rdfs:label "Where is a class instantiated?" ;
    rdfs:comment "The functions and methods that construct an instance of a class." ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-which-classes-are-ever-instantiated-and-from ;
    slkg:queryParameter [ a slkg:QueryParameter ;
            rdfs:comment "dotted identifier of a class" ;
            slkg:paramExample "starlayer.graph.graph.starlayer_graph.StarLayerGraph" ;
            slkg:paramName "symbol" ;
            slkg:paramRequired true ] ;
    slkg:queryRoot ql:who-instantiates-tree .

ql:call-chain-from-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:distinct true ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "reached"^^ns2:Variable ] ) ;
    ns1:projection ( "reached"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object "b"^^ns2:Variable ;
                ns1:predicate [ a ns2:MulPath ;
                        ns2:mod "+" ;
                        ns2:path slkg:calls ] ;
                ns1:subject "a"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "a"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "reached"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "b"^^ns2:Variable ] ) .

ql:call-cycles-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "first"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "second"^^ns2:Variable ] ) ;
    ns1:projection ( "first"^^ns2:Variable "second"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object "b"^^ns2:Variable ;
                ns1:predicate slkg:calls ;
                ns1:subject "a"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "a"^^ns2:Variable ;
                ns1:predicate slkg:calls ;
                ns1:subject "b"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "first"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "a"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "second"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "b"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:RelationalExpression ;
                        ns2:expr [ a ns2:Builtin_STR ;
                                ns2:arg "a"^^ns2:Variable ] ;
                        ns2:op "<"^^ns2:PlainString ;
                        ns2:other [ a ns2:Builtin_STR ;
                                ns2:arg "b"^^ns2:Variable ] ] ] ) .

ql:callees-of-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "callee"^^ns2:Variable ] ) ;
    ns1:projection ( "callee"^^ns2:Variable "file"^^ns2:Variable "line"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object "t"^^ns2:Variable ;
                ns1:predicate slkg:calls ;
                ns1:subject "c"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "c"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "callee"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "t"^^ns2:Variable ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "file"^^ns2:Variable ;
                            ns1:predicate slkg:filePath ;
                            ns1:subject "t"^^ns2:Variable ] ) ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "line"^^ns2:Variable ;
                            ns1:predicate slkg:lineStart ;
                            ns1:subject "t"^^ns2:Variable ] ) ] ) .

ql:callers-of-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "caller"^^ns2:Variable ] ) ;
    ns1:projection ( "caller"^^ns2:Variable "file"^^ns2:Variable "line"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object "target"^^ns2:Variable ;
                ns1:predicate slkg:calls ;
                ns1:subject "c"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "caller"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "c"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "target"^^ns2:Variable ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "file"^^ns2:Variable ;
                            ns1:predicate slkg:filePath ;
                            ns1:subject "c"^^ns2:Variable ] ) ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "line"^^ns2:Variable ;
                            ns1:predicate slkg:lineStart ;
                            ns1:subject "c"^^ns2:Variable ] ) ] ) .

ql:capabilities-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "area"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "capability"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "symbol"^^ns2:Variable ] ) ;
    ns1:projection ( "area"^^ns2:Variable "capability"^^ns2:Variable "status"^^ns2:Variable "symbol"^^ns2:Variable "file"^^ns2:Variable "line"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:Values ;
                ns1:rows ( ( ns1:undef ) ) ;
                ns1:vars ( "text"^^ns2:Variable ) ] [ a ns1:TriplePattern ;
                ns1:object slkg:Capability ;
                ns1:predicate rdf:type ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "a"^^ns2:Variable ;
                ns1:predicate slkg:inCapabilityArea ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "capability"^^ns2:Variable ;
                ns1:predicate rdfs:comment ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "status"^^ns2:Variable ;
                ns1:predicate slkg:hasStatus ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "area"^^ns2:Variable ;
                ns1:predicate rdfs:label ;
                ns1:subject "a"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:ConditionalOrExpression ;
                        ns2:expr [ a ns2:UnaryNot ;
                                ns2:expr [ a ns2:Builtin_BOUND ;
                                        ns2:arg "text"^^ns2:Variable ] ] ;
                        ns2:other ( [ a ns2:Builtin_CONTAINS ;
                                    ns2:arg1 [ a ns2:Builtin_LCASE ;
                                            ns2:arg "capability"^^ns2:Variable ] ;
                                    ns2:arg2 [ a ns2:Builtin_LCASE ;
                                            ns2:arg "text"^^ns2:Variable ] ] ) ] ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "symbol"^^ns2:Variable ;
                            ns1:predicate slkg:implementedByIdentifier ;
                            ns1:subject "cap"^^ns2:Variable ] [ a ns1:Optional ;
                            ns1:where ( [ a ns1:TriplePattern ;
                                        ns1:object "symbol"^^ns2:Variable ;
                                        ns1:predicate dcterms:identifier ;
                                        ns1:subject "s"^^ns2:Variable ] [ a ns1:Optional ;
                                        ns1:where ( [ a ns1:TriplePattern ;
                                                    ns1:object "file"^^ns2:Variable ;
                                                    ns1:predicate slkg:filePath ;
                                                    ns1:subject "s"^^ns2:Variable ] ) ] [ a ns1:Optional ;
                                        ns1:where ( [ a ns1:TriplePattern ;
                                                    ns1:object "line"^^ns2:Variable ;
                                                    ns1:predicate slkg:lineStart ;
                                                    ns1:subject "s"^^ns2:Variable ] ) ] ) ] ) ] ) .

ql:capability-of-symbol-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "area"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "capability"^^ns2:Variable ] ) ;
    ns1:projection ( "area"^^ns2:Variable "capability"^^ns2:Variable "status"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object slkg:Capability ;
                ns1:predicate rdf:type ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "a"^^ns2:Variable ;
                ns1:predicate slkg:inCapabilityArea ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "capability"^^ns2:Variable ;
                ns1:predicate rdfs:comment ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "status"^^ns2:Variable ;
                ns1:predicate slkg:hasStatus ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate slkg:implementedByIdentifier ;
                ns1:subject "cap"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "area"^^ns2:Variable ;
                ns1:predicate rdfs:label ;
                ns1:subject "a"^^ns2:Variable ] ) .

ql:cq-are-there-call-cycles-a-calls-b a slkg:CompetencyQuestion ;
    rdfs:label "Are there call cycles (A calls B calls A)?" ;
    rdfs:comment "a query over call edges, no separate extraction step." ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-does-method-x-on-a-subclass-override a slkg:CompetencyQuestion ;
    rdfs:label "Does method X on a subclass override a same-named method on a base class?" ;
    rdfs:comment "`slkg:overrides`, built 2026-10-14, originally scoped to same-file bases only, generalized project-wide the same day by reusing `SymbolIndex.resolve_method_in_chain()` (the identical cross-file walk already used for `self`/`cls` call resolution) instead of a separate same-file-only helper. Checked against the real codebase: 7 real cross-file override edges - `starontology/manchester.py`'s `_AstCursor` genuinely subclasses `graph/parsers/manchester_parser.py`'s `_Cursor` and overrides 7 of its methods - invisible under the earlier same-file-only scope, now surfaced. The handful of same-file inheritance pairs still redeclare no shared method names, consistent with this codebase's documented composition-over-inheritance style." ;
    slkg:aboutTopic ql:topic-inheritance ;
    slkg:cqStatus "answerable" .

ql:cq-does-this-function-have-a-test-that a slkg:CompetencyQuestion ;
    rdfs:label "Does this function have a test that exercises it?" ;
    rdfs:comment "a `slkg:calls` edge from a `tests.`-prefixed function to it (same caveats as the rest of the call graph: a test that exercises a function only through an unresolvable indirection won't show up)." ;
    slkg:aboutTopic ql:topic-testing ;
    slkg:cqStatus "answerable" .

ql:cq-finer-grained-coupling-which-function-in-module a slkg:CompetencyQuestion ;
    rdfs:label "Finer-grained coupling (which *function* in module A calls which *function* in module B)" ;
    rdfs:comment "now answerable directly via `slkg:calls`, subject to the same resolution-confidence caveats noted above." ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:cqStatus "answerable" .

ql:cq-if-i-change-x-s-signature-what a slkg:CompetencyQuestion ;
    rdfs:label "If I change X's signature, what else might break (direct callers)?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-is-a-private-function-called-from-outside a slkg:CompetencyQuestion ;
    rdfs:label "Is a \"private\" function called from outside its own module anyway (a leaky abstraction)?" ;
    rdfs:comment "a query joining `isPrivate` with `slkg:calls`'s source module against the private entity's own module." ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:cqStatus "answerable" .

ql:cq-is-this-function-ever-called-by-anything a slkg:CompetencyQuestion ;
    rdfs:label "Is this function ever called by anything, anywhere in the codebase?" ;
    rdfs:comment "zero incoming `slkg:calls` edges. **Caveat inherited directly from the call graph's own resolution limits**: zero incoming edges means \"never called in a way this extractor could confidently resolve\" - a function called only through a pattern it can't resolve (a local variable holding a function reference, a dynamic dispatch, a decorator-wrapped indirect call) will show as unreferenced even though it genuinely isn't dead. Treat a \"zero callers\" result as a lead to check, not a proof." ;
    slkg:aboutTopic ql:topic-dead-code ;
    slkg:cqStatus "answerable" .

ql:cq-what-calls-function-x-reverse-lookup a slkg:CompetencyQuestion ;
    rdfs:label "What calls function X (reverse lookup)?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-what-does-a-given-module-import-at a slkg:CompetencyQuestion ;
    rdfs:label "What does a given module import (at the module level)?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-functions-methods-does-function-x-call a slkg:CompetencyQuestion ;
    rdfs:label "What functions/methods does function X call?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-what-s-the-call-chain-from-entry a slkg:CompetencyQuestion ;
    rdfs:label "What's the call chain from entry point A down to low-level function B?" ;
    rdfs:comment "a `slkg:calls+` property-path query." ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-which-classes-are-ever-instantiated-and-from a slkg:CompetencyQuestion ;
    rdfs:label "Which classes are ever instantiated, and from where?" ;
    rdfs:comment "`slkg:instantiates` (Function→Class), built 2026-10-14 as a separate property from `slkg:calls` rather than widening its range - \"calls a function\" and \"constructs an instance\" are different relationships. Resolved the same way bare/attribute calls are (same-file nesting, import table, module aliases), just checked against `classes_by_dotted_path` too. Verified against the real codebase: 1135 real `slkg:instantiates` edges, e.g. several modules' own helper functions constructing `TripleTerm(...)`, where the same call previously resolved to nothing at all." ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-which-functions-have-zero-test-coverage-by a slkg:CompetencyQuestion ;
    rdfs:label "Which functions have zero test coverage (by this graph's own definition)?" ;
    rdfs:comment "zero incoming `slkg:calls` edges from any `tests.`-prefixed caller." ;
    slkg:aboutTopic ql:topic-testing ;
    slkg:cqStatus "answerable" .

ql:cq-which-public-functions-have-no-docstring-already a slkg:CompetencyQuestion ;
    rdfs:label "Which public functions have no docstring? (already answerable via existing `rdfs:comment` presence/absence" ;
    rdfs:comment "doesn't need the public/private flag added, though the flag makes the query cleaner.)" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:cqStatus "answerable" .

ql:find-symbol-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "symbol"^^ns2:Variable ] ) ;
    ns1:projection ( "symbol"^^ns2:Variable "kind"^^ns2:Variable "file"^^ns2:Variable "line"^^ns2:Variable "summary"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:Values ;
                ns1:rows ( ( ns1:undef ) ) ;
                ns1:vars ( "text"^^ns2:Variable ) ] [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "s"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:Builtin_CONTAINS ;
                        ns2:arg1 [ a ns2:Builtin_LCASE ;
                                ns2:arg "symbol"^^ns2:Variable ] ;
                        ns2:arg2 [ a ns2:Builtin_LCASE ;
                                ns2:arg "text"^^ns2:Variable ] ] ] [ a ns1:TriplePattern ;
                ns1:object "type"^^ns2:Variable ;
                ns1:predicate rdf:type ;
                ns1:subject "s"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:RelationalExpression ;
                        ns2:expr "type"^^ns2:Variable ;
                        ns2:op "IN"^^ns2:PlainString ;
                        ns2:other ( slkg:Class slkg:Function slkg:Method slkg:Module ) ] ] [ a ns1:Bind ;
                ns1:expr [ a ns2:Builtin_LCASE ;
                        ns2:arg [ a ns2:Builtin_REPLACE ;
                                ns2:arg [ a ns2:Builtin_STR ;
                                        ns2:arg "type"^^ns2:Variable ] ;
                                ns2:pattern "^.*#" ;
                                ns2:replacement "" ] ] ;
                ns1:var "kind"^^ns2:Variable ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "file"^^ns2:Variable ;
                            ns1:predicate slkg:filePath ;
                            ns1:subject "s"^^ns2:Variable ] ) ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "line"^^ns2:Variable ;
                            ns1:predicate slkg:lineStart ;
                            ns1:subject "s"^^ns2:Variable ] ) ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "summary"^^ns2:Variable ;
                            ns1:predicate rdfs:comment ;
                            ns1:subject "s"^^ns2:Variable ] ) ] ) .

ql:leaky-private-functions-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "private"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "caller"^^ns2:Variable ] ) ;
    ns1:projection ( "private"^^ns2:Variable "callerModule"^^ns2:Variable "caller"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:Values ;
                ns1:rows ( ( ns1:undef ) ) ;
                ns1:vars ( "prefix"^^ns2:Variable ) ] [ a ns1:TriplePattern ;
                ns1:object true ;
                ns1:predicate slkg:isPrivate ;
                ns1:subject "f"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object slkg:Function ;
                ns1:predicate rdf:type ;
                ns1:subject "f"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "private"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "f"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:ConditionalOrExpression ;
                        ns2:expr [ a ns2:UnaryNot ;
                                ns2:expr [ a ns2:Builtin_BOUND ;
                                        ns2:arg "prefix"^^ns2:Variable ] ] ;
                        ns2:other ( [ a ns2:Builtin_STRSTARTS ;
                                    ns2:arg1 "private"^^ns2:Variable ;
                                    ns2:arg2 "prefix"^^ns2:Variable ] ) ] ] [ a ns1:TriplePattern ;
                ns1:object "caller"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "c"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "f"^^ns2:Variable ;
                ns1:predicate slkg:calls ;
                ns1:subject "c"^^ns2:Variable ] [ a ns1:Bind ;
                ns1:expr [ a ns2:Builtin_STRBEFORE ;
                        ns2:arg1 [ a ns2:Builtin_STR ;
                                ns2:arg "c"^^ns2:Variable ] ;
                        ns2:arg2 "#" ] ;
                ns1:var "callerFile"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:RelationalExpression ;
                        ns2:expr "callerFile"^^ns2:Variable ;
                        ns2:op "!="^^ns2:PlainString ;
                        ns2:other [ a ns2:Builtin_STRBEFORE ;
                                ns2:arg1 [ a ns2:Builtin_STR ;
                                        ns2:arg "f"^^ns2:Variable ] ;
                                ns2:arg2 "#" ] ] ] [ a ns1:Bind ;
                ns1:expr [ a ns2:Builtin_REPLACE ;
                        ns2:arg "callerFile"^^ns2:Variable ;
                        ns2:pattern "^.*/blob/main/" ;
                        ns2:replacement "" ] ;
                ns1:var "callerModule"^^ns2:Variable ] ) .

ql:longest-functions-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:descending true ;
                ns1:expr "lines"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "symbol"^^ns2:Variable ] ) ;
    ns1:projection ( "symbol"^^ns2:Variable "lines"^^ns2:Variable "file"^^ns2:Variable "line"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:Values ;
                ns1:rows ( ( ns1:undef ) ) ;
                ns1:vars ( "prefix"^^ns2:Variable ) ] [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "f"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "type"^^ns2:Variable ;
                ns1:predicate rdf:type ;
                ns1:subject "f"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "file"^^ns2:Variable ;
                ns1:predicate slkg:filePath ;
                ns1:subject "f"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "end"^^ns2:Variable ;
                ns1:predicate slkg:lineEnd ;
                ns1:subject "f"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "line"^^ns2:Variable ;
                ns1:predicate slkg:lineStart ;
                ns1:subject "f"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:RelationalExpression ;
                        ns2:expr "type"^^ns2:Variable ;
                        ns2:op "IN"^^ns2:PlainString ;
                        ns2:other ( slkg:Function slkg:Method ) ] ] [ a ns1:Filter ;
                ns1:expr [ a ns2:Builtin_STRSTARTS ;
                        ns2:arg1 "file"^^ns2:Variable ;
                        ns2:arg2 "packages/starlayer/starlayer/" ] ] [ a ns1:Filter ;
                ns1:expr [ a ns2:ConditionalOrExpression ;
                        ns2:expr [ a ns2:UnaryNot ;
                                ns2:expr [ a ns2:Builtin_BOUND ;
                                        ns2:arg "prefix"^^ns2:Variable ] ] ;
                        ns2:other ( [ a ns2:Builtin_STRSTARTS ;
                                    ns2:arg1 "symbol"^^ns2:Variable ;
                                    ns2:arg2 "prefix"^^ns2:Variable ] ) ] ] [ a ns1:Bind ;
                ns1:expr [ a ns2:AdditiveExpression ;
                        ns2:expr "end"^^ns2:Variable ;
                        ns2:op ( "-"^^ns2:PlainString "+"^^ns2:PlainString ) ;
                        ns2:other ( "line"^^ns2:Variable 1 ) ] ;
                ns1:var "lines"^^ns2:Variable ] ) .

ql:members-of-class-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "line"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "member"^^ns2:Variable ] ) ;
    ns1:projection ( "member"^^ns2:Variable "kind"^^ns2:Variable "line"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object "m"^^ns2:Variable ;
                ns1:predicate slkg:declares ;
                ns1:subject "c"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "member"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "m"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "type"^^ns2:Variable ;
                ns1:predicate rdf:type ;
                ns1:subject "m"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "c"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:RelationalExpression ;
                        ns2:expr "type"^^ns2:Variable ;
                        ns2:op "IN"^^ns2:PlainString ;
                        ns2:other ( slkg:Method slkg:Attribute ) ] ] [ a ns1:Bind ;
                ns1:expr [ a ns2:Builtin_LCASE ;
                        ns2:arg [ a ns2:Builtin_REPLACE ;
                                ns2:arg [ a ns2:Builtin_STR ;
                                        ns2:arg "type"^^ns2:Variable ] ;
                                ns2:pattern "^.*#" ;
                                ns2:replacement "" ] ] ;
                ns1:var "kind"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns1:Exists ;
                        ns1:negated true ;
                        ns1:where ( [ a ns1:TriplePattern ;
                                    ns1:object true ;
                                    ns1:predicate slkg:isPrivate ;
                                    ns1:subject "m"^^ns2:Variable ] ) ] ] [ a ns1:Optional ;
                ns1:where ( [ a ns1:TriplePattern ;
                            ns1:object "line"^^ns2:Variable ;
                            ns1:predicate slkg:lineStart ;
                            ns1:subject "m"^^ns2:Variable ] ) ] ) .

ql:module-imports-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "imported"^^ns2:Variable ] ) ;
    ns1:projection ( "imported"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "m"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "i"^^ns2:Variable ;
                ns1:predicate slkg:importsModule ;
                ns1:subject "m"^^ns2:Variable ] [ a ns1:Bind ;
                ns1:expr [ a ns2:Builtin_REPLACE ;
                        ns2:arg [ a ns2:Builtin_STR ;
                                ns2:arg "i"^^ns2:Variable ] ;
                        ns2:pattern "^.*#" ;
                        ns2:replacement "" ] ;
                ns1:var "imported"^^ns2:Variable ] ) .

ql:overrides-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:expr "relation"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "method"^^ns2:Variable ] ) ;
    ns1:projection ( "relation"^^ns2:Variable "method"^^ns2:Variable ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object "symbol"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "m"^^ns2:Variable ] [ a ns1:Union ;
                ns1:alternatives ( ( [ a ns1:TriplePattern ;
                                ns1:object "o"^^ns2:Variable ;
                                ns1:predicate slkg:overrides ;
                                ns1:subject "m"^^ns2:Variable ] [ a ns1:TriplePattern ;
                                ns1:object "method"^^ns2:Variable ;
                                ns1:predicate dcterms:identifier ;
                                ns1:subject "o"^^ns2:Variable ] [ a ns1:Bind ;
                                ns1:expr "overrides" ;
                                ns1:var "relation"^^ns2:Variable ] ) ( [ a ns1:TriplePattern ;
                                ns1:object "method"^^ns2:Variable ;
                                ns1:predicate dcterms:identifier ;
                                ns1:subject "o"^^ns2:Variable ] [ a ns1:TriplePattern ;
                                ns1:object "m"^^ns2:Variable ;
                                ns1:predicate slkg:overrides ;
                                ns1:subject "o"^^ns2:Variable ] [ a ns1:Bind ;
                                ns1:expr "overridden by" ;
                                ns1:var "relation"^^ns2:Variable ] ) ) ] ) .

