ql:subpackage-coupling-tree a ns1:Query,
        ns1:SelectQuery ;
    ns1:groupBy ( "from"^^ns2:Variable "to"^^ns2:Variable ) ;
    ns1:orderBy ( [ a ns1:OrderCondition ;
                ns1:descending true ;
                ns1:expr "calls"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "from"^^ns2:Variable ] [ a ns1:OrderCondition ;
                ns1:expr "to"^^ns2:Variable ] ) ;
    ns1:projection ( "from"^^ns2:Variable "to"^^ns2:Variable [ a ns1:Alias ;
                ns1:expr [ a ns2:Aggregate_Count ;
                        ns2:distinct () ;
                        ns2:vars "*"^^ns2:PlainString ] ;
                ns1:var "calls"^^ns2:Variable ] ) ;
    ns1:prologuePrefix [ a ns1:PrefixBinding ;
            ns1:namespace rdfs: ;
            ns1:prefixLabel "rdfs"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace dcterms: ;
            ns1:prefixLabel "dcterms"^^ns2:PlainString ],
        [ a ns1:PrefixBinding ;
            ns1:namespace slkg: ;
            ns1:prefixLabel "slkg"^^ns2:PlainString ] ;
    ns1:where ( [ a ns1:TriplePattern ;
                ns1:object "b"^^ns2:Variable ;
                ns1:predicate slkg:calls ;
                ns1:subject "a"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "id1"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "a"^^ns2:Variable ] [ a ns1:TriplePattern ;
                ns1:object "id2"^^ns2:Variable ;
                ns1:predicate dcterms:identifier ;
                ns1:subject "b"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:ConditionalAndExpression ;
                        ns2:expr [ a ns2:Builtin_STRSTARTS ;
                                ns2:arg1 "id1"^^ns2:Variable ;
                                ns2:arg2 "starlayer." ] ;
                        ns2:other ( [ a ns2:Builtin_STRSTARTS ;
                                    ns2:arg1 "id2"^^ns2:Variable ;
                                    ns2:arg2 "starlayer." ] ) ] ] [ a ns1:Bind ;
                ns1:expr [ a ns2:Builtin_REPLACE ;
                        ns2:arg "id1"^^ns2:Variable ;
                        ns2:pattern "^(starlayer\\.[^.]+).*$" ;
                        ns2:replacement "$1" ] ;
                ns1:var "from"^^ns2:Variable ] [ a ns1:Bind ;
                ns1:expr [ a ns2:Builtin_REPLACE ;
                        ns2:arg "id2"^^ns2:Variable ;
                        ns2:pattern "^(starlayer\\.[^.]+).*$" ;
                        ns2:replacement "$1" ] ;
                ns1:var "to"^^ns2:Variable ] [ a ns1:Filter ;
                ns1:expr [ a ns2:RelationalExpression ;
                        ns2:expr "from"^^ns2:Variable ;
                        ns2:op "!="^^ns2:PlainString ;
                        ns2:other "to"^^ns2:Variable ] ] ) .

