# Known bugs in the libraries StarLayer builds on (rdflib, pySHACL, Fuseki, Oxigraph), and the code that works around each.
# This file is the source: edit it directly. Each issue names the write-up in docs/upstream-issues/ (document and entry
# number) and, for a workaround in this repository, the dotted identifiers of the code (as in functionality.ttl).
# slkg:issueStatus is "worked-around" (the code named here exists for it), "fixed-upstream" (fixed in the library; the
# write-up stays as history) or "documented-only" (known, no code here deals with it).

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#> .
@prefix ui: <https://github.com/hidden-graph/starlayer/ns/codekg/curated/upstream-issues#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ui:rdflib-1 a slkg:UpstreamIssue ;
    rdfs:label "`MultiplicativeExpression` doesn't apply numeric type promotion for `*`" ;
    slkg:upstreamProject "rdflib" ;
    slkg:issueDocPath "docs/upstream-issues/rdflib-upstream-issues.md" ;
    slkg:issueNumber 1 ;
    slkg:issueStatus "worked-around" ;
    slkg:workedAroundByIdentifier "starlayer.graph.query.operator_patches.patch_multiplicative_expression_type_promotion" .

