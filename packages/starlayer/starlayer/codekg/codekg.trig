    ns224:TestOxigraphReconnect dcterms:identifier "tests.graph.integration.test_oxigraph_backend.TestOxigraphReconnect" ;
        a ns2:Class ;
        rdfs:comment """A SPARQLUpdateStore-backed StarLayerGraph has no real open/close
    lifecycle of its own (HTTP is stateless per-call, unlike a file-backed
    store such as Sleepycat) - the meaningful equivalent for this backend
    is confirming a *second*, independent StarLayerGraph/store/process
    reconnecting to the same live endpoint sees data a first one wrote,
    with nothing cached in-process bridging the two. Previously untested
    from any angle.""" ;
        rdfs:label "TestOxigraphReconnect" ;
        ns2:declares ns224:TestOxigraphReconnect.test_second_graph_object_sees_data_from_first, ns224:TestOxigraphReconnect.test_close_does_not_lose_or_corrupt_data ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_backend.py" ;
        ns2:hasDecorator ns224:TestOxigraphReconnect.decorator.0 ;
        ns2:lineEnd 693 ;
        ns2:lineStart 662 .

    ns224:TestOxigraphReconnect.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "oxigraph" ;
        ns2:position 0 .

