    ns90:_SparqlAwareEncodedGraph dcterms:identifier "starlayer.shacl.adapters._SparqlAwareEncodedGraph" ;
        a ns2:Class ;
        rdfs:comment """Graph returned by ``TripleTermAdapter.encode_graph``.

    pySHACL preserves whatever object it's handed as ``data_graph`` and calls
    ``.query()`` on it directly for both ``sh:sparql`` constraints and
    ``sh:construct`` SHACL-AF rules (no rewrite/adaptation hook of its own).
    This subclass intercepts those calls: it decodes itself back into a real
    ``StarLayerGraph`` (via the adapter's existing ``decode_graph``) so SPARQL
    1.2 triple-term syntax and triple-term-valued bindings are handled by
    StarLayerGraph's own query engine, then re-encodes the result so the rest
    of pySHACL — which only understands the flat encoded term space — sees
    consistent output. All other Graph behavior (triples/objects/etc.) is
    untouched; only ``.query()`` is affected.""" ;
        rdfs:label "_SparqlAwareEncodedGraph" ;
        rdfs:subClassOf ns4:rdflib.graph.Graph ;
        ns2:declares ns90:_SparqlAwareEncodedGraph.add, ns90:_SparqlAwareEncodedGraph.remove, ns90:_SparqlAwareEncodedGraph._decode_cached, ns90:_SparqlAwareEncodedGraph.__init__, ns90:_SparqlAwareEncodedGraph.query, ns90:_SparqlAwareEncodedGraph.addN ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/adapters.py" ;
        ns2:isPrivate true ;
        ns2:lineEnd 203 ;
        ns2:lineStart 30 .

