    ns14:StarLayerTurtleParser.parse dcterms:identifier "starlayer.graph.parsers.turtle_parser.StarLayerTurtleParser.parse" ;
        a ns2:Method ;
        rdfs:comment """Parse Turtle 1.2 text and return an rdflib.Graph.

    The graph uses the starlayer.graph internal blank-node encoding for RDF 1.2
    triple terms and reification. Pass debug=True to print intermediate
    representations to stdout.

    base seeds relative-IRI resolution (including a bare "<>") before any
    parsing happens, the same role rdflib's own parsers give their
    publicID/base argument - an in-document @base/BASE directive, if
    present, still overrides it from that point on (current_base is
    reassigned, not merged). Previously there was no way to seed this at
    all from the caller; a document with no @base of its own had no
    working relative-IRI resolution regardless of what publicID the
    caller (e.g. StarLayerGraph.parse(location=..., publicID=...))
    passed in - confirmed via the W3C SHACL 1.2 test suite, whose
    manifest files rely pervasively on "<>" self-reference.""" ;
        rdfs:label "parse" ;
        ns2:declares ns14:StarLayerTurtleParser.parse._orig_line ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/turtle_parser.py" ;
        ns2:hasParameter ns14:StarLayerTurtleParser.parse.param.debug, ns14:StarLayerTurtleParser.parse.param.base, ns14:StarLayerTurtleParser.parse.param.data ;
        ns2:hasReturnValue ns14:StarLayerTurtleParser.parse.returns ;
        ns2:lineEnd 1139 ;
        ns2:lineStart 970 ;
        ns2:signature "def parse(self, data: str, debug: bool=False, base: str=None) -> Graph" .

