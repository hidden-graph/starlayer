    ns129:TestBareLiteralShorthandAndRdfTypeKeyword dcterms:identifier "tests.graph.unit.test_turtle12_serializer.TestBareLiteralShorthandAndRdfTypeKeyword" ;
        a ns2:Class ;
        rdfs:comment """serialize_turtle12 emits Turtle's own bare BooleanLiteral/INTEGER/
    DECIMAL tokens (true/false, 42, 1.5) instead of "value"^^xsd:type, and
    the 'a' keyword for rdf:type - but only when the literal's own lexical
    form actually matches Turtle's bare-token grammar, which is narrower
    than XSD's own lexical space for each datatype. A value typed as one
    of these but whose lexical form doesn't match must fall back to the
    quoted+typed form - that's always syntactically valid Turtle
    regardless of how malformed the lexical form is; the bare form isn't.""" ;
        rdfs:label "TestBareLiteralShorthandAndRdfTypeKeyword" ;
        ns2:declares ns129:TestBareLiteralShorthandAndRdfTypeKeyword.test_malformed_integer_lexical_form_falls_back_to_typed_form, ns129:TestBareLiteralShorthandAndRdfTypeKeyword.test_rdf_type_emitted_as_a_keyword, ns129:TestBareLiteralShorthandAndRdfTypeKeyword.test_decimal_emitted_bare, ns129:TestBareLiteralShorthandAndRdfTypeKeyword.test_integer_emitted_bare_including_negative, ns129:TestBareLiteralShorthandAndRdfTypeKeyword.test_boolean_true_false_emitted_bare, ns129:TestBareLiteralShorthandAndRdfTypeKeyword._roundtrip_and_serialized, ns129:TestBareLiteralShorthandAndRdfTypeKeyword.test_decimal_lexical_form_with_no_fractional_digits_falls_back ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_turtle12_serializer.py" ;
        ns2:lineEnd 398 ;
        ns2:lineStart 327 .

