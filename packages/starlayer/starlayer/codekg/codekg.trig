        rdfs:label "SPARQLSyntaxError" ;
        rdfs:subClassOf ns4:builtins.ValueError ;
        ns2:filePath "packages/starlayer/starlayer/sparql/_syntax_checks.py" ;
        ns2:lineEnd 19 ;
