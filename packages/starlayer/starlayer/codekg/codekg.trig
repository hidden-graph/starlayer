        ns2:hasReturnValue ns75:StarShaclSchema.validate_each.returns ;
        ns2:lineEnd 951 ;
        ns2:lineStart 917 ;
        ns2:signature "def validate_each(self, data_graphs: Iterable[Any] | None=None, **kwargs: Any) -> dict[int, ValidationResult]" .

