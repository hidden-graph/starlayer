    ns64:_ontology_graph dcterms:identifier "starlayer.sparql.srl._ontology_graph" ;
        a ns2:Function ;
        rdfs:comment """The ``srl:`` RDFS ontology, combined with ``salg:``'s and
    ``spexpr:``'s - private: see module docstring for why this isn't
    exposed publicly.

    All three must be loaded together: this module's own SHACL shapes use
    ``sh:class spexpr:Expression``/``spexpr:Variable``, and the RDFS
    subclass entailment those checks depend on only resolves correctly
    when ``srl_owl``, ``sparql_owl``, and ``spexpr_owl`` are all present in
    the same graph.""" ;
        rdfs:label "_ontology_graph" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/srl.py" ;
