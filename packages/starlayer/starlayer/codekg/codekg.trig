GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/shacl/meta_shapes.py> {
    ns74:meta_shapes.py dcterms:identifier "starlayer.shacl.meta_shapes" ;
        a ns2:Module ;
        rdfs:comment """starShacl's own meta-shacl preflight, replacing reliance on pySHACL's
    ``meta_shacl`` kwarg.

    pySHACL's own ``meta_shacl=True`` always validates a shapes graph against its
    bundled ``shacl-shacl.ttl``, with no way to add or replace rules, and that graph
    predates SHACL 1.2 (it has no rule for the 11 new predicates and rejects the 8
    whose value space SHACL 1.2 widened, e.g. ``sh:class ( ex:A ex:B )``).
    ``meta_validate`` instead checks a shapes graph against starShacl's own
    meta-shapes graph, run directly through ``pyshacl.validate()``, so this
    preflight fully replaces pySHACL's rather than running both.

    That graph is not assembled at run time. It is stored as ``starontology``'s
    ``shacl12-shacl.ttl`` (registry entry ``shacl_shacl``) and read by
    ``load_meta_shapes_graph``. The build that produces it (pySHACL's graph with the
    8 too-strict rules removed, plus ``shacl12-validation-shapes.ttl``) lives in
    ``scripts/build_meta_shapes.py`` and is run by ``scripts/build_starontology.py``;
    a test fails if the stored file drifts from a fresh build. Upgrading pySHACL or
    editing the validation shapes therefore changes nothing here until that build is
    re-run.""" ;
        rdfs:label "meta_shapes" ;
        ns2:declares ns82:_collect_query_prefixes, ns82:_meta_validate_cache_key, ns82:load_meta_shapes_graph, ns82:_sparql_structure_cache_key, ns82:meta_validate, ns82:_is_prebound_variable_only_report, ns82:check_sparql_query_text ;
        ns2:filePath "packages/starlayer/starlayer/shacl/meta_shapes.py" ;
        ns2:importsModule ns4:collections.abc, ns4:rdflib.namespace, ns4:typing, ns4:__future__, ns4:rdflib, ns4:collections .

    ns82:_collect_query_prefixes dcterms:identifier "starlayer.shacl.meta_shapes._collect_query_prefixes" ;
        a ns2:Function ;
        rdfs:comment """Resolve the prefix map a ``sh:select``/``sh:ask``/``sh:construct``
    query at ``query_node`` would actually see at real execution time -
    same algorithm as pySHACL's own
    ``SPARQLQueryHelper.collect_prefixes()``, reimplemented directly
    against a plain shapes graph rather than through a full ``Shape``/
    ``pyshacl.ShapesGraph`` wrapper (unnecessary overhead for a read-only prefix
    lookup - ``shape.sg.graph`` is just the same graph passed in here).

    Falls back to starShacl's own ambient ``sh:ShapesGraph`` discovery
    (``_ambient_shapes_graph_prefixes``) when ``query_node`` has no
    explicit ``sh:prefixes`` reference at all - pySHACL's own mechanism
    never does this on its own (see that function's docstring for why).""" ;
        rdfs:label "_collect_query_prefixes" ;
        ns2:calls ns76:_ambient_shapes_graph_prefixes ;
        ns2:filePath "packages/starlayer/starlayer/shacl/meta_shapes.py" ;
        ns2:hasParameter ns82:_collect_query_prefixes.param.shapes_graph, ns82:_collect_query_prefixes.param.query_node ;
        ns2:hasReturnValue ns82:_collect_query_prefixes.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 268 ;
        ns2:lineStart 225 ;
        ns2:signature "def _collect_query_prefixes(shapes_graph: Any, query_node: Any) -> dict[str, Any]" .

    ns82:_collect_query_prefixes.param.query_node a ns2:Parameter ;
        rdfs:label "query_node" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns82:_collect_query_prefixes.param.shapes_graph a ns2:Parameter ;
        rdfs:label "shapes_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns82:_collect_query_prefixes.returns a ns2:ReturnValue ;
        ns2:annotationText "dict[str, Any]" ;
        ns2:hasType ns4:builtins.str, ns4:typing.Any, ns4:builtins.dict .

    ns82:_is_prebound_variable_only_report dcterms:identifier "starlayer.shacl.meta_shapes._is_prebound_variable_only_report" ;
        a ns2:Function ;
        rdfs:comment """True iff every violation in a ``salg.validate_query()`` report is a
    ``salg:noUnboundProjectedVariables`` hit naming only a SHACL pre-bound
    pseudo-variable (``$this``/``$value``/``$PATH``) - a false positive
    this check should suppress, not a real defect. ``False`` (never
    suppressed) for an empty result set too - that would mean ``conforms``
    was already ``True`` and there was nothing to call this for in the
    first place.""" ;
        rdfs:label "_is_prebound_variable_only_report" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/meta_shapes.py" ;
        ns2:hasParameter ns82:_is_prebound_variable_only_report.param.report_graph ;
        ns2:hasReturnValue ns82:_is_prebound_variable_only_report.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 339 ;
        ns2:lineStart 318 ;
        ns2:signature "def _is_prebound_variable_only_report(report_graph: Graph) -> bool" .

    ns82:_is_prebound_variable_only_report.param.report_graph a ns2:Parameter ;
        rdfs:label "report_graph" ;
