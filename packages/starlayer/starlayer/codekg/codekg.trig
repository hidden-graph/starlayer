    ns236:TestPlainTurtle.test_form_feed_and_backspace_escapes_decode dcterms:identifier "tests.graph.unit.test_turtle_parser.TestPlainTurtle.test_form_feed_and_backspace_escapes_decode" ;
        a ns2:Method ;
        rdfs:comment """\\f (form feed, U+000C) and \\b (backspace, U+0008) are both valid
    Turtle ECHAR escapes (grammar: '\\' [tbnrf"'\\]) - _unescape() only
    handled t/n/r plus the quote/backslash escapes, silently leaving
    \\f/\\b as a literal backslash followed by the letter instead of the
    control character. Found via the W3C SHACL 1.2 test suite
    (core/property/singleLine-001.ttl, which uses \\f in a literal) -
    \\n/\\r/\\uXXXX all decoded correctly there, isolating the gap to
    exactly these two escapes.""" ;
        rdfs:label "test_form_feed_and_backspace_escapes_decode" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser.py" ;
        ns2:hasParameter ns236:TestPlainTurtle.test_form_feed_and_backspace_escapes_decode.param.parser ;
