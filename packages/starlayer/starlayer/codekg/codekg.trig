        ns2:position 0 .

    ns27:_annotate_opaque.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns27:_build_rdf_list dcterms:identifier "starlayer.graph.graph.shape_derivation._build_rdf_list" ;
        a ns2:Function ;
        rdfs:label "_build_rdf_list" ;
