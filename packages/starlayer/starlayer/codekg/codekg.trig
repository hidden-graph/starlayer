    ns145:test_execution_roundtrip_via_starlayergraph dcterms:identifier "tests.sparql.unit.test_phase6_serialize12.test_execution_roundtrip_via_starlayergraph" ;
        a ns2:Function ;
        rdfs:label "test_execution_roundtrip_via_starlayergraph" ;
        ns2:calls ns72:prepare_query_12, ns145:_run, ns70:_translate_algebra_12 ;
