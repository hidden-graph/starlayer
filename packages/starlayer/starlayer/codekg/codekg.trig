    ns43:contains_custom_function_call dcterms:identifier "starlayer.graph.query.remote_decompose.contains_custom_function_call" ;
        a ns2:Function ;
        rdfs:comment """True iff a call to one of starlayer.graph's custom SPARQL functions
    (``_CUSTOM_FUNCTION_IRIS``) appears anywhere in ``node``, recursively -
    a generic tree walk, not scoped to any particular algebra shape (unlike
    ``decompose_for_remote``, which only strips ``Extend`` nodes under a
    ``SelectQuery``). Used to *detect* the problem in shapes
    ``decompose_for_remote`` doesn't (yet) know how to *fix* - e.g. a
    ``ConstructQuery`` template minting a fresh triple term - so a caller
    can fail loudly instead of silently sending an unusable query to a
    remote store.""" ;
        rdfs:label "contains_custom_function_call" ;
        ns2:calls ns43:_is_custom_function_call, ns43:contains_custom_function_call ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:hasParameter ns43:contains_custom_function_call.param.node ;
        ns2:hasReturnValue ns43:contains_custom_function_call.returns ;
        ns2:lineEnd 102 ;
        ns2:lineStart 79 ;
        ns2:signature "def contains_custom_function_call(node: Any) -> bool" .

