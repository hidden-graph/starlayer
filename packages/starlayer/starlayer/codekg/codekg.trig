    ns241:TestHasLangAndHasLangdirOnNonLiterals dcterms:identifier "tests.sparql.unit.test_dirlang_string_functions.TestHasLangAndHasLangdirOnNonLiterals" ;
        a ns2:Class ;
        rdfs:comment """RDF 1.2 Query sec 17.4.2.10/.11: hasLANG()/hasLANGDIR() must return
    false for a non-literal RDF term, not error - unlike LANG()/LANGDIR()
    themselves, which both do error on one. Found broken 2026-10-13
    alongside the string-function retrofit: DATATYPE() (which both of
    these build on internally) raises for a non-literal, and that error
    was propagating all the way up uncaught.""" ;
        rdfs:label "TestHasLangAndHasLangdirOnNonLiterals" ;
        ns2:declares ns241:TestHasLangAndHasLangdirOnNonLiterals.test_langdir_of_iri_still_errors, ns241:TestHasLangAndHasLangdirOnNonLiterals.test_haslangdir_of_iri_is_false_not_unbound, ns241:TestHasLangAndHasLangdirOnNonLiterals.test_haslang_of_dirlangstring_is_still_true, ns241:TestHasLangAndHasLangdirOnNonLiterals.test_haslang_of_iri_is_false_not_unbound ;
