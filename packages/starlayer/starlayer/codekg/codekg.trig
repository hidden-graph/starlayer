GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/ssyn_to_text.py> {
    ns48:ssyn_to_text.py dcterms:identifier "starlayer.sparql.ssyn_to_text" ;
        a ns2:Module ;
        rdfs:comment """Render ``ssyn:`` RDF (``to_ssyn_rdf.py``'s output) back into literal
    SPARQL query text — the completion of the round trip, closing it through
    text rather than by hand-reconstructing algebra ``CompValue`` trees.

    This is a much lower-risk path than driving ``rdflib.plugins.sparql.algebra
    .translateGroupGraphPattern``/``translateQuery`` directly: ``ssyn:`` is
    already syntax-shaped (flat WHERE-clause elements, real resolved terms), so
    rendering it as text is close to mechanical — no reconstruction of
    ``TriplesBlock``/path/precedence-chain shapes needed at all, since none of
    that verbosity was ever introduced on the encode side. Once we have text,
    execution goes through this project's own real, already-tested pipeline
    (``parse12.prepare_query_12`` / plain ``prepareQuery``) unchanged — nothing
    new needed there either.

    The one place this *does* reuse existing machinery rather than writing a
    new renderer: ``ssyn:Filter``/``ssyn:Bind``'s ``ssyn:expr`` falls back to
    the existing ``salg:`` expression vocabulary (see ``to_ssyn_rdf.py``'s
    module docstring), and rendering *that* subtree as text reuses rdflib's own
    ``algebra.translateAlgebra`` — via a throwaway wrapper query
    (``SELECT * WHERE { FILTER(<expr>) }``), since ``translateAlgebra`` only
    ever seeds its output from a top-level query node (confirmed, see CLAUDE.md
    finding #14) — rather than hand-writing a second expression-to-text
    renderer duplicating ``_AlgebraTranslator``'s existing ~63-builtin
    coverage.""" ;
        rdfs:label "ssyn_to_text" ;
        ns2:declares ns58:_term_text, ns58:_predicate_text, ns58:ssyn_rdf_to_query_text, ns58:_simplify_expr_immutable, ns58:_expr_text, ns58:_where_group_text, ns58:_where_element_text, ns58:_render_expr_text ;
        ns2:filePath "packages/starlayer/starlayer/sparql/ssyn_to_text.py" ;
        ns2:importsModule ns4:rdflib.collection, ns4:__future__, ns4:rdflib, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib.plugins.sparql.algebra, ns4:rdflib.plugins.sparql.parserutils, ns4:rdflib.namespace .

    ns58:_expr_text dcterms:identifier "starlayer.sparql.ssyn_to_text._expr_text" ;
        a ns2:Function ;
        rdfs:label "_expr_text" ;
        ns2:calls ns58:_render_expr_text, ns53:_decode ;
        ns2:filePath "packages/starlayer/starlayer/sparql/ssyn_to_text.py" ;
        ns2:hasParameter ns58:_expr_text.param.graph, ns58:_expr_text.param.expr_node ;
        ns2:hasReturnValue ns58:_expr_text.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 151 ;
        ns2:lineStart 149 ;
        ns2:signature "def _expr_text(graph: Graph, expr_node) -> str" .

    ns58:_expr_text.param.expr_node a ns2:Parameter ;
        rdfs:label "expr_node" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns58:_expr_text.param.graph a ns2:Parameter ;
        rdfs:label "graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns58:_expr_text.returns a ns2:ReturnValue ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

    ns58:_predicate_text dcterms:identifier "starlayer.sparql.ssyn_to_text._predicate_text" ;
        a ns2:Function ;
        rdfs:comment """A predicate position may be a genuine property path — see
    to_ssyn_rdf.py's _encode_predicate, which falls back to the existing
    spexpr: path encoding (to_rdf._encode_path) for that case, the same
    spexpr:-boundary principle used for expressions. Decode it back into a
    real rdflib.paths.Path object (from_rdf._decode already knows how,
    dispatching on the node's spexpr: type) and reuse *its* own .n3() —
    Path objects already render themselves as valid SPARQL path syntax,
    no new rendering logic needed.

    Path-encoded nodes are typed under spexpr:, not salg: — to_rdf
    ._encode_path types every path node (InvPath/SequencePath/
    AlternativePath/MulPath/NegatedPath) under spexpr: unconditionally (see
    that function's own docstring, "Path is one of the vocabularies that
    moved"), so path-detection code must test for spexpr: specifically.
    Testing salg: here instead would silently miss every genuine path
    predicate, falling through to _term_text(term) — which renders the
    path's own BNode identifier as if it were an ordinary term, producing a
    bare blank-node ID in the regenerated query text instead of e.g.
    `foaf:knows+`.""" ;
        rdfs:label "_predicate_text" ;
        ns2:calls ns53:_decode, ns58:_term_text ;
        ns2:filePath "packages/starlayer/starlayer/sparql/ssyn_to_text.py" ;
        ns2:hasParameter ns58:_predicate_text.param.term, ns58:_predicate_text.param.graph ;
        ns2:hasReturnValue ns58:_predicate_text.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 146 ;
        ns2:lineStart 112 ;
        ns2:signature "def _predicate_text(graph: Graph, term) -> str" .

    ns58:_predicate_text.param.graph a ns2:Parameter ;
        rdfs:comment "The RDF graph containing the encoded predicate." ;
        rdfs:label "graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns58:_predicate_text.param.term a ns2:Parameter ;
        rdfs:comment "The encoded predicate node/term." ;
        rdfs:label "term" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns58:_predicate_text.returns a ns2:ReturnValue ;
        rdfs:comment "The predicate's SPARQL text (a path expression, a prefixed/full IRI, or a variable)." ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

    ns58:_render_expr_text dcterms:identifier "starlayer.sparql.ssyn_to_text._render_expr_text" ;
        a ns2:Function ;
        rdfs:comment """Render a real algebra expression node as text.

    Wraps ``expr`` in a throwaway query and reuses rdflib's own
    ``translateAlgebra``, then slices out the ``FILTER(...)`` contents —
    see this module's docstring for why. Public (not module-private) since
    ``srl.py`` reuses it directly too — SRL's own ``filter.expr``/
    ``assign.expr`` are the same real rdflib ``Expr`` trees, no RDF
    round-trip needed to call this. See :func:`_simplify_expr_immutable`
    for why the expression is simplified via a fresh, non-mutating rebuild
    rather than rdflib's own (in-place-mutating) ``operators.simplify``.""" ;
        rdfs:label "_render_expr_text" ;
