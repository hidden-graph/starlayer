    ns224:TestOxigraphTurtle12Parse dcterms:identifier "tests.graph.integration.test_oxigraph_backend.TestOxigraphTurtle12Parse" ;
        a ns2:Class ;
        rdfs:comment """.parse(format='turtle12'/'trig12') on a native-backend graph used to
    write the rdf-1.1 backend's own tt:HASH skolemized encoding fragments
    directly into the store (StarLayerGraph.parse()'s turtle12/trig12
    branches called super().add(triple), bypassing the backend-aware
    StarLayerGraph.add() override that routes to _native_add()) - so a
    triple term parsed from text (as opposed to added via the .add()
    Python API, which was never affected) came back from .triples() as
    the raw rdf:subject/predicate/object encoding-triple fragments
    instead of a real TripleTerm object, and rdf:reifies lookups against
    such data never matched anything real. Confirmed to affect both
    simple and nested triple terms, and to break starShacl's
    sh:reifierShape/sh:reificationRequired end to end (the discovery
    path). Fixed by decoding the skolemized encoding back into real
    TripleTerm objects (turtle_parser.decode_tt_encoded_triples) before
    writing native-backend data, so it goes through self.add() ->
    _native_add() instead.""" ;
        rdfs:label "TestOxigraphTurtle12Parse" ;
        ns2:declares ns224:TestOxigraphTurtle12Parse.test_no_encoding_triples_visible_after_parse, ns224:TestOxigraphTurtle12Parse.test_trig12_parse_decodes_correctly, ns224:TestOxigraphTurtle12Parse.test_rdf_reifies_lookup_matches_parsed_data, ns224:TestOxigraphTurtle12Parse.test_simple_triple_term_decodes_correctly, ns224:TestOxigraphTurtle12Parse.test_nested_triple_term_decodes_correctly ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_backend.py" ;
        ns2:hasDecorator ns224:TestOxigraphTurtle12Parse.decorator.0 ;
        ns2:lineEnd 261 ;
        ns2:lineStart 177 .

    ns224:TestOxigraphTurtle12Parse.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "oxigraph" ;
        ns2:position 0 .

