    ns143:TestSerialize dcterms:identifier "tests.graph.unit.test_dataset.TestSerialize" ;
        a ns2:Class ;
        rdfs:label "TestSerialize" ;
        ns2:declares ns143:TestSerialize.test_prefixes_before_graph_blocks, ns143:TestSerialize.test_literal_line_resembling_a_prefix_directive_round_trips, ns143:TestSerialize.test_serialize_produces_graph_blocks, ns143:TestSerialize.test_serialize_triple_terms_present ;
