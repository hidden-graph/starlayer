    ns236:TestPlainTurtle.test_typed_literal_preserves_non_canonical_lexical_form dcterms:identifier "tests.graph.unit.test_turtle_parser.TestPlainTurtle.test_typed_literal_preserves_non_canonical_lexical_form" ;
        a ns2:Method ;
        rdfs:comment """"04"^^xsd:integer must stay "04", not be silently rewritten to
    the canonical "4" - RDF 1.2's own literal term-equality definition
    (https://www.w3.org/TR/rdf12-concepts/#dfn-literal-term-equality)
    requires the lexical form to match, not just the value, so a parser
    that normalizes on construction makes two genuinely different terms
    indistinguishable.""" ;
        rdfs:label "test_typed_literal_preserves_non_canonical_lexical_form" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser.py" ;
        ns2:hasParameter ns236:TestPlainTurtle.test_typed_literal_preserves_non_canonical_lexical_form.param.parser ;
        ns2:lineEnd 69 ;
        ns2:lineStart 55 ;
        ns2:signature "def test_typed_literal_preserves_non_canonical_lexical_form(self, parser)" .

    ns236:TestPlainTurtle.test_typed_literal_preserves_non_canonical_lexical_form.param.parser a ns2:Parameter ;
        rdfs:label "parser" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns236:TestPlainTurtle.test_typed_literal_with_bracketed_iri_datatype dcterms:identifier "tests.graph.unit.test_turtle_parser.TestPlainTurtle.test_typed_literal_with_bracketed_iri_datatype" ;
        a ns2:Method ;
        rdfs:comment """'^^<full-iri>' (as opposed to '^^prefixed:name') is ordinary
    Turtle syntax - e.g. any canonical/no-prefixes document - but was
    previously broken end to end (Turtle12SyntaxError: unexpected
    trailing content), since split_obj_and_annotations's '^^'-suffix
    handling only correctly consumed the prefixed-name form.""" ;
        rdfs:label "test_typed_literal_with_bracketed_iri_datatype" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser.py" ;
        ns2:hasParameter ns236:TestPlainTurtle.test_typed_literal_with_bracketed_iri_datatype.param.parser ;
