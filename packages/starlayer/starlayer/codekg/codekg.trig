    ns71:_bgp_plain_vars dcterms:identifier "starlayer.sparql.lower_rdf11._bgp_plain_vars" ;
        a ns2:Function ;
        rdfs:comment """Collect every `Variable` appearing as an ordinary (non-triple-term)
    subject/predicate/object anywhere in `triples` — the seed for
    `already_bound` (see `_add_single_constraint`'s docstring): a variable
    reused this way is guaranteed bound by the BGP's own ordinary matching
    regardless of where any triple-term constraint for it ends up, since
    BGP triples join as one unordered AND, not left-to-right.""" ;
        rdfs:label "_bgp_plain_vars" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/lower_rdf11.py" ;
        ns2:hasParameter ns71:_bgp_plain_vars.param.triples ;
        ns2:hasReturnValue ns71:_bgp_plain_vars.returns ;
