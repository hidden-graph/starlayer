GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/graph/owl_dl.py> {
    ns25:owl_dl.py dcterms:identifier "starlayer.graph.graph.owl_dl" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.graph.owl_dl

    OWL 2 Direct Semantics reasoning via owlready2 + Java HermiT - a genuinely
    different computational model (tableau-based DL reasoning, with real
    disjunctive case-splitting and sound-and-complete consistency checking)
    from every other entailment regime StarLayerGraph.infer() supports, all of which run
    owlrl's forward-chaining rule engine. See infer()'s own docstring for the
    entailment=ENTAILMENT['OWL-Direct'] contract; this module is the bridge that makes it work.

    Deliberately HermiT only, never Pellet (owlready2 bundles both behind
    sync_reasoner()/sync_reasoner_pellet()): HermiT is LGPL, Pellet is AGPL - a
    materially stronger copyleft obligation - and one conformant OWL 2 DL
    reasoner is sufficient to cover this regime. sync_reasoner_pellet() is
    never called anywhere in this module.

    engine="hermit" (this module) is one of two engines infer(entailment=ENTAILMENT['OWL-Direct'])
    can dispatch to - see starlayer.graph.graph.owl_dl_rustdl for the other
    (engine="rustdl": no JVM, but sound-not-provably-complete rather than
    sound-and-complete - a real, permanent gap against this module's own
    guarantee, not a bug in either). Both engines' Python packages are optional
    extras (`pip install starlayer.graph[hermit]` / `[rustdl]`), not core
    dependencies - `owlready2` used to be core, moved to opt-in alongside
    `rustdl` for a consistent story across both rather than one being special.
    A real Java runtime on PATH is the one prerequisite `pip` alone still can't
    satisfy for this engine specifically: owlready2 bundles Java HermiT and
    needs a real JVM at runtime to run it - see `_require_java()` below.""" ;
        rdfs:label "owl_dl" ;
        ns2:declares ns30:classify_owl_dl, ns30:_run_hermit_subprocess, ns30:_complete_type_closure, ns30:_require_owlready2, ns30:InconsistentOntologyError, ns30:_require_java ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:importsModule ns4:pathlib, ns4:__future__, ns4:tempfile, ns4:rdflib, ns4:shutil .

    ns30:InconsistentOntologyError dcterms:identifier "starlayer.graph.graph.owl_dl.InconsistentOntologyError" ;
        a ns2:Class ;
        rdfs:comment """Raised when entailment=ENTAILMENT['OWL-Direct'] finds self's data logically
    inconsistent under OWL 2 DL semantics - e.g. an individual typed as two
    classes declared owl:disjointWith each other. Unlike entailment=ENTAILMENT['OWL-RDF-Based']
    (whose consistency checking, via owlrl, is partial and silently embeds
    a synthetic err:error triple into the result instead of raising - see
    infer()'s own docstring), HermiT's check is sound and complete, so an
    inconsistency here is surfaced as an unmissable exception rather than
    left for the caller to notice on their own.""" ;
        rdfs:label "InconsistentOntologyError" ;
        rdfs:subClassOf ns4:builtins.RuntimeError ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:lineEnd 50 ;
        ns2:lineStart 41 .

    ns30:_complete_type_closure dcterms:identifier "starlayer.graph.graph.owl_dl._complete_type_closure" ;
        a ns2:Function ;
        rdfs:comment """HermiT's CLI realization output only reports each individual's
    *most specific* known type(s), not every ancestor class up the
    hierarchy (confirmed live: for a plain `Manager rdfs:subClassOf
    Employee` + `alice a Manager`, HermiT reports `Type(alice, Manager)`
    but never `Type(alice, Employee)`, even though the subClassOf edge
    itself - `SubClassOf(Manager, Employee)` - is reported and present in
    `expanded`). Every other entailment regime infer() supports (all owlrl-backed)
    gives the full transitive rdf:type closure, so this step restores that
    same guarantee here - walks rdfs:subClassOf transitively from each
    individual's reported type(s) and adds every ancestor class as an
    additional rdf:type, mutating `expanded` in place. Purely additive:
    never removes or changes an existing triple, only adds ones already
    implied by what HermiT already reported.""" ;
        rdfs:label "_complete_type_closure" ;
        ns2:calls ns30:_complete_type_closure._ancestors ;
        ns2:declares ns30:_complete_type_closure._ancestors ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:hasParameter ns30:_complete_type_closure.param.expanded ;
        ns2:hasReturnValue ns30:_complete_type_closure.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 237 ;
        ns2:lineStart 202 ;
        ns2:signature "def _complete_type_closure(expanded: Graph) -> None" .

    ns30:_complete_type_closure._ancestors dcterms:identifier "starlayer.graph.graph.owl_dl._complete_type_closure._ancestors" ;
        a ns2:Function ;
        rdfs:label "_ancestors" ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:hasParameter ns30:_complete_type_closure._ancestors.param.cls ;
        ns2:isPrivate true ;
        ns2:lineEnd 230 ;
        ns2:lineStart 221 ;
        ns2:signature "def _ancestors(cls)" .

    ns30:_complete_type_closure._ancestors.param.cls a ns2:Parameter ;
        rdfs:label "cls" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns30:_complete_type_closure.param.expanded a ns2:Parameter ;
        rdfs:label "expanded" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns30:_complete_type_closure.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns30:_require_java dcterms:identifier "starlayer.graph.graph.owl_dl._require_java" ;
        a ns2:Function ;
        rdfs:comment """Confirm a real Java runtime is reachable - the one prerequisite
    `pip install`ing owlready2 (checked by _require_owlready2() above)
    still can't satisfy: owlready2's HermiT reasoner is a Java program,
    not a pure-Python one.""" ;
        rdfs:label "_require_java" ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:hasReturnValue ns30:_require_java.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 85 ;
        ns2:lineStart 72 ;
        ns2:signature "def _require_java() -> None" .

    ns30:_require_java.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns30:_require_owlready2 dcterms:identifier "starlayer.graph.graph.owl_dl._require_owlready2" ;
        a ns2:Function ;
        rdfs:comment """Import and return the owlready2 module, or raise a clear, actionable
    RuntimeError naming exactly what to install - the "opt-in package
    missing" counterpart to _require_java()'s "JVM missing" check below,
    checked first since it's the cheaper, more fundamental question (no
    point checking for a JVM to run a reasoner whose Python package isn't
    even installed yet).""" ;
        rdfs:label "_require_owlready2" ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:isPrivate true ;
        ns2:lineEnd 69 ;
        ns2:lineStart 53 ;
        ns2:signature "def _require_owlready2()" .

    ns30:_run_hermit_subprocess dcterms:identifier "starlayer.graph.graph.owl_dl._run_hermit_subprocess" ;
        a ns2:Function ;
        rdfs:comment """The actual blocking `owlready2.sync_reasoner()` call, isolated as a
    module-level (picklable-by-reference) function so `_timeout.run_with_timeout()`
    can run it in its own child process/process group and forcibly kill it
    (JVM grandchild included) if it doesn't finish in time - see
    `_timeout.py`'s own module docstring for why that's necessary at all.

    Puts exactly one `(status, ...)` tuple onto `queue`:
    - `('ok', None)` - success; results are already on disk at
      `result_path` (this function's own `world.save()`), not sent
      through the queue itself.
    - `('inconsistent', message)` - HermiT found the ontology logically
      inconsistent.
    - `('java_error', message)` - a present-but-broken JVM failed inside
      the HermiT subprocess call itself (not merely missing - `_require_java()`
      only confirms a `java` binary exists on PATH, not that it works).

    Arbitrary exception *objects* aren't reliably picklable across the
    process boundary (owlready2's own exception classes are not
    guaranteed to be) - only plain strings go through `queue`, and the
    parent (`classify_owl_dl()`) reconstructs the right exception type
    from the status tag.""" ;
        rdfs:label "_run_hermit_subprocess" ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:hasParameter ns30:_run_hermit_subprocess.param.queue, ns30:_run_hermit_subprocess.param.owl_path, ns30:_run_hermit_subprocess.param.result_path ;
        ns2:hasReturnValue ns30:_run_hermit_subprocess.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 125 ;
        ns2:lineStart 88 ;
        ns2:signature "def _run_hermit_subprocess(owl_path: str, result_path: str, queue) -> None" .

    ns30:_run_hermit_subprocess.param.owl_path a ns2:Parameter ;
        rdfs:label "owl_path" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns30:_run_hermit_subprocess.param.queue a ns2:Parameter ;
        rdfs:label "queue" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns30:_run_hermit_subprocess.param.result_path a ns2:Parameter ;
        rdfs:label "result_path" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns30:_run_hermit_subprocess.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns30:classify_owl_dl dcterms:identifier "starlayer.graph.graph.owl_dl.classify_owl_dl" ;
        a ns2:Function ;
        rdfs:comment """Run OWL 2 DL classification (HermiT, via owlready2) over `graph`,
    returning (before, delta) in the same shape
    StarLayerGraph._infer_before_and_delta() returns for the owlrl-backed
    regimes, so infer()'s mode="full"/"delta"/"in-place" branches can
    treat both engines uniformly without knowing which one ran.

    Raises InconsistentOntologyError if the data is logically inconsistent
    under OWL 2 DL semantics.""" ;
        rdfs:label "classify_owl_dl" ;
        ns2:calls ns278:_decompose, ns30:_complete_type_closure, ns30:_require_owlready2, ns26:run_with_timeout, ns30:_require_java ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:hasParameter ns30:classify_owl_dl.param.timeout, ns30:classify_owl_dl.param.graph ;
        ns2:hasReturnValue ns30:classify_owl_dl.returns ;
        ns2:instantiates ns30:InconsistentOntologyError ;
        ns2:lineEnd 199 ;
        ns2:lineStart 128 ;
        ns2:signature "def classify_owl_dl(graph, timeout: float | None=_timeout.DEFAULT_TIMEOUT_SECONDS)" .

    ns30:classify_owl_dl.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to classify." ;
        rdfs:label "graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns30:classify_owl_dl.param.timeout a ns2:Parameter ;
        rdfs:comment "Wall-clock budget in seconds for the actual HermiT call (default `_timeout.DEFAULT_TIMEOUT_SECONDS`, 120s) - the call runs in its own subprocess/process group so it can be forcibly killed, JVM child included, if it's exceeded; raises `_timeout.ReasoningTimeoutError`. Pass `None` to disable the timeout entirely (wait indefinitely - the pre-this-feature behavior). See `_timeout.py`'s own module docstring for why a subprocess kill, not a cooperative cancellation, is the only mechanism that reliably works here." ;
        rdfs:label "timeout" ;
        ns2:annotationText "float | None" ;
        ns2:defaultValue "_timeout.DEFAULT_TIMEOUT_SECONDS" ;
        ns2:hasType ns4:builtins.float ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns30:classify_owl_dl.returns a ns2:ReturnValue ;
        rdfs:comment "A (before, delta) tuple of Graphs - `before` the decomposed input graph, `delta` the newly-entailed triples not already in `before`." .

    ns4:__future__ a ns2:ExternalModule .

