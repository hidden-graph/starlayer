    ns75:_compute_sh_default_value dcterms:identifier "starlayer.shacl.validator._compute_sh_default_value" ;
        a ns2:Function ;
        rdfs:comment """SHACL 1.2 Core's own "Value Nodes of Property Shapes" algorithm treats
    ``sh:defaultValue`` exactly like ``sh:values`` for evaluation purposes -
    "add the output nodes of evalExpr(d, data graph, focus node, {})" - so a
    ``sh:defaultValue`` can be a full node expression (e.g. ``[
    shnex:pathValues ex:firstName ]``, falling back to a sibling property
    when the target one is missing), not just a plain constant. A plain
    ``Literal``/``URIRef`` constant still evaluates to itself via
    ``eval_expr``'s own constant-node handling, so this is a strict superset
    of "just read the raw RDF object", not a special case for the
    node-expression form alone. A plain object-lookup read of
    ``sh:defaultValue`` would be wrong for the node-expression form
    specifically: it would add the blank node itself as a bogus "value"
    rather than evaluating it.""" ;
        rdfs:label "_compute_sh_default_value" ;
        ns2:calls ns78:eval_expr ;
        ns2:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
        ns2:hasParameter ns75:_compute_sh_default_value.param.focus_node, ns75:_compute_sh_default_value.param.target_graph, ns75:_compute_sh_default_value.param.default_value_node, ns75:_compute_sh_default_value.param.sg ;
        ns2:hasReturnValue ns75:_compute_sh_default_value.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 5037 ;
        ns2:lineStart 5006 ;
        ns2:signature "def _compute_sh_default_value(default_value_node: Any, target_graph: Any, sg: Any, focus_node: Any) -> list" .

