GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/query/operator_patches.py> {
    ns33:operator_patches.py dcterms:identifier "starlayer.graph.query.operator_patches" ;
        a ns2:Module ;
        rdfs:comment """Targeted compatibility shims for confirmed bugs in plain rdflib's own
    SPARQL arithmetic/numeric-function evaluation (``rdflib.plugins.sparql``) -
    not bugs in this repo's own query rewriting. Found via the W3C SHACL 1.2
    test suite's Node Expressions and Rules fixtures
    (``docs/w3c-shacl12-test-suite-plan.md`` in the ``starShacl`` repo); each
    bug reproduces against plain ``rdflib.Graph().query()`` with no
    starlayer.graph/pySHACL involvement.

    Both patches follow the same idempotent apply-once pattern used elsewhere
    in this project for third-party monkeypatches: a module-level
    ``_xxx_patch_status: bool | None`` flag plus a marker attribute on the
    patched callable, so repeated calls (e.g. from multiple import sites) are
    safe no-ops.""" ;
        rdfs:label "operator_patches" ;
        ns2:declares ns44:_canonicalize_decimal_lexical_form, ns44:patch_decimal_result_lexical_form, ns44:patch_multiplicative_expression_type_promotion, ns44:apply_all_operator_patches, ns44:_iter_subexpressions, ns44:_find_comp ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/operator_patches.py" ;
        ns2:importsModule ns4:rdflib.plugins.sparql.operators, ns4:rdflib, ns4:rdflib.namespace, ns4:decimal, ns4:math, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib.plugins.sparql.datatypes, ns4:__future__, ns4:rdflib.plugins.sparql.parserutils .

    ns44:_canonicalize_decimal_lexical_form dcterms:identifier "starlayer.graph.query.operator_patches._canonicalize_decimal_lexical_form" ;
        a ns2:Function ;
        rdfs:comment """XSD decimal's canonical lexical form requires a decimal point with
    at least one digit on each side (e.g. ``"42.0"``, not ``"42"``) - but
    rdflib's own CEIL/FLOOR/ROUND/division construct a whole-number decimal
    result via a Python ``int``/exact ``Decimal``, whose default string form
    omits the trailing ``.0``.""" ;
        rdfs:label "_canonicalize_decimal_lexical_form" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/operator_patches.py" ;
        ns2:hasParameter ns44:_canonicalize_decimal_lexical_form.param.literal ;
        ns2:hasReturnValue ns44:_canonicalize_decimal_lexical_form.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 86 ;
        ns2:lineStart 69 ;
        ns2:signature "def _canonicalize_decimal_lexical_form(literal: Literal) -> Literal" .

    ns44:_canonicalize_decimal_lexical_form.param.literal a ns2:Parameter ;
        rdfs:comment "The ``Literal`` to canonicalize." ;
        rdfs:label "literal" ;
        ns2:annotationText "Literal" ;
        ns2:hasType ns4:rdflib.term.Literal ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns44:_canonicalize_decimal_lexical_form.returns a ns2:ReturnValue ;
        rdfs:comment "A re-lexicalized ``Literal`` with a trailing ``.0`` if ``literal`` is ``xsd:decimal``-typed and missing a decimal point; otherwise ``literal`` unchanged." ;
        ns2:annotationText "Literal" ;
        ns2:hasType ns4:rdflib.term.Literal .

    ns44:_find_comp dcterms:identifier "starlayer.graph.query.operator_patches._find_comp" ;
        a ns2:Function ;
        rdfs:comment """Locate a named ``Comp`` grammar node inside rdflib's already-built
    pyparsing SPARQL grammar tree.

    ``Comp.postParse`` reads ``self.evalfn`` fresh on every parse (it's a
    plain mutable instance attribute, not a closure baked in at
    grammar-definition time), so calling ``.setEvalFn()`` on the node found
    here changes behavior for every future ``.query()`` call.""" ;
        rdfs:label "_find_comp" ;
        ns2:calls ns44:_find_comp, ns44:_iter_subexpressions ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/operator_patches.py" ;
        ns2:hasParameter ns44:_find_comp.param.root, ns44:_find_comp.param.name, ns44:_find_comp.param._seen ;
        ns2:hasReturnValue ns44:_find_comp.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 66 ;
        ns2:lineStart 38 ;
        ns2:signature "def _find_comp(root, name, _seen=None)" .

    ns44:_find_comp.param._seen a ns2:Parameter ;
        rdfs:comment "Internal recursion guard - set of already-visited node ids." ;
        rdfs:label "_seen" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns44:_find_comp.param.name a ns2:Parameter ;
        rdfs:comment "The ``Comp`` node's ``.name`` to match." ;
        rdfs:label "name" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns44:_find_comp.param.root a ns2:Parameter ;
        rdfs:comment "The pyparsing grammar node to search from." ;
        rdfs:label "root" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns44:_find_comp.returns a ns2:ReturnValue ;
        rdfs:comment "The matching ``Comp`` node, or ``None`` if not found." .

    ns44:_iter_subexpressions dcterms:identifier "starlayer.graph.query.operator_patches._iter_subexpressions" ;
        a ns2:Function ;
        rdfs:label "_iter_subexpressions" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/operator_patches.py" ;
        ns2:hasParameter ns44:_iter_subexpressions.param.pyparsing_element ;
        ns2:isPrivate true ;
        ns2:lineEnd 35 ;
        ns2:lineStart 29 ;
        ns2:signature "def _iter_subexpressions(pyparsing_element)" .

    ns44:_iter_subexpressions.param.pyparsing_element a ns2:Parameter ;
