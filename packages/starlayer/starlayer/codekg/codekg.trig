    ns32:_run_rustdl_subprocess.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns32:classify_owl_dl_rustdl dcterms:identifier "starlayer.graph.graph.owl_dl_rustdl.classify_owl_dl_rustdl" ;
        a ns2:Function ;
        rdfs:comment """Run OWL 2 DL classification (RustDL) over `graph`, returning
    (before, delta) in the same shape classify_owl_dl() (engine="hermit")
    returns, so infer()'s mode="full"/"delta"/"in-place" branches treat
    both engines uniformly without knowing which one ran.

    Raises InconsistentOntologyError if the data is logically inconsistent.
    See this module's own docstring for what RustDL does and doesn't
    guarantee relative to engine="hermit" - notably, forced *property*
    assignments derived only through disjunctive reasoning (no search)
    won't reproduce the same way this engine did under HermiT.""" ;
        rdfs:label "classify_owl_dl_rustdl" ;
        ns2:calls ns32:_check_rustdl_hang_risk, ns32:_infer_missing_owl_types, ns30:_complete_type_closure, ns278:_decompose, ns26:run_with_timeout, ns32:_require_rustdl ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/owl_dl_rustdl.py" ;
        ns2:hasParameter ns32:classify_owl_dl_rustdl.param.graph, ns32:classify_owl_dl_rustdl.param.timeout ;
        ns2:hasReturnValue ns32:classify_owl_dl_rustdl.returns ;
        ns2:instantiates ns30:InconsistentOntologyError ;
        ns2:lineEnd 335 ;
        ns2:lineStart 253 ;
        ns2:signature "def classify_owl_dl_rustdl(graph, timeout: float | None=_timeout.DEFAULT_TIMEOUT_SECONDS)" .

    ns32:classify_owl_dl_rustdl.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to classify." ;
