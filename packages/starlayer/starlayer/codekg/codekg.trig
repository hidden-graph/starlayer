    ns28:StarLayerGraph.query.param.timeout a ns2:Parameter ;
        rdfs:comment "Only meaningful when ``entailment=ENTAILMENT[\"OWL-Direct\"]``; same validation and meaning as ``infer()``'s own ``timeout`` parameter - see ``infer()``'s own docstring for the full ``engine=``/ ``timeout=`` contract. query call." ;
        rdfs:label "timeout" ;
