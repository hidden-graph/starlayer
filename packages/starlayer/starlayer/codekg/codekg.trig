        ns2:lineEnd 158 ;
        ns2:lineStart 145 ;
        ns2:signature "def parse_trix12_named(text: str) -> list[tuple[URIRef | None, list[tuple]]]" .

    ns23:parse_trix12_named.param.text a ns2:Parameter ;
        rdfs:comment "The TriX 1.2 document text to parse." ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns23:parse_trix12_named.returns a ns2:ReturnValue ;
        rdfs:comment "A list of (graph_id, triples) pairs, one per graph with at least one triple - graph_id is None for an anonymous/default graph, a URIRef for a named graph." ;
        ns2:annotationText "list[tuple[URIRef | None, list[tuple]]]" ;
        ns2:hasType ns4:builtins.tuple, ns4:rdflib.term.URIRef, ns4:builtins.list .

