    ns236:TestLongStringWithEmbeddedQuoteOrBlankLine dcterms:identifier "tests.graph.unit.test_turtle_parser.TestLongStringWithEmbeddedQuoteOrBlankLine" ;
        a ns2:Class ;
        rdfs:comment """End-to-end regression coverage for three real bugs found while
    getting the code-KG extractor's own output (a rich, content-heavy
    docstring corpus) to round-trip through serialize_turtle12() and back
    through this parser:

    1. syntax._split_statements_impl()'s string-tracking didn't remember
       whether an open string was opened with the long (triple) form or
       the short (single-char) form - so a single embedded quote character
       inside a real triple-quoted string (legal per Turtle's own
       grammar - up to 2 consecutive unescaped quote chars mid-string are
       allowed) was misread as closing it.
    2. The same function's directive-keyword detection ran even while
       inside an open string, so a line starting with 'version'/'prefix'/
       'base' (or a prefix of one, e.g. 'based') deep inside a docstring
       was misdetected as a real directive.
    3. StarLayerTurtleParser.parse()'s own blank/comment-line prefilter
       (which runs before split_statements_with_lines()) dropped a blank
       paragraph-break line even when it fell *inside* an open
       triple-quoted string literal, silently losing it from the parsed
       literal's content.

    See tests/graph/unit/test_syntax.py::TestTripleQuotedStringWithEmbeddedQuote
    for the lower-level statement-splitter-only tests.""" ;
        rdfs:label "TestLongStringWithEmbeddedQuoteOrBlankLine" ;
        ns2:declares ns236:TestLongStringWithEmbeddedQuoteOrBlankLine.test_embedded_single_quote_inside_long_string, ns236:TestLongStringWithEmbeddedQuoteOrBlankLine.test_directive_keyword_prefix_inside_long_string_not_misdetected, ns236:TestLongStringWithEmbeddedQuoteOrBlankLine.test_blank_line_inside_long_string_preserved, ns236:TestLongStringWithEmbeddedQuoteOrBlankLine.test_real_source_file_round_trips ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser.py" ;
        ns2:lineEnd 912 ;
        ns2:lineStart 817 .

    ns236:TestLongStringWithEmbeddedQuoteOrBlankLine.test_blank_line_inside_long_string_preserved dcterms:identifier "tests.graph.unit.test_turtle_parser.TestLongStringWithEmbeddedQuoteOrBlankLine.test_blank_line_inside_long_string_preserved" ;
