    ns191:test_each_resource_states_what_it_does_not_claim.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns191:test_entailment_regimes_are_individual_iris_not_the_whole_document dcterms:identifier "tests.test_conformance.test_entailment_regimes_are_individual_iris_not_the_whole_document" ;
        a ns2:Function ;
        rdfs:comment """SPARQL 1.2 Entailment Regimes itself (the document) must never be
    claimed - only the four individually-supported regime IRIs, and they
    must be exactly the regimes the library's code supports
    (SUPPORTED_REGIMES), so the declaration can't drift from the code.""" ;
