        rdfs:comment "A plain graph: the real, stored values of every property shape with a simple ``sh:path``, for its own target focus nodes, with any ``sh:values``/``sh:defaultValue``-computed values unioned in." ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any .

