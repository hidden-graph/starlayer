GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/lexer.py> {
    ns11:lexer.py dcterms:identifier "starlayer.graph.parsers.lexer" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.lexer

    Character-level tokenization for Turtle 1.2. Handles all token forms:
    <<( )>> triple terms, << >> reification shorthand, <IRI>, quoted strings,
    [ ] blank nodes, ( ) collections, and plain whitespace-delimited tokens.

    Every form below that scans for a closing delimiter raises
    starlayer.graph.parsers.errors.Turtle12SyntaxError if it reaches the end of the
    statement text without finding one, rather than silently treating "no
    closing delimiter found" as "the rest of the text is one token" - the
    statement-level Turtle12SyntaxError.line is filled in by the caller
    (StarLayerTurtleParser.parse()), since these functions only see
    already-extracted, single-statement text with no document-level line info.""" ;
        rdfs:label "lexer" ;
        ns2:declares ns20:split_obj_and_annotations, ns20:next_token, ns20:consume_annotation_block ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/lexer.py" .

    ns20:consume_annotation_block dcterms:identifier "starlayer.graph.parsers.lexer.consume_annotation_block" ;
        a ns2:Function ;
        rdfs:comment """Consume one {| ... |} annotation block from the start of s, handling
    nested {| |} blocks and quoted strings.""" ;
        rdfs:label "consume_annotation_block" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/lexer.py" ;
        ns2:hasParameter ns20:consume_annotation_block.param.s ;
        ns2:hasReturnValue ns20:consume_annotation_block.returns ;
        ns2:lineEnd 211 ;
        ns2:lineStart 174 ;
        ns2:signature "def consume_annotation_block(s)" .

    ns20:consume_annotation_block.param.s a ns2:Parameter ;
        rdfs:comment "Text starting with '{|'." ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns20:consume_annotation_block.returns a ns2:ReturnValue ;
        rdfs:comment "A (body_str, remaining) tuple - the block's inner content (stripped) and the remaining text after the closing '|}'." .

    ns20:next_token dcterms:identifier "starlayer.graph.parsers.lexer.next_token" ;
        a ns2:Function ;
        rdfs:comment "Return the next atomic token in s." ;
        rdfs:label "next_token" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/lexer.py" ;
        ns2:hasParameter ns20:next_token.param.s ;
        ns2:hasReturnValue ns20:next_token.returns ;
        ns2:lineEnd 171 ;
        ns2:lineStart 26 ;
        ns2:signature "def next_token(s)" .

    ns20:next_token.param.s a ns2:Parameter ;
        rdfs:comment "The pre-stripped remaining input text to tokenize from." ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns20:next_token.returns a ns2:ReturnValue ;
        rdfs:comment "A (token, remaining) tuple - the next atomic token and the remaining text after it (left-stripped), or (None, '') if s is empty." .

    ns20:split_obj_and_annotations dcterms:identifier "starlayer.graph.parsers.lexer.split_obj_and_annotations" ;
        a ns2:Function ;
        rdfs:comment """Split an object term plus any trailing ~reifier/{| |} annotation
    suffixes into the object token and its annotation specs.""" ;
        rdfs:label "split_obj_and_annotations" ;
        ns2:calls ns20:next_token, ns20:consume_annotation_block ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/lexer.py" ;
        ns2:hasParameter ns20:split_obj_and_annotations.param.s ;
        ns2:hasReturnValue ns20:split_obj_and_annotations.returns ;
        ns2:lineEnd 291 ;
        ns2:lineStart 214 ;
        ns2:signature "def split_obj_and_annotations(s)" .

    ns20:split_obj_and_annotations.param.s a ns2:Parameter ;
        rdfs:comment "Text of the form 'obj [~ reifier [{| body |}]]* [{| body |}]*'." ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns20:split_obj_and_annotations.returns a ns2:ReturnValue ;
        rdfs:comment "A (obj_token, annotations) tuple, where annotations is a list of (reifier_or_None, body_or_None) pairs in source order." .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/shacl/profiling.py> {
    ns74:profiling.py dcterms:identifier "starlayer.shacl.profiling" ;
        a ns2:Module ;
        rdfs:comment """Support for SHACL 1.2 Profiling (https://www.w3.org/TR/shacl12-profiling/).

    docs/shacl12-gap-matrix.md's Profiling row and "Not Covered / Deferred"
    table investigated this document to the same depth as the other five
    SHACL 1.2 documents and concluded no *mandatory* validator runtime
    behavior is missing: S2's packaging conventions (sh:ShapesGraph/
    sh:DataGraph grouping, rdfs:isDefinedBy/rdfs:member, owl:imports) are
    SHOULD-level organizational metadata with no defined effect on
    validation, and S3/S4 (declaring/using SHACL feature profiles) describe
    how other specs and tooling use SHACL, not processor behavior.

    That still leaves two genuinely useful, spec-shaped things an
    implementation *can* do that this module provides:

    1. ``declared_conformance_profile()`` - starlayer.shacl's own self-declaration
       (S3, "Profiles of SHACL") of which named SHACL 1.2 feature profiles it
       implements, as a small bundled RDF document
       (assets/shacl12-conformance-profile.ttl) using the same dx-prof
       vocabulary the spec itself uses, rather than only the prose gap matrix.
    2. ``derive_conforms_to()`` - S5.5's sh:conformsTo inference rule. This is
       MAY-level (S2.8) and mechanically just an ordinary SPARQL CONSTRUCT
       rule - starlayer.shacl's own sh:SPARQLRule engine could already execute a
       rule of this exact shape - but it can never fire against a plain
       validation report graph as produced, since that report has no
       sh:usedDataGraph/sh:usedShapesGraph/sh:validationReport identity
       linking it back to caller-meaningful graph IRIs unless the caller opts
       in. ``StarShaclSchema.validate()``'s own ``data_graph_iri=``/
       ``shapes_graph_resource=`` keyword arguments (SHACL 1.2 Core S6.7.1.5-6.7.1.6,
       see ``validator.py::_annotate_used_graphs_and_configuration``) already
       add the ``sh:usedDataGraph``/``sh:usedShapesGraph`` half of that identity
       when supplied - ``derive_conforms_to()`` reads those straight off the
       report when present, so a caller who already validated with those
       kwargs doesn't have to repeat the IRIs here. The one link neither
       mechanism supplies on its own is ``sh:validationReport`` (a data-graph
       *resource* pointing at its own report) - genuinely new identity this
       function adds, since nothing else in the pipeline has a reason to.""" ;
        rdfs:label "profiling" ;
        ns2:declares ns83:derive_conforms_to, ns83:declared_conformance_profile, ns83:_bind_derived_namespaces, ns83:_find_report_node ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:importsModule ns4:rdflib, ns4:rdflib.namespace, ns4:typing, ns4:__future__, ns4:os .

    ns83:_bind_derived_namespaces dcterms:identifier "starlayer.shacl.profiling._bind_derived_namespaces" ;
        a ns2:Function ;
        rdfs:comment """Give ``graph`` a clean, deliberate namespace table instead of
    whatever ``StarLayerGraph()``'s own bare-construction default happens
    to be - same pattern (and same motivation) as ``validator.py``'s own
    ``_rebuild_report_namespaces()``, just scoped to what's actually
    available in this module (no ``data_graph``/``shacl_graph``/
    ``ont_graph`` graph objects here, only IRIs - ``report_graph``/
    ``specification_graph`` are the only real graphs this function ever
    sees).""" ;
        rdfs:label "_bind_derived_namespaces" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:hasParameter ns83:_bind_derived_namespaces.param.graph, ns83:_bind_derived_namespaces.param.sources ;
        ns2:hasReturnValue ns83:_bind_derived_namespaces.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 149 ;
        ns2:lineStart 115 ;
        ns2:signature "def _bind_derived_namespaces(graph: Any, *sources: Any) -> None" .

    ns83:_bind_derived_namespaces.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to bind namespaces onto, in place. ``sh``/``prof``/``dcterms`` (bound unconditionally first, since every triple this module derives uses at least one of them), in the order given, first-bound-wins." ;
        rdfs:label "graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns83:_bind_derived_namespaces.param.sources a ns2:Parameter ;
        rdfs:label "sources" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "vararg" .

    ns83:_bind_derived_namespaces.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns83:_find_report_node dcterms:identifier "starlayer.shacl.profiling._find_report_node" ;
        a ns2:Function ;
        rdfs:label "_find_report_node" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:hasParameter ns83:_find_report_node.param.report_graph ;
        ns2:hasReturnValue ns83:_find_report_node.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 112 ;
        ns2:lineStart 109 ;
        ns2:signature "def _find_report_node(report_graph: Any) -> Any" .

    ns83:_find_report_node.param.report_graph a ns2:Parameter ;
        rdfs:label "report_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns83:_find_report_node.returns a ns2:ReturnValue ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any .

    ns83:declared_conformance_profile dcterms:identifier "starlayer.shacl.profiling.declared_conformance_profile" ;
        a ns2:Function ;
        rdfs:comment """A fresh copy of starlayer.shacl's bundled self-declared SHACL 1.2
    conformance statement (S3). Parses the bundled asset fresh on every
    call rather than caching - matching this project's convention
    elsewhere (see meta_shapes.py::build_meta_shapes_graph) of never
    sharing one mutable graph object across callers.

    Returns a ``StarLayerGraph``, not a plain ``rdflib.Graph`` - this is a
    public, caller-facing result meant to be inspected/serialized/merged,
    not internal plumbing fed straight to pySHACL.""" ;
        rdfs:label "declared_conformance_profile" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:hasReturnValue ns83:declared_conformance_profile.returns ;
        ns2:lineEnd 106 ;
        ns2:lineStart 85 ;
        ns2:signature "def declared_conformance_profile() -> StarLayerGraph" .

    ns83:declared_conformance_profile.returns a ns2:ReturnValue ;
        rdfs:comment "A fresh StarLayerGraph containing the bundled conformance statement." ;
        ns2:annotationText "StarLayerGraph" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

    ns83:derive_conforms_to dcterms:identifier "starlayer.shacl.profiling.derive_conforms_to" ;
        a ns2:Function ;
        rdfs:comment """Derive ``sh:conformsTo`` triples from a validation report, per
    SHACL 1.2 Profiling S5.5.

    Only conforming reports (``sh:conforms true``) produce a
    ``sh:conformsTo`` triple, matching the rule's own WHERE clause - a
    non-conformant report derives nothing.

    If ``specification_graph`` is given, the second S5.5 rule also runs
    once the first has fired, additionally deriving ``dcterms:conformsTo``
    triples to whatever specification(s) ``shapes_graph`` is declared a
    profile of. This is not the same relationship
    ``declared_conformance_profile()`` records (that one is *this
    library's* own conformance to named SHACL 1.2 feature profiles, a
    different resource than ``shapes_graph``) - pass a graph relating
    ``shapes_graph`` itself to whatever it profiles.""" ;
        rdfs:label "derive_conforms_to" ;
        ns2:calls ns83:_bind_derived_namespaces, ns83:_find_report_node ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:hasParameter ns83:derive_conforms_to.param.conforms_only, ns83:derive_conforms_to.param.specification_graph, ns83:derive_conforms_to.param.data_graph, ns83:derive_conforms_to.param.report_graph, ns83:derive_conforms_to.param.shapes_graph ;
        ns2:hasReturnValue ns83:derive_conforms_to.returns ;
        ns2:lineEnd 300 ;
        ns2:lineStart 152 ;
        ns2:signature "def derive_conforms_to(report_graph: Any, *, data_graph: str | URIRef | None=None, shapes_graph: str | URIRef | None=None, specification_graph: Any | None=None, conforms_only: bool=False) -> StarLayerGraph" .

    ns83:derive_conforms_to.param.conforms_only a ns2:Parameter ;
        rdfs:comment "If ``True``, the returned graph contains *only* the ``sh:conformsTo``/``dcterms:conformsTo`` triples themselves - not ``report_graph``, and not even the ``sh:validationReport`` link this function otherwise adds (that link exists to justify the conformance claim with a path back to the report, which ``conforms_only`` says isn't wanted) - useful when a caller only cares about the conformance claims themselves, e.g. to merge into a dataset catalog entry that has no reason to reference a SHACL validation report at all. If ``False`` (the default), the returned graph is ``report_graph`` merged with whatever got newly derived - a self-contained, immediately printable/serializable result, where the added ``sh:validationReport`` link resolves to a real, fully-described node rather than a dangling blank-node reference." ;
        rdfs:label "conforms_only" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "False" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns83:derive_conforms_to.param.data_graph a ns2:Parameter ;
        rdfs:comment "The data graph as an RDF resource - an IRI or IRI-like string, using whatever identity scheme the caller's application already uses (a dataset-catalog IRI, a named-graph IRI - there is no single right default). Optional: if the report was produced by ``validate(..., data_graph_iri=..., shapes_graph_resource=...)``, the matching ``sh:usedDataGraph`` triple is already on the report and is read from there when this is omitted." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "str | URIRef | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:rdflib.term.URIRef, ns4:builtins.str ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns83:derive_conforms_to.param.report_graph a ns2:Parameter ;
        rdfs:comment "A plain SHACL validation report graph (e.g. ``ValidationResult.report_graph``). Read, never mutated." ;
        rdfs:label "report_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns83:derive_conforms_to.param.shapes_graph a ns2:Parameter ;
        rdfs:comment "The shapes graph as an RDF resource, same optionality and fallback as ``data_graph`` (read from the report's own ``sh:usedShapesGraph`` when omitted)." ;
        rdfs:label "shapes_graph" ;
        ns2:annotationText "str | URIRef | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:rdflib.term.URIRef, ns4:builtins.str ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 2 .

    ns83:derive_conforms_to.param.specification_graph a ns2:Parameter ;
        rdfs:comment "A graph asserting ``prof:isProfileOf`` on ``shapes_graph`` itself (e.g. a ``prof:Profile`` declaration for the shapes graph the caller validated against), to additionally derive ``dcterms:conformsTo`` triples via S5.5's second rule (see above). Read, never mutated. ``None`` (the default) skips this second rule entirely." ;
        rdfs:label "specification_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns83:derive_conforms_to.returns a ns2:ReturnValue ;
        rdfs:comment "A new ``StarLayerGraph``. ``report_graph``/``specification_graph`` are read, never mutated." ;
        ns2:annotationText "StarLayerGraph" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

