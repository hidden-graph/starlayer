    ns242:test_roundtrip_result_equivalence dcterms:identifier "tests.sparql.unit.test_phase2_aggregates.test_roundtrip_result_equivalence" ;
        a ns2:Function ;
        rdfs:label "test_roundtrip_result_equivalence" ;
        ns2:calls ns242:_canon ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_aggregates.py" ;
        ns2:hasDecorator ns242:test_roundtrip_result_equivalence.decorator.0 ;
        ns2:hasParameter ns242:test_roundtrip_result_equivalence.param.query_text, ns242:test_roundtrip_result_equivalence.param.team_graph ;
        ns2:lineEnd 75 ;
        ns2:lineStart 64 ;
        ns2:signature "def test_roundtrip_result_equivalence(team_graph, query_text)" .

    ns242:test_roundtrip_result_equivalence.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('query_text', QUERIES)" ;
        ns2:position 0 .

    ns242:test_roundtrip_result_equivalence.param.query_text a ns2:Parameter ;
        rdfs:label "query_text" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns242:test_roundtrip_result_equivalence.param.team_graph a ns2:Parameter ;
        rdfs:label "team_graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns242:test_unaliased_expression_group_by_key_roundtrips dcterms:identifier "tests.sparql.unit.test_phase2_aggregates.test_unaliased_expression_group_by_key_roundtrips" ;
        a ns2:Function ;
        rdfs:comment """`GROUP BY (?age+1)` — a parenthesized, computed grouping key with no
    `AS ?var` alias — is legal per SPARQL 1.1's own grammar, but confirmed
    to crash plain, unmodified rdflib's own evaluator outright
    (`evalAggregateJoin`: "Cannot eval thing: None"), independent of this
    project entirely — see the sibling `starlayer.graph` repo's
    `docs/upstream-issues/rdflib-upstream-issues.md` Issue 9 for the full trace. Unlike
    every other query in this file, this test needs `starlayer.graph` imported
    (not just plain rdflib): the actual fix is a parse-tree patch applied
    at `import starlayer.graph` time
    (`evaluate_patches.py::patch_group_by_unaliased_expression_key`), not
    something `to_rdf.py`/`from_rdf.py`'s own generic encoder/decoder can
    or should work around on their own — see `to_rdf._encode_list`'s own
    docstring for why. Confirms the *round-trip* (not just direct
    execution) works once the patch is active: encode, decode, execute
    both, compare results.""" ;
        rdfs:label "test_unaliased_expression_group_by_key_roundtrips" ;
        ns2:calls ns242:_canon ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_aggregates.py" ;
        ns2:lineEnd 115 ;
        ns2:lineStart 78 ;
        ns2:signature "def test_unaliased_expression_group_by_key_roundtrips()" .

    ns4:pytest a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.evaluate a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.processor a ns2:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py> {
    ns97:test_rule_layers_and_run_once.py dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once" ;
        a ns2:Module ;
        rdfs:comment """sh:layer / sh:runOnce (SHACL 1.2 SPARQL Extensions section 8.2.4/8.2.6).

    pySHACL's own rule loop (``pyshacl.rules.apply_rules``) processes shapes
    *sequentially* - one shape's rules reach their own independent fixpoint,
    then the next shape's rules run, in ``shape.order`` order. The spec's layer
    model is a *global* fixpoint across every rule in a layer regardless of
    which shape it's attached to, which that per-shape loop cannot express.
    ``starlayer.shacl/validator.py::_patch_rules_apply_for_layer_and_run_once``
    replaces the loop, but only when a shapes graph actually declares
    ``sh:layer``/``sh:runOnce`` - see that function's docstring.""" ;
        rdfs:label "test_rule_layers_and_run_once" ;
        ns2:declares ns130:test_sh_order_within_a_layer_is_compared_globally_not_per_shape, ns130:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop, ns130:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes, ns130:test_cross_shape_layering_orders_by_layer_not_by_shape_order ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:importsModule ns4:rdflib, ns4:pytest .

    ns130:test_cross_shape_layering_orders_by_layer_not_by_shape_order dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_cross_shape_layering_orders_by_layer_not_by_shape_order" ;
        a ns2:Function ;
        rdfs:comment """ShapeA's rule (layer 0) must produce ex:stage1 before ShapeB's rule
    (layer 1) can produce ex:stage2 from it. ShapeA is deliberately given a
    *higher* sh:order (10) than ShapeB (0) - under pySHACL's original
    per-shape-sequential loop, shapes are processed in ascending shape.order,
    so ShapeB (order 0) would run to its own fixpoint *first*, see no
    ex:stage1 yet, produce nothing, and never be revisited once ShapeA
    (order 10) runs afterward - ex:stage2 would never appear. Only a real
    cross-shape, layer-ordered fixpoint gets this right.""" ;
        rdfs:label "test_cross_shape_layering_orders_by_layer_not_by_shape_order" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:hasReturnValue ns130:test_cross_shape_layering_orders_by_layer_not_by_shape_order.returns ;
        ns2:instantiates ns28:StarLayerGraph ;
        ns2:lineEnd 75 ;
        ns2:lineStart 25 ;
        ns2:signature "def test_cross_shape_layering_orders_by_layer_not_by_shape_order() -> None" .

    ns130:test_cross_shape_layering_orders_by_layer_not_by_shape_order.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns130:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes" ;
        a ns2:Function ;
        rdfs:comment """A rule that mints a fresh blank node every execution would, if
    (mis)treated as an ordinary iterating rule, keep producing a "new" triple
    every pass forever - hitting pySHACL's own 100-iteration cap and raising
    ReportableRuntimeError. Marking it sh:runOnce must make it fire exactly
    once and let the call succeed.""" ;
        rdfs:label "test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:hasReturnValue ns130:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes.returns ;
        ns2:instantiates ns28:StarLayerGraph ;
        ns2:lineEnd 112 ;
        ns2:lineStart 78 ;
        ns2:signature "def test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes() -> None" .

    ns130:test_run_once_rule_fires_exactly_once_despite_minting_fresh_blank_nodes.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns130:test_sh_order_within_a_layer_is_compared_globally_not_per_shape dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_sh_order_within_a_layer_is_compared_globally_not_per_shape" ;
        a ns2:Function ;
        rdfs:comment """Two run-once rules, same layer, on two different shapes: the
    precursor (sh:order 1) is on a shape with a *higher* shape.order (10)
    than the dependent rule's shape (sh:order 2 on a shape with order 0).
    Run-once rules fire exactly once, in sh:order sequence, with no
    fixpoint re-try - so if the implementation accidentally grouped/sorted
    by shape.order first (the old per-shape nesting) rather than comparing
    every rule's own sh:order globally within the layer, the dependent rule
    would run before the precursor and never see its output.""" ;
        rdfs:label "test_sh_order_within_a_layer_is_compared_globally_not_per_shape" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:hasReturnValue ns130:test_sh_order_within_a_layer_is_compared_globally_not_per_shape.returns ;
        ns2:instantiates ns28:StarLayerGraph ;
        ns2:lineEnd 168 ;
        ns2:lineStart 115 ;
        ns2:signature "def test_sh_order_within_a_layer_is_compared_globally_not_per_shape() -> None" .

    ns130:test_sh_order_within_a_layer_is_compared_globally_not_per_shape.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns130:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop dcterms:identifier "tests.shacl.integration.test_rule_layers_and_run_once.test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop" ;
        a ns2:Function ;
        rdfs:comment """No regression: a shapes graph using ordinary sh:rule with no
    sh:layer/sh:runOnce anywhere must still produce the correct result via
    pySHACL's own original per-shape loop (the patch delegates straight
    through, unmodified) - reuses the existing reach-fixpoint fixture
    already covered by test_rule_iteration.py, through apply_rules() this
    time rather than validate() directly, to exercise the actual patched
    call site.""" ;
        rdfs:label "test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop" ;
        ns2:calls ns99:load_shape ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_rule_layers_and_run_once.py" ;
        ns2:hasReturnValue ns130:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop.returns ;
        ns2:instantiates ns28:StarLayerGraph ;
        ns2:lineEnd 192 ;
        ns2:lineStart 171 ;
        ns2:signature "def test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop() -> None" .

    ns130:test_shapes_graph_without_layer_or_run_once_uses_original_pyshacl_loop.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns4:pytest a ns2:ExternalModule .

    ns4:rdflib a ns2:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_dirlang_equality.py> {
    ns111:test_dirlang_equality.py dcterms:identifier "tests.graph.unit.test_dirlang_equality" ;
        a ns2:Module ;
        rdfs:comment """The text rewrite that keeps SPARQL equality away from ``rdf:dirLangString`` on
