    ns176:TestResolveImportsSameGraphCoLocation dcterms:identifier "tests.graph.unit.test_resolve_imports.TestResolveImportsSameGraphCoLocation" ;
        a ns2:Class ;
        rdfs:comment """The real gap this exists to close, found via direct user
    observation: owl:imports isn't only used for genuinely external
    references (ontology-style, needing a loader) - two shapes-graph
    "modules" that import each other are often just loaded together
    into one single graph, with nothing external to fetch at all.
    owl_imports() scans the whole graph regardless of subject, so
    without has_import_locally(), resolve_imports() would try to call a
    loader for an IRI that's already fully present right there.""" ;
        rdfs:label "TestResolveImportsSameGraphCoLocation" ;
        ns2:declares ns176:TestResolveImportsSameGraphCoLocation.test_mixed_local_and_genuinely_external_imports, ns176:TestResolveImportsSameGraphCoLocation.test_resolve_imports_never_calls_the_loader_for_a_locally_satisfied_import, ns176:TestResolveImportsSameGraphCoLocation._co_located_graph, ns176:TestResolveImportsSameGraphCoLocation.test_resolve_imports_works_with_no_loader_at_all_when_everything_is_local, ns176:TestResolveImportsSameGraphCoLocation.test_a_locally_satisfied_modules_own_further_import_is_not_chased_either ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_resolve_imports.py" ;
        ns2:lineEnd 328 ;
        ns2:lineStart 249 .

