    ns181:test_triple_term_predicate_as_path_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_triple_term_predicate_as_path_fails" ;
        a ns2:Function ;
        rdfs:comment """A TripleTerm's own predicate must stay IRI/Variable-only - a
    property path is legal in an ordinary triple pattern's predicate slot
    but never inside a triple term (RDF 1.2's tripleTerm production
    restricts its own verb to a plain iri). Construct this directly, since
    the grammar already rejects it at parse time (only Var|iri spliced in
    for _TripleTermPredicate) - confirms the SHACL shape independently
    enforces the same restriction on a malformed graph.""" ;
        rdfs:label "test_triple_term_predicate_as_path_fails" ;
        ns2:calls ns72:prepare_query_12 ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1004 ;
