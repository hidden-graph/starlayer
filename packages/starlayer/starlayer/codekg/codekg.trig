    ns220:test_single_line_alternate_boolean_lexical_form_leaves_constraint_inactive dcterms:identifier "tests.shacl.integration.test_single_line_and_some_value.test_single_line_alternate_boolean_lexical_form_leaves_constraint_inactive" ;
        a ns2:Function ;
        rdfs:comment """Found 2026-07-31 via the W3C SHACL 1.2 test suite's uniqueLang-002
    fixture (same underlying bug, different predicate): the datatype guard
    above only checks *that* the value is xsd:boolean, then converted it via
    bool(value.value) - XSD's value-space conversion, which also accepts
    "1"^^xsd:boolean as true, alongside the canonical "true". The spec only
    ever mentions "true" for this family of on/off boolean parameters, so
    "1"^^xsd:boolean (a distinct term, even though value-equal) must leave
    the constraint inactive, not silently enable it - now compared via exact
    lexical form instead. Needs format="turtle12" specifically: plain
    "turtle" parsing already normalizes "1"^^xsd:boolean to "true" before
    starlayer.shacl ever sees the literal (rdflib's own Literal()
    constructor default), so only an RDF-1.2 ("turtle12") document, whose
    parser deliberately preserves the non-canonical lexical form (see
    docs/starlayergraph-upstream-change-log.md's 2026-07-31 entry), can actually
    exercise this distinction - matching how the real W3C fixture is loaded.""" ;
        rdfs:label "test_single_line_alternate_boolean_lexical_form_leaves_constraint_inactive" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_single_line_and_some_value.py" ;
        ns2:hasReturnValue ns220:test_single_line_alternate_boolean_lexical_form_leaves_constraint_inactive.returns ;
        ns2:instantiates ns28:StarLayerGraph ;
        ns2:lineEnd 133 ;
        ns2:lineStart 94 ;
        ns2:signature "def test_single_line_alternate_boolean_lexical_form_leaves_constraint_inactive() -> None" .

    ns220:test_single_line_alternate_boolean_lexical_form_leaves_constraint_inactive.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns220:test_single_line_conforms_and_allows_explicit_multiline_opt_out dcterms:identifier "tests.shacl.integration.test_single_line_and_some_value.test_single_line_conforms_and_allows_explicit_multiline_opt_out" ;
