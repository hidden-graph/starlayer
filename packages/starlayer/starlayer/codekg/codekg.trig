GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/query/sparql_api.py> {
    ns33:sparql_api.py dcterms:identifier "starlayer.graph.query.sparql_api" ;
        a ns2:Module ;
        rdfs:comment """StarLayer-aware wrappers for rdflib SPARQL parse/prepare functions.

    These wrappers accept SPARQL 1.2 syntax and return the same rdflib types
    the originals do. All four go through ``starlayer.sparql``'s real
    grammar/algebra pipeline (``parse12.py``/``lower_rdf11.py``) rather than
    text-level rewriting:

      - ``parseQuery``/``parseUpdate`` return a raw parse tree (same shape
        ``rdflib.plugins.sparql.parser.parseQuery``/``parseUpdate`` return),
        via ``starlayer.sparql.parse12.parse_query_12``/``parse_update_12`` -
        genuine ``TripleTermNode`` nodes appear directly in triple-pattern
        position, constructed by the grammar itself, not detected and
        reassembled after the fact from an encoding pattern. ``TripleTermNode``
        is a ``CompValue`` subclass named ``'TripleTerm'`` with
        ``subject``/``predicate``/``object`` keys - the exact shape this
        module's own callers already expect.
      - ``prepareQuery``/``prepareUpdate`` return a compiled, directly
        executable ``Query``/``Update`` object whose algebra is already
        lowered to plain SPARQL 1.1 (``starlayer.sparql.lower_rdf11``'s
        ``query_to_rdf11``/``update_to_rdf11`` + ``rdf11_to_query``/
        ``rdf11_to_update``) - same contract as before ("the compiled algebra
        is SPARQL 1.1; the rewriting is transparent at execution time"), just
        produced by parsing+lowering the real algebra tree instead of
        rewriting text.

    Use these instead of the rdflib originals when working with SPARQL 1.2 queries::

        from starlayer.graph.query import parseQuery, prepareQuery, parseUpdate, prepareUpdate

        # All of these now accept SPARQL 1.2 triple-term syntax
        parseQuery("SELECT ?s WHERE { <<( ?s ?p ?o )>> ex:certainty ?c }")
        prepareQuery("SELECT ?s WHERE { <<( ?s ?p ?o )>> ex:certainty ?c }")
        parseUpdate("DELETE WHERE { <<( ?s ?p ?o )>> ?pred ?val }")
        prepareUpdate("DELETE WHERE { <<( ?s ?p ?o )>> ?pred ?val }")""" ;
        rdfs:label "sparql_api" ;
        ns2:declares ns42:processUpdate, ns42:prepareQuery, ns42:parseUpdate, ns42:parseQuery, ns42:prepareUpdate, ns42:_check_version_conformance ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:importsModule ns4:typing, ns4:__future__, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib.plugins.sparql.parserutils, ns4:pyparsing .

    ns42:_check_version_conformance dcterms:identifier "starlayer.graph.query.sparql_api._check_version_conformance" ;
        a ns2:Function ;
        rdfs:label "_check_version_conformance" ;
        ns2:calls ns3:check_version_conformance, ns41:contains_triple_term ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:_check_version_conformance.param.stripped_text, ns42:_check_version_conformance.param.context, ns42:_check_version_conformance.param.declared_version, ns42:_check_version_conformance.param.tree ;
        ns2:isPrivate true ;
        ns2:lineEnd 59 ;
        ns2:lineStart 47 ;
        ns2:signature "def _check_version_conformance(declared_version, stripped_text, tree, context)" .

    ns42:_check_version_conformance.param.context a ns2:Parameter ;
        rdfs:label "context" ;
        ns2:parameterKind "positional" ;
        ns2:position 3 .

    ns42:_check_version_conformance.param.declared_version a ns2:Parameter ;
        rdfs:label "declared_version" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:_check_version_conformance.param.stripped_text a ns2:Parameter ;
        rdfs:label "stripped_text" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns42:_check_version_conformance.param.tree a ns2:Parameter ;
        rdfs:label "tree" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns42:parseQuery dcterms:identifier "starlayer.graph.query.sparql_api.parseQuery" ;
        a ns2:Function ;
        rdfs:comment """Parse a SPARQL 1.2 SELECT/ASK/CONSTRUCT/DESCRIBE query string.

    A leading ``VERSION "label"`` prologue directive (SPARQL 1.2 Query sec
    4.3) is stripped first - not real SPARQL grammar at all, same handling
    ``StarLayerGraph.query()`` already gives it (see
    ``version_directive.py``'s own module docstring).""" ;
        rdfs:label "parseQuery" ;
        ns2:calls ns72:parse_query_12, ns42:_check_version_conformance, ns41:strip_version_directive ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:parseQuery.param.q ;
        ns2:hasReturnValue ns42:parseQuery.returns ;
        ns2:lineEnd 86 ;
        ns2:lineStart 62 ;
        ns2:signature "def parseQuery(q: str) -> ParseResults" .

    ns42:parseQuery.param.q a ns2:Parameter ;
        rdfs:comment "The SPARQL 1.2 query string to parse." ;
        rdfs:label "q" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:parseQuery.returns a ns2:ReturnValue ;
        rdfs:comment "A pyparsing ``ParseResults`` tree — same type as ``rdflib.plugins.sparql.parser.parseQuery`` — with genuine ``TripleTermNode`` nodes wherever ``<<( s p o )>>``/ ``TRIPLE(s, p, o)`` appears, constructed directly by the grammar (see module docstring), not reassembled from a text-level encoding." ;
        ns2:annotationText "ParseResults" ;
        ns2:hasType ns4:pyparsing.results.ParseResults .

    ns42:parseUpdate dcterms:identifier "starlayer.graph.query.sparql_api.parseUpdate" ;
        a ns2:Function ;
        rdfs:comment """Parse a SPARQL 1.2 Update request string.

    A leading ``VERSION "label"`` directive is stripped first - see
    ``parseQuery``'s own docstring.""" ;
        rdfs:label "parseUpdate" ;
        ns2:calls ns41:strip_version_directive, ns42:_check_version_conformance, ns72:parse_update_12 ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:parseUpdate.param.q ;
        ns2:hasReturnValue ns42:parseUpdate.returns ;
        ns2:lineEnd 140 ;
        ns2:lineStart 120 ;
        ns2:signature "def parseUpdate(q: str) -> CompValue" .

    ns42:parseUpdate.param.q a ns2:Parameter ;
        rdfs:comment "The SPARQL 1.2 update request string to parse." ;
        rdfs:label "q" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:parseUpdate.returns a ns2:ReturnValue ;
        rdfs:comment "An rdflib ``CompValue`` — same type as ``rdflib.plugins.sparql.parser.parseUpdate`` — with genuine ``TripleTermNode`` nodes preserved (same strategy as ``parseQuery``)." ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue .

    ns42:prepareQuery dcterms:identifier "starlayer.graph.query.sparql_api.prepareQuery" ;
        a ns2:Function ;
        rdfs:comment """Parse and translate a SPARQL 1.2 query string to an rdflib ``Query`` object.

    The compiled algebra is plain SPARQL 1.1 (triple terms lowered to
    starlayer.graph's own ``tt:`` content-addressed encoding); the lowering is
    transparent at execution time.

    A leading ``VERSION "label"`` directive is stripped first - see
    ``parseQuery``'s own docstring.""" ;
        rdfs:label "prepareQuery" ;
        ns2:calls ns41:strip_version_directive, ns72:prepare_query_12, ns42:_check_version_conformance, ns71:rdf11_to_query, ns71:query_to_rdf11 ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:prepareQuery.param.queryString, ns42:prepareQuery.param.base, ns42:prepareQuery.param.initNs ;
        ns2:hasReturnValue ns42:prepareQuery.returns ;
        ns2:lineEnd 117 ;
        ns2:lineStart 89 ;
        ns2:signature "def prepareQuery(queryString: str, initNs=None, base=None) -> Query" .

    ns42:prepareQuery.param.base a ns2:Parameter ;
        rdfs:comment "Optional base IRI for relative-IRI resolution." ;
        rdfs:label "base" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns42:prepareQuery.param.initNs a ns2:Parameter ;
        rdfs:comment "Optional namespace prefix bindings, as accepted by ``rdflib.plugins.sparql.prepareQuery``." ;
        rdfs:label "initNs" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns42:prepareQuery.param.queryString a ns2:Parameter ;
        rdfs:comment "The SPARQL 1.2 query string to parse and compile." ;
        rdfs:label "queryString" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:prepareQuery.returns a ns2:ReturnValue ;
        rdfs:comment "A compiled, directly executable ``Query`` object, usable with ``StarLayerGraph.query()`` or ``rdflib.Graph.query()``." ;
        ns2:annotationText "Query" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Query .

    ns42:prepareUpdate dcterms:identifier "starlayer.graph.query.sparql_api.prepareUpdate" ;
        a ns2:Function ;
        rdfs:comment """Parse and translate a SPARQL 1.2 Update request string to an rdflib ``Update`` object.

    The compiled form is plain SPARQL 1.1, same lowering as ``prepareQuery``.

    A leading ``VERSION "label"`` directive is stripped first - see
    ``parseQuery``'s own docstring.""" ;
        rdfs:label "prepareUpdate" ;
        ns2:calls ns72:prepare_update_12, ns42:_check_version_conformance, ns71:rdf11_to_update, ns41:strip_version_directive, ns71:update_to_rdf11 ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:prepareUpdate.param.updateString, ns42:prepareUpdate.param.initNs, ns42:prepareUpdate.param.base ;
        ns2:hasReturnValue ns42:prepareUpdate.returns ;
        ns2:lineEnd 170 ;
        ns2:lineStart 143 ;
        ns2:signature "def prepareUpdate(updateString: str, initNs=None, base=None) -> Update" .

    ns42:prepareUpdate.param.base a ns2:Parameter ;
        rdfs:comment "Optional base IRI for relative-IRI resolution." ;
        rdfs:label "base" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns42:prepareUpdate.param.initNs a ns2:Parameter ;
        rdfs:comment "Optional namespace prefix bindings, as accepted by ``rdflib.plugins.sparql.prepareUpdate``." ;
        rdfs:label "initNs" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns42:prepareUpdate.param.updateString a ns2:Parameter ;
        rdfs:comment "The SPARQL 1.2 update request string to parse and compile." ;
        rdfs:label "updateString" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:prepareUpdate.returns a ns2:ReturnValue ;
        rdfs:comment "A compiled, directly executable ``Update`` object, usable with ``StarLayerGraph.update()`` or ``rdflib.Graph.update()``." ;
        ns2:annotationText "Update" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Update .

    ns42:processUpdate dcterms:identifier "starlayer.graph.query.sparql_api.processUpdate" ;
        a ns2:Function ;
        rdfs:comment """Execute a SPARQL 1.2 Update against a graph.

    This is the SPARQL 1.2-aware replacement for
    ``rdflib.plugins.sparql.processUpdate``. The rdflib original calls
    ``parseUpdate()`` directly, bypassing any ``graph.update()`` override.

    For ``StarLayerGraph``/``StarLayerDataset`` instances, this delegates
    the *original* SPARQL 1.2 text straight to ``graph.update()`` so that
    graph's own full update pipeline runs unmodified (registry rebuild,
    ``_invalidate_callback``, native-backend routing, INSERT/DELETE
    template-position triple-term handling — all of which is specific to
    those classes' own ``.update()``, not something to reimplement or
    bypass here). For a plain ``rdflib.Graph`` (which has no notion of
    SPARQL 1.2 syntax at all), ``updateString`` is first compiled via this
    module's own ``prepareUpdate`` into a directly executable, already-
    SPARQL-1.1 ``Update`` object, then handed to ``graph.update()`` — the
    same general entry point, not the more narrowly-typed
    ``rdflib.plugins.sparql.processUpdate`` function, since ``Graph.update()``
    already accepts a prepared object or text uniformly.

    Checks via attribute (``_tt_registry``/``_sg_cache``) rather than
    ``isinstance`` to avoid a circular import.""" ;
        rdfs:label "processUpdate" ;
        ns2:calls ns42:prepareUpdate ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:processUpdate.param.graph, ns42:processUpdate.param.updateString, ns42:processUpdate.param.base, ns42:processUpdate.param.initBindings, ns42:processUpdate.param.initNs ;
        ns2:hasReturnValue ns42:processUpdate.returns ;
        ns2:lineEnd 220 ;
        ns2:lineStart 173 ;
        ns2:signature "def processUpdate(graph, updateString: str, initBindings=None, initNs=None, base=None) -> None" .

    ns42:processUpdate.param.base a ns2:Parameter ;
        rdfs:comment "Optional base IRI for relative-IRI resolution." ;
        rdfs:label "base" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 4 .

    ns42:processUpdate.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to update - a ``StarLayerGraph``/ ``StarLayerDataset`` or a plain ``rdflib.Graph``." ;
        rdfs:label "graph" ;
