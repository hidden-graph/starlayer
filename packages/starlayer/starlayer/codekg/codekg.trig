    ns167:TestValidateSpecificationGraphParameter dcterms:identifier "tests.shacl.integration.test_used_graphs_and_configuration.TestValidateSpecificationGraphParameter" ;
        a ns2:Class ;
        rdfs:comment """specification_graph= is deliberately *not* a StarShaclSchema
    construction-time property or a validate() parameter - it was
    briefly both (2026-10-10), reverted the same day: "what specification
    does this data conform to" is a publishing decision about the result,
    not an intrinsic fact about how to validate (unlike shacl_graph/
    ont_graph/inference), so binding it at construction would make every
    validate() call on one schema instance always assert the same
    external-spec claim whether or not that caller wanted it. The real,
    supported path is calling shacl_profiling.derive_conforms_to()
    explicitly, after validate() returns - see its own module docstring.
    sh:conformsTo (S5.5's first rule) is unaffected either way; it never
    depended on specification_graph. The bare module-level validate()
    function still keeps its own per-call specification_graph= - it has
    no "schema" object for this reasoning to apply to.""" ;
        rdfs:label "TestValidateSpecificationGraphParameter" ;
        ns2:declares ns167:TestValidateSpecificationGraphParameter._specification_graph, ns167:TestValidateSpecificationGraphParameter.test_explicit_derive_conforms_to_after_validate_derives_dcterms_conforms_to, ns167:TestValidateSpecificationGraphParameter.test_bare_validate_function_also_accepts_specification_graph, ns167:TestValidateSpecificationGraphParameter.test_no_specification_graph_only_sh_conforms_to_as_before, ns167:TestValidateSpecificationGraphParameter.test_schema_rejects_specification_graph_as_a_construction_kwarg ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_used_graphs_and_configuration.py" ;
        ns2:lineEnd 383 ;
        ns2:lineStart 302 .

