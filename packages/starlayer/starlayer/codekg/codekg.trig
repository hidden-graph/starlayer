        ns2:calls ns194:_encode_data_prop_range, ns92:manchester_validate ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py" ;
        ns2:lineEnd 112 ;
        ns2:lineStart 97 ;
        ns2:signature "def test_broken_mid_chain_rdf_list_fails()" .

    ns194:test_misc_axiom_item_of_wrong_family_fails dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes.test_misc_axiom_item_of_wrong_family_fails" ;
        a ns2:Function ;
        rdfs:comment """A MiscEquivalentClassesAxiom's items must each be a manch:ClassExpression
    (or a bare IRI) - substituting a manch:PropertyExpression-typed node (the
    wrong family entirely) must be caught, even though MiscAxiom items are
    bare values with no ClauseItem wrapper to hang a value-kind check off of
    (see manch:ClassExpressionListShape, reused directly here).""" ;
        rdfs:label "test_misc_axiom_item_of_wrong_family_fails" ;
        ns2:calls ns92:manchester_parse_to_tree, ns92:manchester_validate ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py" ;
        ns2:lineEnd 94 ;
        ns2:lineStart 73 ;
        ns2:signature "def test_misc_axiom_item_of_wrong_family_fails()" .

    ns194:test_shapes_graph_is_valid_shacl_and_reusable dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes.test_shapes_graph_is_valid_shacl_and_reusable" ;
        a ns2:Function ;
