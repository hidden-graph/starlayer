GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/integration/test_oxigraph_store_rdf12.py> {
    ns155:test_oxigraph_store_rdf12.py dcterms:identifier "tests.graph.integration.test_oxigraph_store_rdf12" ;
        a ns2:Module ;
        rdfs:comment """tests/graph/integration/test_oxigraph_store_rdf12.py

    StarLayerGraph/StarLayerDataset backed by oxrdflib's standard OxigraphStore
    (an in-process pyoxigraph engine) in rdf-1.2 native mode - real triple terms
    and SPARQL 1.2, no HTTP. See starlayer.graph.backends.native_oxigraph.

    The store is chosen explicitly at construction (store=..., backend='rdf-1.2');
    nothing here relies on, or sets, a global default. No live server needed, so
    no pytest.mark.integration.

    Requires: pip install oxrdflib pyoxigraph""" ;
        rdfs:label "test_oxigraph_store_rdf12" ;
        ns2:declares ns300:TestEmbeddedCloseReopen, ns300:TestQueryConstructIsCreatedLikeTheSource, ns300:TestDirLangStringEquality, ns300:sg, ns300:TestEmbeddedTurtle12Parse, ns300:TestEmbeddedBoundBnodeQuery, ns300:_is_oxigraph_backed, ns300:_oxigraph_graph, ns300:TestEmbeddedLen, ns300:TestPlainTupleIsATripleTerm, ns300:embedded_oxigraph_store, ns300:TestEmbeddedRoundTrip, ns300:TestDirLangStringEqualityGuard, ns300:TestEmptyLike, ns300:TestInferIsCreatedLikeTheSource, ns300:TestBoundBlankNodeLookups ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_store_rdf12.py" ;
        ns2:importsModule ns4:pytest, ns4:rdflib, ns4:os .

    ns300:TestBoundBlankNodeLookups dcterms:identifier "tests.graph.integration.test_oxigraph_store_rdf12.TestBoundBlankNodeLookups" ;
        a ns2:Class ;
