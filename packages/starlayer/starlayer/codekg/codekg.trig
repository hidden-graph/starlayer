        ns2:hasReturnValue ns82:_meta_validate_cache_key.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 115 ;
        ns2:lineStart 58 ;
        ns2:signature "def _meta_validate_cache_key(shapes_graph_for_meta: Any, kwargs: dict) -> tuple | None" .

