        ns2:hasType ns4:typing.Any, ns4:collections.abc.Iterable ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns82:load_meta_shapes_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph .

