        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:parseUpdate.returns a ns2:ReturnValue ;
        rdfs:comment "An rdflib ``CompValue`` — same type as ``rdflib.plugins.sparql.parser.parseUpdate`` — with genuine ``TripleTermNode`` nodes preserved (same strategy as ``parseQuery``)." ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue .

    ns42:prepareQuery dcterms:identifier "starlayer.graph.query.sparql_api.prepareQuery" ;
        a ns2:Function ;
        rdfs:comment """Parse and translate a SPARQL 1.2 query string to an rdflib ``Query`` object.

    The compiled algebra is plain SPARQL 1.1 (triple terms lowered to
    starlayer.graph's own ``tt:`` content-addressed encoding); the lowering is
    transparent at execution time.

    A leading ``VERSION "label"`` directive is stripped first - see
    ``parseQuery``'s own docstring.""" ;
        rdfs:label "prepareQuery" ;
        ns2:calls ns71:query_to_rdf11, ns71:rdf11_to_query, ns42:_check_version_conformance, ns72:prepare_query_12, ns41:strip_version_directive ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:prepareQuery.param.base, ns42:prepareQuery.param.queryString, ns42:prepareQuery.param.initNs ;
        ns2:hasReturnValue ns42:prepareQuery.returns ;
        ns2:lineEnd 117 ;
        ns2:lineStart 89 ;
        ns2:signature "def prepareQuery(queryString: str, initNs=None, base=None) -> Query" .

    ns42:prepareQuery.param.base a ns2:Parameter ;
        rdfs:comment "Optional base IRI for relative-IRI resolution." ;
        rdfs:label "base" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns42:prepareQuery.param.initNs a ns2:Parameter ;
        rdfs:comment "Optional namespace prefix bindings, as accepted by ``rdflib.plugins.sparql.prepareQuery``." ;
        rdfs:label "initNs" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns42:prepareQuery.param.queryString a ns2:Parameter ;
