        rdfs:comment "The graph to use from here on - ``data_graph`` itself if ``inplace``, otherwise a new graph." ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any .

    ns85:apply_entailment dcterms:identifier "starlayer.shacl.entailment.apply_entailment" ;
        a ns2:Function ;
        rdfs:comment """Materialize ``shacl_graph``'s own declared ``sh:entailment``
    regime(s) over ``data_graph`` (and ``ont_graph``, if given - see
    ``_apply_entailment_regimes``'s own docstring for exactly how), merged
    with whatever ``inference`` contributes, and return the graph to use
    from here on - which is ``data_graph`` itself only when
    ``inplace=True``.

    A no-op (returns ``data_graph`` unchanged, same object either way)
    when ``shacl_graph`` declares no ``sh:entailment`` and ``inference``
    is ``None`` - the overwhelmingly common case. ``shacl_graph`` may
    itself be ``None`` (contributes no declared regimes, same as an empty
    shapes graph).""" ;
        rdfs:label "apply_entailment" ;
        ns2:calls ns85:declared_entailment_regimes, ns85:_apply_entailment_regimes ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/entailment.py" ;
        ns2:hasParameter ns85:apply_entailment.param.data_graph, ns85:apply_entailment.param.inference, ns85:apply_entailment.param.shacl_graph, ns85:apply_entailment.param.ont_graph, ns85:apply_entailment.param.inplace ;
