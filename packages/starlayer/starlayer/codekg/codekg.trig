    ns92:manchester_validate dcterms:identifier "starlayer.starontology.manchester.manchester_validate" ;
        a ns2:Function ;
        rdfs:comment """Validate ``data_graph`` against the shapes in
    ``manchester_shapes.ttl``. Which shapes to check against is this
    module's own, fixed concern, not a parameter.

    Runs with RDFS reasoning enabled (``ont_graph=get_ontology_graph(
    "manchester_owl")``, ``inference="rdfs"``) - this is what lets the
    dispatch shapes (``ClassExpressionShape``/``PropertyExpressionShape``/
    ``DataRangeShape``/``FrameShape``/``ClauseShape``/``MiscAxiomShape``) be
    a single ``sh:class`` check against an abstract superclass instead of
    enumerating every concrete tag by name, the same reasoning ``salg:``'s
    own shapes use for SPARQL.

    No public ``ontology_graph()``/``shapes_graph()`` here - get those
    two graphs directly from ``starontology`` instead:
    ``get_ontology_graph("manchester_owl")`` /
    ``get_ontology_graph("manchester_shacl")``. This function needs no
    combining logic the way ``starlayer.sparql.srl.srl_validate()`` does for
    ``srl:``+``salg:``, so there was nothing worth wrapping here even
    privately.

    Goes through ``starlayer.shacl.validate()``, never bare ``pyshacl`` -
    this validates a caller-supplied ``data_graph`` that may be genuine
    RDF 1.2 content, which only ``starlayer.shacl`` understands correctly.

    Before SHACL runs, a pre-flight check looks at the graph as asserted (see ``_preflight``): inference
    would otherwise repair a missing ``rdf:type`` from a property's ``rdfs:domain`` and hide a tree the
    decoder cannot read. Its findings are merged into the returned report.""" ;
        rdfs:label "manchester_validate" ;
        ns2:calls ns92:_preflight_text, ns92:_preflight, ns92:_preflight_report ;
        ns2:filePath "packages/starlayer/starlayer/starontology/manchester.py" ;
        ns2:hasParameter ns92:manchester_validate.param.data_graph ;
        ns2:hasReturnValue ns92:manchester_validate.returns ;
        ns2:lineEnd 1247 ;
        ns2:lineStart 1182 ;
        ns2:signature "def manchester_validate(data_graph: Graph) -> tuple[bool, Graph, str]" .

    ns92:manchester_validate.param.data_graph a ns2:Parameter ;
        rdfs:comment "The ``manch:`` syntax tree to validate - e.g. straight out of ``manchester_parse_to_tree()``, or an LLM-authored ``manch:`` graph not yet decoded." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns92:manchester_validate.returns a ns2:ReturnValue ;
        rdfs:comment "``(conforms, results_graph, results_text)``, unpacked from ``starlayer.shacl``'s own ``ValidationResult``." ;
        ns2:annotationText "tuple[bool, Graph, str]" ;
        ns2:hasType ns4:rdflib.graph.Graph, ns4:builtins.tuple, ns4:builtins.bool, ns4:builtins.str .

