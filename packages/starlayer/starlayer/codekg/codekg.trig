    ns14:_Expander._resolve_qt_slot.param.val a ns2:Parameter ;
        rdfs:comment "The subject/object token to resolve - may be plain, a reifier-shorthand << >> token, or a ground <<( )>> triple term." ;
        rdfs:label "val" ;
