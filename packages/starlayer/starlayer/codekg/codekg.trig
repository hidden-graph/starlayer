    ns87:extract_subgraph.param.shacl_graph a ns2:Parameter ;
        rdfs:comment "The shapes graph. Defaults to ``data_graph``." ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
