    ns75:apply_rules.returns a ns2:ReturnValue ;
        rdfs:comment "A ``RulesResult`` with two fields: ``inferred_graph`` - strictly the triples rule execution itself produced (shape-attached and global rules, plus any ``sh:sourceRule`` provenance reifiers); neither the original base triples nor anything any entailment regime added are included, since entailment is purely a computational device here, never persisted. ``validation`` - the full ``ValidationResult`` from the final re-validation pass, whose ``conforms``/ ``report_graph``/``report_text`` reflect the complete evaluation graph (base ∪ rules ∪ entailment); its own ``data_graph`` field is always ``None`` in this context (the internal call uses the ``\"validation\"`` mode's own ``inplace=False`` default)." ;
        ns2:annotationText "RulesResult" ;
        ns2:hasType ns4:starlayer.shacl.results.RulesResult .

    ns75:evaluate dcterms:identifier "starlayer.shacl.validator.evaluate" ;
        a ns2:Function ;
        rdfs:comment """Computes every ``sh:values``/``sh:defaultValue``-declared virtual
    property across ``shacl_graph`` and returns the result as a
    shape-driven subgraph.

    A third, independent processing mode alongside ``validate()``
    (checks conformance, never mutates) and ``apply_rules()`` (executes
    ``sh:rule``, materializes real triples). ``StarShaclSchema.evaluate()``
    keeps its own, separate copy of this body for now - see
    ``validate()``'s own docstring.

    The returned graph contains every property shape's real, stored
    ``sh:path`` values for its own target focus nodes (not just the
    ones also declaring ``sh:values``/``sh:defaultValue``), plus the
    computed virtual values layered on top - never the whole of
    ``data_graph``. Only a property shape's simple, single-predicate
    ``sh:path`` is handled; a property path expression (sequence/
    inverse/etc.) is silently skipped. A computed value is unioned
    with any real, already-stored value for the same predicate, never
    replacing it (SHACL 1.2 Core's "Value Nodes of Property Shapes"
    algorithm unconditionally adds both real path-based values and
    ``sh:values``-computed values to the same set; only
    ``sh:defaultValue`` is conditional, on that set still being empty).
    The caller's own ``data_graph`` is never mutated, and the returned
    graph is not meant to be persisted - the SHACL 1.2 Node Expressions
    spec's own framing for virtual values is that they are computed
    "only on demand", never creating real triples in the data or
    shapes graph.""" ;
        rdfs:label "evaluate" ;
        ns2:calls ns75:_shape_target_nodes, ns75:_compute_sh_values, ns85:apply_entailment, ns75:_augment_shapes_with_new_target_types, ns75:_compute_sh_default_value ;
        ns2:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
        ns2:hasParameter ns75:evaluate.param.shacl_graph, ns75:evaluate.param.data_graph, ns75:evaluate.param.ont_graph, ns75:evaluate.param.inference ;
        ns2:hasReturnValue ns75:evaluate.returns ;
        ns2:lineEnd 3712 ;
        ns2:lineStart 3588 ;
        ns2:signature "def evaluate(data_graph: Any, shacl_graph: Any | None=None, ont_graph: Any | None=None, *, inference: Any | None=None) -> Any" .

    ns75:evaluate.param.data_graph a ns2:Parameter ;
        rdfs:comment "The RDF data to evaluate virtual properties over." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns75:evaluate.param.inference a ns2:Parameter ;
        rdfs:comment "A real ``ENTAILMENT.*`` IRI, or an iterable of them, merged with ``shacl_graph``'s own declared ``sh:entailment`` regime(s) and applied once, up front, onto a private, non-mutating copy of ``data_graph``. Every later step (target resolution, ``sh:values``/ ``sh:defaultValue`` computation, and what counts as a \"real, stored\" value) runs against that entailed copy. Unlike ``apply_rules()``'s \"inference graph\" exclusion, an entailed triple here is treated exactly like an asserted one and can appear in the returned subgraph - a deliberate choice, since Core's own value-nodes algorithm itself never distinguishes asserted from entailed triples." ;
        rdfs:label "inference" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns75:evaluate.param.ont_graph a ns2:Parameter ;
        rdfs:comment "An optional ontology graph, visible to entailment the same way as in ``validate()``/``apply_rules()``." ;
        rdfs:label "ont_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns75:evaluate.param.shacl_graph a ns2:Parameter ;
        rdfs:comment "The shapes graph declaring ``sh:values``/ ``sh:defaultValue``. ``None`` falls back to ``data_graph`` itself, matching ``validate()``'s own \"data graph doubles as shapes graph\" allowance." ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

