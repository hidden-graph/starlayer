    ns76:_build_member_shape_component.MemberShapeConstraintComponent dcterms:identifier "starlayer.shacl.native_components._build_member_shape_component.MemberShapeConstraintComponent" ;
        a ns2:Class ;
        rdfs:comment """``sh:memberShape``: each value node must be a well-formed SHACL
    list, or that alone is a violation; otherwise every member of the
    list must conform to the given shape.

    Reporting shape matches the SHACL 1.2 Core spec's own convention:
    one violation per non-conforming *member*, each blaming the whole
    list as the value node (not the individual member).""" ;
        rdfs:label "MemberShapeConstraintComponent" ;
