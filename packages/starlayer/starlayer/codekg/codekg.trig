        ns2:position 0 .

    ns18:split_statements.returns a ns2:ReturnValue ;
        rdfs:comment "A list of statement strings (prefix/base/version directives and triple statements), each stripped of surrounding whitespace." .

    ns18:split_statements_with_lines dcterms:identifier "starlayer.graph.parsers.syntax.split_statements_with_lines" ;
        a ns2:Function ;
