    ns236:TestBnodeListInTripleTerm dcterms:identifier "tests.graph.unit.test_turtle_parser.TestBnodeListInTripleTerm" ;
        a ns2:Class ;
        rdfs:comment """RDF 1.2 grammar: ttSubject/rtSubject/ttObject/rtObject all admit
    `BlankNode`, which is BLANK_NODE_LABEL or ANON (a bare `_:label` or an
    *empty* `[]`) - never a blankNodePropertyList carrying its own
    properties. Confirmed directly against the W3C RDF 1.2 Turtle syntax
    test suite (turtle12-bad-7, "compound blank node expression", a
    TestTurtleNegativeSyntax case - see tests/w3c_turtle12/).

    An earlier version of this parser instead silently *expanded* a
    non-empty `[ ... ]` here (a bug fix for a different problem: it used to
    produce a garbage URIRef from the raw bracket text) - that was more
    lenient than the grammar actually allows. Both the acceptance below
    (empty `[]`) and the rejection (non-empty) are asserted here.""" ;
        rdfs:label "TestBnodeListInTripleTerm" ;
        ns2:declares ns236:TestBnodeListInTripleTerm.test_bnode_with_properties_in_object_position_rejected, ns236:TestBnodeListInTripleTerm.test_bnode_with_properties_in_subject_position_rejected, ns236:TestBnodeListInTripleTerm.test_empty_bnode_in_subject_position_accepted, ns236:TestBnodeListInTripleTerm.test_bnode_with_properties_in_reification_shorthand_rejected, ns236:TestBnodeListInTripleTerm.test_empty_bnode_in_object_position_accepted ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser.py" ;
        ns2:lineEnd 343 ;
        ns2:lineStart 291 .

    ns236:TestBnodeListInTripleTerm.test_bnode_with_properties_in_object_position_rejected dcterms:identifier "tests.graph.unit.test_turtle_parser.TestBnodeListInTripleTerm.test_bnode_with_properties_in_object_position_rejected" ;
