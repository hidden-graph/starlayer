GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/parse12.py> {
    ns48:parse12.py dcterms:identifier "starlayer.sparql.parse12" ;
        a ns2:Module ;
        rdfs:comment """Public entry points for ingesting SPARQL 1.2 (triple-term) query/update
    text into a genuine, post-``translateQuery``/``translateUpdate`` algebra
    tree — see ``grammar12.py`` for how ``<<( s p o )>>``/``TRIPLE(s, p, o)``
    syntax is made parseable at all, and ``triple_term.py`` for why the
    resulting node has to be a ``TripleTermNode``, not a bare ``CompValue``.

    Because the grammar extension (``grammar12.install()``) constructs a
    ``TripleTermNode`` directly inside its parse action, the parse tree these
    functions produce never contains a plain ``CompValue('TripleTerm', ...)`` to
    promote after the fact — ``translateQuery``/``translateUpdate`` can be
    called on it immediately, completely unmodified.""" ;
        rdfs:label "parse12" ;
        ns2:declares ns72:_reject_blank_nodes_in_delete, ns72:prepare_query_12, ns72:parse_update_12, ns72:_canonicalize_construct_where, ns72:parse_query_12, ns72:prepare_update_12, ns72:_parse_with_recovery, ns72:_check_no_blank_nodes ;
        ns2:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:importsModule ns4:rdflib.plugins.sparql.parser, ns4:collections.abc, ns4:typing, ns4:__future__, ns4:rdflib, ns4:rdflib.plugins.sparql.algebra, ns4:rdflib.plugins.sparql.parserutils, ns4:pyparsing.exceptions, ns4:rdflib.plugins.sparql.sparql .

    ns72:_canonicalize_construct_where dcterms:identifier "starlayer.sparql.parse12._canonicalize_construct_where" ;
        a ns2:Function ;
        rdfs:comment """``CONSTRUCT WHERE { pattern }`` shorthand (the template IS the WHERE
    pattern) reaches here with ``algebra.template`` set to ``None`` — plain,
    unmodified ``rdflib.plugins.sparql.algebra.translateQuery`` behavior,
    not something this project's own grammar/algebra work introduced.
    ``pattern`` itself is required by the SPARQL grammar (``ConstructWhere``
    — a plain ``TriplesTemplate``, no FILTER/OPTIONAL/UNION/etc permitted)
    to be exactly a flat BGP, so ``algebra.p.p.triples`` is always exactly
    the triple list needed.

    Populating ``template`` explicitly here — the *canonical*, always-
    explicit-template form of a CONSTRUCT query — rather than leaving the
    ``None``/"use the WHERE clause" convention for downstream code to
    rediscover is a deliberate simplification, not merely a serialization
    workaround: this project's own RDF encoding of the algebra
    (``to_rdf.py``) has no special "template is really the WHERE clause"
    convention of its own, so leaving ``template=None`` here would mean that
    information is silently lost the moment the algebra is encoded to RDF —
    the query would regenerate as ``CONSTRUCT {}`` (a literal, always-
    empty-result template), a real semantic mistranslation, not just lost
    shorthand syntax. Regenerating the *shorthand* ``CONSTRUCT WHERE``
    spelling specifically (as opposed to an equivalent explicit
    ``CONSTRUCT { ... } WHERE { ... }``) is explicitly out of scope for
    now, per instruction - only the meaning needs to survive, not the
    original surface syntax.""" ;
        rdfs:label "_canonicalize_construct_where" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:hasParameter ns72:_canonicalize_construct_where.param.query ;
        ns2:hasReturnValue ns72:_canonicalize_construct_where.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 122 ;
        ns2:lineStart 81 ;
        ns2:signature "def _canonicalize_construct_where(query: Query) -> Query" .

    ns72:_canonicalize_construct_where.param.query a ns2:Parameter ;
        rdfs:label "query" ;
        ns2:annotationText "Query" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Query ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns72:_canonicalize_construct_where.returns a ns2:ReturnValue ;
        ns2:annotationText "Query" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Query .

    ns72:_check_no_blank_nodes dcterms:identifier "starlayer.sparql.parse12._check_no_blank_nodes" ;
        a ns2:Function ;
        rdfs:label "_check_no_blank_nodes" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:hasParameter ns72:_check_no_blank_nodes.param.triples, ns72:_check_no_blank_nodes.param.quads, ns72:_check_no_blank_nodes.param.context ;
        ns2:hasReturnValue ns72:_check_no_blank_nodes.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 227 ;
        ns2:lineStart 217 ;
        ns2:signature "def _check_no_blank_nodes(triples, quads, context: str) -> None" .

    ns72:_check_no_blank_nodes.param.context a ns2:Parameter ;
        rdfs:label "context" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns72:_check_no_blank_nodes.param.quads a ns2:Parameter ;
        rdfs:label "quads" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns72:_check_no_blank_nodes.param.triples a ns2:Parameter ;
        rdfs:label "triples" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns72:_check_no_blank_nodes.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns72:_parse_with_recovery dcterms:identifier "starlayer.sparql.parse12._parse_with_recovery" ;
        a ns2:Function ;
        rdfs:comment """Shared body for ``parse_query_12``/``parse_update_12``: re-verify the
    grammar installation (cheap - see ``grammar12._already_installed``'s
    own docstring) before parsing, and if the parse still fails with a
    ``ParseBaseException`` anyway, force a full unconditional re-install
    (``grammar12.install(force=True)``) and retry exactly once before
    giving up.

    Re-verification alone isn't sufficient: some pytest runs hit a residual
    grammar corruption that ``_already_installed()``'s own live-object
    check doesn't catch (the trigger lives somewhere in pytest's import
    machinery, not reproducible via a plain script). A forced reinstall
    immediately before retrying the *same* text recovers it. If the retry
    *also* fails, that reliably means the query text itself is genuinely
    invalid syntax, not a grammar-state artifact - propagates normally, no
    third attempt.""" ;
        rdfs:label "_parse_with_recovery" ;
        ns2:calls ns73:install ;
        ns2:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:hasParameter ns72:_parse_with_recovery.param.text, ns72:_parse_with_recovery.param.parse_fn ;
        ns2:isPrivate true ;
        ns2:lineEnd 55 ;
        ns2:lineStart 33 ;
        ns2:signature "def _parse_with_recovery(parse_fn, text: str)" .

    ns72:_parse_with_recovery.param.parse_fn a ns2:Parameter ;
        rdfs:label "parse_fn" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns72:_parse_with_recovery.param.text a ns2:Parameter ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns72:_reject_blank_nodes_in_delete dcterms:identifier "starlayer.sparql.parse12._reject_blank_nodes_in_delete" ;
        a ns2:Function ;
        rdfs:comment """SPARQL Update forbids a blank node appearing in ``DELETE DATA``'s
    ``QuadData`` or in ``Modify``'s ``DELETE`` template - deleting requires
    matching a specific, already-existing term, and a blank node (whether
    written directly as ``_:x`` or minted implicitly by an anonymous
    ``{| ... |}`` annotation reifier - see ``grammar12.py``'s ``_reify``)
    can never identify one. Plain, unmodified rdflib doesn't enforce this
    syntactically either, so it's checked here, post-translate, against the
    two operation shapes that carry a delete template: ``DeleteData.triples``/
    ``.quads`` directly, and ``Modify.delete.triples``/``.quads``
    (``Modify.delete`` is ``None`` for an INSERT-only Modify, per
    ``algebra.translateUpdate1``).""" ;
        rdfs:label "_reject_blank_nodes_in_delete" ;
        ns2:calls ns72:_check_no_blank_nodes ;
        ns2:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:hasParameter ns72:_reject_blank_nodes_in_delete.param.update ;
        ns2:hasReturnValue ns72:_reject_blank_nodes_in_delete.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 214 ;
        ns2:lineStart 185 ;
        ns2:signature "def _reject_blank_nodes_in_delete(update: Update) -> Update" .

    ns72:_reject_blank_nodes_in_delete.param.update a ns2:Parameter ;
        rdfs:comment "The translated ``Update`` to check." ;
        rdfs:label "update" ;
        ns2:annotationText "Update" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Update ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns72:_reject_blank_nodes_in_delete.returns a ns2:ReturnValue ;
        rdfs:comment "``update`` unchanged, if no blank node was found in a delete template." ;
        ns2:annotationText "Update" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Update .

    ns72:parse_query_12 dcterms:identifier "starlayer.sparql.parse12.parse_query_12" ;
        a ns2:Function ;
        rdfs:comment """Parse SPARQL 1.2 query text into a parse tree with genuine
    ``TripleTermNode`` nodes wherever ``<<( s p o )>>``/``TRIPLE(s, p, o)``
    appears — rdflib's own parser, unmodified, operating on its own grammar
    objects extended in place by ``grammar12.install()``. See
    ``_parse_with_recovery`` for why this isn't just a bare ``parseQuery``
    call.""" ;
        rdfs:label "parse_query_12" ;
        ns2:calls ns299:check_parse_tree, ns299:reject_surrogate_escapes, ns72:_parse_with_recovery ;
