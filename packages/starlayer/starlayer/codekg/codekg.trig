    ns90:_SparqlAwareEncodedGraph._decode_cached dcterms:identifier "starlayer.shacl.adapters._SparqlAwareEncodedGraph._decode_cached" ;
        a ns2:Method ;
        rdfs:comment """Decode self back to a StarLayerGraph, reusing the previous
    decode if nothing has been added/removed since (tracked via
    ``_mutation_version``, bumped by ``add``/``remove``/``addN``).

    A SHACL-AF ``sh:construct`` rule under ``iterate_rules=True`` calls
    ``.query()`` once per (focus node, construct) pair *per iteration*,
    against the same unmutated graph snapshot for the whole iteration -
    pySHACL only merges newly-constructed triples in (via ``add()``)
    after every focus node has been queried for that pass. Decoding the
    full graph fresh on every single one of those calls, rather than
    once per iteration, was profiled at over half of total validation
    time for a 40-node linearly-growing chain - a real bottleneck for
    rule-heavy workloads on larger graphs that this cache avoids.""" ;
        rdfs:label "_decode_cached" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/adapters.py" ;
        ns2:hasParameter ns90:_SparqlAwareEncodedGraph._decode_cached.param.adapter ;
        ns2:hasReturnValue ns90:_SparqlAwareEncodedGraph._decode_cached.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 114 ;
        ns2:lineStart 86 ;
        ns2:signature "def _decode_cached(self, adapter: TripleTermAdapter) -> Any" .

    ns90:_SparqlAwareEncodedGraph._decode_cached.param.adapter a ns2:Parameter ;
        rdfs:comment "The adapter to decode with on a cache miss." ;
        rdfs:label "adapter" ;
        ns2:annotationText "TripleTermAdapter" ;
        ns2:hasType ns90:TripleTermAdapter ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

