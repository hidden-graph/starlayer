    ns40:patch_order_by_tt_hash_term_kind.returns a ns2:ReturnValue ;
        rdfs:comment "True if the patch applied (or was already applied), False if rdflib's internals didn't match what this shim expects." ;
        ns2:annotationText "bool" ;
