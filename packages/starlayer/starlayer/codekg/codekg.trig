    ns7:_canonicalize_numeric_literal dcterms:identifier "starlayer.graph.model.encoding._canonicalize_numeric_literal" ;
        a ns2:Function ;
        rdfs:comment """Reformat a decimal/double/float-typed Literal's lexical form to its
    XSD canonical form. A no-op for anything already canonical, or for any
    other datatype.

    decimal: canonical form requires a decimal point with at least one
    digit on each side (e.g. "42.0", not "42").
    double/float: reformats through Python's own float parsing/repr, which
    - for the ordinary (non-extreme-magnitude) range this is actually used
    for in practice - already produces XSD's own "at least one digit each
    side of a required decimal point" convention (e.g. "123e0" -> "123.0",
    "1.5E2" -> "150.0"); not a full implementation of XSD 1.1's exact
    canonical-form algorithm for every possible magnitude (e.g. very
    large/small values render with Python's "1e+30"-style exponent rather
    than XSD's "1.0E30"), which is a level of fidelity nothing in this
    codebase currently needs.""" ;
        rdfs:label "_canonicalize_numeric_literal" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:_canonicalize_numeric_literal.param.literal ;
        ns2:hasReturnValue ns7:_canonicalize_numeric_literal.returns ;
        ns2:lineEnd 249 ;
        ns2:lineStart 205 ;
        ns2:signature "def _canonicalize_numeric_literal(literal: Literal) -> Literal" .

    ns7:_canonicalize_numeric_literal.param.literal a ns2:Parameter ;
        rdfs:comment "The Literal to canonicalize." ;
        rdfs:label "literal" ;
        ns2:annotationText "Literal" ;
        ns2:hasType ns4:rdflib.term.Literal ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:_canonicalize_numeric_literal.returns a ns2:ReturnValue ;
        rdfs:comment "A Literal with the same datatype and a canonicalized lexical form, or the original object unchanged if it was already canonical or not one of the canonicalizable numeric datatypes." ;
        ns2:annotationText "Literal" ;
        ns2:hasType ns4:rdflib.term.Literal .

    ns7:_reencode_tt dcterms:identifier "starlayer.graph.model.encoding._reencode_tt" ;
        a ns2:Function ;
        rdfs:comment """Emit tt's rdf:subject/predicate/object encoding triples into
    out_graph (recursively for any nested TripleTerm component) and return
    its content-addressed URI - the write-side mirror of
    StarLayerGraph._intern_tt(), but writing to an arbitrary graph rather
    than `self`, and given an already-fully-resolved TripleTerm (no nested
    tt:HASH URIRefs left to look up) rather than one that might still
    contain them. See inject_missing_tt_encoding()'s docstring for why this
    exists.""" ;
        rdfs:label "_reencode_tt" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:_reencode_tt.param.tt, ns7:_reencode_tt.param.out_graph ;
