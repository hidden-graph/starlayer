    ns224:TestOxigraphIsomorphicAndSerialize dcterms:identifier "tests.graph.integration.test_oxigraph_backend.TestOxigraphIsomorphicAndSerialize" ;
        a ns2:Class ;
        rdfs:comment """isomorphic() and serialize() to a non-RDF12 format (e.g. 'xml',
    'turtle') both bypassed native dispatch via raw store.triples()/
    Graph.triples() - which can't parse a "type":"triple" SPARQL JSON
    binding at all (see starlayer.graph.backends.native's own module docstring) -
    so both would mishandle or crash on any native-backend graph containing
    a triple term. Also covers the turtle12 serializer's @version "1.2"
    directive, which used to check self._tt_nodes (always empty for native)
    and so silently omitted the directive for native-backend graphs that
    did contain real triple terms.""" ;
        rdfs:label "TestOxigraphIsomorphicAndSerialize" ;
        ns2:declares ns224:TestOxigraphIsomorphicAndSerialize.test_turtle12_version_directive_present_for_native_triple_term, ns224:TestOxigraphIsomorphicAndSerialize.test_isomorphic_native_vs_in_memory, ns224:TestOxigraphIsomorphicAndSerialize.test_serialize_non_rdf12_format_with_triple_term ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_backend.py" ;
        ns2:hasDecorator ns224:TestOxigraphIsomorphicAndSerialize.decorator.0 ;
        ns2:lineEnd 1147 ;
        ns2:lineStart 1104 .

