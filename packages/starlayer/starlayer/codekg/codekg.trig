        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/test_mc_introspection.py" ;
        ns2:importsModule ns4:__future__, ns4:re, ns4:hashlib, ns4:rdflib, ns4:pytest, ns4:rdflib.namespace, ns4:pathlib .

