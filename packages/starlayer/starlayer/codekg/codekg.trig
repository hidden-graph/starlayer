    ns12:_parse_property_expr dcterms:identifier "starlayer.graph.parsers.manchester_parser._parse_property_expr" ;
        a ns2:Function ;
        rdfs:comment """Parse an objectPropertyExpr ::= objectProperty | 'inverse'
    objectProperty.

    Deliberately not routed through _parse_description/_parse_primary:
    property positions (SubPropertyOf:, EquivalentTo:, DisjointWith:,
    InverseOf:) never accept the full and/or/not/restriction grammar,
