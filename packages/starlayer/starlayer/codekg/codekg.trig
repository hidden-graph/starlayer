GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/w3c_shacl12/closure.py> {
    ns100:closure.py dcterms:identifier "tests.shacl.w3c_shacl12.closure" ;
        a ns2:Module ;
        rdfs:comment """Extract a self-contained subgraph reachable from a given RDF node.

    A W3C suite test file packs the data graph, shapes graph, manifest metadata,
    and the expected result all into one document sharing one graph. Pulling out
    "just the expected sh:ValidationReport" (rooted at the entry's mf:result
    blank node) needs a closure walk, since it isn't a separately-parseable
    document of its own.""" ;
        rdfs:label "closure" ;
        ns2:declares ns105:node_closure ;
        ns2:filePath "packages/starlayer/tests/shacl/w3c_shacl12/closure.py" ;
        ns2:importsModule ns4:rdflib.term, ns4:__future__, ns4:rdflib .

    ns105:node_closure dcterms:identifier "tests.shacl.w3c_shacl12.closure.node_closure" ;
        a ns2:Function ;
        rdfs:comment "Return a new Graph of every triple reachable from root via blank-node objects." ;
        rdfs:label "node_closure" ;
        ns2:filePath "packages/starlayer/tests/shacl/w3c_shacl12/closure.py" ;
        ns2:hasParameter ns105:node_closure.param.graph, ns105:node_closure.param.root ;
        ns2:hasReturnValue ns105:node_closure.returns ;
        ns2:lineEnd 30 ;
        ns2:lineStart 16 ;
        ns2:signature "def node_closure(graph: Graph, root: Node) -> Graph" .

    ns105:node_closure.param.graph a ns2:Parameter ;
        rdfs:label "graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns105:node_closure.param.root a ns2:Parameter ;
        rdfs:label "root" ;
        ns2:annotationText "Node" ;
        ns2:hasType ns4:rdflib.term.Node ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns105:node_closure.returns a ns2:ReturnValue ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph .

    ns4:__future__ a ns2:ExternalModule .

    ns4:rdflib a ns2:ExternalModule .

    ns4:rdflib.graph.Graph dcterms:identifier "rdflib.graph.Graph" ;
        a ns2:ExternalType ;
        rdfs:label "Graph" ;
        rdfs:subClassOf ns2:Type .

    ns4:rdflib.term a ns2:ExternalModule .

