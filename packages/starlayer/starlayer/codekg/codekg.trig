        ns2:optional true .

    ns3:check_version_conformance_for_graphs dcterms:identifier "starlayer.graph.model.conformance.check_version_conformance_for_graphs" ;
        a ns2:Function ;
        rdfs:comment """Convenience wrapper: computes uses_triple_term/uses_dirlangstring by
    scanning the given StarLayerGraph(s) (their _tt_nodes registry and
    triples() for a DirLangString object), then calls
    check_version_conformance().

    Shared by StarLayerGraph.parse()'s per-format branches (Turtle,
    N-Triples/N-Quads, TriG, RDF/XML each pass graphs=[self]) and
    StarLayerDataset (passes graphs=self.contexts(), since a document-level
    VERSION directive covers every named graph, not just one) - previously
    each of those call sites duplicated this exact scan inline.""" ;
        rdfs:label "check_version_conformance_for_graphs" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/conformance.py" ;
        ns2:hasParameter ns3:check_version_conformance_for_graphs.param.context, ns3:check_version_conformance_for_graphs.param.graphs, ns3:check_version_conformance_for_graphs.param.declared_version ;
        ns2:hasReturnValue ns3:check_version_conformance_for_graphs.returns ;
        ns2:lineEnd 138 ;
        ns2:lineStart 112 ;
        ns2:signature "def check_version_conformance_for_graphs(declared_version, graphs, *, context: str) -> None" .

    ns3:check_version_conformance_for_graphs.param.context a ns2:Parameter ;
        rdfs:label "context" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "kwonly" ;
        ns2:position 2 .

    ns3:check_version_conformance_for_graphs.param.declared_version a ns2:Parameter ;
        rdfs:label "declared_version" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

