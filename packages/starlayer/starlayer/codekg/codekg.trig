    ns82:load_meta_shapes_graph dcterms:identifier "starlayer.shacl.meta_shapes.load_meta_shapes_graph" ;
        a ns2:Function ;
        rdfs:comment """The meta-shapes graph ``meta_validate()`` checks against, read from
    the stored ``shacl12-shacl.ttl`` (``starontology``'s ``"shacl_shacl"``
    entry) rather than reassembled from pySHACL's base graph and starShacl's
    validation shapes on every call.

    The stored file is built by ``scripts/build_meta_shapes.py`` (run through
    ``scripts/build_starontology.py``); it is the authoritative copy at run
    time, so editing the validation shapes or upgrading pySHACL has no effect
    on validation until the file is regenerated. A test compares the stored
    file with a fresh build and fails on drift.

    The file is parsed once per process by ``starontology`` and cached there;
    each call returns a fresh copy, so ``extra_graphs`` can be added (plain
    triple addition) without affecting later calls.""" ;
        rdfs:label "load_meta_shapes_graph" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/meta_shapes.py" ;
        ns2:hasParameter ns82:load_meta_shapes_graph.param.extra_graphs ;
        ns2:hasReturnValue ns82:load_meta_shapes_graph.returns ;
        ns2:lineEnd 138 ;
        ns2:lineStart 114 ;
        ns2:signature "def load_meta_shapes_graph(extra_graphs: Iterable[Any]=()) -> Graph" .

