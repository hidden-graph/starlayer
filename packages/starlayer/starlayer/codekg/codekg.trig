GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/trix12.py> {
    ns11:trix12.py dcterms:identifier "starlayer.graph.parsers.trix12" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.trix12

    Parse TriX 1.2 XML into triples, preserving or merging named-graph structure.

    TriX is an XML-based named-graph format. Each <graph> block contains <triple>
    elements whose three children are term nodes. RDF 1.2 triple terms are
    represented by nesting another <triple> element in a term position (subject
    or object) - the same element used for an asserted statement, disambiguated
    only by structural position, not a distinct tag name. This matches Apache Jena's real TriX writer, including its lowercase
    <trix> root element - it also nests <triple> for a triple term, the only
    production TriX implementation found to actually support RDF 1.2 triple
    terms, since Oxigraph doesn't implement TriX at all. StarLayer originally
    invented its own <TriX>/<tripleTerm> spelling before this was checked
    against a real implementation; both the
    old root-tag capitalization and <tripleTerm> are still accepted here for
    backward compatibility with anything already serialized by this parser's
    own prior convention, but are no longer emitted (see trix12.py serializer).

    Entry points:
        parse_trix12(text)        -> list of (s, p, o)            (merges all graphs)
        parse_trix12_named(text)  -> list of (graph_id, triples)  (preserves structure)""" ;
        rdfs:label "trix12" ;
        ns2:declares ns23:_parse_term, ns23:_iter_graphs, ns23:parse_trix12_named, ns23:_parse_graph, ns23:parse_trix12 ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        ns2:importsModule ns4:rdflib, ns4:xml.etree.ElementTree, ns4:__future__ .

    ns23:_iter_graphs dcterms:identifier "starlayer.graph.parsers.trix12._iter_graphs" ;
        a ns2:Function ;
        rdfs:comment "Yield (graph_id, triples) pairs from a TriX document." ;
        rdfs:label "_iter_graphs" ;
        ns2:calls ns23:_parse_graph ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        ns2:hasParameter ns23:_iter_graphs.param.text ;
        ns2:isPrivate true ;
        ns2:lineEnd 124 ;
        ns2:lineStart 113 ;
        ns2:signature "def _iter_graphs(text: str)" .

    ns23:_iter_graphs.param.text a ns2:Parameter ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns23:_parse_graph dcterms:identifier "starlayer.graph.parsers.trix12._parse_graph" ;
        a ns2:Function ;
        rdfs:comment """Parse a <graph> element; return (graph_id, triples).

    The graph is named when its first child is a <uri> element.""" ;
        rdfs:label "_parse_graph" ;
        ns2:calls ns23:_parse_term ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/trix12.py" ;
        ns2:hasParameter ns23:_parse_graph.param.graph_elem ;
        ns2:hasReturnValue ns23:_parse_graph.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 110 ;
        ns2:lineStart 83 ;
        ns2:signature "def _parse_graph(graph_elem: ET.Element) -> tuple[URIRef | None, list[tuple]]" .

    ns23:_parse_graph.param.graph_elem a ns2:Parameter ;
        rdfs:label "graph_elem" ;
        ns2:annotationText "ET.Element" ;
        ns2:hasType ns4:xml.etree.ElementTree.Element ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns23:_parse_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "tuple[URIRef | None, list[tuple]]" ;
        ns2:hasType ns4:builtins.tuple, ns4:builtins.list, ns4:rdflib.term.URIRef .

    ns23:_parse_term dcterms:identifier "starlayer.graph.parsers.trix12._parse_term" ;
        a ns2:Function ;
        rdfs:comment "Convert a TriX term element to an rdflib node or TripleTerm." ;
