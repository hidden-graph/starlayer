        rdfs:comment "The expression tree (or list of expression trees) to simplify." ;
        rdfs:label "expr" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns58:_simplify_expr_immutable.returns a ns2:ReturnValue ;
        rdfs:comment "A fresh, simplified equivalent — the original is never mutated." .

