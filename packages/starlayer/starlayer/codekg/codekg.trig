    ns78:_eval_custom_function_call dcterms:identifier "starlayer.shacl.node_expressions._eval_custom_function_call" ;
        a ns2:Function ;
        rdfs:comment """Evaluate a call to a custom List/Named Parameter Expression Function.

    Implements both "EVALUATION OF CUSTOM LIST/NAMED PARAMETER EXPRESSIONS"
    algorithms from the spec, which are identical up to how ``argScope`` gets
    built: ``evalExpr(expr, focusGraph, focusNode, scope) ->
    evalExpr(body, focusGraph, focusNode, argScope)`` - the function body is
    evaluated in a *fresh* scope containing only the bound arguments (plus
    ``focusNode``, since ``shnex:var "focusNode"`` reads it out of scope like
    any other entry), never merged with the caller's own ``shnex:var``
    bindings - real function-call isolation, not lexical closure.

    For the named-parameter case, ``argScope`` is built from *every*
    declared ``sh:parameter`` of ``fn``, not just the key parameter(s): the
    spec's own "EVALUATION OF CUSTOM NAMED PARAMETER EXPRESSIONS" algorithm
    says "argScope is a map of (parameter) nodes as keys and (argument)
    nodes as values, so that **each parameter** of f has the value of the
    parameter's sh:path from expr" - not "each key parameter". Key
    parameters are still what the registry uses to *find and dispatch to*
    the right function in the first place; building ``argScope`` is a
    separate step that must cover every declared parameter, key or not, or
    a call site supplying a value for a declared-but-non-key parameter
    would silently lose it.""" ;
        rdfs:label "_eval_custom_function_call" ;
        ns2:calls ns78:eval_expr, ns78:_eval_custom_function_call._eval_arg ;
        ns2:declares ns78:_eval_custom_function_call._eval_arg ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/node_expressions.py" ;
        ns2:hasParameter ns78:_eval_custom_function_call.param.sg, ns78:_eval_custom_function_call.param.expr, ns78:_eval_custom_function_call.param.focus_node, ns78:_eval_custom_function_call.param.registry, ns78:_eval_custom_function_call.param.call_predicates, ns78:_eval_custom_function_call.param.recurse_depth, ns78:_eval_custom_function_call.param.data_graph ;
        ns2:hasReturnValue ns78:_eval_custom_function_call.returns ;
        ns2:isPrivate true ;
