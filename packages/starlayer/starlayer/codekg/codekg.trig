GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/sqe/from_rdf.py> {
    ns65:from_rdf.py dcterms:identifier "starlayer.sparql.sqe.from_rdf" ;
        a ns2:Module ;
        rdfs:comment """Decode ``sqe:`` RDF back into a real, executable rdflib ``Query`` —
    reconstructs the raw-parse-tree-shaped ``CompValue``s ``translateQuery``
    itself expects. A ``TriplesBlock``'s/``ConstructQuery``'s own ``.template``'s
    triples-field is a list of 3-element lists, concatenated then re-split into
    groups of 3 by ``algebra.triples()`` - a single already-grouped triple just
    needs its own ``[[s, p, o]]``-wrapped entry, no different from what a
    one-triple ``WHERE`` clause parses to from text - then hands that to
    rdflib's own, completely unmodified ``translateQuery`` — the same function
    ``sqe/to_rdf.py``'s encoder path, ``prepare_query_12``, and the ``sast:``
    layer all already call.

    Term/expression/path decoding at the ``salg:`` boundary (``sqe:expr``,
    and any predicate position that's a genuine property path) reuses
    ``..from_rdf._decode`` directly, unchanged — it already dispatches
    correctly across ``Variable``/plain term/``salg:``-encoded path/expression
    uniformly, so there's nothing new to write at that boundary.""" ;
        rdfs:label "from_rdf" ;
        ns2:declares ns66:_decode_values, ns66:_query_name_for_root, ns66:_decode_triple_pattern_fields, ns66:_decode_solution_modifiers, ns66:_decode_term, ns66:_decode_exists_hook, ns66:_decode_where_element, ns66:_decode_where_group, ns66:_decode, ns66:_decode_projection_item, ns66:sqe_tree_to_query, ns66:_decode_query_cv ;
        ns2:filePath "packages/starlayer/starlayer/sparql/sqe/from_rdf.py" ;
        ns2:importsModule ns4:rdflib.collection, ns4:rdflib.namespace, ns4:__future__, ns4:rdflib, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib.plugins.sparql.algebra, ns4:rdflib.plugins.sparql.parserutils .

    ns66:_decode dcterms:identifier "starlayer.sparql.sqe.from_rdf._decode" ;
        a ns2:Function ;
        rdfs:comment """Decode an expression or term, rebuilding sqe:Exists blocks (the shared
    decoder handles everything else).""" ;
        rdfs:label "_decode" ;
        ns2:calls ns53:_decode ;
        ns2:filePath "packages/starlayer/starlayer/sparql/sqe/from_rdf.py" ;
        ns2:hasParameter ns66:_decode.param.node, ns66:_decode.param.graph ;
        ns2:isPrivate true ;
        ns2:lineEnd 88 ;
        ns2:lineStart 81 ;
        ns2:signature "def _decode(node, graph: Graph)" .

    ns66:_decode.param.graph a ns2:Parameter ;
        rdfs:label "graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns66:_decode.param.node a ns2:Parameter ;
        rdfs:label "node" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

