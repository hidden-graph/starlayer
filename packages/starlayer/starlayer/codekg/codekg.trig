    ns75:_materialize_source_rule_provenance dcterms:identifier "starlayer.shacl.validator._materialize_source_rule_provenance" ;
        a ns2:Function ;
        rdfs:comment """Add one reifier per ``(triple, rule_node)`` record to ``out_data``,
    encoding SHACL 1.2 SPARQL Extensions section 8.7's ``sh:sourceRule``
    provenance shorthand in its fully-expanded form: ``_:id rdf:reifies
    <<( s p o )>> . _:id sh:sourceRule <rule> .`` Call only after all rule
    execution has completely finished - see ``_patch_rule_apply_for_source_rule_provenance``'s
    docstring for why.

    Builds the reifier's ``rdf:reifies`` object as a plain ``(s, p, o)``
    3-tuple rather than via ``adapter.term_factory`` directly: the adapter's
    own ``term_factory`` defaults to the fallback ``TripleTermValue`` (not a
    real ``rdflib.Node``) regardless of whether ``out_data`` actually is a
    ``StarLayerGraph`` - `TripleTermAdapter.for_starlayer_graph()` is what
    would set it to the real ``starlayer.graph`` ``TripleTerm``, but nothing
    here can assume that classmethod was used to build ``adapter``. A plain
    3-tuple sidesteps that mismatch: ``StarLayerGraph.add()``'s own
    ``_coerce_tt`` explicitly recognizes "a tuple/TripleTerm" as inline
    triple-term shorthand in any node position (see its docstring), so this
    matches ``out_data``'s actual representation unconditionally, the same
    convention ``TripleTermAdapter._encode_node`` documents and relies on
    elsewhere in this codebase.""" ;
        rdfs:label "_materialize_source_rule_provenance" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/validator.py" ;
        ns2:hasParameter ns75:_materialize_source_rule_provenance.param.decode, ns75:_materialize_source_rule_provenance.param.records, ns75:_materialize_source_rule_provenance.param.out_data, ns75:_materialize_source_rule_provenance.param.adapter ;
        ns2:hasReturnValue ns75:_materialize_source_rule_provenance.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 4206 ;
        ns2:lineStart 4150 ;
        ns2:signature "def _materialize_source_rule_provenance(out_data: Any, adapter: TripleTermAdapter, records: list[tuple[tuple[Any, Any, Any], Any]], *, decode: bool) -> None" .

    ns75:_materialize_source_rule_provenance.param.adapter a ns2:Parameter ;
        rdfs:comment "Used to decode every term (subject/predicate/object and the rule node) back to ``out_data``'s own representation when ``decode=True``." ;
        rdfs:label "adapter" ;
        ns2:annotationText "TripleTermAdapter" ;
        ns2:hasType ns4:starlayer.shacl.adapters.TripleTermAdapter ;
        ns2:parameterKind "positional" ;
