        a ns2:Function ;
        rdfs:label "_build_sparql_constraint_component" ;
        ns2:declares ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:hasReturnValue ns76:_build_sparql_constraint_component.returns ;
