    ns199:_oxigraph_store_installed dcterms:identifier "tests.graph.w3c_sparql12.test_w3c_sparql12_eval._oxigraph_store_installed" ;
        a ns2:Function ;
        rdfs:label "_oxigraph_store_installed" ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_sparql12/test_w3c_sparql12_eval.py" ;
        ns2:hasReturnValue ns199:_oxigraph_store_installed.returns ;
