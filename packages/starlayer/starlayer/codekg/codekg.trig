    ns28:StarLayerGraph.update dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.update" ;
        a ns2:Method ;
        rdfs:comment """Execute a SPARQL UPDATE.

    For the native rdf-1.2 backend, the update is forwarded to the
    endpoint via HTTP unchanged (see
    ``starlayer.graph.backends.native.native_update``).

    Otherwise, SPARQL 1.2 text is parsed via starlayer.sparql's real
    grammar (``prepare_update_12``), lowered to a plain SPARQL 1.1
    algebra (tt:HASH encoding), and serialized back to real SPARQL 1.1
    Update text before executing - every shape (triple-term WHERE
    patterns, ground triple terms in INSERT/DELETE DATA, triple terms in
    INSERT/DELETE templates) is handled natively by that lowering, with
    no post-processing needed here.

    Always passes text, never a pre-parsed ``Update`` object, to the
    underlying ``Graph.update()``: a remote store's
    ``SPARQLUpdateStore.update()`` hard-``assert``s on a plain string,
    since all it can do is POST text over HTTP, whereas the default
    in-memory store's generic processor accepts either.""" ;
        rdfs:label "update" ;
        ns2:calls ns3:check_version_conformance, ns71:update_to_rdf11, ns28:StarLayerGraph._build_registry_from_store, ns41:strip_version_directive, ns71:rdf11_update_to_sparql11_text, ns38:native_update, ns41:contains_triple_term, ns72:prepare_update_12, ns28:StarLayerGraph._on_mutated ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        ns2:hasParameter ns28:StarLayerGraph.update.param.kwargs, ns28:StarLayerGraph.update.param.initNs, ns28:StarLayerGraph.update.param.use_store_provided, ns28:StarLayerGraph.update.param.processor, ns28:StarLayerGraph.update.param.initBindings, ns28:StarLayerGraph.update.param.update_object ;
        ns2:hasReturnValue ns28:StarLayerGraph.update.returns ;
        ns2:lineEnd 2597 ;
        ns2:lineStart 2533 ;
        ns2:signature "def update(self, update_object, processor='sparql', initNs=None, initBindings=None, use_store_provided=True, **kwargs) -> None" .

    ns28:StarLayerGraph.update.param.initBindings a ns2:Parameter ;
        rdfs:label "initBindings" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 3 .

