        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns87:_close_shape._walk.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns87:_close_shape.param.shacl_graph a ns2:Parameter ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns87:_close_shape.param.shape a ns2:Parameter ;
        rdfs:label "shape" ;
        ns2:annotationText "Any" ;
