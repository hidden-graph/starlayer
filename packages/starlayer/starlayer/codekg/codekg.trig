    ns300:TestDirLangStringEquality.test_sameterm_on_dirlangstring_works dcterms:identifier "tests.graph.integration.test_oxigraph_store_rdf12.TestDirLangStringEquality.test_sameterm_on_dirlangstring_works" ;
        a ns2:Method ;
        rdfs:comment """The workaround the upstream-issue doc recommends: sameTerm() is
    exact-term equality, a different operator, and is unaffected.""" ;
