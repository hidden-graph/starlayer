    ns75:StarShaclSchema dcterms:identifier "starlayer.shacl.validator.StarShaclSchema" ;
        a ns2:Class ;
        rdfs:comment """A SHACL schema: a bound shapes graph plus an optional ontology
    graph, to validate, infer rules against, or evaluate node
    expressions over any number of data graphs.

    ``self.shacl_graph``/``self.ont_graph`` are each a reference to
    their own separate graph - this class does not itself *hold* triples
    the way ``StarLayerGraph`` does. Composition, not inheritance: there
    is no real "is-a" relationship available between it and any
    existing rdflib/pyshacl class - pySHACL's own main entry point,
    ``validate()``, is a stateless one-shot function, not a long-lived
    object to subclass, and this class unifies several independent
    capabilities (``validate``/``apply_rules``/``evaluate``) rather than
    specializing any one of them. Construct one per distinct shapes-set
    (``PersonSchema = StarShaclSchema(person_shapes)``,
    ``ProductSchema = StarShaclSchema(product_shapes)``, ...), then call
    ``validate``/``apply_rules``/``evaluate`` against whatever data graph
    you're checking. ``select_widgets`` is the one method that needs no data
    graph at all - it chooses SHACL 1.2 UI widgets from the shapes graph alone. Shape-driven subgraph extraction is a separate, plain
    function (``starlayer.shacl.extract_subgraph()``), not a method here -
    see its own docstring, and the subgraph-extraction guide, for why.

    Adds RDF 1.2/triple-term adaptation around pySHACL, which understands
    neither triple terms nor SHACL 1.2's own predicates natively.""" ;
        rdfs:label "StarShaclSchema" ;
        ns2:declares ns75:StarShaclSchema.select_widgets, ns75:StarShaclSchema._resolve_shacl_graph, ns75:StarShaclSchema._ensure_native_component_shapes_typed, ns75:StarShaclSchema._resolve_data_graph, ns75:StarShaclSchema._augment_shapes_with_new_target_types, ns75:StarShaclSchema._resolve_shapes_graph_and_provenance, ns75:StarShaclSchema.__init__, ns75:StarShaclSchema._annotate_used_graphs_and_configuration, ns75:StarShaclSchema.extract_shapes_graph, ns75:StarShaclSchema._humanize_report_text, ns75:StarShaclSchema._try_native_structural_property_validation, ns75:StarShaclSchema._try_native_core_validation, ns75:StarShaclSchema.validate_each, ns75:StarShaclSchema._annotate_conformance_disallows, ns75:StarShaclSchema._resolve_structural_component_definition, ns75:StarShaclSchema.evaluate, ns75:StarShaclSchema._strip_deactivated_node_expressions, ns75:StarShaclSchema._nodes_conforming_to, ns75:StarShaclSchema.target_nodes, ns75:StarShaclSchema._resolve_literal_only_component_name, ns75:StarShaclSchema.evaluate_component, ns75:StarShaclSchema.validate, ns75:StarShaclSchema.build_report, ns75:StarShaclSchema._try_native_literal_only_validation, ns75:StarShaclSchema.close_shape, ns75:StarShaclSchema.apply_rules ;
        ns2:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
        ns2:lineEnd 2154 ;
        ns2:lineStart 81 .

    ns75:StarShaclSchema.__init__ dcterms:identifier "starlayer.shacl.validator.StarShaclSchema.__init__" ;
        a ns2:Method ;
        rdfs:comment """Bind a shapes graph (plus optional ontology/data graphs and an
    entailment regime) once, so every processing method
    (``validate``/``apply_rules``/``evaluate``/``target_nodes``) can
    be called repeatedly without re-passing the same arguments.""" ;
        rdfs:label "__init__" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
        ns2:hasParameter ns75:StarShaclSchema.__init__.param.inference, ns75:StarShaclSchema.__init__.param.ont_graph, ns75:StarShaclSchema.__init__.param.shacl_graph, ns75:StarShaclSchema.__init__.param.data_graph, ns75:StarShaclSchema.__init__.param.scoring_graph, ns75:StarShaclSchema.__init__.param.adapter, ns75:StarShaclSchema.__init__.param.validate_fn ;
        ns2:hasReturnValue ns75:StarShaclSchema.__init__.returns ;
        ns2:instantiates ns90:TripleTermAdapter ;
        ns2:isDunder true ;
        ns2:lineEnd 203 ;
        ns2:lineStart 107 ;
        ns2:signature "def __init__(self, shacl_graph: Any | None=None, ont_graph: Any | None=None, *, data_graph: Any | None=None, scoring_graph: Any | None=None, inference: Any | None=None, adapter: TripleTermAdapter | None=None, validate_fn: Callable[..., tuple[bool, Graph, str]] | None=None) -> None" .

    ns75:StarShaclSchema.__init__.param.adapter a ns2:Parameter ;
        rdfs:comment "Overrides the ``TripleTermAdapter`` used to encode/decode triple terms around pySHACL. Defaults to a fresh ``TripleTermAdapter()``." ;
        rdfs:label "adapter" ;
        ns2:annotationText "TripleTermAdapter | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:starlayer.shacl.adapters.TripleTermAdapter ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 5 .

    ns75:StarShaclSchema.__init__.param.data_graph a ns2:Parameter ;
        rdfs:comment "An optional default data graph, bound once here the same way ``shacl_graph``/``ont_graph`` already are, so a caller performing several different operations (``validate()``, ``apply_rules()``, ``evaluate()``, ...) against the same data doesn't have to keep re-passing it to every method call - each method's own ``data_graph`` parameter is optional, falling back to this one (see ``_resolve_data_graph()``). Still fully overridable per call - binding a default here doesn't prevent passing a different ``data_graph`` to any one method." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 2 .

    ns75:StarShaclSchema.__init__.param.inference a ns2:Parameter ;
        rdfs:comment "An optional entailment regime (one of the real ``ENTAILMENT.*`` IRIs, or an iterable of them), bound once here rather than accepted as a per-method keyword - an entailment regime is realistically a property of \"how this schema interprets its data,\" not something a caller would want to vary call-to-call on the same schema. Methods below don't accept their own ``inference=`` parameter at all - construct a second ``StarShaclSchema`` with a different ``inference=`` if two different regimes are genuinely needed against the same shapes/data." ;
        rdfs:label "inference" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns75:StarShaclSchema.__init__.param.ont_graph a ns2:Parameter ;
        rdfs:comment "An optional ontology graph consulted for entailment and other axiom lookups, normalized with ``force_default_union=True``." ;
        rdfs:label "ont_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns75:StarShaclSchema.__init__.param.scoring_graph a ns2:Parameter ;
        rdfs:comment "An optional catalog of ``shui:WidgetScore``/ ``shui:WidgetAcceptMatcher`` entries, bound once here the same way ``data_graph`` is. :meth:`select_widgets` uses it when called without its own ``scoring_graph=``; a per-call value overrides it. Only :meth:`select_widgets` reads it." ;
        rdfs:label "scoring_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns75:StarShaclSchema.__init__.param.shacl_graph a ns2:Parameter ;
        rdfs:comment "The SHACL shapes graph to validate against. Normalized once, here, rather than per-call: every method below reads this same object every time, so ``apply_rules()``'s own separate ``normalize_graph_inputs(self.shacl_graph, ...)`` call (for ``rule_set``/``_global_sparql_rule_triples`` - needs blank-node identity to match whatever ``self.validate()`` ends up using internally) gets the identical, already-normalized object back - no second, independent normalization that could silently diverge." ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns75:StarShaclSchema.__init__.param.validate_fn a ns2:Parameter ;
        rdfs:comment "Overrides the underlying ``(data_graph, shacl_graph, ont_graph, **options) -> (conforms, report_graph, report_text)`` callable ``validate()`` dispatches to. Defaults to pySHACL's own ``validate()``." ;
        rdfs:label "validate_fn" ;
        ns2:annotationText "Callable[..., tuple[bool, Graph, str]] | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:builtins.str, ns4:rdflib.graph.Graph, ns4:builtins.tuple, ns4:collections.abc.Callable, ns4:builtins.bool ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 6 .

    ns75:StarShaclSchema.__init__.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns75:StarShaclSchema._annotate_conformance_disallows dcterms:identifier "starlayer.shacl.validator.StarShaclSchema._annotate_conformance_disallows" ;
        a ns2:Method ;
        rdfs:comment """Add ``sh:conformanceDisallows`` to the report per the SHACL 1.2
    Core spec: the set of severities whose presence makes ``sh:conforms``
    false. pySHACL's own ``allow_warnings``/``allow_infos`` options
    already implement the underlying behavior for ``sh:Violation``/
    ``sh:Warning``/``sh:Info`` (confirmed directly: a Warning- or
    Info-only result already flips ``sh:conforms`` to false by default,
    matching the spec's stated default disallow set of
    Violation+Warning+Info) - annotating ``disallowed`` just makes that
    set explicit in the report.

    Also recomputes ``sh:conforms`` itself (returned, and fixed up in
    ``report_graph`` to match) rather than trusting pySHACL's own
    boolean as-is: pySHACL has no notion of SHACL 1.2's new
    ``sh:Debug``/``sh:Trace`` severities (below ``sh:Warning``, must
    never block conformance regardless of ``allow_warnings``/
    ``allow_infos``) at all, so a shape using one of them still
    incorrectly flips ``sh:conforms`` to false. Recomputing purely from
    ``disallowed`` (rather than special-casing Debug/Trace separately)
    fixes this for free, since neither is ever a member of it - only
    ``sh:Violation``, and conditionally ``sh:Warning``/``sh:Info``, ever
    are. Confirmed via the W3C SHACL 1.2 test suite's severity-004/
    severity-005 fixtures.""" ;
        rdfs:label "_annotate_conformance_disallows" ;
        ns2:calls ns75:_find_genuine_report_node ;
        ns2:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
        ns2:hasParameter ns75:StarShaclSchema._annotate_conformance_disallows.param.conforms, ns75:StarShaclSchema._annotate_conformance_disallows.param.report_graph, ns75:StarShaclSchema._annotate_conformance_disallows.param.options ;
        ns2:hasReturnValue ns75:StarShaclSchema._annotate_conformance_disallows.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 1436 ;
        ns2:lineStart 1379 ;
        ns2:signature "def _annotate_conformance_disallows(self, report_graph: Any, options: dict[str, Any], conforms: bool) -> bool" .

    ns75:StarShaclSchema._annotate_conformance_disallows.param.conforms a ns2:Parameter ;
        rdfs:comment "pySHACL's own computed conformance boolean, used as the fallback return value when no report node is found." ;
        rdfs:label "conforms" ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns75:StarShaclSchema._annotate_conformance_disallows.param.options a ns2:Parameter ;
        rdfs:comment "The resolved validator options for this run - reads ``allow_warnings``/``allow_infos``." ;
        rdfs:label "options" ;
        ns2:annotationText "dict[str, Any]" ;
        ns2:hasType ns4:typing.Any, ns4:builtins.str, ns4:builtins.dict ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns75:StarShaclSchema._annotate_conformance_disallows.param.report_graph a ns2:Parameter ;
