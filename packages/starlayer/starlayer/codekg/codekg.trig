        a ns2:Function ;
        rdfs:label "pytest_collection_modifyitems" ;
        ns2:calls ns304:_requested ;
        ns2:filePath "packages/starlayer/tests/conftest.py" ;
        ns2:hasParameter ns304:pytest_collection_modifyitems.param.config, ns304:pytest_collection_modifyitems.param.items ;
        ns2:lineEnd 118 ;
        ns2:lineStart 97 ;
        ns2:signature "def pytest_collection_modifyitems(config, items)" .

    ns304:pytest_collection_modifyitems.param.config a ns2:Parameter ;
        rdfs:label "config" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

