GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/trig12.py> {
    ns11:trig12.py dcterms:identifier "starlayer.graph.parsers.trig12" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.trig12

    Parse TriG 1.2 text into triples, preserving or merging named-graph structure.

    TriG 1.2 is Turtle 1.2 with optional ``GRAPH <name> { ... }`` blocks.  Each
    block's content is Turtle 1.2, so this parser:

      1. Extracts PREFIX / @prefix declarations.
      2. Splits the document into graph blocks (default graph + each GRAPH block).
      3. Prepends the prefix declarations to each block's content.
      4. Parses each chunk as Turtle 1.2 via StarLayerTurtleParser.

    Entry points:
        parse_trig12(text)        -> list of (s, p, o)            (merges all graphs)
        parse_trig12_named(text)  -> list of (graph_id, triples, namespaces)""" ;
        rdfs:label "trig12" ;
        ns2:declares ns21:extract_version_directive, ns21:_split_trig_blocks_with_ids, ns21:parse_trig12_named, ns21:parse_trig12, ns21:_extract_prefix_map, ns21:_resolve_graph_id, ns21:_extract_prefix_lines, ns21:_split_trig_blocks, ns21:_consume_balanced, ns21:_mask_string_literals ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        ns2:importsModule ns4:re, ns4:__future__, ns4:rdflib .

