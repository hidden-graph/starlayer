    ns299:check_parse_tree dcterms:identifier "starlayer.sparql._syntax_checks.check_parse_tree" ;
        a ns2:Function ;
        rdfs:comment """Reject nested aggregates, a repeated ``VALUES`` variable, and a
    ``SELECT`` expression variable that reuses a ``GROUP BY`` key's name.

    Raises:
        SPARQLSyntaxError: On the first rule broken.""" ;
        rdfs:label "check_parse_tree" ;
        ns2:calls ns299:_check_group_by_scope, ns299:_as_list, ns299:_walk ;
        ns2:filePath "packages/starlayer/starlayer/sparql/_syntax_checks.py" ;
        ns2:hasParameter ns299:check_parse_tree.param.tree ;
        ns2:hasReturnValue ns299:check_parse_tree.returns ;
        ns2:instantiates ns299:SPARQLSyntaxError ;
