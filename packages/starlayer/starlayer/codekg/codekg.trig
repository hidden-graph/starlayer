    ns267:TestReturnedGraphIsShapeDrivenSubgraph dcterms:identifier "tests.shacl.integration.test_evaluate_virtual_values.TestReturnedGraphIsShapeDrivenSubgraph" ;
        a ns2:Class ;
        rdfs:comment """2026-10-07: evaluate() stopped returning a full copy of data_graph -
    the returned graph is scoped to exactly what the shapes graph's own
    property shapes describe via sh:path (every property shape, not just
    ones with sh:values/sh:defaultValue), unioned with the computed virtual
    values. Anything in data_graph a property shape's sh:path never reaches
    - an unrelated predicate on a targeted node, an unconnected subject,
    even the rdf:type triple that targeted the node in the first place -
    is correctly absent.""" ;
        rdfs:label "TestReturnedGraphIsShapeDrivenSubgraph" ;
        ns2:declares ns267:TestReturnedGraphIsShapeDrivenSubgraph.test_property_shape_without_sh_values_still_contributes_its_real_values, ns267:TestReturnedGraphIsShapeDrivenSubgraph.test_unrelated_predicate_and_unconnected_subject_are_excluded ;
