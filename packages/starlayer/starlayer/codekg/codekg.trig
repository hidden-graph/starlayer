    ns236:TestCollectionElementLiteralCoercion.test_blank_node_member_still_expands_normally dcterms:identifier "tests.graph.unit.test_turtle_parser.TestCollectionElementLiteralCoercion.test_blank_node_member_still_expands_normally" ;
        a ns2:Method ;
        rdfs:comment """Regression guard: fixing literal coercion for collection members
    must not disturb the existing (already-correct) expansion of a
    '[ ... ]' blank-node member into its own triples.""" ;
