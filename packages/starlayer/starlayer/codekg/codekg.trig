GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_turtle_parser_errors.py> {
    ns111:test_turtle_parser_errors.py dcterms:identifier "tests.graph.unit.test_turtle_parser_errors" ;
        a ns2:Module ;
        rdfs:comment """End-to-end tests: StarLayerTurtleParser (via StarLayerGraph.parse(format='turtle12'))
    must raise Turtle12SyntaxError on malformed Turtle 1.2 input, in line with how
    rdflib's own Turtle parser (rdflib.plugins.parsers.notation3.BadSyntax) reacts
    to the same malformed input - confirmed directly against rdflib during the
    2026-07-17 architectural review, which is what prompted this fix. Previously
    this parser silently accepted malformed input and produced wrong data instead
    of raising; see docs/future_enhancements.md for the write-up.""" ;
        rdfs:label "test_turtle_parser_errors" ;
        ns2:declares ns132:TestMalformedTokens, ns132:TestUnterminatedForms, ns132:_parse, ns132:TestBareStopCharAsSubject, ns132:TestWellFormedInputStillParses ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser_errors.py" ;
        ns2:importsModule ns4:pytest .

    ns132:TestBareStopCharAsSubject dcterms:identifier "tests.graph.unit.test_turtle_parser_errors.TestBareStopCharAsSubject" ;
        a ns2:Class ;
        rdfs:comment """N3-style '{ s p o } ...' (a triple as the subject of another
    statement) is never legal RDF 1.2 - a triple term can only ever appear
    in object position, via <<( )>>, not via N3 '{ }' formula syntax at
    all. Previously this silently parsed with zero errors and produced
    zero triples (confirmed live before the fix) - indistinguishable from
    "the document had nothing in it," a genuinely dangerous failure mode
    for a typo. Now raises Turtle12SyntaxError instead, for the same reason
    every other malformed-input case in this file does.""" ;
        rdfs:label "TestBareStopCharAsSubject" ;
        ns2:declares ns132:TestBareStopCharAsSubject.test_n3_formula_as_subject_raises_turtle12, ns132:TestBareStopCharAsSubject.test_stray_closing_bracket_as_subject_raises, ns132:TestBareStopCharAsSubject.test_valid_annotation_block_document_still_parses, ns132:TestBareStopCharAsSubject.test_n3_formula_as_subject_raises_longturtle12 ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_turtle_parser_errors.py" ;
        ns2:lineEnd 105 ;
        ns2:lineStart 58 .

    ns132:TestBareStopCharAsSubject.test_n3_formula_as_subject_raises_longturtle12 dcterms:identifier "tests.graph.unit.test_turtle_parser_errors.TestBareStopCharAsSubject.test_n3_formula_as_subject_raises_longturtle12" ;
