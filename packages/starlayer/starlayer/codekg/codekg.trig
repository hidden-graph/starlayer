    ns28:can_resolve_import dcterms:identifier "starlayer.graph.graph.starlayer_graph.can_resolve_import" ;
        a ns2:Function ;
        rdfs:comment """Returns whether ``loader`` can resolve ``iri``.

    A question about the *loader*'s own knowledge, not about any
    particular graph's data, which is why this is a plain function
    rather than a ``StarLayerGraph`` method the way
    ``owl_imports()``/``resolve_imports()`` are.

    Implemented the only honest way this can be answered: by actually
    calling ``loader(iri)`` and checking whether it returned a graph
    instead of ``None``. For a loader that only ever consults an
    already-known local registry (e.g. ``starontology``'s own), this is
    free - a dict lookup. For a loader that makes a real network
    request, this has the *exact same* cost and side effects as actually
    resolving would - there is no cheaper way to ask "would this work"
    short of trying it, since only the loader itself knows what it can
    reach.""" ;
        rdfs:label "can_resolve_import" ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        ns2:hasParameter ns28:can_resolve_import.param.iri, ns28:can_resolve_import.param.loader ;
        ns2:hasReturnValue ns28:can_resolve_import.returns ;
        ns2:lineEnd 155 ;
        ns2:lineStart 130 ;
        ns2:signature "def can_resolve_import(iri: Any, *, loader: Callable[[Any], Any | None]) -> bool" .

    ns28:can_resolve_import.param.iri a ns2:Parameter ;
        rdfs:comment "The import target to test." ;
        rdfs:label "iri" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns28:can_resolve_import.param.loader a ns2:Parameter ;
        rdfs:comment "Resolves an IRI to a graph, or ``None`` if it can't." ;
        rdfs:label "loader" ;
        ns2:annotationText "Callable[[Any], Any | None]" ;
        ns2:hasType ns4:collections.abc.Callable, ns4:typing.Any ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns28:can_resolve_import.returns a ns2:ReturnValue ;
        rdfs:comment "True if ``loader(iri)`` returns a graph rather than ``None``." ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool .

    ns4:__future__ a ns2:ExternalModule .

