        a ns2:Function ;
        rdfs:comment "Expand <<( s p o )>> into a starlayer.graph TripleTerm bnode. Handles nesting." ;
        rdfs:label "expand_triple_term" ;
        ns2:calls ns202:parse_nt12.expand_triple_term, ns20:next_token, ns202:parse_nt12.resolve_token ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_turtle12/test_w3c_turtle.py" ;
        ns2:hasParameter ns202:parse_nt12.expand_triple_term.param.tok ;
