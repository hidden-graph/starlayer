GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/starontology/manchester_conformance/test_mc_differential.py> {
    ns334:test_mc_differential.py dcterms:identifier "tests.starontology.manchester_conformance.test_mc_differential" ;
        a ns2:Module ;
        rdfs:comment """Differential test: our parser against the OWL API 5.1.20 oracle goldens (P in the plan's P/T/R/O/V/N).

    For each corpus case with a golden: if the oracle accepted it, ``parse_manchester`` must accept it and
    produce an OWL-equivalent graph (unordered lists compared as sets); if the oracle rejected it, the
    disposition is recorded in ``known_failures.ORACLE_REJECTS`` - the W3C Note may allow what OWL API does
    not, so a rejection is a *finding to classify*, never a silent skip.""" ;
        rdfs:label "test_mc_differential" ;
        ns2:declares ns337:test_matches_owlapi, ns337:test_oracle_reject_registry_has_no_stale_entries ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/test_mc_differential.py" ;
        ns2:importsModule ns4:pytest, ns4:__future__ .

    ns337:test_matches_owlapi dcterms:identifier "tests.starontology.manchester_conformance.test_mc_differential.test_matches_owlapi" ;
        a ns2:Function ;
        rdfs:label "test_matches_owlapi" ;
        ns2:calls ns338:same_owl, ns338:load_golden, ns338:parse_to_graph, ns338:owlapi_graph_from_golden ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/test_mc_differential.py" ;
        ns2:hasDecorator ns337:test_matches_owlapi.decorator.0, ns337:test_matches_owlapi.decorator.1 ;
        ns2:hasParameter ns337:test_matches_owlapi.param.case, ns337:test_matches_owlapi.param.request ;
        ns2:lineEnd 49 ;
        ns2:lineStart 23 ;
        ns2:signature "def test_matches_owlapi(case, request)" .

    ns337:test_matches_owlapi.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.manchester_conformance" ;
        ns2:position 0 .

    ns337:test_matches_owlapi.decorator.1 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('case', GOLDEN_CASES, ids=lambda c: c.id)" ;
        ns2:position 1 .

    ns337:test_matches_owlapi.param.case a ns2:Parameter ;
        rdfs:label "case" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns337:test_matches_owlapi.param.request a ns2:Parameter ;
        rdfs:label "request" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns337:test_oracle_reject_registry_has_no_stale_entries dcterms:identifier "tests.starontology.manchester_conformance.test_mc_differential.test_oracle_reject_registry_has_no_stale_entries" ;
