GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_remote_decompose.py> {
    ns111:test_remote_decompose.py dcterms:identifier "tests.graph.unit.test_remote_decompose" ;
        a ns2:Module ;
        rdfs:comment """Unit tests for starlayer.graph.query.remote_decompose - the mechanism that lets
    a query depending on starlayer.graph's own custom SPARQL functions (TT_HASH_FN,
    the SUBJECT/PREDICATE/OBJECT accessors, STRLANGDIR) still run against a
    genuinely remote store, by stripping every algebra node that depends on one
    of those functions and re-evaluating it locally against each result row.

    Regression coverage for a real bug found via live Fuseki testing while
    scoping the removal of starlayer.graph's old text-based SPARQL 1.2 rewriter: the
    new starlayer.sparql-based pipeline can lower a non-ground triple-term
    pattern's predicate constraint into a bare
    ``FILTER(PREDICATE(?tt) = :knows)`` - a custom-function call directly
    inside a Filter's own expression, not wrapped in an Extend/BIND the way
    every case this module was originally built against used. Sent to a real
    remote engine as-is, that FILTER raises on the unknown function and SPARQL's
    own FILTER semantics exclude the row - silently, no exception, every row
    gone. decompose_for_remote() must strip that Filter too, not just Extend
    nodes, and re-check its condition locally per row after the round trip.""" ;
        rdfs:label "test_remote_decompose" ;
        ns2:declares ns239:test_non_ground_triple_term_pattern_strips_filter_not_just_extend, ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows, ns239:_prepare, ns239:test_row_passes_filters_empty_list_is_always_true, ns239:test_ground_pattern_needs_no_filter_stripping ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        ns2:importsModule ns4:__future__, ns4:rdflib .

    ns239:_prepare dcterms:identifier "tests.graph.unit.test_remote_decompose._prepare" ;
        a ns2:Function ;
        rdfs:label "_prepare" ;
        ns2:calls ns34:prepare_query_cached ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        ns2:hasParameter ns239:_prepare.param.query_text ;
        ns2:isPrivate true ;
        ns2:lineEnd 36 ;
        ns2:lineStart 34 ;
        ns2:signature "def _prepare(query_text: str)" .

    ns239:_prepare.param.query_text a ns2:Parameter ;
        rdfs:label "query_text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns239:test_ground_pattern_needs_no_filter_stripping dcterms:identifier "tests.graph.unit.test_remote_decompose.test_ground_pattern_needs_no_filter_stripping" ;
        a ns2:Function ;
        rdfs:comment """A ground triple-term pattern lowers to a plain BGP triple with a
    literal tt:HASH URIRef term (no Extend/Filter/custom-function call
    involved at all - see lower_rdf11.py's own _lower_pattern_term
    docstring) - decompose_for_remote should find nothing to strip.""" ;
        rdfs:label "test_ground_pattern_needs_no_filter_stripping" ;
        ns2:calls ns43:decompose_for_remote, ns239:_prepare ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        ns2:lineEnd 127 ;
        ns2:lineStart 111 ;
        ns2:signature "def test_ground_pattern_needs_no_filter_stripping()" .

    ns239:test_non_ground_triple_term_pattern_strips_filter_not_just_extend dcterms:identifier "tests.graph.unit.test_remote_decompose.test_non_ground_triple_term_pattern_strips_filter_not_just_extend" ;
        a ns2:Function ;
        rdfs:comment """The actual regression: FILTER(PREDICATE(?tt) = :knows) must be
    stripped, and the algebra must contain no custom-function call
    afterward - otherwise it's unsafe to send to a remote store at all.""" ;
        rdfs:label "test_non_ground_triple_term_pattern_strips_filter_not_just_extend" ;
        ns2:calls ns43:decompose_for_remote, ns43:contains_custom_function_call, ns239:_prepare ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        ns2:lineEnd 57 ;
        ns2:lineStart 39 ;
        ns2:signature "def test_non_ground_triple_term_pattern_strips_filter_not_just_extend()" .

    ns239:test_row_passes_filters_empty_list_is_always_true dcterms:identifier "tests.graph.unit.test_remote_decompose.test_row_passes_filters_empty_list_is_always_true" ;
        a ns2:Function ;
        rdfs:label "test_row_passes_filters_empty_list_is_always_true" ;
        ns2:calls ns43:row_passes_filters ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        ns2:lineEnd 131 ;
        ns2:lineStart 130 ;
        ns2:signature "def test_row_passes_filters_empty_list_is_always_true()" .

    ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows dcterms:identifier "tests.graph.unit.test_remote_decompose.test_stripped_filter_recipe_correctly_excludes_non_matching_rows" ;
        a ns2:Function ;
        rdfs:comment """End-to-end simulation of what StarLayerGraph.query() does with the
    decomposed recipes/filters against raw (unrestored) remote result rows -
    a row whose triple-term predicate doesn't match must be excluded, one
    that does match must survive.""" ;
        rdfs:label "test_stripped_filter_recipe_correctly_excludes_non_matching_rows" ;
        ns2:calls ns43:decompose_for_remote, ns43:row_passes_filters, ns7:remember_tt_hash, ns7:term_key, ns239:_prepare, ns7:tt_hash, ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri, ns43:evaluate_recipes_locally ;
        ns2:declares ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        ns2:lineEnd 108 ;
        ns2:lineStart 60 ;
        ns2:signature "def test_stripped_filter_recipe_correctly_excludes_non_matching_rows()" .

    ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri dcterms:identifier "tests.graph.unit.test_remote_decompose.test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri" ;
        a ns2:Function ;
        rdfs:label "_make_tt_uri" ;
        ns2:calls ns7:remember_tt_hash, ns7:term_key, ns7:tt_hash ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_remote_decompose.py" ;
        ns2:hasParameter ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.s, ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.o, ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.p ;
        ns2:isPrivate true ;
        ns2:lineEnd 96 ;
        ns2:lineStart 93 ;
        ns2:signature "def _make_tt_uri(s, p, o)" .

    ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.o a ns2:Parameter ;
        rdfs:label "o" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns239:test_stripped_filter_recipe_correctly_excludes_non_matching_rows._make_tt_uri.param.p a ns2:Parameter ;
