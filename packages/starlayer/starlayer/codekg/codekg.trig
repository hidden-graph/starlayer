    ns97:test_extract_subgraph.py dcterms:identifier "tests.shacl.integration.test_extract_subgraph" ;
        a ns2:Module ;
        rdfs:comment """Regression coverage for starlayer.shacl.extract_subgraph() - see
    starlayer.shacl/subgraph_extraction.py's module docstring for the full design
    (agreed with the user across several turns before implementation: multi-hop
    paths keep every intervening triple with cycle detection, nested/referenced
    shapes are included recursively, only the branch that actually passed is
    included for sh:or/sh:xone, ambiguous "at least one" requirements widen to
    include every satisfying candidate rather than picking an arbitrary one,
    and only real stored triples are ever included).""" ;
        rdfs:label "test_extract_subgraph" ;
        ns2:declares ns140:_graph, ns140:_closes, ns140:TestMultiHopPaths, ns140:TestQualifiedValueShapeDeterminism, ns140:TestNoShapesGraphFallsBackToDataGraph, ns140:TestWholeShapesGraphExtraction, ns140:TestBasicExtractionAndAcceptanceTest, ns140:TestLogicalConstraints, ns140:TestCloseShape, ns140:TestNestedShapes ;
