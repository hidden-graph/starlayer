    ns7:restore_select_bindings dcterms:identifier "starlayer.graph.model.encoding.restore_select_bindings" ;
        a ns2:Function ;
        rdfs:comment """Post-process a SPARQL SELECT rdflib.query.Result in place: drop rows
    that are purely internal encoding infrastructure, and restore any
    tt:HASH URIRef/dirlang: Literal in the surviving rows to its public
    TripleTerm/DirLangString form via restore_fn - then canonicalize any
    numeric literal's lexical form (see canonicalize_query_result_value)
    now that it's a real value rather than an opaque tt:HASH URI.

    Shared by StarLayerGraph.query() (restore_fn=self._restore, which looks
    up a single graph's own registry) and StarLayerDataset.query()
    (restore_fn=self._restore_any, which searches every cached graph's
    registry) - the row-filtering and restoration shape is identical between
    the two; only how a tt:HASH URIRef gets resolved back to a TripleTerm
    differs, which is exactly what restore_fn parameterizes.

    A row is dropped when it contains both a TT_NS-prefixed URIRef and one of
    the rdf:subject/predicate/object encoding predicates as *values* - such a
    row exists only because a query pattern incidentally matched the raw
    encoding triples (e.g. an unconstrained ``?s ?p ?o``), not because the
    caller asked about them.""" ;
        rdfs:label "restore_select_bindings" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:restore_select_bindings.param.r, ns7:restore_select_bindings.param.restore_fn ;
        ns2:hasReturnValue ns7:restore_select_bindings.returns ;
        ns2:lineEnd 326 ;
        ns2:lineStart 292 ;
        ns2:signature "def restore_select_bindings(r: Result, restore_fn: Callable[[Any], Any]) -> None" .

    ns7:restore_select_bindings.param.r a ns2:Parameter ;
        rdfs:comment "The SPARQL SELECT result to post-process in place." ;
        rdfs:label "r" ;
        ns2:annotationText "Result" ;
        ns2:hasType ns4:rdflib.query.Result ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:restore_select_bindings.param.restore_fn a ns2:Parameter ;
        rdfs:comment "Resolves one binding value (e.g. a tt:HASH URIRef or a dirlang Literal) to its public form, looking it up in whichever registry/registries the caller's graph or dataset maintains." ;
        rdfs:label "restore_fn" ;
        ns2:annotationText "Callable[[Any], Any]" ;
        ns2:hasType ns4:collections.abc.Callable, ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns7:restore_select_bindings.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns7:term_key dcterms:identifier "starlayer.graph.model.encoding.term_key" ;
        a ns2:Function ;
        rdfs:comment """Canonical string form of an RDF term for use as one of tt_hash's
    three inputs.

    Uses .n3(), not plain str() - str(Literal(...)) always returns just
    the lexical form, dropping language tag/datatype, so two distinct
    literals can collide. Checks isinstance(term, Node) rather than
    isinstance(term, str) because every rdflib term type is itself a
    str subclass.""" ;
        rdfs:label "term_key" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:term_key.param.term ;
        ns2:hasReturnValue ns7:term_key.returns ;
        ns2:lineEnd 58 ;
        ns2:lineStart 40 ;
        ns2:signature "def term_key(term: Node) -> str" .

    ns7:term_key.param.term a ns2:Parameter ;
        rdfs:comment "The RDF term (must be a Node, not a bare str)." ;
        rdfs:label "term" ;
        ns2:annotationText "Node" ;
        ns2:hasType ns4:rdflib.term.Node ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:term_key.returns a ns2:ReturnValue ;
        rdfs:comment "The term's N3-serialized canonical string form." ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

    ns7:tt_hash dcterms:identifier "starlayer.graph.model.encoding.tt_hash" ;
        a ns2:Function ;
        rdfs:comment """Return a 16-hex-char content-addressed ID for a triple term.

    Inputs are the canonical string representations of the resolved nodes
    (full URIs, bnode IDs, or literal N3 strings). Nested triple terms
    contribute their full TT_NS URI as the s/o string, so nesting is
    reflected in the hash.

    16 hex chars = 64 bits, keeping birthday-bound collision risk negligible
    even for graphs with heavy reification (an 8-char/32-bit prefix becomes
    non-negligible around ~65,000 distinct triple terms in one process - a
    plausible count for this library's primary use case). The hash is safe
    to change without a migration story: it is recomputed fresh from content
    on every intern, never persisted as a stable external identifier - every
    RDF 1.2 serializer emits <<( )>> syntax, never a raw tt:HASH URI.""" ;
        rdfs:label "tt_hash" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:tt_hash.param.o_str, ns7:tt_hash.param.p_str, ns7:tt_hash.param.s_str ;
        ns2:hasReturnValue ns7:tt_hash.returns ;
        ns2:lineEnd 87 ;
        ns2:lineStart 61 ;
        ns2:signature "def tt_hash(s_str: str, p_str: str, o_str: str) -> str" .

    ns7:tt_hash.param.o_str a ns2:Parameter ;
        rdfs:comment "Canonical string form of the triple term's resolved object." ;
        rdfs:label "o_str" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns7:tt_hash.param.p_str a ns2:Parameter ;
        rdfs:comment "Canonical string form of the triple term's resolved predicate." ;
        rdfs:label "p_str" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns7:tt_hash.param.s_str a ns2:Parameter ;
        rdfs:comment "Canonical string form of the triple term's resolved subject." ;
        rdfs:label "s_str" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:tt_hash.returns a ns2:ReturnValue ;
        rdfs:comment "A 16-character hexadecimal digest derived from (s_str, p_str, o_str)." ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

