        rdfs:label "data_graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns92:_preflight.returns a ns2:ReturnValue ;
        ns2:annotationText "list[tuple]" ;
        ns2:hasType ns4:builtins.list, ns4:builtins.tuple .

