    ns28:StarLayerGraph.query dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.query" ;
        a ns2:Method ;
        rdfs:comment """Execute a SPARQL query. Triple-term patterns are rewritten to SPARQL 1.1.

    The rewritten query runs against a plain Graph view of the same store so
    that encoding triples (rdf:subject/predicate/object on tt: URIRefs) are
    visible to the SPARQL engine. TripleTerm/tuple values in ``initBindings``
    are encoded to their internal tt:HASH URIRef first, the same way every
    other read path in this class resolves triple terms before matching
    against the store. Results are post-processed to restore tt:HASH
    URIRefs back to TripleTerm objects.

    For the native rdf-1.2 backend the query is routed through
    starlayer.graph.backends.native.native_query, which uses the endpoint's
    own triple-term syntax.

    Unlike ``infer()``, which always materializes a new graph, every
    ``entailment=`` value here does its work at query time with no
    copy of ``self``'s own data: a plain query rewrite for
    ``ENTAILMENT.RDF``/``ENTAILMENT.RDFS``, or a live union of ``self``
    with a small cached delta (never a full copy of ``self``) for
    ``ENTAILMENT["OWL-RDF-Based"]``/``ENTAILMENT["OWL-Direct"]``.""" ;
        rdfs:label "query" ;
        ns2:calls ns34:store_accepts_prepared_query, ns28:StarLayerGraph._infer_before_and_delta, ns43:contains_custom_function_call, ns28:StarLayerGraph._before_and_delta_for, ns34:prepare_query_cached, ns43:row_passes_filters, ns43:decompose_for_remote, ns43:evaluate_recipes_locally, ns7:restore_select_bindings, ns28:StarLayerGraph.infer, ns7:inject_missing_tt_encoding, ns38:native_query, ns28:StarLayerGraph.from_rdflib, ns28:StarLayerGraph._encode_init_bindings ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        ns2:hasParameter ns28:StarLayerGraph.query.param.initNs, ns28:StarLayerGraph.query.param.infer, ns28:StarLayerGraph.query.param.kwargs, ns28:StarLayerGraph.query.param.timeout, ns28:StarLayerGraph.query.param.result, ns28:StarLayerGraph.query.param.use_store_provided, ns28:StarLayerGraph.query.param.processor, ns28:StarLayerGraph.query.param.entailment, ns28:StarLayerGraph.query.param.engine, ns28:StarLayerGraph.query.param.initBindings, ns28:StarLayerGraph.query.param.query_object ;
        ns2:hasReturnValue ns28:StarLayerGraph.query.returns ;
        ns2:instantiates ns28:_UnionForQuery, ns71:_AlgebraTranslator11 ;
        ns2:lineEnd 2531 ;
        ns2:lineStart 2121 ;
        ns2:signature "def query(self, query_object, processor='sparql', result='sparql', initNs=None, initBindings=None, use_store_provided=True, entailment=None, infer: str='changed', engine: str='hermit', timeout=_OWL_DL_TIMEOUT_DEFAULT, **kwargs) -> Result" .

    ns28:StarLayerGraph.query.param.engine a ns2:Parameter ;
        rdfs:comment "Only meaningful when ``entailment=ENTAILMENT[\"OWL-Direct\"]``; passing a non-default value with any other ``entailment=`` raises ``ValueError`` (fail loudly rather than let a caller believe it silently did something for a different regime). ``\"hermit\"`` (default) or ``\"rustdl\"`` - see ``infer()``'s own docstring for the full ``engine=``/ ``timeout=`` contract." ;
        rdfs:label "engine" ;
        ns2:annotationText "str" ;
        ns2:defaultValue "'hermit'" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 8 .

    ns28:StarLayerGraph.query.param.entailment a ns2:Parameter ;
        rdfs:comment "``None`` (default, plain simple entailment), ``ENTAILMENT.RDF`` (query-time RDF entailment rewrite - see ``starlayer.sparql.entailment_rdf``; not available against the native backend), ``ENTAILMENT.RDFS`` (query-time RDFS rewrite - see ``starlayer.sparql.entailment_rdfs``; not available against the native backend), ``ENTAILMENT[\"OWL-RDF-Based\"]`` (queries the live union of ``self`` and a small cached delta of just its newly-entailed triples - see ``infer(mode=\"delta\")`` and the ``infer`` parameter below), ``ENTAILMENT[\"OWL-Direct\"]`` (OWL 2 DL's counterpart to ``ENTAILMENT[\"OWL-RDF-Based\"]`` - the SPARQL Entailment Regimes spec's own name for OWL-Direct-Semantics-backed querying: same live-union-with-a-cached-delta design, but the delta comes from ``infer(entailment=ENTAILMENT[\"OWL-Direct\"], engine=..., mode=\"delta\")`` - see ``infer()``'s own docstring for the full ``engine=``/``timeout=`` contract and what each engine guarantees. Tableau DL reasoning is routinely orders of magnitude slower than ``owlrl``'s forward-chaining, so ``infer=\"changed\"`` bounds how *often* this cost is paid, not how *expensive* any single recomputation is - for a latency-sensitive caller, materialize once ahead of time via ``infer(entailment=ENTAILMENT[\"OWL-Direct\"], mode=\"in-place\"/\"full\")`` instead and query the result plainly; reserve this regime for when live freshness is genuinely worth the cost. Raises ``starlayer.graph.graph.owl_dl.InconsistentOntologyError`` uncaught if ``self``'s data is logically inconsistent, unlike ``ENTAILMENT[\"OWL-RDF-Based\"]``'s partial/silent consistency checking), or ``\"native\"`` (only legal with ``backend='rdf-1.2'`` - a self-documenting label for \"this endpoint is expected to handle entailment itself\"; changes no behavior on that path, since ``native_query()`` already sends text straight through unmodified regardless of this value - see ``docs/fuseki-reasoning-setup.md`` for actually configuring an endpoint that makes it meaningful). A per-call choice, not a graph-level setting - the same graph can be queried with different (or no) entailment on different calls." ;
        rdfs:label "entailment" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 6 .

    ns28:StarLayerGraph.query.param.infer a ns2:Parameter ;
        rdfs:comment "Only consulted when ``entailment=ENTAILMENT[\"OWL-RDF-Based\"]`` or ``entailment=ENTAILMENT[\"OWL-Direct\"]``; ignored otherwise. Controls reuse of ``self``'s cached entailment delta (``self._owl_rl_cache`` for ``ENTAILMENT[\"OWL-RDF-Based\"]``; ``self._owl_dl_cache[engine]`` for ``ENTAILMENT[\"OWL-Direct\"]``, keyed per engine so switching ``engine=`` between calls doesn't invalidate the other engine's cached slot) against ``self._mutation_generation`` (bumped by ``_on_mutated()`` on every real edit to ``self`` - see ``VALID_INFER_MODES``): ``\"changed\"`` (default) recomputes only if ``self`` was edited since the cache was last computed; ``\"always\"`` ignores the cache and always recomputes; ``\"cached\"`` reuses whatever is cached if anything is, computing only when there's no cache yet. When ``self`` is non-native and has no triple terms, ``self``'s own data is always queried live regardless of this setting - only the entailed delta is subject to it. When ``self`` is native-backed or has triple terms, a snapshot of ``self``'s own data is refreshed on this same cadence too (see the ``ENTAILMENT[\"OWL-RDF-Based\"]`` branch's own comment for why)." ;
        rdfs:label "infer" ;
        ns2:annotationText "str" ;
        ns2:defaultValue "'changed'" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 7 .

    ns28:StarLayerGraph.query.param.initBindings a ns2:Parameter ;
        rdfs:comment "Initial variable bindings. A TripleTerm or (s, p, o) tuple value is encoded to its internal tt:HASH URIRef first, the same way every other read path resolves triple terms before matching against the store." ;
        rdfs:label "initBindings" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 4 .

    ns28:StarLayerGraph.query.param.initNs a ns2:Parameter ;
        rdfs:comment "Namespace bindings for the query; defaults to this graph's own bound namespaces." ;
        rdfs:label "initNs" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 3 .

    ns28:StarLayerGraph.query.param.kwargs a ns2:Parameter ;
