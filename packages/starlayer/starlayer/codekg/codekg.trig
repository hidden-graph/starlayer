GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/shacl/native_components.py> {
    ns74:native_components.py dcterms:identifier "starlayer.shacl.native_components" ;
        a ns2:Module ;
        rdfs:comment """Real pySHACL ``ConstraintComponent`` registrations for SHACL 1.2 Core
    predicates pySHACL doesn't implement.

    Every pySHACL constraint - including its own ``sh:not``/``sh:and``/``sh:or``/
    ``sh:xone`` composition operators - is dispatched through one module-level
    registry: ``pyshacl.constraints.CONSTRAINT_PARAMETERS_MAP``. Registering a
    predicate here means pySHACL's own ``Shape.validate()`` picks it up and
    evaluates it exactly like a core component, which is what makes composition
    with logical operators, ``sh:deactivated``, and ``sh:severity`` correct by
    construction, instead of needing to be reimplemented for every native pass
    (see ``docs/shacl12-gap-matrix.md``'s "Note on Architecture Direction",
    pattern 10, for the full rationale).

    Predicates whose value is itself a referenced shape (e.g. ``sh:someValue``)
    need one extra step: pySHACL's own shape-graph loader only auto-recognizes
    shape nodes reachable via a fixed, hardcoded list of predicates
    (``sh:property``, ``sh:node``, ``sh:not``, ``sh:qualifiedValueShape``, and
    ``sh:and``/``sh:or``/``sh:xone`` list members - see
    ``pyshacl/shapes_graph.py::ShapesGraph._build_node_shape_cache``, which does
    not consult the constraint-parameter registry at all). A value reached only
    via a newly-registered predicate like ``sh:someValue`` is invisible to that
    loader unless it's independently typed ``sh:NodeShape``/``sh:PropertyShape``.
    ``ensure_shape_typed`` below patches a copy of the shapes graph with that
    typing, the same augment-a-copy pattern already used for SHACL 1.2's new
    target types (``StarShaclSchema._augment_shapes_with_new_target_types``).""" ;
        rdfs:label "native_components" ;
        ns2:declares ns76:_matches_any_datatype_encoded, ns76:_build_node_by_expression_component, ns76:_build_class_component, ns76:_compares_favorably, ns76:_evaluate_shape_for_all_values, ns76:_build_single_line_component, ns76:_build_node_component, ns76:_lang_matches_range, ns76:_build_and_component, ns76:_cross_node_reachable_shapes, ns76:_build_qualified_value_shape_component, ns76:_build_property_pair_component, ns76:_build_unique_values_for_component, ns76:_PathEvalGraphAdapter, ns76:_build_closed_component, ns76:ensure_shape_typed, ns76:_build_unique_members_component, ns76:_is_encoded_triple_term, ns76:_build_xone_component, ns76:_build_member_shape_component, ns76:shape_reference_nodes, ns76:_build_root_class_component, ns76:_ambient_shapes_graph_prefixes, ns76:_build_subset_of_component, ns76:_is_subclass_of_or_self, ns76:_build_sparql_constraint_component, ns76:register_native_components, ns76:_build_node_kind_component, ns76:_build_max_list_length_component, ns76:_build_min_list_length_component, ns76:_effective_language_encoded, ns76:_effective_language_direction_key_encoded, ns76:_build_or_component, ns76:_build_reifier_shape_component, ns76:_get_tt_adapter, ns76:_build_unique_lang_component, ns76:_shape_needs_full_batch, ns76:_build_not_component, ns76:_matches_node_kind_encoded, ns76:_annotation_value, ns76:_build_some_value_component, ns76:_shapes_directly_composed_by, ns76:_result_annotation_triples, ns76:_build_all_property_pair_components, ns76:_build_language_in_component, ns76:_build_datatype_component, ns76:_build_property_constraint_component ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:importsModule ns4:__future__, ns4:rdflib, ns4:re, ns4:typing, ns4:weakref .

