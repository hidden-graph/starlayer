        ns2:calls ns94:get_conformance_profiles, ns94:_resource_iri, ns94:_bind_dataset_namespaces ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/starontology/__init__.py" ;
