    ns38:native_update dcterms:identifier "starlayer.graph.backends.native.native_update" ;
        a ns2:Function ;
        rdfs:comment """Execute a SPARQL UPDATE directly against a native-backend HTTP store,
    bypassing rdflib's own store dispatch entirely.

    Needed not just for the rdf-1.2 backend (which understands the update
    text unmodified) but also for any *rdf-1.1* dataset backed by a remote
    store: rdflib's ``Dataset(store=...).update()`` always wraps the whole
    update text in an extra ``GRAPH <urn:x-rdflib:default> { }`` block
    (``SPARQLStore._is_contextual()`` doesn't recognize ``Dataset``'s
    default-graph sentinel as exempt - it's a URIRef, which subclasses str,
    and only the literal string ``"__UNION__"`` is special-cased), which
    nests illegally around any update that already has its own
    ``GRAPH <uri> { }`` clause - the normal way to target a named graph from
    dataset-level SPARQL. Both Oxigraph and Fuseki reject the resulting
    double-nested GRAPH clause outright (HTTP 400), even for a plain
    ``INSERT DATA { GRAPH <uri> {...} }`` with no triple terms involved at
    all. Going straight over HTTP sidesteps rdflib's dispatch (and this
    bug) entirely, for both backends.""" ;
        rdfs:label "native_update" ;
        ns2:calls ns38:check_native_version_conformance, ns3:check_version_conformance, ns38:execute_update, ns41:strip_version_directive, ns71:update_to_rdf11, ns71:rdf11_update_to_sparql11_text, ns72:prepare_update_12, ns41:contains_triple_term ;
        ns2:filePath "packages/starlayer/starlayer/graph/backends/native.py" ;
        ns2:hasParameter ns38:native_update.param.backend, ns38:native_update.param.store, ns38:native_update.param.update_object ;
        ns2:hasReturnValue ns38:native_update.returns ;
        ns2:lineEnd 730 ;
        ns2:lineStart 658 ;
        ns2:signature "def native_update(store, backend: str, update_object: Any) -> None" .

    ns38:native_update.param.backend a ns2:Parameter ;
        rdfs:comment "The backend identifier - 'rdf-1.2' sends update_object straight through unmodified; any other value is treated as a remote rdf-1.1 endpoint and update_object is first lowered to plain SPARQL 1.1 text." ;
        rdfs:label "backend" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns38:native_update.param.store a ns2:Parameter ;
        rdfs:comment "The native-backend store to resolve HTTP endpoints from (see resolve_store_http())." ;
        rdfs:label "store" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns38:native_update.param.update_object a ns2:Parameter ;
        rdfs:comment "The SPARQL UPDATE text to execute." ;
        rdfs:label "update_object" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns38:native_update.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns38:new_graph_like dcterms:identifier "starlayer.graph.backends.native.new_graph_like" ;
        a ns2:Function ;
        rdfs:comment """A new, empty ``StarLayerGraph`` of the same kind as one backed by
    ``store`` - the "derived graphs are created like their source" rule.

    An in-process Oxigraph source gets a fresh, independent in-process
    Oxigraph (a new path-less ``pyoxigraph.Store``) with the same
    representation; anything else - the default in-memory store, a remote
    HTTP endpoint (a new remote database can't be minted from here), SQLAlchemy,
    etc. - gets an ordinary in-memory ``StarLayerGraph``, exactly as before.""" ;
        rdfs:label "new_graph_like" ;
        ns2:calls ns38:_in_process ;
        ns2:filePath "packages/starlayer/starlayer/graph/backends/native.py" ;
        ns2:hasParameter ns38:new_graph_like.param.store, ns38:new_graph_like.param.backend ;
