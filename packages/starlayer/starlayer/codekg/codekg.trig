        ns2:annotationText "None" ;
        ns2:optional true .

    ns299:_walk dcterms:identifier "starlayer.sparql._syntax_checks._walk" ;
        a ns2:Function ;
        rdfs:comment "Yield every ``CompValue`` under ``node`` (including ``node``)." ;
        rdfs:label "_walk" ;
        ns2:calls ns299:_walk ;
        ns2:filePath "packages/starlayer/starlayer/sparql/_syntax_checks.py" ;
        ns2:hasParameter ns299:_walk.param.node ;
