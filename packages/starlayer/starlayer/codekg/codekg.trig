        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns61:_terms_compatible.param.template_term a ns2:Parameter ;
        rdfs:comment "A term from a rule head's triple template." ;
        rdfs:label "template_term" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns61:_terms_compatible.returns a ns2:ReturnValue ;
        rdfs:comment "True if the two terms could refer to the same RDF term." ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool .

