        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns64:parse_ruleset.returns a ns2:ReturnValue ;
        rdfs:comment "The parsed, well-formed ``RuleSet``." ;
