GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_closed_by_types.py> {
    ns97:test_closed_by_types.py dcterms:identifier "tests.shacl.integration.test_closed_by_types" ;
        a ns2:Module ;
        rdfs:label "test_closed_by_types" ;
        ns2:declares ns252:test_sibling_shape_reached_via_target_class_extends_allowed_properties, ns252:test_violates_with_a_property_from_neither_shape, ns252:_violation_components, ns252:TestClosedMalformedValueRejectedCleanly, ns252:test_conforms_with_only_own_and_superclass_properties, ns252:test_linked_shape_via_sh_node_extends_allowed_properties ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_closed_by_types.py" ;
        ns2:importsModule ns4:pytest, ns4:rdflib .

    ns252:TestClosedMalformedValueRejectedCleanly dcterms:identifier "tests.shacl.integration.test_closed_by_types.TestClosedMalformedValueRejectedCleanly" ;
        a ns2:Class ;
        rdfs:comment """A non-boolean sh:closed value must raise a clean ValueError, not crash
    unpredictably or - the more dangerous case - be silently misinterpreted.
    Found 2026-07-20 while investigating a matching pySHACL bug (see
    docs/upstream-issues/pyshacl-upstream-issues.md, Issue 3): starShacl's own
    ClosedConstraintComponent shadow already rejected a non-Literal value
    (e.g. an IRI) cleanly, but a string literal like "false" was still
    silently coerced to closed=True - bool("false") is True in Python
    regardless of the string's content - the opposite of what "false" reads
    as. Checking the literal's actual xsd:boolean datatype (not just
    isinstance(..., Literal)) closes this.""" ;
        rdfs:label "TestClosedMalformedValueRejectedCleanly" ;
        ns2:declares ns252:TestClosedMalformedValueRejectedCleanly.test_iri_value_is_still_rejected_cleanly, ns252:TestClosedMalformedValueRejectedCleanly.test_real_boolean_true_still_works, ns252:TestClosedMalformedValueRejectedCleanly._shape, ns252:TestClosedMalformedValueRejectedCleanly.test_real_boolean_false_still_works, ns252:TestClosedMalformedValueRejectedCleanly._data, ns252:TestClosedMalformedValueRejectedCleanly.test_string_literal_false_is_rejected_not_silently_coerced_to_true ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_closed_by_types.py" ;
        ns2:lineEnd 172 ;
        ns2:lineStart 96 .

    ns252:TestClosedMalformedValueRejectedCleanly._data dcterms:identifier "tests.shacl.integration.test_closed_by_types.TestClosedMalformedValueRejectedCleanly._data" ;
