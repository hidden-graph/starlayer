    ns95:test_symbol_index.py dcterms:identifier "tests.codekg.unit.test_symbol_index" ;
        a ns2:Module ;
        rdfs:comment """Unit tests for starlayer.codekg.extractor.symbol_index.build_symbol_index()
    and SymbolIndex.resolve_method_in_chain().

    Every fixture is written under a synthetic repo_root's own
    packages/starlayer/starlayer/ tree (matching build_symbol_index()'s real,
    hard-coded root-relative convention - see module_identity()) - never a
    real project file, so each test is independent of this project's own
    actual source.""" ;
        rdfs:label "test_symbol_index" ;
        ns2:declares ns96:TestFunctionResolution, ns96:_write_test, ns96:TestResolveRoot, ns96:TestModuleIdentity, ns96:TestClassResolution, ns96:TestResolveMethodInChain, ns96:_write, ns96:TestGracefulDegradation ;
