        ns2:hasParameter ns103:portable_id.param.entry, ns103:portable_id.param.vendor_root ;
        ns2:hasReturnValue ns103:portable_id.returns ;
        ns2:lineEnd 29 ;
        ns2:lineStart 19 ;
        ns2:signature "def portable_id(entry: ManifestEntry, vendor_root: Path) -> str" .

    ns103:portable_id.param.entry a ns2:Parameter ;
