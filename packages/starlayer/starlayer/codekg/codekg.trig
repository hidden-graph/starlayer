GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py> {
    ns97:test_meta_shapes_extensions.py dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions" ;
        a ns2:Module ;
        rdfs:comment """Regression suite for starShacl's own meta-shacl preflight
    (``starlayer.shacl/meta_shapes.py``), which replaces reliance on pySHACL's own
    ``meta_shacl`` kwarg (confirmed to have no extension point - it always
    validates against its own hardcoded, process-cached ``shacl-shacl.pickle``).

    Two confirmed problems motivated this: 11 brand-new SHACL 1.2 predicates
    were silently under-validated (no rule at all), and 8 shadowed predicates
    whose value space SHACL 1.2 widened (list-valued sh:class/sh:datatype/
    sh:nodeKind, path-valued sh:equals/sh:disjoint/sh:lessThan/
    sh:lessThanOrEquals, sh:closed sh:ByTypes) were *actively rejected* by
    pySHACL's still-SHACL-1.0/1.1-era bundled meta-shapes, under starShacl's
    own default ``meta_shacl=True``.""" ;
        rdfs:label "test_meta_shapes_extensions" ;
        ns2:declares ns158:test_member_shape_value_must_be_a_node_shape_not_a_property_shape, ns158:TestRuleWellFormedness, ns158:TestConstraintComponentWellFormedness, ns158:test_too_strict_base_triples_absent_from_assembled_graph, ns158:test_allow_infos_on_validate_relaxes_info_severity_meta_shacl_check, ns158:TestSparqlWellFormedness, ns158:TestSparqlQueryStructureValidation, ns158:test_malformed_reification_required_now_caught, ns158:test_empty_sh_ignored_properties_now_caught, ns158:test_non_empty_sh_ignored_properties_and_language_in_still_pass, ns158:TestConditionWellFormedness, ns158:test_data_graph_with_owl_ontology_type_passes, ns158:test_malformed_unique_members_now_caught, ns158:test_empty_sh_in_list_now_caught, ns158:test_malformed_min_list_length_now_caught_cleanly_not_a_raw_crash, ns158:test_malformed_some_value_now_caught, ns158:test_pyshacl_own_base_meta_shapes_never_mutated, ns158:_triple_rule_shape, ns158:TestShuiWellFormedness, ns158:TestSparqlQueryTextValidation, ns158:test_empty_sh_xone_list_still_rejected_by_meta_shacl_even_with_allow_warnings, ns158:TestNodeExpressionWellFormedness, ns158:test_member_shape_value_as_a_node_shape_still_passes, ns158:test_malformed_subset_of_now_caught, ns158:_validate, ns158:test_malformed_member_shape_now_caught, ns158:test_meta_shacl_false_still_skips_preflight_entirely, ns158:test_meta_validate_reads_the_stored_file_and_the_library_has_no_build_code, ns158:test_malformed_single_line_now_caught, ns158:test_malformed_max_list_length_now_caught_cleanly_not_a_raw_crash, ns158:test_genuinely_malformed_shacl_11_shape_still_caught, ns158:test_well_formed_new_predicate_usage_still_passes, ns158:test_empty_sh_language_in_now_caught, ns158:test_load_meta_shapes_graph_returns_independent_copies, ns158:test_allow_warnings_on_validate_relaxes_warning_severity_meta_shacl_check, ns158:TestSparqlPrefixesWellFormedness, ns158:test_malformed_reifier_shape_now_caught, ns158:test_meta_validate_raises_reportable_runtime_error_with_expected_message, ns158:test_meta_shapes_extra_hook_enforced_end_to_end, ns158:test_empty_sh_xone_list_now_caught, ns158:test_malformed_unique_values_for_now_caught, ns158:test_data_graph_owl_imports_without_ontology_type_now_caught, ns158:test_malformed_root_class_now_caught, ns158:test_widened_shadowed_predicate_passes_default_meta_shacl, ns158:test_stored_meta_shapes_file_matches_a_fresh_build, ns158:test_non_empty_sh_in_and_xone_still_pass ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py" ;
        ns2:importsModule ns4:pytest, ns4:rdflib, ns4:build_meta_shapes .

    ns158:TestConditionWellFormedness dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions.TestConditionWellFormedness" ;
        a ns2:Class ;
        rdfs:comment """sh:condition's value has a stricter requirement than sh:someValue/
    sh:memberShape/sh:reifierShape: unlike those three (auto-typed by
    starlayer.shacl.native_components.SHAPE_EXPECTING_PREDICATES before pySHACL
    runs), sh:condition's value is NOT auto-typed - pySHACL's own
    lookup_shape_from_node requires it to already be explicitly
    `a sh:NodeShape`/`a sh:PropertyShape`, confirmed via a live
    apply_rules() reproduction that raises RuleLoadError otherwise. The
    meta-shacl rule (stsh:ExplicitlyTypedShapeReferenceShape) mirrors that
    real runtime requirement exactly.""" ;
        rdfs:label "TestConditionWellFormedness" ;
        ns2:declares ns158:TestConditionWellFormedness.test_list_of_explicitly_typed_conditions_passes, ns158:TestConditionWellFormedness.test_untyped_condition_passes_meta_validate_standalone, ns158:TestConditionWellFormedness.test_reference_to_a_non_shape_vacuously_conforms_consistent_with_other_shape_referencing_predicates, ns158:TestConditionWellFormedness.test_explicitly_typed_condition_passes ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py" ;
        ns2:lineEnd 1051 ;
        ns2:lineStart 955 .

    ns158:TestConditionWellFormedness.test_explicitly_typed_condition_passes dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions.TestConditionWellFormedness.test_explicitly_typed_condition_passes" ;
