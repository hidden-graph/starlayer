        rdfs:comment "The TriX 1.2 document text to parse." ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns23:parse_trix12.returns a ns2:ReturnValue ;
        rdfs:comment "A list of (s, p, o) triples from every graph in the document." ;
        ns2:annotationText "list[tuple]" ;
        ns2:hasType ns4:builtins.tuple, ns4:builtins.list .

    ns23:parse_trix12_named dcterms:identifier "starlayer.graph.parsers.trix12.parse_trix12_named" ;
        a ns2:Function ;
        rdfs:comment """Parse TriX 1.2 text; return list of (graph_id, triples).

    Subjects and objects may be TripleTerm instances.""" ;
        rdfs:label "parse_trix12_named" ;
