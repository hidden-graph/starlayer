GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/starontology/manchester_conformance/grammar.py> {
    ns334:grammar.py dcterms:identifier "tests.starontology.manchester_conformance.grammar" ;
        a ns2:Module ;
        rdfs:comment """The W3C Manchester Syntax grammar as data: the spine of the coverage matrix.

    ``PRODUCTIONS`` is loaded from ``vendor/owl2-manchester-productions.json`` (see
    ``vendor/VENDORED_FROM.md`` for provenance). ``LABELLED_ALTERNATIVES`` are the note's named
    alternatives inside ``restriction``, which the note marks up as anchors but not as productions.""" ;
        rdfs:label "grammar" ;
        ns2:declares ns342:_list_instantiations ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/grammar.py" ;
        ns2:importsModule ns4:__future__, ns4:re, ns4:json, ns4:pathlib .

    ns342:_list_instantiations dcterms:identifier "tests.starontology.manchester_conformance.grammar._list_instantiations" ;
        a ns2:Function ;
        rdfs:comment """Names like ``descriptionAnnotatedList`` / ``individual2List`` / ``literalList``: the note defines
    three list templates once (``<NT>List``, ``<NT>2List``, ``<NT>AnnotatedList``) and the other
    productions use their instantiations without defining them. Each instantiation is its own row, so a
    list form that no case exercises is visible rather than waved through.""" ;
        rdfs:label "_list_instantiations" ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/grammar.py" ;
        ns2:hasReturnValue ns342:_list_instantiations.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 41 ;
        ns2:lineStart 32 ;
        ns2:signature "def _list_instantiations() -> frozenset[str]" .

    ns342:_list_instantiations.returns a ns2:ReturnValue ;
        ns2:annotationText "frozenset[str]" ;
        ns2:hasType ns4:builtins.str, ns4:builtins.frozenset .

    ns4:__future__ a ns2:ExternalModule .

    ns4:builtins.frozenset dcterms:identifier "builtins.frozenset" ;
        a ns2:ExternalType ;
        rdfs:label "frozenset" ;
        rdfs:subClassOf ns2:Type .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a ns2:ExternalType ;
        rdfs:label "str" ;
        rdfs:subClassOf ns2:Type .

    ns4:json a ns2:ExternalModule .

