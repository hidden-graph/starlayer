GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/sqe/shapes.py> {
    ns65:shapes.py dcterms:identifier "starlayer.sparql.sqe.shapes" ;
        a ns2:Module ;
        rdfs:comment """SHACL validation for ``sqe:`` graphs - thin wrapper combining this
    vocabulary's own hand-authored shapes (``sqe_shapes.ttl``) with ``salg:``'s
    existing shapes/ontology, since ``sqe:Filter``/``sqe:Bind`` reference
    ``salg:ExpressionShape`` by name (``sh:node``) - that shape's own
    *definition* has to be present in the shapes graph being validated
    against, not just its ontology class for RDFS reasoning.

    No public ``ontology_graph()``/``shapes_graph()`` of its own - same choice
    ``srl.py`` already made ("to avoid two paths to the same two graphs"; see
    that module's own comment) and the same reason Manchester doesn't have
    them either (`starontology.get_ontology_graph("sqe_owl")`/`"sqe_shacl"`
    is the one real path to those graphs). ``sqe_validate()`` combines them
    privately below.""" ;
        rdfs:label "shapes" ;
        ns2:declares ns69:sqe_validate, ns69:_shapes_graph, ns69:_ontology_graph ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/sqe/shapes.py" ;
        ns2:importsModule ns4:warnings, ns4:rdflib, ns4:__future__ .

    ns69:_ontology_graph dcterms:identifier "starlayer.sparql.sqe.shapes._ontology_graph" ;
        a ns2:Function ;
        rdfs:comment """A fresh ``rdflib.Graph`` combining ``sqe:``'s own RDFS ontology
    with ``salg:``'s - needed for the same ``sh:node salg:ExpressionShape``
    etc. RDFS-subclass entailment ``salg:``'s own ``validate_query()``
    already depends on (see that function's docstring).""" ;
        rdfs:label "_ontology_graph" ;
        ns2:calls ns60:ontology_graph ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/sqe/shapes.py" ;
        ns2:hasReturnValue ns69:_ontology_graph.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 50 ;
        ns2:lineStart 39 ;
        ns2:signature "def _ontology_graph() -> Graph" .

    ns69:_ontology_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph .

    ns69:_shapes_graph dcterms:identifier "starlayer.sparql.sqe.shapes._shapes_graph" ;
        a ns2:Function ;
        rdfs:comment """A fresh ``rdflib.Graph`` combining ``sqe:``'s own shapes with
    ``salg:``'s (SHACL graphs are mutated by pyshacl during validation, so
    callers get their own copy rather than a shared module-level
    instance).""" ;
        rdfs:label "_shapes_graph" ;
        ns2:calls ns47:shapes_graph ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/sqe/shapes.py" ;
        ns2:hasReturnValue ns69:_shapes_graph.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 36 ;
        ns2:lineStart 27 ;
        ns2:signature "def _shapes_graph() -> Graph" .

    ns69:_shapes_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph .

    ns69:sqe_validate dcterms:identifier "starlayer.sparql.sqe.shapes.sqe_validate" ;
        a ns2:Function ;
        rdfs:comment """Validate ``data_graph`` (e.g. from ``to_rdf.sqe_parse_to_tree``, or
    an LLM-/UI-authored ``sqe:`` graph not yet decoded) against the shapes
    above.

    Goes through ``starlayer.shacl``, never bare ``pyshacl`` - same reason
    ``salg:``'s own ``validate_query()`` does: a ``sqe:`` graph may embed
    genuine RDF 1.2 content (a triple-term-valued term, via the ``salg:``
    fallback boundary) that only ``starlayer.shacl`` understands correctly.""" ;
        rdfs:label "sqe_validate" ;
        ns2:calls ns69:_shapes_graph, ns69:_ontology_graph ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/sqe/shapes.py" ;
        ns2:hasParameter ns69:sqe_validate.param.data_graph ;
        ns2:hasReturnValue ns69:sqe_validate.returns ;
        ns2:lineEnd 84 ;
        ns2:lineStart 53 ;
        ns2:signature "def sqe_validate(data_graph: Graph) -> tuple[bool, Graph, str]" .

    ns69:sqe_validate.param.data_graph a ns2:Parameter ;
        rdfs:comment "The ``sqe:`` RDF graph to validate." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns69:sqe_validate.returns a ns2:ReturnValue ;
        rdfs:comment "A ``(conforms, report_graph, report_text)`` tuple." ;
        ns2:annotationText "tuple[bool, Graph, str]" ;
        ns2:hasType ns4:builtins.str, ns4:builtins.tuple, ns4:rdflib.graph.Graph, ns4:builtins.bool .

    ns4:__future__ a ns2:ExternalModule .

