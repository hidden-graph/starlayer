GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_native_backend_oxigraph.py> {
    ns97:test_native_backend_oxigraph.py dcterms:identifier "tests.shacl.integration.test_native_backend_oxigraph" ;
        a ns2:Module ;
        rdfs:comment """Integration tests for StarShaclSchema against a StarLayerGraph running
    the native RDF 1.2 backend (``backend='rdf-1.2'``, e.g. Oxigraph) - as
    opposed to every other test in this suite, which uses either a plain
    ``rdflib.Graph`` or the default ``backend='rdf-1.1'`` tt:HASH-encoded mode.

    This is a real, previously-untested surface: `TripleTermAdapter.encode_graph()`
    (``starlayer.shacl/adapters.py``) has zero backend-awareness of its own - it relies
    entirely on ``StarLayerGraph``'s own promise that ``.triples()``/``.query()``
    yield the same Python-level term shapes (real ``TripleTerm`` objects, not
    raw encoded URIs) regardless of backend. Investigating this surfaced a real
    bug in ``starlayer.graph`` itself (fixed there, not here): ``StarLayerGraph.
    parse(format='turtle12'/'trig12')`` wrote the rdf-1.1 backend's own tt:HASH
    skolemized encoding fragments directly into the store for *any* backend,
    bypassing the backend-aware ``StarLayerGraph.add()`` override - so triple
    terms parsed from text (not added via the ``.add()`` Python API) never
    decoded correctly on a native-backend graph, and broke ``sh:reifierShape``/
    ``sh:reificationRequired`` end to end (the discovery path: a reifier
    correctly reifying the outer ``(focus, path, value)`` triple silently failed
    to be found).

    Requires a running Oxigraph instance:
        docker run -d --name oxigraph-test -p 7878:7878 \\
          ghcr.io/oxigraph/oxigraph serve --location /data --bind 0.0.0.0:7878""" ;
        rdfs:label "test_native_backend_oxigraph" ;
        ns2:declares ns208:test_apply_rules_with_meta_shacl_on_native_backend_conforming_shape, ns208:test_unique_values_for_conforms_when_no_duplicate_on_native_backend, ns208:test_global_sparql_rule_produces_triples_on_native_backend, ns208:_native_graph, ns208:test_meta_shacl_snapshots_a_remote_shapes_graph_to_in_memory, ns208:test_unique_values_for_duplicate_detection_on_native_backend, ns208:test_meta_shacl_reports_a_genuine_blank_node_violation_without_crashing, ns208:_oxigraph_available, ns208:test_reifier_shape_correctly_conforms_on_native_backend, ns208:test_apply_rules_works_in_default_rdf11_mode_against_remote_store, ns208:_validate, ns208:test_basic_triple_term_data_validates, ns208:test_bound_bnode_class_check_is_correct_on_native_backend, ns208:test_reifier_shape_violates_when_reifier_missing_on_native_backend, ns208:test_violation_report_correctly_restores_triple_term_value ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_native_backend_oxigraph.py" ;
        ns2:importsModule ns4:rdflib.plugins.stores.sparqlstore, ns4:pytest, ns4:rdflib, ns4:uuid, ns4:requests .

