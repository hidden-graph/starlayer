    ns42:parseQuery.param.q a ns2:Parameter ;
        rdfs:comment "The SPARQL 1.2 query string to parse." ;
        rdfs:label "q" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:parseQuery.returns a ns2:ReturnValue ;
        rdfs:comment "A pyparsing ``ParseResults`` tree — same type as ``rdflib.plugins.sparql.parser.parseQuery`` — with genuine ``TripleTermNode`` nodes wherever ``<<( s p o )>>``/ ``TRIPLE(s, p, o)`` appears, constructed directly by the grammar (see module docstring), not reassembled from a text-level encoding." ;
        ns2:annotationText "ParseResults" ;
        ns2:hasType ns4:pyparsing.results.ParseResults .

    ns42:parseUpdate dcterms:identifier "starlayer.graph.query.sparql_api.parseUpdate" ;
        a ns2:Function ;
        rdfs:comment """Parse a SPARQL 1.2 Update request string.

    A leading ``VERSION "label"`` directive is stripped first - see
    ``parseQuery``'s own docstring.""" ;
        rdfs:label "parseUpdate" ;
        ns2:calls ns41:strip_version_directive, ns42:_check_version_conformance, ns72:parse_update_12 ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:parseUpdate.param.q ;
        ns2:hasReturnValue ns42:parseUpdate.returns ;
