GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/integration/test_cross_backend_parity.py> {
    ns155:test_cross_backend_parity.py dcterms:identifier "tests.graph.integration.test_cross_backend_parity" ;
        a ns2:Module ;
        rdfs:comment """tests/integration/test_cross_backend_parity.py

    Systematic behavioral parity checks: the same operation, run against the
    default in-memory (rdf-1.1) backend and against each live native (rdf-1.2)
    backend in turn, must produce the same observable result.

    This project's core value proposition is "identical behavior regardless of
    backend" (see docs/future_enhancements.md's "Cross-backend behavior parity"
    section), but until now that was only verified by a one-off script
    (three_way_compare.py) run manually in a scratch directory. It found 3 real
    bugs the first time it was run. This module checks in that methodology as a
    standing, reusable test rather than something that only runs when someone
    remembers to.

    Requires a running Fuseki and/or Oxigraph instance - see the docstrings in
    test_fuseki_backend.py / test_oxigraph_backend.py for the docker run
    commands. Each backend's scenarios skip independently if that backend isn't
    reachable, so this still provides value with only one of the two running.

    Run:
        .venv/bin/pytest tests/integration/test_cross_backend_parity.py -v""" ;
        rdfs:label "test_cross_backend_parity" ;
        ns2:declares ns156:_scenario_sparql_tt_pattern_match, ns156:_internal_graph, ns156:_oxigraph_available, ns156:test_internal_rejects_triple_term_as_subject_of_nested_reifier_shorthand, ns156:_scenario_is_triple_fn, ns156:_clear_http, ns156:_oxigraph_graph, ns156:_oxigraph_store_available, ns156:_scenario_nested_reifier_shorthand, ns156:test_oxigraph_store_matches_internal_for_numeric_lexical_form, ns156:_scenario_ceil_whole_number_decimal, ns156:_scenario_reifier_annotation_formal_pattern, ns156:_oxigraph_store_graph, ns156:test_oxigraph_matches_internal, ns156:_scenario_triple_term_subject_rejected, ns156:test_oxigraph_rejects_triple_term_as_subject_of_nested_reifier_shorthand, ns156:_scenario_construct_round_trip, ns156:_scenario_dirlang_functions, ns156:_scenario_plain_triple, ns156:test_fuseki_wrongly_accepts_triple_term_as_subject_of_nested_reifier_shorthand, ns156:_scenario_triple_term_write_read, ns156:test_oxigraph_matches_internal_for_numeric_lexical_form, ns156:_fuseki_available, ns156:_fuseki_graph, ns156:test_oxigraph_store_matches_internal, ns156:test_fuseki_matches_internal_for_numeric_lexical_form, ns156:test_fuseki_matches_internal, ns156:_scenario_division_whole_number_decimal, ns156:_scenario_dirlangstring_write_read, ns156:_scenario_triple_constructor_fn, ns156:ex, ns156:_scenario_strlangdir_invalid_direction, ns156:_scenario_nested_triple_term ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_cross_backend_parity.py" ;
