    ns96:TestClassResolution.test_cross_file_base_resolved_via_live_introspection dcterms:identifier "tests.codekg.unit.test_symbol_index.TestClassResolution.test_cross_file_base_resolved_via_live_introspection" ;
        a ns2:Method ;
        rdfs:comment """A base class imported from another file in the same project
    resolves to its real cross-module dotted path - the same
    types.resolve_type_name() machinery already used for annotations,
    applied here to a base-class expression, and its live-importlib
    fallback happens to also correctly resolve a genuine internal
    cross-module class, not just external ones. Uses this project's
    own real starlayer.codekg.extractor.imports module as the
    "cross-file base" being subclassed, since it needs to be something
    actually importable - a synthetic project module wouldn't be on
    sys.path.""" ;
        rdfs:label "test_cross_file_base_resolved_via_live_introspection" ;
        ns2:calls ns283:build_symbol_index, ns96:_write ;
        ns2:filePath "packages/starlayer/tests/codekg/unit/test_symbol_index.py" ;
        ns2:hasParameter ns96:TestClassResolution.test_cross_file_base_resolved_via_live_introspection.param.tmp_path ;
