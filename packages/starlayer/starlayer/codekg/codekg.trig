        rdfs:label "queryString" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:prepareQuery.returns a ns2:ReturnValue ;
        rdfs:comment "A compiled, directly executable ``Query`` object, usable with ``StarLayerGraph.query()`` or ``rdflib.Graph.query()``." ;
        ns2:annotationText "Query" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Query .

    ns42:prepareUpdate dcterms:identifier "starlayer.graph.query.sparql_api.prepareUpdate" ;
