        ns2:hasReturnValue ns35:_register_dirlang_string_functions._same_kind.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 349 ;
        ns2:lineStart 319 ;
        ns2:signature "def _same_kind(lexical, language, direction)" .

