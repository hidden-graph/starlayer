    ns57:query_to_ssyn_rdf dcterms:identifier "starlayer.sparql.to_ssyn_rdf.query_to_ssyn_rdf" ;
        a ns2:Function ;
        rdfs:comment """Encode a bare ``SELECT`` query's raw parse tree
