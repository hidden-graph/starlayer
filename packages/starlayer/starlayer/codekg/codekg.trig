GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/query/query_cache.py> {
    ns33:query_cache.py dcterms:identifier "starlayer.graph.query.query_cache" ;
        a ns2:Module ;
        rdfs:comment """Per-graph/dataset SPARQL query preparation cache.

    ``StarLayerGraph.query()`` and ``StarLayerDataset.query()`` both parse
    SPARQL 1.2 query text via ``starlayer.sparql``'s real grammar/algebra
    pipeline (``prepare_query_12`` -> ``query_to_rdf11`` -> ``rdf11_to_query``)
    on every call. Callers that evaluate the same query text repeatedly against
    an unmutated graph with only ``initBindings`` differing - the exact shape of
    pySHACL's own SHACL-AF rule/constraint evaluation, which calls ``.query()``
    once per focus node per rule per iteration - redo that parse+lower work
    every single time even though its result never changes between those calls.

    ``prepare_query_cached`` caches the parsed-and-lowered
    ``rdflib.plugins.sparql.sparql.Query`` object, keyed on the query text plus
    the *effective* namespace mapping and base IRI - both of which are baked
    into the parsed query at parse time (via ``prepare_query_12``'s own
    ``initNs``/``base`` passthrough to ``translateQuery``), so they're part of
    what makes two calls equivalent, not just the query text. Passing an
    already-prepared ``Query`` object instead of a string to ``Graph.query()``
    is a first-class, documented rdflib capability (``Store.query()``'s own
    type signature is ``Union[Query, str]``, and ``SPARQLProcessor.query()``
    branches on exactly this) for the *default* code path - but not every
    store honors that contract:
    ``rdflib.plugins.stores.sparqlstore.SPARQLStore``/``SPARQLUpdateStore``
    (used for any remote HTTP SPARQL endpoint, e.g. Fuseki) hard-require a
    plain string (``assert isinstance(query, str)`` in their own ``query()``),
    raising ``AssertionError`` rather than falling back gracefully. Callers
    must check ``store_accepts_prepared_query`` before deciding whether to use
    the cached prepared object directly, or serialize it back to text first
    (see ``StarLayerGraph.query()``'s own generalized remote-store handling).""" ;
        rdfs:label "query_cache" ;
        ns2:declares ns34:prepare_query_cached, ns34:store_accepts_prepared_query, ns34:_load_string_only_store_types ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/query_cache.py" ;
        ns2:importsModule ns4:collections.abc, ns4:typing, ns4:rdflib.plugins.sparql.sparql, ns4:__future__ .

    ns34:_load_string_only_store_types dcterms:identifier "starlayer.graph.query.query_cache._load_string_only_store_types" ;
        a ns2:Function ;
        rdfs:label "_load_string_only_store_types" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/query_cache.py" ;
        ns2:hasReturnValue ns34:_load_string_only_store_types.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 52 ;
        ns2:lineStart 49 ;
        ns2:signature "def _load_string_only_store_types() -> tuple[type, ...]" .

    ns34:_load_string_only_store_types.returns a ns2:ReturnValue ;
        ns2:annotationText "tuple[type, ...]" ;
        ns2:hasType ns4:builtins.tuple, ns4:builtins.type .

    ns34:prepare_query_cached dcterms:identifier "starlayer.graph.query.query_cache.prepare_query_cached" ;
        a ns2:Function ;
        rdfs:comment """Return a prepared SPARQL ``Query`` for ``query_text``, reusing a
    previous preparation from ``cache`` if the same
    (query text, effective namespaces, base, entailment) was seen before.""" ;
        rdfs:label "prepare_query_cached" ;
        ns2:calls ns49:rewrite_algebra_for_rdf, ns51:rewrite_algebra_for_rdfs, ns41:contains_triple_term, ns71:query_to_rdf11, ns71:rdf11_to_query, ns41:strip_version_directive, ns3:check_version_conformance, ns72:prepare_query_12 ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/query_cache.py" ;
        ns2:hasParameter ns34:prepare_query_cached.param.base, ns34:prepare_query_cached.param.query_text, ns34:prepare_query_cached.param.entailment, ns34:prepare_query_cached.param.effective_ns, ns34:prepare_query_cached.param.cache ;
        ns2:hasReturnValue ns34:prepare_query_cached.returns ;
        ns2:lineEnd 165 ;
        ns2:lineStart 79 ;
        ns2:signature "def prepare_query_cached(cache: dict[tuple[str, tuple, str | None, Any], Query], query_text: str, effective_ns: Mapping[str, Any] | None, base: str | None, entailment: Any=None) -> Query" .

    ns34:prepare_query_cached.param.base a ns2:Parameter ;
        rdfs:comment "The base IRI to parse against, baked into the cached ``Query`` the same way ``effective_ns`` is." ;
        rdfs:label "base" ;
        ns2:annotationText "str | None" ;
        ns2:hasType ns4:builtins.str ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 3 .

    ns34:prepare_query_cached.param.cache a ns2:Parameter ;
        rdfs:comment "The per-graph/dataset cache dict to read from and populate, keyed on (query text, sorted effective namespace pairs, base, entailment)." ;
        rdfs:label "cache" ;
        ns2:annotationText "dict[tuple[str, tuple, str | None, Any], Query]" ;
        ns2:hasType ns4:typing.Any, ns4:builtins.tuple, ns4:rdflib.plugins.sparql.sparql.Query, ns4:builtins.dict, ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns34:prepare_query_cached.param.effective_ns a ns2:Parameter ;
        rdfs:comment "The namespace mapping that will actually be used - the caller's explicit ``initNs``, or its own bound namespaces if none was given - not ``None`` standing in for \"resolve it later\"; a cache keyed before that resolution would miss real differences (or worse, reuse a stale mapping) if a graph's bound namespaces change between calls with the same query text." ;
        rdfs:label "effective_ns" ;
        ns2:annotationText "Mapping[str, Any] | None" ;
        ns2:hasType ns4:collections.abc.Mapping, ns4:builtins.str, ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns34:prepare_query_cached.param.entailment a ns2:Parameter ;
        rdfs:comment "``None`` (default, today's plain behavior) or ``ENTAILMENT.RDFS``/``ENTAILMENT.RDF`` (``starlayer.graph.graph.entailment_regimes``), which rewrites every BGP for the given entailment regime (see ``starlayer.sparql.entailment_rdfs``/``entailment_rdf`` for exactly which rules) once here, baked into the cached prepared object - not re-applied on every cache hit. Included in the cache key defensively, even though a given ``StarLayerGraph`` instance's ``entailment`` is fixed for its whole lifetime and this cache is per-instance (so in practice it never varies within one cache's lifetime today). Only these three values ever reach this function - ``query()``'s ``ENTAILMENT[\"OWL-RDF-Based\"]``/``ENTAILMENT[\"OWL-Direct\"]``/ ``\"native\"`` branches all return before calling it." ;
        rdfs:label "entailment" ;
        ns2:annotationText "Any" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 4 .

    ns34:prepare_query_cached.param.query_text a ns2:Parameter ;
        rdfs:comment "The raw SPARQL 1.2 query text (may still carry a leading ``VERSION`` directive - stripped here before parsing)." ;
        rdfs:label "query_text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns34:prepare_query_cached.returns a ns2:ReturnValue ;
        rdfs:comment "The prepared ``rdflib.plugins.sparql.sparql.Query`` object, from cache if present, otherwise freshly parsed and lowered then stored in ``cache`` before returning." ;
        ns2:annotationText "Query" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Query .

    ns34:store_accepts_prepared_query dcterms:identifier "starlayer.graph.query.query_cache.store_accepts_prepared_query" ;
        a ns2:Function ;
        rdfs:comment """Whether ``store``'s own ``query()`` (if it implements one - see
    ``Graph.query()``'s ``hasattr(self.store, "query")`` dispatch) can
    safely be handed a pre-parsed ``rdflib.plugins.sparql.sparql.Query``
    object instead of a plain string.""" ;
        rdfs:label "store_accepts_prepared_query" ;
        ns2:calls ns34:_load_string_only_store_types ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/query_cache.py" ;
        ns2:hasParameter ns34:store_accepts_prepared_query.param.store ;
        ns2:hasReturnValue ns34:store_accepts_prepared_query.returns ;
        ns2:lineEnd 76 ;
        ns2:lineStart 55 ;
        ns2:signature "def store_accepts_prepared_query(store: Any) -> bool" .

    ns34:store_accepts_prepared_query.param.store a ns2:Parameter ;
        rdfs:comment "The rdflib ``Store`` instance a query is about to be run against." ;
        rdfs:label "store" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns34:store_accepts_prepared_query.returns a ns2:ReturnValue ;
        rdfs:comment "``False`` for known string-only stores (``SPARQLStore``/ ``SPARQLUpdateStore``); ``True`` otherwise, including for the default in-memory ``Memory`` store, whose own ``query()`` just raises ``NotImplementedError`` and falls through to the generic ``SPARQLProcessor`` path, which does correctly accept a prepared ``Query`` object." ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool .

    ns4:__future__ a ns2:ExternalModule .

