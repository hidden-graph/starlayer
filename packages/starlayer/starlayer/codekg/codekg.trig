    ns111:test_turtle12_serializer.py dcterms:identifier "tests.graph.unit.test_turtle12_serializer" ;
        a ns2:Module ;
        rdfs:comment """Unit tests for starlayer.graph.serializers.turtle12.

    Each test parses a TTL 1.2 snippet, serializes it back, then re-parses the
    output and checks graph isomorphism — confirming a faithful round-trip.""" ;
