    ns76:_build_node_kind_component.NodeKindConstraintComponent dcterms:identifier "starlayer.shacl.native_components._build_node_kind_component.NodeKindConstraintComponent" ;
        a ns2:Class ;
        rdfs:comment """Shadows pySHACL's own ``NodeKindConstraintComponent`` to add
    SHACL 1.2's list-valued ``sh:nodeKind`` (only the four "pure" kinds -
    ``sh:IRI``/``sh:BlankNode``/``sh:Literal``/``sh:TripleTerm`` - are
    valid list members per spec; the combined forms like
    ``sh:BlankNodeOrIRI`` stay single-value-only). Delegates to a real
    instance of pySHACL's own component for the plain single-value case
    (byte-for-byte parity), except scalar ``sh:TripleTerm``, which is
    handled natively the same way as list-valued forms since pySHACL
    has no built-in concept of triple terms. Native evaluation uses
    ``_matches_node_kind_encoded`` with ``_is_encoded_triple_term`` to
    recognize a ``sh:TripleTerm``-kind value correctly, since a real
    triple term is already flattened into a plain content-addressed
    URI by the time this component's ``evaluate()`` sees it.""" ;
        rdfs:label "NodeKindConstraintComponent" ;
        rdfs:subClassOf ns4:pyshacl.constraints.constraint_component.ConstraintComponent ;
        ns2:declares ns76:_build_node_kind_component.NodeKindConstraintComponent.__init__, ns76:_build_node_kind_component.NodeKindConstraintComponent.constraint_name, ns76:_build_node_kind_component.NodeKindConstraintComponent.constraint_parameters, ns76:_build_node_kind_component.NodeKindConstraintComponent.evaluate ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:lineEnd 1790 ;
        ns2:lineStart 1711 .

