    ns76:_build_node_component.NodeConstraintComponent dcterms:identifier "starlayer.shacl.native_components._build_node_component.NodeConstraintComponent" ;
        a ns2:Class ;
        rdfs:comment """Shadows pySHACL's own ``NodeConstraintComponent`` - see
    ``AndConstraintComponent``'s docstring for the shared rationale.
    ``sh:node`` has the identical per-value-node recursion pattern as
    the four logical operators (see
    ``pyshacl/constraints/core/shape_based_constraints.py::
    NodeConstraintComponent._evaluate_node_shape``), so it needs the
    same fix. This is also the mechanism behind the ``sh:property``
    case: ``sh:property``'s own per-value recursion is left
    unpatched - its target must be a *property* shape, which
    ``sh:uniqueValuesFor`` can't sit on directly - but it hands each
    path value one at a time to the property shape's own
    ``sh:node``, which is what actually truncates the batch.
    Patching ``sh:node`` here covers that path too, at whatever
    depth it's reached from.""" ;
        rdfs:label "NodeConstraintComponent" ;
        rdfs:subClassOf ns4:pyshacl.constraints.constraint_component.ConstraintComponent ;
        ns2:declares ns76:_build_node_component.NodeConstraintComponent.constraint_name, ns76:_build_node_component.NodeConstraintComponent.evaluate, ns76:_build_node_component.NodeConstraintComponent.__init__, ns76:_build_node_component.NodeConstraintComponent.constraint_parameters, ns76:_build_node_component.NodeConstraintComponent._evaluate_node_shape_mixed, ns76:_build_node_component.NodeConstraintComponent.make_generic_messages ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/native_components.py" ;
