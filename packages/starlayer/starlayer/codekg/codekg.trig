GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/ntriples12.py> {
    ns11:ntriples12.py dcterms:identifier "starlayer.graph.parsers.ntriples12" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.ntriples12

    Parse N-Triples 1.2 and N-Quads 1.2 text into lists of triples/quads.

    Triple terms (<<( s p o )>>) are returned as TripleTerm objects.  The caller
    (StarLayerGraph.parse) adds them via self.add(), which handles the internal
    tt: encoding through _coerce_tt / _intern_tt.

    Entry points:
        parse_ntriples12(text) -> list of (s, p, o)
        parse_nquads12(text)   -> list of (s, p, o, graph_uri_or_none)""" ;
        rdfs:label "ntriples12" ;
        ns2:declares ns15:_parse_nt_line, ns15:_token_to_node, ns15:extract_version_directive, ns15:_unescape_nt, ns15:parse_ntriples12, ns15:_consume_nt_term, ns15:parse_nquads12 ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/ntriples12.py" ;
        ns2:importsModule ns4:rdflib, ns4:__future__, ns4:re .

    ns15:_consume_nt_term dcterms:identifier "starlayer.graph.parsers.ntriples12._consume_nt_term" ;
        a ns2:Function ;
        rdfs:comment "Consume one N-Triples 1.2 term starting at start; return (token, end)." ;
        rdfs:label "_consume_nt_term" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/ntriples12.py" ;
        ns2:hasParameter ns15:_consume_nt_term.param.text, ns15:_consume_nt_term.param.start ;
        ns2:hasReturnValue ns15:_consume_nt_term.returns ;
        ns2:isPrivate true ;
