        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/conformance.py" ;
        ns2:importsModule ns4:warnings .

    ns3:RDF12ConformanceWarning dcterms:identifier "starlayer.graph.model.conformance.RDF12ConformanceWarning" ;
        a ns2:Class ;
        rdfs:comment """A declared VERSION label doesn't match the RDF 1.2 features actually
    used in an RDF document (Turtle, TriG, N-Triples/N-Quads, RDF/XML).""" ;
        rdfs:label "RDF12ConformanceWarning" ;
        rdfs:subClassOf ns4:builtins.UserWarning ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/conformance.py" ;
        ns2:lineEnd 38 ;
        ns2:lineStart 36 .

    ns3:SPARQL12ConformanceWarning dcterms:identifier "starlayer.graph.model.conformance.SPARQL12ConformanceWarning" ;
        a ns2:Class ;
        rdfs:comment """A declared VERSION label doesn't match the RDF 1.2 features actually
    used in a SPARQL query/update's own text.

    Deliberately not a subclass of RDF12ConformanceWarning: per SPARQL 1.2
    Query sec 4.3, "the SPARQL version labels refer to SPARQL syntax and
    semantics, while the RDF version labels refer to RDF syntax and
    semantics" - the two directives share label spelling but check a
    different kind of conformance, so they get distinct warning classes.""" ;
        rdfs:label "SPARQL12ConformanceWarning" ;
        rdfs:subClassOf ns4:builtins.UserWarning ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/conformance.py" ;
        ns2:lineEnd 50 ;
        ns2:lineStart 41 .

    ns3:check_version_conformance dcterms:identifier "starlayer.graph.model.conformance.check_version_conformance" ;
        a ns2:Function ;
        rdfs:comment """Warn if declared_version is unrecognized, or is "1.2-basic"/"1.1" while
    a triple term and/or dirLangString is actually present.

    "1.1" is included alongside "1.2-basic" here, not just "1.2-basic": "1.1"
    means plain RDF 1.1 syntax/semantics, which by definition has neither of
    the two RDF 1.2 additions this project tracks (see the README's own
    scope note) - so it excludes triple terms/dirLangString at least as
    strictly as "1.2-basic" does, not more permissively.

    declared_version -- the VERSION directive's label, or None if no
                         directive was present (in which case this is a no-op)
    context           -- short label identifying what was checked, for the
                          warning message, e.g. "Turtle document" or
                          "SPARQL query"
    warning_class     -- RDF12ConformanceWarning (default) for RDF document
                          formats, or SPARQL12ConformanceWarning for a
                          SPARQL query/update's own VERSION directive
    stacklevel        -- passed straight to warnings.warn(); the default (3)
                          is correct for a direct caller (warn's own frame,
                          then this function's, then the caller's - pointing
                          the warning at the caller's line). A wrapper that
                          itself calls this function - e.g.
                          check_version_conformance_for_graphs() below -
                          should pass stacklevel=4 so the warning still
                          points at *its* caller, not at the wrapper itself.""" ;
        rdfs:label "check_version_conformance" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/conformance.py" ;
        ns2:hasParameter ns3:check_version_conformance.param.context, ns3:check_version_conformance.param.uses_dirlangstring, ns3:check_version_conformance.param.warning_class, ns3:check_version_conformance.param.stacklevel, ns3:check_version_conformance.param.uses_triple_term, ns3:check_version_conformance.param.declared_version ;
        ns2:hasReturnValue ns3:check_version_conformance.returns ;
        ns2:lineEnd 109 ;
        ns2:lineStart 53 ;
        ns2:signature "def check_version_conformance(declared_version, *, uses_triple_term: bool, uses_dirlangstring: bool, context: str, warning_class: type=RDF12ConformanceWarning, stacklevel: int=3) -> None" .

    ns3:check_version_conformance.param.context a ns2:Parameter ;
        rdfs:label "context" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns3:check_version_conformance.param.declared_version a ns2:Parameter ;
        rdfs:label "declared_version" ;
