        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns67:sqe_parse_to_tree.returns a ns2:ReturnValue ;
        rdfs:comment "A ``(graph, root)`` tuple." ;
        ns2:annotationText "tuple[Graph, IdentifiedNode]" ;
        ns2:hasType ns4:rdflib.graph.Graph, ns4:builtins.tuple, ns4:rdflib.term.IdentifiedNode .

