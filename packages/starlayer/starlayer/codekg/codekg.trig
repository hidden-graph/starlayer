    ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity dcterms:identifier "starlayer.shacl.native_components._build_sparql_constraint_component.SparqlConstraintComponentWithSeverity" ;
        a ns2:Class ;
        rdfs:comment """Fixes a real pySHACL gap: ``sh:sparql``'s own constraint node
    (the object of ``sh:sparql``, distinct from the shape it's attached
    to) can carry its own ``sh:severity`` override, per the SHACL Core
    spec's SPARQL-based Constraints section - the same way it already
    carries its own ``sh:message``/``sh:deactivated``. pySHACL's own
    ``SPARQLBasedConstraint.__init__`` reads
    ``sh:message``/``sh:deactivated`` from that node but never
    ``sh:severity``, so every violation always reports the *shape's*
    own severity (``self.shape.severity``, read generically inside
    ``ConstraintComponent.make_v_result``) regardless of what the
    constraint node itself declares - not something specific to
    advanced/rules mode or any starShacl wrapping.

    Unlike most other native components in this module (which hold a
    delegate instance rather than subclass one of pySHACL's own
    concrete constraint classes), this one does real method-override
    inheritance: it subclasses pySHACL's own ``SPARQLBasedConstraint``
    directly rather than reimplementing it, overriding only the
    methods below - query execution, message/deactivation handling,
    and pre-binding all stay pySHACL's own, unmodified logic.""" ;
        rdfs:label "SparqlConstraintComponentWithSeverity" ;
        rdfs:subClassOf ns4:pyshacl.constraints.sparql.sparql_based_constraints.SPARQLBasedConstraint ;
        ns2:declares ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity._evaluate_sparql_constraint, ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.make_v_result, ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.__init__ ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:lineEnd 1184 ;
        ns2:lineStart 1097 .

    ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.__init__ dcterms:identifier "starlayer.shacl.native_components._build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.__init__" ;
