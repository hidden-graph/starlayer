    ns145:test_serializer_output_reparses dcterms:identifier "tests.sparql.unit.test_phase6_serialize12.test_serializer_output_reparses" ;
        a ns2:Function ;
        rdfs:comment """Every regenerated text is itself valid SPARQL 1.2 - parses cleanly
    through our own grammar again, no partial/garbled placeholder text left
