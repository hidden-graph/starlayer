GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/entailment_rdfs.py> {
    ns48:entailment_rdfs.py dcterms:identifier "starlayer.sparql.entailment_rdfs" ;
        a ns2:Module ;
        rdfs:comment """starlayer.sparql.entailment_rdfs

    Query-time RDFS entailment, via rewriting an already-lowered plain SPARQL
    1.1 algebra tree - no data is copied or materialized (compare
    starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer(), the
    materialize-a-closure alternative for regimes this rewrite can't express).

    RDFS is a "regular" fragment in the query-rewriting sense: every rule here
    is either a bounded transitive/reflexive closure over one predicate
    (rdfs:subClassOf, rdfs:subPropertyOf - expressible as an rdflib property
    path, no schema reading needed) or a rule that joins against a *fixed*
    shape of schema triple (rdfs:domain/rdfs:range/rdfs:subPropertyOf - joined
    directly as ordinary graph patterns, using fresh variables, rather than
    enumerated in Python first). Unlike OWL, no rule's consequent feeds back
    into needing another rule's premise re-derived - there's no fixpoint
    iteration to approximate here, which is exactly why this stays a rewrite
    and never needs StarLayerGraph.infer()'s materialize-then-query approach.

    Rules covered (RDF Semantics' own numbering):

        rdfs9  - x rdf:type C, C rdfs:subClassOf D => x rdf:type D
        rdfs2  - x P y, P rdfs:domain D            => x rdf:type D
        rdfs3  - x P y, P rdfs:range D             => y rdf:type D
        rdfs11 - subClassOf transitivity (+ rdfs10 reflexivity, for free from
                 the same zero-or-more path - see the reflexivity note below)
        rdfs5  - subPropertyOf transitivity (+ rdfs6 reflexivity, likewise)
        rdfs7  - Q rdfs:subPropertyOf P, x Q y     => x P y

    Deliberately out of scope (all "vocabulary-level" facts, not about the
    data being queried - matching them would mean rewriting e.g. `?x a
    rdfs:Resource` into "any term used anywhere in the graph," a fundamentally
    different and far less useful query shape than what the rules above
    produce): rdfs4a/rdfs4b (every term used anywhere is rdf:type
    rdfs:Resource), rdfs8 (every rdfs:Class is rdfs:subClassOf rdfs:Resource),
    rdfs12/rdfs13 (container-membership-property/datatype axioms), and the
    ~30 fixed RDFS axiomatic triples (e.g. rdf:type rdfs:domain rdfs:Resource).
    These account for most of the triple growth on a real closure -
    StarLayerGraph.infer(entailment=ENTAILMENT.RDFS) still produces all of it
    for a caller who wants byte-for-byte RDFS completeness; this rewrite
    targets the rules that actually answer a question about the data.

    Reflexivity note: rdflib's ZeroOrMorePath (the `*` in a property path) is
    unconditionally reflexive - a zero-length path always matches a node
    against itself, so `rdfs:subClassOf*` trivially includes every term as
    its own ancestor, even one with zero subClassOf triples anywhere in the
    graph, not just ones explicitly declared rdfs:Class. This is a standard,
    widely-accepted simplification (the same one virtually every practical
    RDFS query-rewriting/reasoning system makes) rather than gating
    reflexivity on rdfs6/rdfs10's stricter "only if explicitly typed
    rdf:Property/rdfs:Class" precondition, and is why rdfs6/rdfs10 need no
    separate handling here - the path substitution already subsumes them.""" ;
        rdfs:label "entailment_rdfs" ;
        ns2:declares ns51:rewrite_algebra_for_rdfs, ns51:_type_union, ns51:_rewrite_bgp ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/entailment_rdfs.py" ;
        ns2:importsModule ns4:rdflib.paths, ns4:itertools, ns4:rdflib, ns4:rdflib.plugins.sparql.algebra, ns4:typing, ns4:__future__, ns4:rdflib.plugins.sparql.parserutils .

    ns51:_rewrite_bgp dcterms:identifier "starlayer.sparql.entailment_rdfs._rewrite_bgp" ;
        a ns2:Function ;
        rdfs:comment """Return the algebra node replacing one BGP: a Join of a "simple" BGP
    (every triple whose entailment is exactly one alternative, folded
    together for efficiency, matching what a plain BGP already does) with
    one Union node per triple that needs multiple alternatives (currently
    only rdf:type, via rdfs9+rdfs2+rdfs3).""" ;
        rdfs:label "_rewrite_bgp" ;
        ns2:calls ns51:_type_union ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/entailment_rdfs.py" ;
        ns2:hasParameter ns51:_rewrite_bgp.param.fresh, ns51:_rewrite_bgp.param.bgp ;
        ns2:hasReturnValue ns51:_rewrite_bgp.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 127 ;
        ns2:lineStart 83 ;
        ns2:signature "def _rewrite_bgp(bgp: CompValue, fresh: itertools.count) -> CompValue" .

    ns51:_rewrite_bgp.param.bgp a ns2:Parameter ;
        rdfs:comment "The BGP algebra node to rewrite." ;
        rdfs:label "bgp" ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns51:_rewrite_bgp.param.fresh a ns2:Parameter ;
        rdfs:comment "Shared counter supplying fresh variable suffixes across the whole rewrite pass." ;
        rdfs:label "fresh" ;
        ns2:annotationText "itertools.count" ;
        ns2:hasType ns4:itertools.count ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns51:_rewrite_bgp.returns a ns2:ReturnValue ;
        rdfs:comment "The replacement algebra node (a Join chain, or the original-shaped BGP if nothing needed a Union)." ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue .

    ns51:_type_union dcterms:identifier "starlayer.sparql.entailment_rdfs._type_union" ;
        a ns2:Function ;
        rdfs:comment """rdfs9 (subclass chain) UNION rdfs2 (domain) UNION rdfs3 (range) for
    one ``(s, rdf:type, o)`` triple pattern - see module docstring for why
    these three specifically, and why each needs no Python-level
    enumeration of the schema (every fresh variable here is joined
    directly against ordinary rdfs:domain/rdfs:range/rdfs:subClassOf
    triples in the same graph being queried, by the query engine itself).""" ;
        rdfs:label "_type_union" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/entailment_rdfs.py" ;
        ns2:hasParameter ns51:_type_union.param.fresh, ns51:_type_union.param.s, ns51:_type_union.param.o ;
        ns2:hasReturnValue ns51:_type_union.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 164 ;
        ns2:lineStart 130 ;
        ns2:signature "def _type_union(s: Any, o: Any, fresh: itertools.count) -> CompValue" .

    ns51:_type_union.param.fresh a ns2:Parameter ;
        rdfs:comment "Shared counter supplying fresh variable suffixes across the whole rewrite pass." ;
        rdfs:label "fresh" ;
        ns2:annotationText "itertools.count" ;
        ns2:hasType ns4:itertools.count ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns51:_type_union.param.o a ns2:Parameter ;
        rdfs:comment "The triple pattern's rdf:type object term (the class being tested for membership)." ;
        rdfs:label "o" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns51:_type_union.param.s a ns2:Parameter ;
        rdfs:comment "The triple pattern's subject term." ;
        rdfs:label "s" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns51:_type_union.returns a ns2:ReturnValue ;
        rdfs:comment "A nested Union algebra node of the three alternatives." ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue .

    ns51:rewrite_algebra_for_rdfs dcterms:identifier "starlayer.sparql.entailment_rdfs.rewrite_algebra_for_rdfs" ;
        a ns2:Function ;
        rdfs:comment """Return ``algebra`` with every BGP rewritten for RDFS entailment (see
    module docstring for exactly which rules). Mutates and returns the
    same tree (matching ``rdflib.plugins.sparql.algebra.traverse``'s own
    contract, already relied on elsewhere in this codebase's lowering
    passes) - idempotent, since every triple this rewrite produces uses
    either a ``Path`` object or a fresh ``__starlayer_rdfs_N`` variable in
    predicate position, neither of which matches the ``p == RDF.type`` /
    ``isinstance(p, URIRef)`` checks that trigger rewriting on a second
    pass.""" ;
        rdfs:label "rewrite_algebra_for_rdfs" ;
        ns2:calls ns51:_rewrite_bgp ;
        ns2:declares ns51:rewrite_algebra_for_rdfs._visit ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/entailment_rdfs.py" ;
        ns2:hasParameter ns51:rewrite_algebra_for_rdfs.param.algebra ;
        ns2:hasReturnValue ns51:rewrite_algebra_for_rdfs.returns ;
        ns2:lineEnd 192 ;
        ns2:lineStart 167 ;
        ns2:signature "def rewrite_algebra_for_rdfs(algebra: Any) -> Any" .

    ns51:rewrite_algebra_for_rdfs._visit dcterms:identifier "starlayer.sparql.entailment_rdfs.rewrite_algebra_for_rdfs._visit" ;
        a ns2:Function ;
        rdfs:label "_visit" ;
        ns2:calls ns51:_rewrite_bgp ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/entailment_rdfs.py" ;
