        rdfs:comment "The parser cursor to read tokens from." ;
        rdfs:label "cur" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns12:_parse_item_annotations.returns a ns2:ReturnValue ;
        rdfs:comment "A list of (prop, value) pairs, or None if no Annotations: prefix was written here - the grammar has no \"annotated with nothing\" form, so None unambiguously means absence." .

