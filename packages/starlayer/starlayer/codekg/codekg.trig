    ns240:TestU6.test_insert_template_tt_registered_after_insert dcterms:identifier "tests.graph.unit.test_sparql12_update.TestU6.test_insert_template_tt_registered_after_insert" ;
        a ns2:Method ;
        rdfs:comment """New TT created via INSERT template must be registered in the graph.

    Uses reifier shorthand (no parens), not a raw triple term, as the
    template's subject - a raw `<<( s p o )>>` triple term is never
    legal RDF 1.2 in subject position (see
    starlayer.sparql.triple_term.InvalidTripleTermError's rule 2,
    2026-08-15). The shorthand still constructs and registers the same
    underlying (alice, knows, bob) triple term - it just does so as the
    object of an auto-generated `rdf:reifies` triple rather than
    directly as `:note`'s subject - so this still correctly exercises
    the thing this test is named for.""" ;
        rdfs:label "test_insert_template_tt_registered_after_insert" ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_sparql12_update.py" ;
        ns2:hasParameter ns240:TestU6.test_insert_template_tt_registered_after_insert.param.g ;
        ns2:lineEnd 316 ;
        ns2:lineStart 296 ;
        ns2:signature "def test_insert_template_tt_registered_after_insert(self, g)" .

