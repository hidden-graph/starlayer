    ns76:_build_language_in_component.LanguageInConstraintComponent dcterms:identifier "starlayer.shacl.native_components._build_language_in_component.LanguageInConstraintComponent" ;
        a ns2:Class ;
        rdfs:comment """Fully replaces pySHACL's own ``LanguageInConstraintComponent``
    (unlike ``DatatypeConstraintComponent``, which only shadows one
    case): pySHACL's own check keys off ``Literal.language``, which is
    never set for an encoded ``DirLangString`` value (stored via a
    special ``datatype=``, not ``lang=``), so any RDF 1.2
    direction-tagged string value always spuriously fails, regardless
    of its real language tag. Matching otherwise reproduces pySHACL's
    own basic language-range filtering (SPARQL ``langMatches``) exactly
    for the plain-language-tag case. Base direction plays no part in
    the match - per spec, ``sh:languageIn`` is about the language tag
    component only.""" ;
        rdfs:label "LanguageInConstraintComponent" ;
        rdfs:subClassOf ns4:pyshacl.constraints.constraint_component.ConstraintComponent ;
        ns2:declares ns76:_build_language_in_component.LanguageInConstraintComponent.constraint_parameters, ns76:_build_language_in_component.LanguageInConstraintComponent.evaluate, ns76:_build_language_in_component.LanguageInConstraintComponent.constraint_name, ns76:_build_language_in_component.LanguageInConstraintComponent.__init__ ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:lineEnd 1857 ;
        ns2:lineStart 1804 .

