        ns2:position 0 .

    ns75:StarShaclSchema._annotate_conformance_disallows.returns a ns2:ReturnValue ;
        rdfs:comment "The recomputed ``sh:conforms`` value (also written back onto ``report_graph``), or ``conforms`` unchanged if ``report_graph`` has no ``sh:ValidationReport`` node at all." ;
