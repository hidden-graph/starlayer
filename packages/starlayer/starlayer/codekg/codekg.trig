    ns56:query_ast_to_rdf dcterms:identifier "starlayer.sparql.to_ast_rdf.query_ast_to_rdf" ;
        a ns2:Function ;
        rdfs:comment """Encode ``parseQuery(text)``'s raw output — ``[prologue, query]`` —
    as ``sast:`` RDF.

    ``root`` is additionally typed ``sast:Query`` so parsed queries in a
    larger store can be found via ``?q a sast:Query`` regardless of query
    form — same convention as ``to_rdf.query_to_rdf``.""" ;
        rdfs:label "query_ast_to_rdf" ;
        ns2:calls ns54:_new_starlayer_graph, ns56:_encode ;
        ns2:filePath "packages/starlayer/starlayer/sparql/to_ast_rdf.py" ;
        ns2:hasParameter ns56:query_ast_to_rdf.param.parse_result, ns56:query_ast_to_rdf.param.graph ;
        ns2:hasReturnValue ns56:query_ast_to_rdf.returns ;
        ns2:lineEnd 71 ;
        ns2:lineStart 47 ;
        ns2:signature "def query_ast_to_rdf(parse_result: ParseResults, graph: Graph | None=None) -> tuple[Graph, BNode]" .

    ns56:query_ast_to_rdf.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to add triples to. Defaults to a fresh ``StarLayerGraph`` (see ``to_rdf._new_starlayer_graph``), never a plain ``rdflib.Graph``." ;
        rdfs:label "graph" ;
        ns2:annotationText "Graph | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns56:query_ast_to_rdf.param.parse_result a ns2:Parameter ;
