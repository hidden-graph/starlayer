        ns2:hasReturnValue ns75:StarShaclSchema.extract_subgraph.returns ;
        ns2:lineEnd 1954 ;
        ns2:lineStart 1893 ;
        ns2:signature "def extract_subgraph(self, data_graph: Any | None=None, *, shape: Any, focus_node: Any, shapes_graph_resource: Any | None=None) -> Any | None" .

    ns75:StarShaclSchema.extract_subgraph.param.data_graph a ns2:Parameter ;
        rdfs:comment "The data graph ``focus_node`` belongs to. Optional - falls back to ``self.data_graph`` if omitted." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
