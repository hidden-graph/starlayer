        ns2:isPrivate true ;
        ns2:lineEnd 63 ;
        ns2:lineStart 41 ;
        ns2:signature "def _rectangle_shapes(*, with_expected_predicate: bool) -> str" .

    ns183:_rectangle_shapes.param.with_expected_predicate a ns2:Parameter ;
        rdfs:label "with_expected_predicate" ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 0 .

    ns183:_rectangle_shapes.returns a ns2:ReturnValue ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

    ns183:test_expected_predicate_does_not_override_an_existing_value dcterms:identifier "tests.shacl.integration.test_expected_predicate.test_expected_predicate_does_not_override_an_existing_value" ;
        a ns2:Function ;
        rdfs:comment """ex:rect2 already asserts a real (large) ex:area - sh:defaultValue must
