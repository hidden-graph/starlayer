    ns42:parseQuery dcterms:identifier "starlayer.graph.query.sparql_api.parseQuery" ;
        a ns2:Function ;
        rdfs:comment """Parse a SPARQL 1.2 SELECT/ASK/CONSTRUCT/DESCRIBE query string.

    A leading ``VERSION "label"`` prologue directive (SPARQL 1.2 Query sec
    4.3) is stripped first - not real SPARQL grammar at all, same handling
    ``StarLayerGraph.query()`` already gives it (see
    ``version_directive.py``'s own module docstring).""" ;
        rdfs:label "parseQuery" ;
        ns2:calls ns72:parse_query_12, ns41:strip_version_directive, ns42:_check_version_conformance ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:parseQuery.param.q ;
        ns2:hasReturnValue ns42:parseQuery.returns ;
        ns2:lineEnd 86 ;
