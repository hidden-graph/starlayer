GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py> {
    ns111:test_manchester_ast_shapes.py dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes" ;
        a ns2:Module ;
        rdfs:comment """SHACL shape tests for the manch: vocabulary (see manchester_shapes.ttl/.py)
    - mirrors the sibling starlayer.sparql package's test_shacl_shapes.py structure.

    Two directions get tested:

    1. Every representative document (imported from test_manchester_ast.DOCUMENTS,
       so this suite can't silently drift from what the encoder actually
       produces) encodes to a graph that *conforms*.
    2. A handful of deliberately malformed graphs, built by mutating a valid
       encoded document, each *fail* validation for the specific structural
       reason the mutation introduces - not just "conforms is False somewhere".""" ;
        rdfs:label "test_manchester_ast_shapes" ;
        ns2:declares ns194:test_valid_documents_conform, ns194:test_broken_mid_chain_rdf_list_fails, ns194:test_wrong_item_type_under_data_prop_range_clause_fails, ns194:test_misc_axiom_item_of_wrong_family_fails, ns194:_encode_data_prop_range, ns194:test_shapes_graph_is_valid_shacl_and_reusable ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py" ;
        ns2:importsModule ns4:tests.graph.unit.test_manchester_ast, ns4:rdflib, ns4:pytest, ns4:rdflib.collection .

    ns194:_encode_data_prop_range dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes._encode_data_prop_range" ;
        a ns2:Function ;
        rdfs:label "_encode_data_prop_range" ;
        ns2:calls ns92:manchester_parse_to_tree ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_manchester_ast_shapes.py" ;
        ns2:isPrivate true ;
