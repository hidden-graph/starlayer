GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_phase4_prologue.py> {
    ns120:test_phase4_prologue.py dcterms:identifier "tests.sparql.unit.test_phase4_prologue" ;
        a ns2:Module ;
        rdfs:comment """Phase 4: Prologue (BASE/PREFIX) round-trip.

    Not cosmetic: confirmed empirically that a reconstructed Query with an
    empty Prologue silently gives a *wrong* result for BASE-relative IRI()/
    URI() builtin resolution (Builtin_IRI calls ctx.prologue.absolutize()) —
    real evaluation-time behavior, not just prettier regenerated text. Also
    confirmed rdflib's own algebra.translateAlgebra never reads query.prologue
    at all (byte-identical output regardless of prologue content), so this
    phase can't and doesn't attempt to make regenerated query text use
    prefixed names — see vocab.py's "Prologue (BASE/PREFIX)" section.""" ;
        rdfs:label "test_phase4_prologue" ;
        ns2:declares ns246:test_translate_algebra_output_unaffected_by_prologue, ns246:test_base_relative_iri_resolution_survives_roundtrip, ns246:test_update_base_relative_iri_resolution_survives_roundtrip, ns246:test_prefix_bindings_survive_roundtrip ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase4_prologue.py" ;
        ns2:importsModule ns4:rdflib.plugins.sparql.update, ns4:rdflib.plugins.sparql.evaluate, ns4:rdflib, ns4:rdflib.plugins.sparql.algebra, ns4:rdflib.plugins.sparql.processor .

    ns246:test_base_relative_iri_resolution_survives_roundtrip dcterms:identifier "tests.sparql.unit.test_phase4_prologue.test_base_relative_iri_resolution_survives_roundtrip" ;
