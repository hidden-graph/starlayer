    ns76:_build_datatype_component.DatatypeConstraintComponent dcterms:identifier "starlayer.shacl.native_components._build_datatype_component.DatatypeConstraintComponent" ;
        a ns2:Class ;
        rdfs:comment """Shadows pySHACL's own ``DatatypeConstraintComponent`` to add two
    SHACL 1.2 cases pySHACL 0.40 gets wrong:

    - list-valued ``sh:datatype`` (union of choices) - pySHACL only
      accepts a single IRI value.
    - ``sh:datatype rdf:dirLangString`` - a ``DirLangString`` is encoded
      internally (``starlayer.graph``) as a ``Literal`` whose datatype
      is starlayer.graph's own packing URI, never the real
      ``rdf:dirLangString``, so pySHACL's own datatype-equality check
      always reports a spurious violation for genuinely well-formed
      values.

    Delegates to a real instance of pySHACL's own component for every
    other single-IRI value, preserving its behavior byte-for-byte
    (including its SPARQL-1.1 ill-typed-literal detection via
    ``_assert_actual_datatype``) rather than reimplementing it.""" ;
        rdfs:label "DatatypeConstraintComponent" ;
        rdfs:subClassOf ns4:pyshacl.constraints.constraint_component.ConstraintComponent ;
        ns2:declares ns76:_build_datatype_component.DatatypeConstraintComponent.__init__, ns76:_build_datatype_component.DatatypeConstraintComponent.constraint_name, ns76:_build_datatype_component.DatatypeConstraintComponent.constraint_parameters, ns76:_build_datatype_component.DatatypeConstraintComponent.evaluate ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:lineEnd 1766 ;
        ns2:lineStart 1670 .

