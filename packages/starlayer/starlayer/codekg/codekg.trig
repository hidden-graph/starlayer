    ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.make_v_result dcterms:identifier "starlayer.shacl.native_components._build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.make_v_result" ;
        a ns2:Method ;
        rdfs:comment """``sh:resultAnnotation`` (SHACL-AF SPARQL Constraints): a
    ``sh:sparql`` constraint node can declare one or more
    ``sh:ResultAnnotation`` entries, each injecting an extra
    ``(result, sh:annotationProperty-value, ...)`` triple onto every
    ``sh:ValidationResult`` this constraint produces - value sourced
    either from ``sh:annotationVarName`` (a name from the SELECT
    query's own result row) or a fixed ``sh:annotationValue``. Left
    entirely unimplemented by pySHACL itself, so this method exists
    to cover the gap.

    Hooks here rather than ``_evaluate_sparql_constraint`` above
    (which only sees the *already-built* ``(desc, r_node,
    r_triples)`` reports, with no further access to the per-row
    SPARQL variable bindings) because ``make_v_result`` itself
    receives both ``source_constraint`` (the ``sh:sparql`` node
    where ``sh:resultAnnotation`` would be declared) and
    ``bound_vars`` (the SELECT row's own bindings) as real
    parameters, not just derivable from what's returned.""" ;
        rdfs:label "make_v_result" ;
        ns2:calls ns76:_result_annotation_triples ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:hasParameter ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.make_v_result.param.kwargs, ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.make_v_result.param.datagraph, ns76:_build_sparql_constraint_component.SparqlConstraintComponentWithSeverity.make_v_result.param.focus_node ;
        ns2:lineEnd 1184 ;
        ns2:lineStart 1158 ;
        ns2:signature "def make_v_result(self, datagraph: Any, focus_node: Any, **kwargs: Any)" .

