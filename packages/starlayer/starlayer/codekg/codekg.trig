        ns2:annotationText "StarLayerGraph | StarLayerDataset" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph, ns4:starlayer.graph.graph.starlayer_dataset.StarLayerDataset .

    ns199:_new_oxigraph_store_graph dcterms:identifier "tests.graph.w3c_sparql12.test_w3c_sparql12_eval._new_oxigraph_store_graph" ;
        a ns2:Function ;
