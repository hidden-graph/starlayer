        rdfs:label "test_prefix_bindings_survive_roundtrip" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase4_prologue.py" ;
        ns2:lineEnd 50 ;
        ns2:lineStart 42 ;
        ns2:signature "def test_prefix_bindings_survive_roundtrip()" .

