    ns3:check_version_conformance.param.uses_triple_term a ns2:Parameter ;
        rdfs:label "uses_triple_term" ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns3:check_version_conformance.param.warning_class a ns2:Parameter ;
        rdfs:label "warning_class" ;
        ns2:annotationText "type" ;
        ns2:defaultValue "RDF12ConformanceWarning" ;
        ns2:hasType ns4:builtins.type ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns3:check_version_conformance.returns a ns2:ReturnValue ;
