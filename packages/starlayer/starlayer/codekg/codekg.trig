    ns18:extract_fields.returns a ns2:ReturnValue ;
        rdfs:comment "A dict of the statement's fields - {'version': ...} for a VERSION directive, {'prefix': ..., 'iri': ...} for @prefix, {'iri': ...} for @base, or {'triple_set': [...]} for a triple statement (a list of subject/predicate/object/annotation field dicts) - or {} if the statement doesn't match its claimed type's grammar." .

    ns18:split_statements dcterms:identifier "starlayer.graph.parsers.syntax.split_statements" ;
        a ns2:Function ;
        rdfs:comment """Split Turtle text into a list of statement strings.

    See split_statements_with_lines() for the same split with each
