        rdfs:comment "The SPARQL SELECT result to post-process in place." ;
        rdfs:label "r" ;
        ns2:annotationText "Result" ;
        ns2:hasType ns4:rdflib.query.Result ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:restore_select_bindings.param.restore_fn a ns2:Parameter ;
