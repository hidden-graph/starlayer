GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_phase2_forms.py> {
    ns120:test_phase2_forms.py dcterms:identifier "tests.sparql.unit.test_phase2_forms" ;
        a ns2:Module ;
        rdfs:comment """Phase 2a: query forms and operators that turned out to already work with
    the generic encoder/decoder from Phase 1, with no new vocabulary or code —
    CONSTRUCT, ASK, DESCRIBE (with and without WHERE), and MINUS. Locked in here
    as regression tests.

    SERVICE is checked structurally only (algebra tree equality after decode),
    not executed — evaluating it would require a live network call to a SPARQL
    endpoint, which this test suite must not do.""" ;
        rdfs:label "test_phase2_forms" ;
        ns2:declares ns133:_strip_bookkeeping, ns133:test_roundtrip_result_equivalence, ns133:_canon, ns133:test_service_structural_roundtrip ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        ns2:importsModule ns4:pytest, ns4:rdflib.plugins.sparql.evaluate, ns4:rdflib.plugins.sparql.processor .

    ns133:_canon dcterms:identifier "tests.sparql.unit.test_phase2_forms._canon" ;
        a ns2:Function ;
        rdfs:label "_canon" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        ns2:hasParameter ns133:_canon.param.res ;
        ns2:isPrivate true ;
        ns2:lineEnd 41 ;
        ns2:lineStart 30 ;
        ns2:signature "def _canon(res)" .

    ns133:_canon.param.res a ns2:Parameter ;
        rdfs:label "res" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns133:_strip_bookkeeping dcterms:identifier "tests.sparql.unit.test_phase2_forms._strip_bookkeeping" ;
        a ns2:Function ;
        rdfs:comment """Deep-copy an algebra tree with the _vars/lazy bookkeeping keys removed
    and None-valued keys dropped, so two independently-built trees (one via
    translateQuery, one via rdf_to_query) can be compared by their real
    structure/content. A key explicitly set to None (translateQuery always
    sets "datasetClause", even when there's no FROM clause) and an absent
    key are behaviorally identical everywhere in rdflib — CompValue.__getattr__
    returns None for a missing key too — so encoding skips None values
    entirely rather than emitting a triple that would just decode back to
    the same key: None.""" ;
        rdfs:label "_strip_bookkeeping" ;
        ns2:calls ns133:_strip_bookkeeping ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        ns2:hasParameter ns133:_strip_bookkeeping.param.node ;
        ns2:isPrivate true ;
        ns2:lineEnd 82 ;
        ns2:lineStart 59 ;
        ns2:signature "def _strip_bookkeeping(node)" .

    ns133:_strip_bookkeeping.param.node a ns2:Parameter ;
        rdfs:label "node" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns133:test_roundtrip_result_equivalence dcterms:identifier "tests.sparql.unit.test_phase2_forms.test_roundtrip_result_equivalence" ;
        a ns2:Function ;
        rdfs:label "test_roundtrip_result_equivalence" ;
        ns2:calls ns133:_canon ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        ns2:hasDecorator ns133:test_roundtrip_result_equivalence.decorator.0 ;
        ns2:hasParameter ns133:test_roundtrip_result_equivalence.param.fixture_graph, ns133:test_roundtrip_result_equivalence.param.query_text ;
        ns2:lineEnd 56 ;
        ns2:lineStart 45 ;
        ns2:signature "def test_roundtrip_result_equivalence(fixture_graph, query_text)" .

    ns133:test_roundtrip_result_equivalence.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('query_text', QUERIES)" ;
        ns2:position 0 .

    ns133:test_roundtrip_result_equivalence.param.fixture_graph a ns2:Parameter ;
        rdfs:label "fixture_graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns133:test_roundtrip_result_equivalence.param.query_text a ns2:Parameter ;
        rdfs:label "query_text" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns133:test_service_structural_roundtrip dcterms:identifier "tests.sparql.unit.test_phase2_forms.test_service_structural_roundtrip" ;
        a ns2:Function ;
        rdfs:comment """SERVICE isn't executed (would require a live network call); this
    checks the decoded algebra tree matches the original structurally.""" ;
        rdfs:label "test_service_structural_roundtrip" ;
        ns2:calls ns133:_strip_bookkeeping ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase2_forms.py" ;
        ns2:lineEnd 96 ;
        ns2:lineStart 85 ;
        ns2:signature "def test_service_structural_roundtrip()" .

    ns4:pytest a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.evaluate a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.processor a ns2:ExternalModule .
}

