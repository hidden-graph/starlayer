    ns145:test_construct_serializer_output_reparses dcterms:identifier "tests.sparql.unit.test_phase6_serialize12.test_construct_serializer_output_reparses" ;
        a ns2:Function ;
        rdfs:label "test_construct_serializer_output_reparses" ;
