        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns18:extract_fields.param.typ, ns18:extract_fields.param.stmt, ns18:extract_fields.param.blank_counter ;
        ns2:hasReturnValue ns18:extract_fields.returns ;
        ns2:instantiates ns19:Turtle12SyntaxError ;
        ns2:lineEnd 592 ;
        ns2:lineStart 480 ;
