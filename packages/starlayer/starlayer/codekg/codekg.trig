        ns2:hasReturnValue ns71:_add_single_constraint.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 745 ;
        ns2:lineStart 718 ;
        ns2:signature "def _add_single_constraint(value, accessor_expr, extra_constraints: list, already_bound: set) -> None" .

    ns71:_add_single_constraint.param.accessor_expr a ns2:Parameter ;
        rdfs:label "accessor_expr" ;
