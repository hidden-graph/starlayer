    ns300:TestBoundBlankNodeLookups.test_bound_blank_node_returns_only_its_own_values dcterms:identifier "tests.graph.integration.test_oxigraph_store_rdf12.TestBoundBlankNodeLookups.test_bound_blank_node_returns_only_its_own_values" ;
