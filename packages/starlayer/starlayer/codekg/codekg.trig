GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/sqe_coverage/test_oxigraph_differential.py> {
    ns319:test_oxigraph_differential.py dcterms:identifier "tests.sparql.sqe_coverage.test_oxigraph_differential" ;
        a ns2:Module ;
        rdfs:comment """Differential testing against Oxigraph, an independent SPARQL 1.2 engine (pyoxigraph, in-process).

    Plain rdflib is a reference for SPARQL 1.1 only; Oxigraph also implements RDF 1.2 (triple terms, reifiers,
    annotations, base-direction strings) and the SPARQL 1.2 functions, so it can referee those too.

    * ``test_generated_queries_agree_with_oxigraph``: the generated 1.1 queries from the sqe property tests,
      run through StarLayer's regular query path and through Oxigraph.
    * ``test_sparql12_queries_agree_with_oxigraph``: generated queries that use the 1.2 syntax and functions.
    * ``test_sqe_text_agrees_with_oxigraph``: the text sqe renders for a generated query, run on StarLayer,
      against the ORIGINAL query on Oxigraph - so sqe is checked against an engine that is not StarLayer.

    Results are compared as sets of canonical terms (blank-node labels masked, since two engines never agree on
    them). Opt-in (``pytest --sqe-coverage``); example count from ``STARLAYER_SQE_FUZZ_EXAMPLES``.""" ;
        rdfs:label "test_oxigraph_differential" ;
        ns2:declares ns328:_lit, ns328:_sparql12_query, ns328:test_sqe_text_of_sparql12_agrees_with_oxigraph, ns328:_oxigraph_outcome, ns328:_oxigraph_store, ns328:_canonical_number, ns328:test_sparql12_queries_agree_with_oxigraph, ns328:_starlayer_term, ns328:test_generated_queries_agree_with_oxigraph, ns328:_starlayer_outcome, ns328:_order_sensitive, ns328:test_sqe_text_agrees_with_oxigraph, ns328:_oxigraph_term ;
        ns2:filePath "packages/starlayer/tests/sparql/sqe_coverage/test_oxigraph_differential.py" ;
        ns2:importsModule ns4:pytest, ns4:__future__, ns4:rdflib, ns4:hypothesis, ns4:tests.sparql.sqe_coverage.test_sqe_features, ns4:tests.sparql.sqe_coverage.test_sqe_property_based .

