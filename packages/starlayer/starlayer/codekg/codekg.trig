    ns67:sqe_parse_to_tree.param.root a ns2:Parameter ;
        rdfs:comment "The node to use as the query's own root - any ``URIRef``/ ``BNode``. Defaults to a fresh ``BNode()``. Give a real ``URIRef`` to make the query findable by that identity later (e.g. ``graph.value(my_iri, RDF.type, SQE.Query)``), rather than only via the ``root`` value this function itself returns - useful once a graph accumulates more than one encoded query (via repeated calls sharing one ``graph=``), where a bare `?s a sqe:Query` lookup can no longer tell them apart on its own." ;
        rdfs:label "root" ;
        ns2:annotationText "IdentifiedNode | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:rdflib.term.IdentifiedNode ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

