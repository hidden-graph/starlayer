GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_roundtrip.py> {
    ns120:test_roundtrip.py dcterms:identifier "tests.sparql.unit.test_roundtrip" ;
        a ns2:Module ;
        rdfs:comment """Phase 1 round-trip tests: SELECT + BGP + FILTER + OPTIONAL + UNION.

    Verifies text -> algebra -> RDF -> algebra -> results, by *executing* both
    the original prepared query and the RDF-round-tripped reconstruction against
    the same fixture graph and comparing result sets — not by comparing
    regenerated query text, which isn't guaranteed stable (see algebra.py's
    translateAlgebra: it always emits full IRIs, never prefixed names).""" ;
        rdfs:label "test_roundtrip" ;
        ns2:declares ns128:test_roundtrip_result_equivalence, ns128:_canon, ns128:test_regenerated_text_is_also_executable ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_roundtrip.py" ;
        ns2:importsModule ns4:rdflib.plugins.sparql.evaluate, ns4:rdflib.plugins.sparql.processor, ns4:rdflib.plugins.sparql.algebra, ns4:pytest .

    ns128:_canon dcterms:identifier "tests.sparql.unit.test_roundtrip._canon" ;
        a ns2:Function ;
        rdfs:label "_canon" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_roundtrip.py" ;
        ns2:hasParameter ns128:_canon.param.res ;
        ns2:isPrivate true ;
        ns2:lineEnd 74 ;
        ns2:lineStart 70 ;
        ns2:signature "def _canon(res)" .

    ns128:_canon.param.res a ns2:Parameter ;
        rdfs:label "res" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns128:test_regenerated_text_is_also_executable dcterms:identifier "tests.sparql.unit.test_roundtrip.test_regenerated_text_is_also_executable" ;
        a ns2:Function ;
        rdfs:comment """Bonus check: algebra.translateAlgebra (rdflib's own algebra -> text
    serializer) should also be able to turn the round-tripped algebra back
    into query text that re-parses and produces the same results.""" ;
        rdfs:label "test_regenerated_text_is_also_executable" ;
        ns2:calls ns128:_canon ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_roundtrip.py" ;
        ns2:hasDecorator ns128:test_regenerated_text_is_also_executable.decorator.0 ;
        ns2:hasParameter ns128:test_regenerated_text_is_also_executable.param.query_text, ns128:test_regenerated_text_is_also_executable.param.fixture_graph ;
        ns2:lineEnd 128 ;
        ns2:lineStart 114 ;
        ns2:signature "def test_regenerated_text_is_also_executable(fixture_graph, query_text)" .

    ns128:test_regenerated_text_is_also_executable.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('query_text', _TRANSLATE_ALGEBRA_QUERIES)" ;
        ns2:position 0 .

    ns128:test_regenerated_text_is_also_executable.param.fixture_graph a ns2:Parameter ;
        rdfs:label "fixture_graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns128:test_regenerated_text_is_also_executable.param.query_text a ns2:Parameter ;
        rdfs:label "query_text" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns128:test_roundtrip_result_equivalence dcterms:identifier "tests.sparql.unit.test_roundtrip.test_roundtrip_result_equivalence" ;
        a ns2:Function ;
        rdfs:label "test_roundtrip_result_equivalence" ;
        ns2:calls ns128:_canon ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_roundtrip.py" ;
        ns2:hasDecorator ns128:test_roundtrip_result_equivalence.decorator.0 ;
        ns2:hasParameter ns128:test_roundtrip_result_equivalence.param.query_text, ns128:test_roundtrip_result_equivalence.param.fixture_graph ;
        ns2:lineEnd 89 ;
        ns2:lineStart 78 ;
        ns2:signature "def test_roundtrip_result_equivalence(fixture_graph, query_text)" .

    ns128:test_roundtrip_result_equivalence.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('query_text', QUERIES)" ;
        ns2:position 0 .

    ns128:test_roundtrip_result_equivalence.param.fixture_graph a ns2:Parameter ;
        rdfs:label "fixture_graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns128:test_roundtrip_result_equivalence.param.query_text a ns2:Parameter ;
        rdfs:label "query_text" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns4:pytest a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.algebra a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.evaluate a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.processor a ns2:ExternalModule .
}

