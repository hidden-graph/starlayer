        ns2:hasType ns4:xml.etree.ElementTree.Element ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns23:parse_trix12 dcterms:identifier "starlayer.graph.parsers.trix12.parse_trix12" ;
        a ns2:Function ;
        rdfs:comment """Parse TriX 1.2 text; return list of (s, p, o) triples.

    All named graphs are merged. Subjects and objects may be TripleTerm
