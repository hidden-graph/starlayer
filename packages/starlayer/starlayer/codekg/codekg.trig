        ns2:annotationText "URIRef" ;
        ns2:hasType ns4:rdflib.term.URIRef ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns94:local_loader.returns a ns2:ReturnValue ;
        ns2:annotationText "StarLayerGraph | None" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph ;
