        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns7:tt_hash.param.p_str a ns2:Parameter ;
        rdfs:comment "Canonical string form of the triple term's resolved predicate." ;
        rdfs:label "p_str" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns7:tt_hash.param.s_str a ns2:Parameter ;
        rdfs:comment "Canonical string form of the triple term's resolved subject." ;
        rdfs:label "s_str" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:tt_hash.returns a ns2:ReturnValue ;
        rdfs:comment "A 16-character hexadecimal digest derived from (s_str, p_str, o_str)." ;
