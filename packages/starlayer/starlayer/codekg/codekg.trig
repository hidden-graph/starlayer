        ns2:hasReturnValue ns9:_split_iri.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 66 ;
        ns2:lineStart 54 ;
        ns2:signature "def _split_iri(iri: str) -> tuple[str, str]" .

    ns9:_split_iri.param.iri a ns2:Parameter ;
        rdfs:label "iri" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns9:_split_iri.returns a ns2:ReturnValue ;
        ns2:annotationText "tuple[str, str]" ;
        ns2:hasType ns4:builtins.tuple, ns4:builtins.str .

    ns9:serialize_rdfxml12 dcterms:identifier "starlayer.graph.serializers.rdfxml12.serialize_rdfxml12" ;
        a ns2:Function ;
        rdfs:comment """Serialize a StarLayerGraph to RDF/XML 1.2 text.

    Triple terms in object position → ``rdf:parseType="Triple"`` wrapping a
    single ``<rdf:Description>`` (RDF 1.2 XML Syntax sec 2.19). Reification is
    the ordinary ``rdf:reifies`` predicate with a triple-term-valued object -
    the same "formal pattern" used as the canonical form everywhere else in
    this codebase, not the ``rdf:annotation``/``rdf:annotationNodeID``
    shorthand (which the parser accepts for reading, but this serializer
    never emits).""" ;
        rdfs:label "serialize_rdfxml12" ;
        ns2:calls ns9:_set_object, ns9:_register_ns, ns28:StarLayerGraph.from_rdflib, ns9:_clark ;
        ns2:filePath "packages/starlayer/starlayer/graph/serializers/rdfxml12.py" ;
        ns2:hasParameter ns9:serialize_rdfxml12.param.graph ;
        ns2:hasReturnValue ns9:serialize_rdfxml12.returns ;
        ns2:lineEnd 184 ;
        ns2:lineStart 141 ;
        ns2:signature "def serialize_rdfxml12(graph) -> str" .

    ns9:serialize_rdfxml12.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to serialize - a StarLayerGraph, or a plain rdflib.Graph wrapped via StarLayerGraph.from_rdflib()." ;
        rdfs:label "graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns9:serialize_rdfxml12.returns a ns2:ReturnValue ;
        rdfs:comment "The RDF/XML 1.2 serialization of graph." ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

    ns4:__future__ a ns2:ExternalModule .

