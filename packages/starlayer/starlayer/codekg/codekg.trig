    ns43:decompose_for_remote dcterms:identifier "starlayer.graph.query.remote_decompose.decompose_for_remote" ;
        a ns2:Function ;
        rdfs:comment """Mutate `prepared_query.algebra` in place, stripping every Extend/
    Filter that (transitively) depends on a starlayer.graph custom function, and
    return ``(recipes, filters)``: the ordered list of (variable,
    expression) recipes to evaluate locally per result row (same as
    before), plus a list of boolean filter expressions to re-check locally
    per row (new - see `_strip_custom_extends`'s own docstring for why a
    Filter needs different handling than an Extend).

    Only SELECT-shaped queries (``algebra.name == 'SelectQuery'``) are
    decomposed; anything else is left untouched (empty recipes/filters)
    and falls back to the caller's existing plain-text-rewrite behavior -
    not a regression, since those shapes weren't handled before this
    either, and no current test exercises a custom function inside
    CONSTRUCT/ASK/DESCRIBE.

    Any variable a recipe depends on that isn't itself another recipe's
    target (e.g. a triple-term variable bound by an ordinary graph pattern,
    needed as SUBJECT()/PREDICATE()/OBJECT()'s argument) is added to the
    query's own projected-variables list so the remote engine actually
    returns its value - the caller is responsible for trimming the extra
    columns back out of the final result. Same treatment for a variable a
    stripped filter depends on.""" ;
        rdfs:label "decompose_for_remote" ;
        ns2:calls ns43:_strip_custom_extends, ns43:_expr_vars ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:hasParameter ns43:decompose_for_remote.param.prepared_query ;
        ns2:hasReturnValue ns43:decompose_for_remote.returns ;
        ns2:lineEnd 233 ;
        ns2:lineStart 174 ;
        ns2:signature "def decompose_for_remote(prepared_query: Any) -> tuple[list[tuple[Variable, Any]], list[Any]]" .

    ns43:decompose_for_remote.param.prepared_query a ns2:Parameter ;
        rdfs:comment "A compiled rdflib ``Query`` object (e.g. from ``sparql_api.prepareQuery``); its ``.algebra`` is mutated in place." ;
        rdfs:label "prepared_query" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns43:decompose_for_remote.returns a ns2:ReturnValue ;
        rdfs:comment "A ``(recipes, filters)`` tuple: the ordered (variable, expression) recipes to evaluate locally per result row via ``evaluate_recipes_locally``, and the boolean filter expressions to re-check locally per row via ``row_passes_filters``. Both are empty if ``prepared_query`` isn't SELECT-shaped." ;
        ns2:annotationText "tuple[list[tuple[Variable, Any]], list[Any]]" ;
        ns2:hasType ns4:builtins.tuple, ns4:rdflib.term.Variable, ns4:typing.Any, ns4:builtins.list .

    ns43:evaluate_recipes_locally dcterms:identifier "starlayer.graph.query.remote_decompose.evaluate_recipes_locally" ;
        a ns2:Function ;
        rdfs:comment """Evaluate each stripped (var, expr) recipe against `row` (a dict of
    Variable -> already-bound, not-yet-restored Node, straight from a raw
    remote result row), in order, merging each computed value back in so a
    later recipe can reference an earlier one's result - mirrors evalExtend's
    own per-row behavior, just replayed after the remote round trip instead
    of during it.

    Reuses rdflib's own private expression evaluator (`_eval`) rather than
    reimplementing custom-function dispatch: the recipe's `expr` is the
    exact CompValue node pulled from the algebra tree, already wired to the
    real, already-registered custom function implementations via rdflib's
    own Function() evalfn - evaluating it here runs the identical code path
    evalExtend would have used locally, just against a QueryContext built
    from the returned row instead of a live join.""" ;
        rdfs:label "evaluate_recipes_locally" ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:hasParameter ns43:evaluate_recipes_locally.param.recipes, ns43:evaluate_recipes_locally.param.row, ns43:evaluate_recipes_locally.param.graph ;
        ns2:hasReturnValue ns43:evaluate_recipes_locally.returns ;
        ns2:lineEnd 284 ;
        ns2:lineStart 236 ;
        ns2:signature "def evaluate_recipes_locally(recipes: list[tuple[Variable, Any]], row: dict, graph: Any) -> dict" .

    ns43:evaluate_recipes_locally.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to evaluate expressions against - supplies context (e.g. for any graph-dependent builtin) to the QueryContext built here." ;
        rdfs:label "graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns43:evaluate_recipes_locally.param.recipes a ns2:Parameter ;
        rdfs:comment "The ordered (variable, expression) list from `decompose_for_remote`." ;
        rdfs:label "recipes" ;
        ns2:annotationText "list[tuple[Variable, Any]]" ;
        ns2:hasType ns4:typing.Any, ns4:builtins.list, ns4:builtins.tuple, ns4:rdflib.term.Variable ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns43:evaluate_recipes_locally.param.row a ns2:Parameter ;
        rdfs:comment "The remote result row's bindings (Variable -> Node), not yet restored to their public (e.g. TripleTerm) form." ;
        rdfs:label "row" ;
        ns2:annotationText "dict" ;
        ns2:hasType ns4:builtins.dict ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns43:evaluate_recipes_locally.returns a ns2:ReturnValue ;
        rdfs:comment "`row` merged with each recipe's computed value, in evaluation order. A recipe whose dependency is unbound is left out of the result (same as evalExtend's own \"leave unbound\" behavior)." ;
        ns2:annotationText "dict" ;
        ns2:hasType ns4:builtins.dict .

    ns43:row_passes_filters dcterms:identifier "starlayer.graph.query.remote_decompose.row_passes_filters" ;
        a ns2:Function ;
        rdfs:comment """Re-check each stripped filter expression (see `decompose_for_remote`)
    against `bindings` (the row *after* `evaluate_recipes_locally` has
    merged in every recipe's computed value, so a filter depending on one
    of those - not just on an ordinary matched variable - sees it too),
    mirroring SPARQL FILTER's own semantics: the row is excluded if any
    expression is false or raises, not just if it's literally ``False``
    (a filter's own "effective boolean value" coercion - `EBV` - already
    handles truthy non-boolean results the same way a real FILTER would).""" ;
        rdfs:label "row_passes_filters" ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:hasParameter ns43:row_passes_filters.param.graph, ns43:row_passes_filters.param.bindings, ns43:row_passes_filters.param.filters ;
        ns2:hasReturnValue ns43:row_passes_filters.returns ;
        ns2:lineEnd 322 ;
        ns2:lineStart 287 ;
        ns2:signature "def row_passes_filters(filters: list[Any], bindings: dict, graph: Any) -> bool" .

    ns43:row_passes_filters.param.bindings a ns2:Parameter ;
        rdfs:comment "The row's bindings after `evaluate_recipes_locally` has merged in every recipe's computed value." ;
        rdfs:label "bindings" ;
        ns2:annotationText "dict" ;
        ns2:hasType ns4:builtins.dict ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns43:row_passes_filters.param.filters a ns2:Parameter ;
        rdfs:comment "The boolean filter expressions from `decompose_for_remote`." ;
        rdfs:label "filters" ;
        ns2:annotationText "list[Any]" ;
        ns2:hasType ns4:typing.Any, ns4:builtins.list ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns43:row_passes_filters.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to evaluate expressions against." ;
        rdfs:label "graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns43:row_passes_filters.returns a ns2:ReturnValue ;
