GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_sparql12_parse.py> {
    ns111:test_sparql12_parse.py dcterms:identifier "tests.graph.unit.test_sparql12_parse" ;
        a ns2:Module ;
        rdfs:comment """Tests for starlayer.graph.query.parseQuery, prepareQuery, parseUpdate, prepareUpdate.

    These wrappers accept SPARQL 1.2 syntax; the round-trip strategy is:
      1. Rewrite to SPARQL 1.1 (text level)
      2. Parse with rdflib's parser
      3. Post-process: remove encoding triples and replace ?__ttN with TripleTerm nodes""" ;
        rdfs:label "test_sparql12_parse" ;
        ns2:declares ns209:TestParseQueryPlainSparql11, ns209:TestPrepareUpdate, ns209:_is_triple_term, ns209:TestParseQueryTripleTermSubject, ns209:TestParseQueryNestedTripleTermInSubjectPosition, ns209:TestPrepareQuery, ns209:TestParseQueryNestedTripleTermInObjectPosition, ns209:TestProcessUpdate, ns209:TestParseUpdate, ns209:TestParseQueryOptionalBlock, ns209:TestParseQueryTripleTermObject, ns209:_first_triples_block ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_sparql12_parse.py" ;
        ns2:importsModule ns4:pytest, ns4:rdflib, ns4:rdflib.plugins.sparql.sparql, ns4:rdflib.plugins.sparql.parserutils .

    ns209:TestParseQueryNestedTripleTermInObjectPosition dcterms:identifier "tests.graph.unit.test_sparql12_parse.TestParseQueryNestedTripleTermInObjectPosition" ;
        a ns2:Class ;
        rdfs:comment """The legal nesting shape - a triple term inside another's *object*
    position - still parses and preserves structure correctly.""" ;
        rdfs:label "TestParseQueryNestedTripleTermInObjectPosition" ;
        ns2:declares ns209:TestParseQueryNestedTripleTermInObjectPosition.test_outer_object_is_triple_term, ns209:TestParseQueryNestedTripleTermInObjectPosition.test_inner_triple_term_preserved, ns209:TestParseQueryNestedTripleTermInObjectPosition.test_does_not_raise ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_sparql12_parse.py" ;
        ns2:lineEnd 158 ;
        ns2:lineStart 130 .

