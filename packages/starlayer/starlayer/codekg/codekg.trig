    ns38:_parse_json_term dcterms:identifier "starlayer.graph.backends.native._parse_json_term" ;
        a ns2:Function ;
        rdfs:comment "Convert a SPARQL JSON binding term to an rdflib node, DirLangString, or TripleTerm." ;
        rdfs:label "_parse_json_term" ;
        ns2:calls ns44:_canonicalize_decimal_lexical_form, ns38:_parse_json_term ;
