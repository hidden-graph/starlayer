GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_global_sparql_rules.py> {
    ns97:test_global_sparql_rules.py dcterms:identifier "tests.shacl.integration.test_global_sparql_rules" ;
        a ns2:Module ;
        rdfs:comment """"Global" (shape-independent) sh:SPARQLRule (SHACL 1.2): a rule node that
    exists standalone, never referenced by any shape's own sh:rule property,
    meant to execute once against the whole graph regardless of shape targeting.
    Found missing entirely via the W3C SHACL 1.2 test suite's global-symmetric
    fixture - pySHACL's own gather_rules() only discovers rules reachable via
    some shape's sh:rule, so a standalone rule node is invisible to it and
    silently never executes.""" ;
        rdfs:label "test_global_sparql_rules" ;
        ns2:declares ns261:test_global_rule_runs_once_against_whole_graph, ns261:test_shape_attached_rule_still_works_alongside_a_global_one, ns261:test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none, ns261:test_global_rule_deactivated_produces_nothing ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_global_sparql_rules.py" ;
        ns2:importsModule ns4:pytest, ns4:rdflib .

    ns261:test_global_rule_deactivated_produces_nothing dcterms:identifier "tests.shacl.integration.test_global_sparql_rules.test_global_rule_deactivated_produces_nothing" ;
        a ns2:Function ;
        rdfs:label "test_global_rule_deactivated_produces_nothing" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_global_sparql_rules.py" ;
        ns2:hasReturnValue ns261:test_global_rule_deactivated_produces_nothing.returns ;
        ns2:instantiates ns28:StarLayerGraph ;
        ns2:lineEnd 114 ;
        ns2:lineStart 86 ;
        ns2:signature "def test_global_rule_deactivated_produces_nothing() -> None" .

    ns261:test_global_rule_deactivated_produces_nothing.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns261:test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none dcterms:identifier "tests.shacl.integration.test_global_sparql_rules.test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none" ;
        a ns2:Function ;
        rdfs:comment """2026-10-08: shacl_graph=None falls back to data_graph itself as the
    rules source - this is the one case the earlier fallback fix actually
    mattered for (not just convenience): a shape-attached sh:rule already
    ran correctly with shacl_graph=None even before the fix, since pySHACL
    discovers it internally via the data graph's own embedded shapes, but
    a *global*, shape-independent SPARQLRule like this one is found only
    by this module's own normalized_shapes-driven discovery - which used
    to stay None (and thus skip global-rule discovery entirely) whenever
    shacl_graph was omitted.""" ;
        rdfs:label "test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_global_sparql_rules.py" ;
