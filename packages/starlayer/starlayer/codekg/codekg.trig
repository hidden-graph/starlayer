GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/starontology/manchester_conformance/test_mc_tree.py> {
    ns334:test_mc_tree.py dcterms:identifier "tests.starontology.manchester_conformance.test_mc_tree" ;
        a ns2:Module ;
        rdfs:comment """Tree-layer tests (T, R, O, V in the plan's P/T/R/O/V/N): does the ``manch:`` tree faithfully carry
    everything the parser accepts?

    Four independent properties per corpus case, each its own test so a failure names the broken layer:

    - ``validates``    the tree ``manchester_parse_to_tree`` produces passes ``manchester_validate``.
    - ``owl_matches``  ``manchester_tree_to_owl(tree)`` is isomorphic to ``parse_manchester(text)`` - the
                       silent-loss probe: anything the parser compiled that never reached the tree shows up
                       here as a missing triple.
    - ``text_roundtrip`` ``manchester_tree_to_text(tree)`` re-parses to the same OWL graph.
    - ``fixpoint``     text -> tree -> text -> tree -> text is stable after the first pass.

    A case whose direct parse fails is skipped here (the differential test owns that failure).""" ;
        rdfs:label "test_mc_tree" ;
        ns2:declares ns343:_prepare, ns343:test_tree_to_owl_matches_direct_parse, ns343:test_tree_validates, ns343:test_tree_second_pass_is_stable, ns343:test_tree_text_roundtrip ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/test_mc_tree.py" ;
        ns2:importsModule ns4:__future__, ns4:pytest .

    ns343:_prepare dcterms:identifier "tests.starontology.manchester_conformance.test_mc_tree._prepare" ;
        a ns2:Function ;
        rdfs:label "_prepare" ;
        ns2:calls ns338:parse_to_graph ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/test_mc_tree.py" ;
        ns2:hasParameter ns343:_prepare.param.case, ns343:_prepare.param.check, ns343:_prepare.param.request ;
        ns2:isPrivate true ;
        ns2:lineEnd 41 ;
        ns2:lineStart 33 ;
        ns2:signature "def _prepare(case, check: str, request)" .

    ns343:_prepare.param.case a ns2:Parameter ;
        rdfs:label "case" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns343:_prepare.param.check a ns2:Parameter ;
        rdfs:label "check" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns343:_prepare.param.request a ns2:Parameter ;
        rdfs:label "request" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns343:test_tree_second_pass_is_stable dcterms:identifier "tests.starontology.manchester_conformance.test_mc_tree.test_tree_second_pass_is_stable" ;
        a ns2:Function ;
        rdfs:label "test_tree_second_pass_is_stable" ;
