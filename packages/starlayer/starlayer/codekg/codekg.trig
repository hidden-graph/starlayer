        ns2:annotationText "ManifestEntry" ;
        ns2:hasType ns4:tests.shacl.w3c_shacl12.manifest.ManifestEntry ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns103:portable_id.param.vendor_root a ns2:Parameter ;
        rdfs:label "vendor_root" ;
        ns2:annotationText "Path" ;
        ns2:hasType ns4:pathlib.Path ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns103:portable_id.returns a ns2:ReturnValue ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

    ns4:__future__ a ns2:ExternalModule .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a ns2:ExternalType ;
        rdfs:label "str" ;
        rdfs:subClassOf ns2:Type .

