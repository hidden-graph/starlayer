    ns334:test_mc_note_only.py dcterms:identifier "tests.starontology.manchester_conformance.test_mc_note_only" ;
        a ns2:Module ;
        rdfs:comment """Checks for constructs the W3C Note allows but the OWL API oracle rejects.

    There is no oracle output to diff against for these, so each case asserts the structure the Note's
    grammar and the OWL 2 RDF mapping imply. A case whose ``ORACLE_REJECTS`` reason starts with an ``F<n>``
    finding code is a known gap and is applied as a strict xfail.""" ;
        rdfs:label "test_mc_note_only" ;
        ns2:declares ns346:test_note_allowed_construct, ns346:check_short_names_in_literals, ns346:_filler, ns346:_range_is, ns346:_restriction, ns346:check_some_not, ns346:check_value_nodeid, ns346:_intersection_members, ns346:_facet_check, ns346:check_short_name_in_restriction, ns346:check_some_chained, ns346:test_every_note_allowed_reject_has_a_check, ns346:check_short_name_in_facet, ns346:check_that_not, ns346:check_annotation_target_forms, ns346:check_that_and_not, ns346:_annotated_chain_list_is_untyped, ns346:_annotated_same_as_once ;
