        rdfs:label "test_aggregate_count_missing_vars_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1036 ;
        ns2:lineStart 1024 ;
        ns2:signature "def test_aggregate_count_missing_vars_fails()" .

    ns181:test_aggregate_distinct_missing_entirely_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_aggregate_distinct_missing_entirely_fails" ;
        a ns2:Function ;
        rdfs:comment """Companion to the above: confirms the cardinality half of the fix too
    - salg:distinct is genuinely always present (rdf:nil when DISTINCT is
    absent), so removing it entirely must now fail (minCount 1), where
    the previous "at most one" framing would have allowed it.""" ;
        rdfs:label "test_aggregate_distinct_missing_entirely_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1181 ;
        ns2:lineStart 1168 ;
        ns2:signature "def test_aggregate_distinct_missing_entirely_fails()" .

    ns181:test_aggregate_distinct_wrong_type_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_aggregate_distinct_wrong_type_fails" ;
        a ns2:Function ;
        rdfs:comment """salg:distinct (Count/Sum/Min/Max/Avg/GroupConcat/Function) was
    checked for cardinality only ("at most one"), and its own message
    claimed the property was optional - both wrong: confirmed empirically
    it is ALWAYS present (an empty Python list `[]` becomes a real
    `salg:distinct rdf:nil` triple when DISTINCT is absent, never an
    omitted property), so a wrongly-typed value, or the property missing
    entirely, both silently conformed before this fix.""" ;
        rdfs:label "test_aggregate_distinct_wrong_type_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1165 ;
        ns2:lineStart 1147 ;
        ns2:signature "def test_aggregate_distinct_wrong_type_fails()" .

    ns181:test_arithmetic_op_every_real_operator_conforms dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_arithmetic_op_every_real_operator_conforms" ;
        a ns2:Function ;
        rdfs:comment """Positive companion - all four real Arithmetic operators (shared by
    Additive and Multiplicative alike) still conform, including */ which
    a first draft of this enum missed entirely (found by the existing
    test_expression_family_queries_conform fixture failing on a real
    multiplicative query, not assumed).""" ;
        rdfs:label "test_arithmetic_op_every_real_operator_conforms" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:hasDecorator ns181:test_arithmetic_op_every_real_operator_conforms.decorator.0 ;
        ns2:hasParameter ns181:test_arithmetic_op_every_real_operator_conforms.param.text, ns181:test_arithmetic_op_every_real_operator_conforms.param.op ;
        ns2:lineEnd 1383 ;
        ns2:lineStart 1373 ;
        ns2:signature "def test_arithmetic_op_every_real_operator_conforms(op, text)" .

    ns181:test_arithmetic_op_every_real_operator_conforms.decorator.0 a ns2:Decorator ;
        ns2:decoratorText "pytest.mark.parametrize('op,text', [('+', 'SELECT * WHERE { ?s ?p ?o . FILTER(?o + 1 > 0) }'), ('-', 'SELECT * WHERE { ?s ?p ?o . FILTER(?o - 1 > 0) }'), ('*', 'SELECT * WHERE { ?s ?p ?o . FILTER(?o * 1 > 0) }'), ('/', 'SELECT * WHERE { ?s ?p ?o . FILTER(?o / 1 > 0) }')])" ;
        ns2:position 0 .

    ns181:test_arithmetic_op_every_real_operator_conforms.param.op a ns2:Parameter ;
        rdfs:label "op" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns181:test_arithmetic_op_every_real_operator_conforms.param.text a ns2:Parameter ;
        rdfs:label "text" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns181:test_arithmetic_op_illegal_value_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_arithmetic_op_illegal_value_fails" ;
        a ns2:Function ;
        rdfs:comment """Same gap as spexpr:op above, for the Arithmetic family's own
    operator-string list (AdditiveExpression/MultiplicativeExpression
    share it) - a legitimately spexpr:PlainString-tagged but nonsense
    operator value previously conformed.""" ;
        rdfs:label "test_arithmetic_op_illegal_value_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1364 ;
        ns2:lineStart 1349 ;
        ns2:signature "def test_arithmetic_op_illegal_value_fails()" .

    ns181:test_arithmetic_op_wrong_member_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_arithmetic_op_wrong_member_fails" ;
        a ns2:Function ;
        rdfs:comment """AdditiveExpression/MultiplicativeExpression's own spexpr:op was
    cardinality-only despite this shape's own pre-existing message already
    claiming "a well-formed rdf:List of operator strings" - nothing
    actually enforced that. Confirmed op is a real Python list of bare
    strings (e.g. ['+', '-']), each spexpr:PlainString-tagged by the generic
    encoder.""" ;
        rdfs:label "test_arithmetic_op_wrong_member_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1306 ;
        ns2:lineStart 1288 ;
        ns2:signature "def test_arithmetic_op_wrong_member_fails()" .

    ns181:test_ask_missing_p_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_ask_missing_p_fails" ;
