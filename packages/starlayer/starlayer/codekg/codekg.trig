GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/codekg/unit/test_queries.py> {
    ns95:test_queries.py dcterms:identifier "tests.codekg.unit.test_queries" ;
        a ns2:Module ;
        rdfs:comment """The code-KG query library: structure, validity, and results against the committed code knowledge graph.

    The first group needs only the stored library (``curated/query-library.ttl``) and is fast; it runs with the
    ordinary tests. The tests marked ``codekg_queries`` re-parse every query and run them against ``codekg.trig``
    (loading that graph takes about 15 seconds): opt in with ``pytest --codekg-queries``. Every query is also
    validated against the sqe shapes when ``scripts/build_query_library.py`` builds the library.""" ;
        rdfs:label "test_queries" ;
        ns2:declares ns347:test_run_query_checks_its_arguments_before_touching_the_graph, ns347:test_validate_library_notices_a_damaged_tree, ns347:test_a_table_keeps_identifiers_whole_and_cuts_long_prose, ns347:test_rows_show_repository_relative_paths_not_machine_paths, ns347:test_queries_can_be_found_by_topic_id_label_and_iri, ns347:test_query_runs_with_its_examples_and_is_bounded, ns347:test_a_known_call_edge_is_found, ns347:test_every_query_has_a_known_topic_and_topics_resolve, ns347:test_unknown_names_suggest_a_close_match, ns347:kg, ns347:test_paging_and_the_footer, ns347:test_command_line, ns347:test_members_of_class_lists_named_tuple_and_dataclass_fields, ns347:test_usage_is_a_ready_to_copy_call, ns347:test_query_text_round_trips_and_follows_the_parameter_rules, ns347:test_the_shapes_notice_a_corrupted_library, ns347:test_the_library_is_valid, ns347:test_competency_questions_carry_their_status, ns347:_shapes_conform, ns347:test_free_form_sparql_is_bounded_and_refuses_what_could_return_everything, ns347:test_results_say_how_old_the_kg_is, ns347:test_the_stored_library_is_the_only_source ;
        ns2:filePath "packages/starlayer/tests/codekg/unit/test_queries.py" ;
        ns2:importsModule ns4:re, ns4:pytest, ns4:pathlib, ns4:__future__, ns4:rdflib .

