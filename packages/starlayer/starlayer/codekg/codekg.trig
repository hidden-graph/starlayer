    ns76:_build_closed_component.ClosedConstraintComponent dcterms:identifier "starlayer.shacl.native_components._build_closed_component.ClosedConstraintComponent" ;
        a ns2:Class ;
        rdfs:comment """Shadows pySHACL's own ``ClosedConstraintComponent`` (registered
    under the same predicates, ``sh:closed``/``sh:ignoredProperties``,
    fully replacing pySHACL's dispatch entry for both, not adding
    alongside it) to add the SHACL 1.2 Core ``sh:closed sh:ByTypes``
    value - pySHACL 0.40 crashes on this outright
    (``AssertionError: sh:closed must take a xsd:boolean literal``).
    The plain-boolean case below reproduces pySHACL's own
    non-SPARQL-mode ``evaluate()`` logic exactly (same
    ``ALWAYS_IGNORE``/``ignored_props``/``working_paths`` checks, same
    violation shape); only the ``sh:ByTypes`` branch is new.""" ;
        rdfs:label "ClosedConstraintComponent" ;
        rdfs:subClassOf ns4:pyshacl.constraints.constraint_component.ConstraintComponent ;
        ns2:declares ns76:_build_closed_component.ClosedConstraintComponent.__init__, ns76:_build_closed_component.ClosedConstraintComponent.constraint_parameters, ns76:_build_closed_component.ClosedConstraintComponent.evaluate, ns76:_build_closed_component.ClosedConstraintComponent.constraint_name ;
