        rdfs:label "_check_sequence" ;
        ns2:calls ns62:_triple_vars, ns62:_check_sequence, ns62:_expr_vars ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/srl_semantic_checks.py" ;
        ns2:hasParameter ns62:_check_sequence.param.elements, ns62:_check_sequence.param.issues, ns62:_check_sequence.param.rule, ns62:_check_sequence.param.v0 ;
        ns2:hasReturnValue ns62:_check_sequence.returns ;
