        ns2:signature "def query(self, base_graph: Graph, goal_pattern: TriplePattern) -> list[dict]" .

    ns63:RuleSet.query.param.base_graph a ns2:Parameter ;
        rdfs:comment "The graph to run the rule set against." ;
        rdfs:label "base_graph" ;
        ns2:annotationText "Graph" ;
