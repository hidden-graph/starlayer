GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_skos_shapes.py> {
    ns111:test_skos_shapes.py dcterms:identifier "tests.graph.unit.test_skos_shapes" ;
        a ns2:Module ;
        rdfs:comment """Tests for starontology.skos / skos-ontology.ttl.

    Unlike the manch:/salg: vocabularies, SKOS needs no encode/decode/round-trip
    layer - a SKOS thesaurus is already plain RDF the moment it's authored - so
    this is the *only* test file for SKOS support: does the ontology load with
    the right entailments, does a well-formed thesaurus conform, and does each
    of the W3C SKOS Reference's own numbered conditions (S9, S13, S14,
    S19/S20, S27, S37, S46) get caught when violated - plus two shapes that
    aren't numbered conditions:
    OrderedCollectionMemberListConsistencyShape (the spec's own §9.4 prose
    expectation that skos:memberList and skos:member describe the same set) and
    ConceptPrefLabelRecommendedShape (a non-normative sh:Info-severity best
    practice - must never flip conforms, unlike every Violation-severity shape
    above).""" ;
        rdfs:label "test_skos_shapes" ;
        ns2:declares ns254:_base_two_concepts, ns254:test_exactmatch_and_broadmatch_between_same_pair_fails, ns254:test_ordered_collection_member_missing_from_memberlist_fails, ns254:test_ordered_collection_also_typed_concept_fails, ns254:test_broader_on_non_concept_subject_fails, ns254:test_two_preflabels_same_language_fails, ns254:test_ordered_collection_with_no_memberlist_at_all_is_unaffected, ns254:test_valid_thesaurus_conforms, ns254:test_concept_with_preflabel_has_no_recommendation_in_report, ns254:test_concept_and_conceptscheme_same_node_fails, ns254:_form_properties, ns254:test_form_shapes_are_members_of_the_shapes_graph, ns254:test_ordered_collection_memberlist_missing_a_real_member_fails, ns254:test_collection_also_typed_concept_fails, ns254:test_widgets_follow_the_value_datatype, ns254:skos_ontology_graph, ns254:_valid_thesaurus, ns254:test_shapes_graph_is_valid_shacl_and_reusable, ns254:test_form_shapes_conform_to_the_meta_shapes, ns254:test_every_form_property_has_a_name_an_order_an_editor_and_a_viewer, ns254:test_related_and_broader_between_same_pair_fails, ns254:test_ordered_collection_memberlist_and_member_agree_conforms, ns254:test_skos_ontology_graph_loads_standalone, ns254:test_ordered_collection_entails_collection_via_rdfs, ns254:test_concept_missing_preflabel_still_conforms_but_is_reported, ns254:test_form_shapes_are_untargeted_so_they_never_change_validation, ns254:test_preflabel_and_altlabel_sharing_a_literal_fails ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_skos_shapes.py" ;
