    ns14:decode_tt_encoded_triples dcterms:identifier "starlayer.graph.parsers.turtle_parser.decode_tt_encoded_triples" ;
        a ns2:Function ;
        rdfs:comment """Reverse ``_skolemize_encoding``'s tt:HASH encoding, yielding real
    ``(s, p, o)`` triples with any tt:HASH-encoded triple-term value
    restored to a proper ``TripleTerm`` object (nested triple terms
    restored recursively).

    ``_skolemize_encoding``'s output is written directly into the store
    for the rdf-1.1 backend (its content-addressed tt:HASH URIs *are* that
    backend's own on-disk encoding, so no further translation is needed -
    ``super().add()`` is correct there and untouched by this function).
    But that same flat, pre-encoded shape is wrong for the native rdf-1.2
    backend, which needs real ``TripleTerm`` objects handed to
    ``StarLayerGraph.add()`` so its own ``_native_add()`` can write them
    using the backend's real ``<<( )>>`` syntax - this function is the
    bridge that makes that possible, used only on the native-backend path
    (see ``StarLayerGraph.parse()``).

    Anonymous reifiers are already ordinary ``BNode``s in ``g`` (see
    ``_skolemize_encoding``) - no decoding needed for them either.""" ;
        rdfs:label "decode_tt_encoded_triples" ;
        ns2:declares ns14:decode_tt_encoded_triples.reconstruct ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/turtle_parser.py" ;
        ns2:hasParameter ns14:decode_tt_encoded_triples.param.g ;
        ns2:hasReturnValue ns14:decode_tt_encoded_triples.returns ;
        ns2:lineEnd 880 ;
        ns2:lineStart 824 ;
        ns2:signature "def decode_tt_encoded_triples(g: Graph)" .

    ns14:decode_tt_encoded_triples.param.g a ns2:Parameter ;
        rdfs:comment "The skolemized graph to decode, as produced by _skolemize_encoding()." ;
        rdfs:label "g" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns14:decode_tt_encoded_triples.reconstruct dcterms:identifier "starlayer.graph.parsers.turtle_parser.decode_tt_encoded_triples.reconstruct" ;
        a ns2:Function ;
