    ns189:TestNativeIdentifierDefault dcterms:identifier "tests.graph.unit.test_conformance.TestNativeIdentifierDefault" ;
        a ns2:Class ;
        rdfs:comment """A native (backend='rdf-1.2') StarLayerGraph constructed with no
    explicit identifier= used to get rdflib's own default (a fresh random
    BNode) - but query()/update() send SPARQL text straight through
    unscoped (the endpoint's own default graph), while infer()/triples()/
    plain iteration wrap every pattern in GRAPH <self.identifier> { ... }
    via _native_scoped() unless self.identifier is exactly
    DATASET_DEFAULT_GRAPH_ID. A random BNode identifier satisfied neither
    exemption, so those two halves of the API silently disagreed about
    which graph is "self's data" - confirmed live, and previously worked
    around explicitly in tests/integration/test_entailment_native.py by
    always passing identifier=DATASET_DEFAULT_GRAPH_ID. Fixed by
    defaulting to it automatically whenever the caller supplies no
    identifier of their own, so the common case agrees by construction.""" ;
        rdfs:label "TestNativeIdentifierDefault" ;
        ns2:declares ns189:TestNativeIdentifierDefault.test_native_backend_explicit_none_identifier_also_defaults, ns189:TestNativeIdentifierDefault.test_default_backend_still_gets_random_bnode, ns189:TestNativeIdentifierDefault.test_native_backend_defaults_identifier_to_dataset_default_graph_id, ns189:TestNativeIdentifierDefault.test_native_backend_respects_explicit_identifier, ns189:TestNativeIdentifierDefault.test_native_backend_respects_positional_identifier ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_conformance.py" ;
        ns2:lineEnd 344 ;
        ns2:lineStart 303 .

    ns189:TestNativeIdentifierDefault.test_default_backend_still_gets_random_bnode dcterms:identifier "tests.graph.unit.test_conformance.TestNativeIdentifierDefault.test_default_backend_still_gets_random_bnode" ;
