GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/lexer.py> {
    ns11:lexer.py dcterms:identifier "starlayer.graph.parsers.lexer" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.lexer

    Character-level tokenization for Turtle 1.2. Handles all token forms:
    <<( )>> triple terms, << >> reification shorthand, <IRI>, quoted strings,
    [ ] blank nodes, ( ) collections, and plain whitespace-delimited tokens.

    Every form below that scans for a closing delimiter raises
    starlayer.graph.parsers.errors.Turtle12SyntaxError if it reaches the end of the
    statement text without finding one, rather than silently treating "no
    closing delimiter found" as "the rest of the text is one token" - the
    statement-level Turtle12SyntaxError.line is filled in by the caller
    (StarLayerTurtleParser.parse()), since these functions only see
    already-extracted, single-statement text with no document-level line info.""" ;
        rdfs:label "lexer" ;
        ns2:declares ns20:next_token, ns20:consume_annotation_block, ns20:split_obj_and_annotations ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/lexer.py" .

    ns20:consume_annotation_block dcterms:identifier "starlayer.graph.parsers.lexer.consume_annotation_block" ;
        a ns2:Function ;
        rdfs:comment """Consume one {| ... |} annotation block from the start of s, handling
    nested {| |} blocks and quoted strings.""" ;
        rdfs:label "consume_annotation_block" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/lexer.py" ;
        ns2:hasParameter ns20:consume_annotation_block.param.s ;
        ns2:hasReturnValue ns20:consume_annotation_block.returns ;
        ns2:lineEnd 211 ;
        ns2:lineStart 174 ;
        ns2:signature "def consume_annotation_block(s)" .

    ns20:consume_annotation_block.param.s a ns2:Parameter ;
        rdfs:comment "Text starting with '{|'." ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns20:consume_annotation_block.returns a ns2:ReturnValue ;
        rdfs:comment "A (body_str, remaining) tuple - the block's inner content (stripped) and the remaining text after the closing '|}'." .

    ns20:next_token dcterms:identifier "starlayer.graph.parsers.lexer.next_token" ;
        a ns2:Function ;
        rdfs:comment "Return the next atomic token in s." ;
        rdfs:label "next_token" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/lexer.py" ;
        ns2:hasParameter ns20:next_token.param.s ;
        ns2:hasReturnValue ns20:next_token.returns ;
        ns2:instantiates ns19:Turtle12SyntaxError ;
        ns2:lineEnd 171 ;
        ns2:lineStart 26 ;
        ns2:signature "def next_token(s)" .

    ns20:next_token.param.s a ns2:Parameter ;
        rdfs:comment "The pre-stripped remaining input text to tokenize from." ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns20:next_token.returns a ns2:ReturnValue ;
        rdfs:comment "A (token, remaining) tuple - the next atomic token and the remaining text after it (left-stripped), or (None, '') if s is empty." .

    ns20:split_obj_and_annotations dcterms:identifier "starlayer.graph.parsers.lexer.split_obj_and_annotations" ;
        a ns2:Function ;
        rdfs:comment """Split an object term plus any trailing ~reifier/{| |} annotation
    suffixes into the object token and its annotation specs.""" ;
        rdfs:label "split_obj_and_annotations" ;
        ns2:calls ns20:next_token, ns20:consume_annotation_block ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/lexer.py" ;
        ns2:hasParameter ns20:split_obj_and_annotations.param.s ;
        ns2:hasReturnValue ns20:split_obj_and_annotations.returns ;
        ns2:instantiates ns19:Turtle12SyntaxError ;
        ns2:lineEnd 291 ;
        ns2:lineStart 214 ;
        ns2:signature "def split_obj_and_annotations(s)" .

    ns20:split_obj_and_annotations.param.s a ns2:Parameter ;
        rdfs:comment "Text of the form 'obj [~ reifier [{| body |}]]* [{| body |}]*'." ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns20:split_obj_and_annotations.returns a ns2:ReturnValue ;
        rdfs:comment "A (obj_token, annotations) tuple, where annotations is a list of (reifier_or_None, body_or_None) pairs in source order." .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_expected_predicate.py> {
    ns97:test_expected_predicate.py dcterms:identifier "tests.shacl.integration.test_expected_predicate" ;
        a ns2:Module ;
        rdfs:comment """sh:expectedPredicate (SHACL 1.2 SPARQL Extensions section 8.2.7,
    "Expected Derived Triples") - both the sh:defaultValue and sh:values halves.

    A rule declaring sh:expectedPredicate ex:p expects the *derived* triples for
    ex:p - computed via sh:defaultValue/sh:values on every non-deactivated
    property shape using ex:p as sh:path - to already be present before it
    executes. sh:values here is SHACL 1.2 Core's *validation-time* computed-value
    mechanism on an ordinary property shape (sh:select/sh:sparqlExpr/a node
    expression - see _compute_sh_values in validator.py) - not the unrelated,
    separately-tracked, genuinely unimplemented sh:PropertyRule/sh:values
    shorthand (a sh:rule-construction mechanism, see that row in
    docs/shacl12-gap-matrix.md's Core changelog table) that happens to share a
    predicate name.

    **Materialized triples are transient, not permanent** - confirmed 2026-08-15
    via the W3C SHACL 1.2 test suite's own expectedPredicate-example fixture,
    whose expected result includes only the dependent rule's own conclusions,
    never the derived ex:area values themselves. An earlier version of this
    feature (and this test file) assumed permanent materialization based on a
    plausible but incorrect reading of the spec prose alone - corrected once
    concrete fixture evidence was available.

    starlayer.shacl/validator.py::_materialize_expected_predicates is the
    implementation, hooked into the same always-applied
    _patch_rules_apply_for_layer_and_run_once wrap item #3 (sh:layer/
    sh:runOnce) already installs - see that function's own docstring for why
    this lives there rather than as a third wrap of TripleRule.apply/
    SPARQLRule.apply.""" ;
        rdfs:label "test_expected_predicate" ;
        ns2:declares ns183:test_shapes_graph_without_expected_predicate_uses_original_pyshacl_loop, ns183:test_expected_predicate_materializes_default_value_before_rule_runs, ns183:test_without_expected_predicate_default_value_is_never_materialized, ns183:test_expected_predicate_prefers_sh_values_over_default_value, ns183:_rectangle_shapes, ns183:test_expected_predicate_does_not_override_an_existing_value ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_expected_predicate.py" ;
        ns2:importsModule ns4:rdflib, ns4:pytest .

    ns183:_rectangle_shapes dcterms:identifier "tests.shacl.integration.test_expected_predicate._rectangle_shapes" ;
        a ns2:Function ;
