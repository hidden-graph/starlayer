    ns76:_ambient_shapes_graph_prefixes dcterms:identifier "starlayer.shacl.native_components._ambient_shapes_graph_prefixes" ;
        a ns2:Function ;
        rdfs:comment """Prefixes declared via any ``sh:ShapesGraph``-typed node's own
    ``sh:declare``, for ambient (implicit) resolution when a ``sh:sparql``
    constraint has no explicit ``sh:prefixes`` reference at all - see
    ``_build_sparql_constraint_component``'s own docstring for why pySHACL's
    ``SPARQLQueryHelper.collect_prefixes()`` never falls back to this on its
    own. Deliberately does *not* also consult ``owl:Ontology`` nodes the way
    pySHACL's own explicit-``sh:prefixes``-reference path does. Per the W3C
    SHACL 1.2 test suite's ``prefixes-002`` fixture, an ``owl:Ontology``-
    declared prefix can be a deliberate distractor (the same prefix letter
    mapped to a different, wrong namespace) that must not be picked up here.""" ;
        rdfs:label "_ambient_shapes_graph_prefixes" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:hasParameter ns76:_ambient_shapes_graph_prefixes.param.shapes_graph ;
