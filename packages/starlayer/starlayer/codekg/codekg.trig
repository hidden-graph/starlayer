        ns2:hasType ns4:builtins.list .

    ns299:_check_group_by_scope dcterms:identifier "starlayer.sparql._syntax_checks._check_group_by_scope" ;
        a ns2:Function ;
        rdfs:label "_check_group_by_scope" ;
