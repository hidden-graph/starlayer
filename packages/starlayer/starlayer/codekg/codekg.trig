        ns2:lineStart 1526 ;
        ns2:signature "def test_closed_plain_boolean_parity_still_violates_on_unlisted_property() -> None" .

    ns152:test_closed_plain_boolean_parity_still_violates_on_unlisted_property.returns a ns2:ReturnValue ;
