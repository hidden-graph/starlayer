        rdfs:comment "The raw shapes graph (used for ``.triples()``/ ``.objects()`` lookups of ``sh:path``/``sh:deactivated``/ ``sh:values``/``sh:defaultValue``)." ;
        rdfs:label "shapes_graph" ;
