    in place on an ElementTree, into the bnode-based rdf:TripleTerm
    intermediate _convert_bnodes() (and rdflib's own 'xml' parser) understand.""" ;
        rdfs:label "_Preprocessor" ;
        ns2:declares ns17:_Preprocessor._emit_triple_term_block, ns17:_Preprocessor._append_term_component, ns17:_Preprocessor.process, ns17:_Preprocessor._resolve_object_from_property, ns17:_Preprocessor._process_property, ns17:_Preprocessor._resolve_node_element_subject, ns17:_Preprocessor._fresh_id, ns17:_Preprocessor._strip_version_attr, ns17:_Preprocessor._process_parse_type_triple, ns17:_Preprocessor.__init__ ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/rdfxml12.py" ;
