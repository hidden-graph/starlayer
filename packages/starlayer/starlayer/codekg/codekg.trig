        ns2:hasType ns4:builtins.bool .

    ns82:_meta_validate_cache_key dcterms:identifier "starlayer.shacl.meta_shapes._meta_validate_cache_key" ;
        a ns2:Function ;
        rdfs:comment """Content-based cache key for one ``meta_validate()`` outcome.

    ``meta_validate()`` is a pure function of (the shapes graph's own
    *content*, the assembled meta-shapes graph's content, the kwargs
    forwarded to ``pyshacl.validate()``) - never of any object's
    identity. That distinction is load-bearing, not academic: a typical
    caller (e.g. ``starontology``'s own ``shapes_graph()``) reparses
    fresh Turtle text into a brand-new ``Graph`` object on every single
    call, so an identity-keyed cache would never hit at all, even for
    byte-for-byte identical content.

    Uses ``starlayer.graph.rdfc.rdfc10_hash`` - the project's existing
    canonical-hashing tool for exactly this "same content, different
    object, possibly different blank node labels" problem - rather than
    hashing a raw serialization, which would spuriously miss whenever
    rdflib mints fresh, arbitrary blank node labels on a re-parse of the
    same source text: two independent reparses of identical shapes
    Turtle produce different N-Triples text but the identical
    ``rdfc10_hash``.

    The assembled meta-shapes graph itself is deliberately *not* hashed
    here - when ``extra_graphs`` is empty (this cache's only scope, see
    ``meta_validate()``'s own gating), ``load_meta_shapes_graph(())``'s
    output is itself always identical within one process, so it
    contributes nothing distinguishing to the key and hashing it too
    would just be another ~20ms paid for free on every call.""" ;
        rdfs:label "_meta_validate_cache_key" ;
        ns2:calls ns293:rdfc10_hash, ns82:_meta_validate_cache_key._hashable ;
        ns2:declares ns82:_meta_validate_cache_key._hashable ;
        ns2:filePath "packages/starlayer/starlayer/shacl/meta_shapes.py" ;
        ns2:hasParameter ns82:_meta_validate_cache_key.param.shapes_graph_for_meta, ns82:_meta_validate_cache_key.param.kwargs ;
        ns2:hasReturnValue ns82:_meta_validate_cache_key.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 112 ;
        ns2:lineStart 55 ;
        ns2:signature "def _meta_validate_cache_key(shapes_graph_for_meta: Any, kwargs: dict) -> tuple | None" .

    ns82:_meta_validate_cache_key._hashable dcterms:identifier "starlayer.shacl.meta_shapes._meta_validate_cache_key._hashable" ;
        a ns2:Function ;
        rdfs:label "_hashable" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/meta_shapes.py" ;
        ns2:hasParameter ns82:_meta_validate_cache_key._hashable.param.v ;
        ns2:hasReturnValue ns82:_meta_validate_cache_key._hashable.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 105 ;
        ns2:lineStart 102 ;
        ns2:signature "def _hashable(v: Any) -> Any" .

    ns82:_meta_validate_cache_key._hashable.param.v a ns2:Parameter ;
        rdfs:label "v" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns82:_meta_validate_cache_key._hashable.returns a ns2:ReturnValue ;
