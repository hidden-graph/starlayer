    ns14:_split_literal.param.val a ns2:Parameter ;
        rdfs:comment "A quoted literal token, e.g. '\"text\"^^xsd:string' or \"'text'@en\"." ;
        rdfs:label "val" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns14:_split_literal.returns a ns2:ReturnValue ;
        rdfs:comment "A (content_str, suffix_str, kind) tuple: content_str is the raw text between the quotes; kind is '^^' for a typed literal, '@' for a language-tagged one, or '' for a plain literal; suffix_str is the datatype/language text after the quote (empty for plain). Correctly skips ^^ and @ sequences that appear inside the quoted string itself." .

