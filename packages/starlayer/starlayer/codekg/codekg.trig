GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/srl_semantic_checks.py> {
    ns48:srl_semantic_checks.py dcterms:identifier "starlayer.sparql.srl_semantic_checks" ;
        a ns2:Module ;
        rdfs:comment """SRL/SPARQL-RL §4.2 "Well-formedness Conditions" - e.g. ``SET(...)`` must
    not reuse an already-bound variable, and every filter/assignment/head
    variable must be bound. These conditions are cross-referential and
    sequence-position-dependent (whether a variable is "already bound" depends
    on every element before it in the same rule body), which SHACL's own
    per-node shape model structurally can't express - so this lives here as a
    function over the decoded ``srl_ast`` tree, not a SHACL shape.

    Private: ``srl.parse_ruleset()`` runs ``_check_ruleset`` on every
    successfully-parsed ``RuleSet`` and raises ``SRLParseError`` if any issue is
    found - the same "one real gate" contract plain SPARQL's own
    ``prepareQuery()`` has (succeed with a usable object, or raise - never hand
    back something that looks fine but silently misbehaves later). Without
    this gate, a ruleset violating the "SET(...) must not reuse an already-
    bound variable" condition parses *and evaluates* with zero error, just
    silently rebinding the variable to the wrong value.

    Implements the spec's own formalism directly and verbatim (not an
    approximation): for a sequence of rule elements given an initial variable
    set V0, ``Vi`` is V0 plus every variable contributed by elements before
    position i, and ``Vall`` is V0 plus every variable contributed by the whole
    sequence. A rule is well-formed iff its body is a well-formed sequence
    (V0 = empty set) and every variable in a head triple template is in the
    body's own ``Vall``. See each check function's docstring for the exact
    per-element-kind condition it enforces.""" ;
        rdfs:label "srl_semantic_checks" ;
        ns2:declares ns62:_triple_vars, ns62:_term_vars, ns62:_SRLWellFormednessIssue, ns62:_check_rule, ns62:_check_ruleset, ns62:_check_sequence, ns62:_expr_vars ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/srl_semantic_checks.py" ;
        ns2:importsModule ns4:dataclasses, ns4:rdflib.plugins.sparql, ns4:rdflib, ns4:__future__ .

    ns62:_SRLWellFormednessIssue dcterms:identifier "starlayer.sparql.srl_semantic_checks._SRLWellFormednessIssue" ;
        a ns2:Class ;
        rdfs:label "_SRLWellFormednessIssue" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/srl_semantic_checks.py" ;
        ns2:hasAttribute ns62:_SRLWellFormednessIssue.attr.context, ns62:_SRLWellFormednessIssue.attr.rule, ns62:_SRLWellFormednessIssue.attr.variable, ns62:_SRLWellFormednessIssue.attr.kind ;
        ns2:hasDecorator ns62:_SRLWellFormednessIssue.decorator.0 ;
        ns2:isPrivate true ;
        ns2:lineEnd 44 ;
        ns2:lineStart 39 .

    ns62:_SRLWellFormednessIssue.attr.context a ns2:Attribute ;
        rdfs:label "context" ;
