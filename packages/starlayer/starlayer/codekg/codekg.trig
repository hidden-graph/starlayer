    ns226:TestFusekiBoundBnodeQuery.test_bound_bnode_subject_query_matches_only_the_correct_node dcterms:identifier "tests.graph.integration.test_fuseki_backend.TestFusekiBoundBnodeQuery.test_bound_bnode_subject_query_matches_only_the_correct_node" ;
        a ns2:Method ;
        rdfs:comment """Deliberately does NOT assert ``first_bnode != second_bnode`` -
    Fuseki's blank-node numbering resets per query, so two genuinely
    different stored blank nodes can legitimately come back with the
    *same* label/value here (confirmed live: both "b0"). That's exactly
    the scenario the provenance-based join fix (rather than a
    label-equality comparison) exists to get right regardless of
    whether the raw values happen to collide - checked here purely
    functionally, via which property values each one actually has.""" ;
        rdfs:label "test_bound_bnode_subject_query_matches_only_the_correct_node" ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_fuseki_backend.py" ;
        ns2:hasParameter ns226:TestFusekiBoundBnodeQuery.test_bound_bnode_subject_query_matches_only_the_correct_node.param.sg_rdf12 ;
        ns2:lineEnd 406 ;
        ns2:lineStart 389 ;
        ns2:signature "def test_bound_bnode_subject_query_matches_only_the_correct_node(self, sg_rdf12)" .

