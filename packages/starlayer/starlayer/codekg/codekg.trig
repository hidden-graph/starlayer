GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/serializers/turtle12.py> {
    ns8:turtle12.py dcterms:identifier "starlayer.graph.serializers.turtle12" ;
        a ns2:Module ;
        rdfs:label "turtle12" ;
        ns2:declares ns24:_compute_list_heads, ns24:_graph_has_dirlangstring, ns24:_fmt, ns24:serialize_turtle12, ns24:_tt_to_str, ns24:_build_fold_map, ns24:_tt_to_reif_str, ns24:_pred_to_ttl, ns24:_sort_key, ns24:iter_lines_outside_strings, ns24:_node_to_ttl, ns24:serialize_longturtle12, ns24:_graph_has_triple_term ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/serializers/turtle12.py" ;
        ns2:importsModule ns4:rdflib, ns4:re, ns4:collections .

    ns24:_build_fold_map dcterms:identifier "starlayer.graph.serializers.turtle12._build_fold_map" ;
        a ns2:Function ;
        rdfs:comment """Return (fold_map, folded_reifiers, tt_subj_map, tt_subj_reifiers).

    fold_map: (s, p, o) -> list of (reifier, anns, is_named)
        Asserted base triple. Anonymous reifiers → {| |}; named → ~ :r {| |}.
    folded_reifiers: reifier nodes suppressed as explicit subjects (asserted fold).
    tt_subj_map: TripleTerm -> {pred: [obj]}
        Unasserted base triple, anonymous reifier → <<( )>> used as subject.
    tt_subj_reifiers: reifier nodes suppressed as explicit subjects (unasserted fold).

    Not foldable (stay as explicit subjects):
    - Reifier annotates multiple triples (e.g. NYT reported X and Y).
    - Reifier appears as an object elsewhere.
    - Unasserted base triple with a named reifier (identity must be preserved).""" ;
