        ns2:hasParameter ns28:StarLayerGraph._before_and_delta_for.param.regimes, ns28:StarLayerGraph._before_and_delta_for.param.timeout, ns28:StarLayerGraph._before_and_delta_for.param.engine ;
        ns2:hasReturnValue ns28:StarLayerGraph._before_and_delta_for.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 2888 ;
