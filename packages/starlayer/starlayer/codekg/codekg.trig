    ns102:iter_manifest_entries dcterms:identifier "tests.shacl.w3c_shacl12.manifest.iter_manifest_entries" ;
        a ns2:Function ;
        rdfs:comment """Recursively walk a manifest, yielding one ManifestEntry per mf:entries member.

    Follows mf:include at every level. A file with no mf:entries of its own
    (a pure router, e.g. the suite's top-level tests/manifest.ttl) yields
    nothing directly - only its included descendants contribute entries.

    An mf:include target that fails to parse yields one synthetic
    parse_error entry for that file (see ManifestEntry.parse_error) and does
    not recurse further into it, rather than raising and aborting the whole
    walk - a handful of the vendored suite's own fixtures use Turtle
    constructs the young StarLayerTurtleParser doesn't yet support (see
    docs/starlayergraph-upstream-change-log.md), and one bad fixture shouldn't
    hide every other entry from collection.""" ;
        rdfs:label "iter_manifest_entries" ;
        ns2:calls ns102:uri_to_path, ns102:iter_manifest_entries, ns102:file_uri, ns102:load_document ;
        ns2:filePath "packages/starlayer/tests/shacl/w3c_shacl12/manifest.py" ;
        ns2:hasParameter ns102:iter_manifest_entries.param._visited, ns102:iter_manifest_entries.param.manifest_path ;
        ns2:instantiates ns102:ManifestEntry ;
        ns2:lineEnd 165 ;
        ns2:lineStart 117 ;
        ns2:signature "def iter_manifest_entries(manifest_path: Path, *, _visited: set[Path] | None=None)" .

