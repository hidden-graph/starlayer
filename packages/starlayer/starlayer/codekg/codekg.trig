    ns71:_add_component_constraints.param.state a ns2:Parameter ;
        rdfs:label "state" ;
        ns2:annotationText "_LowerState" ;
        ns2:hasType ns71:_LowerState ;
        ns2:parameterKind "positional" ;
        ns2:position 4 .

    ns71:_add_component_constraints.param.term a ns2:Parameter ;
        rdfs:label "term" ;
        ns2:annotationText "TripleTermNode" ;
        ns2:hasType ns4:starlayer.sparql.triple_term.TripleTermNode ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns71:_add_component_constraints.returns a ns2:ReturnValue ;
