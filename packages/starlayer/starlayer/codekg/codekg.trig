        rdfs:label "query" ;
        ns2:calls ns61:_srl_query ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/_srl_ast.py" ;
        ns2:hasParameter ns63:RuleSet.query.param.base_graph, ns63:RuleSet.query.param.goal_pattern ;
        ns2:hasReturnValue ns63:RuleSet.query.returns ;
