    ns54:_encode_binding_row dcterms:identifier "starlayer.sparql.to_rdf._encode_binding_row" ;
        a ns2:Function ;
        rdfs:comment """Encode one VALUES-clause row (one of Values.res's list elements) as
    an rdf:List of salg:Binding nodes. See vocab.py's "Binding rows" section.

    Every variable in a VALUES clause gets a dict entry for every row,
    including an UNDEF one — rdflib represents that not as Python None but
    as the bare *string* "UNDEF" (evalValues in rdflib's own evaluate.py
    checks ``if v != "UNDEF"`` before binding). No special-casing needed
    here for it: the generic bare-str handling in _encode (see vocab.py's
    "Bare Python strings" section) already round-trips that bare string
    faithfully, distinctly from a real Literal("UNDEF") term.""" ;
        rdfs:label "_encode_binding_row" ;
        ns2:calls ns54:_encode, ns54:_build_rdf_list ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/to_rdf.py" ;
        ns2:hasParameter ns54:_encode_binding_row.param.graph, ns54:_encode_binding_row.param.row ;
        ns2:hasReturnValue ns54:_encode_binding_row.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 469 ;
        ns2:lineStart 441 ;
        ns2:signature "def _encode_binding_row(row: dict, graph: Graph) -> BNode | URIRef" .

