        a ns2:Function ;
        rdfs:comment "Return Clark-notation tag {ns}local for *iri*." ;
        rdfs:label "_clark" ;
        ns2:calls ns9:_split_iri ;
        ns2:filePath "packages/starlayer/starlayer/graph/serializers/rdfxml12.py" ;
        ns2:hasParameter ns9:_clark.param.iri ;
        ns2:hasReturnValue ns9:_clark.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 72 ;
        ns2:lineStart 69 ;
        ns2:signature "def _clark(iri: str) -> str" .

    ns9:_clark.param.iri a ns2:Parameter ;
        rdfs:label "iri" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns9:_clark.returns a ns2:ReturnValue ;
        ns2:annotationText "str" ;
