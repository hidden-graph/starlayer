    ns38:blank_node_ids_are_stable dcterms:identifier "starlayer.graph.backends.native.blank_node_ids_are_stable" ;
        a ns2:Function ;
        rdfs:comment """Whether a blank-node label this store returns can be used as a stable
    identity in a later query.

    In-process Oxigraph: yes, always. A remote endpoint is *probed once* and
    the answer cached per query URL: two blank nodes are written to a scratch
    named graph, read back in two different query shapes, and their labels
    compared. Oxigraph returns the same id both times; Fuseki labels blank
    nodes with a per-query counter (``b0``, ``b1``...), so the same label can
    name different nodes in different queries. Any error means "not stable",
    the conservative answer (the provenance join is then kept).

    The probe leaves nothing behind (the scratch graph is cleared).""" ;
        rdfs:label "blank_node_ids_are_stable" ;
        ns2:calls ns38:resolve_store_http, ns38:http_update, ns38:http_select, ns38:_in_process ;
        ns2:filePath "packages/starlayer/starlayer/graph/backends/native.py" ;
        ns2:hasParameter ns38:blank_node_ids_are_stable.param.backend, ns38:blank_node_ids_are_stable.param.store ;
        ns2:hasReturnValue ns38:blank_node_ids_are_stable.returns ;
        ns2:lineEnd 479 ;
        ns2:lineStart 433 ;
        ns2:signature "def blank_node_ids_are_stable(store, backend: str) -> bool" .

