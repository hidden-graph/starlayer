GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/shacl/entailment.py> {
    ns74:entailment.py dcterms:identifier "starlayer.shacl.entailment" ;
        a ns2:Module ;
        rdfs:comment """starlayer.shacl.entailment

    Reads and applies a shapes graph's own ``sh:entailment`` declarations
    (SHACL 1.2 Core §1.4), and lets ``inference=`` (the keyword every
    processing-mode function accepts as a shortcut for declaring entailment
    without touching the shapes graph) share that exact same regime - internal
    plumbing for ``validate()``/``apply_rules()``/``evaluate()``/
    ``extract_subgraph()``, not part of the public ``starlayer.shacl`` surface.

    Per the spec text, ``sh:entailment`` is a **shapes-graph-level**
    declaration ("a shapes graph contains any triple with the predicate
    ``sh:entailment``"), not scoped to an individual shape, and multiple
    declared regimes combine into **one** entailment pass, not one pass per
    regime ("the processor MUST provide the entailments for all of the values
    of ``sh:entailment``... during the validation process" - plural values,
    singular process).

    ``infer()``/``query()`` (``starlayer.graph``) already speak the real W3C
    entailment regime IRIs
    (``starlayer.graph.graph.entailment_regimes.ENTAILMENT``), so this module
    needs no separate IRI<->string translation table at all: the IRIs read
    straight out of ``sh:entailment`` triples are the exact same values
    ``infer()`` already accepts.

    Entailment also sees schema axioms declared only in ``ont_graph`` (the
    idiomatic place for ``rdfs:domain``/``rdfs:range``/etc.), not just
    ``data_graph``.

    ``inference=`` takes a real ``ENTAILMENT.*`` IRI, or an iterable of them -
    the same vocabulary ``sh:entailment`` itself uses - unioned into the
    regime set before materializing (the same "multiple regimes combine into
    one pass" rule Core §1.4 already gives ``sh:entailment``'s own multiple
    declared values), going through the identical
    ``_apply_entailment_regimes()`` call either way. A caller passing a plain
    string (e.g. pySHACL's own ``"rdfs"``/``"owlrl"``/etc. vocabulary) gets
    ``ValueError`` from ``_apply_entailment_regimes()``'s own
    unsupported-regime check, since a plain string is never a member of
    ``SUPPORTED_REGIMES`` - only real ``ENTAILMENT.*`` IRIs are accepted.""" ;
        rdfs:label "entailment" ;
        ns2:declares ns85:_apply_entailment_regimes, ns85:apply_entailment, ns85:declared_entailment_regimes ;
        ns2:filePath "packages/starlayer/starlayer/shacl/entailment.py" ;
        ns2:importsModule ns4:typing, ns4:rdflib, ns4:__future__ .

    ns85:_apply_entailment_regimes dcterms:identifier "starlayer.shacl.entailment._apply_entailment_regimes" ;
        a ns2:Function ;
        rdfs:comment """Materialize ``regimes`` (a frozenset of ``ENTAILMENT.*`` IRIs) over
    ``data_graph`` and return the graph to use from here on.

    When ``ont_graph`` is given, entailment is *computed* over
    ``data_graph`` union ``ont_graph`` (so an axiom declared only in
    ``ont_graph``, e.g. ``rdfs:domain``, is actually seen) - but only the
    newly-entailed **delta** is ever materialized back into the result;
    ``ont_graph``'s own raw triples are never copied in, and ``ont_graph``
    itself is never mutated. This mirrors ``infer(mode="delta")``'s own
    "compute over a combined view, materialize only what's new" pattern -
    ``combined.infer(mode="delta")`` already excludes everything present
    in either source graph before reasoning ran, so this needs no separate
    bookkeeping to avoid re-adding ``ont_graph``'s own axioms.""" ;
        rdfs:label "_apply_entailment_regimes" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/entailment.py" ;
        ns2:hasParameter ns85:_apply_entailment_regimes.param.inplace, ns85:_apply_entailment_regimes.param.data_graph, ns85:_apply_entailment_regimes.param.ont_graph, ns85:_apply_entailment_regimes.param.regimes ;
        ns2:hasReturnValue ns85:_apply_entailment_regimes.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 135 ;
        ns2:lineStart 69 ;
        ns2:signature "def _apply_entailment_regimes(data_graph: Any, regimes: frozenset, ont_graph: Any | None=None, *, inplace: bool) -> Any" .

    ns85:_apply_entailment_regimes.param.data_graph a ns2:Parameter ;
        rdfs:comment "The graph entailment is applied to. Must already be a StarLayerGraph." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns85:_apply_entailment_regimes.param.inplace a ns2:Parameter ;
        rdfs:comment "``True`` mutates and returns ``data_graph`` itself; ``False`` returns a *new* graph (``data_graph``'s own triples plus the delta). ``data_graph`` is left completely untouched either way when ``ont_graph`` is given, same non-mutation guarantee as the ``ont_graph=None`` case." ;
        rdfs:label "inplace" ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns85:_apply_entailment_regimes.param.ont_graph a ns2:Parameter ;
        rdfs:comment "An optional graph unioned in only for computing entailment - never copied into the result, never mutated." ;
        rdfs:label "ont_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns85:_apply_entailment_regimes.param.regimes a ns2:Parameter ;
        rdfs:comment "The ``ENTAILMENT.*`` IRIs to materialize." ;
        rdfs:label "regimes" ;
        ns2:annotationText "frozenset" ;
        ns2:hasType ns4:builtins.frozenset ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns85:_apply_entailment_regimes.returns a ns2:ReturnValue ;
        rdfs:comment "The graph to use from here on - ``data_graph`` itself if ``inplace``, otherwise a new graph." ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any .

    ns85:apply_entailment dcterms:identifier "starlayer.shacl.entailment.apply_entailment" ;
        a ns2:Function ;
        rdfs:comment """Materialize ``shacl_graph``'s own declared ``sh:entailment``
    regime(s) over ``data_graph`` (and ``ont_graph``, if given - see
    ``_apply_entailment_regimes``'s own docstring for exactly how), merged
    with whatever ``inference`` contributes, and return the graph to use
    from here on - which is ``data_graph`` itself only when
    ``inplace=True``.

    A no-op (returns ``data_graph`` unchanged, same object either way)
    when ``shacl_graph`` declares no ``sh:entailment`` and ``inference``
    is ``None`` - the overwhelmingly common case. ``shacl_graph`` may
    itself be ``None`` (contributes no declared regimes, same as an empty
    shapes graph).""" ;
        rdfs:label "apply_entailment" ;
        ns2:calls ns85:declared_entailment_regimes, ns85:_apply_entailment_regimes ;
        ns2:filePath "packages/starlayer/starlayer/shacl/entailment.py" ;
        ns2:hasParameter ns85:apply_entailment.param.shacl_graph, ns85:apply_entailment.param.inference, ns85:apply_entailment.param.data_graph, ns85:apply_entailment.param.ont_graph, ns85:apply_entailment.param.inplace ;
        ns2:hasReturnValue ns85:apply_entailment.returns ;
        ns2:lineEnd 203 ;
        ns2:lineStart 138 ;
        ns2:signature "def apply_entailment(data_graph: Any, shacl_graph: Any, ont_graph: Any | None=None, *, inplace: bool, inference: Any | None=None) -> Any" .

    ns85:apply_entailment.param.data_graph a ns2:Parameter ;
        rdfs:comment "The graph entailment is applied to. Must already be a StarLayerGraph (same precondition ``infer()`` itself enforces) - every real caller already guarantees this by the time entailment needs applying (``validate()``'s own ``normalize_graph_inputs()`` call happens first)." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns85:apply_entailment.param.inference a ns2:Parameter ;
        rdfs:comment "A real ``ENTAILMENT.*`` IRI, or an iterable of them - the *same vocabulary* ``sh:entailment`` itself uses, unioned into the regime set before materializing (the same \"multiple regimes combine into one pass\" rule Core §1.4 already gives ``sh:entailment``'s own multiple declared values). ``None`` (the default) contributes nothing. This is every processing-mode function's own ``inference=`` keyword - a way to request entailment without touching the shapes graph. Does not accept pySHACL's own string vocabulary (``\"rdfs\"``/``\"owlrl\"``/etc.) - only real ``ENTAILMENT.*`` IRIs." ;
        rdfs:label "inference" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns85:apply_entailment.param.inplace a ns2:Parameter ;
        rdfs:comment "Must be threaded through from the caller's own resolved mode options (``resolve_mode_options(...)['inplace']``) - not optional/defaulted, since the plain ``\"validation\"`` mode's own ``inplace=False`` guarantee (never mutating the caller's data) depends on every caller passing this explicitly rather than relying on a default." ;
        rdfs:label "inplace" ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns85:apply_entailment.param.ont_graph a ns2:Parameter ;
        rdfs:comment "An optional ontology graph, unioned in only for computing entailment (see ``_apply_entailment_regimes``)." ;
        rdfs:label "ont_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns85:apply_entailment.param.shacl_graph a ns2:Parameter ;
        rdfs:comment "The shapes graph whose ``sh:entailment`` declarations to read. May be ``None``." ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns85:apply_entailment.returns a ns2:ReturnValue ;
        rdfs:comment "The graph to use from here on - ``data_graph`` itself if ``inplace``, otherwise a new graph." ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any .

    ns85:declared_entailment_regimes dcterms:identifier "starlayer.shacl.entailment.declared_entailment_regimes" ;
        a ns2:Function ;
        rdfs:comment """Every distinct object of an ``sh:entailment`` triple anywhere in
    ``shacl_graph`` - not scoped to any one shape's own subject, matching
    the spec's shapes-graph-level declaration.""" ;
        rdfs:label "declared_entailment_regimes" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/entailment.py" ;
        ns2:hasParameter ns85:declared_entailment_regimes.param.shacl_graph ;
        ns2:hasReturnValue ns85:declared_entailment_regimes.returns ;
        ns2:lineEnd 66 ;
        ns2:lineStart 52 ;
        ns2:signature "def declared_entailment_regimes(shacl_graph: Any) -> frozenset" .

    ns85:declared_entailment_regimes.param.shacl_graph a ns2:Parameter ;
        rdfs:comment "The shapes graph to scan." ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns85:declared_entailment_regimes.returns a ns2:ReturnValue ;
        rdfs:comment "The declared ``ENTAILMENT.*`` regime IRIs, or an empty frozenset if none are declared (the common case - most shapes graphs rely only on the unconditional ``rdf:type``/``rdfs:subClassOf`` \"SHACL type\" closure, which needs no declaration whatsoever)." ;
        ns2:annotationText "frozenset" ;
        ns2:hasType ns4:builtins.frozenset .

    ns4:__future__ a ns2:ExternalModule .

