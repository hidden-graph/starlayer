GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/query/remote_decompose.py> {
    ns33:remote_decompose.py dcterms:identifier "starlayer.graph.query.remote_decompose" ;
        a ns2:Module ;
        rdfs:comment """Decompose a SPARQL-1.1-*shaped* query (as produced by starlayer.sparql's
    lowering, see starlayer.graph.query.query_cache) for execution against a genuinely
    remote store (rdflib's SPARQLStore/SPARQLUpdateStore - real Fuseki-as-1.1 or
    any other HTTP SPARQL 1.1 endpoint).

    For TRIPLE()/isTRIPLE(TRIPLE(...))/STRLANGDIR() (and SUBJECT()/PREDICATE()/
    OBJECT() on a value that isn't already sitting in the store) that lowering
    calls starlayer.graph's own custom SPARQL extension functions (register_custom_function
    - see starlayer.graph.query.custom_functions). Those registrations are local-process
    only: a remote SPARQL engine has never heard of the function IRI. Per SPARQL
    1.1's own extension-function error semantics,
    an unbound/unknown function call inside a BIND doesn't fail the query - it
    just leaves that BIND's target variable unbound for every row. So the query
    runs, returns rows, and the relevant column is silently empty - no exception,
    just wrong data.

    The fix used here is the same one the original in-memory/native evaluation
    path already relies on implicitly: run the plain-SPARQL-1.1-expressible part
    of the query remotely in one round trip, then evaluate the custom-function
    parts locally in Python - using the exact same, already-registered function
    implementations - once the now-known bound values are back, merging the
    computed values into each result row before returning to the caller.

    Concretely: parse the rewritten text into a real algebra tree (prepareQuery
    succeeds locally since the custom functions are registered in-process), walk
    it to find every ``Extend`` whose bound expression is - or transitively
    depends on - a call to one of starlayer.graph's custom functions, strip those
    Extend nodes (keeping their inner pattern), and record an ordered "recipe"
    list of (variable, expression) to replay locally, per result row, after the
    simplified query comes back from the remote store.""" ;
        rdfs:label "remote_decompose" ;
        ns2:declares ns43:_strip_custom_extends, ns43:contains_custom_function_call, ns43:row_passes_filters, ns43:_is_custom_function_call, ns43:evaluate_recipes_locally, ns43:decompose_for_remote, ns43:_expr_vars, ns43:_cv_get ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:importsModule ns4:rdflib, ns4:typing, ns4:__future__, ns4:rdflib.plugins.sparql.parserutils .

    ns43:_cv_get dcterms:identifier "starlayer.graph.query.remote_decompose._cv_get" ;
        a ns2:Function ;
        rdfs:label "_cv_get" ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:hasParameter ns43:_cv_get.param.default, ns43:_cv_get.param.node, ns43:_cv_get.param.key ;
        ns2:hasReturnValue ns43:_cv_get.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 55 ;
        ns2:lineStart 51 ;
        ns2:signature "def _cv_get(node: CompValue, key: str, default: Any=None) -> Any" .

    ns43:_cv_get.param.default a ns2:Parameter ;
        rdfs:label "default" ;
        ns2:annotationText "Any" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns43:_cv_get.param.key a ns2:Parameter ;
        rdfs:label "key" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns43:_cv_get.param.node a ns2:Parameter ;
        rdfs:label "node" ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns43:_cv_get.returns a ns2:ReturnValue ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any .

    ns43:_expr_vars dcterms:identifier "starlayer.graph.query.remote_decompose._expr_vars" ;
        a ns2:Function ;
        rdfs:comment """Variables `expr` depends on. rdflib's own algebra construction
    already computes and stashes this as `_vars` on every CompValue
    expression node - only bare Variable/constant leaves need special-
    casing (a bare Variable reference has no `_vars` of its own; it *is*
    its own dependency).""" ;
        rdfs:label "_expr_vars" ;
        ns2:calls ns43:_cv_get ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:hasParameter ns43:_expr_vars.param.expr ;
        ns2:hasReturnValue ns43:_expr_vars.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 68 ;
        ns2:lineStart 58 ;
        ns2:signature "def _expr_vars(expr: Any) -> set" .

    ns43:_expr_vars.param.expr a ns2:Parameter ;
        rdfs:label "expr" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns43:_expr_vars.returns a ns2:ReturnValue ;
        ns2:annotationText "set" ;
        ns2:hasType ns4:builtins.set .

    ns43:_is_custom_function_call dcterms:identifier "starlayer.graph.query.remote_decompose._is_custom_function_call" ;
        a ns2:Function ;
        rdfs:label "_is_custom_function_call" ;
        ns2:calls ns43:_cv_get ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:hasParameter ns43:_is_custom_function_call.param.expr ;
        ns2:hasReturnValue ns43:_is_custom_function_call.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 76 ;
        ns2:lineStart 71 ;
        ns2:signature "def _is_custom_function_call(expr: Any) -> bool" .

    ns43:_is_custom_function_call.param.expr a ns2:Parameter ;
        rdfs:label "expr" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns43:_is_custom_function_call.returns a ns2:ReturnValue ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool .

    ns43:_strip_custom_extends dcterms:identifier "starlayer.graph.query.remote_decompose._strip_custom_extends" ;
        a ns2:Function ;
        rdfs:comment """Recursively strip Extend/Filter nodes that (transitively) depend on
    a starlayer.graph custom function.

    Extend nodes get a ``(var, expr)`` recipe appended, same as before.
    Filter nodes - a shape only the starlayer.sparql-based pipeline
    produces, not the old text rewriter this module was originally built
    against: a non-ground triple-term pattern's own predicate constraint
    lowers to ``FILTER(PREDICATE(?tt) = :knows)`` rather than an
    Extend+equality-check - get their whole boolean expression appended to
    `filters` instead, to be re-evaluated locally per row (SPARQL's own
    FILTER semantics: exclude the row if the expression is false or
    raises), since a remote engine sent this expression as-is would raise
    on the unknown function and silently exclude every row rather than
    just failing to compute one value the way an unbound BIND target does.

    Post-order: children are visited (and their own recipes/filters
    recorded) before their parent, so `recipes` ends up in dependency
    order - an earlier recipe never references a variable defined by a
    later one, matching how BIND itself would have evaluated them.

    Uses `contains_custom_function_call` (recursive), not
    `_is_custom_function_call` (direct-node-only): a Filter's own
    expression is essentially never *itself* the Function call - it's a
    RelationalExpression/ConditionalExpression *containing* one - so a
    direct-only check would never match it. Strictly more general for
    Extend too (still matches the direct-call case, since
    contains_custom_function_call checks that first), so both use the same
    condition.""" ;
        rdfs:label "_strip_custom_extends" ;
        ns2:calls ns43:_expr_vars, ns43:_strip_custom_extends, ns43:contains_custom_function_call ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/remote_decompose.py" ;
        ns2:hasParameter ns43:_strip_custom_extends.param.filters, ns43:_strip_custom_extends.param.recipes, ns43:_strip_custom_extends.param.node, ns43:_strip_custom_extends.param.local_vars ;
        ns2:hasReturnValue ns43:_strip_custom_extends.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 171 ;
        ns2:lineStart 105 ;
        ns2:signature "def _strip_custom_extends(node: Any, local_vars: set, recipes: list, filters: list) -> Any" .

    ns43:_strip_custom_extends.param.filters a ns2:Parameter ;
        rdfs:comment "Mutated in place - accumulates each stripped Filter's boolean expression." ;
        rdfs:label "filters" ;
        ns2:annotationText "list" ;
        ns2:hasType ns4:builtins.list ;
        ns2:parameterKind "positional" ;
        ns2:position 3 .

    ns43:_strip_custom_extends.param.local_vars a ns2:Parameter ;
        rdfs:comment "Mutated in place - accumulates every variable bound by a stripped Extend, so a later recipe/filter can tell it's depending on a locally-evaluated value rather than one the remote store will return." ;
        rdfs:label "local_vars" ;
        ns2:annotationText "set" ;
        ns2:hasType ns4:builtins.set ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns43:_strip_custom_extends.param.node a ns2:Parameter ;
        rdfs:comment "The algebra (sub)tree to process." ;
        rdfs:label "node" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns43:_strip_custom_extends.param.recipes a ns2:Parameter ;
        rdfs:comment "Mutated in place - accumulates (variable, expression) pairs for each stripped Extend, in dependency order." ;
        rdfs:label "recipes" ;
        ns2:annotationText "list" ;
        ns2:hasType ns4:builtins.list ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns43:_strip_custom_extends.returns a ns2:ReturnValue ;
