        ns2:lineStart 39 ;
        ns2:signature "def _encode_data_prop_range()" .

    ns194:test_broken_mid_chain_rdf_list_fails dcterms:identifier "tests.graph.unit.test_manchester_ast_shapes.test_broken_mid_chain_rdf_list_fails" ;
        a ns2:Function ;
        rdfs:comment """A rdf:List missing rdf:first partway through must fail the generic
    WellFormedListShape check - not just at the head.""" ;
