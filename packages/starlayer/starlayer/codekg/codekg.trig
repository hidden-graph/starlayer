        ns2:lineEnd 2733 ;
        ns2:lineStart 2705 ;
        ns2:signature "def isomorphic(self, other) -> bool" .

    ns28:StarLayerGraph.isomorphic.param.other a ns2:Parameter ;
        rdfs:comment "The graph to compare against. Need not be a StarLayerGraph - the unfold works directly off raw triples, degrading to a no-op (plain rdflib isomorphism) for a graph with no tt: content at all." ;
        rdfs:label "other" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

