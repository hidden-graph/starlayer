GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/entailment_rdf.py> {
    ns48:entailment_rdf.py dcterms:identifier "starlayer.sparql.entailment_rdf" ;
        a ns2:Module ;
        rdfs:comment """starlayer.sparql.entailment_rdf

    Query-time RDF entailment, via rewriting an already-lowered plain SPARQL 1.1
    algebra tree - no data is copied or materialized. Sibling to
    starlayer.sparql.entailment_rdfs (RDFS entailment, one step stronger); this module
    covers the SPARQL 1.1/1.2 Entailment Regimes spec's separate, weaker "RDF
    Entailment" regime (https://www.w3.org/TR/rdf11-mt/#rdf-entailment).

    RDF entailment = simple entailment plus, per the RDF 1.1 Semantics spec:

        rdfD2 - if the graph contains any triple `xxx aaa yyy`, it RDF-entails
            `aaa rdf:type rdf:Property` - every term used anywhere as a
            predicate is entailed to be an rdf:Property. The only rule
            implemented here - the one rule that actually answers a question
            about the data being queried.

    Deliberately out of scope, matching the precedent entailment_rdfs.py
    already sets for its own "vocabulary-level" exclusions (rdfs4a/4b/8/12/13,
    the fixed RDFS axiomatic triples):

        rdfD1 - for a typed literal with a *recognized* datatype, entails an
            existential blank node witnessing "_:nnn rdf:type <that datatype>".
            Depends on an implementation-defined "recognized datatype map," and
            produces a fact about an anonymous witness node a query could
            rarely usefully target.

        The fixed set of ~9 RDF axiomatic triples (rdf:type rdf:type
            rdf:Property, rdf:subject rdf:type rdf:Property, ...,
            rdf:nil rdf:type rdf:List), plus one more such triple *per
            container-membership-property IRI* (rdf:_1, rdf:_2, ...) that
            actually occurs in the graph or query - an infinite family, only
            ever instantiated for IRIs actually present, and - like RDFS's own
            excluded axiomatic triples - vocabulary-level noise that doesn't
            answer a real question about the data being queried.

    Scoping note, unlike entailment_rdfs.py's rdf:type handling: the rewrite
    here only triggers when the *object* is the literal bound term rdf:Property,
    not a variable. RDFS's rdf:type rewrite generalizes correctly to a variable
    object because it walks a real class hierarchy via a property path; rdfD2
    is a single fixed axiom about one specific class, and a generic
    `?p rdf:type ?class` query has no principled bounded rewrite that adds "and
    ?class could also be rdf:Property" without turning this into an unbounded,
    schema-independent search over every possible additional type-fact - the
    same "regular fragment" tractability constraint entailment_rdfs.py's own
    module docstring describes for RDFS.""" ;
        rdfs:label "entailment_rdf" ;
        ns2:declares ns49:_rewrite_bgp, ns49:_property_union, ns49:rewrite_algebra_for_rdf ;
        ns2:filePath "packages/starlayer/starlayer/sparql/entailment_rdf.py" ;
        ns2:importsModule ns4:__future__, ns4:rdflib, ns4:rdflib.plugins.sparql.algebra, ns4:itertools, ns4:rdflib.plugins.sparql.parserutils, ns4:typing .

    ns49:_property_union dcterms:identifier "starlayer.sparql.entailment_rdf._property_union" ;
        a ns2:Function ;
        rdfs:comment """rdfD2 for one ``(s, rdf:type, rdf:Property)`` triple pattern: match
    either the literal asserted fact, or "s is used as a predicate
    anywhere" - a fresh-variable BGP joined via Union, the same composition
    pattern entailment_rdfs.py's own _type_union already establishes.""" ;
        rdfs:label "_property_union" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/entailment_rdf.py" ;
        ns2:hasParameter ns49:_property_union.param.fresh, ns49:_property_union.param.s ;
        ns2:hasReturnValue ns49:_property_union.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 117 ;
        ns2:lineStart 97 ;
        ns2:signature "def _property_union(s: Any, fresh: itertools.count) -> CompValue" .

    ns49:_property_union.param.fresh a ns2:Parameter ;
        rdfs:comment "Shared counter supplying fresh variable suffixes across the whole rewrite pass." ;
        rdfs:label "fresh" ;
        ns2:annotationText "itertools.count" ;
        ns2:hasType ns4:itertools.count ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns49:_property_union.param.s a ns2:Parameter ;
        rdfs:comment "The triple pattern's subject term (the term being tested for rdf:Property membership)." ;
        rdfs:label "s" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns49:_property_union.returns a ns2:ReturnValue ;
        rdfs:comment "A Union algebra node of the two alternatives." ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue .

    ns49:_rewrite_bgp dcterms:identifier "starlayer.sparql.entailment_rdf._rewrite_bgp" ;
        a ns2:Function ;
        rdfs:comment """Return the algebra node replacing one BGP: a Join of a "simple" BGP
    (every triple whose entailment is exactly one alternative, matching what
    a plain BGP already does) with one Union node per triple matching
    rdfD2's trigger shape (s, rdf:type, rdf:Property).""" ;
        rdfs:label "_rewrite_bgp" ;
        ns2:calls ns49:_property_union ;
        ns2:filePath "packages/starlayer/starlayer/sparql/entailment_rdf.py" ;
        ns2:hasParameter ns49:_rewrite_bgp.param.fresh, ns49:_rewrite_bgp.param.bgp ;
        ns2:hasReturnValue ns49:_rewrite_bgp.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 94 ;
        ns2:lineStart 67 ;
        ns2:signature "def _rewrite_bgp(bgp: CompValue, fresh: itertools.count) -> CompValue" .

    ns49:_rewrite_bgp.param.bgp a ns2:Parameter ;
        rdfs:comment "The BGP algebra node to rewrite." ;
        rdfs:label "bgp" ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns49:_rewrite_bgp.param.fresh a ns2:Parameter ;
        rdfs:comment "Shared counter supplying fresh variable suffixes across the whole rewrite pass." ;
        rdfs:label "fresh" ;
        ns2:annotationText "itertools.count" ;
        ns2:hasType ns4:itertools.count ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns49:_rewrite_bgp.returns a ns2:ReturnValue ;
        rdfs:comment "The replacement algebra node (a Join chain, or the original-shaped BGP if nothing matched)." ;
        ns2:annotationText "CompValue" ;
        ns2:hasType ns4:rdflib.plugins.sparql.parserutils.CompValue .

    ns49:rewrite_algebra_for_rdf dcterms:identifier "starlayer.sparql.entailment_rdf.rewrite_algebra_for_rdf" ;
        a ns2:Function ;
        rdfs:comment """Return ``algebra`` with every BGP rewritten for RDF entailment (see
    module docstring for exactly which rule). Mutates and returns the same
    tree (matching ``rdflib.plugins.sparql.algebra.traverse``'s own
    contract) - idempotent, since every triple this rewrite produces uses a
    fresh ``__starlayer_rdf_N`` variable in a slot that never matches the
    ``p == RDF.type and o == RDF.Property`` trigger a second time (the
    fresh predicate variable is never literally ``rdf:Property``).""" ;
        rdfs:label "rewrite_algebra_for_rdf" ;
        ns2:calls ns49:_rewrite_bgp ;
        ns2:declares ns49:rewrite_algebra_for_rdf._visit ;
        ns2:filePath "packages/starlayer/starlayer/sparql/entailment_rdf.py" ;
        ns2:hasParameter ns49:rewrite_algebra_for_rdf.param.algebra ;
        ns2:hasReturnValue ns49:rewrite_algebra_for_rdf.returns ;
        ns2:lineEnd 143 ;
        ns2:lineStart 120 ;
        ns2:signature "def rewrite_algebra_for_rdf(algebra: Any) -> Any" .

    ns49:rewrite_algebra_for_rdf._visit dcterms:identifier "starlayer.sparql.entailment_rdf.rewrite_algebra_for_rdf._visit" ;
        a ns2:Function ;
        rdfs:label "_visit" ;
        ns2:calls ns49:_rewrite_bgp ;
        ns2:filePath "packages/starlayer/starlayer/sparql/entailment_rdf.py" ;
        ns2:hasParameter ns49:rewrite_algebra_for_rdf._visit.param.node ;
        ns2:hasReturnValue ns49:rewrite_algebra_for_rdf._visit.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 141 ;
        ns2:lineStart 138 ;
        ns2:signature "def _visit(node: Any) -> Any" .

    ns49:rewrite_algebra_for_rdf._visit.param.node a ns2:Parameter ;
        rdfs:label "node" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns49:rewrite_algebra_for_rdf._visit.returns a ns2:ReturnValue ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any .

    ns49:rewrite_algebra_for_rdf.param.algebra a ns2:Parameter ;
        rdfs:comment "The root of an already-lowered plain SPARQL 1.1 algebra tree." ;
        rdfs:label "algebra" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

