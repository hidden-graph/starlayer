    ns278:graph_diff dcterms:identifier "starlayer.graph.compare.graph_diff" ;
        a ns2:Function ;
        rdfs:comment """RDF-1.2-aware replacement for ``rdflib.compare.graph_diff``.

    Operates on (and returns) the *decomposed* graphs - the returned
    "in first only"/"in second only" graphs describe differences in terms of
    the synthetic reification fragments, not the original triple terms, so
    this is meant for programmatic use (e.g. ``len(in_first) == 0``), not for
    display back to a user.""" ;
        rdfs:label "graph_diff" ;
        ns2:calls ns278:_decompose ;
        ns2:filePath "packages/starlayer/starlayer/graph/compare.py" ;
        ns2:hasParameter ns278:graph_diff.param.g2, ns278:graph_diff.param.g1 ;
        ns2:lineEnd 163 ;
        ns2:lineStart 154 ;
        ns2:signature "def graph_diff(g1: Any, g2: Any)" .

    ns278:graph_diff.param.g1 a ns2:Parameter ;
        rdfs:label "g1" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns278:graph_diff.param.g2 a ns2:Parameter ;
        rdfs:label "g2" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns278:isomorphic dcterms:identifier "starlayer.graph.compare.isomorphic" ;
        a ns2:Function ;
        rdfs:comment """RDF-1.2-aware replacement for ``rdflib.compare.isomorphic`` - correct
    for graphs containing triple terms (including ones with nested blank
    nodes), identical to the original for graphs that don't. Also RDF
    1.1-correct for simple-literal-vs-explicit-``xsd:string`` (see module
    docstring): a plain ``Literal("x")`` and ``Literal("x", datatype=XSD.string)``
