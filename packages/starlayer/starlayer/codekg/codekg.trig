        ns2:importsModule ns4:__future__, ns4:collections, ns4:rdflib.namespace, ns4:hashlib, ns4:collections.abc, ns4:typing, ns4:rdflib.term, ns4:rdflib, ns4:rdflib.query .

    ns7:_canonicalize_numeric_literal dcterms:identifier "starlayer.graph.model.encoding._canonicalize_numeric_literal" ;
        a ns2:Function ;
        rdfs:comment """Reformat a decimal/double/float-typed Literal's lexical form to its
    XSD canonical form. A no-op for anything already canonical, or for any
    other datatype.

    decimal: canonical form requires a decimal point with at least one
    digit on each side (e.g. "42.0", not "42").
    double/float: reformats through Python's own float parsing/repr, which
    - for the ordinary (non-extreme-magnitude) range this is actually used
    for in practice - already produces XSD's own "at least one digit each
    side of a required decimal point" convention (e.g. "123e0" -> "123.0",
    "1.5E2" -> "150.0"); not a full implementation of XSD 1.1's exact
    canonical-form algorithm for every possible magnitude (e.g. very
    large/small values render with Python's "1e+30"-style exponent rather
    than XSD's "1.0E30"), which is a level of fidelity nothing in this
    codebase currently needs.""" ;
        rdfs:label "_canonicalize_numeric_literal" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:_canonicalize_numeric_literal.param.literal ;
        ns2:hasReturnValue ns7:_canonicalize_numeric_literal.returns ;
        ns2:lineEnd 249 ;
        ns2:lineStart 205 ;
        ns2:signature "def _canonicalize_numeric_literal(literal: Literal) -> Literal" .

    ns7:_canonicalize_numeric_literal.param.literal a ns2:Parameter ;
        rdfs:comment "The Literal to canonicalize." ;
        rdfs:label "literal" ;
        ns2:annotationText "Literal" ;
        ns2:hasType ns4:rdflib.term.Literal ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:_canonicalize_numeric_literal.returns a ns2:ReturnValue ;
        rdfs:comment "A Literal with the same datatype and a canonicalized lexical form, or the original object unchanged if it was already canonical or not one of the canonicalizable numeric datatypes." ;
        ns2:annotationText "Literal" ;
        ns2:hasType ns4:rdflib.term.Literal .

    ns7:_reencode_tt dcterms:identifier "starlayer.graph.model.encoding._reencode_tt" ;
        a ns2:Function ;
        rdfs:comment """Emit tt's rdf:subject/predicate/object encoding triples into
    out_graph (recursively for any nested TripleTerm component) and return
    its content-addressed URI - the write-side mirror of
    StarLayerGraph._intern_tt(), but writing to an arbitrary graph rather
    than `self`, and given an already-fully-resolved TripleTerm (no nested
    tt:HASH URIRefs left to look up) rather than one that might still
    contain them. See inject_missing_tt_encoding()'s docstring for why this
    exists.""" ;
        rdfs:label "_reencode_tt" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:_reencode_tt.param.out_graph, ns7:_reencode_tt.param.tt ;
        ns2:hasReturnValue ns7:_reencode_tt.returns ;
        ns2:lineEnd 353 ;
        ns2:lineStart 329 ;
        ns2:signature "def _reencode_tt(tt: TripleTerm, out_graph: Graph) -> URIRef" .

    ns7:_reencode_tt.param.out_graph a ns2:Parameter ;
        rdfs:comment "The graph to add the encoding triples to." ;
        rdfs:label "out_graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns7:_reencode_tt.param.tt a ns2:Parameter ;
        rdfs:comment "The triple term to encode, fully resolved - no unresolved nested tt:HASH URIRefs." ;
        rdfs:label "tt" ;
        ns2:annotationText "TripleTerm" ;
        ns2:hasType ns4:starlayer.graph.model.triple.TripleTerm ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:_reencode_tt.returns a ns2:ReturnValue ;
        rdfs:comment "The tt:HASH URIRef naming tt." ;
        ns2:annotationText "URIRef" ;
        ns2:hasType ns4:rdflib.term.URIRef .

    ns7:canonicalize_query_result_value dcterms:identifier "starlayer.graph.model.encoding.canonicalize_query_result_value" ;
        a ns2:Function ;
        rdfs:comment """Canonicalize a numeric-XSD-typed Literal's lexical form for a SPARQL
    query *result* value specifically, recursing into a TripleTerm's own
    subject/object components.

    Deliberately applied only here, at the SELECT-result boundary (see
    restore_select_bindings below) - not anywhere data is read verbatim
    (plain .triples()/_restore() on their own): Turtle/N-Triples parsing
    deliberately preserves a literal's exact lexical form as written, since
    RDF 1.2's own term-equality rules require it. A query *result*, though,
    is expected to match what a conformant engine's own query results look
    like (e.g. "123e0" canonicalizes to "123.0").""" ;
        rdfs:label "canonicalize_query_result_value" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:canonicalize_query_result_value.param.node ;
        ns2:hasReturnValue ns7:canonicalize_query_result_value.returns ;
        ns2:lineEnd 289 ;
        ns2:lineStart 252 ;
        ns2:signature "def canonicalize_query_result_value(node: Node | TripleTerm) -> Node | TripleTerm" .

    ns7:canonicalize_query_result_value.param.node a ns2:Parameter ;
        rdfs:comment "The query result value to canonicalize - an RDF term or a TripleTerm." ;
        rdfs:label "node" ;
        ns2:annotationText "Node | TripleTerm" ;
        ns2:hasType ns4:rdflib.term.Node, ns4:starlayer.graph.model.triple.TripleTerm ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:canonicalize_query_result_value.returns a ns2:ReturnValue ;
        rdfs:comment "node unchanged if nothing needed canonicalizing (preserving identity, not just equality, so a TripleTerm's own _namespace_manager survives), or an equivalent value with any numeric literal's lexical form canonicalized." ;
        ns2:annotationText "Node | TripleTerm" ;
        ns2:hasType ns4:rdflib.term.Node, ns4:starlayer.graph.model.triple.TripleTerm .

    ns7:decode_dirlang_datatype dcterms:identifier "starlayer.graph.model.encoding.decode_dirlang_datatype" ;
        a ns2:Function ;
        rdfs:comment """Return (language, direction) if datatype is a starlayer.graph dirlang
    encoding.

    Returns None for any other datatype, including plain rdf:langString,
    which never reaches here since it's represented via Literal's native
    lang= rather than a synthetic datatype URI.""" ;
        rdfs:label "decode_dirlang_datatype" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:decode_dirlang_datatype.param.datatype ;
        ns2:hasReturnValue ns7:decode_dirlang_datatype.returns ;
        ns2:lineEnd 199 ;
        ns2:lineStart 177 ;
        ns2:signature "def decode_dirlang_datatype(datatype: URIRef) -> tuple[str, str] | None" .

    ns7:decode_dirlang_datatype.param.datatype a ns2:Parameter ;
        rdfs:comment "The literal's datatype URIRef to test." ;
        rdfs:label "datatype" ;
        ns2:annotationText "URIRef" ;
        ns2:hasType ns4:rdflib.term.URIRef ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:decode_dirlang_datatype.returns a ns2:ReturnValue ;
        rdfs:comment "A (language, direction) tuple decoded from the datatype's local name, or None if datatype is not a dirlang encoding." ;
        ns2:annotationText "tuple[str, str] | None" ;
        ns2:hasType ns4:builtins.tuple, ns4:builtins.str ;
        ns2:optional true .

    ns7:encode_dirlang_datatype dcterms:identifier "starlayer.graph.model.encoding.encode_dirlang_datatype" ;
        a ns2:Function ;
        rdfs:comment """Return the internal datatype URIRef encoding a DirLangString's
    (language, direction) pair.

    rdflib.Literal(text, lang="en--rtl") raises ValueError - rdflib's langtag
    validator has no notion of the RDF 1.2 "--dir" suffix and rejects it
    outright. Validation only fires for the lang= keyword, not datatype=, so
    packing (language, direction) into a synthetic datatype URI sidesteps the
    check entirely while staying self-describing: the URI's local name is
    exactly the real "lang--dir" lexical suffix (RDF 1.2 Concepts sec 3.4),
    so decoding is a plain string split, no lookup table.""" ;
        rdfs:label "encode_dirlang_datatype" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:encode_dirlang_datatype.param.language, ns7:encode_dirlang_datatype.param.direction ;
        ns2:hasReturnValue ns7:encode_dirlang_datatype.returns ;
        ns2:lineEnd 174 ;
        ns2:lineStart 155 ;
        ns2:signature "def encode_dirlang_datatype(language: str, direction: str) -> URIRef" .

    ns7:encode_dirlang_datatype.param.direction a ns2:Parameter ;
        rdfs:comment "The literal's real base direction (\"ltr\" or \"rtl\")." ;
        rdfs:label "direction" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns7:encode_dirlang_datatype.param.language a ns2:Parameter ;
        rdfs:comment "The literal's real language tag (e.g. \"en\")." ;
        rdfs:label "language" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns7:encode_dirlang_datatype.returns a ns2:ReturnValue ;
        rdfs:comment "A URIRef under DIRLANG_NS whose local name is \"<language>--<direction>\"." ;
        ns2:annotationText "URIRef" ;
        ns2:hasType ns4:rdflib.term.URIRef .

    ns7:inject_missing_tt_encoding dcterms:identifier "starlayer.graph.model.encoding.inject_missing_tt_encoding" ;
        a ns2:Function ;
        rdfs:comment """Scan a freshly-built CONSTRUCT result graph for any tt:HASH URIRef
    that appears with no rdf:subject/predicate/object encoding triples of
    its own already in `graph`, and - wherever `restore_fn` (the querying
    graph/dataset's own ``_restore``/``_restore_any``) can still resolve it
    - inject those triples so the value survives being wrapped in
    ``StarLayerGraph.from_rdflib()`` afterwards.

    Why this is needed: a CONSTRUCT template can embed a tt:HASH URIRef that
    was never freshly computed by this query at all - just read straight off
    an existing WHERE-clause binding, e.g. ``BIND(<<(?s ?p ?o)>> AS ?t)``
    where ``?o`` itself already held a *nested* triple-term value from the
    graph being queried. Such a value is only "known" via the *querying*
    graph's own ``_tt_nodes`` registry (built when that data was originally
    parsed) - the plain rdflib Graph rdflib's SPARQL engine hands back for a
    CONSTRUCT result has no rdf:subject/predicate/object triples for it at
    all (those were never re-derived, since nothing re-interned it), so
    ``StarLayerGraph.from_rdflib()``'s registry-building pass
    (``_build_registry_from_store()``) has nothing to find, and the raw
    tt:HASH URIRef would otherwise leak straight through to callers instead
    of the TripleTerm it's supposed to mean. Called on `graph` *before*
    ``StarLayerGraph.from_rdflib(graph)``, from both ``StarLayerGraph.query()``
    and ``StarLayerDataset.query()``.""" ;
        rdfs:label "inject_missing_tt_encoding" ;
