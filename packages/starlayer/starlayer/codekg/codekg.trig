GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/unit/test_trig12_parser.py> {
    ns111:test_trig12_parser.py dcterms:identifier "tests.graph.unit.test_trig12_parser" ;
        a ns2:Module ;
        rdfs:comment """Unit tests for starlayer.graph.parsers.trig12's own string-literal-aware
    block/prefix splitting.

    Covers a real bug found while running this project's own code-KG
    extractor over this project's own graph/parsers/trig12.py: this module's
    GRAPH-block detection and @prefix-declaration extraction used to run
    blind text-wide regexes/single-char quote tracking with no awareness of
    whether a given piece of text was really top-level syntax or just the
    content of an open (triple- or single-quoted) string literal - e.g. a
    docstring that quotes "@prefix : <http://example.org/> ." or shows a
    literal "GRAPH <...> { ... }" example, exactly like this module's own
    docstrings do.""" ;
        rdfs:label "test_trig12_parser" ;
        ns2:declares ns151:TestMaskStringLiterals, ns151:TestConsumeBalancedWithEmbeddedQuote, ns151:TestSplitTrigBlocksWithEmbeddedDirectiveLookalikes, ns151:TestExtractPrefixLinesIgnoresStringContent ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_trig12_parser.py" ;
        ns2:importsModule ns4:rdflib .

