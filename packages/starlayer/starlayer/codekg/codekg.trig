    ns73:_annotation_reifier_term_resolved dcterms:identifier "starlayer.sparql._grammar12._annotation_reifier_term_resolved" ;
        a ns2:Function ;
        rdfs:comment """Build the reification triple ``(r, rdf:reifies, tt)`` for one
    resolved (s, p, o, r) reifier-shorthand term.

    ``r`` must appear only once, as the first element of the single
    embedded triple below, not as a separately prepended copy — rdflib's
    own ``expandTriples()`` (its ``isinstance(t, list)`` branch) uses
    ``t[0]`` both as the value slotted into an enclosing triple's object
    position (via a plain ``res.append(t[0])``) and, separately, folds the
    whole of ``t`` (``t[0]`` included) back in as one or more new
    self-contained triples of its own — duplicating ``r`` as a standalone
    ``t[0]`` ahead of its real first triple breaks that contract.""" ;
        rdfs:label "_annotation_reifier_term_resolved" ;
        ns2:calls ns73:_make_triple_term ;
        ns2:filePath "packages/starlayer/starlayer/sparql/_grammar12.py" ;
        ns2:hasParameter ns73:_annotation_reifier_term_resolved.param.r, ns73:_annotation_reifier_term_resolved.param.s, ns73:_annotation_reifier_term_resolved.param.p, ns73:_annotation_reifier_term_resolved.param.o ;
        ns2:hasReturnValue ns73:_annotation_reifier_term_resolved.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 739 ;
        ns2:lineStart 715 ;
        ns2:signature "def _annotation_reifier_term_resolved(s, p, o, r) -> list" .

    ns73:_annotation_reifier_term_resolved.param.o a ns2:Parameter ;
