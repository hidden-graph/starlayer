    ns226:TestFusekiDatasetUpdate dcterms:identifier "tests.graph.integration.test_fuseki_backend.TestFusekiDatasetUpdate" ;
        a ns2:Class ;
        rdfs:comment """StarLayerDataset.update() against a remote store 400'd on any update
    text containing its own GRAPH <uri> {} clause, for *both* backends -
    rdflib's Dataset(store=...).update() always wraps the whole update in an
    extra GRAPH <urn:x-rdflib:default> {} block regardless, nesting illegally
    around one already present. Confirmed here (not just against Oxigraph)
    with a plain INSERT DATA containing no triple terms at all, on both
    rdf-1.1 and rdf-1.2. See TestOxigraphDatasetUpdate for the fuller
    rationale.""" ;
        rdfs:label "TestFusekiDatasetUpdate" ;
        ns2:declares ns226:TestFusekiDatasetUpdate.test_insert_data_with_graph_clause, ns226:TestFusekiDatasetUpdate._dataset, ns226:TestFusekiDatasetUpdate.test_insert_where_with_graph_clause ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_fuseki_backend.py" ;
        ns2:hasDecorator ns226:TestFusekiDatasetUpdate.decorator.0 ;
        ns2:lineEnd 490 ;
        ns2:lineStart 459 .

