    ns95:test_build.py dcterms:identifier "tests.codekg.unit.test_build" ;
        a ns2:Module ;
        rdfs:comment """End-to-end test for starlayer.codekg.extractor.build.refresh() - the
    wholesale-replace orchestration.

    Writes tiny synthetic module files to a tmp dir structured to mimic
    packages/starlayer/starlayer/<something>/, points refresh() at a tmp
    trig_path override (never the real, checked-in codekg.trig), and
    confirms: the result parses back with the expected triples, and running
    refresh() a second time with a MODIFIED fixture file produces updated
    triples rather than stale ones - the real behavior this design hinges on.""" ;
        rdfs:label "test_build" ;
        ns2:declares ns228:test_refresh_handles_docstring_resembling_a_prefix_directive, ns228:_make_repo_root, ns228:test_refresh_preserves_ontology_and_curated_graphs, ns228:test_refresh_removes_graph_for_module_no_longer_in_target_paths, ns228:test_refresh_second_run_replaces_stale_triples_not_stacks_them, ns228:test_refresh_produces_expected_triples ;
        ns2:filePath "packages/starlayer/tests/codekg/unit/test_build.py" ;
        ns2:importsModule ns4:pathlib, ns4:__future__, ns4:rdflib, ns4:rdflib.namespace .

    ns228:_make_repo_root dcterms:identifier "tests.codekg.unit.test_build._make_repo_root" ;
