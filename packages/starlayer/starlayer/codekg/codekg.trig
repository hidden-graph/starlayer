    ns158:test_allow_infos_on_validate_relaxes_info_severity_meta_shacl_check dcterms:identifier "tests.shacl.integration.test_meta_shapes_extensions.test_allow_infos_on_validate_relaxes_info_severity_meta_shacl_check" ;
        a ns2:Function ;
        rdfs:comment """meta_validate() itself already forwards allow_warnings/allow_infos
    to pySHACL correctly (it calls pyshacl.validate() directly, so pySHACL's
    own handling of these two kwargs applies unmodified) - the gap was
    validator.py's own call site never forwarding the caller's
    validate(..., allow_infos=...) through to meta_validate() at all. Uses
    the sh:DataGraph/owl:imports check (Info severity) as the probe.
    ignore_imports=True on both calls for the same reason as the two
    tests above - the owl:imports here is incidental probe data, not a
    genuine shapes-graph dependency.""" ;
        rdfs:label "test_allow_infos_on_validate_relaxes_info_severity_meta_shacl_check" ;
        ns2:calls ns158:_validate ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_meta_shapes_extensions.py" ;
