GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/expr_validation.py> {
    ns48:expr_validation.py dcterms:identifier "starlayer.sparql.expr_validation" ;
        a ns2:Module ;
        rdfs:comment """The validation data for the shared expression vocabulary (``spexpr:``): its SHACL shapes graph and RDFS
    ontology, ready to combine with a vocabulary's own.

    ``sqe:``, ``srl:`` and ``salg:`` all embed ``spexpr:`` expressions (a ``FILTER``, a ``BIND``, an ``ORDER BY``
    key), and validating one needs the same two things: the shapes for every expression builtin and the RDFS
    subclass axioms the ``sh:class spexpr:Expression`` dispatch relies on. They live here, in one place that imports
    nothing from any of those vocabularies, so a vocabulary can validate its own trees without importing a sibling's
    package. (``salg`` imports this module; ``sqe`` must not import ``salg``.)

    The per-builtin shapes are generated from ``expr_families._EXPR_NODE_FAMILY`` rather than written by hand, so
    they cannot drift from the table the encoder uses. This module needs rdflib and ``starontology`` only, not
    pyshacl.""" ;
        rdfs:label "expr_validation" ;
        ns2:declares ns349:ontology_graph, ns349:expression_shapes_turtle, ns349:shapes_graph ;
        ns2:filePath "packages/starlayer/starlayer/sparql/expr_validation.py" ;
        ns2:importsModule ns4:rdflib, ns4:__future__ .

    ns349:expression_shapes_turtle dcterms:identifier "starlayer.sparql.expr_validation.expression_shapes_turtle" ;
        a ns2:Function ;
        rdfs:comment """The short per-expression-node-name declarations (one per real builtin), each pointing at its family's
    reusable body shape (``spexpr:_<Family>ExprBodyShape``) with ``sh:node``.

    Targets ``spexpr:``: both the target class and the body shape live in the shared expression vocabulary, and
    a node typed ``spexpr:Name`` would never match a ``sh:targetClass salg:Name`` shape. Carries its own
    ``@prefix spexpr:`` line, so it is self-contained whatever it gets concatenated with.""" ;
        rdfs:label "expression_shapes_turtle" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/expr_validation.py" ;
        ns2:hasReturnValue ns349:expression_shapes_turtle.returns ;
        ns2:lineEnd 44 ;
        ns2:lineStart 24 ;
        ns2:signature "def expression_shapes_turtle() -> str" .

    ns349:expression_shapes_turtle.returns a ns2:ReturnValue ;
        rdfs:comment "The generated Turtle declarations, newline-terminated, with their own leading ``@prefix`` line." ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

    ns349:ontology_graph dcterms:identifier "starlayer.sparql.expr_validation.ontology_graph" ;
        a ns2:Function ;
        rdfs:comment """A fresh graph of the ``spexpr:`` RDFS ontology (the subclass axioms behind ``sh:class spexpr:Expression``
    and the variable and path classes).""" ;
        rdfs:label "ontology_graph" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/expr_validation.py" ;
        ns2:hasReturnValue ns349:ontology_graph.returns ;
        ns2:lineEnd 59 ;
        ns2:lineStart 56 ;
        ns2:signature "def ontology_graph() -> Graph" .

    ns349:ontology_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph .

    ns349:shapes_graph dcterms:identifier "starlayer.sparql.expr_validation.shapes_graph" ;
        a ns2:Function ;
        rdfs:comment """A fresh graph of the ``spexpr:`` shapes: the stored ``spexpr_shacl`` plus the generated per-builtin
    shapes. Callers get their own copy, because pyshacl mutates a shapes graph while validating.""" ;
        rdfs:label "shapes_graph" ;
        ns2:calls ns349:expression_shapes_turtle ;
        ns2:filePath "packages/starlayer/starlayer/sparql/expr_validation.py" ;
        ns2:hasReturnValue ns349:shapes_graph.returns ;
        ns2:lineEnd 53 ;
        ns2:lineStart 47 ;
        ns2:signature "def shapes_graph() -> Graph" .

    ns349:shapes_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph .

    ns4:__future__ a ns2:ExternalModule .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a ns2:ExternalType ;
        rdfs:label "str" ;
        rdfs:subClassOf ns2:Type .

    ns4:rdflib a ns2:ExternalModule .

    ns4:rdflib.graph.Graph dcterms:identifier "rdflib.graph.Graph" ;
        a ns2:ExternalType ;
        rdfs:label "Graph" ;
        rdfs:subClassOf ns2:Type .
}

