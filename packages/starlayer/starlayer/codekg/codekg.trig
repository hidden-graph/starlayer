    ns28:StarLayerGraph.qname_term dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.qname_term" ;
        a ns2:Method ;
        rdfs:comment """Prefixed n3 form of any term - URIRef, BNode, Literal, TripleTerm,
    or DirLangString.

    Unlike the inherited qname(), which only accepts a URI and raises on
    anything else, this dispatches on whatever it's given: a caller
    iterating over triples() often doesn't know in advance whether a
    given position holds a plain node or a TripleTerm, and qname_term()
    does the right thing either way without an isinstance check.""" ;
        rdfs:label "qname_term" ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        ns2:hasParameter ns28:StarLayerGraph.qname_term.param.node ;
        ns2:hasReturnValue ns28:StarLayerGraph.qname_term.returns ;
        ns2:lineEnd 1840 ;
        ns2:lineStart 1824 ;
        ns2:signature "def qname_term(self, node) -> str" .

    ns28:StarLayerGraph.qname_term.param.node a ns2:Parameter ;
        rdfs:comment "The term to render." ;
        rdfs:label "node" ;
