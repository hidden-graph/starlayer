    ns75:_materialize_default_value_triples dcterms:identifier "starlayer.shacl.validator._materialize_default_value_triples" ;
        a ns2:Function ;
        rdfs:comment """For each predicate, and for every non-deactivated property shape in
    ``shapes_graph`` whose ``sh:path`` is that predicate, add derived
    ``(focus, predicate, value)`` triples to ``data_graph`` for every
    target/focus node of that property shape that has no existing value for
    the predicate - preferring an ``sh:values``-computed value when the
    property shape declares one and it produces at least one result,
    falling back to a plain ``sh:defaultValue`` otherwise (matching the
    ``expectedPredicate-example`` fixture's own worked case: a rectangle
    with real width/height gets its area computed via ``sh:values``, one
    with neither falls back to ``sh:defaultValue``'s constant). Never
    overwrites or duplicates an already-asserted value, per
    ``sh:defaultValue``'s own spec-defined semantics ("used when no other
    values are present for a property").

    A property shape's own "target/focus nodes" are, per ordinary SHACL
    Core semantics, the target nodes of whatever node shape(s) reference it
    via ``sh:property`` (the common case - see the SHACL 1.2 SPARQL
    Extensions spec's own worked ``ex:RectangleShape``/
    ``ex:RectangleShape-area`` example) - plus, for completeness, the
    property shape's own targets if it happens to declare ``sh:target*``
    directly (a rarer, but spec-legitimate, top-level-property-shape case).""" ;
        rdfs:label "_materialize_default_value_triples" ;
        ns2:calls ns75:_shape_target_nodes, ns75:_compute_sh_default_value, ns75:_compute_sh_values ;
        ns2:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
        ns2:hasParameter ns75:_materialize_default_value_triples.param.shapes_graph_wrapper, ns75:_materialize_default_value_triples.param.data_graph, ns75:_materialize_default_value_triples.param.predicates, ns75:_materialize_default_value_triples.param.shapes_graph ;
        ns2:hasReturnValue ns75:_materialize_default_value_triples.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 4639 ;
        ns2:lineStart 4538 ;
        ns2:signature "def _materialize_default_value_triples(data_graph: Any, shapes_graph: Any, shapes_graph_wrapper: Any, predicates: set) -> list[tuple[Any, Any, Any]]" .

    ns75:_materialize_default_value_triples.param.data_graph a ns2:Parameter ;
        rdfs:comment "The data graph to materialize derived triples into." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns75:_materialize_default_value_triples.param.predicates a ns2:Parameter ;
