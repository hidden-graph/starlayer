    ns38:resolve_store_http dcterms:identifier "starlayer.graph.backends.native.resolve_store_http" ;
        a ns2:Function ;
        rdfs:comment """Return (query_url, update_url, extra_headers) from a native-backend store.

    SPARQLUpdateStore pre-encodes credentials as an Authorization header in
    store.kwargs['headers'] rather than exposing a raw auth tuple. Shared by
    StarLayerGraph and StarLayerDataset - a dataset's per-context
    StarLayerGraphs all share the same underlying store (see
    StarLayerDataset.get_context()), so there is exactly one store to
    resolve per dataset, same as for a single graph.""" ;
        rdfs:label "resolve_store_http" ;
        ns2:filePath "packages/starlayer/starlayer/graph/backends/native.py" ;
        ns2:hasParameter ns38:resolve_store_http.param.store, ns38:resolve_store_http.param.backend ;
