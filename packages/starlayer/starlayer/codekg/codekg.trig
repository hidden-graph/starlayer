GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/__init__.py> {
    ns291:__init__.py dcterms:identifier "starlayer.codekg.__init__" ;
        a ns2:Module ;
        rdfs:comment """starlayer.codekg - loader for the code knowledge graph extracted from
    this project's own Python source.

    Two files, two very different lifecycles:

    - ``ontology.ttl`` is the hand-maintained vocabulary (``slkg:``/
      ``externaltype:``) this subpackage defines - never touched by the
      extractor, edited by hand like any other vocabulary in
      ``starlayer.starontology``.
    - ``codekg.trig`` is the auto-generated dataset the extractor produces: one
      named graph per extracted module, wholesale-replaced on every extractor
      run (see ``starlayer.codekg.extractor``, built separately). It does not
      exist until the extractor has run at least once.

    A third named graph, identified by ``CURATED_GRAPH_IRI``, holds the hand-maintained
    curated layer: every ``curated/*.ttl`` file (the capabilities in ``functionality.ttl``,
    the named queries in ``query-library.ttl``). It is read from those files on request,
    ``get_codekg_dataset(include_curated=True)``, and is never written into ``codekg.trig``.

    Mirrors ``starlayer.starontology``'s own loader pattern: parse once,
    never hand back a shared mutable object, copy out a fresh graph/dataset
    per call instead.""" ;
        rdfs:label "__init__" ;
        ns2:declares ns292:_derive_demonstrated_by, ns292:get_ontology_graph, ns292:get_codekg_dataset, ns292:get_module_graph ;
        ns2:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        ns2:importsModule ns4:typing, ns4:__future__, ns4:rdflib, ns4:pathlib .

    ns292:_derive_demonstrated_by dcterms:identifier "starlayer.codekg.__init__._derive_demonstrated_by" ;
        a ns2:Function ;
        rdfs:comment """Add ``entity slkg:demonstratedBy example`` for each ``slkg:demonstratesIdentifier`` that names an extracted entity.

    The curated files name code by dotted identifier (stable across refactors); this resolves them to the entities'
    IRIs once the module graphs are loaded, the same way ``slkg:implementedByIdentifier`` is resolved at query time.""" ;
        rdfs:label "_derive_demonstrated_by" ;
        ns2:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        ns2:hasParameter ns292:_derive_demonstrated_by.param.dataset, ns292:_derive_demonstrated_by.param.curated ;
        ns2:hasReturnValue ns292:_derive_demonstrated_by.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 132 ;
        ns2:lineStart 114 ;
        ns2:signature "def _derive_demonstrated_by(dataset: StarLayerDataset, curated: StarLayerGraph) -> None" .

    ns292:_derive_demonstrated_by.param.curated a ns2:Parameter ;
        rdfs:label "curated" ;
        ns2:annotationText "StarLayerGraph" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns292:_derive_demonstrated_by.param.dataset a ns2:Parameter ;
        rdfs:label "dataset" ;
        ns2:annotationText "StarLayerDataset" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_dataset.StarLayerDataset ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns292:_derive_demonstrated_by.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns292:get_codekg_dataset dcterms:identifier "starlayer.codekg.__init__.get_codekg_dataset" ;
        a ns2:Function ;
        rdfs:comment """A fresh ``StarLayerDataset`` with ``codekg.trig`` parsed into it, or
    an empty dataset (no module graphs) if the extractor hasn't produced
    that file yet. With ``include_curated=True`` the ``curated/*.ttl`` files
    are also parsed into the ``CURATED_GRAPH_IRI`` graph (the default leaves
    it out, so the extractor's read-modify-write of the dataset can never
    write curated triples into ``codekg.trig``). Never cached/shared - the extractor mutates a dataset
    returned from a similar pattern, so a caller must never be handed back
    the same mutable object another caller could also be holding.""" ;
        rdfs:label "get_codekg_dataset" ;
        ns2:calls ns292:_derive_demonstrated_by ;
        ns2:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        ns2:hasParameter ns292:get_codekg_dataset.param.include_curated ;
        ns2:hasReturnValue ns292:get_codekg_dataset.returns ;
        ns2:instantiates ns31:StarLayerDataset ;
        ns2:lineEnd 111 ;
        ns2:lineStart 92 ;
        ns2:signature "def get_codekg_dataset(include_curated: bool=False) -> StarLayerDataset" .

    ns292:get_codekg_dataset.param.include_curated a ns2:Parameter ;
        rdfs:label "include_curated" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "False" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns292:get_codekg_dataset.returns a ns2:ReturnValue ;
        ns2:annotationText "StarLayerDataset" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_dataset.StarLayerDataset .

    ns292:get_module_graph dcterms:identifier "starlayer.codekg.__init__.get_module_graph" ;
        a ns2:Function ;
        rdfs:comment """The named graph for one extracted module, or ``None`` if it doesn't
    exist (or is empty) in the current ``codekg.trig``.

    ``module_path`` is a repo-relative path under
    ``packages/starlayer/starlayer/``, e.g. ``"graph/model/encoding.py"``.""" ;
        rdfs:label "get_module_graph" ;
        ns2:calls ns292:get_codekg_dataset ;
        ns2:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        ns2:hasParameter ns292:get_module_graph.param.module_path ;
        ns2:hasReturnValue ns292:get_module_graph.returns ;
        ns2:lineEnd 146 ;
        ns2:lineStart 135 ;
        ns2:signature "def get_module_graph(module_path: str) -> StarLayerGraph | None" .

    ns292:get_module_graph.param.module_path a ns2:Parameter ;
        rdfs:label "module_path" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns292:get_module_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "StarLayerGraph | None" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph ;
        ns2:optional true .

    ns292:get_ontology_graph dcterms:identifier "starlayer.codekg.__init__.get_ontology_graph" ;
        a ns2:Function ;
        rdfs:comment """A fresh ``StarLayerGraph`` of ``ontology.ttl`` alone (plain Turtle,
    not a dataset), identified by ``ONTOLOGY_GRAPH_IRI``.""" ;
        rdfs:label "get_ontology_graph" ;
        ns2:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        ns2:hasReturnValue ns292:get_ontology_graph.returns ;
        ns2:lineEnd 89 ;
        ns2:lineStart 75 ;
        ns2:signature "def get_ontology_graph() -> StarLayerGraph" .

    ns292:get_ontology_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "StarLayerGraph" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

    ns4:__future__ a ns2:ExternalModule .

    ns4:builtins.bool dcterms:identifier "builtins.bool" ;
        a ns2:ExternalType ;
        rdfs:label "bool" ;
        rdfs:subClassOf ns2:Type .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a ns2:ExternalType ;
        rdfs:label "str" ;
        rdfs:subClassOf ns2:Type .

