    ns269:_boolean_expr_conforms dcterms:identifier "tests.shacl.integration.test_shnex_node_expressions._boolean_expr_conforms" ;
        a ns2:Function ;
        rdfs:comment """Like _expression_conforms, but for expressions that already evaluate to
    a boolean (true)/(false) list themselves (e.g. shnex:matchAll, shnex:exists)
    - plugged directly into sh:expression with no extra shnex:exists wrapper,
    since wrapping an already-boolean result in shnex:exists would always see
    a non-empty ``(true)`` or ``(false)`` list and be vacuously true either way.

    ``fmt`` selects the shapes-graph parse format - "turtle12" for cases that
    need an RDF 1.2 dir-lang-string literal constant (``"x"@en--ltr``), which
    plain "turtle" doesn't parse.""" ;
        rdfs:label "_boolean_expr_conforms" ;
        ns2:filePath "packages/starlayer/tests/shacl/integration/test_shnex_node_expressions.py" ;
        ns2:hasParameter ns269:_boolean_expr_conforms.param.target, ns269:_boolean_expr_conforms.param.fmt, ns269:_boolean_expr_conforms.param.expression_ttl ;
        ns2:hasReturnValue ns269:_boolean_expr_conforms.returns ;
        ns2:instantiates ns28:StarLayerGraph ;
        ns2:isPrivate true ;
        ns2:lineEnd 97 ;
        ns2:lineStart 71 ;
        ns2:signature "def _boolean_expr_conforms(expression_ttl: str, target: str='ex:alice', fmt: str='turtle') -> bool" .

