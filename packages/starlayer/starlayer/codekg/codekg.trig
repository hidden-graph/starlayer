        rdfs:label "_collect_parse_errors" ;
        ns2:calls ns102:iter_manifest_entries ;
        ns2:filePath "packages/starlayer/tests/shacl/w3c_shacl12/test_w3c_parse_health.py" ;
        ns2:hasReturnValue ns223:_collect_parse_errors.returns ;
