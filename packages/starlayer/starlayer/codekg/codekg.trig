GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/w3c_shacl12/known_failures.py> {
    ns100:known_failures.py dcterms:identifier "tests.shacl.w3c_shacl12.known_failures" ;
        a ns2:Module ;
        rdfs:comment """Registry of W3C SHACL 1.2 suite entries with a known, reasoned disposition.

    Per CLAUDE.md's testing-coverage discipline, a failing conformance test is
    never silently skipped - every entry here names *why* (a specific
    docs/shacl12-gap-matrix.md "Not Covered / Deferred" row, a specific
    docs/upstream-issues/pyshacl-upstream-issues.md entry, or a concrete Working-Draft-churn
    explanation) and is applied as ``pytest.xfail(strict=True)``, so it breaks
    loudly (as an unexpected XPASS) the moment the underlying gap is closed
    instead of silently going stale.

    Review this file the same way the gap matrix's own tables are reviewed:
    every entry is a claim that should still be true, not a historical record.

    Keyed by ids.portable_id(entry, VENDOR_ROOT) - a path-relative id, *not*
    str(entry.iri) (which is an absolute file:// path that differs across
    machines/checkouts, unsuitable for a committed file). This is also the
    pytest parametrize id, so a failing test's node id can be pasted directly
    in as a key here.""" ;
        rdfs:label "known_failures" ;
        ns2:filePath "packages/starlayer/tests/shacl/w3c_shacl12/known_failures.py" ;
        ns2:importsModule ns4:__future__ .

    ns4:__future__ a ns2:ExternalModule .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/shacl/integration/test_native_backend_oxigraph_store.py> {
    ns97:test_native_backend_oxigraph_store.py dcterms:identifier "tests.shacl.integration.test_native_backend_oxigraph_store" ;
        a ns2:Module ;
        rdfs:comment """SHACL validate()/apply_rules() against graphs backed by oxrdflib's
    OxigraphStore in rdf-1.2 native mode (in-process, no server).

    Regression: with meta_shacl on, a blank node in the shapes graph (e.g. an
    inline sh:property [ ... ]) that appears in a violation report is looked up
    via the find_node_named_graph fallback in starlayer.shacl.validator. A graph
    built with no explicit identifier lives in the store's true default graph,
    which that fallback's "GRAPH ?g" discovery query can never enumerate - it
    used to raise LookupError.""" ;
        rdfs:label "test_native_backend_oxigraph_store" ;
        ns2:declares ns302:test_validate_and_apply_rules_with_default_graph_store, ns302:_graph ;
