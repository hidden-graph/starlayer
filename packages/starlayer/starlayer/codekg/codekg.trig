        rdfs:label "data_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "kwonly" ;
        ns2:position 0 .

    ns80:target_nodes.param.inference a ns2:Parameter ;
