    ns181:test_bind_extend_conforms dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_bind_extend_conforms" ;
        a ns2:Function ;
        rdfs:comment """The counter-example that found this whole gap: BIND's algebra node
    (Extend) was missing from GraphPatternShape's recognized-operator list
    entirely, and nothing caught it - the old sh:node-based sh:or dispatch
    silently gave up (pyshacl's shape-recursion guard) before ever
    reaching the check. A real regression test, not just a positive-
    conformance one.""" ;
        rdfs:label "test_bind_extend_conforms" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 428 ;
        ns2:lineStart 413 ;
        ns2:signature "def test_bind_extend_conforms()" .

    ns181:test_binding_val_missing_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_binding_val_missing_fails" ;
        a ns2:Function ;
        rdfs:comment """salg:Binding's own salg:val was "at most one" (0 or 1) - but
    to_rdf._encode_binding_row unconditionally adds this triple for every
    row/variable pair, including UNDEF (represented as the spexpr:PlainString
    literal "UNDEF", not by omitting the property) - so a genuinely
    missing salg:val, which the old shape allowed, can never actually be
    produced by this encoder and should be rejected as malformed.""" ;
        rdfs:label "test_binding_val_missing_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 1216 ;
        ns2:lineStart 1201 ;
        ns2:signature "def test_binding_val_missing_fails()" .

    ns181:test_binding_with_two_vars_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_binding_with_two_vars_fails" ;
        a ns2:Function ;
        rdfs:comment """salg:Binding must have exactly one salg:var - a row entry can't be
    ambiguous about which variable it binds.""" ;
        rdfs:label "test_binding_with_two_vars_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
        ns2:lineEnd 280 ;
        ns2:lineStart 271 ;
        ns2:signature "def test_binding_with_two_vars_fails()" .

    ns181:test_bogus_node_reused_as_p1_via_another_operator_still_fails dcterms:identifier "tests.sparql.unit.test_shacl_shapes.test_bogus_node_reused_as_p1_via_another_operator_still_fails" ;
        a ns2:Function ;
        rdfs:comment """A second-order version of the test above: rather than the bogus
    node being directly assigned to salg:p1, give it a salg:p1 property of
    its own first (which - if salg:p1 still had rdfs:domain
    salg:GraphPattern - would falsely entail the bogus node itself as
    salg:GraphPattern), then use *that* bogus node as another Union's own
    p1. Confirms removing salg:p1/p2's rdfs:domain (not just rdfs:range)
    was necessary - domain entailment on the subject side of p1 is just as
    exploitable as range entailment on the object side, one hop removed.""" ;
        rdfs:label "test_bogus_node_reused_as_p1_via_another_operator_still_fails" ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_shacl_shapes.py" ;
