    ns224:TestOxigraphDatasetUpdate dcterms:identifier "tests.graph.integration.test_oxigraph_backend.TestOxigraphDatasetUpdate" ;
        a ns2:Class ;
        rdfs:comment """StarLayerDataset.update() against a remote store 400'd on any update
    text containing its own ``GRAPH <uri> { }`` clause - the normal way to
    target a named graph from dataset-level SPARQL - because rdflib's own
    ``Dataset(store=...).update()`` always wraps the whole update in an
    extra ``GRAPH <urn:x-rdflib:default> { }`` block (SPARQLStore's
    ``_is_contextual()`` doesn't recognize ``Dataset``'s default-graph
    sentinel as exempt), producing an illegal nested GRAPH block. Confirmed
    against real Oxigraph with a plain (no triple terms) INSERT DATA.  Fixed
    by bypassing rdflib's dispatch and sending the update over HTTP directly
    for any store with query/update endpoints - same as
    StarLayerGraph.update()'s existing native-backend path.""" ;
        rdfs:label "TestOxigraphDatasetUpdate" ;
        ns2:declares ns224:TestOxigraphDatasetUpdate.test_insert_data_with_graph_clause, ns224:TestOxigraphDatasetUpdate.test_delete_where_with_graph_clause, ns224:TestOxigraphDatasetUpdate.test_delete_data_with_graph_clause, ns224:TestOxigraphDatasetUpdate._dataset, ns224:TestOxigraphDatasetUpdate.test_insert_where_with_graph_clause ;
        ns2:filePath "packages/starlayer/tests/graph/integration/test_oxigraph_backend.py" ;
        ns2:hasDecorator ns224:TestOxigraphDatasetUpdate.decorator.0 ;
        ns2:lineEnd 752 ;
