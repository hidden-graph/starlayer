    ns191:test_each_resource_states_what_it_does_not_claim dcterms:identifier "tests.test_conformance.test_each_resource_states_what_it_does_not_claim" ;
        a ns2:Function ;
        rdfs:comment """Every resource carries a second rdfs:comment (not just the
    descriptive first one) stating what's deliberately excluded - real
    RDF data on the resource itself, not just source-file header prose a
    caller querying the graph would never see.""" ;
        rdfs:label "test_each_resource_states_what_it_does_not_claim" ;
        ns2:calls ns290:declared_conformance ;
        ns2:filePath "packages/starlayer/tests/test_conformance.py" ;
        ns2:hasReturnValue ns191:test_each_resource_states_what_it_does_not_claim.returns ;
