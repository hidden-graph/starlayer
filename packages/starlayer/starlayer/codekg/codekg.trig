    ns111:test_query_prepare_cache.py dcterms:identifier "tests.graph.unit.test_query_prepare_cache" ;
        a ns2:Module ;
        rdfs:comment """Regression tests for the prepared-query cache (starlayer.graph.query.query_cache).

    StarLayerGraph.query()/StarLayerDataset.query() used to rewrite (SPARQL 1.2 ->
    1.1) and parse the query text fresh on every call, even when the same query
    text is evaluated repeatedly with only initBindings differing - exactly how
    pySHACL evaluates a SHACL-AF sh:construct rule or sh:sparql constraint (once
    per focus node, per iteration). These tests confirm the cache actually
    eliminates the redundant work, stays correct across differing
    initNs/initBindings/data mutations, and doesn't change any query's result.""" ;
        rdfs:label "test_query_prepare_cache" ;
        ns2:declares ns237:test_different_query_text_parses_again, ns237:test_starlayer_graph_over_sparql_update_store_falls_back_to_string, ns237:test_construct_rule_repeated_per_focus_node_matches_pyshacl_pattern, ns237:test_different_effective_namespaces_do_not_collide, ns237:test_cache_does_not_serve_stale_data_after_mutation, ns237:test_dataset_repeated_query_parses_once, ns237:test_dataset_query_correct_across_repeated_calls_with_bindings, ns237:test_store_accepts_prepared_query_false_for_sparql_update_store, ns237:counting_prepare_query, ns237:test_repeated_identical_query_parses_once, ns237:test_repeated_query_with_different_bindings_gives_correct_results, ns237:test_store_accepts_prepared_query_true_for_default_memory_store, ns237:test_triple_term_query_still_correct_with_cache ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_query_prepare_cache.py" ;
