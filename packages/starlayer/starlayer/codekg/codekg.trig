GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/parse12.py> {
    ns48:parse12.py dcterms:identifier "starlayer.sparql.parse12" ;
        a ns2:Module ;
        rdfs:comment """Public entry points for ingesting SPARQL 1.2 (triple-term) query/update
    text into a genuine, post-``translateQuery``/``translateUpdate`` algebra
    tree — see ``grammar12.py`` for how ``<<( s p o )>>``/``TRIPLE(s, p, o)``
    syntax is made parseable at all, and ``triple_term.py`` for why the
    resulting node has to be a ``TripleTermNode``, not a bare ``CompValue``.

    Because the grammar extension (``grammar12.install()``) constructs a
    ``TripleTermNode`` directly inside its parse action, the parse tree these
    functions produce never contains a plain ``CompValue('TripleTerm', ...)`` to
    promote after the fact — ``translateQuery``/``translateUpdate`` can be
    called on it immediately, completely unmodified.""" ;
        rdfs:label "parse12" ;
        ns2:declares ns72:_canonicalize_construct_where, ns72:prepare_query_12, ns72:parse_update_12, ns72:_check_no_blank_nodes, ns72:_reject_blank_nodes_in_delete, ns72:prepare_update_12, ns72:_parse_with_recovery, ns72:parse_query_12 ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:importsModule ns4:rdflib.plugins.sparql.sparql, ns4:typing, ns4:__future__, ns4:rdflib, ns4:rdflib.plugins.sparql.algebra, ns4:rdflib.plugins.sparql.parser, ns4:rdflib.plugins.sparql.parserutils, ns4:pyparsing.exceptions, ns4:collections.abc .

    ns72:_canonicalize_construct_where dcterms:identifier "starlayer.sparql.parse12._canonicalize_construct_where" ;
        a ns2:Function ;
        rdfs:comment """``CONSTRUCT WHERE { pattern }`` shorthand (the template IS the WHERE
    pattern) reaches here with ``algebra.template`` set to ``None`` — plain,
    unmodified ``rdflib.plugins.sparql.algebra.translateQuery`` behavior,
    not something this project's own grammar/algebra work introduced.
    ``pattern`` itself is required by the SPARQL grammar (``ConstructWhere``
    — a plain ``TriplesTemplate``, no FILTER/OPTIONAL/UNION/etc permitted)
    to be exactly a flat BGP, so ``algebra.p.p.triples`` is always exactly
    the triple list needed.

    Populating ``template`` explicitly here — the *canonical*, always-
    explicit-template form of a CONSTRUCT query — rather than leaving the
    ``None``/"use the WHERE clause" convention for downstream code to
    rediscover is a deliberate simplification, not merely a serialization
    workaround: this project's own RDF encoding of the algebra
    (``to_rdf.py``) has no special "template is really the WHERE clause"
    convention of its own, so leaving ``template=None`` here would mean that
    information is silently lost the moment the algebra is encoded to RDF —
    the query would regenerate as ``CONSTRUCT {}`` (a literal, always-
    empty-result template), a real semantic mistranslation, not just lost
    shorthand syntax. Regenerating the *shorthand* ``CONSTRUCT WHERE``
    spelling specifically (as opposed to an equivalent explicit
    ``CONSTRUCT { ... } WHERE { ... }``) is explicitly out of scope for
    now, per instruction - only the meaning needs to survive, not the
    original surface syntax.""" ;
        rdfs:label "_canonicalize_construct_where" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:hasParameter ns72:_canonicalize_construct_where.param.query ;
        ns2:hasReturnValue ns72:_canonicalize_construct_where.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 115 ;
        ns2:lineStart 74 ;
        ns2:signature "def _canonicalize_construct_where(query: Query) -> Query" .

    ns72:_canonicalize_construct_where.param.query a ns2:Parameter ;
        rdfs:label "query" ;
        ns2:annotationText "Query" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Query ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns72:_canonicalize_construct_where.returns a ns2:ReturnValue ;
        ns2:annotationText "Query" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Query .

