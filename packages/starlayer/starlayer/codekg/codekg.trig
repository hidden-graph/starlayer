GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py> {
    ns120:test_phase6_rdf12_native.py dcterms:identifier "tests.sparql.unit.test_phase6_rdf12_native" ;
        a ns2:Module ;
        rdfs:comment """Phase 6: native SPARQL 1.2 (triple-term) algebra representation.

    Unlike every earlier phase, this one is verified *structurally*, not by
    executing the original and round-tripped query/update and comparing result
    rows — deliberately, per the Phase 6 plan (see CLAUDE.md / the plan file):
    making a TripleTermNode-bearing algebra tree directly executable is real,
    separate, future work (either a text round-trip through starlayer.graph, or an
    eventual 1.2-algebra -> 1.1-algebra translator this project would write
    itself). Today's deliverable is the representation, not execution — so
    "structural round-trip" (does the decoded tree match the original tree,
    including bookkeeping like _vars) is this phase's correctness bar, the same
    approach already used for SERVICE (test_phase2_forms.py's
    test_service_structural_roundtrip), which can't be executed in tests either,
    for an unrelated reason (it needs a live network call).

    Ingestion here goes through starlayer.sparql.parse12 (prepare_query_12/
    prepare_update_12), NOT rdflib's/starlayer.graph's plain prepareQuery — see
    grammar12.py for why: this project extends rdflib's own real SPARQL grammar
    in place with new <<( s p o )>>/TRIPLE(s, p, o) productions, rather than
    depending on starlayer.graph's SPARQL-1.2-to-1.1 text-rewrite pipeline.""" ;
        rdfs:label "test_phase6_rdf12_native" ;
        ns2:declares ns121:test_triple_term_node_is_the_decoded_type, ns121:test_variable_nested_inside_triple_term_found_in_vars, ns121:_strip_bookkeeping, ns121:test_updates_parse_and_translate, ns121:test_update_structural_roundtrip, ns121:test_queries_parse_and_translate, ns121:test_query_structural_roundtrip ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py" ;
        ns2:importsModule ns4:rdflib, ns4:rdflib.plugins.sparql.parserutils, ns4:__future__ .

    ns121:_strip_bookkeeping dcterms:identifier "tests.sparql.unit.test_phase6_rdf12_native._strip_bookkeeping" ;
        a ns2:Function ;
        rdfs:comment """Deep-copy an algebra tree with the _vars/lazy bookkeeping keys
    removed and None-valued keys dropped, so two independently-built trees
    can be compared by real structure/content — same helper as
    test_phase2_forms.py's SERVICE structural round-trip test. TripleTermNode
    is a CompValue subclass, so it's handled by the same branch, no special
    casing needed.""" ;
        rdfs:label "_strip_bookkeeping" ;
        ns2:calls ns121:_strip_bookkeeping ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py" ;
        ns2:hasParameter ns121:_strip_bookkeeping.param.node ;
        ns2:isPrivate true ;
        ns2:lineEnd 105 ;
        ns2:lineStart 87 ;
        ns2:signature "def _strip_bookkeeping(node)" .

    ns121:_strip_bookkeeping.param.node a ns2:Parameter ;
        rdfs:label "node" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns121:test_queries_parse_and_translate dcterms:identifier "tests.sparql.unit.test_phase6_rdf12_native.test_queries_parse_and_translate" ;
        a ns2:Function ;
        rdfs:label "test_queries_parse_and_translate" ;
        ns2:calls ns72:prepare_query_12 ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py" ;
        ns2:lineEnd 111 ;
        ns2:lineStart 108 ;
        ns2:signature "def test_queries_parse_and_translate()" .

    ns121:test_query_structural_roundtrip dcterms:identifier "tests.sparql.unit.test_phase6_rdf12_native.test_query_structural_roundtrip" ;
        a ns2:Function ;
        rdfs:label "test_query_structural_roundtrip" ;
        ns2:calls ns121:_strip_bookkeeping, ns72:prepare_query_12 ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py" ;
        ns2:lineEnd 129 ;
        ns2:lineStart 120 ;
        ns2:signature "def test_query_structural_roundtrip()" .

    ns121:test_triple_term_node_is_the_decoded_type dcterms:identifier "tests.sparql.unit.test_phase6_rdf12_native.test_triple_term_node_is_the_decoded_type" ;
        a ns2:Function ;
        rdfs:comment """Confirms from_rdf's TripleTerm special case actually returns
    TripleTermNode, not a bare CompValue - a bare CompValue in this position
    would be unhashable and crash algebra.reorderTriples/_knownTerms the
    moment rdf_to_query recomputes _addVars/analyse bookkeeping.""" ;
        rdfs:label "test_triple_term_node_is_the_decoded_type" ;
        ns2:calls ns72:prepare_query_12 ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py" ;
        ns2:lineEnd 177 ;
        ns2:lineStart 163 ;
        ns2:signature "def test_triple_term_node_is_the_decoded_type()" .

    ns121:test_update_structural_roundtrip dcterms:identifier "tests.sparql.unit.test_phase6_rdf12_native.test_update_structural_roundtrip" ;
        a ns2:Function ;
        rdfs:label "test_update_structural_roundtrip" ;
        ns2:calls ns121:_strip_bookkeeping, ns72:prepare_update_12 ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py" ;
        ns2:lineEnd 140 ;
        ns2:lineStart 132 ;
        ns2:signature "def test_update_structural_roundtrip()" .

    ns121:test_updates_parse_and_translate dcterms:identifier "tests.sparql.unit.test_phase6_rdf12_native.test_updates_parse_and_translate" ;
        a ns2:Function ;
        rdfs:label "test_updates_parse_and_translate" ;
        ns2:calls ns72:prepare_update_12 ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py" ;
        ns2:lineEnd 117 ;
        ns2:lineStart 114 ;
        ns2:signature "def test_updates_parse_and_translate()" .

    ns121:test_variable_nested_inside_triple_term_found_in_vars dcterms:identifier "tests.sparql.unit.test_phase6_rdf12_native.test_variable_nested_inside_triple_term_found_in_vars" ;
        a ns2:Function ;
        rdfs:comment """Direct guard for the exact defect an early spike caught: a plain,
    non-CompValue substitute for TripleTerm made rdflib's own _addVars
    bookkeeping silently under-count, since its generic recursive traversal
    (_traverseAgg) only recurses into CompValue/list/tuple/ParseResults.
    TripleTermNode being a real CompValue subclass is what avoids that -
    assert it directly here rather than only relying on the broader
    round-trip tests above to catch a regression.""" ;
        rdfs:label "test_variable_nested_inside_triple_term_found_in_vars" ;
        ns2:calls ns72:prepare_query_12 ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_phase6_rdf12_native.py" ;
        ns2:lineEnd 160 ;
        ns2:lineStart 143 ;
        ns2:signature "def test_variable_nested_inside_triple_term_found_in_vars()" .

    ns4:__future__ a ns2:ExternalModule .

    ns4:rdflib a ns2:ExternalModule .

    ns4:rdflib.plugins.sparql.parserutils a ns2:ExternalModule .
}

