    ns76:register_native_components dcterms:identifier "starlayer.shacl.native_components.register_native_components" ;
        a ns2:Function ;
        rdfs:comment """Register starShacl's SHACL 1.2 native constraint components into
    pySHACL's own dispatch map.

    Idempotent - safe to call many times, only registers once per process.
    Mutates ``CONSTRAINT_PARAMETERS_MAP``/``ALL_CONSTRAINT_COMPONENTS``/
    ``ALL_CONSTRAINT_PARAMETERS`` *in place* rather than rebinding them:
    ``pyshacl/shape.py``'s ``Shape.validate()`` lazily caches a reference to
    these same list/dict objects the first time it runs in a process
    (``module.CONSTRAINT_PARAMS``); in-place mutation stays visible through
    that cache, reassignment would not.""" ;
        rdfs:label "register_native_components" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:hasReturnValue ns76:register_native_components.returns ;
        ns2:lineEnd 128 ;
