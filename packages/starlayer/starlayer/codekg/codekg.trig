        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns54:_encode_binding_row.param.row a ns2:Parameter ;
        rdfs:comment "One VALUES-clause binding row (variable -> bound value, or the \"UNDEF\" sentinel string)." ;
        rdfs:label "row" ;
        ns2:annotationText "dict" ;
        ns2:hasType ns4:builtins.dict ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns54:_encode_binding_row.returns a ns2:ReturnValue ;
        rdfs:comment "The ``rdf:List`` node (or ``rdf:nil`` if ``row`` is empty) encoding this row." ;
        ns2:annotationText "BNode | URIRef" ;
        ns2:hasType ns4:rdflib.term.URIRef, ns4:rdflib.term.BNode .

    ns54:_encode_comp_value dcterms:identifier "starlayer.sparql.to_rdf._encode_comp_value" ;
        a ns2:Function ;
