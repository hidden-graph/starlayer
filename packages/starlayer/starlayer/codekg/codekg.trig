        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns14:StarLayerTurtleParser.parse.param.debug a ns2:Parameter ;
        rdfs:comment "If True, print the intermediate canonical/expanded representations to stdout." ;
        rdfs:label "debug" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "False" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns14:StarLayerTurtleParser.parse.returns a ns2:ReturnValue ;
        rdfs:comment "An rdflib.Graph using the starlayer.graph internal blank-node encoding for RDF 1.2 triple terms and reification. The graph also carries a `_declared_version` attribute (the document's declared VERSION label, or None) for StarLayerGraph.parse()'s RDF12ConformanceWarning check." ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph .

    ns14:_Expander dcterms:identifier "starlayer.graph.parsers.turtle_parser._Expander" ;
        a ns2:Class ;
        rdfs:comment "Holds mutable state for quoted-triple expansion within a single parse() call." ;
        rdfs:label "_Expander" ;
        ns2:declares ns14:_Expander.__init__, ns14:_Expander.expand_qt_in_triple, ns14:_Expander._resolve_qt_slot, ns14:_Expander.qt_to_json, ns14:_Expander._alloc, ns14:_Expander.qt_reif_to_json, ns14:_Expander.expand_annotation, ns14:_Expander._require_plain_blank_node ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/turtle_parser.py" ;
        ns2:isPrivate true ;
        ns2:lineEnd 699 ;
        ns2:lineStart 405 .

