    ns50:_effectively_bound_vars dcterms:identifier "starlayer.sparql.salg.semantic_checks._effectively_bound_vars" ;
        a ns2:Function ;
        rdfs:comment """The real, ground-truth set of variables `node` can bind - rdflib's
    own `_addVars` result, supplemented with the one confirmed gap it has
