    ns7:canonicalize_query_result_value dcterms:identifier "starlayer.graph.model.encoding.canonicalize_query_result_value" ;
        a ns2:Function ;
        rdfs:comment """Canonicalize a numeric-XSD-typed Literal's lexical form for a SPARQL
    query *result* value specifically, recursing into a TripleTerm's own
    subject/object components.

    Deliberately applied only here, at the SELECT-result boundary (see
    restore_select_bindings below) - not anywhere data is read verbatim
    (plain .triples()/_restore() on their own): Turtle/N-Triples parsing
    deliberately preserves a literal's exact lexical form as written, since
    RDF 1.2's own term-equality rules require it. A query *result*, though,
    is expected to match what a conformant engine's own query results look
    like (e.g. "123e0" canonicalizes to "123.0").""" ;
        rdfs:label "canonicalize_query_result_value" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns7:canonicalize_query_result_value.param.node ;
        ns2:hasReturnValue ns7:canonicalize_query_result_value.returns ;
        ns2:lineEnd 289 ;
        ns2:lineStart 252 ;
        ns2:signature "def canonicalize_query_result_value(node: Node | TripleTerm) -> Node | TripleTerm" .

    ns7:canonicalize_query_result_value.param.node a ns2:Parameter ;
