        ns2:isPrivate true ;
        ns2:lineEnd 78 ;
        ns2:lineStart 66 ;
        ns2:signature "def _new_graph(entry) -> StarLayerGraph | StarLayerDataset" .

    ns199:_new_graph.param.entry a ns2:Parameter ;
        rdfs:label "entry" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns199:_new_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "StarLayerGraph | StarLayerDataset" ;
        ns2:hasType ns4:starlayer.graph.graph.starlayer_dataset.StarLayerDataset, ns4:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

    ns199:_new_oxigraph_graph dcterms:identifier "tests.graph.w3c_sparql12.test_w3c_sparql12_eval._new_oxigraph_graph" ;
        a ns2:Function ;
        rdfs:comment """Same shape as _new_graph(), but backed by a live Oxigraph endpoint via
    the native rdf-1.2 backend instead of the in-memory default - no special
    loading path of its own, same .parse()/.query() calls either way.

    A plain (non-dataset) StarLayerGraph is given
    ``rdflib.graph.DATASET_DEFAULT_GRAPH_ID`` as its identifier rather than
    an arbitrary graph name: that sentinel is what tells the native
    backend's write/read paths (StarLayerGraph._native_scoped()) this graph
    stands for a dataset's own default graph, so its triples go to the
    endpoint's real (unnamed) default graph - the same place an unmodified
    query with no GRAPH clause looks by default. Anything else would need
    the query text itself changed to add a GRAPH wrapper, which defeats the
    point of this whole test file (running each W3C query exactly as
    published, see the module docstring).""" ;
        rdfs:label "_new_oxigraph_graph" ;
        ns2:calls ns173:data_format ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_sparql12/test_w3c_sparql12_eval.py" ;
        ns2:hasParameter ns199:_new_oxigraph_graph.param.entry ;
        ns2:hasReturnValue ns199:_new_oxigraph_graph.returns ;
        ns2:instantiates ns31:StarLayerDataset, ns28:StarLayerGraph ;
        ns2:isPrivate true ;
        ns2:lineEnd 100 ;
        ns2:lineStart 81 ;
        ns2:signature "def _new_oxigraph_graph(entry) -> StarLayerGraph | StarLayerDataset" .

    ns199:_new_oxigraph_graph.param.entry a ns2:Parameter ;
        rdfs:label "entry" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

