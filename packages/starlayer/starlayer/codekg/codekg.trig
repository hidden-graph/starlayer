        ns2:calls ns18:classify_statement, ns18:split_statements ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_syntax.py" ;
        ns2:lineEnd 239 ;
        ns2:lineStart 225 ;
        ns2:signature "def test_directive_keyword_inside_long_string_not_misdetected(self)" .

    ns170:TestTripleQuotedStringWithEmbeddedQuote.test_embedded_single_quote_does_not_split_statement dcterms:identifier "tests.graph.unit.test_syntax.TestTripleQuotedStringWithEmbeddedQuote.test_embedded_single_quote_does_not_split_statement" ;
        a ns2:Method ;
