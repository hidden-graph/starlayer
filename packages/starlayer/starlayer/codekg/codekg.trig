    ns17:extract_version_directive dcterms:identifier "starlayer.graph.parsers.rdfxml12.extract_version_directive" ;
        a ns2:Function ;
        rdfs:comment """Return the first rdf:version attribute value found anywhere in the
    document, or None.

    RDF 1.2 XML Syntax's version-announcement mechanism is structurally
    different from every other format's - an XML attribute on an in-scope
    node element, not a prologue-line directive - so it needs its own
    detection rather than reusing syntax.extract_fields()'s text-directive
    pattern. A separate, lightweight scan (rather than reusing
    _Preprocessor's own version-stripping pass below) keeps this a simple
    standalone function, matching ntriples12.py's/trig12.py's
    extract_version_directive() so StarLayerGraph.parse() can call it
    alongside parse_rdfxml12() without changing that function's existing
    list[tuple] return contract.""" ;
        rdfs:label "extract_version_directive" ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/parsers/rdfxml12.py" ;
        ns2:hasParameter ns17:extract_version_directive.param.text ;
        ns2:hasReturnValue ns17:extract_version_directive.returns ;
        ns2:lineEnd 101 ;
        ns2:lineStart 74 ;
        ns2:signature "def extract_version_directive(text: str) -> str | None" .

    ns17:extract_version_directive.param.text a ns2:Parameter ;
        rdfs:comment "The RDF/XML 1.2 document text to scan." ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns17:extract_version_directive.returns a ns2:ReturnValue ;
        rdfs:comment "The first rdf:version attribute value found anywhere in the document, or None if there isn't one." ;
        ns2:annotationText "str | None" ;
        ns2:hasType ns4:builtins.str ;
        ns2:optional true .

    ns17:parse_rdfxml12 dcterms:identifier "starlayer.graph.parsers.rdfxml12.parse_rdfxml12" ;
        a ns2:Function ;
        rdfs:comment """Parse RDF/XML 1.2 text; return list of (s, p, o) triples.

    rdf:parseType="Triple" (triple terms in object position) and
    rdf:annotation/rdf:annotationNodeID (the reifier-shorthand attributes) are
    the two RDF 1.2 additions to RDF/XML; both are preprocessed at the XML
    tree level (see _Preprocessor) into the bnode-based rdf:TripleTerm
    intermediate encoding, then handed to rdflib's real (RDF 1.1) 'xml'
    parser, then converted to TripleTerm objects exactly as before.
    Subjects and objects may be TripleTerm instances.""" ;
        rdfs:label "parse_rdfxml12" ;
