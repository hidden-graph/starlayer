    ns120:test_srl_eval.py dcterms:identifier "tests.sparql.unit.test_srl_eval" ;
        a ns2:Module ;
        rdfs:comment """Tests for starlayer.sparql.srl_eval - SRL §4.3 (Rule Dependency),
    §4.4 (Stratification), and §6 (Rule Set Evaluation).

    The centerpiece is test_worked_example_end_to_end below: it parses the
    exact base graph and rules (R1-R5) from the spec's own §6.6 "Worked
    Example" and asserts the exact dependency edges, exact stratification,
    and exact inferred graph the spec itself states - about as strong a
    correctness oracle as is available for a pre-Recommendation spec with no
    independent reference implementation.""" ;
        rdfs:label "test_srl_eval" ;
        ns2:declares ns137:_ast_ruleset, ns137:_ast_rule, ns137:test_worked_example_is_run_once_matches_spec, ns137:_default_value_base, ns137:test_worked_example_end_to_end, ns137:test_imports_rejected, ns137:test_infer_output_never_includes_base_graph_triples, ns137:_p, ns137:test_head_with_a_triple_term_containing_a_variable_makes_a_run_once_rule, ns137:_tp, ns137:test_blank_node_in_a_body_pattern_is_treated_as_a_variable_for_dependencies, ns137:test_plain_not_over_the_rules_own_output_is_still_a_stratification_error, ns137:test_worked_example_stratification_matches_spec, ns137:test_where_data_rule_has_no_dependencies_and_matches_only_the_base_graph, ns137:test_worked_example_dependency_graph_matches_spec, ns137:test_query_matches_goal_pattern_against_base_and_inferred, ns137:test_where_data_matches_only_the_original_base_graph, ns137:test_plan_shows_strata_and_dependency_edges_for_the_worked_example, ns137:test_a_positive_pattern_in_a_rule_with_not_data_is_still_a_dependency, ns137:test_stratification_error_on_closed_self_cycle, ns137:_km_triples, ns137:test_plan_raises_stratification_error_without_running_anything, ns137:_edge_labels_by_index, ns137:test_not_data_does_not_count_as_a_dependency_on_the_rules_own_output, ns137:TestInferSchemaParameter, ns137:test_triple_term_in_a_pattern_depends_on_a_triple_term_template_with_variables, ns137:_worked_example, ns137:TestInferAndQueryInferenceParameter, ns137:test_filter_and_assignment_evaluate_correctly ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_srl_eval.py" ;
