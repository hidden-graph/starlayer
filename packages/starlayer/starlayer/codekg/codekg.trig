        ns2:filePath "packages/starlayer/starlayer/sparql/sqe/to_text.py" ;
        ns2:hasParameter ns68:_abbreviate.param.prefixes, ns68:_abbreviate.param.iri ;
        ns2:hasReturnValue ns68:_abbreviate.returns ;
