    ns90:_SparqlAwareEncodedGraph.query dcterms:identifier "starlayer.shacl.adapters._SparqlAwareEncodedGraph.query" ;
        a ns2:Method ;
        rdfs:comment """Run a SPARQL query, routing it through a decoded
    ``StarLayerGraph`` when triple-term-aware evaluation is available,
    then re-encoding the result back into this graph's own flat term
    space - see the class docstring for why this interception exists.

    Falls back to plain ``rdflib.Graph.query()`` unchanged whenever no
    adapter is bound, ``starlayer.graph`` isn't installed, or decoding
    doesn't actually produce a ``StarLayerGraph``. Otherwise: decodes
    self (reusing the cached decode when nothing has mutated since -
    see ``_decode_cached()``), normalizes any triple-term-valued
    ``initBindings`` to match the decoded graph's own term space, runs
    the query against it, then re-encodes the output - each SELECT
    row's triple-term-like bindings back into flat ``tt:HASH``
    URIRefs, or a CONSTRUCT result's whole output graph back into
    encoded form - so the rest of pySHACL, which only understands the
    flat encoding, sees consistent output either way.""" ;
        rdfs:label "query" ;
        ns2:calls ns90:_normalize_init_bindings, ns90:_SparqlAwareEncodedGraph._decode_cached, ns81:is_triple_term_like, ns90:_starlayer_graph_class ;
        ns2:filePath "packages/starlayer/starlayer/shacl/adapters.py" ;
        ns2:hasParameter ns90:_SparqlAwareEncodedGraph.query.param.initNs, ns90:_SparqlAwareEncodedGraph.query.param.query_object, ns90:_SparqlAwareEncodedGraph.query.param.kwargs, ns90:_SparqlAwareEncodedGraph.query.param.use_store_provided, ns90:_SparqlAwareEncodedGraph.query.param.processor, ns90:_SparqlAwareEncodedGraph.query.param.result, ns90:_SparqlAwareEncodedGraph.query.param.initBindings ;
        ns2:hasReturnValue ns90:_SparqlAwareEncodedGraph.query.returns ;
        ns2:lineEnd 203 ;
        ns2:lineStart 116 ;
        ns2:signature "def query(self, query_object: Any, processor: str='sparql', result: str='sparql', initNs: Any=None, initBindings: Any=None, use_store_provided: bool=True, **kwargs: Any) -> Any" .

