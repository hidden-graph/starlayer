    ns308:_matcher_accepts dcterms:identifier "starlayer.shacl.ui_widget_selection._matcher_accepts" ;
        a ns2:Function ;
        rdfs:comment """Section 3.4 Matcher Function, step for step:

    1. No focus node, a ``shui:dataGraphShape`` present and no
       ``shui:shapesGraphShape``: reject - the only condition cannot be checked.
    2. The shape node is validated in the *shapes graph* against the
       matcher's ``shui:shapesGraphShape``, whose definition is read from the
       *scoring graph*. Reject on failure.
    3. No focus node: accept.
    4. The focus node is validated in the *data graph* against the
       matcher's ``shui:dataGraphShape``. The spec reads that shape from the
       shapes graph; the scoring graph is searched too, so a catalog that
       defines it alongside the matcher also works.""" ;
        rdfs:label "_matcher_accepts" ;
        ns2:calls ns308:_node_conforms ;
        ns2:filePath "packages/starlayer/starlayer/shacl/ui_widget_selection.py" ;
        ns2:hasParameter ns308:_matcher_accepts.param.data_graph, ns308:_matcher_accepts.param.shape_node, ns308:_matcher_accepts.param.scoring_graph, ns308:_matcher_accepts.param.shapes_graph, ns308:_matcher_accepts.param.focus_node, ns308:_matcher_accepts.param.matcher ;
        ns2:hasReturnValue ns308:_matcher_accepts.returns ;
        ns2:instantiates ns28:StarLayerGraph ;
        ns2:isPrivate true ;
        ns2:lineEnd 118 ;
        ns2:lineStart 71 ;
        ns2:signature "def _matcher_accepts(matcher: Any, *, shape_node: Any, focus_node: Any | None, data_graph: Any | None, shapes_graph: Any, scoring_graph: Any) -> bool" .

