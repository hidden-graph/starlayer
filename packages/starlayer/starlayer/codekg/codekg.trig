        ns2:instantiates ns28:StarLayerGraph ;
        ns2:lineEnd 83 ;
        ns2:lineStart 52 ;
        ns2:signature "def test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none() -> None" .

    ns261:test_global_rule_discovered_from_data_graph_itself_when_shacl_graph_is_none.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns261:test_global_rule_runs_once_against_whole_graph dcterms:identifier "tests.shacl.integration.test_global_sparql_rules.test_global_rule_runs_once_against_whole_graph" ;
