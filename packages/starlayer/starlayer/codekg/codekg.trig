GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/model/triple.py> {
    ns1:triple.py dcterms:identifier "starlayer.graph.model.triple" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.model.triple

    Core RDF 1.2 types: TripleTerm.""" ;
        rdfs:label "triple" ;
        ns2:declares ns5:TripleTerm ;
        ns2:filePath "packages/starlayer/starlayer/graph/model/triple.py" ;
        ns2:importsModule ns4:rdflib .

    ns5:TripleTerm dcterms:identifier "starlayer.graph.model.triple.TripleTerm" ;
        a ns2:Class ;
        rdfs:comment """An RDF 1.2 triple term — a triple used as a resource.

    Value-typed: two instances with the same (s, p, o) are equal and have the
    same hash. A plain Python 3-tuple is coerced to TripleTerm wherever the
    StarLayerGraph API expects a node.

    _namespace_manager is set by StarLayerGraph._restore() when returning a
    TripleTerm from a query result so that __str__ can emit prefixed names.
    It is excluded from equality and hashing.""" ;
        rdfs:label "TripleTerm" ;
        ns2:declares ns5:TripleTerm.__eq__, ns5:TripleTerm.__str__, ns5:TripleTerm._key, ns5:TripleTerm.__setattr__, ns5:TripleTerm.__init__, ns5:TripleTerm.__hash__, ns5:TripleTerm.__iter__, ns5:TripleTerm.n3, ns5:TripleTerm.__repr__ ;
