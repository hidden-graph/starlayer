        ns2:lineEnd 184 ;
        ns2:lineStart 141 ;
        ns2:signature "def serialize_rdfxml12(graph) -> str" .

    ns9:serialize_rdfxml12.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to serialize - a StarLayerGraph, or a plain rdflib.Graph wrapped via StarLayerGraph.from_rdflib()." ;
        rdfs:label "graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns9:serialize_rdfxml12.returns a ns2:ReturnValue ;
        rdfs:comment "The RDF/XML 1.2 serialization of graph." ;
        ns2:annotationText "str" ;
