        ns2:hasReturnValue ns56:_build_rdf_list.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 132 ;
        ns2:lineStart 127 ;
        ns2:signature "def _build_rdf_list(nodes: list, graph: Graph) -> BNode | URIRef" .

    ns56:_build_rdf_list.param.graph a ns2:Parameter ;
        rdfs:label "graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
