        rdfs:label "update" ;
        ns2:annotationText "Update" ;
        ns2:hasType ns4:rdflib.plugins.sparql.sparql.Update ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns71:update_to_rdf11.returns a ns2:ReturnValue ;
        rdfs:comment "A `(graph, root)` tuple - the RDF graph for the lowered 1.1 update, and the node for its root." ;
        ns2:annotationText "tuple[Graph, URIRef]" ;
        ns2:hasType ns4:rdflib.term.URIRef, ns4:rdflib.graph.Graph, ns4:builtins.tuple .

