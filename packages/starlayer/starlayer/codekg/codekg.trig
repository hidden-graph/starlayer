GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/graph/w3c_sparql12/download_w3c_sparql12_tests.py> {
    ns135:download_w3c_sparql12_tests.py dcterms:identifier "tests.graph.w3c_sparql12.download_w3c_sparql12_tests" ;
        a ns2:Module ;
        rdfs:comment """W3C SPARQL 1.2 Test Suite download script.

    Downloads manifest.ttl and every file it references (queries, data, expected
    results) for a fixed set of manifest categories from a single pinned-commit
    tarball snapshot of the official test suite at
    https://github.com/w3c/rdf-tests/tree/main/sparql/sparql12 - a real,
    separate test suite from starlayer.graph's own tests/w3c_turtle12/
    (Turtle-1.2-only, a different manifest). Mirrors
    scripts/sync_w3c_shacl12_suite.py's own fetch shape (one tarball request,
    pinned SHA, deliberate bump, a VENDORED_FROM.md provenance stamp) rather than
    this script's own prior per-file ``requests.get()`` design, which risked
    GitHub's 60-req/hour unauthenticated rate limit and left no record of what
    was actually fetched.

    The manifest itself is still parsed as real Turtle via rdflib, not regex -
    the SPARQL 1.2 manifests nest mf:action as a blank node with qt:query/qt:data
    (or ut:request for updates), which a line-oriented regex scan can't recover
    reliably.

    Populates tests/w3c_sparql12/data/ for this repo's own
    test_w3c_sparql12_eval.py, which runs the *original* W3C query text directly
    through StarLayerGraph (no starlayer.sparql translation pipeline involved at
    all) and compares against the suite's own official expected results - the
    "does starlayer.graph itself correctly execute these queries" check, independent
    of anything the downstream starlayer.sparql project's own translation adds
    or might get wrong. (The same fixture data, and the same fetch logic, is
    also vendored into the starlayer.sparql project's own tests/w3c_sparql12/ -
    copied rather than shared via a cross-repo path, since starlayer.graph's own test
    suite shouldn't depend on a specific sibling package existing.)

    Categories fetched (see this suite's own index at
    https://w3c.github.io/rdf-tests/sparql/sparql12/ for the full list of 10):
      - syntax-triple-terms-positive / -negative: PositiveSyntaxTest/
        NegativeSyntaxTest(/Update variants) - parse-only checks.
      - eval-triple-terms: QueryEvaluationTest/UpdateEvaluationTest - full
        execution checks.
      - expression: QueryEvaluationTest for isTRIPLE/SUBJECT/PREDICATE/OBJECT.
      - lang-basedir/codepoint-escapes/grouping/rdf11/syntax/version - added
        2026-10-13 (previously the only unfetched six; see
        starlayer/graph/CLAUDE.md's dated entry for why lang-basedir in
        particular was worth adding - several real starlayer.sparql gaps were
        found and fixed through it). Several fixtures across these are
        believed, confirmed-against-plain-rdflib defects inherited from
        rdflib itself, not this project's own gap - see
        tests/sparql/w3c_sparql12/test_w3c_sparql12.py's own
        _KNOWN_SUITE_DEFECT_FRAGMENTS/_INHERITED_RDFLIB_GAP_FRAGMENTS for the
        full, individually-reasoned list.

    Bumping PINNED_SHA is a deliberate, one-line, reviewable change - this
    script never auto-follows ``main``'s tip. The companion Turtle 1.2 downloader
    (tests/graph/w3c_turtle12/) and this script's own sibling copy
    (tests/sparql/w3c_sparql12/) pull from the same w3c/rdf-tests repo at their
    own independently-pinned SHA; bump all affected scripts together when
    investigating a specific upstream change, but there's no requirement they
    share one SHA otherwise.

    Always re-fetches and overwrites (the source is a pinned, immutable commit,
    so there's nothing to gain from skipping files already on disk - unlike a
    live, unpinned fetch, re-running this can never produce different output
    until PINNED_SHA is bumped).

    Usage: python download_w3c_sparql12_tests.py""" ;
        rdfs:label "download_w3c_sparql12_tests" ;
        ns2:declares ns136:_fetch_tarball_members, ns136:main, ns136:fetch_category, ns136:_local_filename ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_sparql12/download_w3c_sparql12_tests.py" ;
        ns2:importsModule ns4:datetime, ns4:__future__, ns4:io, ns4:rdflib, ns4:tarfile, ns4:os, ns4:rdflib.namespace, ns4:urllib.request .

    ns136:_fetch_tarball_members dcterms:identifier "tests.graph.w3c_sparql12.download_w3c_sparql12_tests._fetch_tarball_members" ;
        a ns2:Function ;
        rdfs:comment "{category: {relative_filename: bytes}} for each name in CATEGORIES." ;
        rdfs:label "_fetch_tarball_members" ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_sparql12/download_w3c_sparql12_tests.py" ;
        ns2:hasReturnValue ns136:_fetch_tarball_members.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 134 ;
        ns2:lineStart 112 ;
        ns2:signature "def _fetch_tarball_members() -> dict[str, dict[str, bytes]]" .

    ns136:_fetch_tarball_members.returns a ns2:ReturnValue ;
        ns2:annotationText "dict[str, dict[str, bytes]]" ;
        ns2:hasType ns4:builtins.bytes, ns4:builtins.dict, ns4:builtins.str .

    ns136:_local_filename dcterms:identifier "tests.graph.w3c_sparql12.download_w3c_sparql12_tests._local_filename" ;
        a ns2:Function ;
        rdfs:comment """The manifest references files by IRI relative to the category's own
    base URL - just the trailing path segment is the local filename.""" ;
        rdfs:label "_local_filename" ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_sparql12/download_w3c_sparql12_tests.py" ;
        ns2:hasParameter ns136:_local_filename.param.iri ;
        ns2:hasReturnValue ns136:_local_filename.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 140 ;
        ns2:lineStart 137 ;
        ns2:signature "def _local_filename(iri: str) -> str" .

    ns136:_local_filename.param.iri a ns2:Parameter ;
        rdfs:label "iri" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns136:_local_filename.returns a ns2:ReturnValue ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str .

    ns136:fetch_category dcterms:identifier "tests.graph.w3c_sparql12.download_w3c_sparql12_tests.fetch_category" ;
        a ns2:Function ;
        rdfs:comment """Write this category's manifest.ttl + every file it references from
    the already-fetched tarball contents, return a list of test-entry dicts
    for the combined index.""" ;
        rdfs:label "fetch_category" ;
        ns2:calls ns136:_local_filename ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_sparql12/download_w3c_sparql12_tests.py" ;
        ns2:hasParameter ns136:fetch_category.param.category, ns136:fetch_category.param.files ;
        ns2:hasReturnValue ns136:fetch_category.returns ;
        ns2:lineEnd 224 ;
        ns2:lineStart 143 ;
        ns2:signature "def fetch_category(category: str, files: dict[str, bytes]) -> list[dict]" .

    ns136:fetch_category.param.category a ns2:Parameter ;
        rdfs:label "category" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns136:fetch_category.param.files a ns2:Parameter ;
        rdfs:label "files" ;
        ns2:annotationText "dict[str, bytes]" ;
        ns2:hasType ns4:builtins.bytes, ns4:builtins.dict, ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns136:fetch_category.returns a ns2:ReturnValue ;
        ns2:annotationText "list[dict]" ;
        ns2:hasType ns4:builtins.dict, ns4:builtins.list .

    ns136:main dcterms:identifier "tests.graph.w3c_sparql12.download_w3c_sparql12_tests.main" ;
        a ns2:Function ;
        rdfs:label "main" ;
        ns2:calls ns136:fetch_category, ns136:_fetch_tarball_members ;
        ns2:filePath "packages/starlayer/tests/graph/w3c_sparql12/download_w3c_sparql12_tests.py" ;
        ns2:hasReturnValue ns136:main.returns ;
        ns2:lineEnd 273 ;
        ns2:lineStart 227 ;
        ns2:signature "def main() -> None" .

    ns136:main.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns4:__future__ a ns2:ExternalModule .

    ns4:builtins.bytes dcterms:identifier "builtins.bytes" ;
        a ns2:ExternalType ;
        rdfs:label "bytes" ;
        rdfs:subClassOf ns2:Type .

    ns4:builtins.dict dcterms:identifier "builtins.dict" ;
        a ns2:ExternalType ;
