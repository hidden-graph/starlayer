        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns42:_check_version_conformance.param.context, ns42:_check_version_conformance.param.declared_version, ns42:_check_version_conformance.param.tree, ns42:_check_version_conformance.param.stripped_text ;
        ns2:isPrivate true ;
        ns2:lineEnd 59 ;
        ns2:lineStart 47 ;
        ns2:signature "def _check_version_conformance(declared_version, stripped_text, tree, context)" .

    ns42:_check_version_conformance.param.context a ns2:Parameter ;
        rdfs:label "context" ;
        ns2:parameterKind "positional" ;
        ns2:position 3 .

    ns42:_check_version_conformance.param.declared_version a ns2:Parameter ;
        rdfs:label "declared_version" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns42:_check_version_conformance.param.stripped_text a ns2:Parameter ;
        rdfs:label "stripped_text" ;
