        ns2:hasReturnValue ns28:StarLayerGraph.parse.returns ;
        ns2:instantiates ns14:StarLayerTurtleParser ;
        ns2:lineEnd 2119 ;
        ns2:lineStart 1865 ;
        ns2:signature "def parse(self, source=None, publicID=None, format=None, location=None, file=None, data=None, **kwargs) -> StarLayerGraph" .

