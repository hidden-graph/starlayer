GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/starontology/manchester_conformance/tools/regen_owlapi_goldens.py> {
    ns332:regen_owlapi_goldens.py dcterms:identifier "tests.starontology.manchester_conformance.tools.regen_owlapi_goldens" ;
        a ns2:Module ;
        rdfs:comment """Regenerate the OWL API golden files for the Manchester conformance corpus.

    Offline tool (needs a JVM); CI never runs it - CI compares against the committed goldens. Run it when
    the corpus changes or to re-verify against a newer oracle jar:

        python tests/starontology/manchester_conformance/tools/regen_owlapi_goldens.py \\
            --jar "/path/to/manchester-owl-parser.jar" [--only case-id ...]

    The jar is the ``manchester-owl/manchester-syntax-parser`` shaded build (Main entry point
    ``OWLAPIInterface``) bundling OWL API 5.1.20, the same oracle docs/graph/manchester_syntax_gap_analysis.md
    uses. Each golden records: whether the oracle accepted the input, its Turtle output (RDF mapping), its own
    Manchester rendering, and the jar's SHA-256 so a golden is always traceable to the oracle that made it.""" ;
        rdfs:label "regen_owlapi_goldens" ;
        ns2:declares ns333:run_oracle_batch, ns333:main ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/tools/regen_owlapi_goldens.py" ;
        ns2:importsModule ns4:os, ns4:manchester_conformance.corpus, ns4:argparse, ns4:hashlib, ns4:json, ns4:subprocess, ns4:pathlib, ns4:__future__, ns4:sys, ns4:tempfile .

    ns333:main dcterms:identifier "tests.starontology.manchester_conformance.tools.regen_owlapi_goldens.main" ;
        a ns2:Function ;
        rdfs:label "main" ;
        ns2:calls ns333:run_oracle_batch ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/tools/regen_owlapi_goldens.py" ;
        ns2:hasReturnValue ns333:main.returns ;
        ns2:lineEnd 85 ;
        ns2:lineStart 53 ;
        ns2:signature "def main() -> int" .

    ns333:main.returns a ns2:ReturnValue ;
        ns2:annotationText "int" ;
        ns2:hasType ns4:builtins.int .

    ns333:run_oracle_batch dcterms:identifier "tests.starontology.manchester_conformance.tools.regen_owlapi_goldens.run_oracle_batch" ;
        a ns2:Function ;
        rdfs:comment """One JVM for the whole corpus. ``OwlApiDirect`` loads each document straight into the OWL API
    (no scratch ontology), so ontology-level triples (IRI, version IRI, annotations) are visible.""" ;
        rdfs:label "run_oracle_batch" ;
        ns2:filePath "packages/starlayer/tests/starontology/manchester_conformance/tools/regen_owlapi_goldens.py" ;
        ns2:hasParameter ns333:run_oracle_batch.param.cases, ns333:run_oracle_batch.param.jar ;
        ns2:hasReturnValue ns333:run_oracle_batch.returns ;
        ns2:lineEnd 50 ;
        ns2:lineStart 35 ;
        ns2:signature "def run_oracle_batch(jar: Path, cases) -> dict[str, dict]" .

    ns333:run_oracle_batch.param.cases a ns2:Parameter ;
        rdfs:label "cases" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns333:run_oracle_batch.param.jar a ns2:Parameter ;
        rdfs:label "jar" ;
        ns2:annotationText "Path" ;
        ns2:hasType ns4:pathlib.Path ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns333:run_oracle_batch.returns a ns2:ReturnValue ;
        ns2:annotationText "dict[str, dict]" ;
        ns2:hasType ns4:builtins.str, ns4:builtins.dict .

    ns4:__future__ a ns2:ExternalModule .

    ns4:argparse a ns2:ExternalModule .

    ns4:builtins.dict dcterms:identifier "builtins.dict" ;
        a ns2:ExternalType ;
        rdfs:label "dict" ;
        rdfs:subClassOf ns2:Type .

    ns4:builtins.int dcterms:identifier "builtins.int" ;
        a ns2:ExternalType ;
        rdfs:label "int" ;
        rdfs:subClassOf ns2:Type .

    ns4:builtins.str dcterms:identifier "builtins.str" ;
        a ns2:ExternalType ;
