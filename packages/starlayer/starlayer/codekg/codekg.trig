GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/tests/test_reexports.py> {
    ns149:test_reexports.py dcterms:identifier "tests.test_reexports" ;
        a ns2:Module ;
        rdfs:comment """starlayer's __init__.py re-exports names from starlayer.graph/starlayer.shacl by
    reference, not by copy or redefinition - these tests lock in `is` identity
    (not just equal behavior) so a future refactor can't quietly turn a
    re-export into a separate, divergent copy.""" ;
        rdfs:label "test_reexports" ;
        ns2:declares ns150:test_graph_and_validator_work_together_through_the_single_import, ns150:test_reexports_are_the_same_objects_not_copies, ns150:test_all_matches_actual_module_exports ;
        ns2:filePath "packages/starlayer/tests/test_reexports.py" .

    ns150:test_all_matches_actual_module_exports dcterms:identifier "tests.test_reexports.test_all_matches_actual_module_exports" ;
        a ns2:Function ;
        rdfs:comment """``dir(starlayer)`` also legitimately includes ``graph``/``sparql``/
    ``shacl``/``starontology``/``conformance`` - Python always binds an
    imported submodule as an attribute of its parent package as a side
    effect of the import (not something any of this project's own code
    opts into). ``graph``/``shacl``/``sparql`` are always present -
    ``starlayer/__init__.py`` imports all three directly and
    unconditionally (``sparql`` joined 2026-10-14, for `StarQuery` -
    see that same date's entry in ``starlayer/sparql/CLAUDE.md``).
    ``starontology``/``conformance`` are order-dependent instead - nothing
    in ``starlayer/__init__.py`` imports either directly, but they can
    still end up bound here purely from process-wide import order -
    ``starontology`` ends up bound this way since ``starlayer.sparql``'s
    own submodules import it eagerly (so it was already order-dependent
    before ``sparql`` itself became unconditional - that only fixed
    ``sparql``'s own presence, not its transitive import's), and
    ``conformance`` the same way again, since ``starlayer.conformance``'s
    own ``declared_conformance()`` lazily imports
    ``starlayer.shacl.shacl_profiling`` internally - whichever test file
    happens to import ``starlayer.conformance`` first in a given session
    (e.g. ``test_conformance.py``) is what binds it. ``codekg`` joins the
    list for the identical reason (2026-10-13): nothing in
    ``starlayer/__init__.py`` imports it, but the code-KG extractor's own
    tests (``tests/codekg/``) import ``starlayer.codekg``/
    ``starlayer.codekg.extractor.*`` directly, so whether it's bound here
    depends purely on whether one of those test modules already ran in
    the same session. All six (``sparql`` included, even though it's now
    unconditionally present - keeping it in this subtraction set is
    harmless and avoids re-deriving which ones are guaranteed vs. not)
    are deliberately excluded here rather than asserted against, since
    none of them are part of the curated ``__all__`` list (see this
    module's own docstring) - this test only needs to confirm every
    *curated* re-export is genuinely present, not that nothing else is
    ever visible.""" ;
        rdfs:label "test_all_matches_actual_module_exports" ;
        ns2:filePath "packages/starlayer/tests/test_reexports.py" ;
        ns2:hasReturnValue ns150:test_all_matches_actual_module_exports.returns ;
        ns2:lineEnd 59 ;
        ns2:lineStart 23 ;
        ns2:signature "def test_all_matches_actual_module_exports() -> None" .

    ns150:test_all_matches_actual_module_exports.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns150:test_graph_and_validator_work_together_through_the_single_import dcterms:identifier "tests.test_reexports.test_graph_and_validator_work_together_through_the_single_import" ;
        a ns2:Function ;
        rdfs:label "test_graph_and_validator_work_together_through_the_single_import" ;
        ns2:filePath "packages/starlayer/tests/test_reexports.py" ;
        ns2:hasReturnValue ns150:test_graph_and_validator_work_together_through_the_single_import.returns ;
        ns2:lineEnd 81 ;
        ns2:lineStart 62 ;
        ns2:signature "def test_graph_and_validator_work_together_through_the_single_import() -> None" .

    ns150:test_graph_and_validator_work_together_through_the_single_import.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns150:test_reexports_are_the_same_objects_not_copies dcterms:identifier "tests.test_reexports.test_reexports_are_the_same_objects_not_copies" ;
        a ns2:Function ;
        rdfs:label "test_reexports_are_the_same_objects_not_copies" ;
        ns2:filePath "packages/starlayer/tests/test_reexports.py" ;
        ns2:hasReturnValue ns150:test_reexports_are_the_same_objects_not_copies.returns ;
        ns2:lineEnd 20 ;
        ns2:lineStart 17 ;
        ns2:signature "def test_reexports_are_the_same_objects_not_copies() -> None" .

    ns150:test_reexports_are_the_same_objects_not_copies.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .
}

