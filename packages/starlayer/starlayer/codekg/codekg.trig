    ns30:classify_owl_dl dcterms:identifier "starlayer.graph.graph.owl_dl.classify_owl_dl" ;
        a ns2:Function ;
        rdfs:comment """Run OWL 2 DL classification (HermiT, via owlready2) over `graph`,
    returning (before, delta) in the same shape
    StarLayerGraph._infer_before_and_delta() returns for the owlrl-backed
    regimes, so infer()'s mode="full"/"delta"/"in-place" branches can
    treat both engines uniformly without knowing which one ran.

    Raises InconsistentOntologyError if the data is logically inconsistent
    under OWL 2 DL semantics.""" ;
        rdfs:label "classify_owl_dl" ;
        ns2:calls ns30:_complete_type_closure, ns30:_require_owlready2, ns30:_require_java, ns26:run_with_timeout ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/graph/graph/owl_dl.py" ;
        ns2:hasParameter ns30:classify_owl_dl.param.timeout, ns30:classify_owl_dl.param.graph ;
        ns2:hasReturnValue ns30:classify_owl_dl.returns ;
        ns2:lineEnd 199 ;
        ns2:lineStart 128 ;
        ns2:signature "def classify_owl_dl(graph, timeout: float | None=_timeout.DEFAULT_TIMEOUT_SECONDS)" .

    ns30:classify_owl_dl.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to classify." ;
        rdfs:label "graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns30:classify_owl_dl.param.timeout a ns2:Parameter ;
        rdfs:comment "Wall-clock budget in seconds for the actual HermiT call (default `_timeout.DEFAULT_TIMEOUT_SECONDS`, 120s) - the call runs in its own subprocess/process group so it can be forcibly killed, JVM child included, if it's exceeded; raises `_timeout.ReasoningTimeoutError`. Pass `None` to disable the timeout entirely (wait indefinitely - the pre-this-feature behavior). See `_timeout.py`'s own module docstring for why a subprocess kill, not a cooperative cancellation, is the only mechanism that reliably works here." ;
        rdfs:label "timeout" ;
        ns2:annotationText "float | None" ;
        ns2:defaultValue "_timeout.DEFAULT_TIMEOUT_SECONDS" ;
        ns2:hasType ns4:builtins.float ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns30:classify_owl_dl.returns a ns2:ReturnValue ;
