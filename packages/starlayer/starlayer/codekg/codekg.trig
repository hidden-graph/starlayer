        ns2:hasType ns4:typing.Any, ns4:collections.abc.Callable ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns7:inject_missing_tt_encoding.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

