    ns28:StarLayerGraph._native_remove dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph._native_remove" ;
        a ns2:Method ;
        rdfs:comment """Remove triples matching (s, p, obj) via raw SPARQL Update -
    mirrors _native_add()/_native_triples()'s own dispatch rather than
    rdflib's own ``Graph.remove()`` -> ``store.remove()``, which reaches
    rdflib's ``SPARQLUpdateStore`` directly and crashes outright on any
