    ns294:TestEntailmentBinding.test_repeated_calls_with_bound_entailment_stay_correct dcterms:identifier "tests.sparql.unit.test_star_query.TestEntailmentBinding.test_repeated_calls_with_bound_entailment_stay_correct" ;
        a ns2:Method ;
        rdfs:comment """Regression guard for the real bug this class works around (see
    its own module docstring): entailment=RDF/RDFS only rewrites a
    query's algebra when given as text, never when given an already-
    prepared Query object. A naive "prepare once, reuse the prepared
    object" implementation would silently stop applying entailment -
    confirmed empirically to fail silently (empty results, no error)
    before this class's run() picked text vs. prepared object based on
    the effective entailment. Calling run() twice guards against a
    once-only accidental pass too.""" ;
        rdfs:label "test_repeated_calls_with_bound_entailment_stay_correct" ;
        ns2:calls ns294:TestEntailmentBinding._graph_with_subclass ;
        ns2:filePath "packages/starlayer/tests/sparql/unit/test_star_query.py" ;
        ns2:lineEnd 88 ;
        ns2:lineStart 75 ;
        ns2:signature "def test_repeated_calls_with_bound_entailment_stay_correct(self)" .

