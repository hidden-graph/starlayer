    ns224:TestOxigraphRemove dcterms:identifier "tests.graph.integration.test_oxigraph_backend.TestOxigraphRemove" ;
        a ns2:Class ;
        rdfs:comment """StarLayerGraph.remove() on the native backend used to call
    super().remove() directly - bypassing sparql_term()/skolemize_bnode()
    entirely - which reaches rdflib's own SPARQLUpdateStore._node_to_sparql()
    and crashes outright on any BNode ("SPARQLStore does not support
    BNodes!"), confirmed live against Oxigraph before this fix. Also had no
    live test coverage of any kind (BNode or not). Fixed with a dedicated
    _native_remove() mirroring _native_add()/_native_triples()'s own
    sparql_term()-based dispatch.""" ;
        rdfs:label "TestOxigraphRemove" ;
        ns2:declares ns224:TestOxigraphRemove.test_remove_bnode_triple, ns224:TestOxigraphRemove.test_remove_plain_triple, ns224:TestOxigraphRemove.test_remove_triple_term_valued_triple, ns224:TestOxigraphRemove.test_remove_wildcard_pattern ;
