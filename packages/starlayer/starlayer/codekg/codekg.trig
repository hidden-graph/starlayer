    ns88:normalize_to_starlayer_graph dcterms:identifier "starlayer.shacl.engine.normalization.normalize_to_starlayer_graph" ;
        a ns2:Function ;
        rdfs:comment """Normalize input graph to StarLayerGraph.

    A plain rdflib.Graph is always converted. Existing StarLayerGraph
    instances are returned as-is.""" ;
