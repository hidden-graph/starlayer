        ns2:hasParameter ns42:prepareUpdate.param.updateString, ns42:prepareUpdate.param.base, ns42:prepareUpdate.param.initNs ;
        ns2:hasReturnValue ns42:prepareUpdate.returns ;
        ns2:lineEnd 170 ;
