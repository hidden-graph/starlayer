    ns197:TestInferCombinedWithRdf dcterms:identifier "tests.graph.unit.test_infer.TestInferCombinedWithRdf" ;
        a ns2:Class ;
        rdfs:comment """ENTAILMENT.RDF combines freely with RDFS/OWL-RDF-Based (any subset,
    including all three at once) - the native RDF delta is unioned with
    whatever the owlrl-backed regime(s) entail. Uses rdf:first/rdf:rest/
    rdf:nil data specifically: RDFS alone does NOT entail
    ``rdf:nil rdf:type rdf:List`` (confirmed empirically - it has no rule
    touching rdf:List at all), unlike rdfD2's own property-typing effect
    which RDFS's rdfs6 reflexivity already happens to subsume for any
    predicate - so this is a real case where the union adds something the
    owlrl side alone would not, not a trivially-already-equal result.""" ;
        rdfs:label "TestInferCombinedWithRdf" ;
        ns2:declares ns197:TestInferCombinedWithRdf.test_rdf_alone_in_a_set_is_unchanged, ns197:TestInferCombinedWithRdf.test_rdf_plus_owl_rl_unions_both_deltas, ns197:TestInferCombinedWithRdf.test_owl_direct_combined_with_rdf_still_raises, ns197:TestInferCombinedWithRdf._list_and_subclass_graph, ns197:TestInferCombinedWithRdf.test_all_three_combined, ns197:TestInferCombinedWithRdf.test_rdf_plus_rdfs_unions_both_deltas ;
        ns2:filePath "packages/starlayer/tests/graph/unit/test_infer.py" ;
        ns2:hasDecorator ns197:TestInferCombinedWithRdf.decorator.0 ;
