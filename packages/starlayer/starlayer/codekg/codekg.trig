    ns82:_meta_validate_cache_key.returns a ns2:ReturnValue ;
        rdfs:comment "A ``(content_hash, kwarg_items)`` tuple to use as the cache key, or ``None`` if ``rdfc10_hash`` itself raises - not cacheable; the caller must compute fresh, exactly as if this cache didn't exist. ``rdfc10_hash`` has a known pre-existing edge case in its canonicalization algorithm (an ``AssertionError`` - \"blank node ... was never assigned a canonical identifier\") that a real shapes graph can hit, unrelated to this cache. A caching *optimization* must never be able to turn a graph that validates correctly into one that raises - correctness always wins over the cache hit." ;
        ns2:annotationText "tuple | None" ;
        ns2:hasType ns4:builtins.tuple ;
        ns2:optional true .

    ns82:_sparql_structure_cache_key dcterms:identifier "starlayer.shacl.meta_shapes._sparql_structure_cache_key" ;
        a ns2:Function ;
        rdfs:comment """Cache key for one query's structural-validation outcome - the exact
    inputs the *effective* (exemption-applied) result depends on for this
    one embedded query: which predicate carried it (part of the error
    message, not the semantics, but cheap to include and keeps the key
    unambiguous), the literal text itself, its resolved prefix map (two
    otherwise-identical query strings can mean different things under
    different prefix bindings), and ``is_target`` - whether ``$this`` is
    genuinely required to be bound by this query's own pattern (a
    ``sh:target``-declared SPARQL target) or externally pre-bound (every
    other case) changes whether a given unbound-``$this`` violation is a
    real defect, even for byte-identical query text (see
    ``_is_prebound_variable_only_report``'s own docstring).""" ;
        rdfs:label "_sparql_structure_cache_key" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/meta_shapes.py" ;
        ns2:hasParameter ns82:_sparql_structure_cache_key.param.predicate, ns82:_sparql_structure_cache_key.param.text_literal, ns82:_sparql_structure_cache_key.param.prefixes, ns82:_sparql_structure_cache_key.param.is_target ;
        ns2:hasReturnValue ns82:_sparql_structure_cache_key.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 290 ;
        ns2:lineStart 271 ;
        ns2:signature "def _sparql_structure_cache_key(predicate: Any, text_literal: Literal, prefixes: dict, is_target: bool) -> tuple" .

    ns82:_sparql_structure_cache_key.param.is_target a ns2:Parameter ;
        rdfs:label "is_target" ;
        ns2:annotationText "bool" ;
        ns2:hasType ns4:builtins.bool ;
        ns2:parameterKind "positional" ;
        ns2:position 3 .

    ns82:_sparql_structure_cache_key.param.predicate a ns2:Parameter ;
