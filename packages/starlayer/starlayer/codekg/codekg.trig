    ns62:_check_rule dcterms:identifier "starlayer.sparql.srl_semantic_checks._check_rule" ;
        a ns2:Function ;
        rdfs:comment """§4.2: is ``rule`` a well-formed rule? Its body must be a well-formed
    sequence given V0 = the empty set, and every variable in a head triple
    template must be in the body's own ``Vall``.""" ;
        rdfs:label "_check_rule" ;
        ns2:calls ns62:_triple_vars, ns62:_check_sequence ;
        ns2:filePath "/Users/johnclements/Documents/GitHub/hidden-graph/starlayer/packages/starlayer/starlayer/sparql/srl_semantic_checks.py" ;
