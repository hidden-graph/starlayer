        ns2:hasReturnValue ns280:StarQuery.__init__.returns ;
        ns2:isDunder true ;
        ns2:lineEnd 112 ;
        ns2:lineStart 68 ;
        ns2:signature "def __init__(self, text: str, *, base: str | None=None, initNs: Mapping[str, Any] | None=None, initBindings: Mapping[str, Any] | None=None, entailment: Any | None=None, infer: str='changed', engine: str='hermit', timeout: Any=_TIMEOUT_NOT_BOUND) -> None" .

    ns280:StarQuery.__init__.param.base a ns2:Parameter ;
        rdfs:comment "Optional base IRI, passed through to query preparation." ;
        rdfs:label "base" ;
        ns2:annotationText "str | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:builtins.str ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns280:StarQuery.__init__.param.engine a ns2:Parameter ;
        rdfs:comment "Passed through to ``StarLayerGraph.query()`` - only consulted for ``entailment=ENTAILMENT[\"OWL-Direct\"]``." ;
        rdfs:label "engine" ;
        ns2:annotationText "str" ;
        ns2:defaultValue "'hermit'" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "kwonly" ;
        ns2:position 6 .

    ns280:StarQuery.__init__.param.entailment a ns2:Parameter ;
        rdfs:comment "The entailment regime to use on every :meth:`run` call, unless overridden per call - see ``StarLayerGraph.query()``'s own ``entailment=`` for the full set of accepted values." ;
        rdfs:label "entailment" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns280:StarQuery.__init__.param.infer a ns2:Parameter ;
        rdfs:comment "Passed through to ``StarLayerGraph.query()`` - only consulted for the two entailment regimes that cache a delta (``OWL-RDF-Based``/``OWL-Direct``)." ;
        rdfs:label "infer" ;
        ns2:annotationText "str" ;
        ns2:defaultValue "'changed'" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "kwonly" ;
        ns2:position 5 .

    ns280:StarQuery.__init__.param.initBindings a ns2:Parameter ;
        rdfs:comment "Initial variable bindings, bound once." ;
        rdfs:label "initBindings" ;
        ns2:annotationText "Mapping[str, Any] | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:builtins.str, ns4:typing.Any, ns4:collections.abc.Mapping ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns280:StarQuery.__init__.param.initNs a ns2:Parameter ;
        rdfs:comment "Namespace bindings for the query - bound once here rather than repeated on every :meth:`run` call." ;
        rdfs:label "initNs" ;
        ns2:annotationText "Mapping[str, Any] | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns4:builtins.str, ns4:typing.Any, ns4:collections.abc.Mapping ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 2 .

    ns280:StarQuery.__init__.param.text a ns2:Parameter ;
        rdfs:comment "The SPARQL query text (SPARQL 1.2, including RDF 1.2 triple-term/annotation syntax)." ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns4:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns280:StarQuery.__init__.param.timeout a ns2:Parameter ;
        rdfs:comment "Passed through to ``StarLayerGraph.query()``. Left unset by default (the sentinel below), in which case ``StarLayerGraph.query()``'s own default is used instead of this module duplicating that default's actual value." ;
        rdfs:label "timeout" ;
        ns2:annotationText "Any" ;
        ns2:defaultValue "_TIMEOUT_NOT_BOUND" ;
        ns2:hasType ns4:typing.Any ;
        ns2:parameterKind "kwonly" ;
        ns2:position 7 .

    ns280:StarQuery.__init__.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns280:StarQuery.run dcterms:identifier "starlayer.sparql.star_query.StarQuery.run" ;
        a ns2:Method ;
        rdfs:comment """Run the bound query against ``graph``.

    Any option bound at construction can be overridden for just this
    one call via ``**overrides`` - the bound value itself is never
    changed.""" ;
        rdfs:label "run" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/star_query.py" ;
        ns2:hasParameter ns280:StarQuery.run.param.graph, ns280:StarQuery.run.param.overrides ;
