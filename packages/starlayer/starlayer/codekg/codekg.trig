        ns2:signature "def _register_ns(sg) -> None" .

    ns9:_register_ns.param.sg a ns2:Parameter ;
        rdfs:label "sg" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns9:_register_ns.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns9:_set_object dcterms:identifier "starlayer.graph.serializers.rdfxml12._set_object" ;
        a ns2:Function ;
        rdfs:comment "Configure *prop* for the given object node (attribute or nested element)." ;
        rdfs:label "_set_object" ;
        ns2:calls ns9:_set_object, ns9:_clark, ns7:encode_dirlang_datatype ;
        ns2:filePath "packages/starlayer/starlayer/graph/serializers/rdfxml12.py" ;
        ns2:hasParameter ns9:_set_object.param.obj, ns9:_set_object.param.prop ;
        ns2:hasReturnValue ns9:_set_object.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 130 ;
        ns2:lineStart 92 ;
        ns2:signature "def _set_object(prop: ET.Element, obj) -> None" .

    ns9:_set_object.param.obj a ns2:Parameter ;
        rdfs:label "obj" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns9:_set_object.param.prop a ns2:Parameter ;
        rdfs:label "prop" ;
        ns2:annotationText "ET.Element" ;
        ns2:hasType ns4:xml.etree.ElementTree.Element ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns9:_set_object.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns9:_sort_key dcterms:identifier "starlayer.graph.serializers.rdfxml12._sort_key" ;
        a ns2:Function ;
        rdfs:label "_sort_key" ;
        ns2:filePath "packages/starlayer/starlayer/graph/serializers/rdfxml12.py" ;
        ns2:hasParameter ns9:_sort_key.param.node ;
