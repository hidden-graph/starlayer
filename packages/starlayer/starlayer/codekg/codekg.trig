    ns50:find_unbound_projected_variables dcterms:identifier "starlayer.sparql.salg.semantic_checks.find_unbound_projected_variables" ;
        a ns2:Function ;
        rdfs:comment """Returns every ``UnboundProjectedVariable`` finding in ``data_graph``.

    Finds every ``salg:Project`` node in ``data_graph`` (a ``salg:``
    algebra graph, as produced by ``to_rdf.query_to_rdf``/``update_to_rdf``
    - ``Project`` nodes can appear for a Query or an Update alike) whose
    ``PV`` names a variable that's never actually bound anywhere in its
    own pattern subtree.

    A plain, standalone function for a caller who wants this one check
    directly - the same check also runs automatically as a real SHACL
    constraint whenever ``starlayer.sparql.validate()`` validates a graph whose
    ``salg:Project`` nodes activate it (see this module's own docstring).""" ;
        rdfs:label "find_unbound_projected_variables" ;
        ns2:calls ns50:_unbound_projected_variables_for_node ;
        ns2:filePath "packages/starlayer/starlayer/sparql/salg/semantic_checks.py" ;
        ns2:hasParameter ns50:find_unbound_projected_variables.param.data_graph ;
        ns2:hasReturnValue ns50:find_unbound_projected_variables.returns ;
        ns2:lineEnd 203 ;
        ns2:lineStart 179 ;
        ns2:signature "def find_unbound_projected_variables(data_graph: Graph) -> list[UnboundProjectedVariable]" .

    ns50:find_unbound_projected_variables.param.data_graph a ns2:Parameter ;
        rdfs:comment "The ``salg:`` algebra graph to scan." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns4:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns50:find_unbound_projected_variables.returns a ns2:ReturnValue ;
        rdfs:comment "One `UnboundProjectedVariable` per offending `PV` variable, across every `Project` node in `data_graph` (empty if none)." ;
        ns2:annotationText "list[UnboundProjectedVariable]" ;
        ns2:hasType ns50:UnboundProjectedVariable, ns4:builtins.list .

