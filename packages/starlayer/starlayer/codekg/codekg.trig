    ns63:RuleSet.query.param.goal_pattern a ns2:Parameter ;
        rdfs:comment "The triple pattern to match against the union of ``base_graph`` and the inferred triples." ;
        rdfs:label "goal_pattern" ;
        ns2:annotationText "TriplePattern" ;
        ns2:hasType ns63:TriplePattern ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns63:RuleSet.query.returns a ns2:ReturnValue ;
        rdfs:comment "One ``dict[Variable, term]`` solution per match." ;
