        ns2:declares ns76:_build_unique_values_for_component.UniqueValuesForConstraintComponent ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:hasReturnValue ns76:_build_unique_values_for_component.returns ;
