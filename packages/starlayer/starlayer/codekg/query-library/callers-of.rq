# name: callers-of
# label: Who calls a function or method?
# comment: The direct callers of a symbol, from the call graph. No rows means no caller this extractor could resolve, which is a lead, not proof that nothing calls it.
# topic: call-graph
# answers: What calls function X (reverse lookup)
# answers: If I change X's signature, what else might break
# param: symbol | dotted identifier of a function or method | starlayer.graph.model.encoding.tt_hash | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?caller ?file ?line WHERE {
  ?target dcterms:identifier ?symbol .
  ?c slkg:calls ?target ;
     dcterms:identifier ?caller .
  OPTIONAL { ?c slkg:filePath ?file }
  OPTIONAL { ?c slkg:lineStart ?line }
}
ORDER BY ?caller
