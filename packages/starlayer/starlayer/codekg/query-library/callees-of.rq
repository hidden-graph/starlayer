# name: callees-of
# label: What does a function or method call?
# comment: The direct callees of a symbol, from the call graph.
# topic: call-graph
# answers: What functions/methods does function X call
# param: symbol | dotted identifier of a function or method | starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?callee ?file ?line WHERE {
  ?c dcterms:identifier ?symbol ;
     slkg:calls ?t .
  ?t dcterms:identifier ?callee .
  OPTIONAL { ?t slkg:filePath ?file }
  OPTIONAL { ?t slkg:lineStart ?line }
}
ORDER BY ?callee
