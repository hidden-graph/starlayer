# name: capabilities
# label: What StarLayer does, and which code does it
# comment: The curated capability list with the symbols that implement each, optionally limited to words in the capability text. Capabilities with no implementing symbol are roadmap items or are implemented by a SHACL or OWL file.
# topic: capabilities
# param: text | only capabilities whose description contains this, case-insensitive | SHACL | optional
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?area ?capability ?status ?symbol ?file ?line WHERE {
  VALUES ?text { UNDEF }
  ?cap a slkg:Capability ;
       slkg:inCapabilityArea ?a ;
       rdfs:comment ?capability ;
       slkg:hasStatus ?status .
  ?a rdfs:label ?area .
  FILTER(!BOUND(?text) || CONTAINS(LCASE(?capability), LCASE(?text)))
  OPTIONAL {
    ?cap slkg:implementedByIdentifier ?symbol .
    OPTIONAL {
      ?s dcterms:identifier ?symbol .
      OPTIONAL { ?s slkg:filePath ?file }
      OPTIONAL { ?s slkg:lineStart ?line }
    }
  }
}
ORDER BY ?area ?capability ?symbol
