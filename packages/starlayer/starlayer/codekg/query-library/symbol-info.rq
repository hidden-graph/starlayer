# name: symbol-info
# label: What is this symbol, and where is it?
# comment: The kind, location, signature and one-line summary of one symbol, by its dotted identifier.
# topic: navigation
# answers: What are a function/method's parameters
# param: symbol | dotted identifier of a class, function, method or module | starlayer.graph.model.encoding.tt_hash | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?kind ?file ?line ?lineEnd ?signature ?summary WHERE {
  ?s dcterms:identifier ?symbol .
  ?s a ?type .
  FILTER(?type IN (slkg:Class, slkg:Function, slkg:Method, slkg:Module))
  BIND(LCASE(REPLACE(STR(?type), "^.*#", "")) AS ?kind)
  OPTIONAL { ?s slkg:filePath ?file }
  OPTIONAL { ?s slkg:lineStart ?line }
  OPTIONAL { ?s slkg:lineEnd ?lineEnd }
  OPTIONAL { ?s slkg:signature ?signature }
  OPTIONAL { ?s rdfs:comment ?summary }
}
