# name: leaky-private-functions
# label: Private functions called from another module
# comment: Functions whose name starts with an underscore but that a different module (file) calls anyway, which usually means the abstraction leaks or the function should be public.
# topic: api-surface
# answers: Is a "private" function called from outside its own module anyway
# param: prefix | only private functions whose dotted identifier starts with this | starlayer.graph | optional
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?private ?callerModule ?caller WHERE {
  VALUES ?prefix { UNDEF }
  ?f a slkg:Function ;
     slkg:isPrivate true ;
     dcterms:identifier ?private .
  FILTER(!BOUND(?prefix) || STRSTARTS(?private, ?prefix))
  ?c slkg:calls ?f ;
     dcterms:identifier ?caller .
  BIND(STRBEFORE(STR(?c), "#") AS ?callerFile)
  FILTER(?callerFile != STRBEFORE(STR(?f), "#"))
  BIND(REPLACE(?callerFile, "^.*/blob/main/", "") AS ?callerModule)
}
ORDER BY ?private ?caller
