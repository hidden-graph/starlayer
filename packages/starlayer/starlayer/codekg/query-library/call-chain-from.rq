# name: call-chain-from
# label: Everything a function reaches through calls
# comment: All functions and methods reachable from a symbol by following calls any number of steps (a property-path query). Large for entry points; narrow the symbol first.
# topic: call-graph
# answers: What's the call chain from entry point A down to low-level function B
# param: symbol | dotted identifier of the starting function or method | starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT ?reached WHERE {
  ?a dcterms:identifier ?symbol ;
     slkg:calls+ ?b .
  ?b dcterms:identifier ?reached .
}
ORDER BY ?reached
