# name: public-api-of-module
# label: Public classes and functions of a module
# comment: What a module defines at its top level that does not start with an underscore.
# topic: api-surface
# answers: What's the public API surface of a module/package
# param: symbol | dotted identifier of a module | starlayer.graph.model.encoding | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?name ?kind ?line ?summary WHERE {
  ?mod dcterms:identifier ?symbol ;
       slkg:declares ?s .
  ?s dcterms:identifier ?name .
  ?s a ?type .
  FILTER(?type IN (slkg:Class, slkg:Function))
  BIND(LCASE(REPLACE(STR(?type), "^.*#", "")) AS ?kind)
  FILTER NOT EXISTS { ?s slkg:isPrivate true }
  OPTIONAL { ?s slkg:lineStart ?line }
  OPTIONAL { ?s rdfs:comment ?summary }
}
ORDER BY ?line
