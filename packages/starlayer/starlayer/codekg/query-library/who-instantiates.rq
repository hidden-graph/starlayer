# name: who-instantiates
# label: Where is a class instantiated?
# comment: The functions and methods that construct an instance of a class.
# topic: call-graph
# answers: Which classes are ever instantiated, and from where
# param: symbol | dotted identifier of a class | starlayer.graph.graph.starlayer_graph.StarLayerGraph | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?constructor ?file ?line WHERE {
  ?class dcterms:identifier ?symbol .
  ?f slkg:instantiates ?class ;
     dcterms:identifier ?constructor .
  OPTIONAL { ?f slkg:filePath ?file }
  OPTIONAL { ?f slkg:lineStart ?line }
}
ORDER BY ?constructor
