# name: tests-of
# label: Which tests exercise a function?
# comment: The test functions and methods that call a symbol directly.
# topic: testing
# answers: Does this function have a test that exercises it
# param: symbol | dotted identifier of a function or method | starlayer.graph.model.encoding.tt_hash | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?test ?file ?line WHERE {
  ?target dcterms:identifier ?symbol .
  ?t slkg:calls ?target ;
     dcterms:identifier ?test ;
     slkg:filePath ?file .
  FILTER(STRSTARTS(?file, "packages/starlayer/tests/"))
  OPTIONAL { ?t slkg:lineStart ?line }
}
ORDER BY ?test
