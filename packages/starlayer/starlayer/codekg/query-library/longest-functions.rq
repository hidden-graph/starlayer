# name: longest-functions
# label: The longest functions and methods
# comment: Functions and methods ordered by number of lines, optionally limited to a dotted prefix. A rough guide to where complexity lives.
# topic: architecture
# param: prefix | only symbols whose dotted identifier starts with this | starlayer.graph | optional
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?symbol ?lines ?file ?line WHERE {
  VALUES ?prefix { UNDEF }
  ?f a ?type ;
     dcterms:identifier ?symbol ;
     slkg:filePath ?file ;
     slkg:lineStart ?line ;
     slkg:lineEnd ?end .
  FILTER(?type IN (slkg:Function, slkg:Method))
  FILTER(STRSTARTS(?file, "packages/starlayer/starlayer/"))
  FILTER(!BOUND(?prefix) || STRSTARTS(?symbol, ?prefix))
  BIND(?end - ?line + 1 AS ?lines)
}
ORDER BY DESC(?lines) ?symbol
