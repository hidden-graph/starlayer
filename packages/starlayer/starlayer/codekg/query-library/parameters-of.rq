# name: parameters-of
# label: Parameters of a function or method
# comment: Each parameter's position, name, kind, type annotation and default value.
# topic: navigation
# answers: What are a function/method's parameters
# param: symbol | dotted identifier of a function or method | starlayer.graph.graph.starlayer_graph.StarLayerGraph.infer | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?position ?name ?kind ?annotation ?default WHERE {
  ?f dcterms:identifier ?symbol ;
     slkg:hasParameter ?p .
  ?p rdfs:label ?name .
  OPTIONAL { ?p slkg:position ?position }
  OPTIONAL { ?p slkg:parameterKind ?kind }
  OPTIONAL { ?p slkg:annotationText ?annotation }
  OPTIONAL { ?p slkg:defaultValue ?default }
}
ORDER BY ?position
