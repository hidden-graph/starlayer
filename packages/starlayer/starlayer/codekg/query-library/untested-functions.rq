# name: untested-functions
# label: Functions no test calls directly
# comment: Public functions and methods with no direct call from any test, optionally limited to a dotted prefix. A function exercised only through another function shows up here too, so treat it as a lead.
# topic: testing
# answers: Which functions have zero test coverage
# param: prefix | only symbols whose dotted identifier starts with this | starlayer.shacl | optional
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?symbol ?file ?line WHERE {
  VALUES ?prefix { UNDEF }
  ?f a ?type ;
     dcterms:identifier ?symbol ;
     slkg:filePath ?file .
  FILTER(?type IN (slkg:Function, slkg:Method))
  FILTER(STRSTARTS(?file, "packages/starlayer/starlayer/"))
  FILTER(!BOUND(?prefix) || STRSTARTS(?symbol, ?prefix))
  FILTER NOT EXISTS { ?f slkg:isPrivate true }
  FILTER NOT EXISTS {
    ?t slkg:calls ?f ;
       slkg:filePath ?testFile .
    FILTER(STRSTARTS(?testFile, "packages/starlayer/tests/"))
  }
  OPTIONAL { ?f slkg:lineStart ?line }
}
ORDER BY ?symbol
