# name: module-imports
# label: What external modules does a module import?
# comment: The third-party and standard-library modules a module imports at its top level. Imports of other starlayer modules are not recorded in the graph (the extractor only extracts external imports), so use callers-of and callees-of for dependencies inside the project.
# topic: architecture
# answers: What does a given module import
# param: symbol | dotted identifier of a module | starlayer.sparql.srl | required
PREFIX slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?imported WHERE {
  ?m dcterms:identifier ?symbol ;
     slkg:importsModule ?i .
  BIND(REPLACE(STR(?i), "^.*#", "") AS ?imported)
}
ORDER BY ?imported
