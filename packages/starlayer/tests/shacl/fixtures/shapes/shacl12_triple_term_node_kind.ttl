@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <http://example.org/> .

# sh:TripleTerm as a list-valued sh:nodeKind member - constrains a value to
# be a genuine RDF 1.2 triple term, e.g. the object of rdf:reifies.

ex:ReifiesTripleTermShape a sh:NodeShape ;
  sh:targetSubjectsOf rdf:reifies ;
  sh:property [
    sh:path rdf:reifies ;
    sh:nodeKind ( sh:TripleTerm ) ;
  ] .
