@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Mirrors the SHACL 1.2 Core spec's own example for
# sh:reifierShape / sh:reificationRequired.

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:property ex:PersonShape-age .
ex:PersonShape-age a sh:PropertyShape ;
  sh:path ex:age ;
  sh:datatype xsd:integer ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:reifierShape ex:ProvenanceShape ;
  sh:reificationRequired true .

ex:ProvenanceShape a sh:NodeShape ;
  sh:property ex:ProvenanceShape-date ;
  sh:property ex:ProvenanceShape-author .
ex:ProvenanceShape-date a sh:PropertyShape ;
  sh:path ex:date ;
  sh:datatype xsd:date ;
  sh:minCount 1 ;
  sh:maxCount 1 .
ex:ProvenanceShape-author a sh:PropertyShape ;
  sh:path ex:author ;
  sh:nodeKind sh:IRI ;
  sh:minCount 1 ;
  sh:maxCount 1 .
