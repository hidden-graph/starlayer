@prefix manch: <https://github.com/hidden-graph/starlayer/ns/graph/manchester-ast#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Every property described as "ordered" holds its children as plain parent-property-child triples with a tree:ord ordinal on the child (a blank node
# child carries it itself; an IRI or literal sits in a tree:Item, tree:value): see starontology/tree/. No rdf:List is used in this vocabulary;
# an empty sequence is an absent property.

manch:And rdfs:comment "`C1 and C2 and ...` - manch:operands, ordered, >=2 ClassExpression." ;
    rdfs:subClassOf manch:ClassExpression .

manch:Annotation a rdfs:Class ;
    rdfs:comment "One (annotationProperty, value) pair - manch:annotationProperty (a URIRef), manch:annotationTarget (a URIRef or Literal). Used both for a frame-level Annotations: clause's own items, and inside a ClauseItem's/Fact's manch:annotations list. May itself carry manch:annotations: the annotations on this annotation (annotationAnnotatedList)." .

manch:AnnotationPropertyAnnotationsClause rdfs:comment "AnnotationProperty: Annotations: - same shape as ClassAnnotationsClause." ;
    rdfs:subClassOf manch:Clause .

manch:AnnotationPropertyDomainClause rdfs:comment "AnnotationProperty: Domain: - items' manch:value is a bare URIRef." ;
    rdfs:subClassOf manch:Clause .

manch:AnnotationPropertyFrame rdfs:comment "AnnotationProperty: <name>." ;
    rdfs:subClassOf manch:Frame .

manch:AnnotationPropertyRangeClause rdfs:comment "AnnotationProperty: Range: - items' manch:value is a bare URIRef." ;
    rdfs:subClassOf manch:Clause .

manch:AnnotationPropertySubPropertyOfClause rdfs:comment "AnnotationProperty: SubPropertyOf: - items' manch:value is a bare URIRef." ;
    rdfs:subClassOf manch:Clause .

manch:ClassAnnotationsClause rdfs:comment "Class: Annotations: - manch:items, ordered bare Annotation (no ClauseItem wrapper, no per-item annotations slot - a frame-level Annotations: clause is never itself annotated)." ;
    rdfs:subClassOf manch:Clause .

manch:ClassDisjointUnionOfClause rdfs:comment "DisjointUnionOf: - a single-axiom clause: manch:items holds exactly one ClauseItem, which has no manch:value but holds >=2 ClassExpression as ordered manch:values (the whole comma list is one axiom, annotated once - see manchester_parser.py's own DisjointUnionOf: handling)." ;
    rdfs:subClassOf manch:Clause .

manch:ClassDisjointWithClause rdfs:comment "Class: DisjointWith: - same item shape as ClassSubClassOfClause." ;
    rdfs:subClassOf manch:Clause .

manch:ClassEquivalentToClause rdfs:comment "Class: EquivalentTo: - same item shape as ClassSubClassOfClause." ;
    rdfs:subClassOf manch:Clause .

manch:ClassExpression rdfs:comment "An OWL class-expression AST node (manchester_parser.py's own And/Or/Not/OneOf/Some/Only/Value/Self/Min/Max/Exactly tags) - an atomic class is a bare URIRef, no wrapper." .

manch:ClassFrame rdfs:comment "Class: <name>." ;
    rdfs:subClassOf manch:Frame .

manch:ClassHasKeyClause rdfs:comment "HasKey: - single-axiom, same shape as ClassDisjointUnionOfClause but its manch:values are PropertyExpression." ;
    rdfs:subClassOf manch:Clause .

manch:ClassSubClassOfClause rdfs:comment "SubClassOf:/SuperClassOf: - manch:items, ordered ClauseItem whose manch:value is a ClassExpression. See manch:reversed for how the two keywords are told apart." ;
    rdfs:subClassOf manch:Clause .

manch:Clause rdfs:comment "One clause body inside a frame - manch:items, an ordered sequence whose member shape depends on the concrete clause type (see each subclass's own comment). SuperClassOf:/SuperPropertyOf: fold into the same clause class as their SubClassOf:/SubPropertyOf: counterpart (same manch:items shape either way) - but unlike other spelling variants, this pair is not cosmetic: it flips which side of the compiled rdfs:subClassOf/subPropertyOf triple the frame's own subject lands on, so the optional manch:reversed boolean (see its own comment) is what actually distinguishes the two on decode, not the keyword." .

manch:ClauseItem a rdfs:Class ;
    rdfs:comment "One ordinary clause-list item - manch:value (shape depends on the enclosing clause, see each Clause subclass's own comment), manch:annotations (optional, ordered Annotation - present only when the item had an inline Annotations: prefix). Deliberately one uniform shape for every per-item-annotatable clause, regardless of whether the OWL 2 RDF mapping ultimately reifies it via owl:Axiom or (for a negative Fact:) attaches directly to an owl:NegativePropertyAssertion bnode - that distinction is an artifact of the final OWL-semantic compile step, not something that exists yet at this AST layer." .

manch:DataAnd rdfs:comment "`D1 and D2 and ...` - manch:operands, ordered, >=2 DataRange." ;
    rdfs:subClassOf manch:DataRange .

manch:DataExactly rdfs:comment "`d exactly n D` - same shape as DataMin." ;
    rdfs:subClassOf manch:ClassExpression .

manch:DataMax rdfs:comment "`d max n D` - same shape as DataMin." ;
    rdfs:subClassOf manch:ClassExpression .

manch:DataMin rdfs:comment "`d min n D` - QUALIFIED data cardinality (the unqualified form stays manch:Min, it has no filler to tell data from object): manch:onProperty, manch:cardinality, manch:filler (a DataRange, required)." ;
    rdfs:subClassOf manch:ClassExpression .

manch:DataNot rdfs:comment "`not D` - manch:operand, a single DataRange." ;
    rdfs:subClassOf manch:DataRange .

manch:DataOneOf rdfs:comment "`{ lit1, lit2, ... }` - manch:literals, ordered Literal." ;
    rdfs:subClassOf manch:DataRange .

manch:DataOnly rdfs:comment "`d only D` - data-property counterpart of manch:Only; manch:filler is a DataRange." ;
    rdfs:subClassOf manch:ClassExpression .

manch:DataOr rdfs:comment "`D1 or D2 or ...` - same shape as DataAnd." ;
    rdfs:subClassOf manch:DataRange .

manch:DataPropertyAnnotationsClause rdfs:comment "DataProperty: Annotations: - same shape as ClassAnnotationsClause." ;
    rdfs:subClassOf manch:Clause .

manch:DataPropertyCharacteristicsClause rdfs:comment "DataProperty: Characteristics: - same item shape as ObjectPropertyCharacteristicsClause (only Functional is legal here, but the AST/ontology doesn't restrict which characteristic keyword)." ;
    rdfs:subClassOf manch:Clause .

manch:DataPropertyDisjointWithClause rdfs:comment "DataProperty: DisjointWith: - same item shape as DataPropertySubPropertyOfClause." ;
    rdfs:subClassOf manch:Clause .

manch:DataPropertyDomainClause rdfs:comment "DataProperty: Domain: - items' manch:value is a ClassExpression." ;
    rdfs:subClassOf manch:Clause .

manch:DataPropertyEquivalentToClause rdfs:comment "DataProperty: EquivalentTo: - same item shape as DataPropertySubPropertyOfClause." ;
    rdfs:subClassOf manch:Clause .

manch:DataPropertyFrame rdfs:comment "DataProperty: <name>." ;
    rdfs:subClassOf manch:Frame .

manch:DataPropertyRangeClause rdfs:comment "DataProperty: Range: - items' manch:value is a DataRange, not a ClassExpression (genuinely distinct shape from ObjectPropertyRangeClause)." ;
    rdfs:subClassOf manch:Clause .

manch:DataPropertySubPropertyOfClause rdfs:comment "DataProperty SubPropertyOf:/SuperPropertyOf: - items' manch:value is a PropertyExpression (same grammar as the object-property case; the parser doesn't restrict `inverse` away from data properties even though it's semantically meaningless there - a deliberate parser permissiveness, not enforced by this AST either, matching manchester_parser.py's own documented declaration-order-strictness stance). See manch:reversed for how the two keywords are told apart." ;
    rdfs:subClassOf manch:Clause .

manch:DataRange rdfs:comment "A data-range AST node (DataProperty: Range:, Datatype: EquivalentTo:) - an atomic datatype is a bare URIRef, no wrapper." .

manch:DataSome rdfs:comment "`d some D` - a Some restriction on a DATA property: manch:onProperty, manch:filler (a DataRange, not a ClassExpression). Distinct from manch:Some because the OWL mapping differs (rdfs:Datatype fillers, owl:onDataRange for the qualified forms) and Manchester syntax itself does not mark the difference - the parser decides from the property's declaration or the filler's shape." ;
    rdfs:subClassOf manch:ClassExpression .

manch:DatatypeAnnotationsClause rdfs:comment "Datatype: Annotations: - same shape as ClassAnnotationsClause." ;
    rdfs:subClassOf manch:Clause .

manch:DatatypeEquivalentToClause rdfs:comment "Datatype: EquivalentTo: - items' manch:value is a DataRange." ;
    rdfs:subClassOf manch:Clause .

manch:DatatypeFrame rdfs:comment "Datatype: <name>." ;
    rdfs:subClassOf manch:Frame .

manch:DatatypeRestriction rdfs:comment "`datatype[facet lit, ...]` - manch:datatype (a URIRef), manch:facets (ordered manch:FacetRestriction)." ;
    rdfs:subClassOf manch:DataRange .

manch:Exactly rdfs:comment "`p exactly n` / `p exactly n C` - same shape as Min." ;
    rdfs:subClassOf manch:ClassExpression .

manch:FacetRestriction a rdfs:Class ;
    rdfs:comment "One (facet, literal) pair inside a DatatypeRestriction - manch:facet (the xsd: facet URIRef, e.g. xsd:minInclusive), manch:restrictionValue (the Literal)." .

manch:Fact a rdfs:Class ;
    rdfs:comment "One Individual: Facts: item - manch:negative (an xsd:boolean Literal), manch:property (a URIRef), manch:value (a URIRef or Literal), manch:annotations (optional, same shape as ClauseItem's)." .

manch:Frame rdfs:comment "A top-level Manchester frame (Class:/ObjectProperty:/DataProperty:/AnnotationProperty:/Individual:/Datatype:) - manch:subject (the frame's own name), manch:clauses (ordered Clause, in written order)." .

manch:IndividualAnnotationsClause rdfs:comment "Individual: Annotations: - same shape as ClassAnnotationsClause." ;
    rdfs:subClassOf manch:Clause .

manch:IndividualDifferentFromClause rdfs:comment "DifferentFrom: - same item shape as IndividualSameAsClause." ;
    rdfs:subClassOf manch:Clause .

manch:IndividualFactsClause rdfs:comment "Individual: Facts: - manch:items is ordered manch:Fact (not plain ClauseItem - a fact is itself a (negative, property, value) triple, not a bare expression; see manch:Fact)." ;
    rdfs:subClassOf manch:Clause .

manch:IndividualFrame rdfs:comment "Individual: <name>." ;
    rdfs:subClassOf manch:Frame .

manch:IndividualSameAsClause rdfs:comment "SameAs: - items' manch:value is a bare individual URIRef." ;
    rdfs:subClassOf manch:Clause .

manch:IndividualTypesClause rdfs:comment "Individual: Types: - items' manch:value is a ClassExpression." ;
    rdfs:subClassOf manch:Clause .

manch:Inverse rdfs:comment "`inverse p` - manch:operand, the wrapped property URIRef." ;
    rdfs:subClassOf manch:PropertyExpression .

manch:Max rdfs:comment "`p max n` / `p max n C` - same shape as Min." ;
    rdfs:subClassOf manch:ClassExpression .

manch:Min rdfs:comment "`p min n` / `p min n C` (qualified) - manch:onProperty, manch:cardinality (an xsd:nonNegativeInteger Literal), manch:filler (a ClassExpression, absent for the unqualified form - same tag either way, per manchester_parser.py's own AST, not two separate constructs)." ;
    rdfs:subClassOf manch:ClassExpression .

manch:MiscAxiom rdfs:comment "A top-level Misc axiom (no subject frame) - manch:items, an ordered sequence whose member shape depends on the concrete axiom (see each subclass), and optionally manch:annotations: the axiom's own leading `Annotations:`, one list for the whole axiom (the note's misc production), never per item." .

manch:MiscDifferentIndividualsAxiom rdfs:comment "DifferentIndividuals: - same item shape as MiscSameIndividualAxiom." ;
    rdfs:subClassOf manch:MiscAxiom .

manch:MiscDisjointClassesAxiom rdfs:comment "DisjointClasses: - same item shape as MiscEquivalentClassesAxiom." ;
    rdfs:subClassOf manch:MiscAxiom .

manch:MiscDisjointPropertiesAxiom rdfs:comment "DisjointProperties: - same item shape as MiscEquivalentPropertiesAxiom." ;
    rdfs:subClassOf manch:MiscAxiom .

manch:MiscEquivalentClassesAxiom rdfs:comment "EquivalentClasses: - manch:items ordered ClassExpression." ;
    rdfs:subClassOf manch:MiscAxiom .

manch:MiscEquivalentPropertiesAxiom rdfs:comment "EquivalentProperties: - manch:items ordered PropertyExpression." ;
    rdfs:subClassOf manch:MiscAxiom .

manch:MiscSameIndividualAxiom rdfs:comment "SameIndividual: - manch:items ordered bare individual URIRef." ;
    rdfs:subClassOf manch:MiscAxiom .

manch:Not rdfs:comment "`not C` - manch:operand, a single ClassExpression." ;
    rdfs:subClassOf manch:ClassExpression .

manch:ObjectPropertyAnnotationsClause rdfs:comment "ObjectProperty: Annotations: - same shape as ClassAnnotationsClause." ;
    rdfs:subClassOf manch:Clause .

manch:ObjectPropertyCharacteristicsClause rdfs:comment "Characteristics: - items' manch:value is a URIRef (owl:FunctionalProperty etc, the resolved characteristic, not the bare keyword)." ;
    rdfs:subClassOf manch:Clause .

manch:ObjectPropertyDisjointWithClause rdfs:comment "ObjectProperty: DisjointWith: - same item shape as ObjectPropertySubPropertyOfClause." ;
    rdfs:subClassOf manch:Clause .

manch:ObjectPropertyDomainClause rdfs:comment "ObjectProperty: Domain: - items' manch:value is a ClassExpression." ;
    rdfs:subClassOf manch:Clause .

manch:ObjectPropertyEquivalentToClause rdfs:comment "ObjectProperty: EquivalentTo: - same item shape as ObjectPropertySubPropertyOfClause." ;
    rdfs:subClassOf manch:Clause .

manch:ObjectPropertyFrame rdfs:comment "ObjectProperty: <name>." ;
    rdfs:subClassOf manch:Frame .

manch:ObjectPropertyInverseOfClause rdfs:comment "InverseOf: (object property only) - same item shape as ObjectPropertySubPropertyOfClause." ;
    rdfs:subClassOf manch:Clause .

manch:ObjectPropertyRangeClause rdfs:comment "ObjectProperty: Range: - items' manch:value is a ClassExpression (contrast DataPropertyRangeClause)." ;
    rdfs:subClassOf manch:Clause .

manch:ObjectPropertySubPropertyChainClause rdfs:comment "SubPropertyChain: (object property only) - single-axiom, manch:items holds exactly one ClauseItem which holds PropertyExpression as ordered manch:values, in chain order (`p1 o p2 o p3`)." ;
    rdfs:subClassOf manch:Clause .

manch:ObjectPropertySubPropertyOfClause rdfs:comment "SubPropertyOf:/SuperPropertyOf: - items' manch:value is a PropertyExpression. See manch:reversed for how the two keywords are told apart." ;
    rdfs:subClassOf manch:Clause .

manch:OneOf rdfs:comment "`{ ind1, ind2, ... }` - manch:individuals, ordered URIRef." ;
    rdfs:subClassOf manch:ClassExpression .

manch:Only rdfs:comment "`p only C` - same shape as Some." ;
    rdfs:subClassOf manch:ClassExpression .

manch:OntologyDocument a rdfs:Class ;
    rdfs:comment "The root of one parsed Manchester document." .

manch:OntologyHeader a rdfs:Class ;
    rdfs:comment "The Ontology: header - manch:ontologyIRI (optional URIRef), manch:versionIRI (optional URIRef, only with an ontologyIRI), manch:imports (ordered URIRef, in order), manch:annotations (optional ordered Annotation - the ontology's own Annotations:)." .

manch:Or rdfs:comment "`C1 or C2 or ...` - manch:operands, same shape as And." ;
    rdfs:subClassOf manch:ClassExpression .

manch:PlainString a rdfs:Datatype ;
    rdfs:comment "Reserved datatype tag for a bare Python string that must round-trip distinctly from a genuine RDF string literal (rdflib.Literal('x') == 'x' is False, and the two hash differently) - used only for manch:prefixName, the one place this vocabulary carries a bare Python str rather than an already-real URIRef/Literal/int (cardinalities, facet literals, individual/data values, and Characteristics: values are all already real terms - see ontology/__init__.py's own module docstring)." .

manch:PrefixDeclaration a rdfs:Class ;
    rdfs:comment "One Prefix: declaration - manch:prefixName (a manch:PlainString-tagged string, '' for the default prefix), manch:namespace (a plain string, not a URIRef - a Prefix: declaration's own IRI is definitional, not a reference)." .

manch:PropertyExpression rdfs:comment "A property-expression AST node - a plain property is a bare URIRef, no wrapper; manch:Inverse is the only wrapped form." .

manch:Self rdfs:comment "`p Self` - manch:onProperty only." ;
    rdfs:subClassOf manch:ClassExpression .

manch:Some rdfs:comment "`p some C` - manch:onProperty (a PropertyExpression), manch:filler (a ClassExpression)." ;
    rdfs:subClassOf manch:ClassExpression .

manch:Value rdfs:comment "`p value v` - manch:onProperty, manch:filler (an individual URIRef or a data Literal - `value` accepts either)." ;
    rdfs:subClassOf manch:ClassExpression .

manch:annotationProperty a rdf:Property ;
    rdfs:comment "Domain safe: leaf class." ;
    rdfs:domain manch:Annotation .

manch:annotationTarget a rdf:Property ;
    rdfs:comment "Domain safe: leaf class." ;
    rdfs:domain manch:Annotation .

manch:annotations a rdf:Property ;
    rdfs:comment "A ClauseItem's, Fact's or OntologyHeader's own optional ordered Annotation - present only when an Annotations: was written there. No rdfs:domain: shared across leaf classes with no other common superclass." .

manch:cardinality a rdf:Property ;
    rdfs:comment "Min/Max/Exactly's own xsd:nonNegativeInteger cardinality Literal. No rdfs:domain - three sibling leaf classes, kept undeclared for the same consistency reasoning as manch:onProperty." .

manch:clauses a rdf:Property ;
    rdfs:comment "The frame's own ordered Clause, in written order. Domain safe, same reasoning as manch:subject." ;
    rdfs:domain manch:Frame .

manch:datatype a rdf:Property ;
    rdfs:comment "DatatypeRestriction's own base datatype URIRef. Domain safe: leaf class." ;
    rdfs:domain manch:DatatypeRestriction .

manch:facet a rdf:Property ;
    rdfs:comment "The facet's own xsd: URIRef (xsd:minInclusive etc). Domain safe: leaf class." ;
    rdfs:domain manch:FacetRestriction .

manch:facets a rdf:Property ;
    rdfs:comment "DatatypeRestriction's own ordered FacetRestriction. Domain safe: leaf class." ;
    rdfs:domain manch:DatatypeRestriction .

manch:filler a rdf:Property ;
    rdfs:comment "Some/Only/Value/Min/Max/Exactly's own filler (absent on Min/Max/Exactly's unqualified form). No rdfs:domain: its own value is independently sh:class-dispatch-checked (a ClassExpression, or for Value a plain URIRef/Literal, not always dispatch-checked at all) - declaring range would risk pre-satisfying that check for the ClassExpression-valued uses." .

manch:frames a rdf:Property ;
    rdfs:comment "OntologyDocument's own ordered Frame, in written order." ;
    rdfs:domain manch:OntologyDocument .

manch:header a rdf:Property ;
    rdfs:comment "OntologyDocument's own Ontology: header - range safe here: nothing dispatch-checks manch:OntologyHeader via sh:class (it's a leaf, no subclasses)." ;
    rdfs:domain manch:OntologyDocument ;
    rdfs:range manch:OntologyHeader .

manch:imports a rdf:Property ;
    rdfs:comment "The header's own ordered Import: URIRef, in order." ;
    rdfs:domain manch:OntologyHeader .

manch:individuals a rdf:Property ;
    rdfs:comment "OneOf's own ordered individual URIRef. Domain safe: manch:OneOf is a leaf ClassExpression subclass, not itself a dispatch superclass." ;
    rdfs:domain manch:OneOf .

manch:items a rdf:Property ;
    rdfs:comment "A Clause's or MiscAxiom's own ordered items - member shape depends on the concrete (sub)class, see each one's own comment. No rdfs:domain: shared across manch:Clause and manch:MiscAxiom, two unrelated dispatch families." .

manch:literals a rdf:Property ;
    rdfs:comment "DataOneOf's own ordered Literal. Domain safe: leaf class." ;
    rdfs:domain manch:DataOneOf .

manch:misc a rdf:Property ;
    rdfs:comment "OntologyDocument's own ordered MiscAxiom, in written order." ;
    rdfs:domain manch:OntologyDocument .

manch:namespace a rdf:Property ;
    rdfs:comment "The declaration's own IRI text, as a plain string Literal (not a URIRef - this is the definition of the prefix mapping itself, not a reference resolved through it)." ;
    rdfs:domain manch:PrefixDeclaration .

manch:negative a rdf:Property ;
    rdfs:comment "Whether this is a negative fact (`not prop value`). Domain safe: leaf class." ;
    rdfs:domain manch:Fact .

manch:onProperty a rdf:Property ;
    rdfs:comment "Some/Only/Value/Self/Min/Max/Exactly's own property expression. No rdfs:domain (shared across 7 sibling leaf classes, no other common superclass but manch:ClassExpression itself - declaring it would be technically harmless here since all 7 truly are ClassExpression subclasses, but left undeclared for consistency with manch:filler below, which cannot safely declare it)." .

manch:ontologyIRI a rdf:Property ;
    rdfs:comment "The optional Ontology: <iri> - absent for a bare `Ontology:` header." ;
    rdfs:domain manch:OntologyHeader .

manch:operand a rdf:Property ;
    rdfs:comment "Not/DataNot/Inverse's own single operand. No rdfs:domain - shared across three unrelated dispatch families (ClassExpression/DataRange/PropertyExpression), and its own value is independently sh:class-dispatch-checked depending on which clause it's reached through." .

manch:operands a rdf:Property ;
    rdfs:comment "And/Or/DataAnd/DataOr's own ordered >=2 operands. No rdfs:domain - shared across manch:ClassExpression and manch:DataRange subclasses, two unrelated dispatch families." .

manch:prefixName a rdf:Property ;
    rdfs:comment "The bare prefix label ('' for the default prefix) - a manch:PlainString-tagged Literal, not a plain string literal (see manch:PlainString's own comment)." ;
    rdfs:domain manch:PrefixDeclaration .

manch:prefixes a rdf:Property ;
    rdfs:comment "OntologyDocument's own ordered PrefixDeclaration, in written order." ;
    rdfs:domain manch:OntologyDocument .

manch:property a rdf:Property ;
    rdfs:comment "The fact's own property URIRef. Domain safe: leaf class - manch:Fact is the only class using this exact property name (deliberately distinct from manch:onProperty above, which is used elsewhere)." ;
    rdfs:domain manch:Fact .

manch:restrictionValue a rdf:Property ;
    rdfs:comment "The facet's own Literal value. Domain safe: leaf class." ;
    rdfs:domain manch:FacetRestriction .

manch:reversed a rdf:Property ;
    rdfs:comment "Present (true) only on a ClassSubClassOfClause/ObjectPropertySubPropertyOfClause/DataPropertySubPropertyOfClause instance that was originally written as SuperClassOf:/SuperPropertyOf: rather than SubClassOf:/SubPropertyOf: - absent (not just false) otherwise. This is load-bearing, not spelling trivia: SuperClassOf:/SuperPropertyOf: compiles to the OPPOSITE rdfs:subClassOf/subPropertyOf triple direction from its Sub* counterpart (the frame's own subject ends up as the *object*, not the subject, of the relation), and manch:items alone can't distinguish the two cases (same item shape either way) - so without this flag, decoding a Super* clause and re-rendering it as Sub* would silently reverse the compiled OWL semantics. Domain safe: only ever asserted on a manch:Clause instance." ;
    rdfs:domain manch:Clause ;
    rdfs:range xsd:boolean .

manch:subject a rdf:Property ;
    rdfs:comment "The frame's own name (class/property/individual/datatype URIRef). Domain safe: used consistently across every manch:Frame subclass, no other class anywhere reuses this property name." ;
    rdfs:domain manch:Frame .

manch:value a rdf:Property ;
    rdfs:comment "A ClauseItem's own value - shape depends on the enclosing clause (a ClassExpression, PropertyExpression, DataRange, or bare URIRef/Literal). No rdfs:domain/range: deliberately polymorphic by design (see manch:ClauseItem's own comment), and several of its possible shapes are independently sh:class-dispatch-checked." .

manch:values a rdf:Property ;
    rdfs:comment "The members of a single-axiom clause's one ClauseItem (DisjointUnionOf:, HasKey:, SubPropertyChain:), ordered with tree:ord, in written order. Used instead of manch:value, which held a nested list before the ordinals; a ClauseItem has manch:value or manch:values, never both." ;
    rdfs:domain manch:ClauseItem .

manch:versionIRI a rdf:Property ;
    rdfs:comment "The optional version IRI that follows the ontology IRI in `Ontology: <iri> <versionIRI>`." ;
    rdfs:domain manch:OntologyHeader .
