@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <http://example.org/> .

# Scalar sh:nodeKind sh:TripleTerm form - should be accepted the same way
# as the singleton-list form ( sh:TripleTerm ).

ex:ReifiesTripleTermShapeScalar a sh:NodeShape ;
  sh:targetSubjectsOf rdf:reifies ;
  sh:property [
    sh:path rdf:reifies ;
    sh:nodeKind sh:TripleTerm ;
  ] .
