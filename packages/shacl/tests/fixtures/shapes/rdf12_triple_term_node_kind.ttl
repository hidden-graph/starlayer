@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix stsh: <https://github.com/hidden-graph/starshacl/ns#> .

ex:TripleTermNodeKindShape a sh:NodeShape ;
  sh:targetNode ex:focus ;
  sh:property [
    sh:path ex:says ;
    sh:nodeKind stsh:TripleTermNodeKind ;
  ] .
