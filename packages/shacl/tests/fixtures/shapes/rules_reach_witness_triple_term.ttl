@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .

ex:ReachWitnessShape a sh:NodeShape ;
  sh:targetSubjectsOf ex:reach ;
  sh:rule [
    a sh:SPARQLRule ;
    sh:construct """
      PREFIX ex: <http://example.org/>
      PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
      CONSTRUCT {
        $this ex:reach ?z .
        $this ex:reachWitness <<( $this ex:reach ?z )>> .
      }
      WHERE {
        $this ex:reach ?y .
        ?y ex:reach ?z .
      }
    """ ;
  ] .
