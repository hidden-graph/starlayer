	rdfs:isDefinedBy <https://www.w3.org/TR/shacl12-ui/> ;
	rdfs:comment "annotation passes through inertly — not an implemented starshacl feature; see Scope note above"@en ;
	stsh:requiredEngine stsh:StarShacl .

