@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skshp: <https://github.com/hidden-graph/starlayergraph/ns/skos-shapes#> .

# SHACL shapes checking the W3C SKOS Reference's own numbered "Documented
# Consistency and Integrity Conditions" (https://www.w3.org/TR/skos-reference/
# - `# S<n>` comments cite the exact condition each shape enforces). Scoped
# to those normative conditions only - not SkoHub/vocabulary-specific best
# practices (e.g. "a Concept should have a prefLabel", "no orphan concepts") -
# those are recommendations, not integrity conditions the spec itself states
# a conforming SKOS graph must satisfy.
#
# SHACL Core wherever Core can express the condition - sh:sparql is reserved
# for what Core genuinely can't do (same discipline as manch:/salg:'s own
# shapes). Every shape below turns out to be expressible in Core alone: class
# disjointness via sh:not+sh:class, property disjointness via sh:disjoint,
# domain/range via sh:targetSubjectsOf/sh:targetObjectsOf+sh:class.
#
# Deliberately out of scope (a real, documented gap, not an oversight): S32-
# S35's skos:memberList/skos:member consistency (an rdf:List-walk, the same
# class of check as manch:WellFormedListShape - a genuinely separate, more
# involved check than the "is this graph even coherent" conditions below).
#
# Validated with NO inference and NO ont_graph (see skos_shapes.py) -
# deliberately, unlike manch:/salg:. skos-ontology.ttl faithfully restates
# the real spec's S19/S20 rdfs:domain/range axioms on skos:semanticRelation,
# but if that ontology were fed into an inference="rdfs" validation pass the
# way manch:/salg: feed theirs in, RDFS would auto-entail exactly the
# skos:Concept type the SemanticRelationDomainRangeShape below exists to
# check for - silently making that shape tautological (confirmed empirically
# while building this: a deliberately-non-Concept subject of skos:broader
# stopped failing the moment ont_graph+inference were added). So every shape
# here is self-sufficient against the bare data graph: no sh:class dispatch
# over an abstract superclass reached only via rdfs:subClassOf, hence the
# three disjointness shapes below list skos:OrderedCollection explicitly
# alongside skos:Collection rather than relying on S29's subClassOf edge to
# be entailed first.

# ---------------------------------------------------------------------
# Class disjointness (S9, S37)
# ---------------------------------------------------------------------

skshp:ConceptDisjointnessShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:not [ sh:class skos:ConceptScheme ] ; # S9
    sh:not [ sh:class skos:Collection ] ; # S37
    sh:not [ sh:class skos:OrderedCollection ] ; # S37 (via S29's subClassOf, listed explicitly - see module comment)
    sh:message "S9/S37: skos:Concept is disjoint with skos:ConceptScheme and skos:Collection." .

skshp:ConceptSchemeDisjointnessShape a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    sh:not [ sh:class skos:Concept ] ; # S9
    sh:not [ sh:class skos:Collection ] ; # S37
    sh:not [ sh:class skos:OrderedCollection ] ; # S37 (via S29's subClassOf, listed explicitly - see module comment)
    sh:message "S9/S37: skos:ConceptScheme is disjoint with skos:Concept and skos:Collection." .

skshp:CollectionDisjointnessShape a sh:NodeShape ;
    sh:targetClass skos:Collection, skos:OrderedCollection ;
    sh:not [ sh:class skos:Concept ] ; # S37
    sh:not [ sh:class skos:ConceptScheme ] ; # S37
    sh:message "S37: skos:Collection is disjoint with skos:Concept and skos:ConceptScheme." .

# ---------------------------------------------------------------------
# Lexical labels (S13, S14)
# ---------------------------------------------------------------------

skshp:LexicalLabelShape a sh:NodeShape ;
    sh:targetSubjectsOf skos:prefLabel, skos:altLabel, skos:hiddenLabel ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:disjoint skos:altLabel, skos:hiddenLabel ; # S13
        sh:datatype rdf:langString ;
        sh:uniqueLang true ; # S14
        sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint. S14: no more than one skos:prefLabel per language tag." ;
    ] ;
    sh:property [
        sh:path skos:altLabel ;
        sh:disjoint skos:prefLabel, skos:hiddenLabel ; # S13
        sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint." ;
    ] ;
    sh:property [
        sh:path skos:hiddenLabel ;
        sh:disjoint skos:prefLabel, skos:altLabel ; # S13
        sh:message "S13: skos:prefLabel/altLabel/hiddenLabel must be pairwise disjoint." ;
    ] .

# ---------------------------------------------------------------------
# Semantic relations (S19, S20, S27)
# ---------------------------------------------------------------------

skshp:SemanticRelationDomainRangeShape a sh:NodeShape ;
    sh:targetSubjectsOf skos:semanticRelation, skos:broader, skos:narrower,
        skos:broaderTransitive, skos:narrowerTransitive, skos:related ;
    sh:targetObjectsOf skos:semanticRelation, skos:broader, skos:narrower,
        skos:broaderTransitive, skos:narrowerTransitive, skos:related ;
    sh:class skos:Concept ; # S19, S20
    sh:message "S19/S20: the domain and range of every SKOS semantic relation is skos:Concept." .

skshp:RelatedDisjointWithHierarchicalShape a sh:NodeShape ;
    sh:targetSubjectsOf skos:related ;
    sh:property [
        sh:path skos:related ;
        sh:disjoint skos:broader, skos:narrower, skos:broaderTransitive, skos:narrowerTransitive ; # S27
        sh:message "S27: skos:related is disjoint with skos:broader(Transitive)/skos:narrower(Transitive)." ;
    ] .

# ---------------------------------------------------------------------
# Mapping properties (S46)
# ---------------------------------------------------------------------

skshp:MappingRelationDisjointnessShape a sh:NodeShape ;
    sh:targetSubjectsOf skos:exactMatch ;
    sh:property [
        sh:path skos:exactMatch ;
        sh:disjoint skos:broadMatch, skos:narrowMatch, skos:relatedMatch ; # S46
        sh:message "S46: skos:exactMatch is disjoint with skos:broadMatch, skos:narrowMatch, and skos:relatedMatch." ;
    ] .
