predicate position, neither of which matches the ``p == RDF.type`` /
``isinstance(p, URIRef)`` checks that trigger rewriting on a second
pass.""" ;
        rdfs:label "rewrite_algebra_for_rdfs" ;
        ns2:declares ns70:rewrite_algebra_for_rdfs._visit ;
        ns2:filePath "packages/starlayer/starlayer/sparql/entailment_rdfs.py" ;
        ns2:hasParameter ns70:rewrite_algebra_for_rdfs.param.algebra ;
        ns2:hasReturnValue ns70:rewrite_algebra_for_rdfs.returns ;
        ns2:lineEnd 214 ;
        ns2:lineStart 180 ;
        ns2:signature "def rewrite_algebra_for_rdfs(algebra: Any) -> Any" .

    ns70:rewrite_algebra_for_rdfs._visit dcterms:identifier "starlayer.sparql.entailment_rdfs.rewrite_algebra_for_rdfs._visit" ;
        a ns2:Function ;
        rdfs:label "_visit" ;
        ns2:calls ns70:_rewrite_bgp, ns70:rewrite_algebra_for_rdfs ;
