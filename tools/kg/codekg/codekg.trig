        ns2:hasReturnValue ns40:_run_hermit_subprocess.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 125 ;
        ns2:lineStart 88 ;
        ns2:signature "def _run_hermit_subprocess(owl_path: str, result_path: str, queue) -> None" .

