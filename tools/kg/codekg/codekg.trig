        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns99:referenced_shapes.returns a ns2:ReturnValue ;
        ns2:annotationText "set[Any]" ;
        ns2:hasType ns5:typing.Any, ns5:builtins.set .

    ns99:shapes_graph_members dcterms:identifier "starlayer.shacl.shapes_graphs.shapes_graph_members" ;
        a ns2:Function ;
        rdfs:comment """The elements that belong to ``shapes_graph`` by ``rdfs:member``, ``rdfs:isDefinedBy`` or ``owl:imports`` (see the module
docstring): every kind of element, not only shapes (a property group or a constraint component says ``rdfs:isDefinedBy`` too).

