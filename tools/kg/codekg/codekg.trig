    ns32:StarLayerGraph._native_add_many dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph._native_add_many" ;
        a ns2:Method ;
        rdfs:comment """Write every ``(s, p, obj)`` in ``triples`` to this graph in a
single SPARQL Update request, rather than one ``_native_add()`` HTTP
call per triple.

Real, unskolemized blank-node syntax is used here (unlike the
single-triple ``add()`` -> ``_native_add()`` path) - safe
specifically *because* every triple goes out together in one
request, so SPARQL 1.1 Update's per-request blank-node scoping (the
whole reason ``skolemize_bnode()`` exists - see its docstring) never
comes into play: a blank node repeated across these triples keeps
its real identity for free, and Oxigraph's own engine still
recognizes it as a genuine blank node (correct ``ORDER BY`` term-kind
position, ``isBLANK()``) rather than the URI ``skolemize_bnode()``
would otherwise turn it into.

Used by ``parse()``/``addN()`` for a single ``StarLayerGraph``,
where every triple is known up front and destined for this one
graph. Not used by ``StarLayerDataset.parse()``'s own per-context
loop: a blank node there may be shared *across* different named-graph
contexts (data-4.trig's ``_:b``, referenced from both ``:g1`` and
``:g2``), each its own separate ``StarLayerGraph``/HTTP request -
only ``skolemize_bnode()`` keeps that case safe, so that path still
goes through ``add()`` one triple at a time.""" ;
        rdfs:label "_native_add_many" ;
        ns2:calls ns25:blank_node_ids_are_stable, ns32:StarLayerGraph._native_scoped, ns25:execute_update, ns25:sparql_term, ns32:StarLayerGraph._on_mutated ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        ns2:hasParameter ns32:StarLayerGraph._native_add_many.param.skolemize_bnodes, ns32:StarLayerGraph._native_add_many.param.triples ;
        ns2:hasReturnValue ns32:StarLayerGraph._native_add_many.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 713 ;
        ns2:lineStart 644 ;
        ns2:signature "def _native_add_many(self, triples, *, skolemize_bnodes: bool | None=None) -> None" .

    ns32:StarLayerGraph._native_add_many.param.skolemize_bnodes a ns2:Parameter ;
        rdfs:comment "``None`` (default) decides from the store: skolemize only on an engine whose blank-node ids are not stable across queries (``blank_node_ids_are_stable()``), where a real blank node could never be referred to again. Write blank nodes as their stable skolem URIs, exactly like ``add()`` does, instead of as real blank nodes. Real blank nodes get engine-assigned ids, so a ``BNode`` object that existed *before* the write (a label from some other graph, a variable the caller still holds) no longer names the stored node afterwards; skolemizing keeps the original label addressable, at the cost of the stored node not being a true blank node to ``isBLANK()``/``ORDER BY``. Use it when copying a graph whose existing ``BNode`` labels must keep working; leave it off for ``parse()``-style loads." ;
        rdfs:label "skolemize_bnodes" ;
        ns2:annotationText "bool | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:builtins.bool ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns32:StarLayerGraph._native_add_many.param.triples a ns2:Parameter ;
        rdfs:comment "The ``(s, p, obj)`` triples to write." ;
        rdfs:label "triples" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns32:StarLayerGraph._native_add_many.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

