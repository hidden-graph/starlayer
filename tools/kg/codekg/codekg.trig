GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/model/encoding.py> {
    ns59:encoding.py dcterms:identifier "starlayer.graph.model.encoding" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.model.encoding

Shared constants and hash function for the starlayer.graph internal graph encoding.

Triple terms    → content-addressed URIRefs under TT_NS (same content = same URI),
                  each typed ``rdf:PropositionForm`` and described by
                  ``rdf:propositionFormSubject/Predicate/Object`` - the vocabulary
                  of the RDF 1.2 Interoperability "basic encoding". Only the node
                  *name* differs from the spec (a stable content hash instead of a
                  fresh blank node); see to_basic()/from_basic() for the conversion.
                  Reads find triple terms by that type, not by the name.
Anon reifiers   → ordinary BNodes (each {| |} block is distinct); no internal
                  skolemization scheme of their own - see
                  starlayer.graph.parsers.turtle_parser._skolemize_encoding
                  for why a previous rr:N sequential-URIRef scheme was
                  replaced with this
DirLangString   → a Literal whose datatype URI under DIRLANG_NS packs the real
                  language tag and base direction (see decode_dirlang_datatype)""" ;
        rdfs:label "encoding" ;
        ns2:declares ns34:_reencode_tt, ns34:tt_hash, ns34:lookup_tt_hash, ns34:inject_missing_tt_encoding, ns34:_canonicalize_numeric_literal, ns34:encoding_triples, ns34:decode_dirlang_datatype, ns34:term_key, ns34:restore_select_bindings, ns34:remember_tt_hash, ns34:canonicalize_query_result_value, ns34:encode_dirlang_datatype ;
        ns2:filePath "packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:importsModule ns5:collections.abc, ns5:hashlib, ns5:rdflib.namespace, ns5:__future__, ns5:typing, ns5:rdflib.term, ns5:rdflib.query, ns5:rdflib, ns5:collections .

    ns34:_canonicalize_numeric_literal dcterms:identifier "starlayer.graph.model.encoding._canonicalize_numeric_literal" ;
        a ns2:Function ;
        rdfs:comment """Reformat a decimal/double/float-typed Literal's lexical form to its
XSD canonical form. A no-op for anything already canonical, or for any
other datatype.

decimal: canonical form requires a decimal point with at least one
digit on each side (e.g. "42.0", not "42").
double/float: reformats through Python's own float parsing/repr, which
- for the ordinary (non-extreme-magnitude) range this is actually used
for in practice - already produces XSD's own "at least one digit each
side of a required decimal point" convention (e.g. "123e0" -> "123.0",
"1.5E2" -> "150.0"); not a full implementation of XSD 1.1's exact
canonical-form algorithm for every possible magnitude (e.g. very
large/small values render with Python's "1e+30"-style exponent rather
than XSD's "1.0E30"), which is a level of fidelity nothing in this
codebase currently needs.""" ;
        rdfs:label "_canonicalize_numeric_literal" ;
        ns2:filePath "packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns34:_canonicalize_numeric_literal.param.literal ;
        ns2:hasReturnValue ns34:_canonicalize_numeric_literal.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 288 ;
        ns2:lineStart 237 ;
        ns2:signature "def _canonicalize_numeric_literal(literal: Literal) -> Literal" .

    ns34:_canonicalize_numeric_literal.param.literal a ns2:Parameter ;
        rdfs:comment "The Literal to canonicalize." ;
        rdfs:label "literal" ;
        ns2:annotationText "Literal" ;
        ns2:hasType ns5:rdflib.term.Literal ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns34:_canonicalize_numeric_literal.returns a ns2:ReturnValue ;
        rdfs:comment "A Literal with the same datatype and a canonicalized lexical form, or the original object unchanged if it was already canonical or not one of the canonicalizable numeric datatypes." ;
        ns2:annotationText "Literal" ;
        ns2:hasType ns5:rdflib.term.Literal .

    ns34:_reencode_tt dcterms:identifier "starlayer.graph.model.encoding._reencode_tt" ;
        a ns2:Function ;
        rdfs:comment """Emit tt's rdf:subject/predicate/object encoding triples into
out_graph (recursively for any nested TripleTerm component) and return
its content-addressed URI - the write-side mirror of
StarLayerGraph._intern_tt(), but writing to an arbitrary graph rather
than `self`, and given an already-fully-resolved TripleTerm (no nested
tt:HASH URIRefs left to look up) rather than one that might still
contain them. See inject_missing_tt_encoding()'s docstring for why this
exists.""" ;
        rdfs:label "_reencode_tt" ;
        ns2:calls ns34:encoding_triples, ns34:_reencode_tt, ns34:tt_hash, ns34:term_key ;
        ns2:filePath "packages/starlayer/starlayer/graph/model/encoding.py" ;
        ns2:hasParameter ns34:_reencode_tt.param.tt, ns34:_reencode_tt.param.out_graph ;
        ns2:hasReturnValue ns34:_reencode_tt.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 391 ;
        ns2:lineStart 368 ;
        ns2:signature "def _reencode_tt(tt: TripleTerm, out_graph: Graph) -> URIRef" .

    ns34:_reencode_tt.param.out_graph a ns2:Parameter ;
        rdfs:comment "The graph to add the encoding triples to." ;
        rdfs:label "out_graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns5:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns34:_reencode_tt.param.tt a ns2:Parameter ;
        rdfs:comment "The triple term to encode, fully resolved - no unresolved nested tt:HASH URIRefs." ;
        rdfs:label "tt" ;
        ns2:annotationText "TripleTerm" ;
        ns2:hasType ns5:starlayer.graph.model.triple.TripleTerm ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns34:_reencode_tt.returns a ns2:ReturnValue ;
        rdfs:comment "The tt:HASH URIRef naming tt." ;
        ns2:annotationText "URIRef" ;
        ns2:hasType ns5:rdflib.term.URIRef .

    ns34:canonicalize_query_result_value dcterms:identifier "starlayer.graph.model.encoding.canonicalize_query_result_value" ;
