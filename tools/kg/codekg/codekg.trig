        ns2:hasReturnValue ns34:inject_missing_tt_encoding.returns ;
        ns2:lineEnd 433 ;
        ns2:lineStart 394 ;
        ns2:signature "def inject_missing_tt_encoding(graph: Graph, restore_fn: Callable[[Any], Any]) -> None" .

    ns34:inject_missing_tt_encoding.param.graph a ns2:Parameter ;
