    ns85:StarShaclSchema.validate.param.shapes_graph_loader a ns2:Parameter ;
        rdfs:comment "Resolves one ``owl:imports`` target IRI to the graph it names, or ``None`` if it can't be resolved - used to follow ``shacl_graph``'s own ``owl:imports`` (optionally redirected through ``owl:versionIRI``) before validating. This library never decides retrieval policy on its own, so no loader is used unless one is given." ;
        rdfs:label "shapes_graph_loader" ;
