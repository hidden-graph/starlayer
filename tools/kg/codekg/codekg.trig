        ns2:optional true .

    ns73:_dataset dcterms:identifier "starlayer.graph.query.update_patches._dataset" ;
        a ns2:Function ;
        rdfs:comment "The dataset being updated, or None when the target is a plain graph (which has only a default graph)." ;
        rdfs:label "_dataset" ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/update_patches.py" ;
        ns2:hasParameter ns73:_dataset.param.ctx ;
