    ns107:parse_ruleset dcterms:identifier "starlayer.sparql.srl.parse_ruleset" ;
        a ns2:Function ;
        rdfs:comment """Parse SRL rule-set text into a real ``RuleSet``, with no RDF
involved at all.

Two-pass, matching rdflib's own ``parseQuery``/``translateQuery`` split:
parse raw (leaving prefixed names unresolved), build a real ``Prologue``
from the parsed ``BASE``/``PREFIX`` decls and resolve every prefixed/
relative name against it in one tree pass, then convert the resolved
tree into real ``srl_ast`` dataclasses.

A successfully-returned ``RuleSet`` is also guaranteed §4.2 well-formed
(every filter/assignment/head variable properly bound, no ``SET(...)``
reusing an already-bound variable) - this function is the one real gate,
the same contract plain SPARQL's own ``prepareQuery()`` has. ``SRLParseError``
is raised for a §4.2 well-formedness violation too, not just a
grammar/syntax error: this is what prevents a violating ruleset from
silently parsing *and* evaluating to a wrong answer with no error at all.

By default the rule set is then also encoded as RDF and checked against
the ``srl:`` SHACL shapes (the same check as :func:`srl_validate`), and
``SRLParseError`` is raised if it does not conform. That costs on the
order of 150 ms, against a few ms for parsing alone, so a caller parsing
many rule sets that it already trusts can pass ``validate=False``.""" ;
        rdfs:label "parse_ruleset" ;
        ns2:calls ns107:_build_prologue, ns107:_resolve_pnames, ns128:_check_ruleset, ns107:_check_against_shapes, ns19:parse_serialized, ns107:_simplify_triple_term_expressions, ns107:_list_field, ns107:_build_ruleset ;
        ns2:filePath "packages/starlayer/starlayer/sparql/srl.py" ;
        ns2:hasParameter ns107:parse_ruleset.param.validate, ns107:parse_ruleset.param.base, ns107:parse_ruleset.param.text ;
        ns2:hasReturnValue ns107:parse_ruleset.returns ;
        ns2:instantiates ns107:SRLParseError ;
        ns2:lineEnd 535 ;
        ns2:lineStart 471 ;
        ns2:signature "def parse_ruleset(text: str, base: str | None=None, *, validate: bool=True) -> srl_ast.RuleSet" .

    ns107:parse_ruleset.param.base a ns2:Parameter ;
        rdfs:comment "Base IRI for resolving relative IRIs, if any." ;
        rdfs:label "base" ;
        ns2:annotationText "str | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:builtins.str ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns107:parse_ruleset.param.text a ns2:Parameter ;
        rdfs:comment "The SRL rule-set text to parse." ;
