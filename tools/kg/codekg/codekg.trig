    ns68:_repetition_pairs dcterms:identifier "starlayer.graph.query.path_patches._repetition_pairs" ;
        a ns2:Function ;
        rdfs:comment """The ``(start, end)`` pairs of ``path*``, ``path+`` or ``path?`` as rdflib's ``MulPath.eval`` yields them, found by a
breadth-first search with a visited set instead of rdflib's recursive generators. A chain of a thousand hops overflowed
Python's stack (``RecursionError``), and every result was passed up through one generator frame per hop. Same set of
pairs; the order is breadth-first, which SPARQL leaves open.""" ;
        rdfs:label "_repetition_pairs" ;
        ns2:calls ns68:_repetition_pairs.reachable ;
        ns2:declares ns68:_repetition_pairs.reachable ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/path_patches.py" ;
        ns2:hasParameter ns68:_repetition_pairs.param.graph, ns68:_repetition_pairs.param.path, ns68:_repetition_pairs.param.subj, ns68:_repetition_pairs.param.obj ;
        ns2:isPrivate true ;
        ns2:lineEnd 117 ;
        ns2:lineStart 61 ;
        ns2:signature "def _repetition_pairs(path, graph, subj, obj)" .

