GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/extractor/docstrings.py> {
    ns7:docstrings.py dcterms:identifier "starlayer.codekg.extractor.docstrings" ;
        a ns2:Module ;
        rdfs:comment """starlayer.codekg.extractor.docstrings - the Args:/Returns: hand-rolled
parser.

Implements the code-KG plan's exact docstring grammar (column-0 headers,
case-sensitive)::

    <summary prose - everything before the first "Args:"/"Returns:" line>

    Args:
        <param_name>: <description, first line>
            <continuation line, indented >= 8 spaces, optional>
        <param_name_2>: <description>

    Returns:
        <free-text description, indented >= 4 spaces, may wrap>

No third-party docstring-parsing library is a dependency (none is in
``pyproject.toml``/``uv.lock``), so this is pure stdlib ``inspect``/``re``.
One function, ``parse_docstring()`` - deliberately defensive: a malformed
or unexpected structure never raises, worst case it falls back to treating
the whole thing as summary text.""" ;
        rdfs:label "docstrings" ;
        ns2:declares ns13:_parse_args, ns13:_join_summary, ns13:_join_returns, ns13:parse_docstring, ns13:_collect_returns_lines, ns13:_parse, ns13:_is_column0_header, ns13:_find_first_header ;
        ns2:filePath "packages/starlayer/starlayer/codekg/extractor/docstrings.py" ;
        ns2:importsModule ns5:re, ns5:__future__, ns5:inspect .

    ns13:_collect_returns_lines dcterms:identifier "starlayer.codekg.extractor.docstrings._collect_returns_lines" ;
        a ns2:Function ;
        rdfs:comment """Collect the Returns: section's contributing lines starting at
`start` (the line right after the "Returns:" header). Each contributed
entry is either a stripped content line (indent >= 4 spaces) or the
empty string, marking a blank-line paragraph break. Stops at the next
column-0 non-blank line or end of the docstring. Returns the collected
lines plus the index of the first line not consumed.""" ;
        rdfs:label "_collect_returns_lines" ;
        ns2:filePath "packages/starlayer/starlayer/codekg/extractor/docstrings.py" ;
        ns2:hasParameter ns13:_collect_returns_lines.param.start, ns13:_collect_returns_lines.param.lines ;
