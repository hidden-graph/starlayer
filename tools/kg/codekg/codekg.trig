        ns2:declares ns85:_strip_deactivated_node_expressions, ns85:_graph_contains_triple_terms, ns85:_rule_declared_prefixes, ns85:_transitive_subclasses, ns85:_patch_stringify_for_native_backend_bnodes, ns85:_compute_sh_values, ns85:_resolve_literal_only_component_name, ns85:_patch_shape_value_nodes_for_sh_values, ns85:_annotate_conformance_disallows, ns85:_try_native_structural_property_validation, ns85:_try_native_literal_only_validation, ns85:_is_subclass_of_or_self, ns85:_native_fast_path_shapes_are_plain, ns85:_strip_temp_triples, ns85:validate_each, ns85:_patch_rule_apply_for_source_rule_provenance, ns85:_patch_shape_focus_nodes_for_deactivated_expression, ns85:_shacl_list_members, ns85:_drop_nonmember_property_shape_refs, ns85:StarShaclSchema, ns85:_reject_unknown_validate_options, ns85:_materialize_source_rule_provenance, ns85:_rule_set_members, ns85:apply_rules, ns85:_patch_expression_constraint_for_value_scope, ns85:_resolve_shapes_graph_imports, ns85:_inline_triple_term, ns85:_private_shapes_copy, ns85:_has_property_shape_inside_property_shape, ns85:_patch_rules_apply_for_layer_and_run_once, ns85:_is_implicit_class_shape, ns85:_materialize_expected_predicates, ns85:_rebuild_report_namespaces, ns85:_compute_sh_default_value, ns85:_global_sparql_rule_triples, ns85:_relabel_validation_report_node, ns85:_augment_shapes_with_new_target_types, ns85:_try_native_core_validation, ns85:_shape_is_deactivated, ns85:_inject_shapes_graph_subclass_triples, ns85:_annotate_used_graphs_and_configuration, ns85:_where_shape_validation_graph, ns85:_global_sparql_rules, ns85:_merge_derived_conforms_to, ns85:_sync_report_text_conforms, ns85:_RawGraphView, ns85:_run_layered_rules, ns85:_is_shacl_list, ns85:_patch_rdflib_data_graph_clone_preserves_tt_adapter, ns85:_append_provenance_to_report_text, ns85:_nodes_conforming_to, ns85:_patch_rule_apply_for_rule_set_filtering, ns85:_materialize_default_value_triples, ns85:validate, ns85:_collect_by_types_properties, ns85:_with_where_targets, ns85:_humanize_report_text, ns85:_find_genuine_report_node, ns85:_is_starlayer_graph, ns85:_shape_target_nodes, ns85:_resolve_structural_component_definition, ns85:evaluate, ns85:_ensure_native_component_shapes_typed, ns85:_patch_shape_validate_for_filter_shape, ns85:_default_validate ;
        ns2:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
