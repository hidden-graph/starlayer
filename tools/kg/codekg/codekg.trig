        ns2:filePath "packages/starlayer/starlayer/starontology/__init__.py" ;
        ns2:hasParameter ns133:get_resource_iri.param.name ;
        ns2:hasReturnValue ns133:get_resource_iri.returns ;
        ns2:lineEnd 723 ;
        ns2:lineStart 691 ;
