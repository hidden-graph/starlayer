        rdfs:label "row" ;
        ns2:annotationText "dict" ;
        ns2:hasType ns5:builtins.dict ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns114:_encode_binding_row.returns a ns2:ReturnValue ;
        rdfs:comment "The ``rdf:List`` node (or ``rdf:nil`` if ``row`` is empty) encoding this row." ;
        ns2:annotationText "BNode | URIRef" ;
        ns2:hasType ns5:rdflib.term.URIRef, ns5:rdflib.term.BNode .

    ns114:_encode_comp_value dcterms:identifier "starlayer.sparql.to_rdf._encode_comp_value" ;
        a ns2:Function ;
        rdfs:label "_encode_comp_value" ;
        ns2:calls ns114:_encode_quads_map, ns114:_encode, ns114:_comp_value_ns ;
        ns2:filePath "packages/starlayer/starlayer/sparql/to_rdf.py" ;
        ns2:hasParameter ns114:_encode_comp_value.param.graph, ns114:_encode_comp_value.param.node ;
        ns2:hasReturnValue ns114:_encode_comp_value.returns ;
        ns2:isPrivate true ;
