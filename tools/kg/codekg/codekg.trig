        ns2:lineEnd 169 ;
        ns2:lineStart 145 ;
        ns2:signature "def patch_substr_xpath_semantics() -> bool" .

    ns65:patch_substr_xpath_semantics.returns a ns2:ReturnValue ;
        ns2:annotationText "bool" ;
        ns2:hasType ns5:builtins.bool .

    ns65:patch_sum_avg_errors_are_unbound dcterms:identifier "starlayer.graph.query.builtin_error_patches.patch_sum_avg_errors_are_unbound" ;
        a ns2:Function ;
        rdfs:comment """``SUM``/``AVG`` over a non-numeric value raised out of ``query()`` (or
``AVG`` silently skipped it), losing every row of the query. SPARQL 1.1
Query 18.5 defines SUM/AVG through ``op:numeric-add``, which errors on a
non-numeric operand, and an error in an aggregate makes that one value
unbound (a ``HAVING`` condition over it then drops that group only).
Count, Min, Max, Sample and GroupConcat are unchanged.""" ;
        rdfs:label "patch_sum_avg_errors_are_unbound" ;
        ns2:calls ns65:_marked, ns65:_is_marked ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/builtin_error_patches.py" ;
