        ns2:filePath "packages/starlayer/starlayer/graph/serializers/rdfxml12.py" ;
        ns2:hasParameter ns57:serialize_rdfxml12.param.graph ;
        ns2:hasReturnValue ns57:serialize_rdfxml12.returns ;
