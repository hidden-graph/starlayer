        ns2:hasReturnValue ns6:StarLayerDataset.update.returns ;
        ns2:lineEnd 1077 ;
        ns2:lineStart 997 ;
        ns2:signature "def update(self, update_object, processor='sparql', initNs=None, initBindings=None, use_store_provided=True, **kwargs) -> None" .

