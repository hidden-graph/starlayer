        rdfs:label "obj" ;
        ns2:parameterKind "positional" ;
        ns2:position 3 .

    ns68:_repetition_pairs.param.path a ns2:Parameter ;
        rdfs:label "path" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns68:_repetition_pairs.param.subj a ns2:Parameter ;
        rdfs:label "subj" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns68:_repetition_pairs.reachable dcterms:identifier "starlayer.graph.query.path_patches._repetition_pairs.reachable" ;
        a ns2:Function ;
