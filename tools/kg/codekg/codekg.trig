    ns90:_well_formed.param.triple a ns2:Parameter ;
        rdfs:label "triple" ;
        ns2:annotationText "tuple" ;
        ns2:hasType ns5:builtins.tuple ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns90:_well_formed.returns a ns2:ReturnValue ;
        ns2:annotationText "bool" ;
        ns2:hasType ns5:builtins.bool .

