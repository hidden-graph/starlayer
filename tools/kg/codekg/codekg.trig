        rdfs:comment "Optional base IRI for relative-IRI resolution." ;
        rdfs:label "base" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 4 .

    ns72:processUpdate.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to update - a ``StarLayerGraph``/ ``StarLayerDataset`` or a plain ``rdflib.Graph``." ;
        rdfs:label "graph" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns72:processUpdate.param.initBindings a ns2:Parameter ;
        rdfs:comment "Optional initial variable bindings." ;
        rdfs:label "initBindings" ;
