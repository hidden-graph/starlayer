    ns77:TripleTermAdapter._encode_node dcterms:identifier "starlayer.shacl.adapters.TripleTermAdapter._encode_node" ;
        a ns2:Method ;
        rdfs:comment """Encode one node value for use in a flat, RDF-1.1-compatible
graph.

A plain 3-tuple is first treated as inline triple-term shorthand
(via ``term_factory``); a DirLangString-like value is encoded via
``starlayer.graph``'s own dirlang datatype encoding; anything else
that isn't triple-term-like is returned unchanged. A
triple-term-like value has its own subject/predicate/object
encoded recursively first (so a nested triple term is fully
flattened), then is registered under a content-addressed URIRef
(``<namespace><sha256 of the encoded (s, p, o) key>``) - returning
the existing URIRef if this exact (s, p, o) triple was already
registered, so the same triple term always encodes to the same
URI within this adapter's lifetime.""" ;
        rdfs:label "_encode_node" ;
        ns2:calls ns28:encode_dirlangstring, ns78:is_dirlangstring_like, ns77:TripleTermAdapter._encode_node, ns78:is_triple_term_like ;
        ns2:filePath "packages/starlayer/starlayer/shacl/adapters.py" ;
        ns2:hasParameter ns77:TripleTermAdapter._encode_node.param.value ;
        ns2:hasReturnValue ns77:TripleTermAdapter._encode_node.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 630 ;
        ns2:lineStart 570 ;
        ns2:signature "def _encode_node(self, value: Any) -> Any" .

