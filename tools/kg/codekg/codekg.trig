        ns2:filePath "packages/starlayer/starlayer/shacl/validator.py" ;
        ns2:hasParameter ns85:evaluate.param.inference, ns85:evaluate.param.data_graph, ns85:evaluate.param.properties, ns85:evaluate.param.shacl_graph, ns85:evaluate.param.ont_graph, ns85:evaluate.param.focus_nodes ;
        ns2:hasReturnValue ns85:evaluate.returns ;
        ns2:lineEnd 3951 ;
        ns2:lineStart 3803 ;
        ns2:signature "def evaluate(data_graph: Any, shacl_graph: Any | None=None, ont_graph: Any | None=None, *, inference: Any | None=None, focus_nodes: Any | None=None, properties: Any | None=None) -> Any" .

    ns85:evaluate.param.data_graph a ns2:Parameter ;
        rdfs:comment "The RDF data to evaluate virtual properties over." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns85:evaluate.param.focus_nodes a ns2:Parameter ;
        rdfs:comment "Restrict evaluation to these focus nodes (an iterable of nodes). ``None`` (the default) evaluates every node the shapes target; a node that is not one of a shape's targets is not evaluated for it. Only the per-node work (reading stored values and computing ``sh:values``/``sh:defaultValue``) is limited; the shapes' own targets are still resolved over ``data_graph``." ;
        rdfs:label "focus_nodes" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns85:evaluate.param.inference a ns2:Parameter ;
        rdfs:comment "A real ``ENTAILMENT.*`` IRI, or an iterable of them, merged with ``shacl_graph``'s own declared ``sh:entailment`` regime(s) and applied once, up front, onto a private, non-mutating copy of ``data_graph``. Every later step (target resolution, ``sh:values``/ ``sh:defaultValue`` computation, and what counts as a \"real, stored\" value) runs against that entailed copy. Unlike ``apply_rules()``'s \"inference graph\" exclusion, an entailed triple here is treated exactly like an asserted one and can appear in the returned subgraph - a deliberate choice, since Core's own value-nodes algorithm itself never distinguishes asserted from entailed triples." ;
        rdfs:label "inference" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns85:evaluate.param.ont_graph a ns2:Parameter ;
