        ns2:hasReturnValue ns103:_annotation_reifier_term_resolved.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 746 ;
        ns2:lineStart 722 ;
        ns2:signature "def _annotation_reifier_term_resolved(s, p, o, r) -> list" .

