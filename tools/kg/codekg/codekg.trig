    ns126:_encode_exists_hook dcterms:identifier "starlayer.sparql.sqe.to_rdf._encode_exists_hook" ;
        a ns2:Function ;
        rdfs:comment "EXISTS / NOT EXISTS gets an sqe:Exists node holding a normal where-list." ;
