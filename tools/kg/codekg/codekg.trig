GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/shacl/shapes_graphs.py> {
    ns76:shapes_graphs.py dcterms:identifier "starlayer.shacl.shapes_graphs" ;
        a ns2:Module ;
        rdfs:comment """The ``sh:ShapesGraph`` modules of a graph and what belongs to each (GitHub issue #17).

SHACL 1.2 Profiling section 2 packages shapes into ``sh:ShapesGraph`` resources. A shape (or any other element) belongs to one
in any of three ways, and all three are honored:

- ``<graph> rdfs:member <element>``: the shapes graph lists it (Profiling 2.5, also how a graph *uses* an element it does not
  define);
- ``<element> rdfs:isDefinedBy <graph>``: the element says which graph defines it (2.4);
- ``<graph> owl:imports <other>`` where ``<other>`` is itself a ``sh:ShapesGraph`` in the same graph: the other module's members
  count too, transitively (2.6). Only modules already in the graph are followed; nothing is fetched.

``StarShaclSchema.extract_shapes_graph()`` is built on these.""" ;
        rdfs:label "shapes_graphs" ;
        ns2:declares ns99:shapes_graph_members, ns99:shapes_graphs, ns99:referenced_shapes, ns99:module_nodes ;
        ns2:filePath "packages/starlayer/starlayer/shacl/shapes_graphs.py" ;
        ns2:importsModule ns5:rdflib, ns5:__future__, ns5:typing .

    ns99:module_nodes dcterms:identifier "starlayer.shacl.shapes_graphs.module_nodes" ;
        a ns2:Function ;
        rdfs:comment """``shapes_graph`` and every ``sh:ShapesGraph`` it imports, transitively, among the nodes already in ``graph``.

Raises ``ValueError`` when an ``owl:imports`` target is not typed ``sh:ShapesGraph`` in ``graph``: a shapes graph that
imports another is asserting a dependency, so a missing one is an error, not something to skip. Fetch it first with
``resolve_imports(loader=...)``.""" ;
        rdfs:label "module_nodes" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/shapes_graphs.py" ;
        ns2:hasParameter ns99:module_nodes.param.graph, ns99:module_nodes.param.shapes_graph ;
        ns2:hasReturnValue ns99:module_nodes.returns ;
        ns2:lineEnd 53 ;
        ns2:lineStart 32 ;
        ns2:signature "def module_nodes(graph: Any, shapes_graph: Any) -> set[Any]" .

    ns99:module_nodes.param.graph a ns2:Parameter ;
        rdfs:label "graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns99:module_nodes.param.shapes_graph a ns2:Parameter ;
        rdfs:label "shapes_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns99:module_nodes.returns a ns2:ReturnValue ;
        ns2:annotationText "set[Any]" ;
        ns2:hasType ns5:typing.Any, ns5:builtins.set .

    ns99:referenced_shapes dcterms:identifier "starlayer.shacl.shapes_graphs.referenced_shapes" ;
        a ns2:Function ;
        rdfs:comment """The named shapes that ``starting_points`` refer to, directly or through further shapes: what a self-contained
extract must also hold (GitHub issue #19).

Follows ``sh:node``, ``sh:property``, ``sh:not``, ``sh:qualifiedValueShape``, ``sh:reifierShape``, ``sh:someValue``,
``sh:memberShape`` and the shapes in the lists of ``sh:and``, ``sh:or`` and ``sh:xone``. Blank nodes are walked through
but not returned (they come with a shape's concise bounded description); a starting point is not part of the result.
Cycles are fine.""" ;
        rdfs:label "referenced_shapes" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/shapes_graphs.py" ;
        ns2:hasParameter ns99:referenced_shapes.param.starting_points, ns99:referenced_shapes.param.graph ;
        ns2:hasReturnValue ns99:referenced_shapes.returns ;
        ns2:lineEnd 106 ;
        ns2:lineStart 77 ;
        ns2:signature "def referenced_shapes(graph: Any, starting_points: Any) -> set[Any]" .

    ns99:referenced_shapes.param.graph a ns2:Parameter ;
        rdfs:label "graph" ;
