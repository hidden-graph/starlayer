        ns2:hasReturnValue ns15:collect_local_classes.returns ;
        ns2:lineEnd 95 ;
        ns2:lineStart 73 ;
        ns2:signature "def collect_local_classes(body: list[ast.stmt], nesting_prefix: str, local_classes: set[str], class_path_by_name: dict[str, str]) -> None" .

