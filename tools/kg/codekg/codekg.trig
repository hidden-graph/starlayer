        ns2:signature "def apply_entailment(data_graph: Any, shacl_graph: Any, ont_graph: Any | None=None, *, inplace: bool, inference: Any | None=None) -> Any" .

    ns84:apply_entailment.param.data_graph a ns2:Parameter ;
        rdfs:comment "The graph entailment is applied to. Must already be a StarLayerGraph (same precondition ``infer()`` itself enforces) - every real caller already guarantees this by the time entailment needs applying (``validate()``'s own ``normalize_graph_inputs()`` call happens first)." ;
