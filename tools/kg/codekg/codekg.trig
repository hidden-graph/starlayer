        ns2:position 0 .

    ns62:split_statements.returns a ns2:ReturnValue ;
        rdfs:comment "A list of statement strings (prefix/base/version directives and triple statements), each stripped of surrounding whitespace." .

    ns62:split_statements_with_lines dcterms:identifier "starlayer.graph.parsers.syntax.split_statements_with_lines" ;
        a ns2:Function ;
        rdfs:comment """Split Turtle text into a list of (statement, line) pairs, line being
the 1-based line number in *data* where that statement approximately
begins (statement-start granularity - see _split_statements_impl).
Raises Turtle12SyntaxError if the document ends with an unterminated
string or an unclosed bracket.""" ;
        rdfs:label "split_statements_with_lines" ;
        ns2:calls ns62:_split_statements_impl ;
