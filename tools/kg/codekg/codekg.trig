    ns73:_copy_into.param.dst a ns2:Parameter ;
        rdfs:label "dst" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns73:_copy_into.param.src a ns2:Parameter ;
        rdfs:label "src" ;
        ns2:parameterKind "positional" ;
