    ns65:patch_substr_xpath_semantics dcterms:identifier "starlayer.graph.query.builtin_error_patches.patch_substr_xpath_semantics" ;
        a ns2:Function ;
        rdfs:comment """``SUBSTR("abc", 0, 2)`` must be ``"a"`` (fn:substring keeps positions
``start <= p < start + length``); rdflib slices with the raw index so a
start below 1 gave ``""`` or a Python negative-index slice. Also makes a
non-integer position a type error, as the ``xsd:integer`` signature
requires. Replaces ``operators.Builtin_SUBSTR`` too, because the
directional-literal ``SUBSTR`` in ``custom_functions.py`` calls it.""" ;
        rdfs:label "patch_substr_xpath_semantics" ;
        ns2:calls ns65:_marked, ns65:_is_marked, ns65:_expression_comp ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/builtin_error_patches.py" ;
