        ns2:hasParameter ns35:_canonical_nquads_of.param.graph ;
        ns2:hasReturnValue ns35:_canonical_nquads_of.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 199 ;
        ns2:lineStart 196 ;
        ns2:signature "def _canonical_nquads_of(graph: Any) -> str" .

    ns35:_canonical_nquads_of.param.graph a ns2:Parameter ;
