    ns54:evaluate_recipes_locally.returns a ns2:ReturnValue ;
        rdfs:comment "`row` merged with each recipe's computed value, in evaluation order. A recipe whose dependency is unbound is left out of the result (same as evalExtend's own \"leave unbound\" behavior)." ;
        ns2:annotationText "dict" ;
