    ns32:StarLayerGraph.add dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.add" ;
        a ns2:Method ;
        rdfs:comment """Add a triple. A TripleTerm (or plain 3-tuple) in the object position is
converted to its internal encoding automatically. Always returns self,
matching rdflib's own Graph.add() and enabling method chaining
(g.add(...).add(...)).

    g.add((s, p, o))              # plain triple
    g.add((s, p, TripleTerm(...))) # TripleTerm as object
