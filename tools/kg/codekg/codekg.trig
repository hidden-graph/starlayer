GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/expr_validation.py> {
    ns102:expr_validation.py dcterms:identifier "starlayer.sparql.expr_validation" ;
        a ns2:Module ;
        rdfs:comment """The validation data for the shared expression vocabulary (``spexpr:``): its SHACL shapes graph and RDFS
ontology, ready to combine with a vocabulary's own.

``sqe:``, ``srl:`` and ``salg:`` all embed ``spexpr:`` expressions (a ``FILTER``, a ``BIND``, an ``ORDER BY``
key), and validating one needs the same two things: the shapes for every expression builtin and the RDFS
subclass axioms the ``sh:class spexpr:Expression`` dispatch relies on. They live here, in one place that imports
nothing from any of those vocabularies, so a vocabulary can validate its own trees without importing a sibling's
package. (``salg`` imports this module; ``sqe`` must not import ``salg``.)

The per-builtin shapes are generated from ``expr_families._EXPR_NODE_FAMILY`` rather than written by hand, so
they cannot drift from the table the encoder uses. This module needs rdflib and ``starontology`` only, not
pyshacl.""" ;
        rdfs:label "expr_validation" ;
        ns2:declares ns111:ontology_graph, ns111:expression_shapes_turtle, ns111:shapes_graph ;
        ns2:filePath "packages/starlayer/starlayer/sparql/expr_validation.py" ;
        ns2:importsModule ns5:rdflib, ns5:__future__ .

    ns111:expression_shapes_turtle dcterms:identifier "starlayer.sparql.expr_validation.expression_shapes_turtle" ;
        a ns2:Function ;
        rdfs:comment """The short per-expression-node-name declarations (one per real builtin), each pointing at its family's
reusable body shape (``spexpr:_<Family>ExprBodyShape``) with ``sh:node``.

Targets ``spexpr:``: both the target class and the body shape live in the shared expression vocabulary, and
a node typed ``spexpr:Name`` would never match a ``sh:targetClass salg:Name`` shape. Carries its own
``@prefix spexpr:`` line, so it is self-contained whatever it gets concatenated with.""" ;
        rdfs:label "expression_shapes_turtle" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/expr_validation.py" ;
        ns2:hasReturnValue ns111:expression_shapes_turtle.returns ;
        ns2:lineEnd 44 ;
        ns2:lineStart 24 ;
        ns2:signature "def expression_shapes_turtle() -> str" .

    ns111:expression_shapes_turtle.returns a ns2:ReturnValue ;
        rdfs:comment "The generated Turtle declarations, newline-terminated, with their own leading ``@prefix`` line." ;
        ns2:annotationText "str" ;
        ns2:hasType ns5:builtins.str .

    ns111:ontology_graph dcterms:identifier "starlayer.sparql.expr_validation.ontology_graph" ;
        a ns2:Function ;
        rdfs:comment """A fresh graph of the ``spexpr:`` RDFS ontology (the subclass axioms behind ``sh:class spexpr:Expression``
and the variable and path classes).""" ;
        rdfs:label "ontology_graph" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/expr_validation.py" ;
        ns2:hasReturnValue ns111:ontology_graph.returns ;
        ns2:lineEnd 59 ;
        ns2:lineStart 56 ;
        ns2:signature "def ontology_graph() -> Graph" .

    ns111:ontology_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns5:rdflib.graph.Graph .

    ns111:shapes_graph dcterms:identifier "starlayer.sparql.expr_validation.shapes_graph" ;
        a ns2:Function ;
        rdfs:comment """A fresh graph of the ``spexpr:`` shapes: the stored ``spexpr_shacl`` plus the generated per-builtin
shapes. Callers get their own copy, because pyshacl mutates a shapes graph while validating.""" ;
        rdfs:label "shapes_graph" ;
        ns2:calls ns111:expression_shapes_turtle ;
        ns2:filePath "packages/starlayer/starlayer/sparql/expr_validation.py" ;
        ns2:hasReturnValue ns111:shapes_graph.returns ;
        ns2:lineEnd 53 ;
        ns2:lineStart 47 ;
        ns2:signature "def shapes_graph() -> Graph" .

    ns111:shapes_graph.returns a ns2:ReturnValue ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns5:rdflib.graph.Graph .

    ns5:__future__ a ns2:ExternalModule .

    ns5:builtins.str dcterms:identifier "builtins.str" ;
        a ns2:ExternalType ;
        rdfs:label "str" ;
        rdfs:subClassOf ns2:Type .

    ns5:rdflib a ns2:ExternalModule .

    ns5:rdflib.graph.Graph dcterms:identifier "rdflib.graph.Graph" ;
        a ns2:ExternalType ;
        rdfs:label "Graph" ;
        rdfs:subClassOf ns2:Type .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/sparql/from_ast_rdf.py> {
    ns102:from_ast_rdf.py dcterms:identifier "starlayer.sparql.from_ast_rdf" ;
        a ns2:Module ;
        rdfs:comment """Decode ``sast:`` RDF back into a real, executable rdflib ``Query`` — the
mirror of ``to_ast_rdf.py``, feeding the reconstructed parse tree straight
into rdflib's own, completely unmodified ``translateQuery`` (the same
function ``parse12.prepare_query_12`` calls on a fresh parse).

Confirmed empirically that ``translateQuery``/``translatePrologue`` only
ever read ``q[0]``/``q[1]`` by indexing/iteration and write ``q[1] = ...``
by item assignment — a plain Python ``list`` supports all of that, so the
decoded tree never needs to reconstruct real ``pyparsing.ParseResults``
objects, just plain ``list``s standing in for them. This also matches
CLAUDE.md finding #11: rdflib's own tree-walking (``_traverse``/
``_traverseAgg``) is already generic over ``CompValue``/``list``/``tuple``/
``ParseResults`` — nothing that follows in the pipeline cares which of
those a bare sequence actually is.""" ;
        rdfs:label "from_ast_rdf" ;
        ns2:declares ns112:_decode, ns112:_comp_value_type, ns112:_decode_comp_value, ns112:rdf_ast_to_query ;
        ns2:filePath "packages/starlayer/starlayer/sparql/from_ast_rdf.py" ;
        ns2:importsModule ns5:rdflib.plugins.sparql.sparql, ns5:rdflib.plugins.sparql.algebra, ns5:rdflib.collection, ns5:rdflib.plugins.sparql.parserutils, ns5:rdflib.namespace, ns5:rdflib, ns5:__future__, ns5:typing .

