GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/query/path_patches.py> {
    ns63:path_patches.py dcterms:identifier "starlayer.graph.query.path_patches" ;
        a ns2:Module ;
        rdfs:comment """Fix for rdflib's grammar of a negated property set with an inverse member (``!(^:p)``, ``!(:p|^:q)``).

rdflib's grammar writes ``Comp("InversePath", "^" + (iri | A))``: the IRI after ``^`` is not a named parameter, so the
parsed node is an empty ``InversePath_{}`` and the IRI is lost. ``translatePath`` has no case for that name either, so
evaluation and every renderer crash (``TypeError: 'NoneType' object is not callable``, GitHub issue #77). The node is
rebuilt as ``PathEltOrInverse`` with a named ``part``, which ``translatePath`` already turns into an ``InvPath``;
``NegatedPath.eval`` (see ``evaluate_patches``) handles an ``InvPath`` member.

The grammar object is mutated in place, once, before any query is parsed. Idempotent, like the other patches.""" ;
        rdfs:label "path_patches" ;
        ns2:declares ns68:patch_negated_set_inverse_member, ns68:patch_repetition_paths_are_distinct, ns68:_repetition_pairs, ns68:_NodesWithoutEncoding ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/path_patches.py" ;
        ns2:importsModule ns5:__future__ .

    ns68:_NodesWithoutEncoding dcterms:identifier "starlayer.graph.query.path_patches._NodesWithoutEncoding" ;
        a ns2:Class ;
        rdfs:comment """A read-only view of a graph whose ``subject_objects()`` leaves out the triple-term encoding triples (the
``tt:`` node typed ``rdf:PropositionForm`` and its ``rdf:propositionForm*`` components), so the node set a
zero-length path enumerates is the subjects and objects of the real triples. Every other call is passed through.""" ;
        rdfs:label "_NodesWithoutEncoding" ;
        ns2:declares ns68:_NodesWithoutEncoding.__init__, ns68:_NodesWithoutEncoding.subject_objects, ns68:_NodesWithoutEncoding.__getattr__ ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/path_patches.py" ;
        ns2:isPrivate true ;
