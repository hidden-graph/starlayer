        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns35:_decompose_quads._term.param.node a ns2:Parameter ;
        rdfs:label "node" ;
