        a ns2:Function ;
        rdfs:comment """Render a real algebra expression node as text.

Wraps ``expr`` in a throwaway query and reuses rdflib's own
``translateAlgebra``, then slices out the ``FILTER(...)`` contents —
see this module's docstring for why. Public (not module-private) since
``srl.py`` reuses it directly too — SRL's own ``filter.expr``/
``assign.expr`` are the same real rdflib ``Expr`` trees, no RDF
round-trip needed to call this. See :func:`_simplify_expr_immutable`
for why the expression is simplified via a fresh, non-mutating rebuild
rather than rdflib's own (in-place-mutating) ``operators.simplify``.""" ;
        rdfs:label "_render_expr_text" ;
        ns2:calls ns127:_simplify_expr_immutable, ns110:render_expression ;
        ns2:filePath "packages/starlayer/starlayer/sparql/ssyn_to_text.py" ;
        ns2:hasParameter ns127:_render_expr_text.param.expr ;
        ns2:hasReturnValue ns127:_render_expr_text.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 268 ;
        ns2:lineStart 221 ;
        ns2:signature "def _render_expr_text(expr) -> str" .

    ns127:_render_expr_text.param.expr a ns2:Parameter ;
        rdfs:comment "An ``Expr``/``CompValue`` expression tree." ;
        rdfs:label "expr" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns127:_render_expr_text.returns a ns2:ReturnValue ;
        rdfs:comment "The expression's SPARQL text." ;
