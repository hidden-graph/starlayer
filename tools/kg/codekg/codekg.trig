        ns2:calls ns19:_canonicalize_construct_where, ns105:_reject_triple_term_pattern_subjects, ns19:parse_query_12 ;
        ns2:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:hasParameter ns19:prepare_query_12.param.text, ns19:prepare_query_12.param.base, ns19:prepare_query_12.param.initNs ;
        ns2:hasReturnValue ns19:prepare_query_12.returns ;
        ns2:lineEnd 187 ;
        ns2:lineStart 153 ;
        ns2:signature "def prepare_query_12(text: str, base: str | None=None, initNs: Mapping[str, Any] | None=None) -> Query" .

