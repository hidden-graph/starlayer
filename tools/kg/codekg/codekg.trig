        rdfs:comment "The rdflib SPARQL algebra expression node to scan." ;
        rdfs:label "expr" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns66:_expr_free_vars.returns a ns2:ReturnValue ;
        rdfs:comment "The set of ``Variable`` instances found anywhere in expr's tree." ;
        ns2:annotationText "set" ;
        ns2:hasType ns5:builtins.set .

