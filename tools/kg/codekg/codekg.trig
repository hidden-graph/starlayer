    ns26:_canonicalize_decimal_lexical_form dcterms:identifier "starlayer.graph.query.operator_patches._canonicalize_decimal_lexical_form" ;
        a ns2:Function ;
        rdfs:comment """XSD decimal's canonical lexical form requires a decimal point with
at least one digit on each side (e.g. ``"42.0"``, not ``"42"``) - but
rdflib's own CEIL/FLOOR/ROUND/division construct a whole-number decimal
result via a Python ``int``/exact ``Decimal``, whose default string form
omits the trailing ``.0``.""" ;
