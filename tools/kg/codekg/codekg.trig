    ns32:StarLayerGraph.derive_shape dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.derive_shape" ;
        a ns2:Method ;
        rdfs:comment """Infer a SHACL shape from self's own data and return it.

One ``sh:NodeShape`` per distinct ``rdf:type`` found (the simplest
option: derive shapes from classes, never per-node or heuristic
clustering), optionally reconciled against an existing template
shape.

Every returned shape is closed (``sh:closed true``) and is
self-checked to conform against self before being returned (a real
assertion, not just documentation - see ``shape_derivation.py``).
Goes through ``starlayer.shacl`` for all SHACL semantics, never bare
``pyshacl`` directly - self or template_shape may contain genuine
RDF 1.2 content (triple terms) that only starlayer.shacl understands.""" ;
        rdfs:label "derive_shape" ;
        ns2:calls ns44:derive_shape, ns32:StarLayerGraph.from_rdflib ;
        ns2:filePath "packages/starlayer/starlayer/graph/graph/starlayer_graph.py" ;
        ns2:hasParameter ns32:StarLayerGraph.derive_shape.param.template_shape, ns32:StarLayerGraph.derive_shape.param.ignored_properties, ns32:StarLayerGraph.derive_shape.param.use_default_ignored_properties ;
        ns2:hasReturnValue ns32:StarLayerGraph.derive_shape.returns ;
        ns2:lineEnd 3903 ;
        ns2:lineStart 3840 ;
        ns2:signature "def derive_shape(self, template_shape=None, *, ignored_properties=None, use_default_ignored_properties: bool=True) -> StarLayerGraph" .

    ns32:StarLayerGraph.derive_shape.param.ignored_properties a ns2:Parameter ;
        rdfs:comment "Extra predicates to exclude from every derived ``sh:NodeShape``'s candidate-property scan (union'd into ``sh:ignoredProperties``, alongside the resolved default list below and, unconditionally, ``rdf:type`` itself - required for any closed shape to conform, since ``sh:closed`` doesn't exempt ``rdf:type`` automatically). A template's own existing ``sh:ignoredProperties`` is always carried forward too." ;
        rdfs:label "ignored_properties" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns32:StarLayerGraph.derive_shape.param.template_shape a ns2:Parameter ;
        rdfs:comment "If omitted, every returned NodeShape is built fresh from self's own data. If given (any Graph, including a StarLayerGraph with genuine RDF 1.2 content), its own constraints are validated against self and, wherever a principled data-driven fix exists (cardinality, datatype, class, node kind including ``sh:TripleTerm``, numeric-range bounds, string length, ``sh:languageIn``, additive ``sh:in`` widening), recomputed from the *true* current data rather than patched around a single violating value; constraint types with no generic fix (``sh:pattern``, cross-property comparisons like ``sh:equals``/ ``sh:lessThan``) are dropped with an ``rdfs:comment`` note; opaque ``sh:sparql``-based/custom constraint components are left untouched, also with a note, since there's no way to know whether a failure there is a real data problem or a genuinely important check. Any predicate observed in self with no matching ``sh:property`` on the relevant shape, and any class present in self with no shape at all, get freshly-derived additions - \"extend any new properties\" generalized to the whole graph." ;
        rdfs:label "template_shape" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns32:StarLayerGraph.derive_shape.param.use_default_ignored_properties a ns2:Parameter ;
        rdfs:comment "When true (default), also excludes ``shape_derivation.DEFAULT_IGNORED_PROPERTIES`` (``rdfs:label``/``comment``, ``dcterms:created``/ ``modified``) - pass False to opt out of that built-in list entirely and rely only on ``ignored_properties=``." ;
        rdfs:label "use_default_ignored_properties" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "True" ;
        ns2:hasType ns5:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 2 .

    ns32:StarLayerGraph.derive_shape.returns a ns2:ReturnValue ;
        rdfs:comment "A StarLayerGraph (a real, standalone shapes graph) - wrapped via ``from_rdflib()`` for consistency with every other graph-returning method on this class, even though a derived shapes graph has no triple-term content of its own today." ;
        ns2:annotationText "StarLayerGraph" ;
        ns2:hasType ns32:StarLayerGraph .

    ns32:StarLayerGraph.empty_like dcterms:identifier "starlayer.graph.graph.starlayer_graph.StarLayerGraph.empty_like" ;
        a ns2:Method ;
        rdfs:comment """A new, empty graph of the same kind as this one, with the same
namespace bindings.

The rule for graphs derived from this one (``infer()``'s default
result, a native ``query()``'s CONSTRUCT result): they are created
*like their source*. A graph backed by an in-process Oxigraph yields a
fresh, independent in-process Oxigraph with the same representation;
any other kind - the default in-memory store, a remote endpoint (a new
remote database can't be minted), SQLAlchemy - yields an ordinary
in-memory ``StarLayerGraph``. Nothing global is consulted: the source
graph itself carries the choice, so internal scratch graphs elsewhere
are unaffected.""" ;
        rdfs:label "empty_like" ;
