``StarLayerGraph.query()`` otherwise takes per call - run it against as
many graphs as you like via :meth:`run`.""" ;
        rdfs:label "StarQuery" ;
        ns2:declares ns129:StarQuery.__init__, ns129:StarQuery.run ;
        ns2:filePath "packages/starlayer/starlayer/sparql/star_query.py" ;
        ns2:lineEnd 155 ;
        ns2:lineStart 62 .

