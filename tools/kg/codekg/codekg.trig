        rdfs:comment "The working data graph to add each reifier to." ;
        rdfs:label "out_data" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns85:_materialize_source_rule_provenance.param.records a ns2:Parameter ;
        rdfs:comment "``(triple, rule_node)`` pairs - one per triple that some rule's ``apply()`` call produced, paired with the node identifying the rule that produced it." ;
        rdfs:label "records" ;
