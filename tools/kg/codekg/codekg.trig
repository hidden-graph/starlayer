    ns102:parse12.py dcterms:identifier "starlayer.sparql.parse12" ;
        a ns2:Module ;
        rdfs:comment """Public entry points for ingesting SPARQL 1.2 (triple-term) query/update
text into a genuine, post-``translateQuery``/``translateUpdate`` algebra
tree — see ``grammar12.py`` for how ``<<( s p o )>>``/``TRIPLE(s, p, o)``
syntax is made parseable at all, and ``triple_term.py`` for why the
resulting node has to be a ``TripleTermNode``, not a bare ``CompValue``.

Because the grammar extension (``grammar12.install()``) constructs a
``TripleTermNode`` directly inside its parse action, the parse tree these
functions produce never contains a plain ``CompValue('TripleTerm', ...)`` to
promote after the fact — ``translateQuery``/``translateUpdate`` can be
called on it immediately, completely unmodified.""" ;
        rdfs:label "parse12" ;
        ns2:declares ns19:_reject_blank_nodes_shared_between_operations, ns19:_fresh_blank_nodes_in_insert_data, ns19:_parse_with_recovery, ns19:_check_no_variables, ns19:_check_no_blank_nodes, ns19:_canonicalize_construct_where, ns19:_terms_inside, ns19:prepare_query_12, ns19:parse_serialized, ns19:_blank_nodes_of, ns19:_reject_blank_nodes_in_delete, ns19:parse_update_12, ns19:_relabel, ns19:parse_query_12, ns19:prepare_update_12 ;
        ns2:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:importsModule ns5:rdflib.plugins.sparql.parserutils, ns5:collections.abc, ns5:rdflib.plugins.sparql.parser, ns5:rdflib.plugins.sparql.sparql, ns5:rdflib.plugins.sparql.algebra, ns5:re, ns5:__future__, ns5:typing, ns5:pyparsing.exceptions, ns5:threading, ns5:rdflib .

