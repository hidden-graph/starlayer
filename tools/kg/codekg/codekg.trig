GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/shacl/profiling.py> {
    ns76:profiling.py dcterms:identifier "starlayer.shacl.profiling" ;
        a ns2:Module ;
        rdfs:comment """Support for SHACL 1.2 Profiling (https://www.w3.org/TR/shacl12-profiling/).

docs/shacl12-gap-matrix.md's Profiling row and "Not Covered / Deferred"
table investigated this document to the same depth as the other five
SHACL 1.2 documents and concluded no *mandatory* validator runtime
behavior is missing: S2's packaging conventions (sh:ShapesGraph/
sh:DataGraph grouping, rdfs:isDefinedBy/rdfs:member, owl:imports) are
SHOULD-level organizational metadata with no defined effect on
validation, and S3/S4 (declaring/using SHACL feature profiles) describe
how other specs and tooling use SHACL, not processor behavior.

That still leaves two genuinely useful, spec-shaped things an
implementation *can* do that this module provides:

1. ``declared_conformance_profile()`` - starlayer.shacl's own self-declaration
   (S3, "Profiles of SHACL") of which named SHACL 1.2 feature profiles it
   implements, as a small bundled RDF document
   (the starlayer.shacl resource in starontology's starlayer-profiles.ttl) using the same dx-prof
   vocabulary the spec itself uses, rather than only the prose gap matrix.
2. ``derive_conforms_to()`` - S5.5's sh:conformsTo inference rule. This is
   MAY-level (S2.8) and mechanically just an ordinary SPARQL CONSTRUCT
   rule - starlayer.shacl's own sh:SPARQLRule engine could already execute a
   rule of this exact shape - but it can never fire against a plain
   validation report graph as produced, since that report has no
   sh:usedDataGraph/sh:usedShapesGraph/sh:validationReport identity
   linking it back to caller-meaningful graph IRIs unless the caller opts
   in. ``StarShaclSchema.validate()``'s own ``data_graph_iri=``/
   ``shapes_graph_resource=`` keyword arguments (SHACL 1.2 Core S6.7.1.5-6.7.1.6,
   see ``validator.py::_annotate_used_graphs_and_configuration``) already
   add the ``sh:usedDataGraph``/``sh:usedShapesGraph`` half of that identity
   when supplied - ``derive_conforms_to()`` reads those straight off the
   report when present, so a caller who already validated with those
   kwargs doesn't have to repeat the IRIs here. The one link neither
   mechanism supplies on its own is ``sh:validationReport`` (a data-graph
   *resource* pointing at its own report) - genuinely new identity this
   function adds, since nothing else in the pipeline has a reason to.""" ;
        rdfs:label "profiling" ;
        ns2:declares ns96:_find_report_node, ns96:_bind_derived_namespaces, ns96:declared_conformance_profile, ns96:derive_conforms_to ;
        ns2:filePath "packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:importsModule ns5:__future__, ns5:typing, ns5:rdflib.namespace, ns5:rdflib .

    ns96:_bind_derived_namespaces dcterms:identifier "starlayer.shacl.profiling._bind_derived_namespaces" ;
        a ns2:Function ;
        rdfs:comment """Give ``graph`` a clean, deliberate namespace table instead of
whatever ``StarLayerGraph()``'s own bare-construction default happens
to be - same pattern (and same motivation) as ``validator.py``'s own
``_rebuild_report_namespaces()``, just scoped to what's actually
available in this module (no ``data_graph``/``shacl_graph``/
``ont_graph`` graph objects here, only IRIs - ``report_graph``/
``specification_graph`` are the only real graphs this function ever
sees).""" ;
        rdfs:label "_bind_derived_namespaces" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:hasParameter ns96:_bind_derived_namespaces.param.graph, ns96:_bind_derived_namespaces.param.sources ;
        ns2:hasReturnValue ns96:_bind_derived_namespaces.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 173 ;
        ns2:lineStart 139 ;
        ns2:signature "def _bind_derived_namespaces(graph: Any, *sources: Any) -> None" .

    ns96:_bind_derived_namespaces.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to bind namespaces onto, in place. ``sh``/``prof``/``dcterms`` (bound unconditionally first, since every triple this module derives uses at least one of them), in the order given, first-bound-wins." ;
        rdfs:label "graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns96:_bind_derived_namespaces.param.sources a ns2:Parameter ;
        rdfs:label "sources" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "vararg" .

    ns96:_bind_derived_namespaces.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

    ns96:_find_report_node dcterms:identifier "starlayer.shacl.profiling._find_report_node" ;
        a ns2:Function ;
        rdfs:label "_find_report_node" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:hasParameter ns96:_find_report_node.param.report_graph ;
        ns2:hasReturnValue ns96:_find_report_node.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 136 ;
        ns2:lineStart 133 ;
        ns2:signature "def _find_report_node(report_graph: Any) -> Any" .

    ns96:_find_report_node.param.report_graph a ns2:Parameter ;
        rdfs:label "report_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns96:_find_report_node.returns a ns2:ReturnValue ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any .

    ns96:declared_conformance_profile dcterms:identifier "starlayer.shacl.profiling.declared_conformance_profile" ;
        a ns2:Function ;
        rdfs:comment """A fresh copy of starlayer.shacl's self-declared SHACL 1.2
conformance statement (S3) - the starlayer.shacl resource in the
library's one conformance file. Parses the bundled asset fresh on every
call rather than caching - matching this project's convention
elsewhere (see starontology/__init__.py::_file_graph) of never
sharing one mutable graph object across callers.

Returns a ``StarLayerGraph``, not a plain ``rdflib.Graph`` - this is a
public, caller-facing result meant to be inspected/serialized/merged,
not internal plumbing fed straight to pySHACL.""" ;
        rdfs:label "declared_conformance_profile" ;
        ns2:filePath "packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:hasReturnValue ns96:declared_conformance_profile.returns ;
        ns2:lineEnd 130 ;
        ns2:lineStart 103 ;
        ns2:signature "def declared_conformance_profile() -> StarLayerGraph" .

    ns96:declared_conformance_profile.returns a ns2:ReturnValue ;
        rdfs:comment "A fresh StarLayerGraph containing the bundled conformance statement." ;
        ns2:annotationText "StarLayerGraph" ;
        ns2:hasType ns5:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

    ns96:derive_conforms_to dcterms:identifier "starlayer.shacl.profiling.derive_conforms_to" ;
        a ns2:Function ;
        rdfs:comment """Derive ``sh:conformsTo`` triples from a validation report, per
SHACL 1.2 Profiling S5.5.

Only conforming reports (``sh:conforms true``) produce a
``sh:conformsTo`` triple, matching the rule's own WHERE clause - a
non-conformant report derives nothing.

If ``specification_graph`` is given, the second S5.5 rule also runs
once the first has fired, additionally deriving ``dcterms:conformsTo``
triples to whatever ``shapes_graph`` is declared a profile of (the S5.5
rule), and also - StarLayer's extension - to the ``prof:Profile`` that
lists ``shapes_graph`` as a ``role:validation`` resource and to every
specification or profile that profile ``prof:isProfileOf``, however
many steps up. This is not the same relationship
``declared_conformance_profile()`` records (that one is *this
library's* own conformance to named SHACL 1.2 feature profiles, a
different resource than ``shapes_graph``) - pass a graph relating
``shapes_graph`` itself to whatever it profiles.""" ;
        rdfs:label "derive_conforms_to" ;
        ns2:calls ns96:_bind_derived_namespaces, ns96:_find_report_node ;
        ns2:filePath "packages/starlayer/starlayer/shacl/profiling.py" ;
        ns2:hasParameter ns96:derive_conforms_to.param.report_graph, ns96:derive_conforms_to.param.specification_graph, ns96:derive_conforms_to.param.shapes_graph, ns96:derive_conforms_to.param.conforms_only, ns96:derive_conforms_to.param.data_graph ;
        ns2:hasReturnValue ns96:derive_conforms_to.returns ;
        ns2:lineEnd 329 ;
        ns2:lineStart 176 ;
        ns2:signature "def derive_conforms_to(report_graph: Any, *, data_graph: str | URIRef | None=None, shapes_graph: str | URIRef | None=None, specification_graph: Any | None=None, conforms_only: bool=False) -> StarLayerGraph" .

    ns96:derive_conforms_to.param.conforms_only a ns2:Parameter ;
        rdfs:comment "If ``True``, the returned graph contains *only* the ``sh:conformsTo``/``dcterms:conformsTo`` triples themselves - not ``report_graph``, and not even the ``sh:validationReport`` link this function otherwise adds (that link exists to justify the conformance claim with a path back to the report, which ``conforms_only`` says isn't wanted) - useful when a caller only cares about the conformance claims themselves, e.g. to merge into a dataset catalog entry that has no reason to reference a SHACL validation report at all. If ``False`` (the default), the returned graph is ``report_graph`` merged with whatever got newly derived - a self-contained, immediately printable/serializable result, where the added ``sh:validationReport`` link resolves to a real, fully-described node rather than a dangling blank-node reference." ;
        rdfs:label "conforms_only" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "False" ;
        ns2:hasType ns5:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns96:derive_conforms_to.param.data_graph a ns2:Parameter ;
        rdfs:comment "The data graph as an RDF resource - an IRI or IRI-like string, using whatever identity scheme the caller's application already uses (a dataset-catalog IRI, a named-graph IRI - there is no single right default). Optional: if the report was produced by ``validate(..., data_graph_iri=..., shapes_graph_resource=...)``, the matching ``sh:usedDataGraph`` triple is already on the report and is read from there when this is omitted." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "str | URIRef | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:builtins.str, ns5:rdflib.term.URIRef ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns96:derive_conforms_to.param.report_graph a ns2:Parameter ;
        rdfs:comment "A plain SHACL validation report graph (e.g. ``ValidationResult.report_graph``). Read, never mutated." ;
        rdfs:label "report_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns96:derive_conforms_to.param.shapes_graph a ns2:Parameter ;
        rdfs:comment "The shapes graph as an RDF resource, same optionality and fallback as ``data_graph`` (read from the report's own ``sh:usedShapesGraph`` when omitted)." ;
        rdfs:label "shapes_graph" ;
        ns2:annotationText "str | URIRef | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:builtins.str, ns5:rdflib.term.URIRef ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 2 .

    ns96:derive_conforms_to.param.specification_graph a ns2:Parameter ;
        rdfs:comment "A graph relating ``shapes_graph`` to what it profiles - either ``prof:isProfileOf`` on ``shapes_graph`` itself, or a ``prof:Profile`` that lists it as a ``role:validation`` ``prof:hasResource`` artifact (e.g. ``starontology.get_conformance_profiles()``) - to additionally derive ``dcterms:conformsTo`` triples via S5.5's second rule (see above). Read, never mutated. ``None`` (the default) skips this second rule entirely." ;
        rdfs:label "specification_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns96:derive_conforms_to.returns a ns2:ReturnValue ;
        rdfs:comment "A new ``StarLayerGraph``. ``report_graph``/``specification_graph`` are read, never mutated." ;
        ns2:annotationText "StarLayerGraph" ;
        ns2:hasType ns5:starlayer.graph.graph.starlayer_graph.StarLayerGraph .

    ns5:__future__ a ns2:ExternalModule .

    ns5:builtins.bool dcterms:identifier "builtins.bool" ;
        a ns2:ExternalType ;
        rdfs:label "bool" ;
