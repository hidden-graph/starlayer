        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "varkw" .

    ns85:validate.param.meta_shapes_extra a ns2:Parameter ;
        rdfs:comment "Extra graphs passed through to ``starlayer.shacl.meta_shapes.meta_validate()`` when the resolved options enable ``meta_shacl``." ;
        rdfs:label "meta_shapes_extra" ;
        ns2:annotationText "Iterable[Any]" ;
        ns2:defaultValue "()" ;
        ns2:hasType ns5:collections.abc.Iterable, ns5:typing.Any ;
        ns2:parameterKind "kwonly" ;
        ns2:position 10 .

    ns85:validate.param.mode a ns2:Parameter ;
        rdfs:comment "Selects a named preset bundle of pySHACL options (e.g. ``\"validation\"``/``\"rules\"``/``\"debug\"``) via ``resolve_mode_options()``; any of its options can be overridden per call via ``**kwargs``." ;
        rdfs:label "mode" ;
        ns2:annotationText "str | ValidationMode | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:starlayer.shacl.validation_modes.ValidationMode, ns5:builtins.str ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 5 .

    ns85:validate.param.ont_graph a ns2:Parameter ;
        rdfs:comment "An optional ontology graph. Its own axioms (e.g. ``rdfs:domain``/``range``) are visible to entailment and to pySHACL's own validation run, but its triples are never copied into ``data_graph``, and it is never mutated." ;
        rdfs:label "ont_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns85:validate.param.rdfs_subclass_reasoning_includes_shapes_graph a ns2:Parameter ;
        rdfs:comment "When ``True``, ``sh:rootClass``'s ``rdfs:subClassOf`` lookups also consult ``shacl_graph``'s own subclass triples (injected into a copy of ``data_graph`` for the duration of the call), not just ``data_graph``'s." ;
        rdfs:label "rdfs_subclass_reasoning_includes_shapes_graph" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "False" ;
        ns2:hasType ns5:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 7 .

    ns85:validate.param.shacl_graph a ns2:Parameter ;
        rdfs:comment "The shapes graph. ``None`` lets pySHACL look for shapes embedded directly in ``data_graph`` itself (pySHACL's own \"data graph doubles as shapes graph\" allowance)." ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns85:validate.param.shapes_graph_iri a ns2:Parameter ;
        rdfs:comment "Recorded on the report as ``sh:usedShapesGraph``, with the same ``.identifier`` fallback as ``data_graph_iri``." ;
        rdfs:label "shapes_graph_iri" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 13 .

    ns85:validate.param.shapes_graph_loader a ns2:Parameter ;
        rdfs:comment "A loader resolving ``shacl_graph``'s declared ``owl:imports`` (via ``StarLayerGraph.resolve_imports()``). When given, imports are resolved before validation; when omitted, any import that isn't already locally satisfied raises ``ValueError`` unless ``ignore_imports=True``." ;
        rdfs:label "shapes_graph_loader" ;
        ns2:annotationText "Callable[[Any], Any | None] | None" ;
