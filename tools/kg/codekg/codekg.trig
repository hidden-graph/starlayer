        ns2:hasReturnValue ns43:_demote_unreachable_inline.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 460 ;
        ns2:lineStart 395 ;
        ns2:signature "def _demote_unreachable_inline(by_subj, inline_bns, list_heads, list_items, list_cells) -> None" .

