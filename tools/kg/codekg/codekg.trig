    ns86:_build_node_by_expression_component dcterms:identifier "starlayer.shacl.native_components._build_node_by_expression_component" ;
        a ns2:Function ;
        rdfs:label "_build_node_by_expression_component" ;
        ns2:declares ns86:_build_node_by_expression_component.NodeByExpressionConstraintComponent ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:hasReturnValue ns86:_build_node_by_expression_component.returns ;
