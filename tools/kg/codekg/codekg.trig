    ns65:normalise_directional_language dcterms:identifier "starlayer.graph.query.builtin_error_patches.normalise_directional_language" ;
        a ns2:Function ;
        rdfs:comment """``term`` with the language tag of a directional literal lower-cased.

A directional literal is stored with its (language, direction) packed into
a synthetic datatype IRI (see ``model.encoding``), so rdflib compares the
tag's case; RDF 1.2 Concepts compares language tags case-insensitively.
Any other term is returned unchanged.""" ;
        rdfs:label "normalise_directional_language" ;
        ns2:calls ns34:decode_dirlang_datatype, ns34:encode_dirlang_datatype ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/builtin_error_patches.py" ;
