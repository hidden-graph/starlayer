    ns67:_register_dirlang_string_functions._same_kind dcterms:identifier "starlayer.graph.query.custom_functions._register_dirlang_string_functions._same_kind" ;
        a ns2:Function ;
        rdfs:comment """Build a literal "of the same kind" as a (language, direction)
pair from _classify() - the shared propagation rule SUBSTR/UCASE/
LCASE/STRBEFORE/STRAFTER/REPLACE all follow.

Deliberately a *bare* ``Literal(lexical)`` for the plain case, not
``Literal(lexical, datatype=XSD.string)`` - rdflib's own term
equality treats the two as genuinely different terms
(``Literal("x") != Literal("x", datatype=XSD.string)``), every W3C
expected-result fixture for this family renders the plain case with
no "datatype" key at all, and stock rdflib's own Builtin_CONCAT/
Builtin_STRBEFORE/Builtin_STRAFTER construct their own plain-case
result the same bare way.""" ;
        rdfs:label "_same_kind" ;
        ns2:calls ns34:encode_dirlang_datatype ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/custom_functions.py" ;
        ns2:hasParameter ns67:_register_dirlang_string_functions._same_kind.param.lexical, ns67:_register_dirlang_string_functions._same_kind.param.direction, ns67:_register_dirlang_string_functions._same_kind.param.language ;
        ns2:hasReturnValue ns67:_register_dirlang_string_functions._same_kind.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 382 ;
        ns2:lineStart 352 ;
        ns2:signature "def _same_kind(lexical, language, direction)" .

