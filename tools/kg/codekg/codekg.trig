    ns72:parseQuery dcterms:identifier "starlayer.graph.query.sparql_api.parseQuery" ;
        a ns2:Function ;
        rdfs:comment """Parse a SPARQL 1.2 SELECT/ASK/CONSTRUCT/DESCRIBE query string.

A leading ``VERSION "label"`` prologue directive (SPARQL 1.2 Query sec
4.3) is stripped first - not real SPARQL grammar at all, same handling
``StarLayerGraph.query()`` already gives it (see
``version_directive.py``'s own module docstring).""" ;
        rdfs:label "parseQuery" ;
        ns2:calls ns19:parse_query_12, ns72:_check_version_conformance, ns30:strip_version_directive ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/sparql_api.py" ;
        ns2:hasParameter ns72:parseQuery.param.q ;
        ns2:hasReturnValue ns72:parseQuery.returns ;
