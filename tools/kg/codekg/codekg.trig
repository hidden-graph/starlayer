    ns35:_decompose_quads dcterms:identifier "starlayer.graph.compare._decompose_quads" ;
        a ns2:Function ;
        rdfs:comment """Quads with every triple term replaced by a synthetic reification
fragment placed in the same graph as the quad that held the term, see
the module docstring for why that suffices. Returns de-duplicated quads
(a set, as a graph would be); the decomposition is injective.""" ;
        rdfs:label "_decompose_quads" ;
        ns2:calls ns35:_decompose_quads._term, ns35:_escape_predicate ;
        ns2:declares ns35:_decompose_quads._term ;
        ns2:filePath "packages/starlayer/starlayer/graph/compare.py" ;
        ns2:hasParameter ns35:_decompose_quads.param.quads ;
        ns2:hasReturnValue ns35:_decompose_quads.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 182 ;
