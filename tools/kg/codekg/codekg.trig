        a ns2:Method ;
        rdfs:comment """Parse and prepare ``text`` once; bind every other
``StarLayerGraph.query()`` option alongside it.""" ;
        rdfs:label "__init__" ;
        ns2:calls ns19:prepare_query_12 ;
        ns2:filePath "packages/starlayer/starlayer/sparql/star_query.py" ;
        ns2:hasParameter ns129:StarQuery.__init__.param.infer, ns129:StarQuery.__init__.param.timeout, ns129:StarQuery.__init__.param.initBindings, ns129:StarQuery.__init__.param.text, ns129:StarQuery.__init__.param.base, ns129:StarQuery.__init__.param.entailment, ns129:StarQuery.__init__.param.initNs, ns129:StarQuery.__init__.param.engine ;
        ns2:hasReturnValue ns129:StarQuery.__init__.returns ;
        ns2:isDunder true ;
        ns2:lineEnd 112 ;
        ns2:lineStart 68 ;
        ns2:signature "def __init__(self, text: str, *, base: str | None=None, initNs: Mapping[str, Any] | None=None, initBindings: Mapping[str, Any] | None=None, entailment: Any | None=None, infer: str='changed', engine: str='hermit', timeout: Any=_TIMEOUT_NOT_BOUND) -> None" .

    ns129:StarQuery.__init__.param.base a ns2:Parameter ;
        rdfs:comment "Optional base IRI, passed through to query preparation." ;
        rdfs:label "base" ;
        ns2:annotationText "str | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:builtins.str ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns129:StarQuery.__init__.param.engine a ns2:Parameter ;
        rdfs:comment "Passed through to ``StarLayerGraph.query()`` - only consulted for ``entailment=ENTAILMENT[\"OWL-Direct\"]``." ;
        rdfs:label "engine" ;
        ns2:annotationText "str" ;
        ns2:defaultValue "'hermit'" ;
        ns2:hasType ns5:builtins.str ;
        ns2:parameterKind "kwonly" ;
        ns2:position 6 .

    ns129:StarQuery.__init__.param.entailment a ns2:Parameter ;
        rdfs:comment "The entailment regime to use on every :meth:`run` call, unless overridden per call - see ``StarLayerGraph.query()``'s own ``entailment=`` for the full set of accepted values." ;
        rdfs:label "entailment" ;
