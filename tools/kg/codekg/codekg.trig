        ns2:hasReturnValue ns87:_collect_query_prefixes.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 290 ;
        ns2:lineStart 247 ;
        ns2:signature "def _collect_query_prefixes(shapes_graph: Any, query_node: Any) -> dict[str, Any]" .

