        ns2:hasType ns5:collections.abc.Callable, ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 8 .

    ns85:validate.param.shapes_graph_resource a ns2:Parameter ;
        rdfs:comment "A named ``sh:ShapesGraph`` module of ``shacl_graph`` to validate against (its IRI becomes ``sh:usedShapesGraph``), or an IRI that is not a module of it, used only as the report's provenance tag. Raises ``ValueError`` when ``shacl_graph`` is ``None``. Same meaning as ``StarShaclSchema.validate()``." ;
        rdfs:label "shapes_graph_resource" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 12 .

    ns85:validate.param.specification_graph a ns2:Parameter ;
        rdfs:comment "Passed to ``starlayer.shacl.profiling.derive_conforms_to()`` so SHACL 1.2 Profiling's second rule can additionally derive a ``dcterms:conformsTo`` triple from an already-derived ``sh:conformsTo`` one - a no-op unless both ``data_graph_iri`` and ``shapes_graph_iri`` resolve to something." ;
        rdfs:label "specification_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 14 .

    ns85:validate.param.validate_fn a ns2:Parameter ;
        rdfs:comment "The callable actually invoked to perform validation, taking ``data_graph=``/``shacl_graph=``/ ``ont_graph=`` (already encoded) plus every resolved option as keyword arguments, and returning ``(conforms, report_graph, report_text)``. Defaults to ``_default_validate`` (a thin wrapper around ``pyshacl.validate``)." ;
        rdfs:label "validate_fn" ;
        ns2:annotationText "Callable[..., tuple[bool, Graph, str]] | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:builtins.tuple, ns5:builtins.str, ns5:builtins.bool, ns5:collections.abc.Callable, ns5:rdflib.graph.Graph ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns85:validate.returns a ns2:ReturnValue ;
        rdfs:comment "A ``ValidationResult``: ``conforms`` (bool), ``report_graph``/ ``report_text`` (the validation report, decoded unless ``decode_report=False``), ``data_graph`` (the mutated original when the resolved options include ``inplace=True``, otherwise ``None``), and ``diagnostics`` (an ``ExecutionDiagnostics`` snapshot of adapter encode/decode activity for this call)." ;
        ns2:annotationText "ValidationResult" ;
        ns2:hasType ns5:starlayer.shacl.results.ValidationResult .

