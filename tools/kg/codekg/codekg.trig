        ns2:position 3 .

    ns84:_apply_entailment_regimes.param.ont_graph a ns2:Parameter ;
        rdfs:comment "An optional graph unioned in only for computing entailment - never copied into the result, never mutated." ;
        rdfs:label "ont_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns84:_apply_entailment_regimes.param.regimes a ns2:Parameter ;
