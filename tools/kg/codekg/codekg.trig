    ns75:check_xml_characters dcterms:identifier "starlayer.graph.serializers._xml.check_xml_characters" ;
        a ns2:Function ;
        rdfs:comment """Raise ``ValueError`` if any text or attribute value in the tree has a character XML 1.0 cannot carry.

XML 1.0 has no way to write U+0000-U+0008, U+000B, U+000C, U+000E-U+001F (not even as a character reference), so the
document could not be read back; failing at the write is better than a saved file that does not load (GitHub issue #133).""" ;
        rdfs:label "check_xml_characters" ;
        ns2:filePath "packages/starlayer/starlayer/graph/serializers/_xml.py" ;
