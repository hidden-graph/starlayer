        ns2:hasReturnValue ns57:_clark.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 73 ;
        ns2:lineStart 70 ;
        ns2:signature "def _clark(iri: str) -> str" .

    ns57:_clark.param.iri a ns2:Parameter ;
        rdfs:label "iri" ;
        ns2:annotationText "str" ;
        ns2:hasType ns5:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns57:_clark.returns a ns2:ReturnValue ;
