        ns2:hasType ns5:builtins.str .

    ns127:_predicate_text dcterms:identifier "starlayer.sparql.ssyn_to_text._predicate_text" ;
        a ns2:Function ;
        rdfs:comment """A predicate position may be a genuine property path — see
to_ssyn_rdf.py's _encode_predicate, which falls back to the existing
spexpr: path encoding (to_rdf._encode_path) for that case, the same
spexpr:-boundary principle used for expressions. Decode it back into a
real rdflib.paths.Path object (from_rdf._decode already knows how,
dispatching on the node's spexpr: type) and reuse *its* own .n3() —
Path objects already render themselves as valid SPARQL path syntax,
no new rendering logic needed.

Path-encoded nodes are typed under spexpr:, not salg: — to_rdf
._encode_path types every path node (InvPath/SequencePath/
AlternativePath/MulPath/NegatedPath) under spexpr: unconditionally (see
that function's own docstring, "Path is one of the vocabularies that
moved"), so path-detection code must test for spexpr: specifically.
Testing salg: here instead would silently miss every genuine path
predicate, falling through to _term_text(term) — which renders the
path's own BNode identifier as if it were an ordinary term, producing a
bare blank-node ID in the regenerated query text instead of e.g.
`foaf:knows+`.""" ;
        rdfs:label "_predicate_text" ;
        ns2:calls ns113:_decode, ns127:_term_text ;
        ns2:filePath "packages/starlayer/starlayer/sparql/ssyn_to_text.py" ;
        ns2:hasParameter ns127:_predicate_text.param.graph, ns127:_predicate_text.param.term ;
        ns2:hasReturnValue ns127:_predicate_text.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 147 ;
        ns2:lineStart 113 ;
        ns2:signature "def _predicate_text(graph: Graph, term) -> str" .

    ns127:_predicate_text.param.graph a ns2:Parameter ;
        rdfs:comment "The RDF graph containing the encoded predicate." ;
        rdfs:label "graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns5:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
