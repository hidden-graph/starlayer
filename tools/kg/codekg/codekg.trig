    ns104:decode_dirlang_datatype.returns a ns2:ReturnValue ;
        rdfs:comment "A (language, direction) tuple decoded from the datatype's local name, or None if datatype is not this project's own dirlang encoding." ;
        ns2:annotationText "tuple[str, str] | None" ;
        ns2:hasType ns5:builtins.tuple, ns5:builtins.str ;
        ns2:optional true .

    ns104:encode_dirlang_datatype dcterms:identifier "starlayer.sparql.vocab.encode_dirlang_datatype" ;
        a ns2:Function ;
        rdfs:comment """Return this project's own internal datatype URIRef encoding of
(language, direction) - see DIRLANG_NS above for why this isn't
starlayer.graph's own encode_dirlang_datatype, despite doing the same
thing the same way.""" ;
        rdfs:label "encode_dirlang_datatype" ;
        ns2:filePath "packages/starlayer/starlayer/sparql/vocab.py" ;
        ns2:hasParameter ns104:encode_dirlang_datatype.param.direction, ns104:encode_dirlang_datatype.param.language ;
        ns2:hasReturnValue ns104:encode_dirlang_datatype.returns ;
        ns2:lineEnd 255 ;
        ns2:lineStart 242 ;
        ns2:signature "def encode_dirlang_datatype(language: str, direction: str) -> URIRef" .

    ns104:encode_dirlang_datatype.param.direction a ns2:Parameter ;
        rdfs:comment "The literal's base direction (\"ltr\" or \"rtl\")." ;
        rdfs:label "direction" ;
