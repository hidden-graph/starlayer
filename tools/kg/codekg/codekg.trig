GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/trig12.py> {
    ns60:trig12.py dcterms:identifier "starlayer.graph.parsers.trig12" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.trig12

Parse TriG 1.2 text into triples, preserving or merging named-graph structure.

TriG 1.2 is Turtle 1.2 with optional ``GRAPH <name> { ... }`` blocks.  Each
block's content is Turtle 1.2, so this parser:

  1. Extracts PREFIX / @prefix declarations.
  2. Splits the document into graph blocks (default graph + each GRAPH block).
  3. Prepends the prefix declarations to each block's content.
  4. Parses each chunk as Turtle 1.2 via StarLayerTurtleParser.

Entry points:
    parse_trig12(text)        -> list of (s, p, o)            (merges all graphs)
    parse_trig12_named(text)  -> list of (graph_id, triples, namespaces)""" ;
        rdfs:label "trig12" ;
        ns2:declares ns45:extract_version_directive, ns45:_extract_prefix_lines, ns45:parse_trig12_named, ns45:_resolution_state, ns45:_extract_prefix_map, ns45:_split_trig_blocks_with_ids, ns45:_resolve_graph_id, ns45:parse_trig12, ns45:_split_trig_blocks, ns45:_mask_string_literals, ns45:_search_block, ns45:_consume_balanced ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        ns2:importsModule ns5:__future__, ns5:rdflib, ns5:re .

    ns45:_consume_balanced dcterms:identifier "starlayer.graph.parsers.trig12._consume_balanced" ;
        a ns2:Function ;
        rdfs:comment "Consume from text[start] (must be '{') to the matching '}', return (block, end)." ;
        rdfs:label "_consume_balanced" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        ns2:hasParameter ns45:_consume_balanced.param.start, ns45:_consume_balanced.param.text ;
        ns2:hasReturnValue ns45:_consume_balanced.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 157 ;
        ns2:lineStart 91 ;
        ns2:signature "def _consume_balanced(text: str, start: int) -> tuple[str, int]" .

    ns45:_consume_balanced.param.start a ns2:Parameter ;
        rdfs:label "start" ;
        ns2:annotationText "int" ;
        ns2:hasType ns5:builtins.int ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns45:_consume_balanced.param.text a ns2:Parameter ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns5:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns45:_consume_balanced.returns a ns2:ReturnValue ;
        ns2:annotationText "tuple[str, int]" ;
        ns2:hasType ns5:builtins.tuple, ns5:builtins.str, ns5:builtins.int .

    ns45:_extract_prefix_lines dcterms:identifier "starlayer.graph.parsers.trig12._extract_prefix_lines" ;
        a ns2:Function ;
        rdfs:comment """Return a string of all @prefix / PREFIX declarations found in text.

Matches against a string-literal-masked copy of text (see
_mask_string_literals()), not text itself - a genuine declaration is
never inside a string literal, so it's completely unaffected by
masking, but text that merely *looks* like one inside a string's own
content (e.g. a docstring quoting "@prefix : <http://example.org/> .")
is masked away and correctly never matches.""" ;
        rdfs:label "_extract_prefix_lines" ;
        ns2:calls ns45:_mask_string_literals ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        ns2:hasParameter ns45:_extract_prefix_lines.param.text ;
        ns2:hasReturnValue ns45:_extract_prefix_lines.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 214 ;
        ns2:lineStart 202 ;
        ns2:signature "def _extract_prefix_lines(text: str) -> str" .

    ns45:_extract_prefix_lines.param.text a ns2:Parameter ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns5:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns45:_extract_prefix_lines.returns a ns2:ReturnValue ;
        ns2:annotationText "str" ;
        ns2:hasType ns5:builtins.str .

    ns45:_extract_prefix_map dcterms:identifier "starlayer.graph.parsers.trig12._extract_prefix_map" ;
        a ns2:Function ;
        rdfs:comment """Return {prefix_str: namespace_uri} for all prefix declarations in
text. See _extract_prefix_lines() for why this matches against a
string-literal-masked copy rather than text itself.""" ;
        rdfs:label "_extract_prefix_map" ;
        ns2:calls ns45:_mask_string_literals ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/trig12.py" ;
        ns2:hasParameter ns45:_extract_prefix_map.param.text ;
        ns2:hasReturnValue ns45:_extract_prefix_map.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 231 ;
        ns2:lineStart 217 ;
        ns2:signature "def _extract_prefix_map(text: str) -> dict[str, str]" .

    ns45:_extract_prefix_map.param.text a ns2:Parameter ;
        rdfs:label "text" ;
        ns2:annotationText "str" ;
        ns2:hasType ns5:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns45:_extract_prefix_map.returns a ns2:ReturnValue ;
        ns2:annotationText "dict[str, str]" ;
        ns2:hasType ns5:builtins.dict, ns5:builtins.str .

    ns45:_mask_string_literals dcterms:identifier "starlayer.graph.parsers.trig12._mask_string_literals" ;
        a ns2:Function ;
        rdfs:comment """Return a same-length copy of text with the contents of every quoted
string literal (long or short) replaced by '#' filler (newlines left
untouched, so line-oriented matching elsewhere is unaffected).

Used to protect the regex-based structural scans below
(_GRAPH_BLOCK_RE, _PREFIX_RE, the prefix-map regex) from being fooled
by literal text that merely *looks* like a GRAPH block or a @prefix/
PREFIX declaration but is really just a string's own content - e.g. a
docstring that quotes "@prefix : <http://example.org/> ." as part of
its prose, or one that shows a literal "GRAPH <...> { ... }" example
(this module's own docstrings do both). Positions/length are
preserved so a match's span still slices correctly into the
*original*, unmasked text.""" ;
        rdfs:label "_mask_string_literals" ;
