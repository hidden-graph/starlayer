        ns2:declares ns86:_build_unique_values_for_component.UniqueValuesForConstraintComponent ;
        ns2:filePath "packages/starlayer/starlayer/shacl/native_components.py" ;
        ns2:hasReturnValue ns86:_build_unique_values_for_component.returns ;
