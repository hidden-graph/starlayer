        ns2:hasParameter ns131:_build_rdf_list.param.graph, ns131:_build_rdf_list.param.nodes ;
        ns2:hasReturnValue ns131:_build_rdf_list.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 282 ;
        ns2:lineStart 268 ;
        ns2:signature "def _build_rdf_list(nodes: list, graph: Graph) -> BNode | URIRef" .

    ns131:_build_rdf_list.param.graph a ns2:Parameter ;
        rdfs:comment "The graph to add the list to." ;
        rdfs:label "graph" ;
        ns2:annotationText "Graph" ;
        ns2:hasType ns5:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns131:_build_rdf_list.param.nodes a ns2:Parameter ;
