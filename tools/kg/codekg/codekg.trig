        ns2:signature "def consume_annotation_block(s)" .

    ns61:consume_annotation_block.param.s a ns2:Parameter ;
        rdfs:comment "Text starting with '{|'." ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns61:consume_annotation_block.returns a ns2:ReturnValue ;
        rdfs:comment "A (body_str, remaining) tuple - the block's inner content (stripped) and the remaining text after the closing '|}'." .

    ns61:next_token dcterms:identifier "starlayer.graph.parsers.lexer.next_token" ;
        a ns2:Function ;
        rdfs:comment "Return the next atomic token in s." ;
        rdfs:label "next_token" ;
        ns2:calls ns61:_bracket_end ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/lexer.py" ;
