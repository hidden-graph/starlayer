        ns2:annotationText "str" ;
        ns2:hasType ns5:builtins.str ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns107:parse_ruleset.param.validate a ns2:Parameter ;
        rdfs:comment "Also validate the rule set against the ``srl:`` shapes. Defaults to ``True``." ;
        rdfs:label "validate" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "True" ;
