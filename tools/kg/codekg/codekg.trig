    ns82:target_nodes.param.ont_graph a ns2:Parameter ;
        rdfs:comment "An optional ontology graph unioned in for entailment only (see above) - never copied into the result." ;
        rdfs:label "ont_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns82:target_nodes.param.shacl_graph a ns2:Parameter ;
        rdfs:comment "The graph holding ``shape_node``'s own target declarations. Falls back to ``data_graph`` when ``None``." ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 1 .

    ns82:target_nodes.param.shape_node a ns2:Parameter ;
        rdfs:comment "The shape whose targets to resolve: ``sh:targetNode`` (an IRI, a literal, a ``sh:select`` or a node expression), ``sh:targetClass`` (subclasses included), ``sh:targetSubjectsOf``, ``sh:targetObjectsOf``, ``sh:targetWhere``, ``sh:target`` (SPARQLTarget, via pySHACL's advanced mode), data-graph ``sh:shape`` and implicit class targets. The nodes are the ones ``validate()`` reports on, because the dynamic forms are resolved by the validator's own code (GitHub issue #66)." ;
        rdfs:label "shape_node" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "kwonly" ;
        ns2:position 2 .

