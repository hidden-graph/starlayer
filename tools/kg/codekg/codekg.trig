        ns2:signature "def _decompose_quads(quads: Any) -> list" .

    ns35:_decompose_quads._term dcterms:identifier "starlayer.graph.compare._decompose_quads._term" ;
        a ns2:Function ;
        rdfs:comment """A triple term becomes a fresh blank node (recursing for a nested
triple term in object position); a DirLangString is re-encoded as
the same flat Literal form used at this codebase's own read/write
boundary; an explicit-xsd:string Literal is normalized down to the
simple-literal form (datatype=None) it's semantically sugar for, per
RDF 1.1 Concepts (see module docstring); a language tag is
lower-cased (tags compare case-insensitively); anything else
(already a plain rdflib term) passes through unchanged.""" ;
        rdfs:label "_term" ;
        ns2:calls ns34:encode_dirlang_datatype, ns35:_decompose_quads._term ;
        ns2:filePath "packages/starlayer/starlayer/graph/compare.py" ;
        ns2:hasParameter ns35:_decompose_quads._term.param.node, ns35:_decompose_quads._term.param.g ;
        ns2:hasReturnValue ns35:_decompose_quads._term.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 178 ;
        ns2:lineStart 156 ;
