GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/extractor/__init__.py> {
    ns7:__init__.py dcterms:identifier "starlayer.codekg.extractor.__init__" ;
        a ns2:Module ;
        rdfs:comment """starlayer.codekg.extractor - pure-logic pieces of the code-KG extractor.

Each sibling module here (``imports``, ``types``, ``docstrings``) is
self-contained and independently importable, with no dependency on each
other or on the not-yet-built AST visitor/build orchestration/CLI. This
``__init__.py`` deliberately re-exports nothing - callers import the
specific module they need (``from starlayer.codekg.extractor import
imports`` etc.) rather than a flattened namespace, so each module's own
docstring stays the one place describing its contract.""" ;
        rdfs:label "__init__" ;
        ns2:filePath "packages/starlayer/starlayer/codekg/extractor/__init__.py" .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/extractor/build.py> {
    ns7:build.py dcterms:identifier "starlayer.codekg.extractor.build" ;
        a ns2:Module ;
        rdfs:comment """starlayer.codekg.extractor.build - builds ``codekg.trig`` and ``testskg.trig`` from scratch.

One public function, ``refresh()``: extract each target path with ``visitor.py``, add the build stamp and serialize the
result. The file holds only what this extractor produces (one named graph per module, plus the build stamp), so the
previous file is not read: nothing in it is carried over. (It used to be parsed first, to keep an ontology graph and a
curated graph that the file never contained; the ontology and curated layers are assembled from their own ``.ttl``
files by ``scripts/build_kg.py``.)

Before any single file's own triples are extracted, a whole-project
``symbol_index.build_symbol_index()`` pass runs once across every target
path - this is what lets ``slkg:calls`` resolve a call to a function
defined in a different file than the one making the call (see
``symbol_index.py``'s own module docstring).""" ;
        rdfs:label "build" ;
        ns2:declares ns8:refresh ;
        ns2:filePath "packages/starlayer/starlayer/codekg/extractor/build.py" ;
        ns2:importsModule ns5:pathlib, ns5:__future__ .

    ns8:refresh dcterms:identifier "starlayer.codekg.extractor.build.refresh" ;
        a ns2:Function ;
        rdfs:comment """Extract every path in ``target_paths`` and write ``codekg.trig`` (the source modules and the build stamp) and
``testskg.trig`` (the test modules) from scratch. Returns ``(codekg_dataset, testskg_dataset)``, what was written.

The symbol index spans every target, so a call from a test to a source function resolves although the two live in
different files. ``testskg.trig`` is written only when some target is a test module.""" ;
        rdfs:label "refresh" ;
        ns2:calls ns9:build_symbol_index, ns9:module_identity, ns10:write_stamp, ns11:extract_module ;
        ns2:filePath "packages/starlayer/starlayer/codekg/extractor/build.py" ;
        ns2:hasParameter ns8:refresh.param.repo_root, ns8:refresh.param.target_paths, ns8:refresh.param.tests_trig_path, ns8:refresh.param.trig_path ;
        ns2:instantiates ns6:StarLayerDataset ;
        ns2:lineEnd 69 ;
        ns2:lineStart 23 ;
        ns2:signature "def refresh(target_paths: list[Path], repo_root: Path, *, trig_path: Path | None=None, tests_trig_path: Path | None=None)" .

    ns8:refresh.param.repo_root a ns2:Parameter ;
        rdfs:comment "The repository root, used to compute each path's repo-relative identity (module IRI and dotted import path) via ``symbol_index.module_identity()`` - every entry in ``target_paths`` must live under one of that function's own known roots (``packages/starlayer/starlayer/`` or ``packages/starlayer/tests/`` - see ``symbol_index.resolve_root()``)." ;
        rdfs:label "repo_root" ;
        ns2:annotationText "Path" ;
        ns2:hasType ns5:pathlib.Path ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns8:refresh.param.target_paths a ns2:Parameter ;
        rdfs:comment "The ``.py`` files to extract (already resolved to individual files, not directories - see ``cli.py`` for the directory-globbing step)." ;
        rdfs:label "target_paths" ;
        ns2:annotationText "list[Path]" ;
        ns2:hasType ns5:builtins.list, ns5:pathlib.Path ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns8:refresh.param.tests_trig_path a ns2:Parameter ;
        rdfs:comment "Override for ``testskg.trig``; with ``trig_path`` given it defaults to ``testskg.trig`` beside it." ;
        rdfs:label "tests_trig_path" ;
        ns2:annotationText "Path | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:pathlib.Path ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns8:refresh.param.trig_path a ns2:Parameter ;
        rdfs:comment "Override for where ``codekg.trig`` is written - defaults to the real ``CODEKG_TRIG_PATH`` module constant. Exists for testability (so a test never touches the real, checked-in file)." ;
        rdfs:label "trig_path" ;
        ns2:annotationText "Path | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:pathlib.Path ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 2 .

    ns5:__future__ a ns2:ExternalModule .

