        a ns2:Function ;
        rdfs:label "_decode_comp_value" ;
        ns2:calls ns113:_decode_quads_map, ns113:_strip_vocab_ns, ns113:_to_python_deep, ns113:_decode_list_field, ns113:_decode ;
        ns2:filePath "packages/starlayer/starlayer/sparql/from_rdf.py" ;
        ns2:hasParameter ns113:_decode_comp_value.param.type_uri, ns113:_decode_comp_value.param.node, ns113:_decode_comp_value.param.graph ;
