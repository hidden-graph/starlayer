GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/graph/parsers/lexer.py> {
    ns60:lexer.py dcterms:identifier "starlayer.graph.parsers.lexer" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.lexer

Character-level tokenization for Turtle 1.2. Handles all token forms:
<<( )>> triple terms, << >> reification shorthand, <IRI>, quoted strings,
[ ] blank nodes, ( ) collections, and plain whitespace-delimited tokens.

Every form below that scans for a closing delimiter raises
starlayer.graph.parsers.errors.Turtle12SyntaxError if it reaches the end of the
statement text without finding one, rather than silently treating "no
closing delimiter found" as "the rest of the text is one token" - the
statement-level Turtle12SyntaxError.line is filled in by the caller
(StarLayerTurtleParser.parse()), since these functions only see
already-extracted, single-statement text with no document-level line info.""" ;
        rdfs:label "lexer" ;
        ns2:declares ns61:next_token, ns61:split_obj_and_annotations, ns61:consume_annotation_block, ns61:_bracket_end ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/lexer.py" ;
        ns2:importsModule ns5:re .

    ns61:_bracket_end dcterms:identifier "starlayer.graph.parsers.lexer._bracket_end" ;
        a ns2:Function ;
        rdfs:comment """Offset just past the bracket that closes the one s starts with, or -1.

Brackets inside a string (short or long, with backslash escapes) or an
<IRI> do not count (GitHub issue #73: an escaped quote used to end the
string early).""" ;
        rdfs:label "_bracket_end" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/lexer.py" ;
        ns2:hasParameter ns61:_bracket_end.param.close_char, ns61:_bracket_end.param.open_char, ns61:_bracket_end.param.s ;
        ns2:isPrivate true ;
        ns2:lineEnd 56 ;
        ns2:lineStart 28 ;
        ns2:signature "def _bracket_end(s, open_char, close_char)" .

    ns61:_bracket_end.param.close_char a ns2:Parameter ;
        rdfs:label "close_char" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns61:_bracket_end.param.open_char a ns2:Parameter ;
        rdfs:label "open_char" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns61:_bracket_end.param.s a ns2:Parameter ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns61:consume_annotation_block dcterms:identifier "starlayer.graph.parsers.lexer.consume_annotation_block" ;
        a ns2:Function ;
        rdfs:comment """Consume one {| ... |} annotation block from the start of s, handling
nested {| |} blocks and quoted strings.""" ;
        rdfs:label "consume_annotation_block" ;
