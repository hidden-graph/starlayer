    ns65:patch_select_star_scope_and_describe_star dcterms:identifier "starlayer.graph.query.builtin_error_patches.patch_select_star_scope_and_describe_star" ;
        a ns2:Function ;
        rdfs:comment """``SELECT *`` listed variables that occur only inside a ``FILTER`` (for
instance in ``FILTER EXISTS { ?o :p ?zz }``) as always-unbound columns;
the in-scope variables of a group pattern (SPARQL 1.1 18.2.1) come from its
patterns, not from filters. ``DESCRIBE *`` raised ``TypeError`` because the
parser leaves its variable list empty; it describes the resources bound to
the in-scope variables of the WHERE clause.""" ;
        rdfs:label "patch_select_star_scope_and_describe_star" ;
        ns2:calls ns65:_marked, ns65:_is_marked ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/builtin_error_patches.py" ;
        ns2:hasReturnValue ns65:patch_select_star_scope_and_describe_star.returns ;
        ns2:lineEnd 687 ;
        ns2:lineStart 648 ;
        ns2:signature "def patch_select_star_scope_and_describe_star() -> bool" .

    ns65:patch_select_star_scope_and_describe_star.returns a ns2:ReturnValue ;
        ns2:annotationText "bool" ;
        ns2:hasType ns5:builtins.bool .

    ns65:patch_sparql_parser_keeps_tabs dcterms:identifier "starlayer.graph.query.builtin_error_patches.patch_sparql_parser_keeps_tabs" ;
        a ns2:Function ;
        rdfs:comment """pyparsing expands every TAB in the input to spaces before parsing unless the grammar asks to keep them
(``parseWithTabs``), so a raw TAB inside a string literal came back as up to eight spaces
(``"a<TAB>b"`` read as ``"a       b"``). Whitespace skipping still treats a TAB as whitespace. Plain rdflib has the same bug
(not filed upstream).""" ;
        rdfs:label "patch_sparql_parser_keeps_tabs" ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/builtin_error_patches.py" ;
        ns2:hasReturnValue ns65:patch_sparql_parser_keeps_tabs.returns ;
