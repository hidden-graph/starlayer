    ns82:target_nodes dcterms:identifier "starlayer.shacl.engine.core.target_nodes" ;
        a ns2:Function ;
        rdfs:comment """Resolve ``shape_node``'s SHACL targets against ``data_graph``.

``shacl_graph=None`` falls back to ``data_graph`` itself - matching
``validate()``'s own "data graph doubles as shapes graph" allowance,
for a data file carrying its own embedded shapes.

``shacl_graph``'s own declared ``sh:entailment`` regime(s) (SHACL 1.2
Core sec 1.4), plus the optional ``inference=`` keyword (same
``ENTAILMENT.*`` vocabulary), are applied once, up front, onto a
private, non-mutating copy of ``data_graph`` - computed over
``data_graph`` union ``ont_graph`` when given (so an axiom declared
only in ``ont_graph``, e.g. ``rdfs:domain``, actually widens
``sh:targetClass`` membership), but only the newly-entailed delta is
materialized - ``ont_graph``'s own raw triples are never copied in.
Neither ``data_graph`` nor ``ont_graph`` is mutated. A no-op when
neither is declared nor passed (the common case).""" ;
        rdfs:label "target_nodes" ;
        ns2:calls ns84:apply_entailment, ns82:target_nodes.add, ns85:_augment_shapes_with_new_target_types, ns86:ensure_shape_typed, ns83:normalize_graph_inputs ;
        ns2:declares ns82:target_nodes.add ;
        ns2:filePath "packages/starlayer/starlayer/shacl/engine/core.py" ;
        ns2:hasParameter ns82:target_nodes.param.shape_node, ns82:target_nodes.param.data_graph, ns82:target_nodes.param.ont_graph, ns82:target_nodes.param.inference, ns82:target_nodes.param.shacl_graph ;
        ns2:hasReturnValue ns82:target_nodes.returns ;
        ns2:lineEnd 134 ;
        ns2:lineStart 26 ;
        ns2:signature "def target_nodes(*, data_graph: Any, shacl_graph: Any | None=None, shape_node: Any, ont_graph: Any | None=None, inference: Any | None=None) -> tuple[Any, ...]" .

