        ns2:hasParameter ns52:parse_rdfxml12.param.text ;
        ns2:hasReturnValue ns52:parse_rdfxml12.returns ;
        ns2:instantiates ns52:_Preprocessor ;
        ns2:lineEnd 358 ;
        ns2:lineStart 333 ;
        ns2:signature "def parse_rdfxml12(text: str) -> list[tuple]" .

