        ns2:hasParameter ns33:_lower_template_term.param.pending_extends, ns33:_lower_template_term.param.state, ns33:_lower_template_term.param.extra_template_triples, ns33:_lower_template_term.param.term ;
        ns2:isPrivate true ;
