        rdfs:comment "Whether ``_annotate_used_graphs_and_configuration()`` also records which validation options were in effect, alongside ``sh:usedDataGraph``/``sh:usedShapesGraph``. options (e.g. ``advanced``, ``inplace``, ``meta_shacl``, ``allow_warnings``, ``allow_infos``, ``inference``, ``debug``), forwarded to ``validate_fn``. With the default ``validate_fn`` an option name pySHACL does not know raises ``TypeError`` (pySHACL itself ignores it silently)." ;
        rdfs:label "include_used_configuration" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "False" ;
        ns2:hasType ns5:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 15 .

    ns85:validate.param.kwargs a ns2:Parameter ;
        rdfs:label "kwargs" ;
