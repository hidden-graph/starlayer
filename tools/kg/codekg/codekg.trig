    ns84:apply_entailment dcterms:identifier "starlayer.shacl.entailment.apply_entailment" ;
        a ns2:Function ;
        rdfs:comment """Materialize ``shacl_graph``'s own declared ``sh:entailment``
regime(s) over ``data_graph`` (and ``ont_graph``, if given - see
``_apply_entailment_regimes``'s own docstring for exactly how), merged
with whatever ``inference`` contributes, and return the graph to use
from here on - which is ``data_graph`` itself only when
``inplace=True``.

A no-op (returns ``data_graph`` unchanged, same object either way)
when ``shacl_graph`` declares no ``sh:entailment`` and ``inference``
is ``None`` - the overwhelmingly common case. ``shacl_graph`` may
itself be ``None`` (contributes no declared regimes, same as an empty
shapes graph).""" ;
        rdfs:label "apply_entailment" ;
        ns2:calls ns84:_apply_entailment_regimes, ns84:declared_entailment_regimes ;
        ns2:filePath "packages/starlayer/starlayer/shacl/entailment.py" ;
        ns2:hasParameter ns84:apply_entailment.param.inplace, ns84:apply_entailment.param.data_graph, ns84:apply_entailment.param.shacl_graph, ns84:apply_entailment.param.ont_graph, ns84:apply_entailment.param.inference ;
        ns2:hasReturnValue ns84:apply_entailment.returns ;
