    ns60:turtle_parser.py dcterms:identifier "starlayer.graph.parsers.turtle_parser" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.turtle_parser

Parses Turtle 1.2 text into an rdflib.Graph, expanding RDF 1.2 quoted-triple
syntax (<<( )>>, << >>, {| |}, ~ reifier) into the starlayer.graph internal encoding:

  Triple terms  → content-addressed URIRefs under tt: namespace
  Anon reifiers → plain BNodes (anonymous by nature)
  Named reifiers → unchanged (already named URIs)

Entry point: StarLayerTurtleParser().parse(data)""" ;
        rdfs:label "turtle_parser" ;
        ns2:declares ns47:_is_qt, ns47:_skolemize_encoding, ns47:_norm_qt, ns47:_Expander, ns47:_get_reifier_parts, ns47:StarLayerTurtleParser, ns47:_decode_uchar, ns47:_strip_blank_and_comment_lines, ns47:_resolve_iri_reference, ns47:_next_object_token, ns47:_is_qt_reif, ns47:_has_reifier, ns47:decode_tt_encoded_triples, ns47:_to_node, ns47:_join, ns47:_is_qt_term, ns47:_unescape, ns47:_split_literal, ns47:_is_bnode_list ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/turtle_parser.py" ;
        ns2:importsModule ns5:re, ns5:urllib.parse, ns5:rdflib, ns5:secrets, ns5:rdflib.namespace .

    ns47:StarLayerTurtleParser dcterms:identifier "starlayer.graph.parsers.turtle_parser.StarLayerTurtleParser" ;
        a ns2:Class ;
