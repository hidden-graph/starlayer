    ns60:syntax.py dcterms:identifier "starlayer.graph.parsers.syntax" ;
        a ns2:Module ;
        rdfs:comment """starlayer.graph.parsers.syntax

Statement-level parsing for Turtle 1.2. Splits raw text into statements,
classifies them, extracts predicate-object fields, and expands blank-node
shorthand and RDF collections into flat triple dicts.""" ;
        rdfs:label "syntax" ;
        ns2:declares ns62:_scan_directive_end, ns62:split_statements, ns62:extract_fields, ns62:classify_statement, ns62:_split_on_delimiter, ns62:coerce_object, ns62:expand_triple_set, ns62:split_statements_with_lines, ns62:_split_statements_impl, ns62:_parse_collection_elements ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:importsModule ns5:re, ns5:rdflib.namespace, ns5:rdflib .

    ns62:_parse_collection_elements dcterms:identifier "starlayer.graph.parsers.syntax._parse_collection_elements" ;
        a ns2:Function ;
        rdfs:comment "Parse space-separated elements from the inside of a ( ... ) collection." ;
        rdfs:label "_parse_collection_elements" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:_parse_collection_elements.param.inside ;
        ns2:isPrivate true ;
        ns2:lineEnd 847 ;
        ns2:lineStart 798 ;
        ns2:signature "def _parse_collection_elements(inside)" .

    ns62:_parse_collection_elements.param.inside a ns2:Parameter ;
        rdfs:label "inside" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns62:_scan_directive_end dcterms:identifier "starlayer.graph.parsers.syntax._scan_directive_end" ;
        a ns2:Function ;
        rdfs:comment """From position i (the start of a directive keyword), find where this
directive statement ends.

A directive is terminated by a depth-0 '.' if it has one (e.g.
"@prefix : <http://example.org/> ."), the same as any other statement -
finding it here (bracket/string-depth-aware, so a '.' inside the
directive's own <IRI>, e.g. "example.com", doesn't false-terminate it)
is what lets content following the directive on the *same* physical
line be correctly split into its own, separate statement. If there's
no '.' before the line ends, the directive is dot-less (both the
dotted @prefix/@base/@version and the bare SPARQL-style prefix/base/
version spellings are accepted without a trailing '.' - existing,
intentional leniency), so it ends at end-of-line instead.

Returns the exclusive end offset (just past the '.' if found, otherwise
at the line-terminating '\\n'/'\\r' or end of data).""" ;
        rdfs:label "_scan_directive_end" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:_scan_directive_end.param.data, ns62:_scan_directive_end.param.i ;
        ns2:isPrivate true ;
        ns2:lineEnd 288 ;
        ns2:lineStart 200 ;
        ns2:signature "def _scan_directive_end(data, i)" .

    ns62:_scan_directive_end.param.data a ns2:Parameter ;
        rdfs:label "data" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns62:_scan_directive_end.param.i a ns2:Parameter ;
        rdfs:label "i" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns62:_split_on_delimiter dcterms:identifier "starlayer.graph.parsers.syntax._split_on_delimiter" ;
        a ns2:Function ;
        rdfs:comment """Split text on delim at bracket-depth 0, respecting strings.

Triple-quoted (``\"\"\"``/``'''``) strings are tracked as one atomic
unit, not three independent single-char toggles. Previously this
function only ever tracked single-character quote state (toggling
``in_str`` on literally every ``"``/``'`` it saw) - for a real
triple-quoted string the first two characters of the opening
``\"\"\"`` canceled each other out as a complete, empty string, so
the *third* quote character was misread as starting a brand-new
single-quoted string - one that then terminated early at the real
string's own first embedded quote (e.g. a multi-line docstring
quoting a short phrase, as this project's own cleaned-up docstring
convention - see starlayer.codekg.extractor - routinely produces).
Any ``;``/``,`` between that false terminator and the literal's real
closing ``\"\"\"`` was then silently swallowed into the wrong group
instead of splitting there, corrupting every predicate/object pair
that followed. Confirmed via the code-KG extractor's own real pilot
run against ``starlayer.graph.model.conformance``'s
``SPARQL12ConformanceWarning`` docstring, the first multi-line
comment in this project's fixtures to combine a triple-quoted
serialization with an embedded, quoted short phrase.""" ;
        rdfs:label "_split_on_delimiter" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:_split_on_delimiter.param.text, ns62:_split_on_delimiter.param.delim, ns62:_split_on_delimiter.param.keep_empty ;
        ns2:isPrivate true ;
        ns2:lineEnd 179 ;
        ns2:lineStart 76 ;
        ns2:signature "def _split_on_delimiter(text, delim, keep_empty=False)" .

    ns62:_split_on_delimiter.param.delim a ns2:Parameter ;
        rdfs:label "delim" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns62:_split_on_delimiter.param.keep_empty a ns2:Parameter ;
        rdfs:label "keep_empty" ;
        ns2:defaultValue "False" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns62:_split_on_delimiter.param.text a ns2:Parameter ;
        rdfs:label "text" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns62:_split_statements_impl dcterms:identifier "starlayer.graph.parsers.syntax._split_statements_impl" ;
        a ns2:Function ;
        rdfs:comment """Split Turtle text into (statement, start_offset) pairs, start_offset
being the 0-based character offset in *data* where that statement's
buffering began - statement-start granularity, not byte-exact (newlines
are stripped while buffering a multi-line statement, so a precise
within-statement offset isn't recoverable here), which is enough to
convert to a "close enough" line number for error reporting. See
split_statements() and split_statements_with_lines() below, and
Turtle12SyntaxError in starlayer.graph.parsers.errors.""" ;
        rdfs:label "_split_statements_impl" ;
        ns2:calls ns62:_scan_directive_end ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:_split_statements_impl.param.require_final_dot, ns62:_split_statements_impl.param.data ;
        ns2:instantiates ns58:Turtle12SyntaxError ;
        ns2:isPrivate true ;
        ns2:lineEnd 488 ;
        ns2:lineStart 291 ;
        ns2:signature "def _split_statements_impl(data, require_final_dot=False)" .

    ns62:_split_statements_impl.param.data a ns2:Parameter ;
        rdfs:label "data" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns62:_split_statements_impl.param.require_final_dot a ns2:Parameter ;
        rdfs:label "require_final_dot" ;
        ns2:defaultValue "False" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns62:classify_statement dcterms:identifier "starlayer.graph.parsers.syntax.classify_statement" ;
        a ns2:Function ;
        rdfs:comment "Classify a single statement string by its leading keyword." ;
        rdfs:label "classify_statement" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:classify_statement.param.stmt ;
        ns2:hasReturnValue ns62:classify_statement.returns ;
        ns2:lineEnd 549 ;
        ns2:lineStart 535 ;
        ns2:signature "def classify_statement(stmt)" .

    ns62:classify_statement.param.stmt a ns2:Parameter ;
        rdfs:comment "A single statement string, as produced by split_statements()." ;
        rdfs:label "stmt" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns62:classify_statement.returns a ns2:ReturnValue ;
        rdfs:comment "'version', 'prefix', or 'base' for a directive statement, 'triple' for anything else." .

    ns62:coerce_object dcterms:identifier "starlayer.graph.parsers.syntax.coerce_object" ;
        a ns2:Function ;
        rdfs:comment """Coerce a plain (unquoted) object-position token to a Python value
when the type is unambiguous - true/false to a Python bool, a bare
numeric literal to a correctly-typed Literal.

Only ever called for a token already known to be in *object* position
(a triple's object field, or an rdf:first collection element) - a bare
numeric literal or boolean is only legal there, never as a subject or
predicate, so this function doesn't need to (and must not) run for
those; turtle_parser._to_node() has no other path that accepts one,
which is what correctly rejects a fixture like the W3C Turtle 1.2
negative-syntax test using a bare integer as a subject.

Built directly as a Literal (not int/float) so INTEGER/DECIMAL/DOUBLE
stay distinguishable - a Python int/float can't tell "123e0" (DOUBLE)
from "123.0" (DECIMAL) from "123" (INTEGER) - and normalize=False
preserves the source document's exact lexical form (e.g. "04" stays
"04", not silently "4"), matching turtle_parser._to_node()'s
^^-typed-literal branch, which takes the same care for the same reason.""" ;
        rdfs:label "coerce_object" ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:coerce_object.param.s ;
        ns2:hasReturnValue ns62:coerce_object.returns ;
        ns2:lineEnd 68 ;
        ns2:lineStart 29 ;
        ns2:signature "def coerce_object(s)" .

    ns62:coerce_object.param.s a ns2:Parameter ;
        rdfs:comment "The unquoted object-position token text to coerce." ;
        rdfs:label "s" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns62:coerce_object.returns a ns2:ReturnValue ;
        rdfs:comment "True/False for \"true\"/\"false\", a correctly-typed xsd:double/ xsd:decimal/xsd:integer Literal for a bare numeric literal, or s unchanged if it doesn't match any of those shapes." .

    ns62:expand_triple_set dcterms:identifier "starlayer.graph.parsers.syntax.expand_triple_set" ;
        a ns2:Function ;
        rdfs:comment "Expand [ ] blank nodes and ( ) collections into flat triple dicts." ;
        rdfs:label "expand_triple_set" ;
        ns2:calls ns62:coerce_object, ns62:_parse_collection_elements, ns62:expand_triple_set, ns62:extract_fields ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:expand_triple_set.param.triple_set, ns62:expand_triple_set.param.blank_counter ;
        ns2:hasReturnValue ns62:expand_triple_set.returns ;
        ns2:lineEnd 795 ;
        ns2:lineStart 683 ;
        ns2:signature "def expand_triple_set(triple_set, blank_counter)" .

    ns62:expand_triple_set.param.blank_counter a ns2:Parameter ;
        rdfs:comment "A single-element list holding the next fresh blank-node suffix counter, shared across calls within one parse." ;
        rdfs:label "blank_counter" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns62:expand_triple_set.param.triple_set a ns2:Parameter ;
        rdfs:comment "A list of triple field dicts, as produced by extract_fields() (each with 'subject'/'predicate'/'object' and optionally 'annotations'/'object_str')." ;
        rdfs:label "triple_set" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns62:expand_triple_set.returns a ns2:ReturnValue ;
        rdfs:comment "A new list of triple field dicts with every [ ]/( ) shorthand object resolved to a plain blank-node subject/object, recursively re-expanded until none remain." .

    ns62:extract_fields dcterms:identifier "starlayer.graph.parsers.syntax.extract_fields" ;
        a ns2:Function ;
        rdfs:comment "Parse a single statement string into a fields dict." ;
        rdfs:label "extract_fields" ;
        ns2:calls ns62:_split_on_delimiter, ns62:coerce_object, ns61:split_obj_and_annotations, ns61:next_token, ns62:extract_fields ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:extract_fields.param.typ, ns62:extract_fields.param.stmt, ns62:extract_fields.param.blank_counter ;
        ns2:hasReturnValue ns62:extract_fields.returns ;
        ns2:instantiates ns58:Turtle12SyntaxError ;
        ns2:lineEnd 680 ;
        ns2:lineStart 552 ;
        ns2:signature "def extract_fields(stmt, typ, blank_counter=None)" .

    ns62:extract_fields.param.blank_counter a ns2:Parameter ;
        rdfs:comment "A single-element list holding the next fresh blank-node suffix counter, shared across calls within one parse so minted blank nodes (`_:sl_N`) don't collide; None disables blank-node-property-list/collection expansion in subject position (for a caller that doesn't need it, e.g. a directive statement)." ;
        rdfs:label "blank_counter" ;
        ns2:defaultValue "None" ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns62:extract_fields.param.stmt a ns2:Parameter ;
        rdfs:comment "A single statement string, as produced by split_statements()." ;
        rdfs:label "stmt" ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns62:extract_fields.param.typ a ns2:Parameter ;
        rdfs:comment "The statement's kind, as returned by classify_statement() - 'version', 'prefix', 'base', or 'triple'." ;
        rdfs:label "typ" ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns62:extract_fields.returns a ns2:ReturnValue ;
        rdfs:comment "A dict of the statement's fields - {'version': ...} for a VERSION directive, {'prefix': ..., 'iri': ...} for @prefix, {'iri': ...} for @base, or {'triple_set': [...]} for a triple statement (a list of subject/predicate/object/annotation field dicts) - or {} if the statement doesn't match its claimed type's grammar." .

    ns62:split_statements dcterms:identifier "starlayer.graph.parsers.syntax.split_statements" ;
        a ns2:Function ;
        rdfs:comment """Split Turtle text into a list of statement strings.

See split_statements_with_lines() for the same split with each
statement's approximate source line number attached.""" ;
        rdfs:label "split_statements" ;
        ns2:calls ns62:_split_statements_impl ;
        ns2:filePath "packages/starlayer/starlayer/graph/parsers/syntax.py" ;
        ns2:hasParameter ns62:split_statements.param.data ;
        ns2:hasReturnValue ns62:split_statements.returns ;
        ns2:lineEnd 504 ;
        ns2:lineStart 491 ;
