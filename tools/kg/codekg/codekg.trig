        rdfs:comment "A `(graph, root)` tuple - the RDF graph for the lowered 1.1 update, and the node for its root." ;
        ns2:annotationText "tuple[Graph, URIRef]" ;
        ns2:hasType ns5:rdflib.term.URIRef, ns5:rdflib.graph.Graph, ns5:builtins.tuple .

