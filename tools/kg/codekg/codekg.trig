    ns95:extract_subgraph dcterms:identifier "starlayer.shacl.subgraph_extraction.extract_subgraph" ;
        a ns2:Function ;
        rdfs:comment """Returns the subgraph covered by one shape+focus_node pair, or by
every real entry point a whole shapes graph declares.

Like ``StarLayerGraph.cbd()``, but the reachability rule is a SHACL
shape's own constraints instead of blank-node adjacency. See the
module docstring for the full design this follows, including the
four filter combinations and the unified return contract.

``shacl_graph`` is a raw shapes graph (already normalized by the caller,
matching ``evaluate()``'s own calling convention) - wrapped here into a
``pyshacl.ShapesGraph`` so ``lookup_shape_from_node``/shape harvesting
work the same way they do for ``_shape_conforms`` elsewhere in this
codebase. Wrapped over a *copy*, never the caller's own object:
``pyshacl.ShapesGraph.__init__``/``.shapes`` mutates whatever graph it's
given in place (injecting a couple of RDFS/OWL class-hierarchy axiom
triples for its own implicit-class-target support), which would
otherwise silently pollute the caller's ``shacl_graph`` as an unrelated
side effect of calling this function.

``shacl_graph=None`` falls back to ``data_graph`` itself - matching
``validate()``'s own "data graph doubles as shapes graph" allowance,
for a data file carrying its own embedded shapes.

``ont_graph``/``inference=``: entailment feeds the conformance re-check
and the extraction walk, but the returned triples are intersected back
against the real, pre-entailment ``data_graph`` before returning, so an
entailed-only triple never appears in the output - see the module
docstring's entailment section for the full design.""" ;
        rdfs:label "extract_subgraph" ;
        ns2:calls ns84:apply_entailment, ns95:_shape_conforms, ns95:_target_triples, ns95:_extract ;
        ns2:filePath "packages/starlayer/starlayer/shacl/subgraph_extraction.py" ;
        ns2:hasParameter ns95:extract_subgraph.param.inference, ns95:extract_subgraph.param.focus_node, ns95:extract_subgraph.param.shacl_graph, ns95:extract_subgraph.param.ont_graph, ns95:extract_subgraph.param.shape, ns95:extract_subgraph.param.data_graph, ns95:extract_subgraph.param.include_targets ;
        ns2:hasReturnValue ns95:extract_subgraph.returns ;
        ns2:instantiates ns32:StarLayerGraph ;
        ns2:lineEnd 642 ;
        ns2:lineStart 525 ;
        ns2:signature "def extract_subgraph(data_graph: Any, shacl_graph: Any | None=None, ont_graph: Any | None=None, *, shape: Any | None=None, focus_node: Any | None=None, inference: Any | None=None, include_targets: bool=True) -> Any" .

    ns95:extract_subgraph.param.data_graph a ns2:Parameter ;
        rdfs:comment "The full data graph - not a pre-narrowed candidate, since multi-hop paths/nested shapes mean the traversal's real reach can't be known in advance." ;
        rdfs:label "data_graph" ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns95:extract_subgraph.param.focus_node a ns2:Parameter ;
        rdfs:comment "Restrict to this one focus node. Omit to discover every real target ``pySHACL``'s own ``Shape.focus_nodes()`` resolves for each candidate shape (declared/implicit targets, including SPARQL-based ``sh:target``)." ;
        rdfs:label "focus_node" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 4 .

    ns95:extract_subgraph.param.include_targets a ns2:Parameter ;
        rdfs:comment "Also return the triples that make each focus node a target of its shape (``sh:targetClass``: its ``rdf:type`` and ``rdfs:subClassOf`` triples; ``sh:targetSubjectsOf`` / ``sh:targetObjectsOf``: the triples with that predicate). The Shape Fragments paper includes them (the shape is conjoined with its target), and without them the fragment no longer says why its nodes were chosen: validating it against the same shapes treats those nodes as no longer targeted and passes vacuously. ``sh:targetNode`` has no such triple. Default ``True``." ;
        rdfs:label "include_targets" ;
        ns2:annotationText "bool" ;
        ns2:defaultValue "True" ;
        ns2:hasType ns5:builtins.bool ;
        ns2:parameterKind "kwonly" ;
        ns2:position 6 .

    ns95:extract_subgraph.param.inference a ns2:Parameter ;
        rdfs:comment "An ``ENTAILMENT.*`` regime IRI, or an iterable of them." ;
        rdfs:label "inference" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 5 .

    ns95:extract_subgraph.param.ont_graph a ns2:Parameter ;
        rdfs:comment "Optional ontology graph feeding entailment." ;
        rdfs:label "ont_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 2 .

    ns95:extract_subgraph.param.shacl_graph a ns2:Parameter ;
        rdfs:comment "The shapes graph. Defaults to ``data_graph``." ;
        rdfs:label "shacl_graph" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns95:extract_subgraph.param.shape a ns2:Parameter ;
        rdfs:comment "Restrict to this one shape's own entry point(s). Omit to consider every (non-deactivated) shape in ``shacl_graph``." ;
        rdfs:label "shape" ;
        ns2:annotationText "Any | None" ;
        ns2:defaultValue "None" ;
        ns2:hasType ns5:typing.Any ;
        ns2:optional true ;
        ns2:parameterKind "kwonly" ;
        ns2:position 3 .

    ns95:extract_subgraph.returns a ns2:ReturnValue ;
        rdfs:comment "A new graph - the union of every conforming ``(shape, focus_node)`` pair's own extraction. Empty (never ``None``) if nothing conforms." ;
        ns2:annotationText "Any" ;
        ns2:hasType ns5:typing.Any .

