GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/__init__.py> {
    ns1:__init__.py dcterms:identifier "starlayer.__init__" ;
        a ns2:Module ;
        rdfs:comment """starlayer - the full StarLayer RDF 1.2 stack in one import.

**Deliberately minimal top-level surface (slimmed 2026-10-04).** `starlayer.graph`
is the rdflib replacement; `starlayer.shacl` is the pyshacl replacement;
`starlayer.sparql` adds `StarQuery`. This top level exists only to pick
which one you want - `StarLayerGraph`/`StarLayerDataset` from
`starlayer.graph`, `StarShaclSchema` from `starlayer.shacl`, `StarQuery`
from `starlayer.sparql` - not to carry up everything each of those
subpackages re-exports for its own rdflib-mirroring convenience
(`BNode`/`Literal`/`URIRef`/`Variable`/`Namespace`/`RDF`/`RDFS`/`XSD`/plain
`Graph`/`Dataset` all still live at `starlayer.graph`, same as before -
just not duplicated up here too) or RDF-1.2-specific value types scoped to
the graph layer (`TripleTerm`/`DirLangString` - also still at
`starlayer.graph`). Every name here is the exact same object as its source
subpackage's own export; nothing is redefined, wrapped, or copied.

For anything not re-exported here, import from the owning subpackage
directly (e.g. ``starlayer.graph.Namespace``,
``starlayer.sparql.srl.parse_ruleset`` (then ``RuleSet.infer()``/``.query()``),
``starlayer.shacl.apply_rules``).""" ;
        rdfs:label "__init__" ;
        ns2:filePath "packages/starlayer/starlayer/__init__.py" .
}

GRAPH <https://github.com/hidden-graph/starlayer/blob/main/packages/starlayer/starlayer/codekg/__init__.py> {
    ns3:__init__.py dcterms:identifier "starlayer.codekg.__init__" ;
        a ns2:Module ;
        rdfs:comment """starlayer.codekg - loader for the code knowledge graph extracted from
this project's own Python source.

Two files, two very different lifecycles:

- ``ontology.ttl`` is the hand-maintained vocabulary (``slkg:``/
  ``externaltype:``) this subpackage defines - never touched by the
  extractor, edited by hand like any other vocabulary in
  ``starlayer.starontology``.
- ``codekg.trig`` is the auto-generated dataset the extractor produces: one
  named graph per extracted module, wholesale-replaced on every extractor
  run (see ``starlayer.codekg.extractor``, built separately). It does not
  exist until the extractor has run at least once.

A third named graph, identified by ``CURATED_GRAPH_IRI``, holds the hand-maintained
curated layer: every ``curated/*.ttl`` file (the capabilities in ``functionality.ttl``,
the named queries in ``query-library.ttl``). It is read from those files on request,
``get_codekg_dataset(include_curated=True)``, and is never written into ``codekg.trig``.

Mirrors ``starlayer.starontology``'s own loader pattern: parse once,
never hand back a shared mutable object, copy out a fresh graph/dataset
per call instead.""" ;
        rdfs:label "__init__" ;
        ns2:declares ns4:get_codekg_dataset, ns4:get_ontology_graph, ns4:get_module_graph, ns4:_derive_demonstrated_by ;
        ns2:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        ns2:importsModule ns5:pathlib, ns5:__future__, ns5:typing, ns5:rdflib .

    ns4:_derive_demonstrated_by dcterms:identifier "starlayer.codekg.__init__._derive_demonstrated_by" ;
        a ns2:Function ;
        rdfs:comment """Add ``entity slkg:demonstratedBy example`` for each ``slkg:demonstratesIdentifier`` that names an extracted entity.

The curated files name code by dotted identifier (stable across refactors); this resolves them to the entities'
IRIs once the module graphs are loaded, the same way ``slkg:implementedByIdentifier`` is resolved at query time.""" ;
        rdfs:label "_derive_demonstrated_by" ;
        ns2:filePath "packages/starlayer/starlayer/codekg/__init__.py" ;
        ns2:hasParameter ns4:_derive_demonstrated_by.param.dataset, ns4:_derive_demonstrated_by.param.curated ;
        ns2:hasReturnValue ns4:_derive_demonstrated_by.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 146 ;
        ns2:lineStart 128 ;
        ns2:signature "def _derive_demonstrated_by(dataset: StarLayerDataset, curated: StarLayerGraph) -> None" .

    ns4:_derive_demonstrated_by.param.curated a ns2:Parameter ;
        rdfs:label "curated" ;
        ns2:annotationText "StarLayerGraph" ;
        ns2:hasType ns5:starlayer.graph.graph.starlayer_graph.StarLayerGraph ;
        ns2:parameterKind "positional" ;
        ns2:position 1 .

    ns4:_derive_demonstrated_by.param.dataset a ns2:Parameter ;
        rdfs:label "dataset" ;
        ns2:annotationText "StarLayerDataset" ;
        ns2:hasType ns5:starlayer.graph.graph.starlayer_dataset.StarLayerDataset ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns4:_derive_demonstrated_by.returns a ns2:ReturnValue ;
        ns2:annotationText "None" ;
        ns2:optional true .

