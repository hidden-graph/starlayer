    ns25:engine_aborts_on_dirlang_equality dcterms:identifier "starlayer.graph.backends.native.engine_aborts_on_dirlang_equality" ;
        a ns2:Function ;
        rdfs:comment """Whether this store's engine is Oxigraph, whose SPARQL ``=`` aborts the whole
