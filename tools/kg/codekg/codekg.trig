        ns2:annotationText "Graph" ;
        ns2:hasType ns5:rdflib.graph.Graph ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns134:_preflight.returns a ns2:ReturnValue ;
        ns2:annotationText "list[tuple]" ;
        ns2:hasType ns5:builtins.list, ns5:builtins.tuple .

