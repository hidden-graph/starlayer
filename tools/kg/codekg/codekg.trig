    ns65:patch_sum_avg_errors_are_unbound.returns a ns2:ReturnValue ;
        ns2:annotationText "bool" ;
        ns2:hasType ns5:builtins.bool .

    ns65:patch_timezone_keeps_minutes dcterms:identifier "starlayer.graph.query.builtin_error_patches.patch_timezone_keeps_minutes" ;
        a ns2:Function ;
        rdfs:comment """``TIMEZONE("...-05:30"^^xsd:dateTime)`` is ``"-PT5H30M"``; rdflib
computed the minutes with Python 3 true division (a float, never truthy
at the right moment) and lost them, and answered ``P0D`` for a zero
offset where fn:timezone-from-dateTime gives ``PT0S``.""" ;
        rdfs:label "patch_timezone_keeps_minutes" ;
        ns2:calls ns65:_is_marked, ns65:_marked, ns65:_expression_comp ;
