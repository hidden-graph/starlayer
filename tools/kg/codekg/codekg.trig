        ns2:hasParameter ns77:TripleTermAdapter._decode_node_for_graph.param.value, ns77:TripleTermAdapter._decode_node_for_graph.param.graph ;
        ns2:hasReturnValue ns77:TripleTermAdapter._decode_node_for_graph.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 715 ;
        ns2:lineStart 664 ;
        ns2:signature "def _decode_node_for_graph(self, value: Any, graph: Any) -> Any" .

