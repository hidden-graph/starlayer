    ns19:_reject_blank_nodes_in_delete dcterms:identifier "starlayer.sparql.parse12._reject_blank_nodes_in_delete" ;
        a ns2:Function ;
        rdfs:comment """SPARQL Update forbids a blank node appearing in ``DELETE DATA``'s
``QuadData`` or in ``Modify``'s ``DELETE`` template - deleting requires
matching a specific, already-existing term, and a blank node (whether
written directly as ``_:x`` or minted implicitly by an anonymous
``{| ... |}`` annotation reifier - see ``grammar12.py``'s ``_reify``)
can never identify one. Plain, unmodified rdflib doesn't enforce this
syntactically either, so it's checked here, post-translate, against the
two operation shapes that carry a delete template: ``DeleteData.triples``/
``.quads`` directly, ``DeleteWhere`` (GitHub issue #135: it silently matched nothing), and ``Modify.delete.triples``/``.quads``
(``Modify.delete`` is ``None`` for an INSERT-only Modify, per
``algebra.translateUpdate1``).""" ;
        rdfs:label "_reject_blank_nodes_in_delete" ;
        ns2:calls ns19:_check_no_variables, ns19:_check_no_blank_nodes ;
        ns2:filePath "packages/starlayer/starlayer/sparql/parse12.py" ;
        ns2:hasParameter ns19:_reject_blank_nodes_in_delete.param.update ;
        ns2:hasReturnValue ns19:_reject_blank_nodes_in_delete.returns ;
        ns2:isPrivate true ;
        ns2:lineEnd 275 ;
        ns2:lineStart 242 ;
        ns2:signature "def _reject_blank_nodes_in_delete(update: Update) -> Update" .

    ns19:_reject_blank_nodes_in_delete.param.update a ns2:Parameter ;
        rdfs:comment "The translated ``Update`` to check." ;
        rdfs:label "update" ;
        ns2:annotationText "Update" ;
        ns2:hasType ns5:rdflib.plugins.sparql.sparql.Update ;
        ns2:parameterKind "positional" ;
        ns2:position 0 .

    ns19:_reject_blank_nodes_in_delete.returns a ns2:ReturnValue ;
        rdfs:comment "``update`` unchanged, if no blank node was found in a delete template." ;
        ns2:annotationText "Update" ;
        ns2:hasType ns5:rdflib.plugins.sparql.sparql.Update .

