    ns65:patch_empty_values_clause dcterms:identifier "starlayer.graph.query.builtin_error_patches.patch_empty_values_clause" ;
        a ns2:Function ;
        rdfs:comment """``VALUES ?a { }`` and ``VALUES () { () }`` crashed (``AttributeError:
... has no attribute 'name'``) because ``translateValues`` returned a bare
``[]`` instead of a ``Values`` node. Zero rows give no solutions; ``()``
rows over zero variables each give one empty solution (grammar rules
InlineDataOneVar / InlineDataFull).""" ;
        rdfs:label "patch_empty_values_clause" ;
        ns2:calls ns65:_marked, ns65:_is_marked ;
        ns2:filePath "packages/starlayer/starlayer/graph/query/builtin_error_patches.py" ;
