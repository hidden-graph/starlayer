    ns57:_split_iri dcterms:identifier "starlayer.graph.serializers.rdfxml12._split_iri" ;
        a ns2:Function ;
        rdfs:comment """Split an IRI into (namespace_uri, local_name).

Tries '#' first, then '/'.  Raises ValueError if the local name cannot
form a valid XML name start character.""" ;
        rdfs:label "_split_iri" ;
        ns2:filePath "packages/starlayer/starlayer/graph/serializers/rdfxml12.py" ;
