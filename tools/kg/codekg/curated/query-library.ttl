        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "symbol"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:STRSTARTS ;
            spexpr:arg1 "file"^^spexpr:Variable ;
            spexpr:arg2 "packages/starlayer/starlayer/"
        ] ;
        tree:ord 5
    ], [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "prefix"^^spexpr:Variable
        ] ;
        tree:ord 0
    ], [
        a sqe:Filter ;
        sqe:expr [
            a sqe:NotExists ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object "testFile"^^spexpr:Variable ;
                sqe:predicate slkg:filePath ;
                sqe:subject "t"^^spexpr:Variable ;
                tree:ord 1
            ], [
                a sqe:Filter ;
                sqe:expr [
                    a spexpr:STRSTARTS ;
                    spexpr:arg1 "testFile"^^spexpr:Variable ;
                    spexpr:arg2 "packages/starlayer/tests/"
                ] ;
                tree:ord 2
            ], [
                a sqe:TriplePattern ;
                sqe:object "f"^^spexpr:Variable ;
                sqe:predicate slkg:calls ;
                sqe:subject "t"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 8
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "file"^^spexpr:Variable ;
        sqe:predicate slkg:filePath ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "f"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 9
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "type"^^spexpr:Variable ;
            spexpr:op "IN"^^spexpr:PlainString ;
            spexpr:other [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:Function
            ], [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:Method
            ]
        ] ;
        tree:ord 4
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "prefix"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:STRSTARTS ;
                spexpr:arg1 "symbol"^^spexpr:Variable ;
                spexpr:arg2 "prefix"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 6
    ], [
        a sqe:Filter ;
        sqe:expr [
            a sqe:NotExists ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object true ;
                sqe:predicate slkg:isPrivate ;
                sqe:subject "f"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 7
    ], [
        a sqe:TriplePattern ;
        sqe:object "type"^^spexpr:Variable ;
        sqe:predicate rdf:type ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 2
    ] .

ql:upstream-workarounds a slkg:NamedQuery ;
    rdfs:comment "The documented bugs in rdflib, pySHACL, Fuseki and Oxigraph and the code that works around each, optionally limited to one library or to one symbol (to ask whether a function exists because of an upstream bug). The curated list is in curated/upstream-issues.ttl; the write-ups are in docs/upstream-issues/." ;
    rdfs:label "Which code works around a bug in a library we build on?" ;
    slkg:aboutTopic ql:topic-upstream-bugs ;
    slkg:answersCompetencyQuestion ql:cq-which-functions-exist-specifically-to-work-around ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "only issues in this library: rdflib, pyshacl, fuseki or oxigraph" ;
        slkg:paramExample "pyshacl" ;
        slkg:paramName "project" ;
        slkg:paramRequired false
    ], [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a function to ask about" ;
        slkg:paramExample "starlayer.shacl.validator.StarShaclProcessor.validate" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired false
    ] ;
    slkg:queryRoot ql:upstream-workarounds-tree .

ql:upstream-workarounds-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "workaround"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:OrderCondition ;
        sqe:expr "upstream"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:OrderCondition ;
        sqe:expr "number"^^spexpr:Variable ;
        tree:ord 1
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "issue"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 4 ;
        tree:value "workaround"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 6 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 5 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "upstream"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "number"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "status"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "issue"^^spexpr:Variable ;
        sqe:predicate rdfs:label ;
        sqe:subject "i"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "project"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:RelationalExpression ;
                spexpr:expr [
                    a spexpr:LCASE ;
                    spexpr:arg "upstream"^^spexpr:Variable
                ] ;
                spexpr:op "="^^spexpr:PlainString ;
                spexpr:other [
                    a spexpr:LCASE ;
                    spexpr:arg "project"^^spexpr:Variable
                ] ;
                tree:ord 0
            ]
        ] ;
        tree:ord 8
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "workaround"^^spexpr:Variable ;
            sqe:predicate slkg:workedAroundByIdentifier ;
            sqe:subject "i"^^spexpr:Variable ;
            tree:ord 0
        ], [
            a sqe:Optional ;
            sqe:where [
                a sqe:Optional ;
                sqe:where [
                    a sqe:TriplePattern ;
                    sqe:object "file"^^spexpr:Variable ;
                    sqe:predicate slkg:filePath ;
                    sqe:subject "s"^^spexpr:Variable ;
                    tree:ord 0
                ] ;
                tree:ord 1
            ], [
                a sqe:Optional ;
                sqe:where [
                    a sqe:TriplePattern ;
                    sqe:object "line"^^spexpr:Variable ;
                    sqe:predicate slkg:lineStart ;
                    sqe:subject "s"^^spexpr:Variable ;
                    tree:ord 0
                ] ;
                tree:ord 2
            ], [
                a sqe:TriplePattern ;
                sqe:object "workaround"^^spexpr:Variable ;
                sqe:predicate dcterms:identifier ;
                sqe:subject "s"^^spexpr:Variable ;
                tree:ord 0
            ] ;
            tree:ord 1
        ] ;
        tree:ord 7
    ], [
        a sqe:TriplePattern ;
        sqe:object "status"^^spexpr:Variable ;
        sqe:predicate slkg:issueStatus ;
        sqe:subject "i"^^spexpr:Variable ;
        tree:ord 4
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "symbol"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:RelationalExpression ;
                spexpr:expr "workaround"^^spexpr:Variable ;
                spexpr:op "="^^spexpr:PlainString ;
                spexpr:other "symbol"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 9
    ], [
        a sqe:TriplePattern ;
        sqe:object "upstream"^^spexpr:Variable ;
        sqe:predicate slkg:upstreamProject ;
        sqe:subject "i"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:TriplePattern ;
        sqe:object slkg:UpstreamIssue ;
        sqe:predicate rdf:type ;
        sqe:subject "i"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "symbol"^^spexpr:Variable
        ] ;
        tree:ord 1
    ], [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "project"^^spexpr:Variable
        ] ;
        tree:ord 0
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "number"^^spexpr:Variable ;
            sqe:predicate slkg:issueNumber ;
            sqe:subject "i"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 6
    ] .

ql:who-instantiates a slkg:NamedQuery ;
    rdfs:comment "The functions and methods that construct an instance of a class." ;
    rdfs:label "Where is a class instantiated?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-which-classes-are-ever-instantiated-and-from ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a class" ;
        slkg:paramExample "starlayer.graph.core.StarLayerGraph" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:who-instantiates-tree .

ql:who-instantiates-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "constructor"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "constructor"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "file"^^spexpr:Variable ;
            sqe:predicate slkg:filePath ;
            sqe:subject "f"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 3
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "class"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "constructor"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "class"^^spexpr:Variable ;
        sqe:predicate slkg:instantiates ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "f"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 4
    ] .