# The code-KG query library: the named queries, the topics they belong to and the competency questions they
# answer. This file is the source: edit it directly (there is no build step that regenerates it). Each query is
# an sqe: tree (the RDF form of a SPARQL query, see starlayer.sparql.sqe) reached through slkg:queryRoot.
# `python scripts/build_query_catalogue.py` validates it against the shapes and rewrites the readable catalogue.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ql: <https://github.com/hidden-graph/starlayer/ns/codekg/curated/query-library#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix slkg: <https://github.com/hidden-graph/starlayer/ns/codekg#> .
@prefix spexpr: <https://github.com/hidden-graph/starlayer/ns/sparql/expr#> .
@prefix sqe: <https://github.com/hidden-graph/starlayer/ns/sparql/query-edit#> .
@prefix tree: <https://github.com/hidden-graph/starlayer/ns/tree#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ql:call-chain-from a slkg:NamedQuery ;
    rdfs:comment "All functions and methods reachable from a symbol by following calls any number of steps (a property-path query). Large for entry points; narrow the symbol first." ;
    rdfs:label "Everything a function reaches through calls" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-what-s-the-call-chain-from-entry ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of the starting function or method" ;
        slkg:paramExample "starlayer.graph.core._Base.infer" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:call-chain-from-tree .

ql:call-chain-from-tree a sqe:Query, sqe:SelectQuery ;
    sqe:distinct true ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "reached"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "reached"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "reached"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "b"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "b"^^spexpr:Variable ;
        sqe:predicate [
            a spexpr:PathElt ;
            spexpr:mod "+" ;
            spexpr:path slkg:calls
        ] ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 0
    ] .

ql:call-cycles a slkg:NamedQuery ;
    rdfs:comment "Direct two-step call cycles (A calls B and B calls A). Longer cycles are not found." ;
    rdfs:label "Pairs of functions that call each other" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-are-there-call-cycles-a-calls-b ;
    slkg:queryRoot ql:call-cycles-tree .

ql:call-cycles-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "second"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:OrderCondition ;
        sqe:expr "first"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "first"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "second"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "a"^^spexpr:Variable ;
        sqe:predicate slkg:calls ;
        sqe:subject "b"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "b"^^spexpr:Variable ;
        sqe:predicate slkg:calls ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "first"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr [
                a spexpr:STR ;
                spexpr:arg "a"^^spexpr:Variable
            ] ;
            spexpr:op "<"^^spexpr:PlainString ;
            spexpr:other [
                a spexpr:STR ;
                spexpr:arg "b"^^spexpr:Variable
            ]
        ] ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "second"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "b"^^spexpr:Variable ;
        tree:ord 3
    ] .

ql:callees-of a slkg:NamedQuery ;
    rdfs:comment "The direct callees of a symbol, from the call graph." ;
    rdfs:label "What does a function or method call?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-what-functions-methods-does-function-x-call ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a function or method" ;
        slkg:paramExample "starlayer.graph.core._Base.infer" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:callees-of-tree .

ql:callees-of-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "callee"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "callee"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "file"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "file"^^spexpr:Variable ;
            sqe:predicate slkg:filePath ;
            sqe:subject "t"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 3
    ], [
        a sqe:TriplePattern ;
        sqe:object "callee"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "t"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "t"^^spexpr:Variable ;
        sqe:predicate slkg:calls ;
        sqe:subject "c"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "c"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "t"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 4
    ] .

ql:callers-of a slkg:NamedQuery ;
    rdfs:comment "The direct callers of a symbol, from the call graph. No rows means no caller this extractor could resolve, which is a lead, not proof that nothing calls it." ;
    rdfs:label "Who calls a function or method?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:answersCompetencyQuestion ql:cq-if-i-change-x-s-signature-what, ql:cq-what-calls-function-x-reverse-lookup ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a function or method" ;
        slkg:paramExample "starlayer.graph.interop.to_basic" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:callers-of-tree .

ql:callers-of-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "caller"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "caller"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "caller"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "c"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "file"^^spexpr:Variable ;
            sqe:predicate slkg:filePath ;
            sqe:subject "c"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 3
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "target"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "c"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "target"^^spexpr:Variable ;
        sqe:predicate slkg:calls ;
        sqe:subject "c"^^spexpr:Variable ;
        tree:ord 0
    ] .

ql:capabilities a slkg:NamedQuery ;
    rdfs:comment "The curated capability list with the symbols that implement each, optionally limited to words in the capability text. Capabilities with no implementing symbol are roadmap items or are implemented by a SHACL or OWL file." ;
    rdfs:label "What StarLayer does, and which code does it" ;
    slkg:aboutTopic ql:topic-capabilities ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "only capabilities whose description contains this, case-insensitive" ;
        slkg:paramExample "SHACL" ;
        slkg:paramName "text" ;
        slkg:paramRequired false
    ] ;
    slkg:queryRoot ql:capabilities-tree .

ql:capabilities-by-role a slkg:NamedQuery ;
    rdfs:comment "The capabilities tagged with an app role (storage, interchange, query, validate, infer, ui-generate or reference), with the symbols that implement each. Start here when you know what the app must do but not which StarLayer parts to use." ;
    rdfs:label "Which capabilities serve a job when building an app?" ;
    slkg:aboutTopic ql:topic-capabilities ;
    slkg:answersCompetencyQuestion ql:cq-which-capabilities-serve-a-job-when-building-an-app ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "the job: storage, interchange, query, validate, infer, ui-generate or reference" ;
        slkg:paramExample "ui-generate" ;
        slkg:paramName "role" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:capabilities-by-role-tree .

ql:capabilities-by-role-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "capability"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:OrderCondition ;
        sqe:expr "area"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:OrderCondition ;
        sqe:expr "symbol"^^spexpr:Variable ;
        tree:ord 2
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 5 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 4 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "symbol"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "capability"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "status"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "area"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object slkg:Capability ;
        sqe:predicate rdf:type ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "role"^^spexpr:Variable ;
        sqe:predicate slkg:appRole ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:TriplePattern ;
        sqe:object "a"^^spexpr:Variable ;
        sqe:predicate slkg:inCapabilityArea ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate slkg:implementedByIdentifier ;
            sqe:subject "cap"^^spexpr:Variable ;
            tree:ord 0
        ], [
            a sqe:Optional ;
            sqe:where [
                a sqe:Optional ;
                sqe:where [
                    a sqe:TriplePattern ;
                    sqe:object "line"^^spexpr:Variable ;
                    sqe:predicate slkg:lineStart ;
                    sqe:subject "s"^^spexpr:Variable ;
                    tree:ord 0
                ] ;
                tree:ord 2
            ], [
                a sqe:Optional ;
                sqe:where [
                    a sqe:TriplePattern ;
                    sqe:object "file"^^spexpr:Variable ;
                    sqe:predicate slkg:filePath ;
                    sqe:subject "s"^^spexpr:Variable ;
                    tree:ord 0
                ] ;
                tree:ord 1
            ], [
                a sqe:TriplePattern ;
                sqe:object "symbol"^^spexpr:Variable ;
                sqe:predicate dcterms:identifier ;
                sqe:subject "s"^^spexpr:Variable ;
                tree:ord 0
            ] ;
            tree:ord 1
        ] ;
        tree:ord 6
    ], [
        a sqe:TriplePattern ;
        sqe:object "area"^^spexpr:Variable ;
        sqe:predicate rdfs:label ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:TriplePattern ;
        sqe:object "capability"^^spexpr:Variable ;
        sqe:predicate rdfs:comment ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "status"^^spexpr:Variable ;
        sqe:predicate slkg:hasStatus ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 4
    ] .

ql:capabilities-by-specification a slkg:NamedQuery ;
    rdfs:comment "The capabilities that implement a W3C specification (wholly or in part), with the symbols that implement each; optionally limited to specifications whose IRI contains some text, such as shacl12-core or sparql12." ;
    rdfs:label "Which capabilities implement a specification?" ;
    slkg:aboutTopic ql:topic-capabilities ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "only specifications whose IRI contains this, case-insensitive" ;
        slkg:paramExample "shacl12" ;
        slkg:paramName "spec" ;
        slkg:paramRequired false
    ] ;
    slkg:queryRoot ql:capabilities-by-specification-tree .

ql:capabilities-by-specification-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "capability"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:OrderCondition ;
        sqe:expr "symbol"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:OrderCondition ;
        sqe:expr "specification"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:OrderCondition ;
        sqe:expr "area"^^spexpr:Variable ;
        tree:ord 1
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 6 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "capability"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "specification"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "area"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 5 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "status"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 4 ;
        tree:value "symbol"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "capability"^^spexpr:Variable ;
        sqe:predicate rdfs:comment ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:TriplePattern ;
        sqe:object "status"^^spexpr:Variable ;
        sqe:predicate slkg:hasStatus ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "area"^^spexpr:Variable ;
        sqe:predicate rdfs:label ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 6
    ], [
        a sqe:TriplePattern ;
        sqe:object "a"^^spexpr:Variable ;
        sqe:predicate slkg:inCapabilityArea ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "spec"^^spexpr:Variable
        ] ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "specification"^^spexpr:Variable ;
        sqe:predicate slkg:implementsSpecification ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:TriplePattern ;
        sqe:object slkg:Capability ;
        sqe:predicate rdf:type ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "spec"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:CONTAINS ;
                spexpr:arg1 [
                    a spexpr:LCASE ;
                    spexpr:arg [
                        a spexpr:STR ;
                        spexpr:arg "specification"^^spexpr:Variable
                    ]
                ] ;
                spexpr:arg2 [
                    a spexpr:LCASE ;
                    spexpr:arg "spec"^^spexpr:Variable
                ] ;
                tree:ord 0
            ]
        ] ;
        tree:ord 7
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:Optional ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object "symbol"^^spexpr:Variable ;
                sqe:predicate dcterms:identifier ;
                sqe:subject "s"^^spexpr:Variable ;
                tree:ord 0
            ], [
                a sqe:Optional ;
                sqe:where [
                    a sqe:TriplePattern ;
                    sqe:object "file"^^spexpr:Variable ;
                    sqe:predicate slkg:filePath ;
                    sqe:subject "s"^^spexpr:Variable ;
                    tree:ord 0
                ] ;
                tree:ord 1
            ], [
                a sqe:Optional ;
                sqe:where [
                    a sqe:TriplePattern ;
                    sqe:object "line"^^spexpr:Variable ;
                    sqe:predicate slkg:lineStart ;
                    sqe:subject "s"^^spexpr:Variable ;
                    tree:ord 0
                ] ;
                tree:ord 2
            ] ;
            tree:ord 1
        ], [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate slkg:implementedByIdentifier ;
            sqe:subject "cap"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 8
    ] .

ql:capabilities-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "area"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:OrderCondition ;
        sqe:expr "capability"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:OrderCondition ;
        sqe:expr "symbol"^^spexpr:Variable ;
        tree:ord 2
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "capability"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 4 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "symbol"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "status"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 5 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "area"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "text"^^spexpr:Variable
        ] ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "status"^^spexpr:Variable ;
        sqe:predicate slkg:hasStatus ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object slkg:Capability ;
        sqe:predicate rdf:type ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:Optional ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object "symbol"^^spexpr:Variable ;
                sqe:predicate dcterms:identifier ;
                sqe:subject "s"^^spexpr:Variable ;
                tree:ord 0
            ], [
                a sqe:Optional ;
                sqe:where [
                    a sqe:TriplePattern ;
                    sqe:object "line"^^spexpr:Variable ;
                    sqe:predicate slkg:lineStart ;
                    sqe:subject "s"^^spexpr:Variable ;
                    tree:ord 0
                ] ;
                tree:ord 2
            ], [
                a sqe:Optional ;
                sqe:where [
                    a sqe:TriplePattern ;
                    sqe:object "file"^^spexpr:Variable ;
                    sqe:predicate slkg:filePath ;
                    sqe:subject "s"^^spexpr:Variable ;
                    tree:ord 0
                ] ;
                tree:ord 1
            ] ;
            tree:ord 1
        ], [
            a sqe:TriplePattern ;
            sqe:object "symbol"^^spexpr:Variable ;
            sqe:predicate slkg:implementedByIdentifier ;
            sqe:subject "cap"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 7
    ], [
        a sqe:TriplePattern ;
        sqe:object "area"^^spexpr:Variable ;
        sqe:predicate rdfs:label ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "text"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:CONTAINS ;
                spexpr:arg1 [
                    a spexpr:LCASE ;
                    spexpr:arg "capability"^^spexpr:Variable
                ] ;
                spexpr:arg2 [
                    a spexpr:LCASE ;
                    spexpr:arg "text"^^spexpr:Variable
                ] ;
                tree:ord 0
            ]
        ] ;
        tree:ord 6
    ], [
        a sqe:TriplePattern ;
        sqe:object "a"^^spexpr:Variable ;
        sqe:predicate slkg:inCapabilityArea ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "capability"^^spexpr:Variable ;
        sqe:predicate rdfs:comment ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 3
    ] .

ql:capability-of-symbol a slkg:NamedQuery ;
    rdfs:comment "The curated capability, if any, that names a symbol as its implementation." ;
    rdfs:label "Which capability does a symbol implement?" ;
    slkg:aboutTopic ql:topic-capabilities ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of the implementing symbol" ;
        slkg:paramExample "starlayer.graph.core.StarLayerGraph" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:capability-of-symbol-tree .

ql:capability-of-symbol-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "area"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:OrderCondition ;
        sqe:expr "capability"^^spexpr:Variable ;
        tree:ord 1
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "capability"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "area"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "status"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "capability"^^spexpr:Variable ;
        sqe:predicate rdfs:comment ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate slkg:implementedByIdentifier ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "area"^^spexpr:Variable ;
        sqe:predicate rdfs:label ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:TriplePattern ;
        sqe:object "status"^^spexpr:Variable ;
        sqe:predicate slkg:hasStatus ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:TriplePattern ;
        sqe:object "a"^^spexpr:Variable ;
        sqe:predicate slkg:inCapabilityArea ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object slkg:Capability ;
        sqe:predicate rdf:type ;
        sqe:subject "cap"^^spexpr:Variable ;
        tree:ord 0
    ] .

ql:cq-are-there-call-cycles-a-calls-b a slkg:CompetencyQuestion ;
    rdfs:comment "a query over call edges, no separate extraction step." ;
    rdfs:label "Are there call cycles (A calls B calls A)?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-does-method-x-on-a-subclass-override a slkg:CompetencyQuestion ;
    rdfs:comment "`slkg:overrides`, built 2026-10-14, originally scoped to same-file bases only, generalized project-wide the same day by reusing `SymbolIndex.resolve_method_in_chain()` (the identical cross-file walk already used for `self`/`cls` call resolution) instead of a separate same-file-only helper. Checked against the real codebase: 7 real cross-file override edges - `starontology/manchester.py`'s `_AstCursor` genuinely subclasses `graph/manchester/parser.py`'s `_Cursor` and overrides 7 of its methods - invisible under the earlier same-file-only scope, now surfaced. The handful of same-file inheritance pairs still redeclare no shared method names, consistent with this codebase's documented composition-over-inheritance style." ;
    rdfs:label "Does method X on a subclass override a same-named method on a base class?" ;
    slkg:aboutTopic ql:topic-inheritance ;
    slkg:cqStatus "answerable" .

ql:cq-does-this-function-have-a-test-that a slkg:CompetencyQuestion ;
    rdfs:comment "a `slkg:calls` edge from a `tests.`-prefixed function to it (same caveats as the rest of the call graph: a test that exercises a function only through an unresolvable indirection won't show up)." ;
    rdfs:label "Does this function have a test that exercises it?" ;
    slkg:aboutTopic ql:topic-testing ;
    slkg:cqStatus "answerable" .

ql:cq-finer-grained-coupling-which-function-in-module a slkg:CompetencyQuestion ;
    rdfs:comment "now answerable directly via `slkg:calls`, subject to the same resolution-confidence caveats noted above." ;
    rdfs:label "Finer-grained coupling (which *function* in module A calls which *function* in module B)" ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:cqStatus "answerable" .

ql:cq-if-i-change-x-s-signature-what a slkg:CompetencyQuestion ;
    rdfs:label "If I change X's signature, what else might break (direct callers)?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-is-a-given-function-class-method-public a slkg:CompetencyQuestion ;
    rdfs:label "Is a given function/class/method public or private (leading-underscore convention)?" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:cqStatus "answerable" .

ql:cq-is-a-private-function-called-from-outside a slkg:CompetencyQuestion ;
    rdfs:comment "a query joining `isPrivate` with `slkg:calls`'s source module against the private entity's own module." ;
    rdfs:label "Is a \"private\" function called from outside its own module anyway (a leaky abstraction)?" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:cqStatus "answerable" .

ql:cq-is-this-function-ever-called-by-anything a slkg:CompetencyQuestion ;
    rdfs:comment "zero incoming `slkg:calls` edges. **Caveat inherited directly from the call graph's own resolution limits**: zero incoming edges means \"never called in a way this extractor could confidently resolve\" - a function called only through a pattern it can't resolve (a local variable holding a function reference, a dynamic dispatch, a decorator-wrapped indirect call) will show as unreferenced even though it genuinely isn't dead. Treat a \"zero callers\" result as a lead to check, not a proof." ;
    rdfs:label "Is this function ever called by anything, anywhere in the codebase?" ;
    slkg:aboutTopic ql:topic-dead-code ;
    slkg:cqStatus "answerable" .

ql:cq-is-this-parameter-ever-passed-a-non a slkg:CompetencyQuestion ;
    rdfs:comment "harder than the rest: requires resolving real argument values at every call site (positional/keyword/splat), not just whether a call exists. Lower-fidelity, may not be worth building; revisit if it turns out to matter." ;
    rdfs:label "Is this parameter ever passed a non-default value anywhere?" ;
    slkg:aboutTopic ql:topic-dead-code ;
    slkg:cqStatus "roadmap" .

ql:cq-what-are-a-function-method-s-parameters a slkg:CompetencyQuestion ;
    rdfs:comment "name, type, optional, default value?" ;
    rdfs:label "What are a function/method's parameters" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-calls-function-x-reverse-lookup a slkg:CompetencyQuestion ;
    rdfs:label "What calls function X (reverse lookup)?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-what-classes-functions-and-methods-does-a a slkg:CompetencyQuestion ;
    rdfs:label "What classes, functions, and methods does a given module define?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-does-a-class-inherit-from-what a slkg:CompetencyQuestion ;
    rdfs:label "What does a class inherit from? What attributes/decorators does it have?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-does-a-function-method-return-and a slkg:CompetencyQuestion ;
    rdfs:label "What does a function/method return, and what type?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-does-a-given-module-import-at a slkg:CompetencyQuestion ;
    rdfs:label "What does a given module import (at the module level)?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-functions-methods-does-function-x-call a slkg:CompetencyQuestion ;
    rdfs:label "What functions/methods does function X call?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-what-s-the-call-chain-from-entry a slkg:CompetencyQuestion ;
    rdfs:comment "a `slkg:calls+` property-path query." ;
    rdfs:label "What's the call chain from entry point A down to low-level function B?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-what-s-the-cleaned-docstring-summary-for a slkg:CompetencyQuestion ;
    rdfs:label "What's the cleaned docstring/summary for a given class/function/method/module?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:cqStatus "answerable" .

ql:cq-what-s-the-public-api-surface-of a slkg:CompetencyQuestion ;
    rdfs:label "What's the public API surface of a module/package (everything not underscore-prefixed)?" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:cqStatus "answerable" .

ql:cq-which-capabilities-serve-a-job-when-building-an-app a slkg:CompetencyQuestion ;
    rdfs:comment "from each capability's slkg:appRole tag, a hand-curated layer" ;
    rdfs:label "Which capabilities serve a job when building an app (storage, query, validate, infer, ui-generate)?" ;
    slkg:aboutTopic ql:topic-capabilities ;
    slkg:cqStatus "answerable" .

ql:cq-which-classes-are-ever-instantiated-and-from a slkg:CompetencyQuestion ;
    rdfs:comment "`slkg:instantiates` (Function→Class), built 2026-10-14 as a separate property from `slkg:calls` rather than widening its range - \"calls a function\" and \"constructs an instance\" are different relationships. Resolved the same way bare/attribute calls are (same-file nesting, import table, module aliases), just checked against `classes_by_dotted_path` too. Verified against the real codebase: 1135 real `slkg:instantiates` edges, e.g. several modules' own helper functions constructing `TripleTerm(...)`, where the same call previously resolved to nothing at all." ;
    rdfs:label "Which classes are ever instantiated, and from where?" ;
    slkg:aboutTopic ql:topic-call-graph ;
    slkg:cqStatus "answerable" .

ql:cq-which-functions-cite-a-specific-w3c-spec a slkg:CompetencyQuestion ;
    rdfs:comment "deliberately out of scope for this graph (explicit decision); if wanted, build as a separate index outside `codekg`, not inside it." ;
    rdfs:label "Which functions cite a specific W3C spec section as their rationale?" ;
    slkg:aboutTopic ql:topic-specifications ;
    slkg:cqStatus "out-of-scope" .

ql:cq-which-functions-exist-specifically-to-work-around a slkg:CompetencyQuestion ;
    rdfs:comment "a hand-maintained list, curated/upstream-issues.ttl, since this is not derivable from the code; it names each workaround by identifier and the write-up in docs/upstream-issues/" ;
    rdfs:label "Which functions exist specifically to work around a known upstream bug (rdflib/pyshacl/etc.), and which bug?" ;
    slkg:aboutTopic ql:topic-upstream-bugs ;
    slkg:cqStatus "answerable" .

ql:cq-which-functions-have-zero-test-coverage-by a slkg:CompetencyQuestion ;
    rdfs:comment "zero incoming `slkg:calls` edges from any `tests.`-prefixed caller." ;
    rdfs:label "Which functions have zero test coverage (by this graph's own definition)?" ;
    slkg:aboutTopic ql:topic-testing ;
    slkg:cqStatus "answerable" .

ql:cq-which-public-functions-have-no-docstring-already a slkg:CompetencyQuestion ;
    rdfs:comment "doesn't need the public/private flag added, though the flag makes the query cleaner.)" ;
    rdfs:label "Which public functions have no docstring? (already answerable via existing `rdfs:comment` presence/absence" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:cqStatus "answerable" .

ql:cq-which-starlayer-modules-import-which-other-starlayer a slkg:CompetencyQuestion ;
    rdfs:comment "not answerable yet: `slkg:importsModule` only records imports of *external* modules (third-party and standard library); imports between this project's own modules are not extracted. Found 2026-10-19 while building the query library. Use the call graph (`slkg:calls`) for dependencies inside the project." ;
    rdfs:label "Which starlayer modules import which other starlayer modules?" ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:cqStatus "roadmap" .

ql:cq-which-two-subpackages-are-most-tightly-coupled a slkg:CompetencyQuestion ;
    rdfs:comment "answered from the call graph (calls between subpackages), not from imports, because imports between this project's modules are not extracted (see the question above)." ;
    rdfs:label "Which two subpackages are most tightly coupled?" ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:cqStatus "answerable" .

ql:find-symbol a slkg:NamedQuery ;
    rdfs:comment "Start here when you know a word but not the full dotted path: lists the classes, functions, methods and modules whose dotted identifier contains the text (ignoring case), with where each is defined." ;
    rdfs:label "Find a symbol by part of its name" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "part of a dotted identifier, case-insensitive" ;
        slkg:paramExample "to_basic" ;
        slkg:paramName "text" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:find-symbol-tree .

ql:find-symbol-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "symbol"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 4 ;
        tree:value "summary"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "kind"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "symbol"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 7
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "summary"^^spexpr:Variable ;
            sqe:predicate rdfs:comment ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 8
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:LCASE ;
            spexpr:arg [
                a spexpr:REPLACE ;
                spexpr:arg [
                    a spexpr:STR ;
                    spexpr:arg "type"^^spexpr:Variable
                ] ;
                spexpr:pattern "^.*#" ;
                spexpr:replacement ""
            ]
        ] ;
        sqe:var "kind"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:TriplePattern ;
        sqe:object "type"^^spexpr:Variable ;
        sqe:predicate rdf:type ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "type"^^spexpr:Variable ;
            spexpr:op "IN"^^spexpr:PlainString ;
            spexpr:other [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:Class
            ], [
                a tree:Item ;
                tree:ord 2 ;
                tree:value slkg:Method
            ], [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:Function
            ], [
                a tree:Item ;
                tree:ord 3 ;
                tree:value slkg:Module
            ]
        ] ;
        tree:ord 4
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:CONTAINS ;
            spexpr:arg1 [
                a spexpr:LCASE ;
                spexpr:arg "symbol"^^spexpr:Variable
            ] ;
            spexpr:arg2 [
                a spexpr:LCASE ;
                spexpr:arg "text"^^spexpr:Variable
            ]
        ] ;
        tree:ord 2
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "file"^^spexpr:Variable ;
            sqe:predicate slkg:filePath ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 6
    ], [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "text"^^spexpr:Variable
        ] ;
        tree:ord 0
    ] .

ql:leaky-private-functions a slkg:NamedQuery ;
    rdfs:comment "Functions whose name starts with an underscore but that a different module (file) calls anyway, which usually means the abstraction leaks or the function should be public." ;
    rdfs:label "Private functions called from another module" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:answersCompetencyQuestion ql:cq-is-a-private-function-called-from-outside ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "only private functions whose dotted identifier starts with this" ;
        slkg:paramExample "starlayer.graph" ;
        slkg:paramName "prefix" ;
        slkg:paramRequired false
    ] ;
    slkg:queryRoot ql:leaky-private-functions-tree .

ql:leaky-private-functions-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "caller"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:OrderCondition ;
        sqe:expr "private"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "callerModule"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "private"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "caller"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "prefix"^^spexpr:Variable
        ] ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object true ;
        sqe:predicate slkg:isPrivate ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "f"^^spexpr:Variable ;
        sqe:predicate slkg:calls ;
        sqe:subject "c"^^spexpr:Variable ;
        tree:ord 6
    ], [
        a sqe:TriplePattern ;
        sqe:object "caller"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "c"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "prefix"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:STRSTARTS ;
                spexpr:arg1 "private"^^spexpr:Variable ;
                spexpr:arg2 "prefix"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "private"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "callerFile"^^spexpr:Variable ;
            spexpr:op "!="^^spexpr:PlainString ;
            spexpr:other [
                a spexpr:STRBEFORE ;
                spexpr:arg1 [
                    a spexpr:STR ;
                    spexpr:arg "f"^^spexpr:Variable
                ] ;
                spexpr:arg2 "#"
            ]
        ] ;
        tree:ord 8
    ], [
        a sqe:TriplePattern ;
        sqe:object slkg:Function ;
        sqe:predicate rdf:type ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:REPLACE ;
            spexpr:arg "callerFile"^^spexpr:Variable ;
            spexpr:pattern "^.*/blob/main/" ;
            spexpr:replacement ""
        ] ;
        sqe:var "callerModule"^^spexpr:Variable ;
        tree:ord 9
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:STRBEFORE ;
            spexpr:arg1 [
                a spexpr:STR ;
                spexpr:arg "c"^^spexpr:Variable
            ] ;
            spexpr:arg2 "#"
        ] ;
        sqe:var "callerFile"^^spexpr:Variable ;
        tree:ord 7
    ] .

ql:longest-functions a slkg:NamedQuery ;
    rdfs:comment "Functions and methods ordered by number of lines, optionally limited to a dotted prefix. A rough guide to where complexity lives." ;
    rdfs:label "The longest functions and methods" ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "only symbols whose dotted identifier starts with this" ;
        slkg:paramExample "starlayer.graph" ;
        slkg:paramName "prefix" ;
        slkg:paramRequired false
    ] ;
    slkg:queryRoot ql:longest-functions-tree .

ql:longest-functions-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:descending true ;
        sqe:expr "lines"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:OrderCondition ;
        sqe:expr "symbol"^^spexpr:Variable ;
        tree:ord 1
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "symbol"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "lines"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "line"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "type"^^spexpr:Variable ;
            spexpr:op "IN"^^spexpr:PlainString ;
            spexpr:other [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:Method
            ], [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:Function
            ]
        ] ;
        tree:ord 6
    ], [
        a sqe:TriplePattern ;
        sqe:object "line"^^spexpr:Variable ;
        sqe:predicate slkg:lineStart ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "prefix"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:STRSTARTS ;
                spexpr:arg1 "symbol"^^spexpr:Variable ;
                spexpr:arg2 "prefix"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 8
    ], [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "prefix"^^spexpr:Variable
        ] ;
        tree:ord 0
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:AdditiveExpression ;
            spexpr:expr "end"^^spexpr:Variable ;
            spexpr:op [
                a tree:Item ;
                tree:ord 1 ;
                tree:value "+"^^spexpr:PlainString
            ], [
                a tree:Item ;
                tree:ord 0 ;
                tree:value "-"^^spexpr:PlainString
            ] ;
            spexpr:other [
                a tree:Item ;
                tree:ord 1 ;
                tree:value 1
            ], [
                a tree:Item ;
                tree:ord 0 ;
                tree:value "line"^^spexpr:Variable
            ]
        ] ;
        sqe:var "lines"^^spexpr:Variable ;
        tree:ord 9
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:STRSTARTS ;
            spexpr:arg1 "file"^^spexpr:Variable ;
            spexpr:arg2 "packages/starlayer/starlayer/"
        ] ;
        tree:ord 7
    ], [
        a sqe:TriplePattern ;
        sqe:object "end"^^spexpr:Variable ;
        sqe:predicate slkg:lineEnd ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "file"^^spexpr:Variable ;
        sqe:predicate slkg:filePath ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:TriplePattern ;
        sqe:object "type"^^spexpr:Variable ;
        sqe:predicate rdf:type ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 1
    ] .

ql:members-of-class a slkg:NamedQuery ;
    rdfs:comment "The methods and attributes (dataclass fields, named-tuple fields) of a class that do not start with an underscore." ;
    rdfs:label "Public members of a class" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:answersCompetencyQuestion ql:cq-what-s-the-public-api-surface-of ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a class" ;
        slkg:paramExample "starlayer.graph.core.StarLayerGraph" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:members-of-class-tree .

ql:members-of-class-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "member"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:OrderCondition ;
        sqe:expr "line"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "kind"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "member"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "m"^^spexpr:Variable ;
        sqe:predicate [
            a spexpr:PathAlternative ;
            spexpr:args [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:declares
            ], [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:hasAttribute
            ]
        ] ;
        sqe:subject "c"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "c"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:LCASE ;
            spexpr:arg [
                a spexpr:REPLACE ;
                spexpr:arg [
                    a spexpr:STR ;
                    spexpr:arg "type"^^spexpr:Variable
                ] ;
                spexpr:pattern "^.*#" ;
                spexpr:replacement ""
            ]
        ] ;
        sqe:var "kind"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "m"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 8
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:UnaryNot ;
            spexpr:expr [
                a spexpr:STRSTARTS ;
                spexpr:arg1 "member"^^spexpr:Variable ;
                spexpr:arg2 "_"
            ]
        ] ;
        tree:ord 6
    ], [
        a sqe:TriplePattern ;
        sqe:object "type"^^spexpr:Variable ;
        sqe:predicate rdf:type ;
        sqe:subject "m"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "member"^^spexpr:Variable ;
        sqe:predicate rdfs:label ;
        sqe:subject "m"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Filter ;
        sqe:expr [
            a sqe:NotExists ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object true ;
                sqe:predicate slkg:isPrivate ;
                sqe:subject "m"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 7
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "type"^^spexpr:Variable ;
            spexpr:op "IN"^^spexpr:PlainString ;
            spexpr:other [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:Attribute
            ], [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:Method
            ]
        ] ;
        tree:ord 4
    ] .

ql:module-imports a slkg:NamedQuery ;
    rdfs:comment "The third-party and standard-library modules a module imports at its top level. Imports of other starlayer modules are not recorded in the graph (the extractor only extracts external imports), so use callers-of and callees-of for dependencies inside the project." ;
    rdfs:label "What external modules does a module import?" ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:answersCompetencyQuestion ql:cq-what-does-a-given-module-import-at ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a module" ;
        slkg:paramExample "starlayer.sparql.srl" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:module-imports-tree .

ql:module-imports-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "imported"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "imported"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "i"^^spexpr:Variable ;
        sqe:predicate slkg:importsModule ;
        sqe:subject "m"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "m"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:REPLACE ;
            spexpr:arg [
                a spexpr:STR ;
                spexpr:arg "i"^^spexpr:Variable
            ] ;
            spexpr:pattern "^.*#" ;
            spexpr:replacement ""
        ] ;
        sqe:var "imported"^^spexpr:Variable ;
        tree:ord 2
    ] .

ql:overrides a slkg:NamedQuery ;
    rdfs:comment "Both directions of the override relation for one method: the base-class method it overrides, and the subclass methods that override it." ;
    rdfs:label "What overrides a method, and what does it override?" ;
    slkg:aboutTopic ql:topic-inheritance ;
    slkg:answersCompetencyQuestion ql:cq-does-method-x-on-a-subclass-override ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a method" ;
        slkg:paramExample "starlayer.graph.manchester.parser._Cursor.record_prefix" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:overrides-tree .

ql:overrides-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "relation"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:OrderCondition ;
        sqe:expr "method"^^spexpr:Variable ;
        tree:ord 1
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "method"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "relation"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Union ;
        sqe:alternatives [
            a sqe:GroupGraphPattern ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object "method"^^spexpr:Variable ;
                sqe:predicate dcterms:identifier ;
                sqe:subject "o"^^spexpr:Variable ;
                tree:ord 1
            ], [
                a sqe:Bind ;
                sqe:expr "overrides" ;
                sqe:var "relation"^^spexpr:Variable ;
                tree:ord 2
            ], [
                a sqe:TriplePattern ;
                sqe:object "o"^^spexpr:Variable ;
                sqe:predicate slkg:overrides ;
                sqe:subject "m"^^spexpr:Variable ;
                tree:ord 0
            ] ;
            tree:ord 0
        ], [
            a sqe:GroupGraphPattern ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object "m"^^spexpr:Variable ;
                sqe:predicate slkg:overrides ;
                sqe:subject "o"^^spexpr:Variable ;
                tree:ord 1
            ], [
                a sqe:TriplePattern ;
                sqe:object "method"^^spexpr:Variable ;
                sqe:predicate dcterms:identifier ;
                sqe:subject "o"^^spexpr:Variable ;
                tree:ord 0
            ], [
                a sqe:Bind ;
                sqe:expr "overridden by" ;
                sqe:var "relation"^^spexpr:Variable ;
                tree:ord 2
            ] ;
            tree:ord 1
        ] ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "m"^^spexpr:Variable ;
        tree:ord 0
    ] .

ql:parameters-of a slkg:NamedQuery ;
    rdfs:comment "Each parameter's position, name, kind, type annotation and default value." ;
    rdfs:label "Parameters of a function or method" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:answersCompetencyQuestion ql:cq-what-are-a-function-method-s-parameters ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a function or method" ;
        slkg:paramExample "starlayer.graph.core._Base.infer" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:parameters-of-tree .

ql:parameters-of-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "position"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 4 ;
        tree:value "default"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "name"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "position"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "annotation"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "kind"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "position"^^spexpr:Variable ;
            sqe:predicate slkg:position ;
            sqe:subject "p"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 3
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "kind"^^spexpr:Variable ;
            sqe:predicate slkg:parameterKind ;
            sqe:subject "p"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "name"^^spexpr:Variable ;
        sqe:predicate rdfs:label ;
        sqe:subject "p"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "default"^^spexpr:Variable ;
            sqe:predicate slkg:defaultValue ;
            sqe:subject "p"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 6
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "p"^^spexpr:Variable ;
        sqe:predicate slkg:hasParameter ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "annotation"^^spexpr:Variable ;
            sqe:predicate slkg:annotationText ;
            sqe:subject "p"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 5
    ] .

ql:public-api-of-module a slkg:NamedQuery ;
    rdfs:comment "What a module defines at its top level that does not start with an underscore." ;
    rdfs:label "Public classes and functions of a module" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:answersCompetencyQuestion ql:cq-what-s-the-public-api-surface-of ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a module" ;
        slkg:paramExample "starlayer.graph.interop" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:public-api-of-module-tree .

ql:public-api-of-module-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "line"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "summary"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "kind"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "name"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "s"^^spexpr:Variable ;
        sqe:predicate slkg:declares ;
        sqe:subject "mod"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "type"^^spexpr:Variable ;
        sqe:predicate rdf:type ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "type"^^spexpr:Variable ;
            spexpr:op "IN"^^spexpr:PlainString ;
            spexpr:other [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:Function
            ], [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:Class
            ]
        ] ;
        tree:ord 4
    ], [
        a sqe:Filter ;
        sqe:expr [
            a sqe:NotExists ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object true ;
                sqe:predicate slkg:isPrivate ;
                sqe:subject "s"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 6
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:LCASE ;
            spexpr:arg [
                a spexpr:REPLACE ;
                spexpr:arg [
                    a spexpr:STR ;
                    spexpr:arg "type"^^spexpr:Variable
                ] ;
                spexpr:pattern "^.*#" ;
                spexpr:replacement ""
            ]
        ] ;
        sqe:var "kind"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:TriplePattern ;
        sqe:object "name"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 7
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "mod"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "summary"^^spexpr:Variable ;
            sqe:predicate rdfs:comment ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 8
    ] .

ql:public-without-docstring a slkg:NamedQuery ;
    rdfs:comment "Public classes, functions and methods that have no summary, optionally limited to a dotted prefix." ;
    rdfs:label "Public symbols with no docstring" ;
    slkg:aboutTopic ql:topic-api-surface ;
    slkg:answersCompetencyQuestion ql:cq-which-public-functions-have-no-docstring-already ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "only symbols whose dotted identifier starts with this" ;
        slkg:paramExample "starlayer.shacl" ;
        slkg:paramName "prefix" ;
        slkg:paramRequired false
    ] ;
    slkg:queryRoot ql:public-without-docstring-tree .

ql:public-without-docstring-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "symbol"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "symbol"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "kind"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "file"^^spexpr:Variable ;
        sqe:predicate slkg:filePath ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "prefix"^^spexpr:Variable
        ] ;
        tree:ord 0
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "prefix"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:STRSTARTS ;
                spexpr:arg1 "symbol"^^spexpr:Variable ;
                spexpr:arg2 "prefix"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 7
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "type"^^spexpr:Variable ;
            spexpr:op "IN"^^spexpr:PlainString ;
            spexpr:other [
                a tree:Item ;
                tree:ord 2 ;
                tree:value slkg:Method
            ], [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:Function
            ], [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:Class
            ]
        ] ;
        tree:ord 4
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:STRSTARTS ;
            spexpr:arg1 "file"^^spexpr:Variable ;
            spexpr:arg2 "packages/starlayer/starlayer/"
        ] ;
        tree:ord 6
    ], [
        a sqe:Filter ;
        sqe:expr [
            a sqe:NotExists ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object "c"^^spexpr:Variable ;
                sqe:predicate rdfs:comment ;
                sqe:subject "s"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 9
    ], [
        a sqe:TriplePattern ;
        sqe:object "type"^^spexpr:Variable ;
        sqe:predicate rdf:type ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:Filter ;
        sqe:expr [
            a sqe:NotExists ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object true ;
                sqe:predicate slkg:isPrivate ;
                sqe:subject "s"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 8
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 10
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:LCASE ;
            spexpr:arg [
                a spexpr:REPLACE ;
                spexpr:arg [
                    a spexpr:STR ;
                    spexpr:arg "type"^^spexpr:Variable
                ] ;
                spexpr:pattern "^.*#" ;
                spexpr:replacement ""
            ]
        ] ;
        sqe:var "kind"^^spexpr:Variable ;
        tree:ord 5
    ] .

ql:subpackage-coupling a slkg:NamedQuery ;
    rdfs:comment "Counts calls between the top-level subpackages of starlayer (graph, sparql, shacl, ...), largest first. It uses the call graph, because the graph does not record imports between starlayer modules." ;
    rdfs:label "Which subpackages call into each other most?" ;
    slkg:aboutTopic ql:topic-architecture ;
    slkg:answersCompetencyQuestion ql:cq-finer-grained-coupling-which-function-in-module ;
    slkg:queryRoot ql:subpackage-coupling-tree .

ql:subpackage-coupling-tree a sqe:Query, sqe:SelectQuery ;
    sqe:groupBy [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "from"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "to"^^spexpr:Variable
    ] ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:descending true ;
        sqe:expr "calls"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:OrderCondition ;
        sqe:expr "to"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:OrderCondition ;
        sqe:expr "from"^^spexpr:Variable ;
        tree:ord 1
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "from"^^spexpr:Variable
    ], [
        a sqe:Alias ;
        sqe:expr [
            a spexpr:COUNT ;
            spexpr:expr "*"^^spexpr:PlainString
        ] ;
        sqe:var "calls"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "to"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalAndExpression ;
            spexpr:expr [
                a spexpr:STRSTARTS ;
                spexpr:arg1 "id1"^^spexpr:Variable ;
                spexpr:arg2 "starlayer."
            ] ;
            spexpr:other [
                a spexpr:STRSTARTS ;
                spexpr:arg1 "id2"^^spexpr:Variable ;
                spexpr:arg2 "starlayer." ;
                tree:ord 0
            ]
        ] ;
        tree:ord 3
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:REPLACE ;
            spexpr:arg "id2"^^spexpr:Variable ;
            spexpr:pattern "^(starlayer\\.[^.]+).*$" ;
            spexpr:replacement "$1"
        ] ;
        sqe:var "to"^^spexpr:Variable ;
        tree:ord 5
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "from"^^spexpr:Variable ;
            spexpr:op "!="^^spexpr:PlainString ;
            spexpr:other "to"^^spexpr:Variable
        ] ;
        tree:ord 6
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:REPLACE ;
            spexpr:arg "id1"^^spexpr:Variable ;
            spexpr:pattern "^(starlayer\\.[^.]+).*$" ;
            spexpr:replacement "$1"
        ] ;
        sqe:var "from"^^spexpr:Variable ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "b"^^spexpr:Variable ;
        sqe:predicate slkg:calls ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "id1"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "a"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:TriplePattern ;
        sqe:object "id2"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "b"^^spexpr:Variable ;
        tree:ord 2
    ] .

ql:symbol-info a slkg:NamedQuery ;
    rdfs:comment "The kind, location, signature and one-line summary of one symbol, by its dotted identifier." ;
    rdfs:label "What is this symbol, and where is it?" ;
    slkg:aboutTopic ql:topic-navigation ;
    slkg:answersCompetencyQuestion ql:cq-what-are-a-function-method-s-parameters ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a class, function, method or module" ;
        slkg:paramExample "starlayer.graph.interop.to_basic" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:symbol-info-tree .

ql:symbol-info-tree a sqe:Query, sqe:SelectQuery ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 4 ;
        tree:value "signature"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "file"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 3 ;
        tree:value "lineEnd"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 5 ;
        tree:value "summary"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "kind"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "file"^^spexpr:Variable ;
            sqe:predicate slkg:filePath ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 4
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 5
    ], [
        a sqe:Bind ;
        sqe:expr [
            a spexpr:LCASE ;
            spexpr:arg [
                a spexpr:REPLACE ;
                spexpr:arg [
                    a spexpr:STR ;
                    spexpr:arg "type"^^spexpr:Variable
                ] ;
                spexpr:pattern "^.*#" ;
                spexpr:replacement ""
            ]
        ] ;
        sqe:var "kind"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "type"^^spexpr:Variable ;
            spexpr:op "IN"^^spexpr:PlainString ;
            spexpr:other [
                a tree:Item ;
                tree:ord 2 ;
                tree:value slkg:Method
            ], [
                a tree:Item ;
                tree:ord 3 ;
                tree:value slkg:Module
            ], [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:Function
            ], [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:Class
            ]
        ] ;
        tree:ord 2
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "lineEnd"^^spexpr:Variable ;
            sqe:predicate slkg:lineEnd ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 6
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "signature"^^spexpr:Variable ;
            sqe:predicate slkg:signature ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 7
    ], [
        a sqe:TriplePattern ;
        sqe:object "type"^^spexpr:Variable ;
        sqe:predicate rdf:type ;
        sqe:subject "s"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "summary"^^spexpr:Variable ;
            sqe:predicate rdfs:comment ;
            sqe:subject "s"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 8
    ] .

ql:tests-of a slkg:NamedQuery ;
    rdfs:comment "The test functions and methods that call a symbol directly." ;
    rdfs:label "Which tests exercise a function?" ;
    slkg:aboutTopic ql:topic-testing ;
    slkg:answersCompetencyQuestion ql:cq-does-this-function-have-a-test-that ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "dotted identifier of a function or method" ;
        slkg:paramExample "starlayer.graph.interop.to_basic" ;
        slkg:paramName "symbol" ;
        slkg:paramRequired true
    ] ;
    slkg:queryRoot ql:tests-of-tree .

ql:tests-of-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "test"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "test"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "file"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:TriplePattern ;
        sqe:object "target"^^spexpr:Variable ;
        sqe:predicate slkg:calls ;
        sqe:subject "t"^^spexpr:Variable ;
        tree:ord 0
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:STRSTARTS ;
            spexpr:arg1 "file"^^spexpr:Variable ;
            spexpr:arg2 "packages/starlayer/tests/"
        ] ;
        tree:ord 4
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "target"^^spexpr:Variable ;
        tree:ord 3
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "t"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 5
    ], [
        a sqe:TriplePattern ;
        sqe:object "file"^^spexpr:Variable ;
        sqe:predicate slkg:filePath ;
        sqe:subject "t"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "test"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "t"^^spexpr:Variable ;
        tree:ord 1
    ] .

ql:topic-api-surface a slkg:Topic ;
    rdfs:comment "What is public, what is private, and where private names leak." ;
    rdfs:label "Visibility and API surface" .

ql:topic-architecture a slkg:Topic ;
    rdfs:comment "Imports between modules and subpackages; where the size is." ;
    rdfs:label "Architecture and coupling" .

ql:topic-call-graph a slkg:Topic ;
    rdfs:comment "Who calls what, call chains, instantiation." ;
    rdfs:label "Relationships and the call graph" .

ql:topic-capabilities a slkg:Topic ;
    rdfs:comment "The curated list of what StarLayer does, and the code behind each item." ;
    rdfs:label "Capabilities" .

ql:topic-dead-code a slkg:Topic ;
    rdfs:comment "Functions nothing calls." ;
    rdfs:label "Dead code and unused surface" .

ql:topic-inheritance a slkg:Topic ;
    rdfs:comment "Overrides and base classes." ;
    rdfs:label "Inheritance" .

ql:topic-navigation a slkg:Topic ;
    rdfs:comment "Finding a symbol and seeing what it is: kind, location, parameters." ;
    rdfs:label "Structure and navigation" .

ql:topic-specifications a slkg:Topic ;
    rdfs:comment "Which code cites which specification." ;
    rdfs:label "Specifications and standards grounding" .

ql:topic-testing a slkg:Topic ;
    rdfs:comment "Which tests exercise which code." ;
    rdfs:label "Testing linkage" .

ql:topic-upstream-bugs a slkg:Topic ;
    rdfs:comment "Code that exists to work around a bug in another project." ;
    rdfs:label "Known upstream bugs and workarounds" .

ql:unreferenced-functions a slkg:NamedQuery ;
    rdfs:comment "Public functions and methods with no incoming call edge at all, optionally limited to a dotted prefix. Entry points, hooks and anything called through indirection show up here, so treat it as a lead." ;
    rdfs:label "Functions nothing calls" ;
    slkg:aboutTopic ql:topic-dead-code ;
    slkg:answersCompetencyQuestion ql:cq-is-this-function-ever-called-by-anything ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "only symbols whose dotted identifier starts with this" ;
        slkg:paramExample "starlayer.sparql" ;
        slkg:paramName "prefix" ;
        slkg:paramRequired false
    ] ;
    slkg:queryRoot ql:unreferenced-functions-tree .

ql:unreferenced-functions-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "symbol"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://purl.org/dc/terms/> ;
        sqe:prefixLabel "dcterms"^^spexpr:PlainString
    ], [
        a sqe:PrefixDecl ;
        sqe:namespace <http://www.w3.org/2000/01/rdf-schema#> ;
        sqe:prefixLabel "rdfs"^^spexpr:PlainString
    ] ;
    sqe:projection [
        a tree:Item ;
        tree:ord 2 ;
        tree:value "line"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 0 ;
        tree:value "symbol"^^spexpr:Variable
    ], [
        a tree:Item ;
        tree:ord 1 ;
        tree:value "file"^^spexpr:Variable
    ] ;
    sqe:where [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:STRSTARTS ;
            spexpr:arg1 "file"^^spexpr:Variable ;
            spexpr:arg2 "packages/starlayer/starlayer/"
        ] ;
        tree:ord 5
    ], [
        a sqe:Optional ;
        sqe:where [
            a sqe:TriplePattern ;
            sqe:object "line"^^spexpr:Variable ;
            sqe:predicate slkg:lineStart ;
            sqe:subject "f"^^spexpr:Variable ;
            tree:ord 0
        ] ;
        tree:ord 9
    ], [
        a sqe:Values ;
        sqe:rows [
            a sqe:Row ;
            sqe:cells [
                a tree:Item ;
                tree:ord 0 ;
                tree:value sqe:undef
            ] ;
            tree:ord 0
        ] ;
        sqe:vars [
            a tree:Item ;
            tree:ord 0 ;
            tree:value "prefix"^^spexpr:Variable
        ] ;
        tree:ord 0
    ], [
        a sqe:TriplePattern ;
        sqe:object "symbol"^^spexpr:Variable ;
        sqe:predicate dcterms:identifier ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 1
    ], [
        a sqe:Filter ;
        sqe:expr [
            a sqe:NotExists ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object true ;
                sqe:predicate slkg:isPrivate ;
                sqe:subject "f"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 7
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:ConditionalOrExpression ;
            spexpr:expr [
                a spexpr:UnaryNot ;
                spexpr:expr [
                    a spexpr:BOUND ;
                    spexpr:arg "prefix"^^spexpr:Variable
                ]
            ] ;
            spexpr:other [
                a spexpr:STRSTARTS ;
                spexpr:arg1 "symbol"^^spexpr:Variable ;
                spexpr:arg2 "prefix"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 6
    ], [
        a sqe:Filter ;
        sqe:expr [
            a spexpr:RelationalExpression ;
            spexpr:expr "type"^^spexpr:Variable ;
            spexpr:op "IN"^^spexpr:PlainString ;
            spexpr:other [
                a tree:Item ;
                tree:ord 1 ;
                tree:value slkg:Method
            ], [
                a tree:Item ;
                tree:ord 0 ;
                tree:value slkg:Function
            ]
        ] ;
        tree:ord 4
    ], [
        a sqe:Filter ;
        sqe:expr [
            a sqe:NotExists ;
            sqe:where [
                a sqe:TriplePattern ;
                sqe:object "f"^^spexpr:Variable ;
                sqe:predicate slkg:calls ;
                sqe:subject "c"^^spexpr:Variable ;
                tree:ord 0
            ]
        ] ;
        tree:ord 8
    ], [
        a sqe:TriplePattern ;
        sqe:object "type"^^spexpr:Variable ;
        sqe:predicate rdf:type ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 2
    ], [
        a sqe:TriplePattern ;
        sqe:object "file"^^spexpr:Variable ;
        sqe:predicate slkg:filePath ;
        sqe:subject "f"^^spexpr:Variable ;
        tree:ord 3
    ] .

ql:untested-functions a slkg:NamedQuery ;
    rdfs:comment "Public functions and methods with no direct call from any test, optionally limited to a dotted prefix. A function exercised only through another function shows up here too, so treat it as a lead." ;
    rdfs:label "Functions no test calls directly" ;
    slkg:aboutTopic ql:topic-testing ;
    slkg:answersCompetencyQuestion ql:cq-which-functions-have-zero-test-coverage-by ;
    slkg:queryParameter [
        a slkg:QueryParameter ;
        rdfs:comment "only symbols whose dotted identifier starts with this" ;
        slkg:paramExample "starlayer.shacl" ;
        slkg:paramName "prefix" ;
        slkg:paramRequired false
    ] ;
    slkg:queryRoot ql:untested-functions-tree .

ql:untested-functions-tree a sqe:Query, sqe:SelectQuery ;
    sqe:orderBy [
        a sqe:OrderCondition ;
        sqe:expr "symbol"^^spexpr:Variable ;
        tree:ord 0
    ] ;
    sqe:prefixDecl [
        a sqe:PrefixDecl ;
        sqe:namespace <https://github.com/hidden-graph/starlayer/ns/codekg#> ;
        sqe:prefixLabel "slkg"^^spexpr:PlainString
