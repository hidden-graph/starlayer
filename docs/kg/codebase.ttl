        <https://github.com/hidden-graph/starlayer/kg/resource/external/rdflib>,
        <https://github.com/hidden-graph/starlayer/kg/resource/module/starlayergraph.serializers.turtle12> ;
    slkg:moduleName "starlayergraph.serializers.trig12" .

