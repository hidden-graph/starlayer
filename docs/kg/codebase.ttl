    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarshacl.sparql_node_expressions.eval_sparql_expr%3A%3Aeval_arg%3A%3A2>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarshacl.sparql_node_expressions.eval_sparql_expr%3A%3Aexpr%3A%3A0>,
