    slkg:qualifiedName "starshacl.validator._graph_contains_triple_terms" ;
    slkg:signature "def _graph_contains_triple_terms(graph: Any) -> bool" .

<https://github.com/hidden-graph/starlayer/kg/resource/function/starshacl.validator._inject_shapes_graph_subclass_triples> a slkg:Function ;
    rdfs:label "_inject_shapes_graph_subclass_triples" ;
    rdfs:comment """When ``enabled`` (the ``rdfs_subclass_reasoning_includes_shapes_graph``
``validate()`` option), copy the shapes graph's own ``rdfs:subClassOf``
triples into a copy of ``data_graph``, so pySHACL-visible code that walks
``rdfs:subClassOf`` (e.g. ``sh:rootClass``'s registered constraint
component - see ``starshacl/native_components.py``) sees them without
needing a separate channel to the shapes graph. The caller removes
exactly the returned ``injected`` triples from the encoded copy handed to
pySHACL immediately after validation, so they never leak into
caller-visible output.""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarshacl.validator._inject_shapes_graph_subclass_triples%3A%3Adata_graph%3A%3A0>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarshacl.validator._inject_shapes_graph_subclass_triples%3A%3Aenabled%3A%3A2>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarshacl.validator._inject_shapes_graph_subclass_triples%3A%3Ashacl_graph%3A%3A1> ;
    slkg:lineEnd 1884 ;
    slkg:lineStart 1858 ;
    slkg:qualifiedName "starshacl.validator._inject_shapes_graph_subclass_triples" ;
    slkg:signature "def _inject_shapes_graph_subclass_triples(data_graph: Any, shacl_graph: Any, *, enabled: bool) -> tuple[Any, set[tuple[Any, Any, Any]]]" .

<https://github.com/hidden-graph/starlayer/kg/resource/function/starshacl.validator._is_implicit_class_shape> a slkg:Function ;
