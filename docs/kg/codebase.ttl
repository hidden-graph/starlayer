    slkg:lineEnd 248 ;
    slkg:lineStart 231 ;
    slkg:qualifiedName "starlayergraph.graph.starlayer_dataset.StarLayerDataset.addN" ;
    slkg:signature "def addN(self, quads) -> None" .

