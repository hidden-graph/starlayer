<https://github.com/hidden-graph/starlayer/kg/resource/method/starlayergraph.graph.starlayer_dataset.StarLayerDataset._check_document_version_conformance> a slkg:Method ;
    rdfs:label "_check_document_version_conformance" ;
    rdfs:comment """Warn (RDF12ConformanceWarning, never a hard error) if a document-
level VERSION directive declares "1.2-basic"/"1.1" but any graph in
this dataset actually uses a triple term or dirLangString.

The directive applies to the whole document, not per named graph
(see trig12.py's extract_version_directive()), so this checks the
union across every context rather than each one independently -
see check_version_conformance_for_graphs(), shared with
StarLayerGraph.parse()'s equivalent per-format checks.""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_dataset.StarLayerDataset._check_document_version_conformance%3A%3Acontext%3A%3A2>,
