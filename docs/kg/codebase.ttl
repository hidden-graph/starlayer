        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarlayergraph.parsers.syntax._split_on_delimiter%3A%3Atext%3A%3A0> ;
