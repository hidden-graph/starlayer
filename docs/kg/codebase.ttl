<https://github.com/hidden-graph/starlayer/kg/resource/method/starlayergraph.parsers.rdfxml12._Preprocessor._strip_version_attr> a slkg:Method ;
    rdfs:label "_strip_version_attr" ;
    rdfs:comment """Remove rdf:version if present on *elem* - it must never reach
rdflib's real 'xml' parser, which would otherwise misinterpret it as
an ordinary property attribute and assert a bogus extra triple (see
module docstring). Recording the value itself is extract_version_directive()'s
job via its own separate scan, not this method's - this only
prevents the corruption.""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.parsers.rdfxml12._Preprocessor._strip_version_attr%3A%3Aelem%3A%3A1>,
