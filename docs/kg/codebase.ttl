    rdfs:label "classify_statement" ;
    rdfs:comment "Return 'version', 'prefix', 'base', or 'triple'." ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarlayergraph.parsers.syntax.classify_statement%3A%3Astmt%3A%3A0> ;
    slkg:lineEnd 334 ;
