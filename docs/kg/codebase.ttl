    rdfs:label "add" ;
    rdfs:comment """Add a triple. A TripleTerm (or plain 3-tuple) in the object position is
converted to its internal encoding automatically.

    g.add((s, p, o))              # plain triple
    g.add((s, p, TripleTerm(...))) # TripleTerm as object
    g.add((s, p, (a, b, c)))      # plain tuple treated as TripleTerm""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph.add%3A%3Aself%3A%3A0>,
