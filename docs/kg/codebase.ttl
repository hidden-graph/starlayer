<https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.jsonld12._node_to_jld> a slkg:Function ;
    rdfs:label "_node_to_jld" ;
    rdfs:comment "Convert any rdflib node (or TripleTerm) to a JSON-LD value object." ;
    slkg:commentText "\"@language\"/\"@direction\" pair: rdflib's JSON-LD codec (RDF 1.1) has",
        "Same internal-datatype-URI encoding as every other format (see",
        "The full TripleTerm definition is emitted as a separate top-level node.",
        "TripleTerms in value position are referenced by their tt:HASH URI.",
        "explicit \"@type\" round-trips through rdflib's real JSON-LD parser",
        "no concept of @direction and would silently drop it on parse. An",
        "starlayergraph.model.encoding) rather than JSON-LD 1.1's native",
        "unchanged, the same way rdf:TripleTerm nodes do below." ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarlayergraph.serializers.jsonld12._node_to_jld%3A%3Acompact%3A%3A1>,
