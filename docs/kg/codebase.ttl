    slkg:lineEnd 183 ;
    slkg:lineStart 159 ;
    slkg:qualifiedName "starsparql.serialize12._AlgebraTranslator12.translateAlgebra" ;
    slkg:signature "def translateAlgebra(self) -> str" .

