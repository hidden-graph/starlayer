<https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.backends.native.http_ask> a slkg:Function ;
    rdfs:label "http_ask" ;
    rdfs:comment "Execute a SPARQL ASK and return the boolean result." ;
