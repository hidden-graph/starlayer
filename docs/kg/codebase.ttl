<https://github.com/hidden-graph/starlayer/kg/resource/method/starlayergraph.graph.starlayer_graph.StarLayerGraph.add_reifier_annotation> a slkg:Method ;
    rdfs:label "add_reifier_annotation" ;
    rdfs:comment """Create a reifier node and add one annotation property to it.

The node is not yet a reifier until add_reification() is called.

    r = g.add_reifier_annotation(EX.confidence, Literal("0.9"), name=EX.stmt1)
    g.add_reification(r, (EX.bob, EX.knows, EX.carol))

    # or inline:
    g.add_reification(
        g.add_reifier_annotation(EX.reported, EX.NYTimes),
        triple_term
    )""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph.add_reifier_annotation%3A%3Aname%3A%3A3>,
