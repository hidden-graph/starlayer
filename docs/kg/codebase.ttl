<https://github.com/hidden-graph/starlayer/kg/resource/module/starsparql.parse12> a slkg:Module ;
    rdfs:label "starsparql.parse12" ;
    dcterms:identifier "starsparql.parse12" ;
    rdfs:comment """Public entry points for ingesting SPARQL 1.2 (triple-term) query/update
text into a genuine, post-``translateQuery``/``translateUpdate`` algebra
tree — see ``grammar12.py`` for how ``<<( s p o )>>``/``TRIPLE(s, p, o)``
syntax is made parseable at all, and ``triple_term.py`` for why the
resulting node has to be a ``TripleTermNode``, not a bare ``CompValue``.

Because the grammar extension (``grammar12.install()``) constructs a
``TripleTermNode`` directly inside its parse action, the parse tree these
functions produce never contains a plain ``CompValue('TripleTerm', ...)`` to
promote after the fact — ``translateQuery``/``translateUpdate`` can be
called on it immediately, completely unmodified.""" ;
    slkg:belongsToPackage <https://github.com/hidden-graph/starlayer/kg/resource/package/starsparql> ;
    slkg:commentText "re-exported for callers" ;
    slkg:contains <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12._canonicalize_construct_where>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12._check_no_blank_nodes>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12._parse_with_recovery>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12._reject_blank_nodes_in_delete>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12.parse_query_12>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12.parse_update_12>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12.prepare_query_12>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12.prepare_update_12> ;
    slkg:defines <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12._canonicalize_construct_where>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12._check_no_blank_nodes>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12._parse_with_recovery>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12._reject_blank_nodes_in_delete>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12.parse_query_12>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.parse12.parse_update_12>,
