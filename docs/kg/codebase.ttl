        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarlayergraph.model.conformance.check_version_conformance%3A%3Auses_dirlangstring%3A%3A2>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarlayergraph.model.conformance.check_version_conformance%3A%3Auses_triple_term%3A%3A1> ;
