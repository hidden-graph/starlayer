<https://github.com/hidden-graph/starlayer/kg/resource/function/starshacl.node_expressions._numeric_sum> a slkg:Function ;
    rdfs:label "_numeric_sum" ;
    rdfs:comment """Sum numeric literals, promoting the result datatype per SPARQL/XPath's
own numeric type promotion rules (any xsd:double -> double; else any
xsd:decimal -> decimal; else xsd:integer) rather than ``Literal(total)``,
which infers a datatype purely from the *Python* result type - a Python
``float`` always becomes ``xsd:double`` regardless of whether the inputs
were ``xsd:decimal``, silently changing the result's type. Confirmed via
the W3C SHACL 1.2 Node Expressions test suite (shnex/sum.ttl's
sum-list-3-mixed/sum-totalRevenue, both summing xsd:decimal inputs and
expecting an xsd:decimal result).""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarshacl.node_expressions._numeric_sum%3A%3Aliterals%3A%3A0> ;
    slkg:lineEnd 171 ;
    slkg:lineStart 144 ;
    slkg:qualifiedName "starshacl.node_expressions._numeric_sum" ;
    slkg:signature "def _numeric_sum(literals: list) -> Literal" .

