<https://github.com/hidden-graph/starlayer/kg/resource/module/starlayergraph.parsers.syntax> a slkg:Module ;
    rdfs:label "starlayergraph.parsers.syntax" ;
    dcterms:identifier "starlayergraph.parsers.syntax" ;
    rdfs:comment """starlayergraph.parsers.syntax

Statement-level parsing for Turtle 1.2. Splits raw text into statements,
classifies them, extracts predicate-object fields, and expands blank-node
shorthand and RDF collections into flat triple dicts.""" ;
    slkg:belongsToPackage <https://github.com/hidden-graph/starlayer/kg/resource/package/starlayergraph> ;
    slkg:commentText "\"123e0\"), a decimal point with no exponent means DECIMAL. Order matters",
        "Turtle grammar distinguishes INTEGER/DECIMAL/DOUBLE purely by lexical",
        "below - DOUBLE must be checked before DECIMAL, since e.g. \"1.5e2\" would",
        "checking DOUBLE first keeps the two independent instead of relying on",
        "otherwise never reach the DOUBLE branch (nothing here requires it to,",
        "shape: an exponent suffix means DOUBLE even with no decimal point (e.g.",
        "since DECIMAL's pattern doesn't match a trailing exponent anyway, but",
        "that)." ;
    slkg:contains <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax._parse_collection_elements>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax._scan_directive_end>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax._split_on_delimiter>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax._split_statements_impl>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax.classify_statement>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax.coerce_object>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax.expand_triple_set>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax.extract_fields>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax.split_statements>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax.split_statements_with_lines> ;
    slkg:defines <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax._parse_collection_elements>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax._scan_directive_end>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax._split_on_delimiter>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax._split_statements_impl>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.parsers.syntax.classify_statement>,
