<https://github.com/hidden-graph/starlayer/kg/resource/method/starlayergraph.graph.starlayer_graph.StarLayerGraph._triples_tt_wildcard> a slkg:Method ;
    rdfs:label "_triples_tt_wildcard" ;
    rdfs:comment """Fan-out triples() for wildcard triple-term patterns.

For each registered TripleTerm whose encoding matches the wildcard
pattern, issues one store query with the concrete tt:HASH URI and
unions the results.  A seen-set prevents duplicates when both
subject and object carry wildcard patterns.""" ;
    slkg:commentText "Build the Cartesian product of concrete URIs for both positions." ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph._triples_tt_wildcard%3A%3Ao_wild%3A%3A5>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph._triples_tt_wildcard%3A%3Aobj%3A%3A3>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph._triples_tt_wildcard%3A%3Ap%3A%3A2>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph._triples_tt_wildcard%3A%3As%3A%3A1>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph._triples_tt_wildcard%3A%3As_wild%3A%3A4>,
