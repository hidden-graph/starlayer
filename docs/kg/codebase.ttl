<https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.lower_rdf11._is_ground> a slkg:Function ;
    rdfs:label "_is_ground" ;
    rdfs:comment """True iff `term` contains no Variable and no BlankNode anywhere,
recursively through nested TripleTermNodes. A blank node counts as
non-ground here even though it isn't a Variable — matching
sparql12_to_11.py's own (session-confirmed) fix for the same question:
a BIND target computed from a triple term containing a blank node must
still be recomputed per-solution-consistent-skolemization, not hoisted
as if it were a constant.""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarsparql.lower_rdf11._is_ground%3A%3Aterm%3A%3A0> ;
