        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.lower_rdf11.rdf11_update_to_sparql11_text>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.lower_rdf11.update_to_rdf11> ;
    slkg:filePath "packages/sparql/starsparql/lower_rdf11.py" ;
    slkg:importsModule <https://github.com/hidden-graph/starlayer/kg/resource/external/__future__>,
        <https://github.com/hidden-graph/starlayer/kg/resource/external/rdflib>,
        <https://github.com/hidden-graph/starlayer/kg/resource/external/rdflib.graph>,
        <https://github.com/hidden-graph/starlayer/kg/resource/external/rdflib.namespace>,
        <https://github.com/hidden-graph/starlayer/kg/resource/external/rdflib.plugins.sparql.algebra>,
