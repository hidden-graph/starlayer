    slkg:qualifiedName "starlayergraph.graph.starlayer_graph.StarLayerGraph.add" ;
    slkg:signature "def add(self, triple)" .

<https://github.com/hidden-graph/starlayer/kg/resource/method/starlayergraph.graph.starlayer_graph.StarLayerGraph.addN> a slkg:Method ;
    rdfs:label "addN" ;
    rdfs:comment """Add multiple quads, encoding all TripleTerms in one store.addN() call.

Unlike the default Graph.addN() → store.addN() path, this override
collects encoding triples (rdf:subject/predicate/object for each
TripleTerm) together with the main triples so that all inserts are
submitted to the store in a single batch.  On transaction-aware
backends (SQLAlchemy, Sleepycat) this means one commit instead of
three per triple term, which is significantly faster for bulk loads.""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph.addN%3A%3Aquads%3A%3A1>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Fmethod%2Fstarlayergraph.graph.starlayer_graph.StarLayerGraph.addN%3A%3Aself%3A%3A0> ;
    slkg:lineEnd 663 ;
    slkg:lineStart 595 ;
    slkg:qualifiedName "starlayergraph.graph.starlayer_graph.StarLayerGraph.addN" ;
    slkg:signature "def addN(self, quads)" .

