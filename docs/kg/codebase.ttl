<https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.turtle12.serialize_turtle12> a slkg:Function ;
    rdfs:label "serialize_turtle12" ;
    rdfs:comment """Serialize a StarLayerGraph or rdflib.Graph (with SL encoding) to Turtle 1.2.

Triple terms are emitted as <<( s p o )>>. Internal encoding triples
(sl:TripleTerm, sl:Reification, rdf:subject/predicate/object) are omitted.
Reifier bnodes whose annotated triple is asserted in the graph are folded
into inline {| ann_pred ann_val |} syntax on the base triple.
Only namespace prefixes actually used in the graph are emitted.""" ;
    slkg:commentText "--- Pass 1: generate triple lines, collecting used URIRef strings ---",
        "--- Pass 2: emit version declaration and used prefix declarations ---",
        "Unasserted anonymous reifiers: TripleTerm becomes the subject directly." ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarlayergraph.serializers.turtle12.serialize_turtle12%3A%3Agraph%3A%3A0> ;
    slkg:lineEnd 302 ;
