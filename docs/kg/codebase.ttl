    slkg:lineEnd 369 ;
    slkg:lineStart 350 ;
    slkg:qualifiedName "starsparql.to_rdf._encode_binding_row" ;
    slkg:signature "def _encode_binding_row(row: dict, graph: Graph) -> BNode | URIRef" .

<https://github.com/hidden-graph/starlayer/kg/resource/function/starsparql.to_rdf._encode_comp_value> a slkg:Function ;
    rdfs:label "_encode_comp_value" ;
    slkg:commentText "See lower_rdf11.py's _lower_expr for the full explanation:",
        "`graph`) fixes up certain keys via a shadowing instance",
        "algebra.translateExists, for Builtin_EXISTS/NOTEXISTS's",
        "attribute assignment (`n.graph = ...`) rather than updating",
        "fragment. Prefer the attribute whenever both exist.",
        "rdflib's own translateQuery post-processing (e.g.",
        "so `value` here can be a stale, untranslated parse-tree",
        "the underlying dict-stored value `.items()` just yielded -" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarsparql.to_rdf._encode_comp_value%3A%3Agraph%3A%3A1>,
