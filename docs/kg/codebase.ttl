<https://github.com/hidden-graph/starlayer/kg/resource/function/starshacl.validator._is_shacl_list> a slkg:Function ;
    rdfs:label "_is_shacl_list" ;
    rdfs:comment """Per the SHACL 1.2 Core spec: a SHACL list is an IRI or blank node that
is either ``rdf:nil`` (with no ``rdf:first``/``rdf:rest`` values of its
own), or has exactly one ``rdf:first`` and one ``rdf:rest`` value that is
itself a SHACL list, with no cycle through ``rdf:rest+``.""" ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarshacl.validator._is_shacl_list%3A%3Agraph%3A%3A0>,
