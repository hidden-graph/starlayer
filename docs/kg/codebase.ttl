<https://github.com/hidden-graph/starlayer/kg/resource/module/starlayergraph.serializers.trix12> a slkg:Module ;
    rdfs:label "starlayergraph.serializers.trix12" ;
    dcterms:identifier "starlayergraph.serializers.trix12" ;
    rdfs:comment """starlayergraph.serializers.trix12

Serialize a StarLayerGraph or StarLayerDataset context to TriX 1.2 XML.

TriX is an XML-based named-graph format (http://www.w3.org/2004/03/trix/).
Each graph is a <graph> element containing <triple> elements. RDF 1.2 triple
terms are represented by nesting another <triple> element in a term position
(subject or object) - the same tag used for an asserted statement, since
TriX disambiguates by structural position, not a distinct tag name. This
matches Apache Jena's real TriX writer (confirmed empirically 2026-07-17
against a live Fuseki 5.5.0), including its lowercase <trix> root element -
the only production TriX implementation found to support RDF 1.2 triple
terms at all, since Oxigraph doesn't implement TriX. See the parser module
(starlayergraph.parsers.trix12) for the corresponding read side, which still
accepts starlayergraph's original <TriX>/<tripleTerm> spelling for backward
compatibility even though it's no longer emitted here.

Entry point:  serialize_trix12(g) -> str""" ;
    slkg:belongsToPackage <https://github.com/hidden-graph/starlayer/kg/resource/package/starlayergraph> ;
    slkg:commentText "shorthand: '{ns}' prefix for element tags" ;
    slkg:contains <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12._append_graph>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12._sort_triple>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12._term_elem>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12.serialize_trix12>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12.serialize_trix12_dataset> ;
    slkg:defines <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12._append_graph>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12._sort_triple>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12._term_elem>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12.serialize_trix12>,
        <https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.trix12.serialize_trix12_dataset> ;
    slkg:filePath "packages/graph/starlayergraph/serializers/trix12.py" ;
    slkg:importsModule <https://github.com/hidden-graph/starlayer/kg/resource/external/__future__>,
        <https://github.com/hidden-graph/starlayer/kg/resource/external/rdflib>,
        <https://github.com/hidden-graph/starlayer/kg/resource/external/xml.etree.ElementTree>,
        <https://github.com/hidden-graph/starlayer/kg/resource/module/starlayergraph.model.dirlangstring>,
        <https://github.com/hidden-graph/starlayer/kg/resource/module/starlayergraph.model.encoding>,
        <https://github.com/hidden-graph/starlayer/kg/resource/module/starlayergraph.model.triple> ;
    slkg:moduleName "starlayergraph.serializers.trix12" .

