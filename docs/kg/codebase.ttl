<https://github.com/hidden-graph/starlayer/kg/resource/function/starlayergraph.serializers.rdfxml12._set_object> a slkg:Function ;
    rdfs:label "_set_object" ;
    rdfs:comment "Configure *prop* for the given object node (attribute or nested element)." ;
    slkg:commentText "(sec 2.19), not an invented element. Recurses for a nested triple",
        "BNode - triple terms are only ever objects, so this can't recurse",
        "Literal(text, datatype=...) unchanged, no langtag validation",
        "Same internal dirlang: datatype-URI encoding as every other format;",
        "holds exactly one property - the real RDF 1.2 XML Syntax mechanism",
        "involved (that only fires for the xml:lang attribute).",
        "rdf:parseType=\"Triple\" wrapping a single <rdf:Description> that",
        "rdflib's real RDF/XML parser reads rdf:datatype back into",
        "term (the inner property's own object is itself a TripleTerm)." ;
    slkg:hasParameter <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarlayergraph.serializers.rdfxml12._set_object%3A%3Aobj%3A%3A1>,
        <https://github.com/hidden-graph/starlayer/kg/resource/parameter/https%3A%2F%2Fgithub.com%2Fhidden-graph%2Fstarlayer%2Fkg%2Fresource%2Ffunction%2Fstarlayergraph.serializers.rdfxml12._set_object%3A%3Aprop%3A%3A0> ;
    slkg:lineEnd 130 ;
    slkg:lineStart 92 ;
    slkg:qualifiedName "starlayergraph.serializers.rdfxml12._set_object" ;
    slkg:signature "def _set_object(prop: ET.Element, obj) -> None" .

